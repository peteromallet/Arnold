+
+release_early_repair_pid_claim() {
+  local current_pid=""
+  if [[ "$REPAIR_PID_FILE_OWNED" == "1" && -r "$REPAIR_PID_FILE" ]]; then
+    read -r current_pid < "$REPAIR_PID_FILE" || current_pid=""

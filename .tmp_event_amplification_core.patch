     _atomic_write_text(_projection_seq_path(plan_dir), str(seq))
 
 
+def _read_projection_tail_seq(path: Path) -> int | None:
+    """Read only the final NDJSON record and return its sequence."""
+    try:
+        with path.open("rb") as handle:
+            handle.seek(0, os.SEEK_END)
+            position = handle.tell()
+            buffer = b""
+            while position > 0:
+                chunk_size = min(64 * 1024, position)
+                position -= chunk_size
+                handle.seek(position)
+                buffer = handle.read(chunk_size) + buffer
+                stripped = buffer.rstrip(b"\r\n")
+                newline = stripped.rfind(b"\n")
+                if newline >= 0 or position == 0:
+                    line = stripped[newline + 1 :]
+                    if not line:
+                        return None
+                    record = json.loads(line.decode("utf-8"))
+                    seq = record.get("seq") if isinstance(record, dict) else None
+                    return seq if isinstance(seq, int) else None
+    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
+        return None
+    return None
+

                        "tasks": [
                            {
                                "id": "T1",
                                "status": "done",
                                "commands_run": [
                                    "pytest tests/editorial_run_lifecycle.py"
                                ],
                            }
                        ]
                    }
                ),
                encoding="utf-8",
            )
            state["current_state"] = "executed"
            (plan_dir / "state.json").write_text(json.dumps(state), encoding="utf-8")
            return 0, "ok", ""
    

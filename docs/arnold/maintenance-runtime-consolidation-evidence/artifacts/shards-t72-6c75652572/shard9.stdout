            "exit 0\n",
            encoding="utf-8",
        )
        fake_repair_bin.chmod(fake_repair_bin.stat().st_mode | stat.S_IXUSR)
    
        script = _phase_contract_script(
            marker_dir=marker_dir,
            workspace=workspace,
            plan_name=plan_name,
            session=session,
            report_path=report_path,
            log_path=log_path,
            queue_root=tmp_path / "queue",
            claim_log=claim_log,

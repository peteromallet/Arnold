    emit_current_needs_human_sidecar() {
      local report_items="$1"
      local session="$2"
      local workspace="$3"
      local remote_spec="$4"
      local current_plan="$5"
      local current_target_observation="${6:-}"
      local health="${7:-}"
      local marker_path stale_marker_plans repair_summary
    
      marker_path="$(repair_needs_human_path "$session")"
      [[ -f "$marker_path" ]] || return 1
    
      stale_marker_plans="$(repair_needs_human_matches_current_plan "$session" "$current_plan" 2>/dev/null)" || {
        local stale_clear_verdict stale_clear_state
        stale_clear_verdict="$(resolver_stale_needs_human_clear_verdict "$current_target_observation")"
        stale_clear_state="${stale_clear_verdict#*:}"
        if [[ "$stale_clear_state" == "$stale_clear_verdict" || -z "$stale_clear_state" ]]; then
          stale_clear_state="UNKNOWN"
        fi
        compare_needs_human_to_resolver "$session" "$current_plan" "true" "${stale_marker_plans:-}"
        if [[ "$stale_clear_verdict" == clear:* ]]; then
          if [[ "${MUTATION_CAPABILITY_PRESENT:-0}" != "1" ]]; then
            log "stale repair needs-human marker preserved; observe-only without minted MutationCapability session=$session canonical_state=$stale_clear_state live_plan=${current_plan:-unknown} marker_plans=${stale_marker_plans:-unknown}"
            return 0
          fi
          rm -f "$marker_path" 2>/dev/null || authority_gap_continue "T29-BYPASS-126" "authority-risk bypass converted to typed evidence gap"
          log "stale repair needs-human marker cleared; canonical resolver permits stale clear session=$session canonical_state=$stale_clear_state live_plan=${current_plan:-unknown} marker_plans=${stale_marker_plans:-unknown}"
          return 1
        fi
        log "stale repair needs-human marker preserved; canonical resolver blocks stale clear session=$session canonical_state=$stale_clear_state live_plan=${current_plan:-unknown} marker_plans=${stale_marker_plans:-unknown}"
      }
      if [[ -n "${stale_marker_plans:-}" ]]; then
        compare_needs_human_to_resolver "$session" "$current_plan" "true" "$stale_marker_plans"
      else
        compare_needs_human_to_resolver "$session" "$current_plan" "false" ""
      fi
    
      # The needs-human marker path is observe-only: the L2 meta-repair trigger
      # that used to dispatch from here was removed with the layered stack. The
      # single-flash babysitter dispatches from launch_chain_tick, not here.
      if command -v repair_needs_human_should_remain_human >/dev/null 2>&1 && ! repair_needs_human_should_remain_human "$session" "$current_plan"; then
        if [[ "${MUTATION_CAPABILITY_PRESENT:-0}" != "1" ]]; then
          log "stale repair needs-human marker preserved; observe-only without minted MutationCapability session=$session live_plan=${current_plan:-unknown}"
          repair_summary="$(repair_needs_human_summary "$session")"
          report_item "$report_items" "$session" "observe" "needs_human" "$repair_summary" "$workspace" "$remote_spec"
          return 0
        fi
        rm -f "$marker_path" 2>/dev/null || authority_gap_continue "T29-BYPASS-127" "authority-risk bypass converted to typed evidence gap"
        log "stale repair needs-human marker cleared; fresh classifier no longer requires human session=$session live_plan=${current_plan:-unknown}"
        return 1
      fi
    
      repair_summary="$(repair_needs_human_summary "$session")"
      log "session has current needs-human marker; reporting without re-notifying session=$session summary=$repair_summary"
      report_item "$report_items" "$session" "observe" "needs_human" "$repair_summary" "$workspace" "$remote_spec"
      return 0
    }
    
    
    current_target_plan_name_from_observation() {
      local observation="$1"
      python3 - "$observation" <<'PY'
    import json
    import sys
    
    try:
        payload = json.loads(sys.argv[1] or "{}")
    except Exception:
        payload = {}
    refs = payload.get("current_refs") if isinstance(payload.get("current_refs"), dict) else {}
    for key in ("current_plan_name", "chain_current_plan_name", "marker_plan_name"):
        value = refs.get(key)
        if isinstance(value, str) and value.strip():
            print(value.strip())
            break
    PY
    }
    
    # ─────────────────────────────────────────────────────────────────────────────
    # Single-flash babysitter launch machinery (Q1/Q2). The watchdog's ONLY repair
    # dispatch is the status-trigger babysitter: one managed
    # hermes:deepseek:deepseek-v4-flash agent whose goal prompt does
    # swarm -> Codex -> implement -> relaunch -> prove. Everything else in the
    # repair-dispatch stack (L1 repair-loop, L2 meta-repair, repair-trigger) has
    # been removed; there is deliberately NO fallthrough.
    # ─────────────────────────────────────────────────────────────────────────────
    
    # Occurrence fingerprint shared by the dedup gate and the launch: sha256 of
    # kind/phase/message/phase_or_step/blocked_task_id from the durable plan
    # failure state, first 12 hex chars. An empty failure record still produces a
    # deterministic digest (all-empty fields) so same-session ticks dedup.
    babysitter_occurrence_digest() {
      local session="$1"
      local workspace="$2"
      local remote_spec="$3"
      local run_kind="${4:-chain}"
      local plan_name="${5:-}"
      PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - \
        "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" <<'PY'
    import hashlib
    import json
    import pathlib
    import sys
    
    session, workspace_raw, remote_spec_raw, run_kind, plan_name = sys.argv[1:]
    workspace = pathlib.Path(workspace_raw)
    plan_name = str(plan_name or "").strip()
    state_path = None
    if plan_name:
        candidate = workspace / ".megaplan" / "plans" / plan_name / "state.json"
        if candidate.is_file():
            state_path = candidate
    elif run_kind == "plan":
        plans_root = workspace / ".megaplan" / "plans"
        candidates = sorted(
            plans_root.glob("*/state.json"),
            key=lambda path: path.stat().st_mtime,
            reverse=True,
        )
        if candidates:
            state_path = candidates[0]
    else:
        # chain / epic_chain: read the chain state's current plan if resolvable,
        # else fall back to the newest plan state in the workspace.
        chain_path = None
        if remote_spec_raw:
            spec_path = pathlib.Path(remote_spec_raw)
            if not spec_path.is_absolute():
                spec_path = workspace / spec_path
            try:
                spec_resolved = spec_path.resolve()
            except Exception:
                spec_resolved = spec_path
            chain_digest = hashlib.sha1(str(spec_resolved).encode("utf-8")).hexdigest()[:12]
            for candidate in (
                workspace / ".megaplan" / "plans" / ".chains" / f"chain-{chain_digest}.json",
                workspace / ".megaplan" / "plans" / ".chains" / f"{spec_resolved.stem}-{chain_digest}.json",
                spec_resolved.parent / ".megaplan" / "plans" / ".chains" / f"chain-{chain_digest}.json",
            ):
                if candidate.is_file():
                    chain_path = candidate
                    break
        if chain_path is not None:
            try:
                chain_state = json.loads(chain_path.read_text(encoding="utf-8"))
                chain_plan = str(chain_state.get("current_plan_name") or "").strip()
            except Exception:
                chain_plan = ""
            if chain_plan:
                candidate = workspace / ".megaplan" / "plans" / chain_plan / "state.json"
                if candidate.is_file():
                    state_path = candidate
        if state_path is None:
            plans_root = workspace / ".megaplan" / "plans"
            candidates = sorted(
                plans_root.glob("*/state.json"),
                key=lambda path: path.stat().st_mtime,
                reverse=True,
            )
            if candidates:
                state_path = candidates[0]
    
    
    def _load_json(path):
        if path is None:
            return {}
        try:
            payload = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            return {}
        return payload if isinstance(payload, dict) else {}
    
    
    latest_failure = _load_json(state_path).get("latest_failure")
    latest_failure = latest_failure if isinstance(latest_failure, dict) else {}
    metadata = latest_failure.get("metadata")
    metadata = metadata if isinstance(metadata, dict) else {}
    digest_src = dict(
        kind=str(latest_failure.get("kind") or ""),
        phase=str(latest_failure.get("phase") or ""),
        message=str(latest_failure.get("message") or ""),
        phase_or_step=str(metadata.get("phase_or_step") or ""),
        blocked_task_id=str(metadata.get("blocked_task_id") or ""),
    )
    if not any(digest_src.values()):
        # The auto-driver clears state.latest_failure when a stall is recorded,
        # so the fields above degenerate to ALL-EMPTY for every stalled chain and
        # the digest collapses to one fixed value (which collided with d587's real
        # digest). Recover durable identity from artifacts the driver does NOT
        # clear: the plan's phase_result (exit kind + phase) plus iteration and
        # current state. Same stall -> same digest; different stall -> different.
        if state_path is not None and state_path.is_file():
            plan_dir = state_path.parent
            phase_result = _load_json(plan_dir / "phase_result.json")
            digest_src["phase_result_phase"] = str(
                phase_result.get("phase") if isinstance(phase_result, dict) else ""
            )
            digest_src["phase_result_exit"] = str(
                phase_result.get("exit_kind") if isinstance(phase_result, dict) else ""
            )
            state_payload = _load_json(state_path)
            digest_src["state"] = str(state_payload.get("current_state") or "")
            digest_src["iteration"] = str(state_payload.get("iteration") or "")
    print(hashlib.sha256(json.dumps(digest_src, sort_keys=True).encode("utf-8")).hexdigest()[:12])
    PY
    }
    
    # driver.babysitter gate: prints "mode\tafter" where mode is superfixer|off and
    # after is the ISO-8601 duration ("" when unset). Missing/unparseable spec
    # defaults to superfixer with no delay (default ON).
    #
    # The remote_spec the watchdog carries is the CHAIN spec (chain.yaml). The
    # driver.babysitter policy lives on the DEPLOY spec (cloud.yaml) that load_spec
    # parses: resolve remote_spec itself first (a deploy spec may be passed
    # directly), then the sibling ``cloud.yaml`` / ``<stem>.cloud.yaml`` in the
    # same initiative directory (the standard layout).
    
    # babysitter_parked_chain_stall: True when the session's chain is STOPPED in a
    # state with NO active step and NO live driver — a milestone plan that was
    # born but never driven (initialized / planned / finalized / critiqued /
    # gated), OR a plan that STOPPED in a failure state (blocked / failed) with
    # no worker live on it. Such a chain is a genuine stoppage the fixer must
    # pick up: pre-execute it is a DRIVE, failed it is a REPAIR (the fixer's job
    # is to diagnose, fix, ship, rebind, resume). A plan with a live active-step
    # worker is NOT parked. mode=off disables REPAIR dispatch, but a parked stall
    # is a drive the fixer must still pick up.
    #
    # Why failed/blocked are included (grok strategy consult 2026-08-16): a
    # blocked/failed plan with no live driver and no lease sits behind the
    # liveness fence (PID/lease-based, not marker-SHA-based) -> watchdog reports
    # 'liveness unavailable; fenced' -> NO babysitter dispatches -> the fixer
    # that would rebind the stale marker (consumer lag) never runs -> catch-22,
    # chain strands forever. Extending the pre-fence dispatch exception (which
    # already exists for parked pre-execute stalls because a parked chain has no
    # live driver by definition) to stopped failed plans gives the fixer the
    # occurrence. The dispatch is still the single-flash babysitter; mechanical
    # relaunch remains fenced; the drive/repair is never --fresh and never wipes.
    babysitter_parked_chain_stall() {
      local session="$1"
      local workspace="$2"
      local remote_spec="$3"
      local run_kind="${4:-chain}"
      local plan_name="${5:-}"
      PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$session" "$workspace" "$remote_spec" "$plan_name" <<'PY'
    import json
    import sys
    from pathlib import Path
    
    session, workspace_raw, remote_spec_raw, plan_name = sys.argv[1:]
    workspace = Path(workspace_raw)
    
    def _find_plan_dir() -> Path | None:
        plans_root = workspace / ".megaplan" / "plans"
        if not plans_root.is_dir():
            return None
        if plan_name:
            candidate = plans_root / plan_name
            if (candidate / "state.json").is_file():
                return candidate
        dirs = sorted(plans_root.iterdir(), key=lambda p: p.stat().st_mtime, reverse=True)
        for d in dirs:
            if (d / "state.json").is_file():
                return d
        return None
    
    plan_dir = _find_plan_dir()
    if plan_dir is None:
        # No plan at all yet: a chain that has never born a plan for its first
        # milestone is parked (needs a DRIVE) unless the chain is fully
        # terminal. Fall through to the chain-record check below.
        plan_dir = None
    state: dict = {}
    if plan_dir is not None:
        try:
            state = json.loads((plan_dir / "state.json").read_text(encoding="utf-8"))
        except (OSError, ValueError):
            state = {}
    current = state.get("current_state")
    if current not in {
        "initialized", "planned", "finalized", "critiqued", "gated",
        "blocked", "failed",
    }:
        # The newest plan is terminal (done/executed/reviewed) or absent. A chain
        # that still has PENDING milestones (current_milestone_index < the total
        # milestone sequence) is parked BETWEEN milestones - the next plan is
        # unborn and nothing will drive it unless the fixer picks it up. Read the
        # chain record from the remote spec's .chains dir; if the chain has
        # pending milestones and no current plan, treat it as parked (a DRIVE).
        chain_pending = False
        if remote_spec_raw:
            spec_path = Path(remote_spec_raw)
            if not spec_path.is_absolute():
                spec_path = workspace / spec_path
            chain_dir = workspace / ".megaplan" / "plans" / ".chains"
            import hashlib
            chain_digest = hashlib.sha1(str(spec_path.resolve()).encode("utf-8")).hexdigest()[:12]
            for candidate in (
                chain_dir / f"chain-{chain_digest}.json",
                chain_dir / f"{spec_path.stem}-{chain_digest}.json",
            ):
                if not candidate.is_file():
                    continue
                try:
                    chain = json.loads(candidate.read_text(encoding="utf-8"))
                except (OSError, ValueError):
                    continue
                idx = chain.get("current_milestone_index")
                completed = chain.get("completed") or []
                last_state = str(chain.get("last_state") or "")
                # A chain parked at a HUMAN GATE (awaiting_human_verify /
                # awaiting_human) must NOT be driven - the fixer would re-run the
                # same milestone, re-emit the same product-safety user_actions,
                # and park again (grok consult 2026-08-17: the between-milestones
                # drive in a85e968a88 was the mechanical generator of the mega m3
                # U1/U2 loop). Human gates are resolved by a human, not a drive.
                if last_state in {"awaiting_human", "awaiting_human_verify"}:
                    chain_pending = False
                else:
                    total = 0
                    try:
                        spec_text = spec_path.read_text(encoding="utf-8")
                        # chain.yaml is YAML: count top-level "- label:" milestone entries.
                        total = sum(1 for line in spec_text.splitlines() if line.startswith("- label:"))
                    except Exception:
                        total = 0
                    if isinstance(idx, int) and idx >= 0 and (total == 0 or idx < total):
                        chain_pending = True
                    elif completed and (total == 0 or len(completed) < total):
                        chain_pending = True
                break
        if not chain_pending:
            sys.exit(1)
    active = state.get("active_step")
    if active and isinstance(active, dict) and active.get("phase"):
        sys.exit(1)  # a worker is live; not parked
    # No active step in a stoppage state (or between milestones with no plan):
    # parked unless a driver is live.
    sys.exit(0)
    PY
    }
    
    babysitter_effective_mode() {
      local remote_spec="$1"
      local workspace="$2"
      PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$remote_spec" "$workspace" <<'PY'
    import pathlib
    import sys
    
    remote_spec_raw, workspace_raw = sys.argv[1:]
    mode = "superfixer"
    after = ""
    candidates: list[pathlib.Path | None] = []
    if remote_spec_raw:
        spec_path = pathlib.Path(remote_spec_raw)
        if not spec_path.is_absolute():
            spec_path = pathlib.Path(workspace_raw) / spec_path
        candidates.append(spec_path)
        candidates.append(spec_path.with_name("cloud.yaml"))
        candidates.append(spec_path.with_name(spec_path.stem + ".cloud.yaml"))
    for candidate in candidates:
        if candidate is None or not candidate.is_file():
            continue
        try:
            from arnold_pipelines.megaplan.cloud.spec import (
                babysitter_effective_mode,
                load_spec,
            )
    
            spec = load_spec(candidate)
            mode = babysitter_effective_mode(spec.driver)
            driver = spec.driver
            if driver is not None and driver.babysitter is not None:
                after = driver.babysitter.after or ""
            break
        except Exception:
            continue
    print(f"{mode}\t{after}")
    PY
    }
    
    # 0 when the after-duration (ISO-8601, e.g. PT1H) has elapsed since the
    # unhealthy state began (latest_failure.recorded_at), or when no reference
    # timestamp exists (fail-safe: fire). 1 when the chain must keep waiting.
    babysitter_after_elapsed() {
      local after="$1"
      local session="$2"
      local workspace="$3"
      local remote_spec="$4"
      local run_kind="${5:-chain}"
      local plan_name="${6:-}"
      PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - \
        "$after" "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" <<'PY'
    import datetime as dt
    import json
    import pathlib
    import sys
    
    from arnold_pipelines.megaplan.resident.schedules import parse_duration
    
    after, session, workspace_raw, remote_spec_raw, run_kind, plan_name = sys.argv[1:]
    workspace = pathlib.Path(workspace_raw)
    plan_name = str(plan_name or "").strip()
    state_path = None
    if plan_name:
        candidate = workspace / ".megaplan" / "plans" / plan_name / "state.json"
        if candidate.is_file():
            state_path = candidate
    else:
        plans_root = workspace / ".megaplan" / "plans"
        candidates = sorted(
            plans_root.glob("*/state.json"),
            key=lambda path: path.stat().st_mtime,
            reverse=True,
        )
        if candidates:
            state_path = candidates[0]
    
    
    def iso_to_dt(value):
        if not value:
            return None
        try:
            parsed = dt.datetime.fromisoformat(str(value).replace("Z", "+00:00"))
        except ValueError:
            return None
        if parsed.tzinfo is None:
            parsed = parsed.replace(tzinfo=dt.timezone.utc)
        return parsed
    
    
    recorded_at = None
    if state_path is not None:
        try:
            payload = json.loads(state_path.read_text(encoding="utf-8"))
        except Exception:
            payload = {}
        failure = payload.get("latest_failure")
        failure = failure if isinstance(failure, dict) else {}
        recorded_at = iso_to_dt(failure.get("recorded_at"))
    try:
        duration = parse_duration(after)
    except (ValueError, TypeError):
        raise SystemExit(1)
    if recorded_at is None:
        # No durable reference timestamp: fail-safe and fire.
        raise SystemExit(0)
    elapsed = dt.datetime.now(dt.timezone.utc) - recorded_at
    if elapsed >= duration:
        raise SystemExit(0)
    raise SystemExit(1)
    PY
    }
    
    # 0 when a babysitter is already live for the same occurrence digest, 1
    # otherwise. Checks the launch receipt (supervisor pid) and the watchdog
    # dispatch receipt (babysitter pid). A pid is live iff kill(pid, 0) succeeds.
    babysitter_running_for_occurrence() {
      local session="$1"
      local digest="$2"
      PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - \
        "$session" "$digest" "${REPAIR_DATA_DIR:-$MARKER_DIR/repair-data}" <<'PY'
    import json
    import os
    import pathlib
    import sys
    from datetime import datetime, timedelta, timezone
    
    session, digest, repair_data_raw = sys.argv[1:]
    repair_data = pathlib.Path(repair_data_raw)
    
    
    def pid_live(pid):
        if not isinstance(pid, int) or pid <= 0:
            return False
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return False
        except PermissionError:
            return True
        return True
    
    
    def _proc_root():
        return pathlib.Path(os.environ.get("CLOUD_WATCHDOG_BABYSITTER_PROC_ROOT", "/proc"))
    
    
    def _progress_logs(payload, run_root):
        """Files that actually move while a babysitter is working.
    
        ``run.log`` is the managed-agent capture. It is silent during a model
        call: the hermes spinner is non-TTY (PIPE), so it writes ``[tool]`` at
        tool start and ``[done]`` at tool end, and nothing while the LLM thinks.
        ``babysitter.stdout.log`` is a tee of that same stream (managed_agent
        tee_output=True); ``babysitter.stderr.log`` is the supervisor. Watching
        only ``run.log`` is what produced the I51 18-minute false-positive reap.
        """
        seen = []
        seen_ids = set()
    
        def _add(path):
            try:
                resolved = path.resolve()
            except OSError:
                return
            marker = str(resolved)
            if marker in seen_ids or not resolved.is_file():
                return
            seen_ids.add(marker)
            seen.append(resolved)
    
        if run_root and run_root.is_dir():
            _add(run_root / "babysitter.stdout.log")
            _add(run_root / "babysitter.stderr.log")
            for path in run_root.rglob("run.log"):
                _add(path)
        for key in ("stdout_log", "stderr_log"):
            raw = payload.get(key)
            if isinstance(raw, str) and raw:
                _add(pathlib.Path(raw))
        return seen
    
    
    def _socket_inodes(pid, proc):
        fd_dir = proc / str(pid) / "fd"
        inodes = set()
        try:
            for entry in fd_dir.iterdir():
                try:
                    target = os.readlink(entry)
                except OSError:
                    continue
                if target.startswith("socket:[") and target.endswith("]"):
                    inodes.add(target[8:-1])
        except OSError:
            return inodes
        return inodes
    
    
    def _pid_has_established_tcp(pid, proc):
        inodes = _socket_inodes(pid, proc)
        if not inodes:
            return False
        tables = [
            proc / str(pid) / "net" / "tcp",
            proc / str(pid) / "net" / "tcp6",
            proc / "net" / "tcp",
            proc / "net" / "tcp6",
        ]
        seen = set()
        for table in tables:
            marker = str(table)
            if marker in seen or not table.is_file():
                continue
            seen.add(marker)
            try:
                lines = table.read_text(encoding="utf-8", errors="replace").splitlines()[1:]
            except OSError:
                continue
            for line in lines:
                parts = line.split()
                # st == 01 is ESTABLISHED; field 9 is inode.
                if len(parts) >= 10 and parts[3] == "01" and parts[9] in inodes:
                    return True
        return False
    
    
    def _pid_runnable(pid, proc):
        try:
            stat = (proc / str(pid) / "stat").read_text(encoding="utf-8")
            state = stat.rsplit(") ", 1)[1].split()[0]
        except (OSError, IndexError):
            return False
        return state in {"R", "D"}
    
    
    def _descendant_pids(root_pids, proc):
        children = {}
        try:
            for entry in proc.iterdir():
                if not entry.name.isdigit():
                    continue
                try:
                    stat = (entry / "stat").read_text(encoding="utf-8")
                    ppid = int(stat.rsplit(") ", 1)[1].split()[1])
                except (OSError, IndexError, ValueError):
                    continue
                children.setdefault(ppid, []).append(int(entry.name))
        except OSError:
            return []
        out = []
        stack = []
        for root in root_pids:
            stack.extend(children.get(int(root), []))
        seen = set()
        while stack:
            pid = stack.pop()
            if pid in seen:
                continue
            seen.add(pid)
            out.append(pid)
            stack.extend(children.get(pid, []))
        return out
    
    
    def _tree_has_live_work(root_pids):
        """True if the babysitter tree is mid-call; None if /proc is unreadable.
    
        A legitimate Flash babysitter spends most of its life in one of two
        silent-log states: (1) blocked on an LLM SSE socket, (2) waiting on a
        child (fan.py / pytest / grep) that is itself running or on a socket.
        ``run.log`` growth cannot see either. I18/I32/I34 hangs are the inverse:
        live pid, 0% CPU, 0 sockets, no children working.
        """
        proc = _proc_root()
        if not proc.is_dir():
            return None
        pids = []
        for raw in root_pids:
            if isinstance(raw, int) and raw > 0:
                pids.append(raw)
        if not pids:
            return False
        for pid in (*pids, *_descendant_pids(pids, proc)):
            if _pid_runnable(pid, proc) or _pid_has_established_tcp(pid, proc):
                return True
        return False
    
    
    def _pid_comm(pid, proc):
        try:
            return (proc / str(pid) / "comm").read_text(encoding="utf-8", errors="replace").strip()
        except OSError:
            return ""
    
    
    def _pid_cmdline(pid, proc):
        try:
            raw = (proc / str(pid) / "cmdline").read_bytes().replace(b"\x00", b" ")
            return raw.decode("utf-8", "replace")
        except OSError:
            return ""
    
    
    def _pid_age_seconds(pid, proc):
        """Seconds since pid start. None if /proc is unreadable."""
        try:
            stat = (proc / str(pid) / "stat").read_text(encoding="utf-8")
            startticks = int(stat.rsplit(") ", 1)[1].split()[19])
            hz = os.sysconf("SC_CLK_TCK") or 100
            uptime = float((proc / "uptime").read_text(encoding="utf-8").split()[0])
        except (OSError, IndexError, ValueError):
            return None
        return uptime - (startticks / float(hz))
    
    
    def _is_codex_child(pid, proc):
        comm = _pid_comm(pid, proc)
        cmd = _pid_cmdline(pid, proc)
        return comm == "codex" or comm.startswith("codex") or "codex exec" in cmd
    
    
    def _progress_has_tool_line(paths):
        for path in paths:
            try:
                text = path.read_text(encoding="utf-8", errors="replace")
            except OSError:
                continue
            if "[tool]" in text or "[done]" in text:
                return True
        return False
    
    
    def signal_hung_fixer_children(root_pids):
        """SIGTERM hung ``codex exec`` descendants. Does not touch the babysitter.
    
        I18 signature: process exists, not R/D, no ESTABLISHED TCP, older than
        the consult bound. A thinking consult has a socket and is left alone.
        """
        proc = _proc_root()
        if not proc.is_dir():
            return []
        bound = float(os.environ.get("CLOUD_WATCHDOG_HUNG_CHILD_MINUTES", "20")) * 60
        pids = [raw for raw in root_pids if isinstance(raw, int) and raw > 0]
        signaled = []
        for pid in _descendant_pids(pids, proc):
            if not _is_codex_child(pid, proc):
                continue
            if _pid_runnable(pid, proc) or _pid_has_established_tcp(pid, proc):
                continue
            age = _pid_age_seconds(pid, proc)
            if age is None or age < bound:
                continue
            try:
                os.kill(pid, 15)
            except OSError:
                continue
            signaled.append(pid)
        return signaled
    
    
    def babysitter_wedged(payload, run_root):
        """A live-pid fixer that has made NO progress is wedged.
    
        Contract (I51b): a busy unbounded babysitter is never reaped. Wedge
        means: past newborn/first-call grace, no fresh progress file, and the
        process tree shows no live work. A hung ``codex`` child is not a reason
        to reap the parent — signal_hung_fixer_children handles that. If /proc
        cannot be inspected, fail open.
        """
        launch_stall_minutes = float(
            os.environ.get("CLOUD_WATCHDOG_BABYSITTER_LAUNCH_STALL_MINUTES", "5")
        )
        log_stall_minutes = float(
            os.environ.get("CLOUD_WATCHDOG_BABYSITTER_LOG_STALL_MINUTES", "10")
        )
        # stdout.log is created at Popen, so log-stall starts at launch and
        # expires at 10 min while the first DeepSeek call (timeout 600s) may
        # still have no [tool] line and no ESTABLISHED socket. 20 min covers
        # API timeout + bootstrap + one scan. Applies ONLY when no [tool]/[done]
        # has ever been written — not a general wall.
        first_call_grace_minutes = float(
            os.environ.get("CLOUD_WATCHDOG_BABYSITTER_FIRST_CALL_GRACE_MINUTES", "20")
        )
        try:
            launched_raw = payload.get("launched_at") or payload.get("dispatched_at")
            if not launched_raw:
                return False
            launched = datetime.fromisoformat(str(launched_raw).replace("Z", "+00:00"))
            age = datetime.now(timezone.utc) - launched
            if age < timedelta(minutes=launch_stall_minutes):
                return False
        except Exception:
            return False
        paths = list(_progress_logs(payload, run_root))
        if not _progress_has_tool_line(paths):
            if age < timedelta(minutes=first_call_grace_minutes):
                return False
        newest = None
        for path in paths:
            try:
                mtime = path.stat().st_mtime
            except OSError:
                continue
            if newest is None or mtime > newest:
                newest = mtime
        if newest is not None:
            if datetime.now(timezone.utc).timestamp() - newest < log_stall_minutes * 60:
                return False
        live_work = _tree_has_live_work(
            (payload.get("babysitter_pid"), payload.get("supervisor_pid"))
        )
        if live_work is True:
            return False
        if live_work is None:
            return False
        return True
    
    
    for name in (
        f"{session}.babysitter-launch-receipt.json",
        f"{session}.babysitter-receipt.json",
    ):
        path = repair_data / name
        if not path.is_file():
            continue
        try:
            payload = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            continue
        # Dedup is SESSION-keyed, not digest-keyed: any live babysitter for this
        # session blocks a new launch. Digest-keyed dedup let a second babysitter
        # launch the moment the occurrence digest changed (e.g. the durable-digest
        # fix changed d58701026410 -> 4f5b449cfd75 while the old babysitter was
        # still running), spawning competing fixers for the same chain.
        if str(payload.get("status") or "") in {"launched", "running"}:
            run_root_raw = payload.get("run_root")
            run_root = pathlib.Path(run_root_raw) if isinstance(run_root_raw, str) else None
            roots = (payload.get("babysitter_pid"), payload.get("supervisor_pid"))
            live = pid_live(roots[0]) or pid_live(roots[1])
            if live:
                hung = signal_hung_fixer_children(roots)
                if hung:
                    print(
                        "hung fixer child; signaling "
                        f"session={session} pids={hung} run_root={run_root}",
                        file=sys.stderr,
                    )
                if not babysitter_wedged(payload, run_root):
                    raise SystemExit(0)
            # Wedged (or dead): terminate the stale babysitter + its agent tree so
            # the fresh dispatch below does not race a zombie fixer on the same
            # chain (observed 2026-08-17 I35: wedged 15:38 agents lingered beside
            # 16:46 re-dispatches, both alive, competing). Best-effort SIGTERM;
            # the receipt is left for the fresh launch to supersede.
            print(
                "babysitter wedged or dead; signaling "
                f"session={session} babysitter_pid={payload.get('babysitter_pid')} "
                f"supervisor_pid={payload.get('supervisor_pid')} "
                f"run_root={run_root}",
                file=sys.stderr,
            )
            for stale_pid in (payload.get("babysitter_pid"), payload.get("supervisor_pid")):
                if isinstance(stale_pid, int) and stale_pid > 0 and pid_live(stale_pid):
                    try:
                        os.kill(stale_pid, 15)
                    except OSError:
                        pass
    raise SystemExit(1)
    PY
    }
    
    # Launch the single-flash babysitter for the given occurrence. Journals
    # deviation_declared + fallback_considered BEFORE the launch side effect (a
    # ledger write failure blocks the launch: no event = no side effect), resolves
    # the goal renderer + arnold-babysitter bin from the LIVE engine, renders the
    # goal, Popens the wrapper detached, grace-polls for an early non-zero rc
    # (fail closed), and writes the dispatch receipt. Returns 0 on launch, 1 on
    # failure. There is NO L1/L2 fallthrough here or at the callers.
    launch_status_trigger_babysitter() {
      local session="$1"
      local workspace="$2"
      local remote_spec="$3"
      local run_kind="${4:-chain}"
      local plan_name="${5:-}"
      local report_items="$6"
      local digest="${7:-}"
      PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" \
      ARNOLD_WATCHDOG_MANIFEST_RUNTIME_ROOT="${MANIFEST_RUNTIME_ROOT:-}" \
      ARNOLD_WATCHDOG_RUNTIME_SRC="${REPAIR_DISPATCH_RUNTIME_SRC:-$SRC_DIR}" \
      CLOUD_WATCHDOG_BABYSITTER_BIN="${CLOUD_WATCHDOG_BABYSITTER_BIN:-}" \
      ARNOLD_BABYSITTER_LAUNCH_GRACE_SECS="${ARNOLD_BABYSITTER_LAUNCH_GRACE_SECS:-2}" \
      python3 - "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" "$MARKER_DIR" "$REPAIR_DATA_DIR" "$digest" <<'PY'
    import datetime as _dt
    import hashlib as _hashlib
    import json as _json
    import os
    import runpy as _runpy
    import subprocess as _subprocess
    import sys
    import tempfile as _tempfile
    import time as _time
    from pathlib import Path
    
    from arnold_pipelines.megaplan.chain.spec import chain_spec_sha256
    from arnold_pipelines.megaplan.incident.ledger import RuntimeTransitionWriter
    
    session, workspace_raw, remote_spec_raw, run_kind, plan_name, marker_dir_raw, repair_data_dir_raw, digest = sys.argv[1:]
    workspace = Path(workspace_raw)
    marker_dir = Path(marker_dir_raw)
    repair_data_dir = Path(repair_data_dir_raw)
    
    
    def emit_runtime_transition(event_name: str, *, error: str = "", summary: str = "") -> None:
        """Append one typed runtime transition BEFORE a dispatch side effect.
    
        The ledger append is synchronous and never swallowed.  Fail closed —
        missing workspace/spec (no contract digest) or a ledger write failure
        raises SystemExit(1) so the caller MUST NOT perform the launch side
        effect (no event = no side effect).
        """
        if not workspace or not remote_spec_raw:
            raise SystemExit(1)
        spec = Path(remote_spec_raw)
        if not spec.is_absolute():
            spec = workspace / spec
        if not spec.is_file():
            raise SystemExit(1)
        try:
            chain_digest = chain_spec_sha256(spec)
            writer = RuntimeTransitionWriter(workspace)
            emit_fn = {
                "deviation_declared": writer.emit_deviation_declared,
                "fallback_considered": writer.emit_fallback_considered,
            }[event_name]
            emit_fn(
                scope=f"chain:{session}",
                failure_class="availability",
                chain_spec_sha256=chain_digest,
                error=error,
                actor="arnold-watchdog",
                session_id=session,
                summary=summary,
            )
        except SystemExit:
            raise
        except Exception as exc:
            print(
                f"babysitter launch blocked: runtime transition ledger write failed "
                f"session={session} event={event_name} err={exc}",
                file=sys.stderr,
            )
            raise SystemExit(1)
    
    
    # P2: journal the typed runtime transitions BEFORE the launch side effect
    # (no event = no side effect).
    emit_runtime_transition(
        "deviation_declared",
        error="watchdog observed unhealthy session; status-trigger babysitter dispatch requested",
        summary=f"watchdog declared runtime deviation session={session}",
    )
    emit_runtime_transition(
        "fallback_considered",
        summary=f"watchdog considered status-trigger babysitter fallback session={session}",
    )
    
    
    def _superfixer_engine_roots() -> list[Path]:
        """Live engine roots: manifest runtime root, dispatch runtime source,
        SRC_DIR, then the origin-derived repo root.  The first root that carries
        the babysitter assets wins; the hardcoded stale arnold-r7 tree is never
        used."""
        roots: list[Path] = []
        for env_name in (
            "ARNOLD_WATCHDOG_MANIFEST_RUNTIME_ROOT",
            "ARNOLD_WATCHDOG_RUNTIME_SRC",
            "SRC_DIR",
        ):
            value = os.environ.get(env_name, "").strip()
            if value:
                roots.append(Path(value))
        origin = os.environ.get("ARNOLD_WATCHDOG_ORIGIN", "").strip()
        if origin:
            roots.append(Path(origin).resolve().parents[4])
        return roots
    
    
    def _resolve_renderer(roots: list[Path]) -> Path:
        for root in roots:
            candidate = (
                root
                / "arnold_pipelines/megaplan/skills/babysitter/scripts/render_babysitter_goal.py"
            )
            if candidate.is_file():
                return candidate
        raise RuntimeError("babysitter goal renderer unavailable under live engine roots")
    
    
    def _resolve_bin(roots: list[Path]) -> Path:
        override = os.environ.get("CLOUD_WATCHDOG_BABYSITTER_BIN", "").strip()
        if override:
            candidate = Path(override)
            if not candidate.is_file():
                raise RuntimeError(f"babysitter bin override is not a file: {candidate}")
            return candidate
        for root in roots:
            candidate = root / "arnold_pipelines/megaplan/cloud/wrappers/arnold-babysitter"
            if candidate.is_file():
                return candidate
        raise RuntimeError("babysitter bin unavailable under live engine roots")
    
    
    def _atomic_write(path: Path, text: str) -> None:
        path.parent.mkdir(parents=True, exist_ok=True)
        fd, tmp = _tempfile.mkstemp(prefix=path.name + ".", dir=str(path.parent))
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text)
        os.replace(tmp, path)
    
    
    def _load_json(path: Path | None) -> dict:
        if path is None:
            return {}
        try:
            payload = _json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            return {}
        return payload if isinstance(payload, dict) else {}
    
    
    plan_name = str(plan_name or "").strip()
    state_path = None
    if plan_name:
        candidate = workspace / ".megaplan" / "plans" / plan_name / "state.json"
        if candidate.is_file():
            state_path = candidate
    elif run_kind == "plan":
        plans_root = workspace / ".megaplan" / "plans"
        candidates = sorted(
            plans_root.glob("*/state.json"),
            key=lambda path: path.stat().st_mtime,
            reverse=True,
        )
        if candidates:
            state_path = candidates[0]
    else:
        chain_path = None
        if remote_spec_raw:
            spec_path = Path(remote_spec_raw)
            if not spec_path.is_absolute():
                spec_path = workspace / spec_path
            try:
                spec_resolved = spec_path.resolve()
            except Exception:
                spec_resolved = spec_path
            chain_digest = _hashlib.sha1(str(spec_resolved).encode("utf-8")).hexdigest()[:12]
            for candidate in (
                workspace / ".megaplan" / "plans" / ".chains" / f"chain-{chain_digest}.json",
                workspace / ".megaplan" / "plans" / ".chains" / f"{spec_resolved.stem}-{chain_digest}.json",
                spec_resolved.parent / ".megaplan" / "plans" / ".chains" / f"chain-{chain_digest}.json",
            ):
                if candidate.is_file():
                    chain_path = candidate
                    break
        if chain_path is not None:
            chain_state = _load_json(chain_path)
            chain_plan = str(chain_state.get("current_plan_name") or "").strip()
            if chain_plan:
                candidate = workspace / ".megaplan" / "plans" / chain_plan / "state.json"
                if candidate.is_file():
                    state_path = candidate
        if state_path is None:
            plans_root = workspace / ".megaplan" / "plans"
            candidates = sorted(
                plans_root.glob("*/state.json"),
                key=lambda path: path.stat().st_mtime,
                reverse=True,
            )
            if candidates:
                state_path = candidates[0]
    
    plan_state = _load_json(state_path)
    resolved_plan_name = str(plan_state.get("name") or plan_name or "").strip()
    if not resolved_plan_name and state_path is not None:
        resolved_plan_name = state_path.parent.name
    latest_failure = plan_state.get("latest_failure")
    latest_failure = latest_failure if isinstance(latest_failure, dict) else {}
    metadata = latest_failure.get("metadata")
    metadata = metadata if isinstance(metadata, dict) else {}
    meta = plan_state.get("meta") if isinstance(plan_state.get("meta"), dict) else {}
    planner_repair = meta.get("planner_repair")
    
    try:
        roots = _superfixer_engine_roots()
        renderer = _resolve_renderer(roots)
        babysitter_bin = _resolve_bin(roots)
        # The live engine root is the renderer's own tree (5 parents up from
        # scripts/render_babysitter_goal.py), never the babysitter bin location
        # (which a test override may relocate).
        engine_root = renderer.resolve().parents[5]
        run_id = "sched_superfixer_status_" + session.replace("/", "_")[:48] + "_" + digest
        _ns = _runpy.run_path(str(renderer))
        render_babysitter_goal = _ns.get("render_babysitter_goal")
        if not callable(render_babysitter_goal):
            raise RuntimeError("babysitter goal renderer is unavailable")
        goal_text = render_babysitter_goal(
            session,
            workspace=str(workspace),
            plan=resolved_plan_name,
            run_kind=run_kind,
            latest_failure=latest_failure if isinstance(latest_failure, dict) else None,
            planner_repair=planner_repair if isinstance(planner_repair, dict) else None,
            occurrence_digest=digest,
            recovery_dir=str(
                Path(workspace) / ".megaplan" / "plans" / ".chains" / "recovery"
            ),
        )
        goal_fd, goal_path = _tempfile.mkstemp(suffix=".md", prefix="superfixer-goal-")
        with os.fdopen(goal_fd, "w") as fh:
            fh.write(goal_text)
        run_root = repair_data_dir / "babysitter-runs" / run_id
        run_root.mkdir(parents=True, exist_ok=True)
        child_env = dict(os.environ)
        child_env["PYTHONPATH"] = str(engine_root) + (
            ":" + child_env["PYTHONPATH"] if child_env.get("PYTHONPATH") else ""
        )
        child_env["ARNOLD_BABYSITTER_SESSION"] = session
        # ROOT FIX (grok consult 2026-08-17): the inherited box-global
        # ARNOLD_REPAIR_SESSION leaked into cross-session babysitter dispatches -
        # an astrid babysitter spawned by the mega watchdog's env carried
        # ARNOLD_REPAIR_SESSION=megaplan-maintenance into its resume/execute
        # workers, which hijacked the MEGA liveness lock/marker/lease. Remap the
        # repair session to the babysitter's target session so the liveness
        # resolver (liveness_lease.resolve_managed_session) sees consistency and
        # publishes under the correct session. Also clear the inherited owner pid
        # so the child never defers to a foreign live publisher.
        child_env["ARNOLD_REPAIR_SESSION"] = session
        child_env.pop("ARNOLD_LIVENESS_OWNER_PID", None)
        child_env.pop("ARNOLD_LIVENESS_OWNER_PROCESS_START", None)
        child_env["ARNOLD_BABYSITTER_WORKSPACE"] = str(workspace)
        child_env["ARNOLD_BABYSITTER_PLAN"] = resolved_plan_name
        child_env["ARNOLD_BABYSITTER_RUN_KIND"] = run_kind
        child_env["ARNOLD_BABYSITTER_OCCURRENCE"] = digest
        child_env["ARNOLD_BABYSITTER_GOAL_FILE"] = goal_path
        child_env["ARNOLD_BABYSITTER_MARKER_DIR"] = str(marker_dir)
        child_env["ARNOLD_BABYSITTER_REPAIR_DATA_DIR"] = str(repair_data_dir)
        stdout_fh = open(run_root / "babysitter.stdout.log", "ab")
        stderr_fh = open(run_root / "babysitter.stderr.log", "ab")
        try:
            launch = _subprocess.Popen(
                [
                    str(babysitter_bin),
                    "--goal-file", goal_path,
                    "--session", session,
                    "--workspace", str(workspace),
                    "--plan", resolved_plan_name,
                    "--run-kind", run_kind,
                    "--occurrence", digest,
                    "--remote-spec", str(remote_spec_raw or ""),
                    "--run-id", run_id,
                    "--run-root", str(run_root),
                    "--mode", "superfixer",
                ],
                env=child_env,
                start_new_session=True,
                stdin=_subprocess.DEVNULL,
                stdout=stdout_fh,
                stderr=stderr_fh,
            )
        finally:
            stdout_fh.close()
            stderr_fh.close()
        # rc check + fail closed: a babysitter that dies immediately with a
        # non-zero rc means the launch did not take; journal and abort so the
        # caller never falls through to a deleted L1/L2 path.
        grace = float(os.environ.get("ARNOLD_BABYSITTER_LAUNCH_GRACE_SECS", "2"))
        deadline = _time.monotonic() + grace
        launch_rc = None
        while _time.monotonic() < deadline:
            launch_rc = launch.poll()
            if launch_rc is not None:
                break
            _time.sleep(0.05)
        if launch_rc is not None and launch_rc != 0:
            raise RuntimeError(f"babysitter exited early rc={launch_rc}")
        receipt = {
            "schema": "arnold.superfixer.watchdog_dispatch_receipt.v1",
            "session": session,
            "plan": resolved_plan_name,
            "run_id": run_id,
            "occurrence_digest": digest,
            "goal_path": goal_path,
            "renderer_path": str(renderer),
            "babysitter_bin": str(babysitter_bin),
            "engine_root": str(engine_root),
            "babysitter_pid": launch.pid,
            "run_root": str(run_root),
            "dispatched_at": _dt.datetime.now(_dt.timezone.utc).strftime(
                "%Y-%m-%dT%H:%M:%SZ"
            ),
            "status": "launched",
        }
        _atomic_write(
            repair_data_dir / f"{session}.babysitter-receipt.json",
            _json.dumps(receipt, indent=2, sort_keys=True) + "\n",
        )
    except SystemExit:
        raise
    except Exception as _sfx:
        print(
            f"babysitter launch failed session={session} err={_sfx}",
            file=sys.stderr,
        )
        raise SystemExit(1)
    PY
    }
    
    # The ONLY repair-dispatch gate in the watchdog (Q2 steps 2/5). Consults
    # driver.babysitter (mode/after), dedups against a live babysitter for the
    # same occurrence, launches the single-flash babysitter, and reports a typed
    # status. Returns 0 in every case — the tick never falls through to a
    # layered L1/L2 path.
    babysitter_policy_dispatch() {
      local session="$1"
      local workspace="$2"
      local remote_spec="$3"
      local run_kind="${4:-chain}"
      local plan_name="${5:-}"
      local report_items="$6"
      local reason="${7:-unhealthy session}"
      local mode_after mode after digest
      mode_after="$(babysitter_effective_mode "$remote_spec" "$workspace" 2>>"${LOG:-/dev/null}" || true)"
      mode="${mode_after%%$'\t'*}"
      after="${mode_after#*$'\t'}"
      [[ -n "$mode" ]] || mode="superfixer"
      if [[ "$mode" == "off" ]]; then
        # mode=off disables REPAIR dispatch for this chain, but a STOPPED
        # PRE-EXECUTE STALL (plan born, no active step, no live driver — e.g.
        # a fresh m2 milestone never driven into prep) is not a repair; it is a
        # chain the fixer must DRIVE.  Dispatch the babysitter for the parked
        # stall even when mode=off, so a healthy-but-unstarted milestone cannot
        # sit forever (astrid-first m2 case, grok/codex fixer-gap family B).
        if babysitter_parked_chain_stall "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" 2>>"${LOG:-/dev/null}"; then
          log "babysitter mode=off but parked-chain stall detected; dispatching drive session=$session reason=$reason"
        else
          log "babysitter mode=off; observing without babysitter dispatch session=$session reason=$reason"
          report_item "$report_items" "$session" "repair" "babysitter_off" \
            "babysitter disabled for this chain (driver.babysitter.mode=off); $reason" \
            "$workspace" "$remote_spec"
          return 0
        fi
      fi
      digest="$(babysitter_occurrence_digest "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" 2>>"${LOG:-/dev/null}" || true)"
      if [[ -n "$digest" ]] && babysitter_running_for_occurrence "$session" "$digest"; then
        log "babysitter already running for occurrence session=$session digest=$digest"
        report_item "$report_items" "$session" "repair" "babysitter_running" \
          "single-flash babysitter already running for this occurrence; observing" \
          "$workspace" "$remote_spec"
        return 0
      fi
      if [[ -n "$after" ]] && ! babysitter_after_elapsed "$after" "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" 2>>"${LOG:-/dev/null}"; then
        log "babysitter after=$after not yet elapsed; observing session=$session reason=$reason"
        report_item "$report_items" "$session" "repair" "babysitter_waiting" \
          "babysitter after=$after not elapsed; observing unhealthy session: $reason" \
          "$workspace" "$remote_spec"
        return 0
      fi
      if launch_status_trigger_babysitter "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" "$report_items" "$digest"; then
        log "single-flash babysitter launched session=$session digest=$digest reason=$reason"
        report_item "$report_items" "$session" "repair" "babysitter_scheduled" \
          "single-flash babysitter dispatched: $reason" "$workspace" "$remote_spec"
      else
        log "babysitter launch failed; no L1/L2 fallthrough session=$session reason=$reason"
        report_item "$report_items" "$session" "repair" "babysitter_launch_failed" \
          "babysitter launch failed; no L1/L2 fallthrough: $reason" "$workspace" "$remote_spec"
      fi
      return 0
    }
    
    emit_custody_structured_facts() {
      local session="$1"
      local workspace="$2"
      local remote_spec="$3"
      local run_kind="${4:-chain}"
      local plan_name="${5:-}"
      local tmux_live="${6:-0}"
      local process_live="${7:-0}"
      local active_step_pid_alive="${8:-}"
      local chain_complete="${9:-0}"
      local supervisor_identity="${10:-}"
      local relaunch_command="${11:-}"
      local needs_human="${12:-0}"
      local repair_active="${13:-0}"
      local watchdog_status="${14:-unknown}"
    
      local facts facts_file
      facts_file="$(mktemp "${TMPDIR:-/tmp}/arnold-watchdog-custody.XXXXXX")" || return 0
      PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$session" "$supervisor_identity" "$tmux_live" "$process_live" "$active_step_pid_alive" "$watchdog_status" "$chain_complete" "$relaunch_command" "$needs_human" "$repair_active" >"$facts_file" 2>>"${LOG:-/dev/null}" <<'PY' || authority_gap_continue "T29-BYPASS-128" "authority-risk bypass converted to typed evidence gap"
    import json
    import shlex
    import sys
    
    from arnold_pipelines.megaplan.cloud.repair_contract import (
        classify_cloud_custody,
        CUSTODY_MANAGED_RUNNING,
        CUSTODY_COMPLETE,
        CUSTODY_UNMANAGED_WARNING,
        CUSTODY_BLOCKED_RELAUNCH,
        CUSTODY_ESCALATED_UNCHANGED,
    )
    
    
    def emit(name: str, value: str) -> None:
        print(f"{name}={shlex.quote(value)}")
    
    
    session_id = sys.argv[1]
    supervisor_identity = sys.argv[2]
    tmux_live = sys.argv[3] == "1"
    process_live = sys.argv[4] == "1"
    active_step_pid_alive = sys.argv[5] == "1"
    watchdog_status = sys.argv[6]
    chain_complete = sys.argv[7] == "1"
    relaunch_command = sys.argv[8]
    needs_human = sys.argv[9] == "1"
    repair_active = sys.argv[10] == "1"
    
    classification = classify_cloud_custody(
        session_id=session_id,
        supervisor_identity=supervisor_identity,
        tmux_live=tmux_live,
        process_live=process_live,
        active_step_worker_pid_liveness=active_step_pid_alive,
        watchdog_status=watchdog_status,
        chain_complete=chain_complete,
        relaunch_command=relaunch_command,
        relaunch_command_available=bool(relaunch_command),
        needs_human=needs_human,
        repair_active=repair_active,
    )
    
    emit("PLAN_STATUS_CUSTODY_KIND", classification.custody_kind)
    emit("PLAN_STATUS_CUSTODY_SESSION_ID", classification.session_id)
    emit("PLAN_STATUS_CUSTODY_SUPERVISOR_IDENTITY", classification.supervisor_identity)
    emit("PLAN_STATUS_CUSTODY_ACTIVE_STEP_PID_LIVE", "1" if classification.active_step_worker_pid_liveness else "0")
    emit("PLAN_STATUS_CUSTODY_UNMANAGED_PROCESS", "1" if classification.custody_kind == CUSTODY_UNMANAGED_WARNING else "0")
    emit("PLAN_STATUS_CUSTODY_LIVE_PROCESS_FINGERPRINTS", ",".join(classification.live_process_fingerprints))
    emit("PLAN_STATUS_CUSTODY_RELAUNCH_COMMAND_AVAILABLE", "1" if classification.relaunch_command_available else "0")
    emit("PLAN_STATUS_CUSTODY_FAILURE_REASONS", "; ".join(classification.failure_reasons))
    emit("PLAN_STATUS_CUSTODY_EVIDENCE_TIMESTAMP", classification.evidence_timestamp)
    emit("PLAN_STATUS_CUSTODY_CONTRACT_ID", classification.contract_id)
    emit("PLAN_STATUS_CUSTODY_BOUNDARY_ID", classification.boundary_id)
    PY
      facts="$(<"$facts_file")"
      rm -f "$facts_file"
      if [[ -n "$facts" ]]; then
        eval "$facts"
      fi
    }
    
    adopt_unmarked_tmux_sessions() {
      local discover_bin="${DISCOVER_BIN:-$SRC_DIR/arnold_pipelines/megaplan/cloud/wrappers/arnold-cloud-discover}"
      [[ -f "$discover_bin" ]] || return 0
    
      # Discovery is retained for operator diagnostics only.  A tmux session has
      # no marker-bound namespace/start identity, so it may not synthesize a
      # marker (which would in turn admit repair/relaunch/retirement control).
      while IFS=$'\t' read -r session workspace remote_spec run_kind plan_name relaunch_command; do
        [[ -n "${session:-}" ]] || continue
        printf '%s\t%s\t%s\t%s\t%s\n' "$session" "$workspace" "$remote_spec" "${run_kind:-chain}" "${plan_name:-}"
      done < <(bash "$discover_bin" tmux-unmarked --marker-dir "$MARKER_DIR" --src-dir "$SRC_DIR")
    }
    
    repo_url_with_token() {
      local repo="$1"
      if [[ "$repo" == https://github.com/* && "$repo" != https://*@github.com/* && -n "${GITHUB_TOKEN:-}" ]]; then
        printf 'https://x-access-token:%s@github.com/%s' "$GITHUB_TOKEN" "${repo#https://github.com/}"
      else
        printf '%s' "$repo"
      fi
    }
    
    emit_report() {
      local items_path="$1"
      local markers="$2"
      local report_tmp
      if ! report_tmp="$(mktemp)"; then
        log "report publication skipped: unable to allocate summary temp file"
        return 0
      fi
      if ! PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$items_path" "$markers" "$REPORT_PATH" "$REPORT_ARCHIVE_DIR" "$REPAIR_ENABLED" "$PUSH_REPAIRS" <<'PY' > "$report_tmp"; then
    import datetime as dt
    import json
    import os
    import sys
    import tempfile
    
    from arnold_pipelines.megaplan.cloud.redact import redact_payload
    
    items_path, markers, report_path, archive_dir, repair, push = sys.argv[1:]
    items = []
    if os.path.exists(items_path):
        with open(items_path, encoding="utf-8") as handle:
            for line in handle:
                line = line.strip()
                if line:
                    items.append(json.loads(line))
    issues = [
        item for item in items
        if item.get("status") not in {"alive", "complete", "completed", "restarted", "synced", "skipped"}
    ]
    restarted = [item for item in items if item.get("status") == "restarted"]
    reaped = [item for item in items if item.get("status") == "reaped"]
    needs_human = [item for item in items if item.get("status") == "needs_human"]
    webhook_notifications = [
        item for item in items
        if item.get("action") == "notify" and item.get("status") == "webhook_sent"
    ]
    now = dt.datetime.now(dt.timezone.utc)
    timestamp = now.isoformat()
    archive_name = now.strftime("%Y%m%dT%H%M%SZ") + ".json"
    archive_path = os.path.join(archive_dir, archive_name) if archive_dir else ""
    payload = {
        "timestamp_utc": timestamp,
        "marker_dir": os.environ.get("CLOUD_WATCHDOG_MARKER_DIR", "/workspace/.megaplan/cloud-sessions"),
        "markers_seen": int(markers),
        "sessions_seen": len(items),
        "alive_sessions": sum(1 for item in items if item.get("status") == "alive"),
        "restarted_sessions": len(restarted),
        "reaped_repairs": len(reaped),
        "needs_human_sessions": len(needs_human),
        "webhook_notifications_sent": len(webhook_notifications),
        "issue_count": len(issues),
        "codex_repair_enabled": repair == "1",
        "push_repairs_enabled": push == "1",
        "latest_report_path": report_path,
        "archive_report_path": archive_path,
        "items": items,
        "issues": issues,
    }
    payload = redact_payload(payload)
    encoded = (json.dumps(payload, indent=2, sort_keys=True) + "\n").encode("utf-8")
    
    def atomic_publish(path, content):
        parent = os.path.dirname(path) or "."
        os.makedirs(parent, exist_ok=True)
        fd, tmp_path = tempfile.mkstemp(prefix=f".{os.path.basename(path)}.", suffix=".tmp", dir=parent)
        try:
            with os.fdopen(fd, "wb") as handle:
                handle.write(content)
                handle.flush()
                os.fsync(handle.fileno())
            os.replace(tmp_path, path)
            dir_fd = os.open(parent, os.O_RDONLY)
            try:
                os.fsync(dir_fd)
            finally:
                os.close(dir_fd)
        except BaseException:
            try:
                os.unlink(tmp_path)
            except FileNotFoundError:
                pass
            raise
    
    atomic_publish(report_path, encoded)
    if archive_path:
        try:
            atomic_publish(archive_path, encoded)
        except OSError as exc:
            print(f"watchdog archive publication failed: {exc}", file=sys.stderr)
    print(json.dumps(payload, sort_keys=True))
    PY
        log "report publication failed; retained last complete report"
        rm -f "$report_tmp"
        return 0
      fi
      # Reports remain local evidence; provider delivery is owned by a
      # durable outbox worker, never by the watchdog observer.
      local summary
      summary="$(cat "$report_tmp")"
      log "report $summary"
      if [[ -n "$REPORT_WEBHOOK" ]]; then
        log "report webhook delivery deferred to canonical outbox worker"
      fi
      rm -f "$report_tmp"
    }
    
    write_watchdog_heartbeat() {
      # Touch a freshness probe at sweep START so the resident can detect a stalled
      # watchdog even when a later step (git sync / pip refresh)
      # hangs before the snapshot write completes (watchdog-snapshot-staleness-fix.md
      # P2). Best-effort; never fails a sweep.
      local status_dir="${1:-$STATUS_DIR}"
      mkdir -p "$status_dir" 2>/dev/null || true
      python3 - "$status_dir" <<'PY' 2>/dev/null || date -u +"%Y-%m-%dT%H:%M:%SZ" > "$status_dir/watchdog.heartbeat" 2>/dev/null || true
    import datetime, pathlib, sys
    p = pathlib.Path(sys.argv[1]) / "watchdog.heartbeat"
    p.write_text(datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z") + "\n")
    PY
    }
    
    record_snapshot_write_outcome() {
      # Track consecutive snapshot-write failures (watchdog-snapshot-staleness-fix.md
      # P2): "ok" resets the counter and clears the error sidecar; "fail" bumps it,
      # and once it reaches SNAPSHOT_FAILURE_THRESHOLD drops a visible
      # cloud-status.write-error.json so consumers know the cache is frozen. Prints
      # the failure count on "fail" (for logging); prints nothing on "ok".
      local status_dir="${1:-$STATUS_DIR}"
      local outcome="${2:-ok}"
      local threshold="${SNAPSHOT_FAILURE_THRESHOLD:-3}"
      python3 - "$status_dir" "$outcome" "$threshold" <<'PY' 2>/dev/null || authority_gap_continue "T29-BYPASS-131" "authority-risk bypass converted to typed evidence gap"
    import datetime, json, pathlib, sys
    status_dir, outcome, threshold = sys.argv[1], sys.argv[2], int(sys.argv[3] or 3)
    base = pathlib.Path(status_dir)
    counter_path = base / "snapshot-failures.json"
    err_path = base / "cloud-status.write-error.json"
    now = datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z")
    if outcome == "ok":
        for p in (counter_path, err_path):
            try:
                p.unlink()
            except FileNotFoundError:
                pass
        sys.exit(0)
    try:
        failures = json.loads(counter_path.read_text()).get("failures", 0) + 1 if counter_path.exists() else 1
    except Exception:
        failures = 1
    counter_path.write_text(json.dumps({"failures": failures, "last_at": now}) + "\n")
    if failures >= threshold:
        err_path.write_text(json.dumps({
            "error": "cloud-status snapshot write has failed %d consecutive sweeps; cache may be frozen" % failures,
            "failures": failures,
            "at": now,
        }) + "\n")
    print(failures)
    PY
    }
    
    write_status_snapshot() {
      # Produce the canonical cloud-status.json. Built from local observation only
      # (marker dir + the report emit_report wrote). The 4th arg ("track" default vs
      # "notrack") decides whether a failure counts toward escalation — the early
      # best-effort write at sweep start uses "notrack" so only authoritative
      # end-of-sweep write failures escalate. Never let a snapshot failure break the
      # watchdog sweep — count/log and move on.
      local marker_dir="${1:-$MARKER_DIR}"
      local report_path="${2:-$REPORT_PATH}"
      local status_dir="${3:-$STATUS_DIR}"
      local track="${4:-track}"
      if PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$marker_dir" "$report_path" "$status_dir" <<'PY' 2>>"${LOG:-/dev/null}"; then
    import sys
    from pathlib import Path
    
    from arnold_pipelines.megaplan.cloud import status_snapshot
    
    marker_dir, report_path, status_dir = (Path(p) for p in sys.argv[1:4])
    status_snapshot.build_and_write_snapshot(
        marker_dir=marker_dir,
        watchdog_report_path=report_path,
        path=status_dir / "cloud-status.json",
        previous_path=status_dir / "cloud-status.previous.json",
    )
    PY
        [[ "$track" != "notrack" ]] && record_snapshot_write_outcome "$status_dir" ok
      else
        if [[ "$track" != "notrack" ]]; then
          local _failures
          _failures="$(record_snapshot_write_outcome "$status_dir" fail)"
          log "status snapshot write failed (${_failures:-?} consecutive; threshold ${SNAPSHOT_FAILURE_THRESHOLD:-3})"
        else
          log "status snapshot early write failed (best-effort; not counted)"
        fi
      fi
    
      # --- custody disagreement detection ---
      # Compare the watchdog's custody classification (produced during session
      # processing and recorded in the watchdog report) with each session's custody
      # in the freshly-written status snapshot.  Disagreements are emitted as
      # structured custody_disagreement report items so S4 consumers can act on
      # them without re-deriving custody from scratch.
      if [[ "$track" != "notrack" ]]; then
        detect_custody_disagreement "$report_path" "$status_dir/cloud-status.json" || authority_gap_continue "T29-BYPASS-132" "authority-risk bypass converted to typed evidence gap"
      fi
    }
    
    detect_custody_disagreement() {
      local report_path="$1"
      local snapshot_path="$2"
      local disagreement_output disagreement_file
      disagreement_file="$(mktemp "${TMPDIR:-/tmp}/arnold-watchdog-disagreement.XXXXXX")" || return 0
      PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$report_path" "$snapshot_path" >"$disagreement_file" 2>>"${LOG:-/dev/null}" <<'PY' || authority_gap_continue "T29-BYPASS-133" "authority-risk bypass converted to typed evidence gap"
    import json
    import sys
    from pathlib import Path
    
    report_path = Path(sys.argv[1])
    snapshot_path = Path(sys.argv[2])
    
    if not report_path.exists() or not snapshot_path.exists():
        raise SystemExit(0)
    
    try:
        report = json.loads(report_path.read_text(encoding="utf-8"))
        snapshot = json.loads(snapshot_path.read_text(encoding="utf-8"))
    except Exception:
        raise SystemExit(0)
    
    if not isinstance(report, dict) or not isinstance(snapshot, dict):
        raise SystemExit(0)
    
    # Build a lookup of watchdog custody items by session from the report.
    report_items = report.get("items")
    if not isinstance(report_items, list):
        raise SystemExit(0)
    
    watchdog_custody = {}
    for item in report_items:
        if not isinstance(item, dict):
            continue
        if item.get("action") != "custody":
            continue
        session = item.get("session")
        if not isinstance(session, str) or not session:
            continue
        summary = item.get("summary")
        if not isinstance(summary, str):
            continue
        # Parse custody_kind from summary "custody_kind=...; ..."
        kind = ""
        for part in summary.split(";"):
            part = part.strip()
            if part.startswith("custody_kind="):
                kind = part[len("custody_kind="):]
                break
        if kind:
            watchdog_custody[session] = kind
    
    # Compare with each snapshot session's cloud_custody.
    snapshot_sessions = snapshot.get("sessions")
    if not isinstance(snapshot_sessions, list):
        raise SystemExit(0)
    
    disagreements = []
    for session_entry in snapshot_sessions:
        if not isinstance(session_entry, dict):
            continue
        session = session_entry.get("session")
        if not isinstance(session, str) or not session:
            continue
        snapshot_custody = session_entry.get("cloud_custody")
        if not isinstance(snapshot_custody, dict):
            continue
        snapshot_kind = snapshot_custody.get("custody_kind", "")
    
        wd_kind = watchdog_custody.get(session, "")
        if not wd_kind or not snapshot_kind:
            continue
    
        if wd_kind != snapshot_kind:
            disagreements.append(
                f"session={session} watchdog_custody={wd_kind} snapshot_custody={snapshot_kind}"
            )
    
    if disagreements:
        for line in disagreements:
            print(line)
    PY
      disagreement_output="$(<"$disagreement_file")"
      rm -f "$disagreement_file"
      if [[ -n "$disagreement_output" ]]; then
        while IFS= read -r line; do
          [[ -n "$line" ]] || continue
          log "custody_disagreement: $line"
        done <<< "$disagreement_output"
      fi
    }
    
    sync_cloud_runtime_wrappers() {
      local wrapper_src_dir="$SRC_DIR/arnold_pipelines/megaplan/cloud/wrappers"
      local wrapper_dest_dir="/usr/local/bin"
      local support_dest_dir="/usr/local/share/arnold-watchdog"
      local wrapper dest
      [[ -d "$wrapper_src_dir" ]] || return 0
    
      mkdir -p "$wrapper_dest_dir" "$support_dest_dir"
      for wrapper in "$wrapper_src_dir"/arnold-* "$wrapper_src_dir"/mp-*; do
        [[ -f "$wrapper" ]] || continue
        dest="$wrapper_dest_dir/$(basename "$wrapper")"
        if [[ -f "$dest" ]] && cmp -s "$wrapper" "$dest"; then
          continue
        fi
        install -m 0755 "$wrapper" "$dest" || return 1
      done
      if [[ -f "$wrapper_src_dir/principles.md" ]]; then
        dest="$support_dest_dir/principles.md"
        if [[ ! -f "$dest" ]] || ! cmp -s "$wrapper_src_dir/principles.md" "$dest"; then
          install -m 0644 "$wrapper_src_dir/principles.md" "$dest" || return 1
        fi
      fi
    }
    
    refresh_editable_install() {
      # The supervisor interpreter is immutable for its lifetime. Source updates
      # are consumed through PYTHONPATH and atomically copied wrappers; never run an
      # in-place pip reinstall from inside the process that is doing observation.
      log "refreshing Arnold source-backed supervisor from $SRC_DIR without mutating interpreter"
      sync_cloud_runtime_wrappers >> "$LOG" 2>&1 || return 1
    
      PYTHONSAFEPATH=1 PYTHONPATH="$SRC_DIR:${PYTHONPATH:-}" python3 -P - <<'PY' >> "$LOG" 2>&1
    import yaml  # noqa: F401
    import arnold_pipelines.megaplan.cloud.cli  # noqa: F401
    import arnold_pipelines.megaplan.cloud.repair_contract  # noqa: F401
    PY
    }
    
    ensure_editable_source_checkout() {
      if [[ -d "$SRC_DIR/.git" ]]; then
        return 0
      fi
    
      local repo="$SYNC_REPO"
      if [[ -z "$repo" && -d /workspace/Arnold/.git ]]; then
        repo="$(cd /workspace/Arnold && git remote get-url origin 2>/dev/null || true)"
      fi
      if [[ -z "$repo" ]]; then
        log "editable source checkout missing at $SRC_DIR and no repo URL is configured"
        return 1
      fi
    
      log "cloning editable source checkout branch=$SYNC_BRANCH into $SRC_DIR"
      mkdir -p "$(dirname "$SRC_DIR")"
      timeout "$SYNC_TIMEOUT_SECS" git clone --branch "$SYNC_BRANCH" "$(repo_url_with_token "$repo")" "$SRC_DIR" >> "$LOG" 2>&1
    }
    
    sync_skills_in_source() {
      local source_dir="$1"
      if [[ -f "$source_dir/scripts/generate_arnold_docs.py" ]]; then
        log "regenerating Arnold docs/skills in $source_dir"
        (cd "$source_dir" && python3 scripts/generate_arnold_docs.py --write) >> "$LOG" 2>&1 || {
          log "generated docs/skills sync failed"
          return 1
        }
      fi
      if [[ -x "$source_dir/sync-skills.sh" ]]; then
        log "syncing installed agent skills from $source_dir"
        (cd "$source_dir" && ./sync-skills.sh) >> "$LOG" 2>&1 || {
          log "installed skill sync failed"
          return 1
        }
      else
        log "sync-skills.sh missing or not executable in $source_dir; skipping installed skill symlinks"
      fi
      sync_extra_cloud_skills
    }
    
    sync_extra_cloud_skills() {
      if [[ ! -d "$EXTRA_SKILLS_DIR" ]]; then
        log "extra cloud skills dir missing at $EXTRA_SKILLS_DIR; skipping"
        return 0
      fi
    
      local target_dirs=(
        "$HOME/.claude/skills"
        "$HOME/.codex/skills"
        "$HOME/.agents/skills"
        "$HOME/.hermes/skills"
      )
      local skill_dir name target_dir dest created skipped updated
      created=0
      skipped=0
      updated=0
      log "syncing extra cloud skills from $EXTRA_SKILLS_DIR"
      for skill_dir in "$EXTRA_SKILLS_DIR"/*/; do
        [[ -d "$skill_dir" && -f "$skill_dir/SKILL.md" ]] || continue
        name="$(basename "$skill_dir")"
        for target_dir in "${target_dirs[@]}"; do
          mkdir -p "$target_dir"
          dest="$target_dir/$name"
          if [[ -L "$dest" ]]; then
            ln -sfn "$skill_dir" "$dest"
            updated=$((updated + 1))
          elif [[ -e "$dest" ]]; then
            skipped=$((skipped + 1))
          else
            ln -s "$skill_dir" "$dest"
            created=$((created + 1))
          fi
        done
      done
      log "extra cloud skills synced created=$created updated=$updated skipped=$skipped"
    }
    
    sync_editable_source_branch() {
      local report_items="$1"
      if [[ "$SYNC_ENABLED" != "1" ]]; then
        log "editable source sync disabled"
        report_item "$report_items" "editable-install" "sync" "skipped" "sync disabled" "$SRC_DIR" "$SYNC_BRANCH"
        return 0
      fi
      if [[ -z "$SYNC_BRANCH" ]]; then
        log "editable source sync skipped; no branch configured"
        report_item "$report_items" "editable-install" "sync" "sync_failed" "no sync branch configured" "$SRC_DIR"
        return 1
      fi
    
      ensure_editable_source_checkout || {
        report_item "$report_items" "editable-install" "sync" "sync_failed" "source checkout unavailable" "$SRC_DIR" "$SYNC_BRANCH"
        return 1
      }
    
      if [[ ! -d "$SRC_DIR/.git" ]]; then
        report_item "$report_items" "editable-install" "sync" "sync_failed" "source checkout missing git metadata" "$SRC_DIR" "$SYNC_BRANCH"
        return 1
      fi
    
      local before after status branch
      before="$(cd "$SRC_DIR" && git rev-parse --short HEAD 2>/dev/null || true)"
      log "syncing editable source branch=$SYNC_BRANCH dir=$SRC_DIR before=$before"
      (
        cd "$SRC_DIR" &&
        git config --global --add safe.directory "$SRC_DIR" >/dev/null 2>&1 || authority_gap_continue "T29-BYPASS-136" "authority-risk bypass converted to typed evidence gap" &&
        timeout "$SYNC_TIMEOUT_SECS" git fetch origin "$SYNC_BRANCH" --prune &&
        branch="$(git branch --show-current)" &&
        if [[ "$branch" != "$SYNC_BRANCH" ]]; then
          if [[ -n "$(git status --porcelain)" ]]; then
            echo "cannot switch from $branch to $SYNC_BRANCH: checkout has local changes" >&2
            exit 12
          fi
          git checkout "$SYNC_BRANCH"
        fi &&
        timeout "$SYNC_TIMEOUT_SECS" git pull --ff-only origin "$SYNC_BRANCH"
      ) >> "$LOG" 2>&1 || {
        log "editable source fetch/pull failed"
        report_item "$report_items" "editable-install" "sync" "sync_failed" "fetch/pull failed" "$SRC_DIR" "$SYNC_BRANCH"
        return 1
      }
    
      sync_skills_in_source "$SRC_DIR" || {
        report_item "$report_items" "editable-install" "sync" "sync_failed" "skill sync failed" "$SRC_DIR" "$SYNC_BRANCH"
        return 1
      }
    
      status="$(cd "$SRC_DIR" && git status --porcelain -- arnold_pipelines/megaplan/skills)"
      if [[ -n "$status" ]]; then
        log "committing editable skill sync drift"
        (
          cd "$SRC_DIR" &&
          git add -A -- arnold_pipelines/megaplan/skills &&
          git commit -m "Sync cloud editable install and skills" &&
          timeout "$SYNC_TIMEOUT_SECS" git push origin "$SYNC_BRANCH"
        ) >> "$LOG" 2>&1 || {
          log "editable skill sync commit/push failed"
          report_item "$report_items" "editable-install" "sync" "sync_failed" "skill sync commit/push failed" "$SRC_DIR" "$SYNC_BRANCH"
          return 1
        }
      else
        log "editable source has no skill sync drift to push"
      fi
    
      status="$(cd "$SRC_DIR" && git status --porcelain)"
      if [[ -n "$status" ]]; then
        log "editable source has non-sync drift; leaving uncommitted"
        report_item "$report_items" "editable-install" "sync" "sync_dirty" "source checkout has non-sync drift; not auto-committing" "$SRC_DIR" "$SYNC_BRANCH"
      fi
    
      refresh_editable_install || {
        log "editable install refresh after sync failed"
        report_item "$report_items" "editable-install" "sync" "sync_failed" "refresh failed" "$SRC_DIR" "$SYNC_BRANCH"
        return 1
      }
    
      after="$(cd "$SRC_DIR" && git rev-parse --short HEAD 2>/dev/null || true)"
      report_item "$report_items" "editable-install" "sync" "synced" "editable source branch synced and refreshed ($before -> $after)" "$SRC_DIR" "$SYNC_BRANCH"
    
      # ── Codex 2026-08-17: fail-closed promotion transaction ────────────────
      # Replace the unconditional auto-advance. Publication of source and
      # activation of a runtime generation are ONE atomic transaction. On any
      # failure the old generation G stays dispatchable; the checkout being at
      # G+1 must NOT invalidate a running G.
      if [[ -n "$before" && -n "$after" && "$before" != "$after" && -n "${ARNOLD_RUNTIME_MANIFEST:-}" && -f "${ARNOLD_RUNTIME_MANIFEST:-}" ]]; then
        candidate_full="$(cd "$SRC_DIR" && git rev-parse "refs/remotes/origin/$SYNC_BRANCH" 2>/dev/null || true)"
        local_head="$(cd "$SRC_DIR" && git rev-parse HEAD 2>/dev/null || true)"
        if [[ -z "$candidate_full" || ${#candidate_full} -ne 40 ]]; then
          log "promotion refused: cannot resolve full SHA of refs/remotes/origin/$SYNC_BRANCH"
        elif [[ "$local_head" != "$candidate_full" ]]; then
          log "promotion refused: local HEAD ($local_head) != origin/$SYNC_BRANCH ($candidate_full)"
        elif [[ -n "$(cd "$SRC_DIR" && git status --porcelain)" ]]; then
          log "promotion refused: checkout is not clean"
        else
          promotion_lock="${ARNOLD_RUNTIME_MANIFEST:-}.promotion.lock"
          (
            flock -x 9 || { log "promotion refused: could not acquire promotion lock"; exit 1; }
            PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$ARNOLD_RUNTIME_MANIFEST" "$candidate_full" "$SRC_DIR" "$before" "$after" <<'PY' >> "$LOG" 2>&1
    import json, sys
    from pathlib import Path
    from arnold_pipelines.megaplan.cloud.runtime_manifest import (
        ManifestError, advance_generation, load_manifest, write_active_pointer, active_manifest_path,
    )
    from arnold_pipelines.megaplan.cloud.install_sync import ensure_dependency_generation
    
    manifest_path, new_commit, runtime_root, before, after = sys.argv[1:6]
    manifest = load_manifest(Path(manifest_path))
    # no-op when already at the candidate generation
    if str(manifest.epic.get("expected_head") or "") == new_commit:
        print("promotion no-op: manifest already at", new_commit)
        sys.exit(0)
    # build/select the matching content-addressed dependency generation for the
    # candidate checkout's frozen spec BEFORE advancing (fail-closed).
    generations_root = Path(__import__("os").environ.get("ARNOLD_GENERATIONS_ROOT", "/workspace/.megaplan/generations"))
    proof = ensure_dependency_generation(runtime_root, generations_root)
    advanced = advance_generation(manifest, new_commit, reason=f"promotion after engine sync ({before} -> {after})", dependency_generation=proof)
    pointer = active_manifest_path()
    if Path(manifest_path).expanduser().resolve(strict=False) == pointer.expanduser().resolve(strict=False):
        write_active_pointer(advanced, pointer)
    else:
        write_active_pointer(advanced, pointer)
        from arnold_pipelines.megaplan.cloud.runtime_manifest import write_manifest
        write_manifest(advanced, Path(manifest_path))
    print("promotion advanced to generation", advanced.generation, "head", new_commit)
    PY
            rc=$?
            if [[ $rc -eq 0 ]]; then
              log "manifest promotion succeeded after engine sync ($before -> $after)"
            else
              log "manifest promotion FAILED (rc=$rc) after engine sync; old generation stays dispatchable"
            fi
          ) 9>"${promotion_lock}"
        fi
      fi
    }
    
    codex_repair_editable_install() {
      local reason="$1"
      if [[ "$REPAIR_ENABLED" != "1" ]]; then
        log "editable install check failed; repair disabled (set ARNOLD_REPAIR_TRIGGER_ENABLED=1): $reason"
        return 1
      fi
      if [[ ! -d "$SRC_DIR/.git" ]]; then
        log "Codex repair skipped; source checkout missing at $SRC_DIR"
        return 1
      fi
      if ! command -v codex >/dev/null 2>&1; then
        log "Codex repair skipped; codex CLI unavailable"
        return 1
      fi
    
      local prompt reason_digest source_repair_id
      prompt="$(mktemp)"
      cat > "$prompt" <<EOF
    You are running inside an Arnold cloud worker. The editable Arnold install failed this watchdog check:
    
    $reason
    
    Working directory: $SRC_DIR
    
    Fix only the Arnold source checkout so the cloud worker can import and run:
    python3 -c "import arnold_pipelines.megaplan.cloud.cli"
    
    The editable install checkout must stay on branch $SYNC_BRANCH. Do not use
    MEGAPLAN_REF or the active workflow checkout branch to choose the repair branch.
    
    Keep the patch narrowly scoped. Run the smallest relevant verification. Do not ask for input.
    EOF
      redact_file_in_place "$prompt"
      reason_digest="$(printf '%s' "$reason" | sha256sum | awk '{print $1}')"
      source_repair_id="watchdog-source-repair:${reason_digest}"
    
      log "starting Codex editable-install repair in $SRC_DIR"
      # Step 57: managed-agent launches may NEVER become accepted repair outside
      # canonical simple_fixer delegation.  Classify the launch before forking the
      # Codex managed-agent process (SC38).
      _child_gate_json="$(child_agent_launch_authority_or_reject live_watchdog arnold-watchdog)" || true
      _child_gate_outcome="$(printf '%s' "$_child_gate_json" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("outcome",""))' 2>/dev/null || true)"
      if [[ "$_child_gate_outcome" == "zero_authority_rejected" ]]; then
        authority_fail_closed "T57-MANAGED-AGENT-FANOUT-01"
        log "Codex editable-install managed-agent launch rejected by child-agent authority gate: $_child_gate_json"
        return 1
      fi
      (
        cd "$SRC_DIR" &&
        python3 -m arnold_pipelines.megaplan.managed_agent run \
          --run-kind automatic_watchdog_source_repair \
          --identity-key "$source_repair_id" \
          --project-dir "$SRC_DIR" \
          --task-kind debugging \
          --difficulty 8 \
          --model "$CODEX_REPAIR_MODEL" \
          --reasoning-effort high \
          --route-class watchdog_editable_install_repair \
          --backend codex \
          --command-display "watchdog editable-install Codex repair" \
          --origin-kind watchdog_source_repair \
          --origin-id "$source_repair_id" \
          --origin-component arnold-watchdog \
          --trigger-id "$reason_digest" \
          --lineage-key watchdog-source-repair \
          --stdin-file "$prompt" \
          --require-output \
          --link phase=editable_install_repair \
          -- timeout "$CODEX_TIMEOUT" codex exec --sandbox danger-full-access \
            -c model="$CODEX_REPAIR_MODEL" -c model_reasoning_effort=high -
      ) >> "$LOG" 2>&1
      local rc=$?
      rm -f "$prompt"
      if [[ $rc -ne 0 ]]; then
        log "Codex repair failed rc=$rc"
        return "$rc"
      fi
    
      if ! (cd "$SRC_DIR" && python3 - <<'PY' >> "$LOG" 2>&1
    import arnold_pipelines.megaplan.cloud.cli  # noqa: F401
    PY
      ); then
        log "Codex repair completed but import check still fails"
        return 1
      fi
    
      if (cd "$SRC_DIR" && git diff --quiet && git diff --cached --quiet); then
        log "Codex repair produced no source changes"
        return 0
      fi
    
      (
        cd "$SRC_DIR" &&
        git add -A &&
        git commit -m "Fix cloud editable install from watchdog"
      ) >> "$LOG" 2>&1 || {
        log "repair commit failed"
        return 1
      }
    
      if [[ "$PUSH_REPAIRS" == "1" ]]; then
        log "pushing watchdog repair commit"
        (cd "$SRC_DIR" && git push) >> "$LOG" 2>&1 || {
          log "repair push failed"
          return 1
        }
      else
        log "repair committed locally; push disabled (set CLOUD_WATCHDOG_PUSH_REPAIRS=1)"
      fi
    }
    
    ensure_install_or_repair() {
      local output
      output="$(mktemp)"
      if refresh_editable_install > "$output" 2>&1; then
        cat "$output" >> "$LOG"
        rm -f "$output"
        return 0
      fi
      local reason
      reason="$(cat "$output")"
      cat "$output" >> "$LOG"
      rm -f "$output"
      codex_repair_editable_install "$reason"
    }
    
    write_watchdog_observation_error() {
      local reason="$1"
      local status_dir="${2:-$STATUS_DIR}"
      local stamp tmp target
      mkdir -p "$status_dir" 2>/dev/null || return 1
      stamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      target="$status_dir/watchdog-observation-failure.json"
      tmp="$(mktemp "$status_dir/.watchdog-observation-failure.XXXXXX")" || return 1
      printf '{"at":"%s","error":"watchdog observation bootstrap failed; watchdog report may be stale","reason":"observation_runtime_not_ready","schema_version":"arnold-watchdog-observation-failure-v1","status":"failed"}\n' \
        "$stamp" > "$tmp"
      mv -f "$tmp" "$target"
      # Preserve the legacy consumer path with the same atomic payload.
      tmp="$(mktemp "$status_dir/.cloud-status.write-error.XXXXXX")" || return 1
      cp "$target" "$tmp"
      mv -f "$tmp" "$status_dir/cloud-status.write-error.json"
      log "watchdog observation failure persisted atomically: ${reason:-unknown}"
    }
    
    write_watchdog_sweep_health() {
      local phase="$1"
      local status_dir="${2:-$STATUS_DIR}"
      local target="$status_dir/watchdog-sweep.${phase}.json"
      local tmp stamp
      mkdir -p "$status_dir"
      stamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      tmp="$(mktemp "$status_dir/.watchdog-sweep.${phase}.XXXXXX")" || return 1
      printf '{"at":"%s","phase":"%s","schema_version":"arnold-watchdog-sweep-health-v1"}\n' \
        "$stamp" "$phase" > "$tmp"
      mv -f "$tmp" "$target"
    }
    
    watchdog_observation_runtime_check() {
      local output rc
      output="$(mktemp)"
      if ! PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - <<'PY' >"$output" 2>&1; then
    import yaml  # noqa: F401
    import arnold_pipelines.megaplan.cloud.cli  # noqa: F401
    import arnold_pipelines.megaplan.cloud.status_snapshot  # noqa: F401
    PY
        cat "$output"
        rm -f "$output"
        return 1
      fi
      rm -f "$output"
      return 0
    }
    
    bootstrap_watchdog_observation() {
      local report_items="$1"
      local reason=""
      WATCHDOG_BOOTSTRAP_RECOVERED=0
      if reason="$(watchdog_observation_runtime_check 2>&1)"; then
        return 0
      fi
      # Fail closed. Attempting pip/source repair from a blind observer caused the
      # original boot/install race and could leave a live-but-sleeping watchdog.
      reason="$(printf '%s' "$reason" | tr '\n' ' ' | sed 's/[[:space:]]\\+/ /g' | sed 's/^ //; s/ $//')"
      [[ -n "$reason" ]] || reason="watchdog observation runtime check failed"
      log "watchdog observation bootstrap failed closed: $reason"
      report_item "$report_items" "watchdog" "observe" "observation_blind" "watchdog observation bootstrap failed closed: $reason" "$SRC_DIR" "$SYNC_BRANCH"
      write_watchdog_observation_error "$reason"
      return 1
    }
    
    matching_runner_process_alive() {
      local workspace="$1"
      local remote_spec="$2"
      local run_kind="${3:-chain}"
      local plan_name="${4:-}"
      PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$workspace" "$remote_spec" "$run_kind" "$plan_name" <<'PY'
    import hashlib
    import json
    import os
    import subprocess
    import sys
    from pathlib import Path
    
    workspace = Path(sys.argv[1])
    remote_spec_raw = sys.argv[2]
    run_kind = sys.argv[3]
    plan_name = sys.argv[4]
    
    
    def pid_alive(value: object) -> bool:
        try:
            pid = int(value)
        except (TypeError, ValueError):
            return False
        if pid <= 0:
            return False
        try:
            os.kill(pid, 0)
        except OSError:
            return False
        return True
    
    
    def add_unique(values: list[str], value: object) -> None:
        if isinstance(value, str):
            cleaned = value.strip()
            if cleaned and cleaned not in values:
                values.append(cleaned)
    
    
    def load_json(path: Path) -> dict[str, object]:
        try:
            payload = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            return {}
        return payload if isinstance(payload, dict) else {}
    
    
    def process_matches() -> bool:
        if run_kind not in {"chain", "epic_chain"} or not remote_spec_raw:
            return False
        try:
            proc = subprocess.run(
                ["ps", "-eww", "-o", "pid=", "-o", "args="],
                check=False,
                capture_output=True,
                text=True,
            )
        except Exception:
            return False
        if proc.returncode != 0:
            return False
        ignored_pids = {os.getpid(), os.getppid()}
        command = "arnold_pipelines.megaplan chain start" if run_kind == "chain" else "arnold_pipelines.megaplan epic-chain start"
        for line in proc.stdout.splitlines():
            stripped = line.strip()
            if not stripped:
                continue
            try:
                pid_text, args = stripped.split(None, 1)
                pid = int(pid_text)
            except (ValueError, TypeError):
                continue
            if pid in ignored_pids:
                continue
            if command in args and "--spec" in args and remote_spec_raw in args:
                return True
        return False
    
    
    if process_matches():
        raise SystemExit(0)
    
    candidate_plans: list[str] = []
    add_unique(candidate_plans, plan_name)
    
    if remote_spec_raw:
        try:
            spec_path = Path(remote_spec_raw)
            try:
                spec_resolved = spec_path.resolve()
            except Exception:
                spec_resolved = spec_path
            digest = hashlib.sha1(str(spec_resolved).encode("utf-8")).hexdigest()[:12]
            chain_state_candidates = (
                workspace / ".megaplan" / "plans" / ".chains" / f"chain-{digest}.json",
                workspace / ".megaplan" / "plans" / ".chains" / f"{spec_resolved.stem}-{digest}.json",
                spec_resolved.parent / ".megaplan" / "plans" / ".chains" / f"chain-{digest}.json",
                spec_resolved.parent / ".megaplan" / "plans" / ".chains" / f"{spec_resolved.stem}-{digest}.json",
                spec_resolved.with_name("chain_state.json"),
            )
            for candidate in chain_state_candidates:
                if not candidate.exists():
                    continue
                chain_state = load_json(candidate)
                add_unique(candidate_plans, chain_state.get("current_plan_name"))
                add_unique(candidate_plans, chain_state.get("plan_name"))
                break
        except Exception:
            pass
    
    for current_plan in candidate_plans:
        state_path = workspace / ".megaplan" / "plans" / current_plan / "state.json"
        if not state_path.exists():
            continue
        state = load_json(state_path)
        active = state.get("active_step")
        if isinstance(active, dict) and pid_alive(active.get("worker_pid")):
            raise SystemExit(0)
    
    raise SystemExit(1)
    PY
    }
    
    plan_process_is_alive() {
      local plan_name="$1"
      if [[ -z "$plan_name" ]]; then
        return 1
      fi
      if ps -eww -o args= \
        | grep -E "[p]ython[0-9.]*([[:space:]]+-P)?[[:space:]]+-m arnold_pipelines.megaplan (init|auto|resume|plan|prep|critique|revise|gate|finalize|execute|review)" \
        | grep -Eq -- "(--plan[=[:space:]]$plan_name|--name[=[:space:]]$plan_name.*--auto-start|--auto-start.*--name[=[:space:]]$plan_name)"; then
        return 0
      fi
      if ps -eww -o args= \
        | grep -E "[a]rnold (auto|resume)|[m]egaplan (auto|resume)" \
        | grep -Fq -- "--plan $plan_name"; then
        return 0
      fi
      return 1
    }
    
    chain_process_is_alive() {
      local remote_spec="$1"
      if [[ -z "$remote_spec" ]]; then
        return 1
      fi
      if ps -eww -o args= \
        | grep -E "[p]ython[0-9.]*([[:space:]]+-P)?[[:space:]]+-m arnold_pipelines.megaplan chain start" \
        | grep -F -- "--spec" \
        | grep -Fq -- "$remote_spec"; then
        return 0
      fi
      return 1
    }
    
    epic_chain_process_is_alive() {
      local remote_spec="$1"
      if [[ -z "$remote_spec" ]]; then
        return 1
      fi
      if ps -eww -o args= \
        | grep -E "[p]ython[0-9.]*([[:space:]]+-P)?[[:space:]]+-m arnold_pipelines.megaplan epic-chain start" \
        | grep -F -- "--spec" \
        | grep -Fq -- "$remote_spec"; then
        return 0
      fi
      return 1
    }
    
    session_health_status() {
      local session="$1"
      local workspace="$2"
      local remote_spec="$3"
      local run_kind="${4:-chain}"
      local plan_name="${5:-}"
      local wait_status
      if ! tmux has-session -t "$session" 2>/dev/null; then
        if matching_runner_process_alive "$workspace" "$remote_spec" "$run_kind" "$plan_name"; then
          echo "alive"
          return 0
        fi
        if [[ "$run_kind" == "chain" ]]; then
          if chain_process_is_alive "$remote_spec" || plan_process_is_alive "$plan_name"; then
            echo "alive"
            return 0
          fi
          wait_status="$(chain_wait_status "$workspace" "$remote_spec")"
          if [[ "$wait_status" != "none" ]]; then
            echo "$wait_status"
            return 0
          fi
        elif [[ "$run_kind" == "epic_chain" ]]; then
          if epic_chain_process_is_alive "$remote_spec"; then
            echo "alive"
            return 0
          fi
        elif [[ -n "$plan_name" ]] && plan_process_is_alive "$plan_name"; then
          echo "alive"
          return 0
        fi
        echo "stopped"
        return 0
      fi
    
      local pane log_path
      pane="$(tmux capture-pane -pt "$session" -S -120 2>/dev/null || true)"
      if printf '%s\n' "$pane" | grep -Eq 'cmd exited rc=[1-9]|error retry [0-9]+/[0-9]+'; then
        echo "retrying_failure"
        return 0
      fi
    
      if [[ "$run_kind" == "chain" ]]; then
        if [[ "$session" == "megaplan-chain" ]]; then
          log_path="$workspace/.megaplan/cloud-chain.log"
        else
          log_path="$workspace/.megaplan/cloud-chain-${session}.log"
        fi
        if [[ -f "$log_path" ]] && tail -80 "$log_path" 2>/dev/null | grep -Eq '"error": "invalid_spec"|invalid_spec|"error": "git_refresh_failed"|git_refresh_failed|fatal: couldn'\''t find remote ref'; then
          echo "chain_log_failure"
          return 0
        fi
    
        if chain_process_is_alive "$remote_spec"; then
          echo "alive"
          return 0
        fi
    
        wait_status="$(chain_wait_status "$workspace" "$remote_spec")"
        if [[ "$wait_status" != "none" ]]; then
          echo "$wait_status"
          return 0
        fi
      elif [[ "$run_kind" == "epic_chain" ]]; then
        log_path="$workspace/.megaplan/cloud-epic-chain-${session}.log"
        if [[ -f "$log_path" ]] && tail -80 "$log_path" 2>/dev/null | grep -Eq '"error": "invalid_spec"|invalid_spec|"error": "git_refresh_failed"|git_refresh_failed|fatal: couldn'\''t find remote ref'; then
          echo "chain_log_failure"
          return 0
        fi
    
        if epic_chain_process_is_alive "$remote_spec"; then
          echo "alive"
          return 0
        fi
      elif [[ -n "$plan_name" ]]; then
        if plan_process_is_alive "$plan_name"; then
          echo "alive"
          return 0
        fi
      fi
    
      echo "stopped"
    }
    
    verify_relaunch_health() {
      local session="$1"
      local workspace="$2"
      local remote_spec="$3"
      local run_kind="${4:-chain}"
      local plan_name="${5:-}"
      local attempts="${6:-15}"
      local health="stopped"
      local attempt
      for ((attempt = 1; attempt <= attempts; attempt++)); do
        health="$(session_health_status "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name")"
        case "$health" in
          alive|awaiting_pr_merge)
            printf '%s\n' "$health"
            return 0
            ;;
          chain_log_failure|retrying_failure)
            printf '%s\n' "$health"
            return 1
            ;;
        esac
        sleep 1
      done
      printf '%s\n' "$health"
      return 1
    }
    
    kimi_operator_running() {
      local session="$1"
      local pgid_path pgid
      # The layered L1 repair-loop / kimi-goal-operator process scans were removed
      # with the layered repair stack. The pgid marker (legacy dispatch custody)
      # remains the liveness source for the Stage-0 marker state machine: any
      # process group still alive under a recorded dispatch pgid counts as
      # running.
      pgid_path="$(kimi_pgid_path "$session")"
      [[ -r "$pgid_path" ]] || return 1
      read -r pgid < "$pgid_path" || return 1
      [[ "$pgid" =~ ^[0-9]+$ ]] || return 1
      if kill -0 "$pgid" >/dev/null 2>&1; then
        return 0
      fi
      kill -0 -- "-$pgid" >/dev/null 2>&1 || return 1
      if ps -eo pgid= 2>/dev/null \
        | awk -v target="$pgid" '$1 == target { found=1 } END { exit found ? 0 : 1 }'; then
        return 0
      fi
      return 1
    }
    
    # Per-session repair-cycle marker. The watchdog sets it when a stopped session
    # gets a mechanical relaunch; if the session re-stops before becoming healthy,
    # the next tick escalates to the primary repair operator. The historical
    # ".kimi-*" sidecars stay in place because the deduper/reaper already keys on
    # them and the focused Kimi fallback reuses the same process-group tracking.
    # Once repair is actually dispatched, its PGID sidecar distinguishes
    # "repair currently/ran" from the mechanical-first stage.
    # Cleared whenever the session is observed healthy or the direct relaunch
    # fallback consumes the cycle after the repair operator exits without recovery.
    kimi_dispatch_marker_path() {
      printf '%s/%s.kimi-dispatch' "$MARKER_DIR" "$1"
    }
    
    kimi_pgid_path() {
      printf '%s/%s.kimi-pgid' "$MARKER_DIR" "$1"
    }
    
    meta_dispatch_marker_path() {
      printf '%s/%s.meta-dispatch' "$MARKER_DIR" "$1"
    }
    
    meta_pgid_path() {
      printf '%s/%s.meta-pgid' "$MARKER_DIR" "$1"
    }
    
    session_marker_path() {
      printf '%s/%s.json' "$MARKER_DIR" "$1"
    }
    
    repair_progress_snapshot_path() {
      printf '%s/%s.reap-progress.json' "$MARKER_DIR" "$1"
    }
    
    repair_needs_human_path() {
      printf '%s/%s.needs-human.json' "$REPAIR_DATA_DIR" "$1"
    }
    
    chain_health_snapshot_path() {
      printf '%s/%s.chain-health.progress.json' "$MARKER_DIR" "$1"
    }
    
    chain_health_artifact_path() {
      printf '%s/%s.chain-health.json' "$REPAIR_DATA_DIR" "$1"
    }
    
    repair_needs_human_summary() {
      local session="$1"
      python3 - "$(repair_needs_human_path "$session")" <<'PY'
    import json
    import pathlib
    import sys
    
    path = pathlib.Path(sys.argv[1])
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        print("repair loop exhausted; needs human")
        raise SystemExit(0)
    summary = payload.get("summary")
    repair_data_path = payload.get("repair_data_path")
    discord_status = payload.get("discord_status")
    parts = []
    if isinstance(summary, str) and summary:
        parts.append(summary)
    if isinstance(repair_data_path, str) and repair_data_path:
        parts.append(f"repair_data={repair_data_path}")
    if isinstance(discord_status, str) and discord_status:
        parts.append(f"discord={discord_status}")
    print("; ".join(parts) if parts else "repair loop exhausted; needs human")
    PY
    }
    
    repair_needs_human_matches_current_plan() {
      local session="$1"
      local current_plan="${2:-}"
      python3 - "$(repair_needs_human_path "$session")" "$current_plan" <<'PY'
    import json
    import pathlib
    import sys
    
    path = pathlib.Path(sys.argv[1])
    current_plan = (sys.argv[2] or "").strip()
    if not current_plan:
        raise SystemExit(0)
    try:
        marker = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        raise SystemExit(0)
    
    plans: set[str] = set()
    
    def add(value: object) -> None:
        if isinstance(value, str):
            value = value.strip()
            if value and "/" not in value:
                plans.add(value)
    
    def collect_from_context(context: object) -> None:
        if not isinstance(context, dict):
            return
        add(context.get("current_plan_name"))
        chain_state = context.get("chain_state_summary")
        if isinstance(chain_state, dict):
            add(chain_state.get("current_plan_name"))
        current = context.get("current")
        if isinstance(current, dict):
            add(current.get("milestone_or_plan"))
            add(current.get("current_plan_name"))
    
    for key in ("plan_name", "current_plan_name", "chain_current_plan_name", "milestone_or_plan"):
        add(marker.get(key))
    
    collect_from_context(marker)
    repair_data_path = marker.get("repair_data_path")
    if isinstance(repair_data_path, str) and repair_data_path:
        try:
            data = json.loads(pathlib.Path(repair_data_path).read_text(encoding="utf-8"))
        except Exception:
            data = {}
        if isinstance(data, dict):
            add(data.get("plan_name"))
            collect_from_context(data.get("current_failure_context"))
            iterations = data.get("iterations")
            if isinstance(iterations, list):
                for item in iterations[-3:]:
                    if not isinstance(item, dict):
                        continue
                    add(item.get("plan_name"))
                    collect_from_context(item)
                    collect_from_context(item.get("failure_context"))
                    collect_from_context(item.get("current_failure_context"))
    
    if plans and current_plan not in plans:
        print(",".join(sorted(plans)))
        raise SystemExit(1)
    raise SystemExit(0)
    PY
    }
    
    repair_needs_human_should_remain_human() {
      local session="$1"
      local current_plan="${2:-}"
      local needs_human_path
      needs_human_path="$(repair_needs_human_path "$session")"
      PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - \
        "$session" "$current_plan" "$MARKER_DIR" "$REPAIR_DATA_DIR" "$needs_human_path" "${current_target_observation:-}" <<'PY' 2>>"${LOG:-/dev/null}"
    import json
    import pathlib
    import sys
    
    from arnold_pipelines.megaplan.cloud.human_blockers import (
        BlockerVerdict,
        classify_needs_human_blocker,
    )
    
    session, current_plan, marker_dir, repair_data_dir, needs_human_path, resolver_json = sys.argv[1:7]
    path = pathlib.Path(needs_human_path)
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except Exception as exc:
        print(f"needs_human_fresh_classifier verdict=AMBIGUOUS_BLOCKER error={type(exc).__name__}", file=sys.stderr)
        raise SystemExit(0)
    
    resolver_record = None
    if resolver_json:
        try:
            resolver_record = json.loads(resolver_json)
        except Exception:
            resolver_record = None
    
    try:
        classification = classify_needs_human_blocker(
            session,
            current_plan=current_plan,
            marker_dir=marker_dir,
            repair_data_dir=repair_data_dir,
            needs_human_path=path,
            needs_human_payload=payload if isinstance(payload, dict) else None,
            resolver_record=resolver_record if isinstance(resolver_record, dict) else None,
        )
    except Exception as exc:
        print(f"needs_human_fresh_classifier verdict=AMBIGUOUS_BLOCKER error={type(exc).__name__}", file=sys.stderr)
        raise SystemExit(0)
    
    print(f"needs_human_fresh_classifier verdict={classification.verdict.name}", file=sys.stderr)
    plan_state_path = ""
    if isinstance(classification.resolver_record, dict):
        plan_state = classification.resolver_record.get("plan_state")
        if isinstance(plan_state, dict):
            plan_state_path = str(plan_state.get("path") or "")
    if plan_state_path:
        try:
            plan_state_payload = json.loads(pathlib.Path(plan_state_path).read_text(encoding="utf-8"))
        except Exception:
            plan_state_payload = {}
        if isinstance(plan_state_payload, dict):
            latest_failure = plan_state_payload.get("latest_failure")
            failure_kind = ""
            if isinstance(latest_failure, dict):
                failure_kind = str(latest_failure.get("kind") or "")
            if failure_kind in {"execution_blocked", "blocked_recovery_not_resolved"}:
                print(f"needs_human_fresh_classifier repairable_failure={failure_kind}", file=sys.stderr)
                raise SystemExit(1)
    if classification.verdict in {BlockerVerdict.TRUE_BLOCKER, BlockerVerdict.AMBIGUOUS_BLOCKER}:
        raise SystemExit(0)
    raise SystemExit(1)
    PY
    }
    
    workspace_has_other_alive_session() {
      local session="$1"
      local workspace="$2"
      local candidates other_session other_workspace other_remote_spec other_run_kind other_plan_name other_health
      candidates="$(PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$MARKER_DIR" "$session" "$workspace" <<'PY'
    import json
    import pathlib
    import sys
    
    from arnold_pipelines.megaplan.cloud.session_markers import is_canonical_session_marker_path
    
    marker_dir = pathlib.Path(sys.argv[1])
    session = sys.argv[2]
    workspace = sys.argv[3]
    for path in sorted(marker_dir.glob("*.json")):
        if not is_canonical_session_marker_path(path):
            continue
        try:
            payload = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            continue
        other_session = payload.get("session")
        other_workspace = payload.get("workspace")
        if not isinstance(other_session, str) or not isinstance(other_workspace, str):
            continue
        if other_session == session or other_workspace != workspace:
            continue
        remote_spec = payload.get("remote_spec")
        if not isinstance(remote_spec, str) or not remote_spec:
            continue
        run_kind = payload.get("run_kind")
        plan_name = payload.get("plan_name")
        print("\t".join([
            other_session,
            other_workspace,
            remote_spec,
            run_kind if isinstance(run_kind, str) and run_kind else "chain",
            plan_name if isinstance(plan_name, str) else "",
        ]))
    PY
    )"
      while IFS=$'\t' read -r other_session other_workspace other_remote_spec other_run_kind other_plan_name; do
        [[ -n "${other_session:-}" ]] || continue
        other_health="$(session_health_status "$other_session" "$other_workspace" "$other_remote_spec" "${other_run_kind:-chain}" "${other_plan_name:-}")"
        if [[ "$other_health" == "alive" || "$other_health" == "awaiting_pr_merge" ]]; then
          printf '%s:%s\n' "$other_session" "$other_health"
          return 0
        fi
      done <<< "$candidates"
      return 1
    }
    
    chain_health_status() {
      local session="$1"
      local workspace="$2"
      local remote_spec_path="$3"
      local health="${4:-unknown}"
      CHAIN_HEALTH_STATUS="ok"
      CHAIN_HEALTH_KIND=""
      CHAIN_HEALTH_SUMMARY=""
      CHAIN_HEALTH_ARTIFACT_PATH=""
      CHAIN_HEALTH_STATE_PATH=""
      CHAIN_HEALTH_LOG_PATH=""
      CHAIN_HEALTH_LOG_MESSAGE=""
      eval "$(python3 - "$session" "$workspace" "$remote_spec_path" "$health" "$MARKER_DIR" "$REPAIR_DATA_DIR" <<'PY'
    import collections
    import datetime as dt
    import hashlib
    import json
    import os
    import re
    import shlex
    import subprocess
    import sys
    from pathlib import Path
    
    from arnold_pipelines.megaplan.watchdog.signals import compute_signal_bundle
    
    session = sys.argv[1]
    workspace = Path(sys.argv[2])
    remote_spec_raw = sys.argv[3]
    health = sys.argv[4]
    marker_dir = Path(sys.argv[5])
    repair_data_dir = Path(sys.argv[6])
    
    CYCLE_REPEATS = max(2, int(os.environ.get("CLOUD_WATCHDOG_CHAIN_CYCLE_REPEATS", "3")))
    STUCK_TICKS = max(2, int(os.environ.get("CLOUD_WATCHDOG_CHAIN_STUCK_TICKS", "3")))
    NO_ADVANCE_TICKS = max(
        2,
        int(os.environ.get("CLOUD_WATCHDOG_CHAIN_NO_ADVANCE_TICKS", os.environ.get("CLOUD_WATCHDOG_CHAIN_STUCK_TICKS", "3"))),
    )
    GUARD_REPEATS = max(
        2,
        int(
            os.environ.get(
                "CLOUD_WATCHDOG_CHAIN_COMPLETION_GUARD_REPEATS",
                os.environ.get("CLOUD_WATCHDOG_CHAIN_CYCLE_REPEATS", "3"),
            )
        ),
    )
    LOG_WINDOW = max(120, int(os.environ.get("CLOUD_WATCHDOG_CHAIN_LOG_WINDOW_LINES", "1500")))
    NONTERMINAL_STATES = {"authority_divergence", "blocked", "error", "awaiting_human", "between_milestones"}
    STOPPED_COMPLETION_GUARD_STATES = {"authority_divergence", "blocked", "error"}
    
    
    def emit(name: str, value: str) -> None:
        print(f"{name}={shlex.quote(value)}")
    
    
    def safe_session_name(raw: str) -> str:
        cleaned = re.sub(r"[^A-Za-z0-9_.-]+", "-", raw).strip("-")
        return cleaned or "chain"
    
    
    def clear_artifact(path: Path) -> None:
        try:
            path.unlink()
        except FileNotFoundError:
            return
        except Exception:
            return
    
    
    def load_json(path: Path) -> dict[str, object]:
        try:
            raw = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            return {}
        return raw if isinstance(raw, dict) else {}
    
    
    def resolve_chain_state_path() -> Path | None:
        candidates: list[Path] = []
        if remote_spec_raw:
            try:
                spec_path = Path(remote_spec_raw)
                if not spec_path.is_absolute():
                    spec_path = workspace / spec_path
                try:
                    spec_resolved = spec_path.resolve()
                except Exception:
                    spec_resolved = spec_path
                digest = hashlib.sha1(str(spec_resolved).encode("utf-8")).hexdigest()[:12]
                candidates.extend(
                    [
                        workspace / ".megaplan" / "plans" / ".chains" / f"chain-{digest}.json",
                        workspace / ".megaplan" / "plans" / ".chains" / f"{spec_resolved.stem}-{digest}.json",
                        spec_resolved.parent / ".megaplan" / "plans" / ".chains" / f"chain-{digest}.json",
                        spec_resolved.parent / ".megaplan" / "plans" / ".chains" / f"{spec_resolved.stem}-{digest}.json",
                        spec_resolved.with_name("chain_state.json"),
                    ]
                )
            except Exception:
                pass
        fallback: list[Path] = []
        for glob_pat in (
            ".megaplan/plans/.chains/*.json",
            ".megaplan/initiatives/*/.megaplan/plans/.chains/*.json",
            ".megaplan/**/chain_state.json",
        ):
            try:
                fallback.extend(workspace.glob(glob_pat))
            except Exception:
                continue
        candidates.extend(sorted(set(fallback), key=lambda path: path.stat().st_mtime, reverse=True))
        for candidate in candidates:
            if not candidate.exists():
                continue
            payload = load_json(candidate)
            if payload:
                return candidate
        return None
    
    
    def resolve_spec_path() -> Path | None:
        if not remote_spec_raw:
            return None
        try:
            spec_path = Path(remote_spec_raw)
            if not spec_path.is_absolute():
                spec_path = workspace / spec_path
            try:
                return spec_path.resolve()
            except Exception:
                return spec_path
        except Exception:
            return None
    
    
    def spec_milestone_labels() -> tuple[list[str], bool]:
        spec_path = resolve_spec_path()
        if spec_path is None:
            return [], False
        try:
            raw = spec_path.read_text(encoding="utf-8")
        except Exception:
            return [], False
        try:
            import yaml  # type: ignore
    
            data = yaml.safe_load(raw)
            milestones = data.get("milestones") if isinstance(data, dict) else None
            if isinstance(milestones, list):
                labels: list[str] = []
                for item in milestones:
                    if not isinstance(item, dict):
                        continue
                    label = item.get("label")
                    if isinstance(label, str) and label:
                        labels.append(label)
                return labels, True
        except Exception:
            pass
        labels = []
        in_milestones = False
        for line in raw.splitlines():
            if re.match(r"^milestones:\s*$", line):
                in_milestones = True
                continue
            if in_milestones and re.match(r"^[A-Za-z_][\w-]*:", line):
                break
            match = re.match(r"^\s*-\s*label:\s*['\"]?([^'\"\s#]+)", line)
            if in_milestones and match:
                labels.append(match.group(1))
        return labels, True
    
    
    def chain_state_is_complete(chain_state: dict[str, object]) -> tuple[bool, int]:
        labels, spec_known = spec_milestone_labels()
        milestone_count = len(labels)
        completed = chain_state.get("completed")
        completed_list = completed if isinstance(completed, list) else []
        completed_labels = {
            item.get("label")
            for item in completed_list
            if isinstance(item, dict) and isinstance(item.get("label"), str)
        }
        try:
            current_index = int(chain_state.get("current_milestone_index") or 0)
        except Exception:
            current_index = 0
        if spec_known and milestone_count == 0:
            return True, milestone_count
        if not spec_known:
            return False, milestone_count
        return current_index >= milestone_count or set(labels).issubset(completed_labels), milestone_count
    
    
    def resolve_chain_log_path() -> Path | None:
        candidates = []
        if session == "megaplan-chain":
            candidates.append(workspace / ".megaplan" / "cloud-chain.log")
        else:
            candidates.extend(
                [
                    workspace / ".megaplan" / f"cloud-chain-{session}.log",
                    workspace / ".megaplan" / "cloud-chain.log",
                ]
            )
        for candidate in candidates:
            if candidate.exists():
                return candidate
        return None
    
    
    def read_tail_lines(path: Path | None, *, max_lines: int) -> list[str]:
        if path is None or not path.exists():
            return []
        try:
            with path.open("r", encoding="utf-8", errors="replace") as handle:
                return list(collections.deque((line.rstrip("\n") for line in handle), maxlen=max_lines))
        except Exception:
            return []
    
    
    def run_git(args: list[str], *, timeout: int = 15) -> subprocess.CompletedProcess[str] | None:
        try:
            return subprocess.run(
                ["git", *args],
                cwd=str(workspace),
                text=True,
                capture_output=True,
                timeout=timeout,
                check=False,
            )
        except (OSError, subprocess.TimeoutExpired):
            return None
    
    
    def first_string(*values: object) -> str:
        for value in values:
            if isinstance(value, str) and value.strip():
                return value.strip()
        return ""
    
    
    def milestone_base_sha_from_state_or_reason(plan_state: dict[str, object], reason: str) -> str:
        meta = plan_state.get("meta")
        chain_policy = meta.get("chain_policy") if isinstance(meta, dict) else None
        if isinstance(chain_policy, dict):
            value = first_string(chain_policy.get("milestone_base_sha"))
            if value:
                return value
        value = first_string(chain_state.get("current_milestone_base_sha"))
        if value:
            return value
        match = re.search(r"\bmilestone_base_sha\s+([0-9a-fA-F]{7,40})\b", reason)
        if match:
            return match.group(1)
        return ""
    
    
    def completion_guard_advancement(base_sha: str, previous_snapshot: dict[str, object]) -> dict[str, object]:
        if not base_sha:
            return {"available": False, "reason": "missing_milestone_base_sha"}
        inside = run_git(["rev-parse", "--is-inside-work-tree"])
        if inside is None:
            return {"available": False, "base_sha": base_sha, "reason": "git_unavailable"}
        if inside.returncode != 0 or inside.stdout.strip().lower() != "true":
            return {"available": False, "base_sha": base_sha, "reason": "not_git_worktree"}
        head = run_git(["rev-parse", "HEAD"])
        if head is None:
            return {"available": False, "base_sha": base_sha, "reason": "git_head_unavailable"}
        if head.returncode != 0:
            return {
                "available": False,
                "base_sha": base_sha,
                "reason": "git_head_failed",
                "stderr": (head.stderr or "").strip()[-500:],
            }
        rev_list = run_git(["rev-list", "--count", f"{base_sha}..HEAD"])
        if rev_list is None:
            return {
                "available": False,
                "base_sha": base_sha,
                "head": head.stdout.strip(),
                "reason": "git_rev_list_unavailable",
            }
        if rev_list.returncode != 0:
            return {
                "available": False,
                "base_sha": base_sha,
                "head": head.stdout.strip(),
                "reason": "git_rev_list_failed",
                "stderr": (rev_list.stderr or "").strip()[-500:],
            }
        try:
            ahead_count = int(rev_list.stdout.strip())
        except ValueError:
            return {
                "available": False,
                "base_sha": base_sha,
                "head": head.stdout.strip(),
                "reason": "git_rev_list_non_integer",
                "stdout": (rev_list.stdout or "").strip()[-120:],
            }
        return {
            "available": True,
            "base_sha": base_sha,
            "head": head.stdout.strip(),
            "ahead_count": ahead_count,
            "zero_advancement": ahead_count == 0,
            "command": f"git rev-list --count {base_sha}..HEAD",
        }
    
    
    def working_tree_status() -> dict[str, object]:
        status = run_git(["status", "--porcelain"])
        if status is None:
            return {"available": False, "reason": "git_status_unavailable"}
        if status.returncode != 0:
            return {
                "available": False,
                "reason": "git_status_failed",
                "stderr": (status.stderr or "").strip()[-500:],
            }
        lines = [line for line in (status.stdout or "").splitlines() if line.strip()]
        non_megaplan_lines: list[str] = []
        for line in lines:
            path = line[3:] if len(line) >= 4 else line
            if " -> " in path:
                path = path.rsplit(" -> ", 1)[-1]
            path = path.strip().strip('"')
            if path == ".megaplan" or path.startswith(".megaplan/"):
                continue
            non_megaplan_lines.append(line)
        return {
            "available": True,
            "dirty": bool(non_megaplan_lines),
            "uncommitted_file_count": len(non_megaplan_lines),
            "sample": non_megaplan_lines[:12],
            "raw_uncommitted_file_count": len(lines),
            "command": "git status --porcelain",
        }
    
    
    def state_fallback_zero_advancement(previous_snapshot: dict[str, object]) -> dict[str, object]:
        if not previous_snapshot:
            return {
                "used": True,
                "zero_advancement": None,
                "reason": "no_previous_snapshot_for_state_fallback",
            }
        previous_completed = int(previous_snapshot.get("completed_count") or -1)
        previous_index = int(previous_snapshot.get("current_milestone_index") or -1)
        zero = previous_completed == completed_count and previous_index == current_index
        return {
            "used": True,
            "zero_advancement": zero,
            "reason": "git_unavailable; falling back to state-file completed-count/current-index",
            "previous_completed_count": previous_completed,
            "current_completed_count": completed_count,
            "previous_milestone_index": previous_index,
            "current_milestone_index": current_index,
        }
    
    
    artifact_path = repair_data_dir / f"{safe_session_name(session)}.chain-health.json"
    snapshot_path = marker_dir / f"{safe_session_name(session)}.chain-health.progress.json"
    marker_dir.mkdir(parents=True, exist_ok=True)
    repair_data_dir.mkdir(parents=True, exist_ok=True)
    
    chain_state_path = resolve_chain_state_path()
    chain_state = load_json(chain_state_path) if chain_state_path is not None else {}
    chain_log_path = resolve_chain_log_path()
    log_lines = read_tail_lines(chain_log_path, max_lines=LOG_WINDOW)
    current_plan_name = str(chain_state.get("current_plan_name") or "").strip()
    last_state = str(chain_state.get("last_state") or "").strip()
    pr_state = str(chain_state.get("pr_state") or "").strip()
    pr_number = chain_state.get("pr_number")
    current_index = int(chain_state.get("current_milestone_index") or 0)
    completed = chain_state.get("completed")
    completed_list = completed if isinstance(completed, list) else []
    completed_count = len(completed_list)
    chain_complete, milestone_count = chain_state_is_complete(chain_state)
    
    plan_dir = workspace / ".megaplan" / "plans" / current_plan_name if current_plan_name else None
    plan_state_path = plan_dir / "state.json" if plan_dir is not None else None
    plan_state = load_json(plan_state_path) if plan_state_path is not None else {}
    plan_current_state = str(plan_state.get("current_state") or "").strip()
    active_step = plan_state.get("active_step")
    plan_has_active_step = isinstance(active_step, dict) and bool(active_step.get("phase") or active_step.get("worker_pid"))
    plan_signal_liveness = ""
    plan_signal_reason = ""
    plan_has_in_flight_llm = False
    if plan_dir is not None and plan_dir.exists():
        try:
            signal_bundle = compute_signal_bundle(plan_dir, plan_state if isinstance(plan_state, dict) else None)
            plan_signal_liveness = str(signal_bundle.liveness or "").strip()
            plan_signal_reason = str(signal_bundle.liveness_reason or "").strip()
            plan_has_in_flight_llm = bool(signal_bundle.has_in_flight_llm)
        except Exception:
            pass
    plan_has_live_activity = plan_has_active_step or plan_signal_liveness == "progressing" or plan_has_in_flight_llm
    plan_state_nonterminal = bool(plan_current_state) and plan_current_state not in {
        "done",
        "aborted",
        "cancelled",
        "failed",
    }
    plan_projected_nonterminal = (
        bool(current_plan_name)
        and not plan_has_live_activity
        and plan_state_nonterminal
        and (
            (last_state in {"blocked", "awaiting_human"} and plan_current_state == last_state)
            or (last_state in NONTERMINAL_STATES and plan_current_state != last_state)
        )
    )
    events_path = plan_dir / "events.ndjson" if plan_dir is not None else None
    events_exists = events_path is not None and events_path.exists()
    events_mtime = events_path.stat().st_mtime if events_exists else 0.0
    events_size = events_path.stat().st_size if events_exists else 0
    
    previous = load_json(snapshot_path)
    stuck_ticks = 1 if last_state in NONTERMINAL_STATES else 0
    if (
        previous
        and last_state in NONTERMINAL_STATES
        and previous.get("last_state") == last_state
        and int(previous.get("current_milestone_index") or -1) == current_index
        and int(previous.get("completed_count") or -1) == completed_count
    ):
        stuck_ticks = int(previous.get("stuck_ticks") or 0) + 1
    
    no_advance_ticks = 0
    events_advanced = False
    if previous:
        prev_events_mtime = float(previous.get("events_mtime") or 0.0)
        prev_events_size = int(previous.get("events_size") or 0)
        events_advanced = events_exists and (
            events_mtime > prev_events_mtime or events_size > prev_events_size
        )
        if (
            events_advanced
            and not plan_has_live_activity
            and int(previous.get("current_milestone_index") or -1) == current_index
            and int(previous.get("completed_count") or -1) == completed_count
        ):
            no_advance_ticks = int(previous.get("no_advance_ticks") or 0) + 1
    
    snapshot = {
        "session": session,
        "current_plan_name": current_plan_name,
        "last_state": last_state,
        "current_milestone_index": current_index,
        "completed_count": completed_count,
        "milestone_count": milestone_count,
        "chain_complete": chain_complete,
        "pr_state": pr_state,
        "pr_number": pr_number,
        "events_mtime": events_mtime,
        "events_size": events_size,
        "plan_has_active_step": plan_has_active_step,
        "plan_has_live_activity": plan_has_live_activity,
        "plan_signal_liveness": plan_signal_liveness,
        "plan_signal_reason": plan_signal_reason,
        "plan_has_in_flight_llm": plan_has_in_flight_llm,
        "stuck_ticks": stuck_ticks,
        "no_advance_ticks": no_advance_ticks,
        "updated_at": dt.datetime.now(dt.timezone.utc).isoformat(),
    }
    try:
        snapshot_path.write_text(json.dumps(snapshot, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    except Exception:
        pass
    
    skip_detection = (
        health == "awaiting_pr_merge"
        or last_state == "awaiting_pr_merge"
        or (last_state in {"done", "complete"} and chain_complete)
        or not chain_state
    )
    if skip_detection:
        clear_artifact(artifact_path)
        emit("CHAIN_HEALTH_STATUS", "ok")
        emit("CHAIN_HEALTH_KIND", "")
        emit("CHAIN_HEALTH_SUMMARY", "")
        emit("CHAIN_HEALTH_ARTIFACT_PATH", "")
        emit("CHAIN_HEALTH_STATE_PATH", str(chain_state_path) if chain_state_path is not None else "")
        emit("CHAIN_HEALTH_LOG_PATH", str(chain_log_path) if chain_log_path is not None else "")
        emit("CHAIN_HEALTH_LOG_MESSAGE", "")
        raise SystemExit(0)
    
    merged_counts: collections.Counter[str] = collections.Counter()
    merged_examples: dict[str, str] = {}
    guard_counts: collections.Counter[str] = collections.Counter()
    guard_examples: dict[str, str] = {}
    guard_reasons: dict[str, str] = {}
    guard_kinds: dict[str, str] = {}
    interesting_lines: list[str] = []
    merged_pattern = re.compile(r"^\[chain\] PR #(?P<pr>\d+) merged; advancing past (?P<milestone>.+)$")
    guard_pattern = re.compile(r"^\[chain\] completion guard blocked (?P<milestone>[^:]+): (?P<reason>.+)$")
    pr_progression_guard_pattern = re.compile(r"^\[chain\] PR progression blocked (?P<milestone>[^:]+): (?P<reason>.+)$")
    
    for raw_line in log_lines:
        line = raw_line.strip()
        if not line:
            continue
        merged_match = merged_pattern.match(line)
        if merged_match:
            milestone = merged_match.group("milestone").strip()
            merged_counts[milestone] += 1
            merged_examples.setdefault(milestone, line)
            interesting_lines.append(line)
            continue
        guard_kind = "completion_guard"
        guard_match = guard_pattern.match(line)
        if not guard_match:
            guard_match = pr_progression_guard_pattern.match(line)
            if guard_match:
                guard_kind = "pr_progression"
        if guard_match:
            milestone = guard_match.group("milestone").strip()
            guard_counts[milestone] += 1
            guard_examples.setdefault(milestone, line)
            guard_reasons[milestone] = guard_match.group("reason").strip()
            guard_kinds[milestone] = guard_kind
            interesting_lines.append(line)
            continue
        if "authority_divergence" in line or '"last_state": "authority_divergence"' in line:
            interesting_lines.append(line)
    
    latest_failure = plan_state.get("latest_failure")
    latest_failure = latest_failure if isinstance(latest_failure, dict) else {}
    large_file_signal_text = "\n".join(
        [
            "\n".join(log_lines[-80:]),
            str(latest_failure.get("kind") or ""),
            str(latest_failure.get("message") or ""),
            json.dumps(latest_failure.get("metadata") or {}, sort_keys=True),
        ]
    ).lower()
    has_large_file_push_rejection = (
        last_state == "failed"
        and (
            "phase-complete callback failed" in large_file_signal_text
            or "phase_callback_failed" in large_file_signal_text
        )
        and "git push" in large_file_signal_text
        and (
            "gh001" in large_file_signal_text
            or "large files detected" in large_file_signal_text
            or "exceeds github" in large_file_signal_text
            or "exceeds file size limit" in large_file_signal_text
            or "100.00 mb" in large_file_signal_text
        )
    )
    
    status = "ok"
    issue_kind = ""
    summary = ""
    recurring_lines: list[str] = []
    evidence_extra_lines: list[str] = []
    completion_guard = {
        "milestone": "",
        "reason": "",
        "repeat_count": 0,
    }
    details: dict[str, object] = {}
    chain_health_log_message = ""
    completion_guard_repair_eligible = False
    
    if last_state in {"done", "complete"} and not chain_complete:
        status = "chain_inconsistent_done"
        issue_kind = "chain_inconsistent_done"
        summary = (
            f"chain state advertises last_state={last_state} but only "
            f"{completed_count}/{milestone_count or '?'} milestones are complete; "
            "treating as incomplete/stuck instead of terminal"
        )
        chain_health_log_message = (
            "CHAIN HEALTH EVIDENCE: chain last_state is terminal-looking but "
            "completed milestones do not cover the chain spec."
        )
    
    if status == "ok" and has_large_file_push_rejection:
        status = "chain_large_file_push_rejection"
        issue_kind = "git_large_file_push_rejection"
        recurring_lines = [
            line
            for line in log_lines[-40:]
            if (
                "GH001" in line
                or "Large files detected" in line
                or "exceeds GitHub" in line
                or "100.00 MB" in line
                or "phase-complete callback failed" in line
                or "git push" in line
            )
        ]
        summary = (
            "chain failed after a successful phase because the post-phase git push was rejected "
            "for an oversized runtime journal; exclude .megaplan runtime event logs from commits "
            "and replay the post-phase publish/chain transition"
        )
        chain_health_log_message = (
            "CHAIN HEALTH EVIDENCE: git push rejected by GitHub large-file limit after phase callback; "
            "runtime journals such as .megaplan/epics/*/events.jsonl must not be pushed"
        )
        evidence_extra_lines.append(
            "- Large-file push rejection: GitHub rejected the milestone branch because a runtime journal exceeded the file-size limit. "
            "Exclude runtime journals from chain commits and replay the post-phase transition."
        )
        details = {
            "latest_failure_kind": latest_failure.get("kind") or "",
            "latest_failure_message": latest_failure.get("message") or "",
            "runtime_journal_patterns": [
                ".megaplan/epics/*/events.jsonl",
                ".megaplan/plans/*/events.ndjson",
                ".megaplan/plans/*/execution_trace.jsonl",
            ],
        }
    
    cycle_milestone = next(
        (
            milestone
            for milestone, repeat_count in merged_counts.items()
            if repeat_count >= CYCLE_REPEATS and guard_counts.get(milestone, 0) >= CYCLE_REPEATS
        ),
        "",
    )
    if cycle_milestone:
        status = "chain_cycle"
        issue_kind = "chain_cycle"
        repeat_count = min(merged_counts[cycle_milestone], guard_counts[cycle_milestone])
        recurring_lines = [
            merged_examples.get(cycle_milestone, ""),
            guard_examples.get(cycle_milestone, ""),
        ]
        completion_guard = {
            "milestone": cycle_milestone,
            "reason": guard_reasons.get(cycle_milestone, ""),
            "repeat_count": repeat_count,
        }
        summary = (
            f"chain-layer cycle on {cycle_milestone}: merged PR/completion-guard pattern repeated "
            f"{repeat_count}x; do not route to plan repair"
        )
        details = {
            "cycle_milestone": cycle_milestone,
            "merged_repeats": merged_counts[cycle_milestone],
            "completion_guard_repeats": guard_counts[cycle_milestone],
        }
    if status == "ok" and guard_counts:
        guard_milestone, guard_repeat_count = max(guard_counts.items(), key=lambda item: item[1])
        if guard_repeat_count >= GUARD_REPEATS:
            status = "chain_completion_guard_rejections"
            issue_kind = "chain_completion_guard_rejections"
            recurring_lines = [guard_examples.get(guard_milestone, "")]
            completion_guard = {
                "milestone": guard_milestone,
                "reason": guard_reasons.get(guard_milestone, ""),
                "repeat_count": guard_repeat_count,
                "kind": guard_kinds.get(guard_milestone, "completion_guard"),
            }
            summary = (
                f"chain completion guard rejected {guard_milestone} {guard_repeat_count}x; "
                "plan repair loop will not fix a chain-driver completion pathology"
            )
            details = {
                "completion_guard_repeats": guard_repeat_count,
                "completion_guard_kind": guard_kinds.get(guard_milestone, "completion_guard"),
            }
    
    if status in {"chain_cycle", "chain_completion_guard_rejections"}:
        guard_milestone = str(completion_guard.get("milestone") or "")
        guard_reason = str(completion_guard.get("reason") or "")
        guard_repeat_count = int(completion_guard.get("repeat_count") or 0)
        base_sha = milestone_base_sha_from_state_or_reason(plan_state, guard_reason)
        advancement_check = completion_guard_advancement(base_sha, previous)
        worktree_check = working_tree_status()
        fallback_check: dict[str, object] = {"used": False}
        zero_advancement = False
        if advancement_check.get("available") is True:
            zero_advancement = advancement_check.get("zero_advancement") is True
        else:
            fallback_check = state_fallback_zero_advancement(previous)
            chain_health_log_message = (
                "completion guard git advancement check unavailable "
                f"session={session} base={base_sha or 'unknown'} reason={advancement_check.get('reason')}; "
                "falling back to state-file completed-count/current-index"
            )
            zero_advancement = fallback_check.get("zero_advancement") is True
        details = {
            **details,
            "completion_guard_advancement": advancement_check,
            "completion_guard_worktree": worktree_check,
            "completion_guard_state_fallback": fallback_check,
        }
        if zero_advancement:
            base_label = base_sha or "unknown"
            if worktree_check.get("available") is True and worktree_check.get("dirty") is True:
                uncommitted_count = int(worktree_check.get("uncommitted_file_count") or 0)
                status = "chain_uncommitted_execute_output"
                issue_kind = "chain_uncommitted_execute_output"
                summary = (
                    f"milestone {guard_milestone or 'unknown'} has 0 committed changes vs base {base_label} "
                    f"but the working tree has {uncommitted_count} uncommitted files; unpublished claimed changes "
                    "were left unpublished in a dirty worktree; execute output was not "
                    "committed, so this is a CHAIN-DRIVER commit-step bug, not a plan no-op waiver case"
                )
                chain_health_log_message = (
                    "CHAIN HEALTH EVIDENCE: working tree has "
                    f"{uncommitted_count} uncommitted files vs committed HEAD; execute output was not "
                    "committed -> repeated publish guards indicate the commit step skipped; investigate "
                    "arnold_pipelines/megaplan/chain commit-and-push gating"
                )
                evidence_extra_lines.append(
                    "- Working tree evidence: "
                    f"{uncommitted_count} uncommitted files vs committed HEAD; execute output was not "
                    "committed -> commit step skipped; investigate "
                    "arnold_pipelines/megaplan/chain commit-and-push gating."
                )
                details["chain_driver_diagnosis"] = summary
            else:
                status = "needs_human"
                issue_kind = "plan_noop_completion_guard"
                summary = (
                    f"milestone {guard_milestone or 'unknown'} produces NO code changes vs base {base_label} "
                    f"across {guard_repeat_count} attempts "
                    "(git rev-list base..HEAD == 0 and working tree is clean); completion guard correctly blocks; "
                    "this is a PLAN decision: rework the milestone so its execute lands work, OR grant a typed no-op "
                    "completion waiver. Not auto-repairable."
                )
                details["plan_level_diagnosis"] = summary
        elif advancement_check.get("available") is True:
            # Code landed after the milestone base, so this is a repair-eligible
            # completion-guard edge case (for example a stale base SHA), not a
            # plan-level no-op. Return ok so launch_chain_tick continues into the
            # existing repair/relaunch path.
            completion_guard_repair_eligible = True
            status = "ok"
            issue_kind = ""
            summary = ""
            recurring_lines = []
            details = {}
        elif fallback_check.get("used") is True and fallback_check.get("zero_advancement") is False:
            completion_guard_repair_eligible = True
            status = "ok"
            issue_kind = ""
            summary = ""
            recurring_lines = []
            details = {}
    
    unclean_base_lines = [
        line
        for line in log_lines[-120:]
        if (
            '"error": "unclean_base"' in line
            or "require_clean_base:" in line
            or "working base carries uncommitted WIP" in line
            or "clean base" in line.lower()
            and "uncommitted" in line.lower()
            and "wip" in line.lower()
        )
    ]
    if (
        status == "ok"
        and not completion_guard_repair_eligible
        and last_state in NONTERMINAL_STATES
        and unclean_base_lines
    ):
        status = "chain_unclean_base"
        issue_kind = "chain_unclean_base"
        recurring_lines = unclean_base_lines[-6:]
        summary = (
            "chain retry/relaunch cannot start because require_clean_base found carried WIP; "
            "preserve the abandoned attempt output before re-initializing the milestone"
        )
        details = {
            "stuck_ticks": stuck_ticks,
            "dirty_base_signal": True,
            "unclean_base_line_count": len(unclean_base_lines),
        }
        chain_health_log_message = (
            "CHAIN HEALTH EVIDENCE: require_clean_base reported carried WIP during chain retry; "
            "this is a chain-driver retry-preservation issue, not a plan-level repair target"
        )
        evidence_extra_lines.append(
            "- Unclean-base evidence: require_clean_base reported carried WIP while the chain was retrying/relaunching. "
            "Preserve or stash the abandoned attempt output before re-initializing the milestone."
        )
    
    if (
        status == "ok"
        and not completion_guard_repair_eligible
        and last_state in NONTERMINAL_STATES
        and not plan_has_live_activity
        and not plan_projected_nonterminal
        and stuck_ticks >= STUCK_TICKS
    ):
        status = "chain_stuck"
        issue_kind = "chain_stuck_nonterminal"
        recurring_lines = interesting_lines[-3:] if interesting_lines else log_lines[-3:]
        summary = (
            f"chain stuck in nonterminal state {last_state} for {stuck_ticks} ticks with no completed[] growth; "
            "treat as chain-layer sickness"
        )
        details = {"stuck_ticks": stuck_ticks}
    if (
        status == "ok"
        and not completion_guard_repair_eligible
        and not plan_projected_nonterminal
        and not plan_has_live_activity
        and no_advance_ticks >= NO_ADVANCE_TICKS
    ):
        status = "chain_no_advance"
        issue_kind = "chain_no_advance"
        recurring_lines = interesting_lines[-3:] if interesting_lines else log_lines[-3:]
        summary = (
            f"current_milestone_index stayed at {current_index} for {no_advance_ticks} busy ticks while "
            "plan events kept moving; the chain is busy but not advancing"
        )
        details = {"no_advance_ticks": no_advance_ticks, "events_advanced": events_advanced}
    
    chain_state_summary = {
        "path": str(chain_state_path) if chain_state_path is not None else "",
        "current_plan_name": current_plan_name,
        "current_milestone_index": current_index,
        "completed_count": completed_count,
        "last_state": last_state,
        "pr_number": pr_number,
        "pr_state": pr_state,
    }
    
    why_chain_layer = (
        "This evidence points at chain-driver state progression or completion-guard behavior after the plan "
        "already executed or the PR already merged. Route to arnold_pipelines/megaplan/chain/, not the plan repair loop."
    )
    
    if status == "ok":
        clear_artifact(artifact_path)
    else:
        rendered_lines = [line for line in recurring_lines if line]
        if not rendered_lines:
            rendered_lines = log_lines[-5:]
        evidence_lines = [
            "## CHAIN HEALTH EVIDENCE",
            f"- Issue: {issue_kind or status}",
            (
                "- Chain state summary: "
                f"last_state={last_state or 'unknown'} "
                f"pr_state={pr_state or 'unknown'} "
                f"current_milestone_index={current_index} "
                f"completed_count={completed_count}"
            ),
            "- Recurring chain-log lines:",
            *[f"> {line}" for line in rendered_lines[:6]],
            (
                "- Completion guard verdict: "
                f"{completion_guard['milestone'] or 'n/a'} -> "
                f"{completion_guard['reason'] or 'n/a'}"
            ),
            *(
                ["- PR progression guard evidence: repeated publish guards blocked advancement after the PR was already merged."]
                if completion_guard.get("kind") == "pr_progression"
                else []
            ),
            *evidence_extra_lines,
            f"- Why this is chain-layer: {why_chain_layer}",
            "- Investigate: arnold_pipelines/megaplan/chain/__init__.py and arnold_pipelines/megaplan/chain/status.py",
        ]
        evidence_markdown = "\n".join(evidence_lines)
        artifact = {
            "session": session,
            "workspace": str(workspace),
            "remote_spec": remote_spec_raw,
            "detected_at": dt.datetime.now(dt.timezone.utc).isoformat(),
            "status": status,
            "issue_kind": issue_kind or status,
            "summary": summary,
            "health": health,
            "thresholds": {
                "chain_cycle_repeats": CYCLE_REPEATS,
                "chain_stuck_ticks": STUCK_TICKS,
                "chain_no_advance_ticks": NO_ADVANCE_TICKS,
                "chain_completion_guard_repeats": GUARD_REPEATS,
                "chain_log_window_lines": LOG_WINDOW,
            },
            "chain_state_summary": chain_state_summary,
            "chain_state_path": str(chain_state_path) if chain_state_path is not None else "",
            "chain_log_path": str(chain_log_path) if chain_log_path is not None else "",
            "chain_log_tail": log_lines[-40:],
            "recurring_cycle_lines": rendered_lines[:10],
            "completion_guard": completion_guard,
            "details": details,
            "snapshot": snapshot,
            "why_chain_layer_issue": why_chain_layer,
            "investigation_hint": "arnold_pipelines/megaplan/chain/",
            "evidence_markdown": evidence_markdown,
        }
        try:
            artifact_path.write_text(json.dumps(artifact, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        except Exception:
            pass
    
    emit("CHAIN_HEALTH_STATUS", status)
    emit("CHAIN_HEALTH_KIND", (issue_kind or status) if status != "ok" else "")
    emit("CHAIN_HEALTH_SUMMARY", summary)
    emit("CHAIN_HEALTH_ARTIFACT_PATH", str(artifact_path) if status != "ok" else "")
    emit("CHAIN_HEALTH_STATE_PATH", str(chain_state_path) if chain_state_path is not None else "")
    emit("CHAIN_HEALTH_LOG_PATH", str(chain_log_path) if chain_log_path is not None else "")
    emit("CHAIN_HEALTH_LOG_MESSAGE", chain_health_log_message)
    PY
    )"
    }
    
    # Per-session runtime-binding preflight.  Identity is the marker session
    # (canonical producer: cli.py _chain_runtime_manifest_path -> {manifest_dir}/{session}.json),
    # NOT this watchdog process's ARNOLD_RUNTIME_MANIFEST / MANIFEST_RUNTIME_ROOT /
    # LIVE_IMPORT_ROOT.  A multi-engine box (per-epic worktrees) has one supervisor
    # observing many sessions; comparing a session's recorded root to the
    # supervisor's own root is env-scoped, not identity-scoped (T-0022 1:1 leak).
    # The session's own manifest epic.runtime_root is the only truth.
    chain_engine_root_preflight() {
      local workspace="$1"
      local remote_spec="$2"
      local session="$3"
      local plan_name="${4:-}"
      local manifest_dir="${ARNOLD_RUNTIME_MANIFEST_DIR:-/workspace/.megaplan}"
      [[ -n "$workspace" && -n "$session" ]] || {
        echo "chain_runtime_binding_drift: relaunch preflight missing workspace or session identity" >&2
        return 24
      }
      if [[ -z "$remote_spec" && -n "$plan_name" ]]; then
        # A plan relaunch carries no spec: resolve the one canonical chain whose
        # persisted execution binding owns the plan.  A plan with no bound chain
        # (standalone) still MUST prove recorded == session manifest below.
        remote_spec="$(python3 - "$workspace" "$plan_name" <<'PY' 2>/dev/null || true
    import pathlib
    import sys
    
    try:
        from arnold_pipelines.megaplan.chain.execution_binding import find_bound_chain_spec
    except Exception:
        raise SystemExit(1)
    spec = find_bound_chain_spec(pathlib.Path(sys.argv[1]), plan_name=sys.argv[2])
    if spec:
        print(spec)
    PY
    )"
      fi
      python3 - "$workspace" "$remote_spec" "$session" "$manifest_dir" <<'PY'
    import hashlib
    import json
    import pathlib
    import sys
    
    workspace, remote_spec, session, manifest_dir = sys.argv[1:5]
    workspace_path = pathlib.Path(workspace)
    
    
    def drift(reason: str) -> None:
        print(f"chain_runtime_binding_drift: {reason}", file=sys.stderr)
        raise SystemExit(24)
    
    
    session_manifest_path = pathlib.Path(manifest_dir) / f"{session}.json"
    try:
        payload = json.loads(session_manifest_path.read_text(encoding="utf-8"))
    except Exception:
        drift(f"session runtime manifest missing: {session_manifest_path}")
    if not isinstance(payload, dict):
        drift(f"session runtime manifest {session_manifest_path} is not an object")
    epic = payload.get("epic")
    if not isinstance(epic, dict):
        drift(f"session runtime manifest {session_manifest_path} lacks epic")
    raw_root = epic.get("runtime_root")
    if not isinstance(raw_root, str) or not raw_root.strip():
        drift(f"session runtime manifest {session_manifest_path} lacks epic.runtime_root")
    manifest = pathlib.Path(raw_root).expanduser().resolve()
    
    
    def require_engine(root: pathlib.Path, label: str) -> None:
        if not root.is_dir() or not (root / ".git").exists():
            drift(f"{label} {root} is missing or dangling")
        if not (root / "arnold_pipelines").is_dir():
            drift(f"{label} {root} has no arnold_pipelines package")
    
    
    if not remote_spec:
        # A STANDALONE plan carries no recorded engine root; the session manifest
        # epic.runtime_root IS the binding.  Prove it is a real engine checkout.
        require_engine(manifest, "session manifest runtime root")
        print(manifest)
        raise SystemExit(0)
    
    spec_path = pathlib.Path(remote_spec)
    if not spec_path.is_absolute():
        spec_path = workspace_path / spec_path
    try:
        spec_path = spec_path.resolve()
    except OSError:
        pass
    digest = hashlib.sha1(str(spec_path).encode("utf-8")).hexdigest()[:12]
    state_path = workspace_path / ".megaplan" / "plans" / ".chains" / f"chain-{digest}.json"
    
    try:
        payload = json.loads(state_path.read_text(encoding="utf-8"))
    except Exception:
        drift(f"chain state {state_path} missing or unreadable")
    if not isinstance(payload, dict):
        drift(f"chain state {state_path} is not an object")
    metadata = payload.get("metadata")
    if not isinstance(metadata, dict):
        drift(f"chain state {state_path} lacks metadata")
    execution_environment = metadata.get("execution_environment")
    if not isinstance(execution_environment, dict):
        drift(f"chain state {state_path} lacks metadata.execution_environment")
    recorded_root = execution_environment.get("engine_root")
    if not isinstance(recorded_root, str) or not recorded_root.strip():
        drift(f"chain state {state_path} lacks metadata.execution_environment.engine_root")
    recorded = pathlib.Path(recorded_root).expanduser().resolve()
    require_engine(recorded, "recorded engine root")
    if recorded != manifest:
        drift(f"engine root mismatch: recorded={recorded} manifest={manifest}")
    print(recorded)
    PY
    }
    
    default_plan_relaunch_command() {
      local plan_name="$1"
      local workspace="$2"
      local session="$3"
      local log_path="$workspace/.megaplan/cloud-logs/${plan_name}.log"
      local accepted_root
      # T-0022: re-read the persisted engine root (bound chain, when this plan
      # belongs to one) and fail closed on drift BEFORE building PYTHONPATH; only
      # the accepted root goes on PYTHONPATH.
      accepted_root="$(chain_engine_root_preflight "$workspace" "" "$session" "$plan_name")" || return $?
      [[ -n "$accepted_root" ]] || return 24
      printf 'if [[ -f /workspace/.cloud-hot-env ]]; then set -a; . /workspace/.cloud-hot-env; set +a; fi; unset ARNOLD_LIVENESS_OWNER_PID ARNOLD_LIVENESS_OWNER_PROCESS_START; cd %q && PLAN_STATE_FILE=%q/.megaplan/plans/%q/state.json && PLAN_CMD=auto && PLAN_AUTO_CMD='\''PYTHONSAFEPATH=1 PYTHONPATH=%q MEGAPLAN_TRUSTED_CONTAINER=1 python3 -P -m arnold_pipelines.megaplan auto --plan %q --project-dir %q >> %q 2>&1'\'' && if [[ -f "$PLAN_STATE_FILE" ]] && python3 - "$PLAN_STATE_FILE" <<'\''PY'\'' >/dev/null 2>&1
    import json
    import sys
    from pathlib import Path
    
    try:
        payload = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
    except Exception:
        raise SystemExit(1)
    
    raise SystemExit(0 if str(payload.get("current_state") or "").strip() == "failed" else 1)
    PY
      then PLAN_CMD=resume; fi && PYTHONSAFEPATH=1 PYTHONPATH=%q MEGAPLAN_TRUSTED_CONTAINER=1 python3 -P -m arnold_pipelines.megaplan "$PLAN_CMD" --plan %q --project-dir %q >> %q 2>&1' \
        "$workspace" "$workspace" "$plan_name" "$accepted_root" "$plan_name" "$workspace" "$log_path" "$accepted_root" "$plan_name" "$workspace" "$log_path"
    }
    
    resume_plan_relaunch_command() {
      local plan_name="$1"
      local workspace="$2"
      local session="$3"
      local log_path="$workspace/.megaplan/cloud-logs/${plan_name}.log"
      local accepted_root
      # T-0022: re-read the persisted engine root (bound chain, when this plan
      # belongs to one) and fail closed on drift BEFORE building PYTHONPATH; only
      # the accepted root goes on PYTHONPATH.
      accepted_root="$(chain_engine_root_preflight "$workspace" "" "$session" "$plan_name")" || return $?
      [[ -n "$accepted_root" ]] || return 24
      printf 'if [[ -f /workspace/.cloud-hot-env ]]; then set -a; . /workspace/.cloud-hot-env; set +a; fi; cd %q && PYTHONSAFEPATH=1 PYTHONPATH=%q MEGAPLAN_TRUSTED_CONTAINER=1 python3 -P -m arnold_pipelines.megaplan resume --plan %q --project-dir %q >> %q 2>&1' \
        "$workspace" "$accepted_root" "$plan_name" "$workspace" "$log_path"
    }
    
    chain_resume_plan_relaunch_command_if_needed() {
      local workspace="$1"
      local plan_name="$2"
      local remote_spec="${3:-}"
      local session="${4:-}"
      # T-0021 (G5): the engine-root preflight runs BEFORE any chain/plan state
      # read — no plan-name derivation from chain state, no plan state.json, no
      # marker.  A missing/dangling/mismatched recorded engine_root (or a missing
      # manifest pin) fails closed with typed drift exit 24 here, before any
      # resume decision is made.
      chain_engine_root_preflight "$workspace" "$remote_spec" "$session" "$plan_name" >/dev/null || return $?
      if [[ -z "$plan_name" && -n "$remote_spec" ]]; then
        plan_name="$(python3 - "$workspace" "$remote_spec" <<'PY' 2>/dev/null || authority_gap_continue "T29-BYPASS-142" "authority-risk bypass converted to typed evidence gap"
    import hashlib
    import json
    import pathlib
    import sys
    
    workspace = pathlib.Path(sys.argv[1])
    spec_path = pathlib.Path(sys.argv[2])
    if not spec_path.is_absolute():
        spec_path = workspace / spec_path
    try:
        spec_path = spec_path.resolve()
    except OSError:
        pass
    digest = hashlib.sha1(str(spec_path).encode("utf-8")).hexdigest()[:12]
    state_path = workspace / ".megaplan" / "plans" / ".chains" / f"chain-{digest}.json"
    try:
        payload = json.loads(state_path.read_text(encoding="utf-8"))
    except Exception:
        raise SystemExit(0)
    plan_name = payload.get("current_plan_name") if isinstance(payload, dict) else ""
    if isinstance(plan_name, str) and plan_name and "/" not in plan_name:
        print(plan_name)
    PY
    )"
      fi
      [[ -n "$plan_name" ]] || return 1
      local plan_state_file="$workspace/.megaplan/plans/$plan_name/state.json"
      [[ -f "$plan_state_file" ]] || return 1
      if ! python3 - "$plan_state_file" <<'PY' >/dev/null 2>&1
    import json
    import sys
    from pathlib import Path
    
    try:
        payload = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
    except Exception:
        raise SystemExit(1)
    
    if str(payload.get("current_state") or "").strip() != "blocked":
        raise SystemExit(1)
    resume_cursor = payload.get("resume_cursor")
    if not isinstance(resume_cursor, dict):
        raise SystemExit(1)
    phase = str(resume_cursor.get("phase") or "").strip()
    retry_strategy = str(resume_cursor.get("retry_strategy") or "").strip()
    latest_failure = payload.get("latest_failure")
    if not isinstance(latest_failure, dict):
        raise SystemExit(1)
    failure_kind = str(latest_failure.get("kind") or "").strip()
    failure_phase = str(latest_failure.get("phase") or "").strip()
    
    raise SystemExit(
        0
        if (
            phase
            and phase != "recover-blocked"
            and retry_strategy in {"check_provider_and_retry", "wait_and_retry"}
            and failure_kind == "external_error_resume_required"
            and failure_phase == "recover-blocked"
        )
        else 1
    )
    PY
      then
        return 1
      fi
      resume_plan_relaunch_command "$plan_name" "$workspace" "$session"
    }
    
    stale_marker_relaunch_command() {
      local relaunch_command="${1:-}"
      local accepted_root="${2:-}"
      if PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 -P - "$relaunch_command" "$accepted_root" <<'PY'
    import sys
    from arnold_pipelines.megaplan.cloud.relaunch_resolution import is_stale_marker_relaunch_command
    raise SystemExit(0 if is_stale_marker_relaunch_command(sys.argv[1], sys.argv[2] if len(sys.argv) > 2 else "") else 1)
    PY
      then
        return 0
      fi
      return 1
    }
    
    default_chain_relaunch_command() {
      local session="$1"
      local workspace="$2"
      local remote_spec="$3"
      local log_relative repair_queue_root repair_marker_dir accepted_root
      if [[ "$session" == "megaplan-chain" ]]; then
        log_relative=".megaplan/cloud-chain.log"
      else
        log_relative=".megaplan/cloud-chain-${session}.log"
      fi
      # The runtime IS the code (P4): the launch bound this session to the
      # per-epic manifest runtime; this safety fallback re-runs the same chain
      # start from the accepted (manifest) runtime root (fixed /workspace/arnold
      # for permit-admitted manifest-less sessions).  T-0022: re-read the
      # persisted engine root from the chain state and fail closed on drift
      # BEFORE building PYTHONPATH; only the accepted root goes on PYTHONPATH.
      # No editable-install refresh, no source checkout mutation, no
      # env-selector re-resolution.
      accepted_root="$(chain_engine_root_preflight "$workspace" "$remote_spec" "$session")" || return $?
      [[ -n "$accepted_root" ]] || return 24
      repair_marker_dir="${MARKER_DIR:-/workspace/.megaplan/cloud-sessions}"
      repair_queue_root="${ARNOLD_REPAIR_QUEUE_ROOT:-${repair_marker_dir%/*}/repair-queue}"
      printf 'unset ARNOLD_LIVENESS_OWNER_PID ARNOLD_LIVENESS_OWNER_PROCESS_START
    export ARNOLD_REPAIR_QUEUE_ROOT=%q
    export ARNOLD_REPAIR_MARKER_DIR=%q
    export ARNOLD_REPAIR_SESSION=%q
    export ARNOLD_REPAIR_RUN_KIND=%q
    if [[ -f /workspace/.cloud-hot-env ]]; then set -a; . /workspace/.cloud-hot-env; set +a; fi; unset ARNOLD_LIVENESS_OWNER_PID ARNOLD_LIVENESS_OWNER_PROCESS_START; cd %q && PYTHONSAFEPATH=1 PYTHONPATH=%q MEGAPLAN_TRUSTED_CONTAINER=1 python3 -P -m arnold_pipelines.megaplan chain start --spec %q --project-dir %q >> %q 2>&1' \
        "$repair_queue_root" "$repair_marker_dir" "$session" "chain" \
        "$workspace" "$accepted_root" "$remote_spec" "$workspace" "$workspace/$log_relative"
    }
    
    resolve_relaunch_command() {
      local session="$1"
      local workspace="$2"
      local remote_spec="$3"
      local run_kind="${4:-chain}"
      local plan_name="${5:-}"
      local relaunch_command="${6:-}"
    
      # A chain marker commonly preserves its original `chain start` command and
      # omits plan_name. Once the active plan records explicit resume authority,
      # that current state must outrank the stale launch-time marker command.
      if [[ "$run_kind" != "plan" ]]; then
        local resume_rc
        chain_resume_plan_relaunch_command_if_needed "$workspace" "$plan_name" "$remote_spec" "$session" || resume_rc=$?
        # G5 (T-0021): the engine-root preflight runs first inside the resume
        # check; a typed drift (24) must fail closed here rather than fall
        # through to the marker/default relaunch paths.
        if [[ "${resume_rc:-0}" -eq 24 ]]; then
          return 24
        fi
        if [[ "${resume_rc:-0}" -eq 0 ]]; then
          return 0
        fi
      fi
      # G5 (round-6 finding 1b): the default-plan preflight gates ANY persisted
      # plan command before it is returned verbatim — a persisted command cannot
      # bypass the engine-root preflight (chain commands are already gated by the
      # preflight inside the resume check above).
      if [[ "$run_kind" == "plan" && -n "$relaunch_command" ]]; then
        chain_engine_root_preflight "$workspace" "" "$session" "$plan_name" >/dev/null || return $?
      fi
      # G5 (round-2 finding 2): the blacklist gate below (relaunch_resolution)
      # also rejects shared-root PYTHONPATH=/workspace/arnold patterns, so a
      # persisted builder-selection command is never returned verbatim — it is
      # regenerated from the preflight-accepted manifest root or fails closed
      # (typed drift 24) instead.  G5 (round-14 finding 1): the gate additionally
      # passes the accepted manifest root so a persisted command referencing a
      # DIFFERENT per-epic runtime path is regenerated, not returned verbatim.
      if [[ -n "$relaunch_command" ]] && ! stale_marker_relaunch_command "$relaunch_command" "$SRC_DIR"; then
        printf '%s' "$relaunch_command"
        return 0
      fi
      if [[ "$run_kind" == "plan" ]]; then
        [[ -n "$plan_name" ]] || return 1
        default_plan_relaunch_command "$plan_name" "$workspace" "$session"
        return 0
      fi
      default_chain_relaunch_command "$session" "$workspace" "$remote_spec"
    }
    
    # Step 53 relaunch-materializer authority gate.
    #
    # Every relaunch command and arnold-supervise bash -lc script produced by this
    # watchdog is a NON-AUTHORITATIVE relaunch materializer: a successful relaunch
    # (return code 0) resumes plan/chain execution but can never become accepted
    # repair.  Accepted repair requires canonical simple_fixer delegation with an
    # exact F01 occurrence tuple; authority is never derived from a label, liveness
    # signal, WBC receipt, or rebuildable projection (SC19).
    #
    # The gate classifies a relaunch command into a closed vocabulary of
    # non-authoritative families and proves no forbidden authority source is
    # present.  Output is a single JSON object on stdout.
    relaunch_materializer_authority_gate() {
      local relaunch_command="${1:-}"
      python3 - "$relaunch_command" <<'GATE_PY'
    import json
    import re
    import sys
    
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    
    NON_AUTHORITATIVE_FAMILIES = (
        "direct_module.auto",
        "direct_module.resume",
        "direct_module.auto_or_resume",
        "direct_module.chain_start",
        "arnold_supervise.bash_lc",
    )
    
    _DIRECT_MODULE_RE = re.compile(
        r"python3\b.*?\s+-m\s+arnold_pipelines\.megaplan\s+(\S+)"
    )
    _SUPERVISE_RE = re.compile(r"arnold-supervise\b.*?\sbash\s+-lc\b")
    
    _FORBIDDEN_AUTHORITY_SOURCES = (
        ("label", re.compile(r"--authority-label|REPAIR_AUTHORITY_LABEL|repair-authority-label")),
        ("liveness", re.compile(r"repair_accepted|accepted_repair_on|repair.*\$\?|repair.*returncode")),
        ("wbc_receipt", re.compile(r"wbc[-_ ]?receipt|well[-_ ]?behaved[-_ ]?client")),
        (
            "rebuildable_projection",
            re.compile(r"rebuildable[-_ ]?projection|reproject[-_ ]?authority"),
        ),
    )
    
    
    def _classify(command):
        if _SUPERVISE_RE.search(command):
            return "arnold_supervise.bash_lc"
        match = _DIRECT_MODULE_RE.search(command)
        if match:
            verb = match.group(1).strip("\"'")
            tail = command[match.end():]
            if verb in ("auto", "resume"):
                return "direct_module." + verb
            if verb == "chain" and tail.lstrip().startswith("start"):
                return "direct_module.chain_start"
            if "PLAN_CMD" in verb:
                return "direct_module.auto_or_resume"
        return ""
    
    
    family = _classify(cmd)
    forbidden_present = [
        name
        for name, pattern in _FORBIDDEN_AUTHORITY_SOURCES
        if pattern.search(cmd)
    ]
    result = dict(
        family=family,
        is_non_authoritative_family=family in NON_AUTHORITATIVE_FAMILIES,
        is_repair_authority=False,
        can_become_accepted_repair_on_success=False,
        accepted_repair_requires_canonical_delegation=True,
        canonical_delegation_path="simple_fixer.singleton_claim.exact_f01_tuple",
        forbidden_authority_sources=[
            "label",
            "liveness",
            "wbc_receipt",
            "rebuildable_projection",
        ],
        forbidden_sources_present=forbidden_present,
    )
    print(json.dumps(result))
    GATE_PY
    }
    
    child_agent_launch_authority_or_reject() {
      # Step 55-58: classify a watchdog child-agent launch (repair-loop, meta-repair,
      # managed-agent, or Kimi family).  A child launch may NEVER become accepted
      # repair outside canonical simple_fixer delegation; authority is never derived
      # from a label, liveness signal, WBC receipt, or rebuildable projection (SC38).
      # Forbidden sources emit a typed zero-authority rejection; exact-F01 occurrences
      # delegate to the simple_fixer singleton claim with no child agent fan-out.
      # Emits JSON on stdout with an ``outcome`` key in
      # {zero_authority_rejected, delegated, no_authority_claim}.
      local caller_kind="${1:-live_watchdog}"
      local caller_id="${2:-arnold-watchdog}"
      local _py_root="${WRAPPER_REPO_ROOT:-${ARNOLD_SRC:-}}"
      PYTHONSAFEPATH=1 PYTHONPATH="${_py_root:+$_py_root:}${PYTHONPATH:-}" python3 -P - \
        "$caller_kind" "$caller_id" <<'CHILD_AGENT_PY'
    import json, os, sys
    from arnold_pipelines.megaplan.cloud.wrappers.repair_delegation import (
        build_repair_delegation, emit_zero_authority_rejection,
    )
    from arnold_pipelines.megaplan.custody.contracts import F01_REPAIR_OCCURRENCE_FIELDS
    
    caller_kind = sys.argv[1] if len(sys.argv) > 1 else "live_watchdog"
    caller_id = sys.argv[2] if len(sys.argv) > 2 else "arnold-watchdog"
    
    forbidden = dict(
        authority_label=os.environ.get("ARNOLD_REPAIR_AUTHORITY_LABEL", ""),
        liveness_receipt=os.environ.get("ARNOLD_REPAIR_LIVENESS_RECEIPT", ""),
        wbc_receipt=os.environ.get("ARNOLD_REPAIR_WBC_RECEIPT", ""),
        rebuildable_projection=os.environ.get("ARNOLD_REPAIR_REBUILDABLE_PROJECTION", ""),
    )
    if any(v for v in forbidden.values()):
        result = emit_zero_authority_rejection(
            caller_kind, caller_id,
            reason="child-agent launch authority derived from forbidden source: "
                   + ",".join(sorted(k for k, v in forbidden.items() if v)),
        )
        print(json.dumps({
            "outcome": result.outcome,
            "delegated": False,
            "child_agent_fanout": False,
            "canonical_delegation_path": "simple_fixer.singleton_claim.exact_f01_tuple",
        }))
        sys.exit(0)
    
    f01_env = os.environ.get("ARNOLD_REPAIR_F01_OCCURRENCE", "")
    target = {}
    if f01_env:
        try:
            target = json.loads(f01_env)
        except Exception:
            target = {}
    
    if not target:
        print(json.dumps({
            "outcome": "no_authority_claim",
            "delegated": False,
            "child_agent_fanout": False,
            "canonical_delegation_path": "simple_fixer.singleton_claim.exact_f01_tuple",
        }))
        sys.exit(0)
    
    for name in F01_REPAIR_OCCURRENCE_FIELDS:
        target.setdefault(name, "")
    
    delegation = build_repair_delegation(caller_kind, caller_id, target)
    if delegation is None:
        result = emit_zero_authority_rejection(
            caller_kind, caller_id,
            reason="child-agent launch path could not construct exact F01 occurrence tuple",
        )
        print(json.dumps({
            "outcome": result.outcome,
            "delegated": False,
            "child_agent_fanout": False,
            "canonical_delegation_path": "simple_fixer.singleton_claim.exact_f01_tuple",
        }))
        sys.exit(0)
    
    print(json.dumps({
        "outcome": "delegated",
        "delegated": True,
        "child_agent_fanout": False,
        "canonical_delegation_path": "simple_fixer.singleton_claim.exact_f01_tuple",
        "occurrence_fingerprint": delegation.occurrence.occurrence_fingerprint,
    }))
    CHILD_AGENT_PY
    }
    
    watchdog_repair_state_authority_or_reject() {
      # Steps 59-65: classify a watchdog repair-state mutation (claim write, claim
      # adoption/existing-owner, stale-state cleanup, process reaping, retry loop,
      # unchanged-fingerprint escalation, or retry-budget mutation).  A repair-state
      # mutation may NEVER become accepted repair outside canonical simple_fixer
      # delegation; authority is never derived from a label, liveness signal, WBC
      # receipt, or rebuildable projection (SC39).  Forbidden sources emit a typed
      # zero-authority rejection; exact-F01 occurrences delegate to the simple_fixer
      # singleton claim with no child agent fan-out.  Emits JSON on stdout with an
      # ``outcome`` key in {zero_authority_rejected, delegated, no_authority_claim}.
      local caller_kind="${1:-live_watchdog}"
      local caller_id="${2:-arnold-watchdog}"
      local _py_root="${WRAPPER_REPO_ROOT:-${ARNOLD_SRC:-}}"
      PYTHONSAFEPATH=1 PYTHONPATH="${_py_root:+$_py_root:}${PYTHONPATH:-}" python3 -P - \
        "$caller_kind" "$caller_id" <<'REPAIR_STATE_PY'
    import json, os, sys
    from arnold_pipelines.megaplan.cloud.wrappers.repair_delegation import (
        build_repair_delegation, emit_zero_authority_rejection,
    )
    from arnold_pipelines.megaplan.custody.contracts import F01_REPAIR_OCCURRENCE_FIELDS
    
    caller_kind = sys.argv[1] if len(sys.argv) > 1 else "live_watchdog"
    caller_id = sys.argv[2] if len(sys.argv) > 2 else "arnold-watchdog"
    
    forbidden = dict(
        authority_label=os.environ.get("ARNOLD_REPAIR_AUTHORITY_LABEL", ""),
        liveness_receipt=os.environ.get("ARNOLD_REPAIR_LIVENESS_RECEIPT", ""),
        wbc_receipt=os.environ.get("ARNOLD_REPAIR_WBC_RECEIPT", ""),
        rebuildable_projection=os.environ.get("ARNOLD_REPAIR_REBUILDABLE_PROJECTION", ""),
    )
    if any(v for v in forbidden.values()):
        result = emit_zero_authority_rejection(
            caller_kind, caller_id,
            reason="repair-state mutation authority derived from forbidden source: "
                   + ",".join(sorted(k for k, v in forbidden.items() if v)),
        )
        print(json.dumps({
            "outcome": result.outcome,
            "delegated": False,
            "repair_state_mutation": False,
            "canonical_delegation_path": "simple_fixer.singleton_claim.exact_f01_tuple",
        }))
        sys.exit(0)
    
    f01_env = os.environ.get("ARNOLD_REPAIR_F01_OCCURRENCE", "")
    target = {}
    if f01_env:
        try:
            target = json.loads(f01_env)
        except Exception:
            target = {}
    
    if not target:
        print(json.dumps({
            "outcome": "no_authority_claim",
            "delegated": False,
            "repair_state_mutation": False,
            "canonical_delegation_path": "simple_fixer.singleton_claim.exact_f01_tuple",
        }))
        sys.exit(0)
    
    for name in F01_REPAIR_OCCURRENCE_FIELDS:
        target.setdefault(name, "")
    
    delegation = build_repair_delegation(caller_kind, caller_id, target)
    if delegation is None:
        result = emit_zero_authority_rejection(
            caller_kind, caller_id,
            reason="repair-state mutation path could not construct exact F01 occurrence tuple",
        )
        print(json.dumps({
            "outcome": result.outcome,
            "delegated": False,
            "repair_state_mutation": False,
            "canonical_delegation_path": "simple_fixer.singleton_claim.exact_f01_tuple",
        }))
        sys.exit(0)
    
    print(json.dumps({
        "outcome": "delegated",
        "delegated": True,
        "repair_state_mutation": True,
        "canonical_delegation_path": "simple_fixer.singleton_claim.exact_f01_tuple",
        "occurrence_fingerprint": delegation.occurrence.occurrence_fingerprint,
    }))
    REPAIR_STATE_PY
    }
    
    kimi_dispatch_marker_set() {
      local session="$1" marker_kind="${2:-deterministic_relaunch}" run_id="${3:-}" manifest_path="${4:-}"
      if [[ "$marker_kind" == "managed_agent" && ( -z "$run_id" || -z "$manifest_path" ) ]]; then
        return 1
      fi
      printf 'arnold-dispatch-marker-v2\t%s\t%s\t%s\t%s\n' \
        "$marker_kind" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$run_id" "$manifest_path" \
        > "$(kimi_dispatch_marker_path "$session")" 2>/dev/null || authority_gap_continue "T29-BYPASS-146" "authority-risk bypass converted to typed evidence gap"
    }
    
    kimi_dispatch_marker_clear() {
      if [[ "${MUTATION_CAPABILITY_PRESENT:-0}" != "1" ]]; then
        log "kimi dispatch marker clear observe-only without minted MutationCapability session=${1:-}"
        return 0
      fi
      rm -f "$(kimi_dispatch_marker_path "$1")" "$(kimi_pgid_path "$1")" 2>/dev/null || authority_gap_continue "T29-BYPASS-147" "authority-risk bypass converted to typed evidence gap"
    }
    
    meta_dispatch_marker_set() {
      local session="$1" run_id="$2" manifest_path="$3"
      [[ -n "$run_id" && -n "$manifest_path" ]] || return 1
      printf 'arnold-dispatch-marker-v2\tmanaged_agent\t%s\t%s\t%s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$run_id" "$manifest_path" \
        > "$(meta_dispatch_marker_path "$session")" 2>/dev/null || authority_gap_continue "T29-BYPASS-148" "authority-risk bypass converted to typed evidence gap"
    }
    
    meta_dispatch_marker_clear() {
      if [[ "${MUTATION_CAPABILITY_PRESENT:-0}" != "1" ]]; then
        log "meta dispatch marker clear observe-only without minted MutationCapability session=${1:-}"
        return 0
      fi
      rm -f "$(meta_dispatch_marker_path "$1")" "$(meta_pgid_path "$1")" 2>/dev/null || authority_gap_continue "T29-BYPASS-149" "authority-risk bypass converted to typed evidence gap"
    }
    
    write_partial_liveness_tick() {
      local session="$1"
      local workspace="$2"
      local remote_spec="$3"
      local run_kind="${4:-chain}"
      local plan_name="${5:-}"
      local health="${6:-alive}"
      local sidecar_dir events_path
      sidecar_dir="${CLOUD_WATCHDOG_REPAIR_SIDECAR_DIR:-${REPAIR_DATA_DIR}.d}"
      events_path="$sidecar_dir/events/events.jsonl"
      mkdir -p "$(dirname "$events_path")" 2>/dev/null || true
      PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$events_path" "$session" "$health" "$workspace" "$remote_spec" "$run_kind" "$plan_name" <<'PY'
    import json
    import os
    import sys
    from datetime import datetime, timezone
    
    events_path, session, health, workspace, remote_spec, run_kind, plan_name = sys.argv[1:8]
    
    MAX_TICKS = 20
    
    tick = {
        "session": session,
        "outcome": "partial_liveness",
        "health": health,
        "recorded_at": datetime.now(timezone.utc).isoformat(),
        "run_kind": run_kind,
        "plan_name": plan_name,
    }
    
    # Read existing events, append the new tick, and truncate to MAX_TICKS
    events = []
    try:
        if os.path.exists(events_path):
            with open(events_path, "r", encoding="utf-8") as fh:
                for line in fh:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        events.append(json.loads(line))
                    except json.JSONDecodeError:
                        continue
    except Exception:
        pass
    
    events.append(tick)
    
    # Keep only the most recent MAX_TICKS
    if len(events) > MAX_TICKS:
        events = events[-MAX_TICKS:]
    
    # Write atomically via temp file
    tmp_path = events_path + ".tmp"
    try:
        with open(tmp_path, "w", encoding="utf-8") as fh:
            for entry in events:
                fh.write(json.dumps(entry, sort_keys=True) + "\n")
        os.replace(tmp_path, events_path)
    except Exception:
        pass
    PY
    }
    
    env_gone_sidecar_path() {
      printf '%s/%s.env-gone' "$MARKER_DIR" "$(safe_name "$1")"
    }
    
    # Detect whether a session's environment has been wiped (workspace dir or
    # chain/epic-chain spec gone — typically after a box reset/redeploy). Uses a
    # strike counter so a transient deploy gap doesn't retire a live session.
    #
    #stdout: prints one of:
    #   - "gone"    and exits 0  -> env missing AND strikes >= $ENV_GONE_STRIKES
    #   - "<count>" and exits 1  -> env missing, strikes below threshold (count printed)
    #   - "present" and exits 1  -> env present (any prior sidecar cleared; recovers
    #                              from a transient deploy that has since resolved)
    environment_gone_check() {
      local session="$1"
      local workspace="$2"
      local spec_path="${3:-}"
      local sidecar count
      sidecar="$(env_gone_sidecar_path "$session")"
    
      # Env present: clear any stale strike sidecar and signal fall-through.
      if [[ -d "$workspace" ]] && { [[ -z "$spec_path" ]] || [[ -f "$spec_path" ]]; }; then
        if [[ -f "$sidecar" ]]; then
          if [[ "${MUTATION_CAPABILITY_PRESENT:-0}" != "1" ]]; then
            log "env-gone strikes preserved; observe-only without minted MutationCapability session=$session workspace=$workspace spec=${spec_path:-}"
          else
            rm -f "$sidecar" 2>/dev/null || authority_gap_continue "T29-BYPASS-151" "authority-risk bypass converted to typed evidence gap"
            log "env-gone strikes cleared; environment recovered session=$session workspace=$workspace spec=${spec_path:-}"
          fi
        fi
        printf 'present\n'
        return 1
      fi
    
      count=0
      if [[ -f "$sidecar" ]]; then
        count="$(cat "$sidecar" 2>/dev/null || authority_gap_continue "T29-BYPASS-152" "authority-risk bypass converted to typed evidence gap")"
        count="${count//[!0-9]/}"
        count="${count:-0}"
      fi
      count=$((count + 1))
      printf '%s\n' "$count" >"$sidecar" 2>/dev/null || authority_gap_continue "T29-BYPASS-153" "authority-risk bypass converted to typed evidence gap"
    
      if (( count >= ENV_GONE_STRIKES )); then
        printf 'gone\n'
        return 0
      fi
      printf '%s\n' "$count"
      return 1
    }
    
    # Persist an environment_gone terminal outcome to repair-data for audit.
    # Writes via save_repair_data directly (NOT repair_data_set_outcome, which
    # requires the repair lock the watchdog does not hold). Best-effort: a failed
    # write must not block session retirement.
    persist_environment_gone_outcome() {
      local session="$1"
      local workspace="$2"
      local remote_spec="$3"
      local run_kind="${4:-chain}"
      local plan_name="${5:-}"
      if [[ "${MUTATION_CAPABILITY_PRESENT:-0}" != "1" ]]; then
        log "environment-gone retirement observe-only without minted MutationCapability session=$session"
        return 0
      fi
      local data_file="${REPAIR_DATA_DIR:-$MARKER_DIR/repair-data}/${session}.repair-data.json"
      PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$data_file" "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" <<'PY' 2>>"${LOG:-/dev/null}" || authority_gap_continue "T29-BYPASS-154" "authority-risk bypass converted to typed evidence gap"
    import pathlib
    import sys
    
    from arnold_pipelines.megaplan.cloud.repair_contract import (
        ENVIRONMENT_GONE,
        load_json,
        save_repair_data,
    )
    
    data_path_raw, session, workspace, remote_spec, run_kind, plan_name = sys.argv[1:]
    data_path = pathlib.Path(data_path_raw)
    payload = load_json(data_path, default={})
    if not isinstance(payload, dict):
        payload = {}
    payload.setdefault("session", session)
    payload.setdefault("workspace", workspace)
    payload.setdefault("run_kind", run_kind)
    payload.setdefault("plan_name", plan_name)
    payload["workspace"] = workspace
    payload["run_kind"] = run_kind
    payload["plan_name"] = plan_name
    payload["outcome"] = ENVIRONMENT_GONE
    save_repair_data(data_path, payload)
    PY
    }
    
    clear_session_tracking_artifacts() {
      local session="$1"
      local plan_name="${2:-}"
      if [[ "${MUTATION_CAPABILITY_PRESENT:-0}" != "1" ]]; then
        log "session tracking artifacts observe-only without minted MutationCapability session=$session"
        return 0
      fi
      rm -f "$(session_marker_path "$session")" 2>/dev/null || authority_gap_continue "T29-BYPASS-155" "authority-risk bypass converted to typed evidence gap"
      kimi_dispatch_marker_clear "$session"
      rm -f "$(repair_needs_human_path "$session")" 2>/dev/null || authority_gap_continue "T29-BYPASS-156" "authority-risk bypass converted to typed evidence gap"
      rm -f "$(chain_health_snapshot_path "$session")" "$(chain_health_artifact_path "$session")" 2>/dev/null || authority_gap_continue "T29-BYPASS-157" "authority-risk bypass converted to typed evidence gap"
      if [[ -n "$plan_name" ]]; then
        rm -f "$MARKER_DIR/$plan_name.progress.json" 2>/dev/null || authority_gap_continue "T29-BYPASS-158" "authority-risk bypass converted to typed evidence gap"
      fi
    }
    
    plan_terminal_status() {
      local workspace="$1"
      local plan_name="$2"
      python3 - "$workspace" "$plan_name" <<'PY'
    import json
    import pathlib
    import sys
    
    workspace = pathlib.Path(sys.argv[1])
    plan_name = sys.argv[2]
    plans_dir = workspace / ".megaplan" / "plans"
    state_paths = []
    if plan_name:
        state_paths.append(plans_dir / plan_name / "state.json")
    else:
        state_paths.extend(
            sorted(
                plans_dir.glob("*/state.json"),
                key=lambda path: path.stat().st_mtime,
                reverse=True,
            )
        )
    if not state_paths:
        print("none")
        raise SystemExit(0)
    
    state_path = state_paths[0]
    try:
        state = json.loads(state_path.read_text(encoding="utf-8"))
    except Exception:
        print("none")
        raise SystemExit(0)
    
    current_state = state.get("current_state")
    if str(current_state or "").strip().lower() in {
        "done",
        "completed",
        "reviewed",
        "abandoned",
    }:
        print(f"{state_path.parent.name}\t{current_state}")
    else:
        print("none")
    PY
    }
    
    kimi_dispatch_failed_previously() {
      local session="$1"
      [[ -f "$(kimi_dispatch_marker_path "$session")" ]] \
        && [[ -f "$(kimi_pgid_path "$session")" ]] \
        && ! kimi_operator_running "$session"
    }
    
    mechanical_relaunch_attempted_previously() {
      local session="$1"
      [[ -f "$(kimi_dispatch_marker_path "$session")" ]] \
        && [[ ! -f "$(kimi_pgid_path "$session")" ]] \
        && ! kimi_operator_running "$session"
    }
    
    repair_data_outcome_for_session() {
      local session="$1"
      local data_path="${REPAIR_DATA_DIR:-$MARKER_DIR/repair-data}/$session.repair-data.json"
      [[ -r "$data_path" ]] || return 0
      python3 - "$data_path" <<'PY'
    import json
    import pathlib
    import sys
    
    try:
        payload = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
    except Exception:
        payload = {}
    if isinstance(payload, dict):
        outcome = str(payload.get("outcome") or "").strip()
        if outcome:
            print(outcome)
    PY
    }
    
    repair_outcome_wants_repair_retry() {
      case "${1:-}" in
        recurring_retry_pending)
          return 0
          ;;
        *)
          return 1
          ;;
      esac
    }
    
    emit_watchdog_incident_bridge_event() {
      local event_kind="$1"
      local session="$2"
      local workspace="$3"
      local remote_spec="$4"
      local summary="$5"
      local status="$6"
      local repair_actor="${7:-immediate_repair}"
      local extra_evidence_json="${8:-[]}"
      PYTHONPATH="${WRAPPER_REPO_ROOT}:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - \
        "$event_kind" "$session" "$workspace" "$remote_spec" "$summary" "$status" "$repair_actor" \
        "${REPAIR_DATA_DIR:-$MARKER_DIR/repair-data}" "$extra_evidence_json" <<'PY' \
        >> "${LOG:-/dev/null}" 2>&1 || authority_gap_continue "T29-BYPASS-159" "authority-risk bypass converted to typed evidence gap"
    import json
    import pathlib
    import sys
    
    from arnold_pipelines.megaplan.cloud.incident_bridge import (
        append_watchdog_detection,
        append_watchdog_dispatch,
    )
    
    (
        event_kind,
        session,
        workspace_raw,
        remote_spec,
        summary,
        status,
        repair_actor,
        repair_data_dir_raw,
        extra_evidence_json,
    ) = sys.argv[1:]
    repair_data_dir = pathlib.Path(repair_data_dir_raw)
    data_path = repair_data_dir / f"{session}.repair-data.json"
    if not data_path.exists():
        raise SystemExit(0)
    try:
        payload = json.loads(data_path.read_text(encoding="utf-8"))
    except Exception:
        payload = {}
    if not isinstance(payload, dict):
        raise SystemExit(0)
    incident_id = str(payload.get("incident_id") or "").strip()
    if not incident_id:
        raise SystemExit(0)
    problem_id = str(payload.get("problem_id") or "").strip() or None
    workspace = pathlib.Path(workspace_raw) if workspace_raw else pathlib.Path.cwd()
    evidence = [
        {
            "kind": "watchdog_observation",
            "status": status,
            "repair_actor": repair_actor,
            "workspace": workspace_raw,
            "remote_spec": remote_spec,
        }
    ]
    try:
        loaded_extra = json.loads(extra_evidence_json)
    except Exception:
        loaded_extra = []
    if isinstance(loaded_extra, list):
        evidence.extend(loaded_extra)
    elif isinstance(loaded_extra, dict):
        evidence.append(loaded_extra)
    
    if event_kind == "detection":
        append_watchdog_detection(
            incident_id=incident_id,
            summary=summary,
            outcome=status,
            evidence=evidence,
            session_id=session,
            problem_id=problem_id,
            next_expected_event="watchdog.dispatch",
            root=workspace,
        )
        raise SystemExit(0)
    
    next_expected_event = None
    if status == "dispatched":
        if repair_actor == "meta_repair":
            next_expected_event = "meta_repair.repair_attempt"
        else:
            next_expected_event = "immediate_repair.repair_attempt"
    append_watchdog_dispatch(
        incident_id=incident_id,
        summary=summary,
        outcome=status,
        evidence=evidence,
        session_id=session,
        problem_id=problem_id,
        next_expected_event=next_expected_event,
        decision={
            "repair_actor": repair_actor,
            "status": status,
            "workspace": workspace_raw,
            "remote_spec": remote_spec,
        },
        root=workspace,
    )
    PY
    }
    
    # ── P2 typed runtime transitions ──────────────────────────────────────────
    # One typed deviation/fallback event path.  Every runtime deviation and
    # fallback decision is appended to the incident ledger BEFORE the caller
    # performs a dispatch side effect.  The append is synchronous and never
    # swallowed: a non-zero CLI exit (policy rejection or journal write failure)
    # returns 1 and the caller MUST block dispatch (no event = no side effect).
    # Emitting is a pure append-only ledger write — it never dispatches repair
    # and never triggers a scan (mirror of emit_watchdog_incident_bridge_event).
    # Missing inputs (no workspace, no spec, unreadable spec) FAIL CLOSED: the
    # event cannot be durably recorded without a contract digest, so the caller
    # MUST treat a non-zero return as "do not dispatch" — never succeed
    # eventless.
    emit_runtime_transition_event() {
      local event_name="$1"
      local session="$2"
      local workspace="$3"
      local remote_spec="$4"
      local failure_class="${5:-}"
      local error_text="${6:-}"
      local candidate_to="${7:-}"
      local candidate_from="${8:-}"
      local attempt_num="${9:-}"
      local summary_text="${10:-}"
      local chain_digest ledger_rc
      local -a ledger_args
      if [[ -z "$workspace" || -z "$remote_spec" || ! -f "$remote_spec" ]]; then
        printf '[watchdog %s] runtime transition ledger input missing (workspace/spec) for %s; blocking dispatch session=%s\n' \
          "$(date -Iseconds)" "$event_name" "$session" >>"${LOG:-/dev/null}" 2>&1 || true
        return 1
      fi
      chain_digest="$(PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$remote_spec" <<'PY'
    import pathlib
    import sys
    
    from arnold_pipelines.megaplan.chain.spec import chain_spec_sha256
    
    print(chain_spec_sha256(pathlib.Path(sys.argv[1])))
    PY
    )"
      if [[ -z "$chain_digest" ]]; then
        return 1
      fi
      ledger_args=(
        "$event_name"
        --root "$workspace"
        --scope "chain:$session"
        --session-id "$session"
        --actor "arnold-watchdog"
        --failure-class "$failure_class"
        --error "$error_text"
        --candidate-to "$candidate_to"
        --candidate-from "$candidate_from"
        --attempt "$attempt_num"
        --chain-spec-sha256 "$chain_digest"
      )
      if [[ -n "$summary_text" ]]; then
        ledger_args+=(--summary "$summary_text")
      fi
      PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 -W ignore::RuntimeWarning \
        -m arnold_pipelines.megaplan.incident.ledger "${ledger_args[@]}" \
        >> "${LOG:-/dev/null}" 2>&1
      ledger_rc=$?
      if [[ "$ledger_rc" != "0" ]]; then
        printf '[watchdog %s] runtime transition ledger write failed (%s) rc=%s; blocking dispatch session=%s\n' \
          "$(date -Iseconds)" "$event_name" "$ledger_rc" "$session" >>"${LOG:-/dev/null}" 2>&1 || true
        return 1
      fi
      return 0
    }
    
    # ---- meta-repair dispatch ----------------------------------------------------
    # Meta-repair diagnoses and fixes repair-system failures when ordinary repair
    # has proven insufficient.  It is gated behind META_REPAIR_ENABLED (default-on),
    # guarded against recursion, and tracked with dedicated marker/pgid sidecars so
    # the watchdog can observe its lifecycle independently of ordinary repair.
    
    run_repair_data_maintenance() {
      local throttle_secs="${REPAIR_DATA_RETENTION_INTERVAL_SECS:-21600}"
      [[ "$throttle_secs" =~ ^[0-9]+$ ]] || throttle_secs=21600
      if (( throttle_secs <= 0 )); then
        return 0
      fi
    
      PYTHONPATH="${WRAPPER_REPO_ROOT}:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$MARKER_DIR" "$REPAIR_DATA_DIR" "$throttle_secs" <<'PY'
    import json
    import pathlib
    import sys
    from datetime import datetime, timezone
    
    from arnold_pipelines.megaplan.cloud.repair_contract import cleanup_repair_data_retention, load_json
    from arnold_pipelines.megaplan.cloud.repair_lock import inspect_repair_lock
    from arnold_pipelines.megaplan.cloud.session_markers import is_canonical_session_marker_path
    
    marker_dir = pathlib.Path(sys.argv[1])
    repair_data_dir = pathlib.Path(sys.argv[2])
    throttle_secs = int(sys.argv[3])
    sidecar_dir = repair_data_dir.with_name(f"{repair_data_dir.name}.d")
    stamp_path = sidecar_dir / "cleanup" / "retention-maintenance.json"
    now = datetime.now(timezone.utc)
    
    previous = load_json(stamp_path, default={})
    last_started_at = str(previous.get("started_at") or "").strip() if isinstance(previous, dict) else ""
    if last_started_at:
        try:
            started_at = datetime.fromisoformat(last_started_at)
        except ValueError:
            started_at = None
        if started_at is not None and (now - started_at).total_seconds() < throttle_secs:
            print("THROTTLED")
            raise SystemExit(0)
    
    for lock_dir in sorted(marker_dir.glob("*.repair-loop.lock")):
        result = inspect_repair_lock(lock_dir)
        if result.busy:
            print("LOCK_BUSY")
            raise SystemExit(0)
    
    active_sessions: set[str] = set()
    for path in sorted(marker_dir.glob("*.json")):
        if not is_canonical_session_marker_path(path):
            continue
        try:
            payload = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            continue
        if isinstance(payload, dict):
            session = str(payload.get("session") or "").strip()
            if session:
                active_sessions.add(session)
    
    stamp_path.parent.mkdir(parents=True, exist_ok=True)
    stamp_path.write_text(json.dumps({"started_at": now.isoformat()}, sort_keys=True), encoding="utf-8")
    summary = cleanup_repair_data_retention(
        repair_data_dir,
        sidecar_dir=sidecar_dir,
        index_path=repair_data_dir / "index.json",
        now=now,
        active_session_ids=active_sessions,
    )
    stamp_path.write_text(
        json.dumps(
            {
                "started_at": now.isoformat(),
                "completed_at": datetime.now(timezone.utc).isoformat(),
                "cleanup_id": summary.get("cleanup_id", ""),
            },
            sort_keys=True,
        ),
        encoding="utf-8",
    )
    print(f"RAN:{summary.get('cleanup_id', '')}")
    PY
    }
    
    reap_stale_repair_candidates() {
      python3 - "$REAP_AGE_SECS" "$REAP_ORPHAN_AGE_SECS" <<'PY'
    import re
    import sys
    
    SESSION_RE = re.compile(r"Session:\s+([^\s]+)")
    CODEX_RE = re.compile(r"(^|\s)codex exec(\s|$)")
    RUN_AGENT_HINTS = (
        "workflows on this Hetzner worker should never pause unexpectedly",
        "cloud watchdog",
        "Kimi launch/diagnosis turn",
    )
    CODEX_HINTS = (
        "You are the watchdog repair-loop dev-fix agent",
        "bounded 3-iteration repair loop",
        "repair data file",
        "workflows on this Hetzner worker should not pause unexpectedly",
    )
    PROTECTED_HINTS = (
        "arnold-watchdog",
        "arnold-progress-auditor",
    )
    RULE_PRIORITY = {
        "orphan_fast_path": 0,
        "age_backstop": 1,
    }
    KIND_PRIORITY = {
        "arnold.agent.run_agent": 0,
        "codex exec": 1,
    }
    
    
    def parse_ps_row(raw: str):
        parts = raw.strip().split(None, 4)
        if len(parts) < 5:
            return None
        try:
            return {
                "pid": int(parts[0]),
                "ppid": int(parts[1]),
                "pgid": int(parts[2]),
                "etimes": int(parts[3]),
                "args": parts[4],
            }
        except ValueError:
            return None
    
    
    def extract_session(kind: str, args: str) -> str:
        match = SESSION_RE.search(args)
        return match.group(1) if match else ""
    
    
    def classify_kind(args: str) -> str:
        if any(hint in args for hint in PROTECTED_HINTS):
            return ""
        if "arnold.agent.run_agent" in args:
            session = extract_session("arnold.agent.run_agent", args)
            if session and any(hint in args for hint in RUN_AGENT_HINTS):
                return "arnold.agent.run_agent"
        if CODEX_RE.search(args):
            session = extract_session("codex exec", args)
            if session and any(hint in args for hint in CODEX_HINTS):
                return "codex exec"
        return ""
    
    
    def decide_reap(row: dict[str, object], age_secs: int, orphan_age_secs: int) -> dict[str, object]:
        args = str(row.get("args") or "")
        kind = classify_kind(args)
        session = extract_session(kind, args) if kind else ""
        decision = {
            "pid": int(row.get("pid") or 0),
            "ppid": int(row.get("ppid") or 0),
            "pgid": int(row.get("pgid") or 0),
            "etimes": int(row.get("etimes") or 0),
            "kind": kind,
            "session": session,
            "reap": False,
            "rule": "",
            "reason": "non_target" if not kind else "under_age",
        }
        if not kind:
            return decision
        if (
            kind in {"arnold.agent.run_agent", "codex exec"}
            and decision["ppid"] == 1
            and decision["etimes"] > orphan_age_secs
        ):
            decision["reap"] = True
            decision["rule"] = "orphan_fast_path"
            decision["reason"] = "orphaned_ppid_1"
            return decision
        if decision["etimes"] > age_secs:
            decision["reap"] = True
            decision["rule"] = "age_backstop"
            decision["reason"] = "elapsed_exceeded"
        return decision
    
    
    def choose_reap_candidates(rows: list[dict[str, object]], age_secs: int, orphan_age_secs: int):
        candidates = [
            decide_reap(row, age_secs, orphan_age_secs)
            for row in rows
        ]
        candidates = [item for item in candidates if item["reap"]]
        candidates.sort(
            key=lambda item: (
                item["session"] or "",
                item["pgid"],
                RULE_PRIORITY[item["rule"]],
                KIND_PRIORITY[item["kind"]],
                -item["etimes"],
                item["pid"],
            )
        )
        seen_sessions = set()
        seen_pgids = set()
        selected = []
        for item in candidates:
            session = item["session"]
            pgid = item["pgid"]
            if session and session in seen_sessions:
                continue
            if pgid in seen_pgids:
                continue
            selected.append(item)
            if session:
                seen_sessions.add(session)
            seen_pgids.add(pgid)
        return selected
    
    
    def main() -> int:
        age_secs = int(sys.argv[1])
        orphan_age_secs = int(sys.argv[2])
        rows = []
        for raw in sys.stdin:
            row = parse_ps_row(raw)
            if row:
                rows.append(row)
        for item in choose_reap_candidates(rows, age_secs, orphan_age_secs):
            print(
                "\t".join(
                    [
                        str(item["pid"]),
                        str(item["ppid"]),
                        str(item["pgid"]),
                        str(item["etimes"]),
                        str(item["kind"]),
                        str(item["session"]),
                        str(item["rule"]),
                        str(item["reason"]),
                    ]
                )
            )
        return 0
    
    
    if __name__ == "__main__":
        raise SystemExit(main())
    PY
    }
    
    reap_stalled_repair_candidates() {
      python3 - "$MARKER_DIR" "$REPAIR_OPERATOR_ROOT" "$REAP_STALL_GRACE_SECS" "$REAP_STALL_IDLE_SECS" "$REAP_AGE_SECS" <<'PY'
    import datetime as dt
    import json
    import pathlib
    import re
    import sys
    
    marker_dir = pathlib.Path(sys.argv[1])
    operator_root = pathlib.Path(sys.argv[2])
    stall_grace_secs = int(sys.argv[3])
    stall_idle_secs = int(sys.argv[4])
    reap_age_secs = int(sys.argv[5])
    
    SESSION_RE = re.compile(r"Session:\s+([^\s]+)")
    CODEX_RE = re.compile(r"(^|\s)codex exec(\s|$)")
    RUN_AGENT_HINTS = (
        "workflows on this Hetzner worker should never pause unexpectedly",
        "cloud watchdog",
        "Kimi launch/diagnosis turn",
    )
    CODEX_HINTS = (
        "You are the watchdog repair-loop dev-fix agent",
        "bounded 3-iteration repair loop",
        "repair data file",
        "workflows on this Hetzner worker should not pause unexpectedly",
    )
    PROTECTED_HINTS = (
        "arnold-watchdog",
        "arnold-progress-auditor",
    )
    KIND_PRIORITY = {
        "arnold.agent.run_agent": 0,
        "codex exec": 1,
    }
    RECENT_WINDOW_SECS = max(reap_age_secs, stall_grace_secs + stall_idle_secs, 1800)
    now = dt.datetime.now(dt.timezone.utc)
    
    
    def parse_ps_row(raw: str):
        parts = raw.strip().split(None, 4)
        if len(parts) < 5:
            return None
        try:
            return {
                "pid": int(parts[0]),
                "ppid": int(parts[1]),
                "pgid": int(parts[2]),
                "etimes": int(parts[3]),
                "args": parts[4],
            }
        except ValueError:
            return None
    
    
    def extract_session(kind: str, args: str) -> str:
        match = SESSION_RE.search(args)
        return match.group(1) if match else ""
    
    
    def classify_kind(args: str) -> str:
        if any(hint in args for hint in PROTECTED_HINTS):
            return ""
        if "arnold.agent.run_agent" in args:
            session = extract_session("arnold.agent.run_agent", args)
            if session and any(hint in args for hint in RUN_AGENT_HINTS):
                return "arnold.agent.run_agent"
        if CODEX_RE.search(args):
            session = extract_session("codex exec", args)
            if session and any(hint in args for hint in CODEX_HINTS):
                return "codex exec"
        return ""
    
    
    def safe_name(value: str) -> str:
        return re.sub(r"[^A-Za-z0-9_.-]", "-", value)
    
    
    def iso_to_dt(raw: object):
        if not isinstance(raw, str) or not raw:
            return None
        try:
            return dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
        except ValueError:
            return None
    
    
    def file_stats(path: pathlib.Path) -> tuple[float, int]:
        try:
            stat = path.stat()
        except OSError:
            return (0.0, 0)
        return (float(stat.st_mtime), int(stat.st_size))
    
    
    def snapshot_path_for(session: str) -> pathlib.Path:
        return marker_dir / f"{session}.reap-progress.json"
    
    
    def find_recent_operator_dir(session: str):
        if not session or not operator_root.is_dir():
            return None
        safe_session = safe_name(session)
        candidates = []
        for path in operator_root.glob(f"*-{safe_session}"):
            if not path.is_dir():
                continue
            log_paths = [candidate for candidate in path.glob("*.log") if candidate.is_file()]
            mtimes = [file_stats(path)[0], *(file_stats(candidate)[0] for candidate in log_paths)]
            newest_mtime = max(mtimes)
            if newest_mtime <= 0:
                continue
            age_secs = max(0, int((now - dt.datetime.fromtimestamp(newest_mtime, tz=dt.timezone.utc)).total_seconds()))
            if age_secs > RECENT_WINDOW_SECS:
                continue
            candidates.append((newest_mtime, path))
        if not candidates:
            return None
        candidates.sort(key=lambda item: (item[0], str(item[1])), reverse=True)
        return candidates[0][1]
    
    
    def assess_session_progress(session: str) -> dict[str, object]:
        operator_dir = find_recent_operator_dir(session)
        if operator_dir is None:
            return {"mapped": False, "reason": "unmappable"}
    
        log_paths = [candidate for candidate in operator_dir.glob("*.log") if candidate.is_file()]
        stats = [(candidate.name, *file_stats(candidate)) for candidate in log_paths]
        if not stats:
            return {"mapped": False, "reason": "no_logs"}
        stats.sort(key=lambda item: (item[1], item[2], item[0]), reverse=True)
        newest_name, newest_mtime, newest_size = stats[0]
    
        snapshot = {
            "operator_dir": str(operator_dir),
            "log_name": newest_name,
            "log_mtime": newest_mtime,
            "log_size": newest_size,
        }
        snapshot_dir = snapshot_path_for(session).parent
        snapshot_dir.mkdir(parents=True, exist_ok=True)
        prev = {}
        snapshot_path = snapshot_path_for(session)
        if snapshot_path.exists():
            try:
                prev = json.loads(snapshot_path.read_text(encoding="utf-8"))
            except Exception:
                prev = {}
    
        same_observation = (
            prev.get("operator_dir") == snapshot["operator_dir"]
            and prev.get("log_name") == snapshot["log_name"]
            and prev.get("log_mtime") == snapshot["log_mtime"]
            and prev.get("log_size") == snapshot["log_size"]
        )
        if same_observation:
            last_advance = (
                iso_to_dt(prev.get("last_advance_ts"))
                or iso_to_dt(prev.get("ts"))
                or dt.datetime.fromtimestamp(newest_mtime, tz=dt.timezone.utc)
            )
        else:
            if prev:
                last_advance = now
            else:
                last_advance = dt.datetime.fromtimestamp(newest_mtime, tz=dt.timezone.utc)
        idle_secs = max(0, int((now - last_advance).total_seconds()))
    
        persisted = dict(snapshot)
        persisted["last_advance_ts"] = last_advance.isoformat()
        persisted["ts"] = now.isoformat()
        try:
            snapshot_path.write_text(json.dumps(persisted, sort_keys=True) + "\n", encoding="utf-8")
        except Exception:
            pass
    
        return {
            "mapped": True,
            "operator_dir": str(operator_dir),
            "idle_secs": idle_secs,
            "stalled": idle_secs >= stall_idle_secs,
        }
    
    
    rows_by_session = {}
    progress_cache = {}
    for raw in sys.stdin:
        row = parse_ps_row(raw)
        if not row:
            continue
        kind = classify_kind(str(row["args"]))
        if not kind:
            continue
        session = extract_session(kind, str(row["args"]))
        if not session:
            continue
        row["kind"] = kind
        row["session"] = session
        rows_by_session.setdefault(session, []).append(row)
    
    candidates = []
    for session, rows in rows_by_session.items():
        progress = progress_cache.setdefault(session, assess_session_progress(session))
        if not progress.get("mapped"):
            continue
        eligible = [row for row in rows if int(row["etimes"]) >= stall_grace_secs]
        if not eligible or not progress.get("stalled"):
            continue
        eligible.sort(
            key=lambda row: (
                KIND_PRIORITY[str(row["kind"])],
                -int(row["etimes"]),
                int(row["pid"]),
            )
        )
        chosen = eligible[0]
        candidates.append(
            {
                "pid": int(chosen["pid"]),
                "ppid": int(chosen["ppid"]),
                "pgid": int(chosen["pgid"]),
                "etimes": int(chosen["etimes"]),
                "kind": str(chosen["kind"]),
                "session": session,
                "rule": "stalled",
                "reason": f"stall_idle_{int(progress['idle_secs'])}s",
                "operator_dir": str(progress["operator_dir"]),
                "idle_secs": int(progress["idle_secs"]),
            }
        )
    
    candidates.sort(
        key=lambda item: (
            item["session"],
            KIND_PRIORITY[item["kind"]],
            -item["etimes"],
            item["pid"],
        )
    )
    seen_pgids = set()
    for item in candidates:
        pgid = item["pgid"]
        if pgid in seen_pgids:
            continue
        seen_pgids.add(pgid)
        print(
            "\t".join(
                [
                    str(item["pid"]),
                    str(item["ppid"]),
                    str(item["pgid"]),
                    str(item["etimes"]),
                    item["kind"],
                    item["session"],
                    item["rule"],
                    item["reason"],
                    item["operator_dir"],
                    str(item["idle_secs"]),
                ]
            )
        )
    PY
    }
    
    kill_process_group() {
      local pgid="$1"
      [[ "$pgid" =~ ^[0-9]+$ ]] || return 1
      kill -- "-$pgid" >/dev/null 2>&1 || return 1
      sleep 0.5
      if kill -0 -- "-$pgid" >/dev/null 2>&1; then
        kill -9 -- "-$pgid" >/dev/null 2>&1 || true
        sleep 0.2
      fi
      ! kill -0 -- "-$pgid" >/dev/null 2>&1
    }
    
    repair_tree_pgids() {
      local root_pid="$1"
      local root_pgid="$2"
      [[ "$root_pid" =~ ^[0-9]+$ ]] || return 1
      [[ "$root_pgid" =~ ^[0-9]+$ ]] || return 1
      python3 - "$root_pid" "$root_pgid" <<'PY'
    import subprocess
    import sys
    
    root_pid = int(sys.argv[1])
    root_pgid = int(sys.argv[2])
    proc = subprocess.run(
        ["ps", "-eo", "pid=,ppid=,pgid="],
        capture_output=True,
        text=True,
        check=False,
    )
    children = {}
    pgids = {}
    for line in proc.stdout.splitlines():
        parts = line.strip().split()
        if len(parts) != 3:
            continue
        try:
            pid = int(parts[0])
            ppid = int(parts[1])
            pgid = int(parts[2])
        except ValueError:
            continue
        children.setdefault(ppid, []).append(pid)
        pgids[pid] = pgid
    
    seen_groups = [root_pgid]
    
    def walk(pid: int) -> None:
        for child in children.get(pid, []):
            child_pgid = pgids.get(child)
            if child_pgid and child_pgid not in seen_groups:
                seen_groups.append(child_pgid)
            walk(child)
    
    walk(root_pid)
    print(" ".join(str(group) for group in seen_groups))
    PY
    }
    
    kill_pid_and_descendants() {
      local root_pid="$1"
      local pid_list
      [[ "$root_pid" =~ ^[0-9]+$ ]] || return 1
      pid_list="$(
        python3 - "$root_pid" <<'PY'
    import subprocess
    import sys
    
    root = int(sys.argv[1])
    proc = subprocess.run(
        ["ps", "-eo", "pid=,ppid="],
        capture_output=True,
        text=True,
        check=False,
    )
    children = {}
    for line in proc.stdout.splitlines():
        parts = line.strip().split()
        if len(parts) != 2:
            continue
        try:
            pid = int(parts[0])
            ppid = int(parts[1])
        except ValueError:
            continue
        children.setdefault(ppid, []).append(pid)
    
    order = []
    
    def walk(pid: int) -> None:
        for child in children.get(pid, []):
            walk(child)
            order.append(child)
    
    walk(root)
    order.append(root)
    print(" ".join(str(pid) for pid in order))
    PY
      )"
      [[ -n "$pid_list" ]] || return 1
      local pid
      for pid in $pid_list; do
        kill "$pid" >/dev/null 2>&1 || true
      done
      sleep 0.5
      for pid in $pid_list; do
        kill -0 "$pid" >/dev/null 2>&1 || continue
        kill -9 "$pid" >/dev/null 2>&1 || true
      done
      ! kill -0 "$root_pid" >/dev/null 2>&1
    }
    
    kill_repair_tree_complete() {
      local root_pid="$1"
      local root_pgid="$2"
      local groups group
      local tried=1
      [[ "$root_pid" =~ ^[0-9]+$ ]] || return 1
      [[ "$root_pgid" =~ ^[0-9]+$ ]] || return 1
      groups="$(repair_tree_pgids "$root_pid" "$root_pgid" 2>/dev/null || true)"
      if [[ -z "$groups" ]]; then
        groups="$root_pgid"
      fi
      for group in $groups; do
        if kill_process_group "$group"; then
          tried=0
        fi
      done
      if kill_pid_and_descendants "$root_pid"; then
        tried=0
      fi
      for group in $groups; do
        if kill -0 -- "-$group" >/dev/null 2>&1; then
          return 1
        fi
      done
      ! kill -0 "$root_pid" >/dev/null 2>&1 || return 1
      return "$tried"
    }
    
    reap_stale_repairs() {
      local report_items="$1"
      # Step 62: process-reaping family.  Reaping a stale or stalled repair
      # process may NEVER become accepted repair outside canonical simple_fixer
      # delegation; a forbidden authority source fails closed with a typed
      # zero-authority rejection (SC39).  The gate is fail-closed only for
      # forbidden sources; normal reaping proceeds otherwise.
      local _wrs_gate_json _wrs_gate_outcome
      _wrs_gate_json="$(watchdog_repair_state_authority_or_reject live_watchdog arnold-watchdog)" || true
      _wrs_gate_outcome="$(printf '%s' "$_wrs_gate_json" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("outcome",""))' 2>/dev/null || true)"
      if [[ "$_wrs_gate_outcome" == "zero_authority_rejected" ]]; then
        authority_fail_closed "T62-PROCESS-REAP-01"
        return 0
      fi
      local ps_rows candidates marker_path workspace remote_spec
      local pid ppid pgid etimes kind session rule reason operator_dir stall_idle
      local live_pgid session_pgid method message
      declare -A seen_sessions=()
      declare -A seen_pgids=()
      ps_rows="$(mktemp)"
      candidates="$(mktemp)"
      ps -eww -o pid=,ppid=,pgid=,etimes=,args= 2>/dev/null > "$ps_rows"
      reap_stale_repair_candidates < "$ps_rows" \
        | awk -F'\t' 'BEGIN{OFS="\t"} {print $1,$2,$3,$4,$5,$6,$7,$8,"",""}' > "$candidates"
      reap_stalled_repair_candidates < "$ps_rows" >> "$candidates"
      while IFS=$'\t' read -r pid ppid pgid etimes kind session rule reason operator_dir stall_idle; do
        [[ "$pid" =~ ^[0-9]+$ ]] || continue
        if [[ -n "$session" && -n "${seen_sessions[$session]:-}" ]]; then
          continue
        fi
        if [[ -n "${seen_pgids[$pgid]:-}" ]]; then
          continue
        fi
        if ! kill -0 "$pid" >/dev/null 2>&1; then
          continue
        fi
        method=""
        session_pgid=""
        if [[ -n "$session" ]]; then
          marker_path="$(session_marker_path "$session")"
          if [[ -r "$(kimi_pgid_path "$session")" ]]; then
            read -r session_pgid < "$(kimi_pgid_path "$session")" || session_pgid=""
            live_pgid="$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ' || true)"
            if [[ ! "$session_pgid" =~ ^[0-9]+$ || "$session_pgid" != "$live_pgid" ]]; then
              session_pgid=""
            fi
          fi
        else
          marker_path=""
        fi
        if [[ -n "$session_pgid" ]] && kill_repair_tree_complete "$pid" "$session_pgid"; then
          method="session_pgid_complete:$session_pgid"
        elif kill_repair_tree_complete "$pid" "$pgid"; then
          method="pgid_complete:$pgid"
        elif kill_pid_and_descendants "$pid"; then
          method="pid_tree:$pid"
        else
          log "stale repair reap failed pid=$pid kind=$kind session=${session:-unknown} rule=$rule age=${etimes}s"
          continue
        fi
        workspace=""
        remote_spec=""
        if [[ -n "$marker_path" && -f "$marker_path" ]]; then
          workspace="$(json_field "$marker_path" workspace 2>/dev/null || true)"
          remote_spec="$(json_field "$marker_path" remote_spec 2>/dev/null || true)"
        fi
        message="reaped stale repair pid=$pid kind=$kind session=${session:-unknown} rule=$rule reason=$reason age=${etimes}s method=$method"
        if [[ "$rule" == "stalled" ]]; then
          message="$message idle=${stall_idle:-unknown}s"
          if [[ -n "$operator_dir" ]]; then
            message="$message operator_dir=$operator_dir"
          fi
        fi
        log "$message"
        report_item "$report_items" "${session:-}" "reap" "reaped" "$message" "$workspace" "$remote_spec"
        if [[ -n "$session" ]]; then
          kimi_dispatch_marker_clear "$session"
          seen_sessions["$session"]=1
        fi
        seen_pgids["$pgid"]=1
      done < "$candidates"
      rm -f "$ps_rows" "$candidates"
    }
    
    chain_current_pr_merged() {
      # Ground-truth check: is the chain's current-milestone PR merged LIVE (gh)?
      # Returns "merged", "open", or "unknown". Used to verify a stale
      # repair-exhausted marker: if the PR merged after the marker was written, the
      # chain can now reconcile+complete on relaunch, so the marker is stale.
      local workspace="$1" remote_spec="${2:-}"
      python3 - "$workspace" "$remote_spec" <<'PY'
    import json
    import pathlib
    import subprocess
    import sys
    
    workspace = pathlib.Path(sys.argv[1])
    plans_dir = workspace / ".megaplan" / "plans"
    chain_paths = sorted(
        {
            *plans_dir.glob(".chains/*.json"),
            *workspace.glob(".megaplan/initiatives/*/.megaplan/plans/.chains/*.json"),
            *(workspace / ".megaplan").glob("**/chain_state.json"),
        },
        key=lambda path: path.stat().st_mtime,
        reverse=True,
    )
    for path in chain_paths:
        try:
            payload = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            continue
        pr_number = payload.get("pr_number")
        if not pr_number:
            continue
        try:
            proc = subprocess.run(
                ["gh", "pr", "view", str(pr_number), "--json", "state"],
                cwd=workspace,
                check=False,
                capture_output=True,
                text=True,
                timeout=120,
            )
            if proc.returncode != 0:
                continue
            state = json.loads(proc.stdout or "{}").get("state", "")
            state = state.lower() if isinstance(state, str) else ""
            print("merged" if state == "merged" else "open" if state == "open" else "unknown")
            raise SystemExit(0)
        except Exception:
            continue
    print("unknown")
    PY
    }
    
    chain_wait_status() {
      local workspace="$1"
      local remote_spec="${2:-}"
      PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$workspace" "$remote_spec" <<'PY'
    import json
    import os
    import pathlib
    import subprocess
    import sys
    import time
    
    workspace = pathlib.Path(sys.argv[1])
    remote_spec = sys.argv[2]
    plans_dir = workspace / ".megaplan" / "plans"
    chain_paths = sorted(
        {
            *plans_dir.glob(".chains/*.json"),
            *workspace.glob(".megaplan/initiatives/*/.megaplan/plans/.chains/*.json"),
            *(workspace / ".megaplan").glob("**/chain_state.json"),
        },
        key=lambda path: path.stat().st_mtime,
        reverse=True,
    )
    
    
    def _spec_path() -> pathlib.Path | None:
        if not remote_spec:
            return None
        path = pathlib.Path(remote_spec)
        if not path.is_absolute():
            path = workspace / path
        return path
    
    
    def _merge_policy() -> str:
        path = _spec_path()
        if path is None:
            return ""
        try:
            for raw_line in path.read_text(encoding="utf-8").splitlines():
                line = raw_line.split("#", 1)[0].strip()
                if not line.startswith("merge_policy:"):
                    continue
                value = line.split(":", 1)[1].strip().strip("'\"")
                if value == "manual":
                    return "review"
                return value
        except Exception:
            return ""
        return ""
    
    
    def _pr_state(pr_number: int) -> str:
        proc = subprocess.run(
            ["gh", "pr", "view", str(pr_number), "--json", "state"],
            cwd=workspace,
            check=False,
            capture_output=True,
            text=True,
            timeout=120,
        )
        if proc.returncode != 0:
            return ""
        state = json.loads(proc.stdout or "{}").get("state", "")
        return state.lower() if isinstance(state, str) else ""
    
    
    def _run_merge_command(pr_number: int, *flags: str) -> subprocess.CompletedProcess[str]:
        return subprocess.run(
            ["gh", "pr", "merge", str(pr_number), *flags],
            cwd=workspace,
            check=False,
            capture_output=True,
            text=True,
            timeout=120,
        )
    
    
    def _reference_census(root: str) -> tuple[str, list[str]]:
        """Canonical runtime reference census for *root* (T-0027).
    
        Fail-closed gate: ``(CLEAR, [])`` only when every reference store is
        readable and holds no exact reference to *root*; otherwise the verdict
        (``REFERENCED`` / ``DANGLING`` / ``UNKNOWN``) plus the census reasons.
        Callers MUST treat any non-CLEAR verdict as a hard deletion refusal —
        no route may treat ``--force`` / ``--auto`` as evidence of safety.
    
        Store dirs come from the SAME env vars as ``arnold-gc-sweep``
        (``ARNOLD_REFERENCE_CHAIN_STORE``, ``ARNOLD_REFERENCE_MARKER_STORE``,
        ``ARNOLD_REFERENCE_SCHEDULE_STORES``, ``ARNOLD_REFERENCE_REPAIR_QUEUE``,
        ``ARNOLD_REFERENCE_LEASE_STORE``, ``ARNOLD_RUNTIME_MANIFEST_DIR``,
        ``ARNOLD_BASE_DIR``) with the census module defaults as fallback, so
        tests sandbox the stores exactly like the sweep.  A raising or
        unavailable census is ``UNKNOWN`` — delete-on-unknown never happens.
        """
        try:
            from arnold_pipelines.megaplan.cloud.runtime_references import (
                DEFAULT_CHAIN_STORE,
                DEFAULT_LEASE_STORE,
                DEFAULT_MARKER_STORE,
                DEFAULT_REPAIR_QUEUE,
                DEFAULT_SCHEDULE_STORE,
                normalize_root,
                run_census,
            )
        except Exception as exc:  # pragma: no cover - defensive boundary
            return "UNKNOWN", [f"reference census unavailable: {exc}"]
        normalized = normalize_root(str(root))
        if not normalized:
            return "UNKNOWN", [f"root {root!r} is not an absolute runtime root"]
        try:
            return run_census(
                root=normalized,
                workspace=os.environ.get("ARNOLD_BASE_DIR", ""),
                manifest_store=os.environ.get(
                    "ARNOLD_RUNTIME_MANIFEST_DIR", "/workspace/.megaplan"
                ),
                current_manifest="",
                chain_store=os.environ.get(
                    "ARNOLD_REFERENCE_CHAIN_STORE", DEFAULT_CHAIN_STORE
                ),
                marker_store=os.environ.get(
                    "ARNOLD_REFERENCE_MARKER_STORE", DEFAULT_MARKER_STORE
                ),
                schedule_store=os.environ.get(
                    "ARNOLD_REFERENCE_SCHEDULE_STORES", DEFAULT_SCHEDULE_STORE
                ),
                repair_queue=os.environ.get(
                    "ARNOLD_REFERENCE_REPAIR_QUEUE", DEFAULT_REPAIR_QUEUE
                ),
                lease_store=os.environ.get(
                    "ARNOLD_REFERENCE_LEASE_STORE", DEFAULT_LEASE_STORE
                ),
            )
        except Exception as exc:  # pragma: no cover - defensive boundary
            return "UNKNOWN", [f"reference census raised: {exc}"]
    
    
    def _census_note(message: str) -> None:
        # The watchdog's canonical log (LOG in the wrapper) is the durable writer
        # channel for the census refusal; never let a log failure mask the merge.
        log_path = os.environ.get("CLOUD_WATCHDOG_LOG", "/workspace/watchdog.log")
        try:
            with open(log_path, "a", encoding="utf-8") as handle:
                handle.write(f"[watchdog {time.strftime('%Y-%m-%dT%H:%M:%S%z')}] {message}\n")
        except Exception:
            pass
    
    
    def _attempt_auto_merge(pr_number: int) -> None:
        subprocess.run(
            ["gh", "pr", "ready", str(pr_number)],
            cwd=workspace,
            check=False,
            capture_output=True,
            text=True,
            timeout=120,
        )
        # T-0027: the PR head branch must never be deleted while a runtime store
        # still references this checkout root (an open PR / manifest / job
        # reference is load-bearing).  REFERENCED / DANGLING / UNKNOWN all skip
        # the --delete-branch flag — fail-closed, the deletion is refused even
        # though the non-destructive merge itself proceeds.  CLEAR keeps the
        # existing route authority (merge + delete-branch).  The verdict gates
        # BOTH the auto attempt and the immediate-squash fallback below.
        census_verdict, census_reasons = _reference_census(str(workspace))
        delete_branch = census_verdict == "CLEAR"
        if not delete_branch:
            detail = "; ".join(census_reasons) or census_verdict
            _census_note(
                f"reference census {census_verdict}: refusing --delete-branch for "
                f"PR #{pr_number} head branch ({detail})"
            )
        proc = _run_merge_command(
            pr_number, "--auto", "--squash", *(["--delete-branch"] if delete_branch else [])
        )
        combined = f"{proc.stdout or ''} {proc.stderr or ''}"
        if proc.returncode == 0:
            return
        if "already checked out" in combined:
            _run_merge_command(pr_number, "--auto", "--squash")
            return
        if "Auto merge is not allowed" in combined:
            proc = _run_merge_command(
                pr_number, "--squash", *(["--delete-branch"] if delete_branch else [])
            )
            combined = f"{proc.stdout or ''} {proc.stderr or ''}"
            if proc.returncode != 0 and "already checked out" in combined:
                _run_merge_command(pr_number, "--squash")
    
    
    for path in chain_paths:
        try:
            payload = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            continue
        last_state = payload.get("last_state")
        pr_number = payload.get("pr_number")
        merge_policy = _merge_policy()
        finalized_review_wait = False
        if last_state == "awaiting_pr_merge":
            pass
        elif last_state == "finalized" and pr_number and merge_policy == "review":
            try:
                finalized_review_wait = _pr_state(int(pr_number)) == "open"
            except Exception:
                finalized_review_wait = False
            if not finalized_review_wait:
                continue
        else:
            # ``finalized`` is the pre-execute plan state, not completion evidence.
            # External merge authority is available only after the chain driver has
            # durably entered awaiting_pr_merge, except for a review-policy PR whose
            # external OPEN state proves that execution already crossed that
            # boundary. Never infer it from a terminal-looking label alone.
            continue
        if not pr_number:
            print("awaiting_pr_merge")
            raise SystemExit(0)
        try:
            pr_number_int = int(pr_number)
            if _pr_state(pr_number_int) == "merged":
                print("none")
                raise SystemExit(0)
            if merge_policy == "auto":
                _attempt_auto_merge(pr_number_int)
                if _pr_state(pr_number_int) == "merged":
                    print("none")
                    raise SystemExit(0)
        except Exception:
            pass
        print("awaiting_pr_merge")
        raise SystemExit(0)
    
    print("none")
    PY
    }
    
    resolve_existing_remote_spec() {
      local session="$1" workspace="$2" remote_spec="$3" run_kind="${4:-chain}"
      PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$session" "$workspace" "$remote_spec" "$run_kind" "$MARKER_DIR" <<'PY'
    import json
    import pathlib
    import sys
    
    session, workspace_raw, remote_spec_raw, run_kind, marker_dir_raw = sys.argv[1:]
    workspace = pathlib.Path(workspace_raw)
    marker_path = pathlib.Path(marker_dir_raw) / f"{session}.json"
    remote_spec = pathlib.Path(remote_spec_raw) if remote_spec_raw else None
    if remote_spec is not None and not remote_spec.is_absolute():
        remote_spec = workspace / remote_spec
    
    if remote_spec is not None and remote_spec.exists():
        print(str(remote_spec))
        raise SystemExit(0)
    
    patterns = []
    if run_kind == "epic_chain":
        patterns.extend([
            ".megaplan/initiatives/*/assets/epic-chain.yaml",
            ".megaplan/initiatives/*/epic-chain.yaml",
        ])
    patterns.extend([
        ".megaplan/initiatives/*/chain.yaml",
        ".megaplan/briefs/*/chain.yaml",
    ])
    
    candidates: list[pathlib.Path] = []
    for pattern in patterns:
        candidates.extend(path for path in workspace.glob(pattern) if path.is_file())
    
    if not candidates:
        print(str(remote_spec or remote_spec_raw or ""))
        raise SystemExit(0)
    
    selected = sorted(candidates, key=lambda path: path.stat().st_mtime, reverse=True)[0]
    try:
        payload = json.loads(marker_path.read_text(encoding="utf-8"))
        if isinstance(payload, dict):
            payload["remote_spec"] = str(selected)
            marker_path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    except Exception:
        pass
    
    print(str(selected))
    PY
    }
    
    reconcile_awaiting_pr_merge() {
      local session="$1" workspace="$2" remote_spec="${3:-}"
      PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$session" "$workspace" "$remote_spec" "$MARKER_DIR" <<'PY'
    import json
    import pathlib
    import subprocess
    import sys
    import time
    
    session, workspace_raw, remote_spec_raw, marker_dir = sys.argv[1:]
    workspace = pathlib.Path(workspace_raw)
    remote_spec = pathlib.Path(remote_spec_raw) if remote_spec_raw else None
    if remote_spec is not None and not remote_spec.is_absolute():
        remote_spec = workspace / remote_spec
    plans_dir = workspace / ".megaplan" / "plans"
    
    
    def emit(status: str, message: str = "") -> None:
        print(f"{status}\t{message}")
    
    
    def load_json(path: pathlib.Path) -> dict:
        try:
            payload = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            return {}
        return payload if isinstance(payload, dict) else {}
    
    
    def advancement_policy() -> tuple[bool, str]:
        if remote_spec is None:
            return False, "chain spec is missing"
        try:
            from arnold_pipelines.megaplan.chain.advancement import policy_for_spec_path
    
            policy = policy_for_spec_path(remote_spec)
        except Exception as exc:
            return False, f"chain advancement policy unreadable: {exc}"
        return (
            policy.automatic_pr_progression,
            f"merge_policy={policy.merge_policy} "
            f"clean_milestone_pr={policy.clean_milestone_pr} source={policy.source}",
        )
    
    
    def chain_state_paths() -> list[pathlib.Path]:
        paths = {
            *plans_dir.glob(".chains/*.json"),
            *workspace.glob(".megaplan/initiatives/*/.megaplan/plans/.chains/*.json"),
            *(workspace / ".megaplan").glob("**/chain_state.json"),
        }
        if remote_spec is not None:
            sibling = remote_spec.with_name("chain_state.json")
            if sibling.exists():
                paths.add(sibling)
        return sorted(paths, key=lambda path: path.stat().st_mtime, reverse=True)
    
    
    def gh_pr_state(pr_number: int) -> tuple[str, str, str]:
        proc = subprocess.run(
            ["gh", "pr", "view", str(pr_number), "--json", "state,mergeCommit,headRefOid"],
            cwd=workspace,
            check=False,
            capture_output=True,
            text=True,
            timeout=120,
        )
        if proc.returncode != 0:
            return "", "", ""
        try:
            payload = json.loads(proc.stdout or "{}")
        except Exception:
            return "", "", ""
        state = payload.get("state")
        merge_commit = payload.get("mergeCommit")
        oid = ""
        if isinstance(merge_commit, dict):
            raw_oid = merge_commit.get("oid")
            oid = raw_oid if isinstance(raw_oid, str) else ""
        head_oid = ""
        raw_head = payload.get("headRefOid")
        if isinstance(raw_head, str) and raw_head:
            head_oid = raw_head
        return (state.lower() if isinstance(state, str) else "", oid, head_oid)
    
    
    def enqueue_wait_evidence(path: pathlib.Path, pr_number: int, pr_state: str) -> str:
        # Awaiting a PR merge is expected wait state, not a repair occurrence.
        # ``watchdog_pr_merge_reconciliation`` and ``pr_boundary_evidence`` are
        # persisted on the chain state immediately above this call.  Do not mint a
        # repair identity from PR labels or enqueue an unclaimable repair request.
        del path, pr_number, pr_state
        return "read_only"
    
    
    automatic_progression, policy_reason = advancement_policy()
    if not automatic_progression:
        emit("review_policy", policy_reason)
        raise SystemExit(0)
    
    for path in chain_state_paths():
        payload = load_json(path)
        if payload.get("last_state") != "awaiting_pr_merge":
            continue
        pr_number = payload.get("pr_number")
        try:
            pr_number_int = int(pr_number)
        except Exception:
            emit("missing_pr", f"{path} has no PR number")
            raise SystemExit(0)
        pr_state, merge_oid, pr_head_sha = gh_pr_state(pr_number_int)
        payload["pr_state"] = pr_state or payload.get("pr_state")
        payload.setdefault("metadata", {})
        evidence_ts = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        if isinstance(payload["metadata"], dict):
            payload["metadata"]["watchdog_pr_merge_reconciliation"] = {
                "checked_at": evidence_ts,
                "pr_number": pr_number_int,
                "pr_state": pr_state or "unknown",
                "merge_commit": merge_oid,
            }
            # PR boundary-contract conformant evidence — queued/waiting/merged
            # reconciliation conforms to pr_ready / pr_merged boundary contracts
            # (pr.ready.1 / pr.merged.1) while preserving the existing
            # watchdog_pr_merge_reconciliation metadata.
            boundary_contract_id = "pr.merged.1" if pr_state == "merged" else "pr.ready.1"
            boundary_evidence = {
                "contract_id": boundary_contract_id,
                "boundary_id": "pr_merged" if pr_state == "merged" else "pr_ready",
                "workflow_id": "megaplan-review",
                "pr_number": pr_number_int,
                "pr_state": pr_state or "unknown",
                "pr_head_sha": pr_head_sha or None,
                "evidence_timestamp": evidence_ts,
                "expected_state_delta": {
                    "pr_stage": "merged" if pr_state == "merged" else pr_state or "ready",
                },
            }
            if pr_state == "merged":
                boundary_evidence["merge_commit_sha"] = merge_oid or None
            payload["metadata"]["pr_boundary_evidence"] = boundary_evidence
        try:
            path.write_text(json.dumps(payload, sort_keys=True, indent=2) + "\n", encoding="utf-8")
        except Exception:
            pass
        if pr_state == "merged":
            subprocess.run(
                ["git", "fetch", "origin", "--prune"],
                cwd=workspace,
                check=False,
                capture_output=True,
                text=True,
                timeout=180,
            )
            if merge_oid:
                subprocess.run(
                    ["git", "cat-file", "-e", f"{merge_oid}^{{commit}}"],
                    cwd=workspace,
                    check=False,
                    capture_output=True,
                    text=True,
                    timeout=30,
                )
            emit("merged", f"PR #{pr_number_int} merged; fetched origin for chain relaunch")
            raise SystemExit(0)
        evidence_status = enqueue_wait_evidence(path, pr_number_int, pr_state)
        emit("waiting", f"PR #{pr_number_int} state={pr_state or 'unknown'} evidence={evidence_status}")
        raise SystemExit(0)
    
    emit("none", "no awaiting auto-policy PR merge state")
    PY
    }
    
    plan_phase_health_status() {
      local workspace="$1"
      local run_kind="${2:-chain}"
      local plan_name="${3:-}"
      python3 - "$workspace" "$run_kind" "$plan_name" <<'PY'
    import datetime as dt
    import json
    import pathlib
    import sys
    
    workspace = pathlib.Path(sys.argv[1])
    run_kind = sys.argv[2]
    plan_name = sys.argv[3]
    plans_dir = workspace / ".megaplan" / "plans"
    if run_kind == "plan" and plan_name:
        state_files = [plans_dir / plan_name / "state.json"]
    else:
        state_files = sorted(
            plans_dir.glob("*/state.json"),
            key=lambda path: path.stat().st_mtime,
            reverse=True,
        )
    if not state_files:
        print("ok")
        raise SystemExit(0)
    
    state_path = state_files[0]
    if run_kind == "plan" and plan_name and not state_path.exists():
        print(f"plan_state_missing:{plan_name}")
        raise SystemExit(0)
    try:
        state = json.loads(state_path.read_text(encoding="utf-8"))
    except Exception as exc:
        print(f"state_unreadable:{state_path.parent.name}:{exc}")
        raise SystemExit(0)
    
    def _parse_timestamp(value: str) -> dt.datetime | None:
        text = str(value or "").strip()
        if not text:
            return None
        if text.endswith("Z"):
            text = text[:-1] + "+00:00"
        try:
            parsed = dt.datetime.fromisoformat(text)
        except ValueError:
            return None
        if parsed.tzinfo is None:
            parsed = parsed.replace(tzinfo=dt.timezone.utc)
        return parsed.astimezone(dt.timezone.utc)
    
    
    now = dt.datetime.now(dt.timezone.utc)
    active = state.get("active_step") or {}
    active_phase = str(active.get("phase") or "").strip()
    active_last_activity = (
        _parse_timestamp(active.get("last_activity_at"))
        or _parse_timestamp(active.get("started_at"))
    )
    recent_active_state = False
    events_path = state_path.parent / "events.ndjson"
    if active_phase:
        if active_last_activity is not None and (now - active_last_activity) <= dt.timedelta(minutes=5):
            recent_active_state = True
    if not recent_active_state and events_path.exists():
        try:
            events_mtime = dt.datetime.fromtimestamp(events_path.stat().st_mtime, tz=dt.timezone.utc)
        except OSError:
            events_mtime = None
        if events_mtime is not None and (now - events_mtime) <= dt.timedelta(minutes=5):
            recent_active_state = True
    
    log_candidates = []
    for pattern in ("cloud-chain*.log", "cloud-logs/*.log"):
        log_candidates.extend((workspace / ".megaplan").glob(pattern))
    log_candidates = sorted(
        [path for path in log_candidates if path.is_file()],
        key=lambda path: path.stat().st_mtime,
        reverse=True,
    )
    for log_path in log_candidates[:3]:
        try:
            recent = log_path.read_text(encoding="utf-8", errors="replace").splitlines()[-240:]
        except Exception:
            continue
        last_sandbox_refusal = -1
        for idx, line in enumerate(recent):
            if "sandbox refused terminal" not in line:
                continue
            if (
                "outside the sandbox root/project directory" in line
                or "outside the worktree" in line
            ):
                last_sandbox_refusal = idx
        if last_sandbox_refusal >= 0:
            later_progress = any(
                marker in line
                for line in recent[last_sandbox_refusal + 1 :]
                for marker in ("[tool]", "[auto ", "[chain]")
            )
            if later_progress or recent_active_state:
                continue
            print(
                "workspace_drift:"
                f"{state_path.parent.name}:"
                f"log={log_path.name}:"
                "sandbox_refused_outside_project_root"
            )
            raise SystemExit(0)
    
    latest_failure = state.get("latest_failure") or {}
    failure_kind = latest_failure.get("kind")
    if failure_kind in {"execution_blocked", "blocked_recovery_not_resolved"}:
        phase = latest_failure.get("phase") or "execute"
        recorded_at = latest_failure.get("recorded_at") or ""
        active = state.get("active_step") or {}
        active_phase = active.get("phase") or ""
        active_pid = active.get("worker_pid") or ""
        active_started = active.get("started_at") or ""
        current_state = state.get("current_state") or ""
        message = latest_failure.get("message") or ""
        print(
            "phase_failure:"
            f"{state_path.parent.name}:"
            f"{phase}:"
            "consecutive=1:"
            f"recorded={recorded_at or 'unknown'}:"
            f"state={current_state or 'unknown'}:"
            f"active={active_phase or 'none'}:"
            f"started={active_started or 'unknown'}:"
            f"pid={active_pid or 'none'}:"
            f"{failure_kind}:{message[:140]}"
        )
        raise SystemExit(0)
    if failure_kind != "phase_failed":
        print("ok")
        raise SystemExit(0)
    
    phase = latest_failure.get("phase") or "unknown"
    recorded_at = latest_failure.get("recorded_at") or ""
    history = state.get("history") or []
    consecutive = 0
    for item in reversed(history):
        if item.get("step") == phase and item.get("result") == "error":
            consecutive += 1
            continue
        if item.get("step") == phase and item.get("result") == "success":
            break
        if consecutive:
            break
    
    active = state.get("active_step") or {}
    active_phase = active.get("phase") or ""
    active_pid = active.get("worker_pid") or ""
    active_started = active.get("started_at") or ""
    current_state = state.get("current_state") or ""
    message = latest_failure.get("message") or ""
    
    success_after_failure = False
    for item in history:
        if item.get("step") != phase or item.get("result") != "success":
            continue
        timestamp = item.get("timestamp") or item.get("completed_at") or ""
        if recorded_at and timestamp and timestamp > recorded_at:
            success_after_failure = True
            break
    
    if success_after_failure:
        print("ok")
        raise SystemExit(0)
    
    print(
        "phase_failure:"
        f"{state_path.parent.name}:"
        f"{phase}:"
        f"consecutive={consecutive}:"
        f"recorded={recorded_at or 'unknown'}:"
        f"state={current_state or 'unknown'}:"
        f"active={active_phase or 'none'}:"
        f"started={active_started or 'unknown'}:"
        f"pid={active_pid or 'none'}:"
        f"{message[:160]}"
    )
    PY
    }
    
    plan_progress_stall_status() {
      local workspace="$1"
      local run_kind="${2:-chain}"
      local plan_name="${3:-}"
      python3 - "$workspace" "$MARKER_DIR" "$run_kind" "$plan_name" <<'PY'
    import datetime as dt
    import json
    import os
    import pathlib
    import sys
    
    workspace = pathlib.Path(sys.argv[1])
    marker_dir = pathlib.Path(sys.argv[2])
    run_kind = sys.argv[3]
    plan_name_arg = sys.argv[4]
    
    # Env-tunable thresholds (defaults from the cloud-watchdog progress-stall contract).
    ITER_MAX = int(os.environ.get("CLOUD_WATCHDOG_STALL_ITERATIONS", "8"))
    ATTEMPT_MAX = int(os.environ.get("CLOUD_WATCHDOG_STALL_ATTEMPTS", "10"))
    PLAN_GROWTH_MINS = int(os.environ.get("CLOUD_WATCHDOG_STALL_PLANGROWTH_MINS", "15"))
    EVENTS_MINS = int(os.environ.get("CLOUD_WATCHDOG_STALL_EVENTS_MINS", "10"))
    
    plans_dir = workspace / ".megaplan" / "plans"
    if run_kind == "plan" and plan_name_arg:
        state_files = [plans_dir / plan_name_arg / "state.json"]
    else:
        state_files = sorted(
            plans_dir.glob("*/state.json"),
            key=lambda path: path.stat().st_mtime,
            reverse=True,
        )
    if not state_files:
        print("ok")
        raise SystemExit(0)
    
    state_path = state_files[0]
    plan_dir = state_path.parent
    plan_name = plan_dir.name
    if run_kind == "plan" and plan_name_arg and not state_path.exists():
        print(f"plan_state_missing:{plan_name_arg}")
        raise SystemExit(0)
    try:
        state = json.loads(state_path.read_text(encoding="utf-8"))
    except Exception as exc:
        print(f"stall_unreadable:{plan_name}:{exc}")
        raise SystemExit(0)
    
    now = dt.datetime.now(dt.timezone.utc)
    
    def _age_minutes(mtime_ts):
        if not mtime_ts:
            return None
        try:
            when = dt.datetime.fromtimestamp(mtime_ts, tz=dt.timezone.utc)
        except (OSError, ValueError, OverflowError):
            return None
        return max(0, int((now - when).total_seconds() // 60))
    
    iteration = int(state.get("iteration") or 0)
    # Top-level iteration can lag the internal milestone counter; the recovery
    # layer records the live milestone iteration in latest_failure.metadata.iteration.
    latest_failure = state.get("latest_failure") or {}
    failure_meta = latest_failure.get("metadata") or {}
    milestone_iteration = iteration
    meta_iter = failure_meta.get("iteration")
    if isinstance(meta_iter, (int, float)) and meta_iter > milestone_iteration:
        milestone_iteration = int(meta_iter)
    stall_count = int(failure_meta.get("stall_count") or 0)
    
    active_step = state.get("active_step") or {}
    attempt = int(active_step.get("attempt") or 0)
    
    plan_v_files = sorted(plan_dir.glob("plan_v*.md"))
    plan_v_count = len(plan_v_files)
    events_path = plan_dir / "events.ndjson"
    events_mtime = events_path.stat().st_mtime if events_path.exists() else 0
    
    # Tick-over-tick snapshot for "no growth while iteration advances" detection.
    snapshot_dir = marker_dir
    snapshot_dir.mkdir(parents=True, exist_ok=True)
    snapshot_path = snapshot_dir / f"{plan_name}.progress.json"
    prev = {}
    if snapshot_path.exists():
        try:
            prev = json.loads(snapshot_path.read_text(encoding="utf-8"))
        except Exception:
            prev = {}
    
    unchanged_ticks = 0
    prev_iter = int(prev.get("iteration") or -1)
    prev_plan_count = int(prev.get("plan_v_count") or -1)
    if prev:
        if plan_v_count == prev_plan_count and milestone_iteration >= prev_iter:
            unchanged_ticks = int(prev.get("unchanged_ticks") or 0) + 1
        elif plan_v_count != prev_plan_count:
            unchanged_ticks = 0
        else:
            unchanged_ticks = int(prev.get("unchanged_ticks") or 0)
    
    snapshot = {
        "iteration": milestone_iteration,
        "plan_v_count": plan_v_count,
        "events_mtime": events_mtime,
        "unchanged_ticks": unchanged_ticks,
        "ts": now.isoformat(),
    }
    try:
        snapshot_path.write_text(json.dumps(snapshot, sort_keys=True) + "\n", encoding="utf-8")
    except Exception:
        pass
    
    newest_plan_age = None
    if plan_v_files:
        newest_mtime = max(p.stat().st_mtime for p in plan_v_files)
        newest_plan_age = _age_minutes(newest_mtime)
    events_age = _age_minutes(events_mtime)
    
    signals = []
    if milestone_iteration >= ITER_MAX:
        signals.append(f"iteration={milestone_iteration}>={ITER_MAX}")
    if attempt and attempt >= ATTEMPT_MAX:
        signals.append(f"active_step.attempt={attempt}>={ATTEMPT_MAX}")
    if stall_count >= 3:
        signals.append(f"stall_count={stall_count}")
    if (
        unchanged_ticks >= 2
        and milestone_iteration > prev_iter
        and plan_v_count == prev_plan_count
    ):
        signals.append(f"plan_v_count={plan_v_count} unchanged-{unchanged_ticks}-ticks")
    if newest_plan_age is not None and newest_plan_age >= PLAN_GROWTH_MINS and milestone_iteration >= max(2, ITER_MAX - 2):
        signals.append(f"plan_v_unchanged_{newest_plan_age}m")
    if events_age is not None and events_age >= EVENTS_MINS and state.get("current_state") not in {None, "completed", "abandoned", "awaiting_review"}:
        signals.append(f"events_stale={events_age}m")
    
    if not signals:
        print("ok")
        raise SystemExit(0)
    
    detail = " ".join(signals)
    print(
        f"progress_stall:{plan_name}:"
        f"iteration={iteration}:"
        f"attempt={attempt}:"
        f"plan_v_count={plan_v_count}:"
        f"{detail}"
    )
    PY
    }
    
    session_terminal_status() {
      local session="$1"
      local workspace="$2"
      local remote_spec="$3"
      local run_kind="${4:-chain}"
      local current_target_observation="${5:-}"
      local marker_dir="${6:-$MARKER_DIR}"
      [[ "$run_kind" == "chain" || "$run_kind" == "epic_chain" ]] || return 0
      python3 - "$session" "$workspace" "$remote_spec" "${REPAIR_DATA_DIR:-$MARKER_DIR/repair-data}" "$current_target_observation" "$marker_dir" <<'PY'
    import hashlib
    import json
    import pathlib
    import sys
    
    session, workspace_raw, remote_spec_raw, repair_data_raw, current_target_raw, marker_dir_raw = sys.argv[1:]
    workspace = pathlib.Path(workspace_raw)
    remote_spec = pathlib.Path(remote_spec_raw)
    if not remote_spec.is_absolute():
        remote_spec = workspace / remote_spec
    repair_data_dir = pathlib.Path(repair_data_raw)
    marker_dir = pathlib.Path(marker_dir_raw)
    
    
    def spec_milestone_count() -> int | None:
        try:
            raw = remote_spec.read_text(encoding="utf-8")
        except Exception:
            return None
        try:
            import yaml  # type: ignore
    
            data = yaml.safe_load(raw)
            milestones = data.get("milestones") if isinstance(data, dict) else None
            if isinstance(milestones, list):
                return len(milestones)
        except Exception:
            pass
        count = 0
        in_milestones = False
        for line in raw.splitlines():
            if line.startswith("milestones:"):
                in_milestones = True
                continue
            if in_milestones and line and not line.startswith((" ", "-")):
                break
            if in_milestones and line.lstrip().startswith("-"):
                count += 1
        return count if in_milestones else None
    
    
    SPEC_MILESTONE_COUNT = spec_milestone_count()
    
    
    def is_complete_state(payload: object) -> bool:
        if not isinstance(payload, dict):
            return False
        last_state = str(payload.get("last_state") or payload.get("current_state") or "").strip()
        current_plan = str(payload.get("current_plan_name") or "").strip()
        if last_state not in {"done", "complete", "completed"}:
            return False
        milestones = payload.get("milestones")
        completed = payload.get("completed")
        completed_list = completed if isinstance(completed, list) else []
        if isinstance(milestones, list) and milestones:
            if len(completed_list) < len(milestones):
                return False
        elif SPEC_MILESTONE_COUNT is not None and SPEC_MILESTONE_COUNT > 0:
            try:
                current_index = int(payload.get("current_milestone_index") or 0)
            except Exception:
                current_index = 0
            if len(completed_list) < SPEC_MILESTONE_COUNT and current_index < SPEC_MILESTONE_COUNT:
                return False
        if completed_list:
            incomplete = [
                item for item in completed_list
                if isinstance(item, dict) and str(item.get("status") or "").strip() not in {"done", "complete", "completed"}
                and "label" not in item
            ]
            if incomplete:
                return False
        events = payload.get("events")
        event_items = events if isinstance(events, list) else []
        event_text = " ".join(
            str(item.get("msg") or item.get("message") or item)
            for item in event_items
        )
        explicit_chain_complete = payload.get("chain_complete") is True
        explicit_completion_event = "all milestones complete" in event_text.lower()
        if (
            SPEC_MILESTONE_COUNT is None
            and not explicit_chain_complete
            and not explicit_completion_event
        ):
            return False
        if current_plan and not explicit_completion_event:
            return False
        return True
    
    
    def iter_chain_states() -> list[pathlib.Path]:
        paths: list[pathlib.Path] = []
        chain_dirs: list[pathlib.Path] = []
        for base in (workspace, remote_spec.parent):
            chain_dir = base / ".megaplan" / "plans" / ".chains"
            if chain_dir not in chain_dirs:
                chain_dirs.append(chain_dir)
        for chain_dir in chain_dirs:
            if not chain_dir.exists():
                continue
            digest = hashlib.sha1(str(remote_spec.resolve()).encode("utf-8")).hexdigest()[:12]
            expected_paths = [
                chain_dir / f"{remote_spec.stem}-{digest}.json",
                chain_dir / f"chain-{digest}.json",
            ]
            paths.extend(path for path in expected_paths if path.exists())
            if paths:
                return paths
            paths.extend(
                [
                    path
                    for path in expected_paths
                    if path not in paths
                ]
            )
            paths.extend(sorted(chain_dir.glob("*.json")))
        return paths
    
    
    def current_target_marks_terminal_stale_chain() -> bool:
        if not current_target_raw:
            return False
        try:
            payload = json.loads(current_target_raw)
        except Exception:
            return False
        if not isinstance(payload, dict):
            return False
        plan_state = payload.get("plan_state")
        if not isinstance(plan_state, dict):
            return False
        plan_current_state = str(plan_state.get("current_state") or "").strip().lower()
        if plan_current_state not in {"done", "complete", "completed"}:
            return False
        stale_evidence = payload.get("stale_evidence")
        if not isinstance(stale_evidence, list):
            return False
        return any(
            isinstance(item, dict)
            and str(item.get("kind") or "").strip() == "stale_chain_state_after_terminal_plan"
            for item in stale_evidence
        )
    
    def manifest_marks_chain_complete() -> bool:
        manifest_path = remote_spec.parent / "completion-manifest.json"
        try:
            payload = json.loads(manifest_path.read_text(encoding="utf-8"))
        except Exception:
            return False
        if not isinstance(payload, dict):
            return False
        if str(payload.get("schema") or "").strip() != "arnold.megaplan.chain_completion_manifest.v1":
            return False
        milestones = payload.get("milestones")
        if not isinstance(milestones, list) or not milestones:
            return False
        terminal = {"done", "complete", "completed"}
        statuses = [
            str(item.get("status") or "").strip().lower()
            for item in milestones
            if isinstance(item, dict)
        ]
        return len(statuses) == len(milestones) and all(status in terminal for status in statuses)
    
    def chain_health_blocks_terminal_shortcut() -> bool:
        path = marker_dir / f"{session}.chain-health.progress.json"
        try:
            payload = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            return False
        if not isinstance(payload, dict):
            return False
        snapshot = payload.get("snapshot")
        if not isinstance(snapshot, dict):
            snapshot = {}
        chain_complete = payload.get("chain_complete")
        if chain_complete is None:
            chain_complete = snapshot.get("chain_complete")
        if chain_complete is not False:
            return False
        try:
            completed_count = int(payload.get("completed_count") or snapshot.get("completed_count") or 0)
        except Exception:
            completed_count = 0
        try:
            milestone_count = int(payload.get("milestone_count") or snapshot.get("milestone_count") or 0)
        except Exception:
            milestone_count = 0
        pr_state = str(payload.get("pr_state") or snapshot.get("pr_state") or "").strip().lower()
        if milestone_count and completed_count < milestone_count:
            return True
        if pr_state and pr_state not in {"merged", "closed"}:
            return True
        return True
    
    
    def current_chain_state_blocks_terminal_shortcut() -> bool:
        try:
            digest = hashlib.sha1(str(remote_spec.resolve()).encode("utf-8")).hexdigest()[:12]
        except Exception:
            digest = ""
        chain_dirs = [workspace / ".megaplan" / "plans" / ".chains"]
        if remote_spec.parent != workspace:
            chain_dirs.append(remote_spec.parent / ".megaplan" / "plans" / ".chains")
        candidate_names = ["chain.json"]
        if digest:
            candidate_names.extend([f"{remote_spec.stem}-{digest}.json", f"chain-{digest}.json"])
        for chain_dir in chain_dirs:
            for name in candidate_names:
                path = chain_dir / name
                if not path.exists():
                    continue
                try:
                    payload = json.loads(path.read_text(encoding="utf-8"))
                except Exception:
                    continue
                if isinstance(payload, dict) and not is_complete_state(payload):
                    return True
        return False
    
    
    if (
        current_target_marks_terminal_stale_chain()
        and not chain_health_blocks_terminal_shortcut()
        and not current_chain_state_blocks_terminal_shortcut()
    ):
        print("complete\tterminal plan state supersedes stale chain state")
        raise SystemExit(0)
    
    if manifest_marks_chain_complete():
        print("complete\tcompletion manifest marks chain complete")
        raise SystemExit(0)
    
    
    for path in iter_chain_states():
        if not path.exists():
            continue
        try:
            payload = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            continue
        if is_complete_state(payload):
            print("complete\tchain complete")
            raise SystemExit(0)
    
    data_path = repair_data_dir / f"{session}.repair-data.json"
    if data_path.exists():
        try:
            payload = json.loads(data_path.read_text(encoding="utf-8"))
        except Exception:
            payload = {}
        attempts = payload.get("attempts") if isinstance(payload, dict) else []
        if isinstance(attempts, list):
            for attempt in reversed(attempts):
                if not isinstance(attempt, dict):
                    continue
                if str(attempt.get("failure_classification") or "") != "chain_completed":
                    continue
                summary = attempt.get("chain_state_summary")
                if is_complete_state(summary):
                    print("complete\tchain complete")
                    raise SystemExit(0)
                context = attempt.get("failure_context")
                if isinstance(context, dict) and is_complete_state(context.get("chain_state_summary")):
                    print("complete\tchain complete")
                    raise SystemExit(0)
    PY
    }
    
    repair_goal_watchdog_status() {
      local session="$1"
      PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" "$MEGAPLAN_SUPERVISOR_PYTHON" -P - "$MARKER_DIR" "$session" <<'PY' 2>>"${LOG:-/dev/null}"
    import json
    import os
    import pathlib
    import sys
    
    from arnold_pipelines.megaplan.cloud.repair_goal import evaluate_repair_goal
    
    marker_dir = pathlib.Path(sys.argv[1])
    session = "".join(ch if ch.isalnum() or ch in "._-" else "_" for ch in sys.argv[2]) or "unknown"
    goal_dir = marker_dir / "repair-goals" / session
    goals = sorted(goal_dir.glob("goal-*.json"), key=lambda path: path.stat().st_mtime, reverse=True)
    for path in goals:
        try:
            payload = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            continue
        if payload.get("status") != "active":
            continue
        result = evaluate_repair_goal(path, action="watchdog_authority_check")
        status = str(result.get("status") or "active")
        evaluation = result.get("evaluation") or {}
        reason = str(evaluation.get("reason") or "")
        control_action = str(evaluation.get("control_action") or "")
        observation = result.get("observation") or {}
        from arnold_pipelines.megaplan.cloud.current_target_liveness import (
            control_liveness_from_current_target,
        )
        target_liveness = control_liveness_from_current_target(
            {"current_target_liveness": observation.get("current_target_liveness")}
            if isinstance(observation, dict)
            else None,
            action="control",
        )
        target_worker_live = bool(
            target_liveness.get("state") == "live"
            and target_liveness.get("known") is True
        )
        if status != "active":
            print(
                f"{status}\t{result.get('goal_id') or ''}\t{reason}\t{control_action}\t"
                f"{'true' if target_worker_live else 'false'}"
            )
            raise SystemExit(0)
        refreshed = json.loads(path.read_text(encoding="utf-8"))
        owner_live = False
        for owner in reversed(refreshed.get("owners") or []):
            if not isinstance(owner, dict) or not owner.get("manifest_path"):
                continue
            try:
                manifest = json.loads(pathlib.Path(owner["manifest_path"]).read_text(encoding="utf-8"))
                pid = int(manifest.get("pid") or 0)
                if manifest.get("status") in {"reserved", "launching", "running", "adopting"} and pid > 0:
                    os.kill(pid, 0)
                    owner_live = True
                    break
            except Exception:
                continue
        print(
            f"{'active_owner' if owner_live else 'active_unowned'}\t"
            f"{result.get('goal_id') or ''}\t{reason}\t{control_action}\t"
            f"{'true' if target_worker_live else 'false'}"
        )
        raise SystemExit(0)
    print("none\t\t\t\tfalse")
    PY
    }
    
    current_target_has_live_worker() {
      local observation="${1:-}"
      [[ -n "$observation" ]] || return 1
      PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$observation" <<'PY'
    import json
    import sys
    
    from arnold_pipelines.megaplan.cloud.current_target_liveness import (
        control_liveness_from_current_target,
    )
    
    try:
        record = json.loads(sys.argv[1])
    except (IndexError, json.JSONDecodeError, TypeError):
        raise SystemExit(1)
    liveness = control_liveness_from_current_target(record, action="control")
    raise SystemExit(0 if liveness.get("state") == "live" and liveness.get("known") is True else 1)
    PY
    }
    
    launch_chain_tick() {
      local session="$1"
      local workspace="$2"
      local remote_spec="$3"
      local report_items="$4"
      local run_kind="${5:-chain}"
      local plan_name="${6:-}"
      local relaunch_command="${7:-}"
      local remote_spec_path="$remote_spec"
      local current_target_observation=""
    
      if [[ -n "$plan_name" ]]; then
        run_kind="plan"
      fi
    
      # G5 (T-0021/T-0022, round-6 finding 1b): the engine-root preflight is the
      # FIRST mutation-gating step in the tick — it runs BEFORE the current-target
      # subprocesses, before any marker/publication/repair side effect.  A missing
      # manifest pin or recorded engine-root drift fails closed (typed drift, exit
      # 24) with ZERO side effects.
      if [[ "$run_kind" == "plan" ]]; then
        chain_engine_root_preflight "$workspace" "" "$session" "$plan_name" >/dev/null || return $?
      else
        chain_engine_root_preflight "$workspace" "$remote_spec" "$session" >/dev/null || return $?
      fi
    
      # Resolve the one namespace-bound liveness record before any repair,
      # retrigger, retirement, or relaunch path.  An unreadable/missing/corrupt
      # record is UNKNOWN and fails closed; raw PID, runner-transition, heartbeat,

E             local session="$2"
E             local workspace="$3"
E             local remote_spec="$4"
E             local current_plan="$5"
E             local current_target_observation="${6:-}"
E             local health="${7:-}"
E             local marker_path stale_marker_plans repair_summary
E           
E             marker_path="$(repair_needs_human_path "$session")"
E             [[ -f "$marker_path" ]] || return 1
E           
E             stale_marker_plans="$(repair_needs_human_matches_current_plan "$session" "$current_plan" 2>/dev/null)" || {
E               local stale_clear_verdict stale_clear_state
E               stale_clear_verdict="$(resolver_stale_needs_human_clear_verdict "$current_target_observation")"
E               stale_clear_state="${stale_clear_verdict#*:}"
E               if [[ "$stale_clear_state" == "$stale_clear_verdict" || -z "$stale_clear_state" ]]; then
E                 stale_clear_state="UNKNOWN"
E               fi
E               compare_needs_human_to_resolver "$session" "$current_plan" "true" "${stale_marker_plans:-}"
E               if [[ "$stale_clear_verdict" == clear:* ]]; then
E                 if [[ "${MUTATION_CAPABILITY_PRESENT:-0}" != "1" ]]; then
E                   log "stale repair needs-human marker preserved; observe-only without minted MutationCapability session=$session canonical_state=$stale_clear_state live_plan=${current_plan:-unknown} marker_plans=${stale_marker_plans:-unknown}"
E                   return 0
E                 fi
E                 rm -f "$marker_path" 2>/dev/null || authority_gap_continue "T29-BYPASS-126" "authority-risk bypass converted to typed evidence gap"
E                 log "stale repair needs-human marker cleared; canonical resolver permits stale clear session=$session canonical_state=$stale_clear_state live_plan=${current_plan:-unknown} marker_plans=${stale_marker_plans:-unknown}"
E                 return 1
E               fi
E               log "stale repair needs-human marker preserved; canonical resolver blocks stale clear session=$session canonical_state=$stale_clear_state live_plan=${current_plan:-unknown} marker_plans=${stale_marker_plans:-unknown}"
E             }
E             if [[ -n "${stale_marker_plans:-}" ]]; then
E               compare_needs_human_to_resolver "$session" "$current_plan" "true" "$stale_marker_plans"
E             else
E               compare_needs_human_to_resolver "$session" "$current_plan" "false" ""
E             fi
E           
E             # The needs-human marker path is observe-only: the L2 meta-repair trigger
E             # that used to dispatch from here was removed with the layered stack. The
E             # single-flash babysitter dispatches from launch_chain_tick, not here.
E             if command -v repair_needs_human_should_remain_human >/dev/null 2>&1 && ! repair_needs_human_should_remain_human "$session" "$current_plan"; then
E               if [[ "${MUTATION_CAPABILITY_PRESENT:-0}" != "1" ]]; then
E                 log "stale repair needs-human marker preserved; observe-only without minted MutationCapability session=$session live_plan=${current_plan:-unknown}"
E                 repair_summary="$(repair_needs_human_summary "$session")"
E                 report_item "$report_items" "$session" "observe" "needs_human" "$repair_summary" "$workspace" "$remote_spec"
E                 return 0
E               fi
E               rm -f "$marker_path" 2>/dev/null || authority_gap_continue "T29-BYPASS-127" "authority-risk bypass converted to typed evidence gap"
E               log "stale repair needs-human marker cleared; fresh classifier no longer requires human session=$session live_plan=${current_plan:-unknown}"
E               return 1
E             fi
E           
E             repair_summary="$(repair_needs_human_summary "$session")"
E             log "session has current needs-human marker; reporting without re-notifying session=$session summary=$repair_summary"
E             report_item "$report_items" "$session" "observe" "needs_human" "$repair_summary" "$workspace" "$remote_spec"
E             return 0
E           }
E           
E           
E           current_target_plan_name_from_observation() {
E             local observation="$1"
E             python3 - "$observation" <<'PY'
E           import json
E           import sys
E           
E           try:
E               payload = json.loads(sys.argv[1] or "{}")
E           except Exception:
E               payload = {}
E           refs = payload.get("current_refs") if isinstance(payload.get("current_refs"), dict) else {}
E           for key in ("current_plan_name", "chain_current_plan_name", "marker_plan_name"):
E               value = refs.get(key)
E               if isinstance(value, str) and value.strip():
E                   print(value.strip())
E                   break
E           PY
E           }
E           
E           # ─────────────────────────────────────────────────────────────────────────────
E           # Single-flash babysitter launch machinery (Q1/Q2). The watchdog's ONLY repair
E           # dispatch is the status-trigger babysitter: one managed
E           # hermes:deepseek:deepseek-v4-flash agent whose goal prompt does
E           # swarm -> Codex -> implement -> relaunch -> prove. Everything else in the
E           # repair-dispatch stack (L1 repair-loop, L2 meta-repair, repair-trigger) has
E           # been removed; there is deliberately NO fallthrough.
E           # ─────────────────────────────────────────────────────────────────────────────
E           
E           # Occurrence fingerprint shared by the dedup gate and the launch: sha256 of
E           # kind/phase/message/phase_or_step/blocked_task_id from the durable plan
E           # failure state, first 12 hex chars. An empty failure record still produces a
E           # deterministic digest (all-empty fields) so same-session ticks dedup.
E           babysitter_occurrence_digest() {
E             local session="$1"
E             local workspace="$2"
E             local remote_spec="$3"
E             local run_kind="${4:-chain}"
E             local plan_name="${5:-}"
E             PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - \
E               "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" <<'PY'
E           import hashlib
E           import json
E           import pathlib
E           import sys
E           
E           session, workspace_raw, remote_spec_raw, run_kind, plan_name = sys.argv[1:]
E           workspace = pathlib.Path(workspace_raw)
E           plan_name = str(plan_name or "").strip()
E           state_path = None
E           if plan_name:
E               candidate = workspace / ".megaplan" / "plans" / plan_name / "state.json"
E               if candidate.is_file():
E                   state_path = candidate
E           elif run_kind == "plan":
E               plans_root = workspace / ".megaplan" / "plans"
E               candidates = sorted(
E                   plans_root.glob("*/state.json"),
E                   key=lambda path: path.stat().st_mtime,
E                   reverse=True,
E               )
E               if candidates:
E                   state_path = candidates[0]
E           else:
E               # chain / epic_chain: read the chain state's current plan if resolvable,
E               # else fall back to the newest plan state in the workspace.
E               chain_path = None
E               if remote_spec_raw:
E                   spec_path = pathlib.Path(remote_spec_raw)
E                   if not spec_path.is_absolute():
E                       spec_path = workspace / spec_path
E                   try:
E                       spec_resolved = spec_path.resolve()
E                   except Exception:
E                       spec_resolved = spec_path
E                   chain_digest = hashlib.sha1(str(spec_resolved).encode("utf-8")).hexdigest()[:12]
E                   for candidate in (
E                       workspace / ".megaplan" / "plans" / ".chains" / f"chain-{chain_digest}.json",
E                       workspace / ".megaplan" / "plans" / ".chains" / f"{spec_resolved.stem}-{chain_digest}.json",
E                       spec_resolved.parent / ".megaplan" / "plans" / ".chains" / f"chain-{chain_digest}.json",
E                   ):
E                       if candidate.is_file():
E                           chain_path = candidate
E                           break
E               if chain_path is not None:
E                   try:
E                       chain_state = json.loads(chain_path.read_text(encoding="utf-8"))
E                       chain_plan = str(chain_state.get("current_plan_name") or "").strip()
E                   except Exception:
E                       chain_plan = ""
E                   if chain_plan:
E                       candidate = workspace / ".megaplan" / "plans" / chain_plan / "state.json"
E                       if candidate.is_file():
E                           state_path = candidate
E               if state_path is None:
E                   plans_root = workspace / ".megaplan" / "plans"
E                   candidates = sorted(
E                       plans_root.glob("*/state.json"),
E                       key=lambda path: path.stat().st_mtime,
E                       reverse=True,
E                   )
E                   if candidates:
E                       state_path = candidates[0]
E           
E           
E           def _load_json(path):
E               if path is None:
E                   return {}
E               try:
E                   payload = json.loads(path.read_text(encoding="utf-8"))
E               except Exception:
E                   return {}
E               return payload if isinstance(payload, dict) else {}
E           
E           
E           latest_failure = _load_json(state_path).get("latest_failure")
E           latest_failure = latest_failure if isinstance(latest_failure, dict) else {}
E           metadata = latest_failure.get("metadata")
E           metadata = metadata if isinstance(metadata, dict) else {}
E           digest_src = dict(
E               kind=str(latest_failure.get("kind") or ""),
E               phase=str(latest_failure.get("phase") or ""),
E               message=str(latest_failure.get("message") or ""),
E               phase_or_step=str(metadata.get("phase_or_step") or ""),
E               blocked_task_id=str(metadata.get("blocked_task_id") or ""),
E           )
E           if not any(digest_src.values()):
E               # The auto-driver clears state.latest_failure when a stall is recorded,
E               # so the fields above degenerate to ALL-EMPTY for every stalled chain and
E               # the digest collapses to one fixed value (which collided with d587's real
E               # digest). Recover durable identity from artifacts the driver does NOT
E               # clear: the plan's phase_result (exit kind + phase) plus iteration and
E               # current state. Same stall -> same digest; different stall -> different.
E               if state_path is not None and state_path.is_file():
E                   plan_dir = state_path.parent
E                   phase_result = _load_json(plan_dir / "phase_result.json")
E                   digest_src["phase_result_phase"] = str(
E                       phase_result.get("phase") if isinstance(phase_result, dict) else ""
E                   )
E                   digest_src["phase_result_exit"] = str(
E                       phase_result.get("exit_kind") if isinstance(phase_result, dict) else ""
E                   )
E                   state_payload = _load_json(state_path)
E                   digest_src["state"] = str(state_payload.get("current_state") or "")
E                   digest_src["iteration"] = str(state_payload.get("iteration") or "")
E           print(hashlib.sha256(json.dumps(digest_src, sort_keys=True).encode("utf-8")).hexdigest()[:12])
E           PY
E           }
E           
E           # driver.babysitter gate: prints "mode\tafter" where mode is superfixer|off and
E           # after is the ISO-8601 duration ("" when unset). Missing/unparseable spec
E           # defaults to superfixer with no delay (default ON).
E           #
E           # The remote_spec the watchdog carries is the CHAIN spec (chain.yaml). The
E           # driver.babysitter policy lives on the DEPLOY spec (cloud.yaml) that load_spec
E           # parses: resolve remote_spec itself first (a deploy spec may be passed
E           # directly), then the sibling ``cloud.yaml`` / ``<stem>.cloud.yaml`` in the
E           # same initiative directory (the standard layout).
E           
E           # babysitter_parked_chain_stall: True when the session's chain is STOPPED in a
E           # state with NO active step and NO live driver — a milestone plan that was
E           # born but never driven (initialized / planned / finalized / critiqued /
E           # gated), OR a plan that STOPPED in a failure state (blocked / failed) with
E           # no worker live on it. Such a chain is a genuine stoppage the fixer must
E           # pick up: pre-execute it is a DRIVE, failed it is a REPAIR (the fixer's job
E           # is to diagnose, fix, ship, rebind, resume). A plan with a live active-step
E           # worker is NOT parked. mode=off disables REPAIR dispatch, but a parked stall
E           # is a drive the fixer must still pick up.
E           #
E           # Why failed/blocked are included (grok strategy consult 2026-08-16): a
E           # blocked/failed plan with no live driver and no lease sits behind the
E           # liveness fence (PID/lease-based, not marker-SHA-based) -> watchdog reports
E           # 'liveness unavailable; fenced' -> NO babysitter dispatches -> the fixer
E           # that would rebind the stale marker (consumer lag) never runs -> catch-22,
E           # chain strands forever. Extending the pre-fence dispatch exception (which
E           # already exists for parked pre-execute stalls because a parked chain has no
E           # live driver by definition) to stopped failed plans gives the fixer the
E           # occurrence. The dispatch is still the single-flash babysitter; mechanical
E           # relaunch remains fenced; the drive/repair is never --fresh and never wipes.
E           babysitter_parked_chain_stall() {
E             local session="$1"
E             local workspace="$2"
E             local remote_spec="$3"
E             local run_kind="${4:-chain}"
E             local plan_name="${5:-}"
E             PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$session" "$workspace" "$remote_spec" "$plan_name" <<'PY'
E           import json
E           import sys
E           from pathlib import Path
E           
E           session, workspace_raw, remote_spec_raw, plan_name = sys.argv[1:]
E           workspace = Path(workspace_raw)
E           
E           def _find_plan_dir() -> Path | None:
E               plans_root = workspace / ".megaplan" / "plans"
E               if not plans_root.is_dir():
E                   return None
E               if plan_name:
E                   candidate = plans_root / plan_name
E                   if (candidate / "state.json").is_file():
E                       return candidate
E               dirs = sorted(plans_root.iterdir(), key=lambda p: p.stat().st_mtime, reverse=True)
E               for d in dirs:
E                   if (d / "state.json").is_file():
E                       return d
E               return None
E           
E           plan_dir = _find_plan_dir()
E           if plan_dir is None:
E               # No plan at all yet: a chain that has never born a plan for its first
E               # milestone is parked (needs a DRIVE) unless the chain is fully
E               # terminal. Fall through to the chain-record check below.
E               plan_dir = None
E           state: dict = {}
E           if plan_dir is not None:
E               try:
E                   state = json.loads((plan_dir / "state.json").read_text(encoding="utf-8"))
E               except (OSError, ValueError):
E                   state = {}
E           current = state.get("current_state")
E           if current not in {
E               "initialized", "planned", "finalized", "critiqued", "gated",
E               "blocked", "failed",
E           }:
E               # The newest plan is terminal (done/executed/reviewed) or absent. A chain
E               # that still has PENDING milestones (current_milestone_index < the total
E               # milestone sequence) is parked BETWEEN milestones - the next plan is
E               # unborn and nothing will drive it unless the fixer picks it up. Read the
E               # chain record from the remote spec's .chains dir; if the chain has
E               # pending milestones and no current plan, treat it as parked (a DRIVE).
E               chain_pending = False
E               if remote_spec_raw:
E                   spec_path = Path(remote_spec_raw)
E                   if not spec_path.is_absolute():
E                       spec_path = workspace / spec_path
E                   chain_dir = workspace / ".megaplan" / "plans" / ".chains"
E                   import hashlib
E                   chain_digest = hashlib.sha1(str(spec_path.resolve()).encode("utf-8")).hexdigest()[:12]
E                   for candidate in (
E                       chain_dir / f"chain-{chain_digest}.json",
E                       chain_dir / f"{spec_path.stem}-{chain_digest}.json",
E                   ):
E                       if not candidate.is_file():
E                           continue
E                       try:
E                           chain = json.loads(candidate.read_text(encoding="utf-8"))
E                       except (OSError, ValueError):
E                           continue
E                       idx = chain.get("current_milestone_index")
E                       completed = chain.get("completed") or []
E                       last_state = str(chain.get("last_state") or "")
E                       # A chain parked at a HUMAN GATE (awaiting_human_verify /
E                       # awaiting_human) must NOT be driven - the fixer would re-run the
E                       # same milestone, re-emit the same product-safety user_actions,
E                       # and park again (grok consult 2026-08-17: the between-milestones
E                       # drive in a85e968a88 was the mechanical generator of the mega m3
E                       # U1/U2 loop). Human gates are resolved by a human, not a drive.
E                       if last_state in {"awaiting_human", "awaiting_human_verify"}:
E                           chain_pending = False
E                       else:
E                           total = 0
E                           try:
E                               spec_text = spec_path.read_text(encoding="utf-8")
E                               # chain.yaml is YAML: count top-level "- label:" milestone entries.
E                               total = sum(1 for line in spec_text.splitlines() if line.startswith("- label:"))
E                           except Exception:
E                               total = 0
E                           if isinstance(idx, int) and idx >= 0 and (total == 0 or idx < total):
E                               chain_pending = True
E                           elif completed and (total == 0 or len(completed) < total):
E                               chain_pending = True
E                       break
E               if not chain_pending:
E                   sys.exit(1)
E           active = state.get("active_step")
E           if active and isinstance(active, dict) and active.get("phase"):
E               sys.exit(1)  # a worker is live; not parked
E           # No active step in a stoppage state (or between milestones with no plan):
E           # parked unless a driver is live.
E           sys.exit(0)
E           PY
E           }
E           
E           babysitter_effective_mode() {
E             local remote_spec="$1"
E             local workspace="$2"
E             PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$remote_spec" "$workspace" <<'PY'
E           import pathlib
E           import sys
E           
E           remote_spec_raw, workspace_raw = sys.argv[1:]
E           mode = "superfixer"
E           after = ""
E           candidates: list[pathlib.Path | None] = []
E           if remote_spec_raw:
E               spec_path = pathlib.Path(remote_spec_raw)
E               if not spec_path.is_absolute():
E                   spec_path = pathlib.Path(workspace_raw) / spec_path
E               candidates.append(spec_path)
E               candidates.append(spec_path.with_name("cloud.yaml"))
E               candidates.append(spec_path.with_name(spec_path.stem + ".cloud.yaml"))
E           for candidate in candidates:
E               if candidate is None or not candidate.is_file():
E                   continue
E               try:
E                   from arnold_pipelines.megaplan.cloud.spec import (
E                       babysitter_effective_mode,
E                       load_spec,
E                   )
E           
E                   spec = load_spec(candidate)
E                   mode = babysitter_effective_mode(spec.driver)
E                   driver = spec.driver
E                   if driver is not None and driver.babysitter is not None:
E                       after = driver.babysitter.after or ""
E                   break
E               except Exception:
E                   continue
E           print(f"{mode}\t{after}")
E           PY
E           }
E           
E           # 0 when the after-duration (ISO-8601, e.g. PT1H) has elapsed since the
E           # unhealthy state began (latest_failure.recorded_at), or when no reference
E           # timestamp exists (fail-safe: fire). 1 when the chain must keep waiting.
E           babysitter_after_elapsed() {
E             local after="$1"
E             local session="$2"
E             local workspace="$3"
E             local remote_spec="$4"
E             local run_kind="${5:-chain}"
E             local plan_name="${6:-}"
E             PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - \
E               "$after" "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" <<'PY'
E           import datetime as dt
E           import json
E           import pathlib
E           import sys
E           
E           from arnold_pipelines.megaplan.resident.schedules import parse_duration
E           
E           after, session, workspace_raw, remote_spec_raw, run_kind, plan_name = sys.argv[1:]
E           workspace = pathlib.Path(workspace_raw)
E           plan_name = str(plan_name or "").strip()
E           state_path = None
E           if plan_name:
E               candidate = workspace / ".megaplan" / "plans" / plan_name / "state.json"
E               if candidate.is_file():
E                   state_path = candidate
E           else:
E               plans_root = workspace / ".megaplan" / "plans"
E               candidates = sorted(
E                   plans_root.glob("*/state.json"),
E                   key=lambda path: path.stat().st_mtime,
E                   reverse=True,
E               )
E               if candidates:
E                   state_path = candidates[0]
E           
E           
E           def iso_to_dt(value):
E               if not value:
E                   return None
E               try:
E                   parsed = dt.datetime.fromisoformat(str(value).replace("Z", "+00:00"))
E               except ValueError:
E                   return None
E               if parsed.tzinfo is None:
E                   parsed = parsed.replace(tzinfo=dt.timezone.utc)
E               return parsed
E           
E           
E           recorded_at = None
E           if state_path is not None:
E               try:
E                   payload = json.loads(state_path.read_text(encoding="utf-8"))
E               except Exception:
E                   payload = {}
E               failure = payload.get("latest_failure")
E               failure = failure if isinstance(failure, dict) else {}
E               recorded_at = iso_to_dt(failure.get("recorded_at"))
E           try:
E               duration = parse_duration(after)
E           except (ValueError, TypeError):
E               raise SystemExit(1)
E           if recorded_at is None:
E               # No durable reference timestamp: fail-safe and fire.
E               raise SystemExit(0)
E           elapsed = dt.datetime.now(dt.timezone.utc) - recorded_at
E           if elapsed >= duration:
E               raise SystemExit(0)
E           raise SystemExit(1)
E           PY
E           }
E           
E           # 0 when a babysitter is already live for the same occurrence digest, 1
E           # otherwise. Checks the launch receipt (supervisor pid) and the watchdog
E           # dispatch receipt (babysitter pid). A pid is live iff kill(pid, 0) succeeds.
E           babysitter_running_for_occurrence() {
E             local session="$1"
E             local digest="$2"
E             PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - \
E               "$session" "$digest" "${REPAIR_DATA_DIR:-$MARKER_DIR/repair-data}" <<'PY'
E           import json
E           import os
E           import pathlib
E           import sys
E           from datetime import datetime, timedelta, timezone
E           
E           session, digest, repair_data_raw = sys.argv[1:]
E           repair_data = pathlib.Path(repair_data_raw)
E           
E           
E           def pid_live(pid):
E               if not isinstance(pid, int) or pid <= 0:
E                   return False
E               try:
E                   os.kill(pid, 0)
E               except ProcessLookupError:
E                   return False
E               except PermissionError:
E                   return True
E               return True
E           
E           
E           def _proc_root():
E               return pathlib.Path(os.environ.get("CLOUD_WATCHDOG_BABYSITTER_PROC_ROOT", "/proc"))
E           
E           
E           def _progress_logs(payload, run_root):
E               """Files that actually move while a babysitter is working.
E           
E               ``run.log`` is the managed-agent capture. It is silent during a model
E               call: the hermes spinner is non-TTY (PIPE), so it writes ``[tool]`` at
E               tool start and ``[done]`` at tool end, and nothing while the LLM thinks.
E               ``babysitter.stdout.log`` is a tee of that same stream (managed_agent
E               tee_output=True); ``babysitter.stderr.log`` is the supervisor. Watching
E               only ``run.log`` is what produced the I51 18-minute false-positive reap.
E               """
E               seen = []
E               seen_ids = set()
E           
E               def _add(path):
E                   try:
E                       resolved = path.resolve()
E                   except OSError:
E                       return
E                   marker = str(resolved)
E                   if marker in seen_ids or not resolved.is_file():
E                       return
E                   seen_ids.add(marker)
E                   seen.append(resolved)
E           
E               if run_root and run_root.is_dir():
E                   _add(run_root / "babysitter.stdout.log")
E                   _add(run_root / "babysitter.stderr.log")
E                   for path in run_root.rglob("run.log"):
E                       _add(path)
E               for key in ("stdout_log", "stderr_log"):
E                   raw = payload.get(key)
E                   if isinstance(raw, str) and raw:
E                       _add(pathlib.Path(raw))
E               return seen
E           
E           
E           def _socket_inodes(pid, proc):
E               fd_dir = proc / str(pid) / "fd"
E               inodes = set()
E               try:
E                   for entry in fd_dir.iterdir():
E                       try:
E                           target = os.readlink(entry)
E                       except OSError:
E                           continue
E                       if target.startswith("socket:[") and target.endswith("]"):
E                           inodes.add(target[8:-1])
E               except OSError:
E                   return inodes
E               return inodes
E           
E           
E           def _pid_has_established_tcp(pid, proc):
E               inodes = _socket_inodes(pid, proc)
E               if not inodes:
E                   return False
E               tables = [
E                   proc / str(pid) / "net" / "tcp",
E                   proc / str(pid) / "net" / "tcp6",
E                   proc / "net" / "tcp",
E                   proc / "net" / "tcp6",
E               ]
E               seen = set()
E               for table in tables:
E                   marker = str(table)
E                   if marker in seen or not table.is_file():
E                       continue
E                   seen.add(marker)
E                   try:
E                       lines = table.read_text(encoding="utf-8", errors="replace").splitlines()[1:]
E                   except OSError:
E                       continue
E                   for line in lines:
E                       parts = line.split()
E                       # st == 01 is ESTABLISHED; field 9 is inode.
E                       if len(parts) >= 10 and parts[3] == "01" and parts[9] in inodes:
E                           return True
E               return False
E           
E           
E           def _pid_runnable(pid, proc):
E               try:
E                   stat = (proc / str(pid) / "stat").read_text(encoding="utf-8")
E                   state = stat.rsplit(") ", 1)[1].split()[0]
E               except (OSError, IndexError):
E                   return False
E               return state in {"R", "D"}
E           
E           
E           def _descendant_pids(root_pids, proc):
E               children = {}
E               try:
E                   for entry in proc.iterdir():
E                       if not entry.name.isdigit():
E                           continue
E                       try:
E                           stat = (entry / "stat").read_text(encoding="utf-8")
E                           ppid = int(stat.rsplit(") ", 1)[1].split()[1])
E                       except (OSError, IndexError, ValueError):
E                           continue
E                       children.setdefault(ppid, []).append(int(entry.name))
E               except OSError:
E                   return []
E               out = []
E               stack = []
E               for root in root_pids:
E                   stack.extend(children.get(int(root), []))
E               seen = set()
E               while stack:
E                   pid = stack.pop()
E                   if pid in seen:
E                       continue
E                   seen.add(pid)
E                   out.append(pid)
E                   stack.extend(children.get(pid, []))
E               return out
E           
E           
E           def _tree_has_live_work(root_pids):
E               """True if the babysitter tree is mid-call; None if /proc is unreadable.
E           
E               A legitimate Flash babysitter spends most of its life in one of two
E               silent-log states: (1) blocked on an LLM SSE socket, (2) waiting on a
E               child (fan.py / pytest / grep) that is itself running or on a socket.
E               ``run.log`` growth cannot see either. I18/I32/I34 hangs are the inverse:
E               live pid, 0% CPU, 0 sockets, no children working.
E               """
E               proc = _proc_root()
E               if not proc.is_dir():
E                   return None
E               pids = []
E               for raw in root_pids:
E                   if isinstance(raw, int) and raw > 0:
E                       pids.append(raw)
E               if not pids:
E                   return False
E               for pid in (*pids, *_descendant_pids(pids, proc)):
E                   if _pid_runnable(pid, proc) or _pid_has_established_tcp(pid, proc):
E                       return True
E               return False
E           
E           
E           def _pid_comm(pid, proc):
E               try:
E                   return (proc / str(pid) / "comm").read_text(encoding="utf-8", errors="replace").strip()
E               except OSError:
E                   return ""
E           
E           
E           def _pid_cmdline(pid, proc):
E               try:
E                   raw = (proc / str(pid) / "cmdline").read_bytes().replace(b"\x00", b" ")
E                   return raw.decode("utf-8", "replace")
E               except OSError:
E                   return ""
E           
E           
E           def _pid_age_seconds(pid, proc):
E               """Seconds since pid start. None if /proc is unreadable."""
E               try:
E                   stat = (proc / str(pid) / "stat").read_text(encoding="utf-8")
E                   startticks = int(stat.rsplit(") ", 1)[1].split()[19])
E                   hz = os.sysconf("SC_CLK_TCK") or 100
E                   uptime = float((proc / "uptime").read_text(encoding="utf-8").split()[0])
E               except (OSError, IndexError, ValueError):
E                   return None
E               return uptime - (startticks / float(hz))
E           
E           
E           def _is_codex_child(pid, proc):
E               comm = _pid_comm(pid, proc)
E               cmd = _pid_cmdline(pid, proc)
E               return comm == "codex" or comm.startswith("codex") or "codex exec" in cmd
E           
E           
E           def _progress_has_tool_line(paths):
E               for path in paths:
E                   try:
E                       text = path.read_text(encoding="utf-8", errors="replace")
E                   except OSError:
E                       continue
E                   if "[tool]" in text or "[done]" in text:
E                       return True
E               return False
E           
E           
E           def signal_hung_fixer_children(root_pids):
E               """SIGTERM hung ``codex exec`` descendants. Does not touch the babysitter.
E           
E               I18 signature: process exists, not R/D, no ESTABLISHED TCP, older than
E               the consult bound. A thinking consult has a socket and is left alone.
E               """
E               proc = _proc_root()
E               if not proc.is_dir():
E                   return []
E               bound = float(os.environ.get("CLOUD_WATCHDOG_HUNG_CHILD_MINUTES", "20")) * 60
E               pids = [raw for raw in root_pids if isinstance(raw, int) and raw > 0]
E               signaled = []
E               for pid in _descendant_pids(pids, proc):
E                   if not _is_codex_child(pid, proc):
E                       continue
E                   if _pid_runnable(pid, proc) or _pid_has_established_tcp(pid, proc):
E                       continue
E                   age = _pid_age_seconds(pid, proc)
E                   if age is None or age < bound:
E                       continue
E                   try:
E                       os.kill(pid, 15)
E                   except OSError:
E                       continue
E                   signaled.append(pid)
E               return signaled
E           
E           
E           def babysitter_wedged(payload, run_root):
E               """A live-pid fixer that has made NO progress is wedged.
E           
E               Contract (I51b): a busy unbounded babysitter is never reaped. Wedge
E               means: past newborn/first-call grace, no fresh progress file, and the
E               process tree shows no live work. A hung ``codex`` child is not a reason
E               to reap the parent — signal_hung_fixer_children handles that. If /proc
E               cannot be inspected, fail open.
E               """
E               launch_stall_minutes = float(
E                   os.environ.get("CLOUD_WATCHDOG_BABYSITTER_LAUNCH_STALL_MINUTES", "5")
E               )
E               log_stall_minutes = float(
E                   os.environ.get("CLOUD_WATCHDOG_BABYSITTER_LOG_STALL_MINUTES", "10")
E               )
E               # stdout.log is created at Popen, so log-stall starts at launch and
E               # expires at 10 min while the first DeepSeek call (timeout 600s) may
E               # still have no [tool] line and no ESTABLISHED socket. 20 min covers
E               # API timeout + bootstrap + one scan. Applies ONLY when no [tool]/[done]
E               # has ever been written — not a general wall.
E               first_call_grace_minutes = float(
E                   os.environ.get("CLOUD_WATCHDOG_BABYSITTER_FIRST_CALL_GRACE_MINUTES", "20")
E               )
E               try:
E                   launched_raw = payload.get("launched_at") or payload.get("dispatched_at")
E                   if not launched_raw:
E                       return False
E                   launched = datetime.fromisoformat(str(launched_raw).replace("Z", "+00:00"))
E                   age = datetime.now(timezone.utc) - launched
E                   if age < timedelta(minutes=launch_stall_minutes):
E                       return False
E               except Exception:
E                   return False
E               paths = list(_progress_logs(payload, run_root))
E               if not _progress_has_tool_line(paths):
E                   if age < timedelta(minutes=first_call_grace_minutes):
E                       return False
E               newest = None
E               for path in paths:
E                   try:
E                       mtime = path.stat().st_mtime
E                   except OSError:
E                       continue
E                   if newest is None or mtime > newest:
E                       newest = mtime
E               if newest is not None:
E                   if datetime.now(timezone.utc).timestamp() - newest < log_stall_minutes * 60:
E                       return False
E               live_work = _tree_has_live_work(
E                   (payload.get("babysitter_pid"), payload.get("supervisor_pid"))
E               )
E               if live_work is True:
E                   return False
E               if live_work is None:
E                   return False
E               return True
E           
E           
E           for name in (
E               f"{session}.babysitter-launch-receipt.json",
E               f"{session}.babysitter-receipt.json",
E           ):
E               path = repair_data / name
E               if not path.is_file():
E                   continue
E               try:
E                   payload = json.loads(path.read_text(encoding="utf-8"))
E               except Exception:
E                   continue
E               # Dedup is SESSION-keyed, not digest-keyed: any live babysitter for this
E               # session blocks a new launch. Digest-keyed dedup let a second babysitter
E               # launch the moment the occurrence digest changed (e.g. the durable-digest
E               # fix changed d58701026410 -> 4f5b449cfd75 while the old babysitter was
E               # still running), spawning competing fixers for the same chain.
E               if str(payload.get("status") or "") in {"launched", "running"}:
E                   run_root_raw = payload.get("run_root")
E                   run_root = pathlib.Path(run_root_raw) if isinstance(run_root_raw, str) else None
E                   roots = (payload.get("babysitter_pid"), payload.get("supervisor_pid"))
E                   live = pid_live(roots[0]) or pid_live(roots[1])
E                   if live:
E                       hung = signal_hung_fixer_children(roots)
E                       if hung:
E                           print(
E                               "hung fixer child; signaling "
E                               f"session={session} pids={hung} run_root={run_root}",
E                               file=sys.stderr,
E                           )
E                       if not babysitter_wedged(payload, run_root):
E                           raise SystemExit(0)
E                   # Wedged (or dead): terminate the stale babysitter + its agent tree so
E                   # the fresh dispatch below does not race a zombie fixer on the same
E                   # chain (observed 2026-08-17 I35: wedged 15:38 agents lingered beside
E                   # 16:46 re-dispatches, both alive, competing). Best-effort SIGTERM;
E                   # the receipt is left for the fresh launch to supersede.
E                   print(
E                       "babysitter wedged or dead; signaling "
E                       f"session={session} babysitter_pid={payload.get('babysitter_pid')} "
E                       f"supervisor_pid={payload.get('supervisor_pid')} "
E                       f"run_root={run_root}",
E                       file=sys.stderr,
E                   )
E                   for stale_pid in (payload.get("babysitter_pid"), payload.get("supervisor_pid")):
E                       if isinstance(stale_pid, int) and stale_pid > 0 and pid_live(stale_pid):
E                           try:
E                               os.kill(stale_pid, 15)
E                           except OSError:
E                               pass
E           raise SystemExit(1)
E           PY
E           }
E           
E           # Launch the single-flash babysitter for the given occurrence. Journals
E           # deviation_declared + fallback_considered BEFORE the launch side effect (a
E           # ledger write failure blocks the launch: no event = no side effect), resolves
E           # the goal renderer + arnold-babysitter bin from the LIVE engine, renders the
E           # goal, Popens the wrapper detached, grace-polls for an early non-zero rc
E           # (fail closed), and writes the dispatch receipt. Returns 0 on launch, 1 on
E           # failure. There is NO L1/L2 fallthrough here or at the callers.
E           launch_status_trigger_babysitter() {
E             local session="$1"
E             local workspace="$2"
E             local remote_spec="$3"
E             local run_kind="${4:-chain}"
E             local plan_name="${5:-}"
E             local report_items="$6"
E             local digest="${7:-}"
E             PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" \
E             ARNOLD_WATCHDOG_MANIFEST_RUNTIME_ROOT="${MANIFEST_RUNTIME_ROOT:-}" \
E             ARNOLD_WATCHDOG_RUNTIME_SRC="${REPAIR_DISPATCH_RUNTIME_SRC:-$SRC_DIR}" \
E             CLOUD_WATCHDOG_BABYSITTER_BIN="${CLOUD_WATCHDOG_BABYSITTER_BIN:-}" \
E             ARNOLD_BABYSITTER_LAUNCH_GRACE_SECS="${ARNOLD_BABYSITTER_LAUNCH_GRACE_SECS:-2}" \
E             python3 - "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" "$MARKER_DIR" "$REPAIR_DATA_DIR" "$digest" <<'PY'
E           import datetime as _dt
E           import hashlib as _hashlib
E           import json as _json
E           import os
E           import runpy as _runpy
E           import subprocess as _subprocess
E           import sys
E           import tempfile as _tempfile
E           import time as _time
E           from pathlib import Path
E           
E           from arnold_pipelines.megaplan.chain.spec import chain_spec_sha256
E           from arnold_pipelines.megaplan.incident.ledger import RuntimeTransitionWriter
E           
E           session, workspace_raw, remote_spec_raw, run_kind, plan_name, marker_dir_raw, repair_data_dir_raw, digest = sys.argv[1:]
E           workspace = Path(workspace_raw)
E           marker_dir = Path(marker_dir_raw)
E           repair_data_dir = Path(repair_data_dir_raw)
E           
E           
E           def emit_runtime_transition(event_name: str, *, error: str = "", summary: str = "") -> None:
E               """Append one typed runtime transition BEFORE a dispatch side effect.
E           
E               The ledger append is synchronous and never swallowed.  Fail closed —
E               missing workspace/spec (no contract digest) or a ledger write failure
E               raises SystemExit(1) so the caller MUST NOT perform the launch side
E               effect (no event = no side effect).
E               """
E               if not workspace or not remote_spec_raw:
E                   raise SystemExit(1)
E               spec = Path(remote_spec_raw)
E               if not spec.is_absolute():
E                   spec = workspace / spec
E               if not spec.is_file():
E                   raise SystemExit(1)
E               try:
E                   chain_digest = chain_spec_sha256(spec)
E                   writer = RuntimeTransitionWriter(workspace)
E                   emit_fn = {
E                       "deviation_declared": writer.emit_deviation_declared,
E                       "fallback_considered": writer.emit_fallback_considered,
E                   }[event_name]
E                   emit_fn(
E                       scope=f"chain:{session}",
E                       failure_class="availability",
E                       chain_spec_sha256=chain_digest,
E                       error=error,
E                       actor="arnold-watchdog",
E                       session_id=session,
E                       summary=summary,
E                   )
E               except SystemExit:
E                   raise
E               except Exception as exc:
E                   print(
E                       f"babysitter launch blocked: runtime transition ledger write failed "
E                       f"session={session} event={event_name} err={exc}",
E                       file=sys.stderr,
E                   )
E                   raise SystemExit(1)
E           
E           
E           # P2: journal the typed runtime transitions BEFORE the launch side effect
E           # (no event = no side effect).
E           emit_runtime_transition(
E               "deviation_declared",
E               error="watchdog observed unhealthy session; status-trigger babysitter dispatch requested",
E               summary=f"watchdog declared runtime deviation session={session}",
E           )
E           emit_runtime_transition(
E               "fallback_considered",
E               summary=f"watchdog considered status-trigger babysitter fallback session={session}",
E           )
E           
E           
E           def _superfixer_engine_roots() -> list[Path]:
E               """Live engine roots: manifest runtime root, dispatch runtime source,
E               SRC_DIR, then the origin-derived repo root.  The first root that carries
E               the babysitter assets wins; the hardcoded stale arnold-r7 tree is never
E               used."""
E               roots: list[Path] = []
E               for env_name in (
E                   "ARNOLD_WATCHDOG_MANIFEST_RUNTIME_ROOT",
E                   "ARNOLD_WATCHDOG_RUNTIME_SRC",
E                   "SRC_DIR",
E               ):
E                   value = os.environ.get(env_name, "").strip()
E                   if value:
E                       roots.append(Path(value))
E               origin = os.environ.get("ARNOLD_WATCHDOG_ORIGIN", "").strip()
E               if origin:
E                   roots.append(Path(origin).resolve().parents[4])
E               return roots
E           
E           
E           def _resolve_renderer(roots: list[Path]) -> Path:
E               for root in roots:
E                   candidate = (
E                       root
E                       / "arnold_pipelines/megaplan/skills/babysitter/scripts/render_babysitter_goal.py"
E                   )
E                   if candidate.is_file():
E                       return candidate
E               raise RuntimeError("babysitter goal renderer unavailable under live engine roots")
E           
E           
E           def _resolve_bin(roots: list[Path]) -> Path:
E               override = os.environ.get("CLOUD_WATCHDOG_BABYSITTER_BIN", "").strip()
E               if override:
E                   candidate = Path(override)
E                   if not candidate.is_file():
E                       raise RuntimeError(f"babysitter bin override is not a file: {candidate}")
E                   return candidate
E               for root in roots:
E                   candidate = root / "arnold_pipelines/megaplan/cloud/wrappers/arnold-babysitter"
E                   if candidate.is_file():
E                       return candidate
E               raise RuntimeError("babysitter bin unavailable under live engine roots")
E           
E           
E           def _atomic_write(path: Path, text: str) -> None:
E               path.parent.mkdir(parents=True, exist_ok=True)
E               fd, tmp = _tempfile.mkstemp(prefix=path.name + ".", dir=str(path.parent))
E               with os.fdopen(fd, "w", encoding="utf-8") as handle:
E                   handle.write(text)
E               os.replace(tmp, path)
E           
E           
E           def _load_json(path: Path | None) -> dict:
E               if path is None:
E                   return {}
E               try:
E                   payload = _json.loads(path.read_text(encoding="utf-8"))
E               except Exception:
E                   return {}
E               return payload if isinstance(payload, dict) else {}
E           
E           
E           plan_name = str(plan_name or "").strip()
E           state_path = None
E           if plan_name:
E               candidate = workspace / ".megaplan" / "plans" / plan_name / "state.json"
E               if candidate.is_file():
E                   state_path = candidate
E           elif run_kind == "plan":
E               plans_root = workspace / ".megaplan" / "plans"
E               candidates = sorted(
E                   plans_root.glob("*/state.json"),
E                   key=lambda path: path.stat().st_mtime,
E                   reverse=True,
E               )
E               if candidates:
E                   state_path = candidates[0]
E           else:
E               chain_path = None
E               if remote_spec_raw:
E                   spec_path = Path(remote_spec_raw)
E                   if not spec_path.is_absolute():
E                       spec_path = workspace / spec_path
E                   try:
E                       spec_resolved = spec_path.resolve()
E                   except Exception:
E                       spec_resolved = spec_path
E                   chain_digest = _hashlib.sha1(str(spec_resolved).encode("utf-8")).hexdigest()[:12]
E                   for candidate in (
E                       workspace / ".megaplan" / "plans" / ".chains" / f"chain-{chain_digest}.json",
E                       workspace / ".megaplan" / "plans" / ".chains" / f"{spec_resolved.stem}-{chain_digest}.json",
E                       spec_resolved.parent / ".megaplan" / "plans" / ".chains" / f"chain-{chain_digest}.json",
E                   ):
E                       if candidate.is_file():
E                           chain_path = candidate
E                           break
E               if chain_path is not None:
E                   chain_state = _load_json(chain_path)
E                   chain_plan = str(chain_state.get("current_plan_name") or "").strip()
E                   if chain_plan:
E                       candidate = workspace / ".megaplan" / "plans" / chain_plan / "state.json"
E                       if candidate.is_file():
E                           state_path = candidate
E               if state_path is None:
E                   plans_root = workspace / ".megaplan" / "plans"
E                   candidates = sorted(
E                       plans_root.glob("*/state.json"),
E                       key=lambda path: path.stat().st_mtime,
E                       reverse=True,
E                   )
E                   if candidates:
E                       state_path = candidates[0]
E           
E           plan_state = _load_json(state_path)
E           resolved_plan_name = str(plan_state.get("name") or plan_name or "").strip()
E           if not resolved_plan_name and state_path is not None:
E               resolved_plan_name = state_path.parent.name
E           latest_failure = plan_state.get("latest_failure")
E           latest_failure = latest_failure if isinstance(latest_failure, dict) else {}
E           metadata = latest_failure.get("metadata")
E           metadata = metadata if isinstance(metadata, dict) else {}
E           meta = plan_state.get("meta") if isinstance(plan_state.get("meta"), dict) else {}
E           planner_repair = meta.get("planner_repair")
E           
E           try:
E               roots = _superfixer_engine_roots()
E               renderer = _resolve_renderer(roots)
E               babysitter_bin = _resolve_bin(roots)
E               # The live engine root is the renderer's own tree (5 parents up from
E               # scripts/render_babysitter_goal.py), never the babysitter bin location
E               # (which a test override may relocate).
E               engine_root = renderer.resolve().parents[5]
E               run_id = "sched_superfixer_status_" + session.replace("/", "_")[:48] + "_" + digest
E               _ns = _runpy.run_path(str(renderer))
E               render_babysitter_goal = _ns.get("render_babysitter_goal")
E               if not callable(render_babysitter_goal):
E                   raise RuntimeError("babysitter goal renderer is unavailable")
E               goal_text = render_babysitter_goal(
E                   session,
E                   workspace=str(workspace),
E                   plan=resolved_plan_name,
E                   run_kind=run_kind,
E                   latest_failure=latest_failure if isinstance(latest_failure, dict) else None,
E                   planner_repair=planner_repair if isinstance(planner_repair, dict) else None,
E                   occurrence_digest=digest,
E                   recovery_dir=str(
E                       Path(workspace) / ".megaplan" / "plans" / ".chains" / "recovery"
E                   ),
E               )
E               goal_fd, goal_path = _tempfile.mkstemp(suffix=".md", prefix="superfixer-goal-")
E               with os.fdopen(goal_fd, "w") as fh:
E                   fh.write(goal_text)
E               run_root = repair_data_dir / "babysitter-runs" / run_id
E               run_root.mkdir(parents=True, exist_ok=True)
E               child_env = dict(os.environ)
E               child_env["PYTHONPATH"] = str(engine_root) + (
E                   ":" + child_env["PYTHONPATH"] if child_env.get("PYTHONPATH") else ""
E               )
E               child_env["ARNOLD_BABYSITTER_SESSION"] = session
E               # ROOT FIX (grok consult 2026-08-17): the inherited box-global
E               # ARNOLD_REPAIR_SESSION leaked into cross-session babysitter dispatches -
E               # an astrid babysitter spawned by the mega watchdog's env carried
E               # ARNOLD_REPAIR_SESSION=megaplan-maintenance into its resume/execute
E               # workers, which hijacked the MEGA liveness lock/marker/lease. Remap the
E               # repair session to the babysitter's target session so the liveness
E               # resolver (liveness_lease.resolve_managed_session) sees consistency and
E               # publishes under the correct session. Also clear the inherited owner pid
E               # so the child never defers to a foreign live publisher.
E               child_env["ARNOLD_REPAIR_SESSION"] = session
E               child_env.pop("ARNOLD_LIVENESS_OWNER_PID", None)
E               child_env.pop("ARNOLD_LIVENESS_OWNER_PROCESS_START", None)
E               child_env["ARNOLD_BABYSITTER_WORKSPACE"] = str(workspace)
E               child_env["ARNOLD_BABYSITTER_PLAN"] = resolved_plan_name
E               child_env["ARNOLD_BABYSITTER_RUN_KIND"] = run_kind
E               child_env["ARNOLD_BABYSITTER_OCCURRENCE"] = digest
E               child_env["ARNOLD_BABYSITTER_GOAL_FILE"] = goal_path
E               child_env["ARNOLD_BABYSITTER_MARKER_DIR"] = str(marker_dir)
E               child_env["ARNOLD_BABYSITTER_REPAIR_DATA_DIR"] = str(repair_data_dir)
E               stdout_fh = open(run_root / "babysitter.stdout.log", "ab")
E               stderr_fh = open(run_root / "babysitter.stderr.log", "ab")
E               try:
E                   launch = _subprocess.Popen(
E                       [
E                           str(babysitter_bin),
E                           "--goal-file", goal_path,
E                           "--session", session,
E                           "--workspace", str(workspace),
E                           "--plan", resolved_plan_name,
E                           "--run-kind", run_kind,
E                           "--occurrence", digest,
E                           "--remote-spec", str(remote_spec_raw or ""),
E                           "--run-id", run_id,
E                           "--run-root", str(run_root),
E                           "--mode", "superfixer",
E                       ],
E                       env=child_env,
E                       start_new_session=True,
E                       stdin=_subprocess.DEVNULL,
E                       stdout=stdout_fh,
E                       stderr=stderr_fh,
E                   )
E               finally:
E                   stdout_fh.close()
E                   stderr_fh.close()
E               # rc check + fail closed: a babysitter that dies immediately with a
E               # non-zero rc means the launch did not take; journal and abort so the
E               # caller never falls through to a deleted L1/L2 path.
E               grace = float(os.environ.get("ARNOLD_BABYSITTER_LAUNCH_GRACE_SECS", "2"))
E               deadline = _time.monotonic() + grace
E               launch_rc = None
E               while _time.monotonic() < deadline:
E                   launch_rc = launch.poll()
E                   if launch_rc is not None:
E                       break
E                   _time.sleep(0.05)
E               if launch_rc is not None and launch_rc != 0:
E                   raise RuntimeError(f"babysitter exited early rc={launch_rc}")
E               receipt = {
E                   "schema": "arnold.superfixer.watchdog_dispatch_receipt.v1",
E                   "session": session,
E                   "plan": resolved_plan_name,
E                   "run_id": run_id,
E                   "occurrence_digest": digest,
E                   "goal_path": goal_path,
E                   "renderer_path": str(renderer),
E                   "babysitter_bin": str(babysitter_bin),
E                   "engine_root": str(engine_root),
E                   "babysitter_pid": launch.pid,
E                   "run_root": str(run_root),
E                   "dispatched_at": _dt.datetime.now(_dt.timezone.utc).strftime(
E                       "%Y-%m-%dT%H:%M:%SZ"
E                   ),
E                   "status": "launched",
E               }
E               _atomic_write(
E                   repair_data_dir / f"{session}.babysitter-receipt.json",
E                   _json.dumps(receipt, indent=2, sort_keys=True) + "\n",
E               )
E           except SystemExit:
E               raise
E           except Exception as _sfx:
E               print(
E                   f"babysitter launch failed session={session} err={_sfx}",
E                   file=sys.stderr,
E               )
E               raise SystemExit(1)
E           PY
E           }
E           
E           # The ONLY repair-dispatch gate in the watchdog (Q2 steps 2/5). Consults
E           # driver.babysitter (mode/after), dedups against a live babysitter for the
E           # same occurrence, launches the single-flash babysitter, and reports a typed
E           # status. Returns 0 in every case — the tick never falls through to a
E           # layered L1/L2 path.
E           babysitter_policy_dispatch() {
E             local session="$1"
E             local workspace="$2"
E             local remote_spec="$3"
E             local run_kind="${4:-chain}"
E             local plan_name="${5:-}"
E             local report_items="$6"
E             local reason="${7:-unhealthy session}"
E             local mode_after mode after digest
E             mode_after="$(babysitter_effective_mode "$remote_spec" "$workspace" 2>>"${LOG:-/dev/null}" || true)"
E             mode="${mode_after%%$'\t'*}"
E             after="${mode_after#*$'\t'}"
E             [[ -n "$mode" ]] || mode="superfixer"
E             if [[ "$mode" == "off" ]]; then
E               # mode=off disables REPAIR dispatch for this chain, but a STOPPED
E               # PRE-EXECUTE STALL (plan born, no active step, no live driver — e.g.
E               # a fresh m2 milestone never driven into prep) is not a repair; it is a
E               # chain the fixer must DRIVE.  Dispatch the babysitter for the parked
E               # stall even when mode=off, so a healthy-but-unstarted milestone cannot
E               # sit forever (astrid-first m2 case, grok/codex fixer-gap family B).
E               if babysitter_parked_chain_stall "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" 2>>"${LOG:-/dev/null}"; then
E                 log "babysitter mode=off but parked-chain stall detected; dispatching drive session=$session reason=$reason"
E               else
E                 log "babysitter mode=off; observing without babysitter dispatch session=$session reason=$reason"
E                 report_item "$report_items" "$session" "repair" "babysitter_off" \
E                   "babysitter disabled for this chain (driver.babysitter.mode=off); $reason" \
E                   "$workspace" "$remote_spec"
E                 return 0
E               fi
E             fi
E             digest="$(babysitter_occurrence_digest "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" 2>>"${LOG:-/dev/null}" || true)"
E             if [[ -n "$digest" ]] && babysitter_running_for_occurrence "$session" "$digest"; then
E               log "babysitter already running for occurrence session=$session digest=$digest"
E               report_item "$report_items" "$session" "repair" "babysitter_running" \
E                 "single-flash babysitter already running for this occurrence; observing" \
E                 "$workspace" "$remote_spec"
E               return 0
E             fi
E             if [[ -n "$after" ]] && ! babysitter_after_elapsed "$after" "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" 2>>"${LOG:-/dev/null}"; then
E               log "babysitter after=$after not yet elapsed; observing session=$session reason=$reason"
E               report_item "$report_items" "$session" "repair" "babysitter_waiting" \
E                 "babysitter after=$after not elapsed; observing unhealthy session: $reason" \
E                 "$workspace" "$remote_spec"
E               return 0
E             fi
E             if launch_status_trigger_babysitter "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" "$report_items" "$digest"; then
E               log "single-flash babysitter launched session=$session digest=$digest reason=$reason"
E               report_item "$report_items" "$session" "repair" "babysitter_scheduled" \
E                 "single-flash babysitter dispatched: $reason" "$workspace" "$remote_spec"
E             else
E               log "babysitter launch failed; no L1/L2 fallthrough session=$session reason=$reason"
E               report_item "$report_items" "$session" "repair" "babysitter_launch_failed" \
E                 "babysitter launch failed; no L1/L2 fallthrough: $reason" "$workspace" "$remote_spec"
E             fi
E             return 0
E           }
E           
E           emit_custody_structured_facts() {
E             local session="$1"
E             local workspace="$2"
E             local remote_spec="$3"
E             local run_kind="${4:-chain}"
E             local plan_name="${5:-}"
E             local tmux_live="${6:-0}"
E             local process_live="${7:-0}"
E             local active_step_pid_alive="${8:-}"
E             local chain_complete="${9:-0}"
E             local supervisor_identity="${10:-}"
E             local relaunch_command="${11:-}"
E             local needs_human="${12:-0}"
E             local repair_active="${13:-0}"
E             local watchdog_status="${14:-unknown}"
E           
E             local facts facts_file
E             facts_file="$(mktemp "${TMPDIR:-/tmp}/arnold-watchdog-custody.XXXXXX")" || return 0
E             PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$session" "$supervisor_identity" "$tmux_live" "$process_live" "$active_step_pid_alive" "$watchdog_status" "$chain_complete" "$relaunch_command" "$needs_human" "$repair_active" >"$facts_file" 2>>"${LOG:-/dev/null}" <<'PY' || authority_gap_continue "T29-BYPASS-128" "authority-risk bypass converted to typed evidence gap"
E           import json
E           import shlex
E           import sys
E           
E           from arnold_pipelines.megaplan.cloud.repair_contract import (
E               classify_cloud_custody,
E               CUSTODY_MANAGED_RUNNING,
E               CUSTODY_COMPLETE,
E               CUSTODY_UNMANAGED_WARNING,
E               CUSTODY_BLOCKED_RELAUNCH,
E               CUSTODY_ESCALATED_UNCHANGED,
E           )
E           
E           
E           def emit(name: str, value: str) -> None:
E               print(f"{name}={shlex.quote(value)}")
E           
E           
E           session_id = sys.argv[1]
E           supervisor_identity = sys.argv[2]
E           tmux_live = sys.argv[3] == "1"
E           process_live = sys.argv[4] == "1"
E           active_step_pid_alive = sys.argv[5] == "1"
E           watchdog_status = sys.argv[6]
E           chain_complete = sys.argv[7] == "1"
E           relaunch_command = sys.argv[8]
E           needs_human = sys.argv[9] == "1"
E           repair_active = sys.argv[10] == "1"
E           
E           classification = classify_cloud_custody(
E               session_id=session_id,
E               supervisor_identity=supervisor_identity,
E               tmux_live=tmux_live,
E               process_live=process_live,
E               active_step_worker_pid_liveness=active_step_pid_alive,
E               watchdog_status=watchdog_status,
E               chain_complete=chain_complete,
E               relaunch_command=relaunch_command,
E               relaunch_command_available=bool(relaunch_command),
E               needs_human=needs_human,
E               repair_active=repair_active,
E           )
E           
E           emit("PLAN_STATUS_CUSTODY_KIND", classification.custody_kind)
E           emit("PLAN_STATUS_CUSTODY_SESSION_ID", classification.session_id)
E           emit("PLAN_STATUS_CUSTODY_SUPERVISOR_IDENTITY", classification.supervisor_identity)
E           emit("PLAN_STATUS_CUSTODY_ACTIVE_STEP_PID_LIVE", "1" if classification.active_step_worker_pid_liveness else "0")
E           emit("PLAN_STATUS_CUSTODY_UNMANAGED_PROCESS", "1" if classification.custody_kind == CUSTODY_UNMANAGED_WARNING else "0")
E           emit("PLAN_STATUS_CUSTODY_LIVE_PROCESS_FINGERPRINTS", ",".join(classification.live_process_fingerprints))
E           emit("PLAN_STATUS_CUSTODY_RELAUNCH_COMMAND_AVAILABLE", "1" if classification.relaunch_command_available else "0")
E           emit("PLAN_STATUS_CUSTODY_FAILURE_REASONS", "; ".join(classification.failure_reasons))
E           emit("PLAN_STATUS_CUSTODY_EVIDENCE_TIMESTAMP", classification.evidence_timestamp)
E           emit("PLAN_STATUS_CUSTODY_CONTRACT_ID", classification.contract_id)
E           emit("PLAN_STATUS_CUSTODY_BOUNDARY_ID", classification.boundary_id)
E           PY
E             facts="$(<"$facts_file")"
E             rm -f "$facts_file"
E             if [[ -n "$facts" ]]; then
E               eval "$facts"
E             fi
E           }
E           
E           adopt_unmarked_tmux_sessions() {
E             local discover_bin="${DISCOVER_BIN:-$SRC_DIR/arnold_pipelines/megaplan/cloud/wrappers/arnold-cloud-discover}"
E             [[ -f "$discover_bin" ]] || return 0
E           
E             # Discovery is retained for operator diagnostics only.  A tmux session has
E             # no marker-bound namespace/start identity, so it may not synthesize a
E             # marker (which would in turn admit repair/relaunch/retirement control).
E             while IFS=$'\t' read -r session workspace remote_spec run_kind plan_name relaunch_command; do
E               [[ -n "${session:-}" ]] || continue
E               printf '%s\t%s\t%s\t%s\t%s\n' "$session" "$workspace" "$remote_spec" "${run_kind:-chain}" "${plan_name:-}"
E             done < <(bash "$discover_bin" tmux-unmarked --marker-dir "$MARKER_DIR" --src-dir "$SRC_DIR")
E           }
E           
E           repo_url_with_token() {
E             local repo="$1"
E             if [[ "$repo" == https://github.com/* && "$repo" != https://*@github.com/* && -n "${GITHUB_TOKEN:-}" ]]; then
E               printf 'https://x-access-token:%s@github.com/%s' "$GITHUB_TOKEN" "${repo#https://github.com/}"
E             else
E               printf '%s' "$repo"
E             fi
E           }
E           
E           emit_report() {
E             local items_path="$1"
E             local markers="$2"
E             local report_tmp
E             if ! report_tmp="$(mktemp)"; then
E               log "report publication skipped: unable to allocate summary temp file"
E               return 0
E             fi
E             if ! PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$items_path" "$markers" "$REPORT_PATH" "$REPORT_ARCHIVE_DIR" "$REPAIR_ENABLED" "$PUSH_REPAIRS" <<'PY' > "$report_tmp"; then
E           import datetime as dt
E           import json
E           import os
E           import sys
E           import tempfile
E           
E           from arnold_pipelines.megaplan.cloud.redact import redact_payload
E           
E           items_path, markers, report_path, archive_dir, repair, push = sys.argv[1:]
E           items = []
E           if os.path.exists(items_path):
E               with open(items_path, encoding="utf-8") as handle:
E                   for line in handle:
E                       line = line.strip()
E                       if line:
E                           items.append(json.loads(line))
E           issues = [
E               item for item in items
E               if item.get("status") not in {"alive", "complete", "completed", "restarted", "synced", "skipped"}
E           ]
E           restarted = [item for item in items if item.get("status") == "restarted"]
E           reaped = [item for item in items if item.get("status") == "reaped"]
E           needs_human = [item for item in items if item.get("status") == "needs_human"]
E           webhook_notifications = [
E               item for item in items
E               if item.get("action") == "notify" and item.get("status") == "webhook_sent"
E           ]
E           now = dt.datetime.now(dt.timezone.utc)
E           timestamp = now.isoformat()
E           archive_name = now.strftime("%Y%m%dT%H%M%SZ") + ".json"
E           archive_path = os.path.join(archive_dir, archive_name) if archive_dir else ""
E           payload = {
E               "timestamp_utc": timestamp,
E               "marker_dir": os.environ.get("CLOUD_WATCHDOG_MARKER_DIR", "/workspace/.megaplan/cloud-sessions"),
E               "markers_seen": int(markers),
E               "sessions_seen": len(items),
E               "alive_sessions": sum(1 for item in items if item.get("status") == "alive"),
E               "restarted_sessions": len(restarted),
E               "reaped_repairs": len(reaped),
E               "needs_human_sessions": len(needs_human),
E               "webhook_notifications_sent": len(webhook_notifications),
E               "issue_count": len(issues),
E               "codex_repair_enabled": repair == "1",
E               "push_repairs_enabled": push == "1",
E               "latest_report_path": report_path,
E               "archive_report_path": archive_path,
E               "items": items,
E               "issues": issues,
E           }
E           payload = redact_payload(payload)
E           encoded = (json.dumps(payload, indent=2, sort_keys=True) + "\n").encode("utf-8")
E           
E           def atomic_publish(path, content):
E               parent = os.path.dirname(path) or "."
E               os.makedirs(parent, exist_ok=True)
E               fd, tmp_path = tempfile.mkstemp(prefix=f".{os.path.basename(path)}.", suffix=".tmp", dir=parent)
E               try:
E                   with os.fdopen(fd, "wb") as handle:
E                       handle.write(content)
E                       handle.flush()
E                       os.fsync(handle.fileno())
E                   os.replace(tmp_path, path)
E                   dir_fd = os.open(parent, os.O_RDONLY)
E                   try:
E                       os.fsync(dir_fd)
E                   finally:
E                       os.close(dir_fd)
E               except BaseException:
E                   try:
E                       os.unlink(tmp_path)
E                   except FileNotFoundError:
E                       pass
E                   raise
E           
E           atomic_publish(report_path, encoded)
E           if archive_path:
E               try:
E                   atomic_publish(archive_path, encoded)
E               except OSError as exc:
E                   print(f"watchdog archive publication failed: {exc}", file=sys.stderr)
E           print(json.dumps(payload, sort_keys=True))
E           PY
E               log "report publication failed; retained last complete report"
E               rm -f "$report_tmp"
E               return 0
E             fi
E             # Reports remain local evidence; provider delivery is owned by a
E             # durable outbox worker, never by the watchdog observer.
E             local summary
E             summary="$(cat "$report_tmp")"
E             log "report $summary"
E             if [[ -n "$REPORT_WEBHOOK" ]]; then
E               log "report webhook delivery deferred to canonical outbox worker"
E             fi
E             rm -f "$report_tmp"
E           }
E           
E           write_watchdog_heartbeat() {
E             # Touch a freshness probe at sweep START so the resident can detect a stalled
E             # watchdog even when a later step (git sync / pip refresh)
E             # hangs before the snapshot write completes (watchdog-snapshot-staleness-fix.md
E             # P2). Best-effort; never fails a sweep.
E             local status_dir="${1:-$STATUS_DIR}"
E             mkdir -p "$status_dir" 2>/dev/null || true
E             python3 - "$status_dir" <<'PY' 2>/dev/null || date -u +"%Y-%m-%dT%H:%M:%SZ" > "$status_dir/watchdog.heartbeat" 2>/dev/null || true
E           import datetime, pathlib, sys
E           p = pathlib.Path(sys.argv[1]) / "watchdog.heartbeat"
E           p.write_text(datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z") + "\n")
E           PY
E           }
E           
E           record_snapshot_write_outcome() {
E             # Track consecutive snapshot-write failures (watchdog-snapshot-staleness-fix.md
E             # P2): "ok" resets the counter and clears the error sidecar; "fail" bumps it,
E             # and once it reaches SNAPSHOT_FAILURE_THRESHOLD drops a visible
E             # cloud-status.write-error.json so consumers know the cache is frozen. Prints
E             # the failure count on "fail" (for logging); prints nothing on "ok".
E             local status_dir="${1:-$STATUS_DIR}"
E             local outcome="${2:-ok}"
E             local threshold="${SNAPSHOT_FAILURE_THRESHOLD:-3}"
E             python3 - "$status_dir" "$outcome" "$threshold" <<'PY' 2>/dev/null || authority_gap_continue "T29-BYPASS-131" "authority-risk bypass converted to typed evidence gap"
E           import datetime, json, pathlib, sys
E           status_dir, outcome, threshold = sys.argv[1], sys.argv[2], int(sys.argv[3] or 3)
E           base = pathlib.Path(status_dir)
E           counter_path = base / "snapshot-failures.json"
E           err_path = base / "cloud-status.write-error.json"
E           now = datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z")
E           if outcome == "ok":
E               for p in (counter_path, err_path):
E                   try:
E                       p.unlink()
E                   except FileNotFoundError:
E                       pass
E               sys.exit(0)
E           try:
E               failures = json.loads(counter_path.read_text()).get("failures", 0) + 1 if counter_path.exists() else 1
E           except Exception:
E               failures = 1
E           counter_path.write_text(json.dumps({"failures": failures, "last_at": now}) + "\n")
E           if failures >= threshold:
E               err_path.write_text(json.dumps({
E                   "error": "cloud-status snapshot write has failed %d consecutive sweeps; cache may be frozen" % failures,
E                   "failures": failures,
E                   "at": now,
E               }) + "\n")
E           print(failures)
E           PY
E           }
E           
E           write_status_snapshot() {
E             # Produce the canonical cloud-status.json. Built from local observation only
E             # (marker dir + the report emit_report wrote). The 4th arg ("track" default vs
E             # "notrack") decides whether a failure counts toward escalation — the early
E             # best-effort write at sweep start uses "notrack" so only authoritative
E             # end-of-sweep write failures escalate. Never let a snapshot failure break the
E             # watchdog sweep — count/log and move on.
E             local marker_dir="${1:-$MARKER_DIR}"
E             local report_path="${2:-$REPORT_PATH}"
E             local status_dir="${3:-$STATUS_DIR}"
E             local track="${4:-track}"
E             if PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$marker_dir" "$report_path" "$status_dir" <<'PY' 2>>"${LOG:-/dev/null}"; then
E           import sys
E           from pathlib import Path
E           
E           from arnold_pipelines.megaplan.cloud import status_snapshot
E           
E           marker_dir, report_path, status_dir = (Path(p) for p in sys.argv[1:4])
E           status_snapshot.build_and_write_snapshot(
E               marker_dir=marker_dir,
E               watchdog_report_path=report_path,
E               path=status_dir / "cloud-status.json",
E               previous_path=status_dir / "cloud-status.previous.json",
E           )
E           PY
E               [[ "$track" != "notrack" ]] && record_snapshot_write_outcome "$status_dir" ok
E             else
E               if [[ "$track" != "notrack" ]]; then
E                 local _failures
E                 _failures="$(record_snapshot_write_outcome "$status_dir" fail)"
E                 log "status snapshot write failed (${_failures:-?} consecutive; threshold ${SNAPSHOT_FAILURE_THRESHOLD:-3})"
E               else
E                 log "status snapshot early write failed (best-effort; not counted)"
E               fi
E             fi
E           
E             # --- custody disagreement detection ---
E             # Compare the watchdog's custody classification (produced during session
E             # processing and recorded in the watchdog report) with each session's custody
E             # in the freshly-written status snapshot.  Disagreements are emitted as
E             # structured custody_disagreement report items so S4 consumers can act on
E             # them without re-deriving custody from scratch.
E             if [[ "$track" != "notrack" ]]; then
E               detect_custody_disagreement "$report_path" "$status_dir/cloud-status.json" || authority_gap_continue "T29-BYPASS-132" "authority-risk bypass converted to typed evidence gap"
E             fi
E           }
E           
E           detect_custody_disagreement() {
E             local report_path="$1"
E             local snapshot_path="$2"
E             local disagreement_output disagreement_file
E             disagreement_file="$(mktemp "${TMPDIR:-/tmp}/arnold-watchdog-disagreement.XXXXXX")" || return 0
E             PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$report_path" "$snapshot_path" >"$disagreement_file" 2>>"${LOG:-/dev/null}" <<'PY' || authority_gap_continue "T29-BYPASS-133" "authority-risk bypass converted to typed evidence gap"
E           import json
E           import sys
E           from pathlib import Path
E           
E           report_path = Path(sys.argv[1])
E           snapshot_path = Path(sys.argv[2])
E           
E           if not report_path.exists() or not snapshot_path.exists():
E               raise SystemExit(0)
E           
E           try:
E               report = json.loads(report_path.read_text(encoding="utf-8"))
E               snapshot = json.loads(snapshot_path.read_text(encoding="utf-8"))
E           except Exception:
E               raise SystemExit(0)
E           
E           if not isinstance(report, dict) or not isinstance(snapshot, dict):
E               raise SystemExit(0)
E           
E           # Build a lookup of watchdog custody items by session from the report.
E           report_items = report.get("items")
E           if not isinstance(report_items, list):
E               raise SystemExit(0)
E           
E           watchdog_custody = {}
E           for item in report_items:
E               if not isinstance(item, dict):
E                   continue
E               if item.get("action") != "custody":
E                   continue
E               session = item.get("session")
E               if not isinstance(session, str) or not session:
E                   continue
E               summary = item.get("summary")
E               if not isinstance(summary, str):
E                   continue
E               # Parse custody_kind from summary "custody_kind=...; ..."
E               kind = ""
E               for part in summary.split(";"):
E                   part = part.strip()
E                   if part.startswith("custody_kind="):
E                       kind = part[len("custody_kind="):]
E                       break
E               if kind:
E                   watchdog_custody[session] = kind
E           
E           # Compare with each snapshot session's cloud_custody.
E           snapshot_sessions = snapshot.get("sessions")
E           if not isinstance(snapshot_sessions, list):
E               raise SystemExit(0)
E           
E           disagreements = []
E           for session_entry in snapshot_sessions:
E               if not isinstance(session_entry, dict):
E                   continue
E               session = session_entry.get("session")
E               if not isinstance(session, str) or not session:
E                   continue
E               snapshot_custody = session_entry.get("cloud_custody")
E               if not isinstance(snapshot_custody, dict):
E                   continue
E               snapshot_kind = snapshot_custody.get("custody_kind", "")
E           
E               wd_kind = watchdog_custody.get(session, "")
E               if not wd_kind or not snapshot_kind:
E                   continue
E           
E               if wd_kind != snapshot_kind:
E                   disagreements.append(
E                       f"session={session} watchdog_custody={wd_kind} snapshot_custody={snapshot_kind}"
E                   )
E           
E           if disagreements:
E               for line in disagreements:
E                   print(line)
E           PY
E             disagreement_output="$(<"$disagreement_file")"
E             rm -f "$disagreement_file"
E             if [[ -n "$disagreement_output" ]]; then
E               while IFS= read -r line; do
E                 [[ -n "$line" ]] || continue
E                 log "custody_disagreement: $line"
E               done <<< "$disagreement_output"
E             fi
E           }
E           
E           sync_cloud_runtime_wrappers() {
E             local wrapper_src_dir="$SRC_DIR/arnold_pipelines/megaplan/cloud/wrappers"
E             local wrapper_dest_dir="/usr/local/bin"
E             local support_dest_dir="/usr/local/share/arnold-watchdog"
E             local wrapper dest
E             [[ -d "$wrapper_src_dir" ]] || return 0
E           
E             mkdir -p "$wrapper_dest_dir" "$support_dest_dir"
E             for wrapper in "$wrapper_src_dir"/arnold-* "$wrapper_src_dir"/mp-*; do
E               [[ -f "$wrapper" ]] || continue
E               dest="$wrapper_dest_dir/$(basename "$wrapper")"
E               if [[ -f "$dest" ]] && cmp -s "$wrapper" "$dest"; then
E                 continue
E               fi
E               install -m 0755 "$wrapper" "$dest" || return 1
E             done
E             if [[ -f "$wrapper_src_dir/principles.md" ]]; then
E               dest="$support_dest_dir/principles.md"
E               if [[ ! -f "$dest" ]] || ! cmp -s "$wrapper_src_dir/principles.md" "$dest"; then
E                 install -m 0644 "$wrapper_src_dir/principles.md" "$dest" || return 1
E               fi
E             fi
E           }
E           
E           refresh_editable_install() {
E             # The supervisor interpreter is immutable for its lifetime. Source updates
E             # are consumed through PYTHONPATH and atomically copied wrappers; never run an
E             # in-place pip reinstall from inside the process that is doing observation.
E             log "refreshing Arnold source-backed supervisor from $SRC_DIR without mutating interpreter"
E             sync_cloud_runtime_wrappers >> "$LOG" 2>&1 || return 1
E           
E             PYTHONSAFEPATH=1 PYTHONPATH="$SRC_DIR:${PYTHONPATH:-}" python3 -P - <<'PY' >> "$LOG" 2>&1
E           import yaml  # noqa: F401
E           import arnold_pipelines.megaplan.cloud.cli  # noqa: F401
E           import arnold_pipelines.megaplan.cloud.repair_contract  # noqa: F401
E           PY
E           }
E           
E           ensure_editable_source_checkout() {
E             if [[ -d "$SRC_DIR/.git" ]]; then
E               return 0
E             fi
E           
E             local repo="$SYNC_REPO"
E             if [[ -z "$repo" && -d /workspace/Arnold/.git ]]; then
E               repo="$(cd /workspace/Arnold && git remote get-url origin 2>/dev/null || true)"
E             fi
E             if [[ -z "$repo" ]]; then
E               log "editable source checkout missing at $SRC_DIR and no repo URL is configured"
E               return 1
E             fi
E           
E             log "cloning editable source checkout branch=$SYNC_BRANCH into $SRC_DIR"
E             mkdir -p "$(dirname "$SRC_DIR")"
E             timeout "$SYNC_TIMEOUT_SECS" git clone --branch "$SYNC_BRANCH" "$(repo_url_with_token "$repo")" "$SRC_DIR" >> "$LOG" 2>&1
E           }
E           
E           sync_skills_in_source() {
E             local source_dir="$1"
E             if [[ -f "$source_dir/scripts/generate_arnold_docs.py" ]]; then
E               log "regenerating Arnold docs/skills in $source_dir"
E               (cd "$source_dir" && python3 scripts/generate_arnold_docs.py --write) >> "$LOG" 2>&1 || {
E                 log "generated docs/skills sync failed"
E                 return 1
E               }
E             fi
E             if [[ -x "$source_dir/sync-skills.sh" ]]; then
E               log "syncing installed agent skills from $source_dir"
E               (cd "$source_dir" && ./sync-skills.sh) >> "$LOG" 2>&1 || {
E                 log "installed skill sync failed"
E                 return 1
E               }
E             else
E               log "sync-skills.sh missing or not executable in $source_dir; skipping installed skill symlinks"
E             fi
E             sync_extra_cloud_skills
E           }
E           
E           sync_extra_cloud_skills() {
E             if [[ ! -d "$EXTRA_SKILLS_DIR" ]]; then
E               log "extra cloud skills dir missing at $EXTRA_SKILLS_DIR; skipping"
E               return 0
E             fi
E           
E             local target_dirs=(
E               "$HOME/.claude/skills"
E               "$HOME/.codex/skills"
E               "$HOME/.agents/skills"
E               "$HOME/.hermes/skills"
E             )
E             local skill_dir name target_dir dest created skipped updated
E             created=0
E             skipped=0
E             updated=0
E             log "syncing extra cloud skills from $EXTRA_SKILLS_DIR"
E             for skill_dir in "$EXTRA_SKILLS_DIR"/*/; do
E               [[ -d "$skill_dir" && -f "$skill_dir/SKILL.md" ]] || continue
E               name="$(basename "$skill_dir")"
E               for target_dir in "${target_dirs[@]}"; do
E                 mkdir -p "$target_dir"
E                 dest="$target_dir/$name"
E                 if [[ -L "$dest" ]]; then
E                   ln -sfn "$skill_dir" "$dest"
E                   updated=$((updated + 1))
E                 elif [[ -e "$dest" ]]; then
E                   skipped=$((skipped + 1))
E                 else
E                   ln -s "$skill_dir" "$dest"
E                   created=$((created + 1))
E                 fi
E               done
E             done
E             log "extra cloud skills synced created=$created updated=$updated skipped=$skipped"
E           }
E           
E           sync_editable_source_branch() {
E             local report_items="$1"
E             if [[ "$SYNC_ENABLED" != "1" ]]; then
E               log "editable source sync disabled"
E               report_item "$report_items" "editable-install" "sync" "skipped" "sync disabled" "$SRC_DIR" "$SYNC_BRANCH"
E               return 0
E             fi
E             if [[ -z "$SYNC_BRANCH" ]]; then
E               log "editable source sync skipped; no branch configured"
E               report_item "$report_items" "editable-install" "sync" "sync_failed" "no sync branch configured" "$SRC_DIR"
E               return 1
E             fi
E           
E             ensure_editable_source_checkout || {
E               report_item "$report_items" "editable-install" "sync" "sync_failed" "source checkout unavailable" "$SRC_DIR" "$SYNC_BRANCH"
E               return 1
E             }
E           
E             if [[ ! -d "$SRC_DIR/.git" ]]; then
E               report_item "$report_items" "editable-install" "sync" "sync_failed" "source checkout missing git metadata" "$SRC_DIR" "$SYNC_BRANCH"
E               return 1
E             fi
E           
E             local before after status branch
E             before="$(cd "$SRC_DIR" && git rev-parse --short HEAD 2>/dev/null || true)"
E             log "syncing editable source branch=$SYNC_BRANCH dir=$SRC_DIR before=$before"
E             (
E               cd "$SRC_DIR" &&
E               git config --global --add safe.directory "$SRC_DIR" >/dev/null 2>&1 || authority_gap_continue "T29-BYPASS-136" "authority-risk bypass converted to typed evidence gap" &&
E               timeout "$SYNC_TIMEOUT_SECS" git fetch origin "$SYNC_BRANCH" --prune &&
E               branch="$(git branch --show-current)" &&
E               if [[ "$branch" != "$SYNC_BRANCH" ]]; then
E                 if [[ -n "$(git status --porcelain)" ]]; then
E                   echo "cannot switch from $branch to $SYNC_BRANCH: checkout has local changes" >&2
E                   exit 12
E                 fi
E                 git checkout "$SYNC_BRANCH"
E               fi &&
E               timeout "$SYNC_TIMEOUT_SECS" git pull --ff-only origin "$SYNC_BRANCH"
E             ) >> "$LOG" 2>&1 || {
E               log "editable source fetch/pull failed"
E               report_item "$report_items" "editable-install" "sync" "sync_failed" "fetch/pull failed" "$SRC_DIR" "$SYNC_BRANCH"
E               return 1
E             }
E           
E             sync_skills_in_source "$SRC_DIR" || {
E               report_item "$report_items" "editable-install" "sync" "sync_failed" "skill sync failed" "$SRC_DIR" "$SYNC_BRANCH"
E               return 1
E             }
E           
E             status="$(cd "$SRC_DIR" && git status --porcelain -- arnold_pipelines/megaplan/skills)"
E             if [[ -n "$status" ]]; then
E               log "committing editable skill sync drift"
E               (
E                 cd "$SRC_DIR" &&
E                 git add -A -- arnold_pipelines/megaplan/skills &&
E                 git commit -m "Sync cloud editable install and skills" &&
E                 timeout "$SYNC_TIMEOUT_SECS" git push origin "$SYNC_BRANCH"
E               ) >> "$LOG" 2>&1 || {
E                 log "editable skill sync commit/push failed"
E                 report_item "$report_items" "editable-install" "sync" "sync_failed" "skill sync commit/push failed" "$SRC_DIR" "$SYNC_BRANCH"
E                 return 1
E               }
E             else
E               log "editable source has no skill sync drift to push"
E             fi
E           
E             status="$(cd "$SRC_DIR" && git status --porcelain)"
E             if [[ -n "$status" ]]; then
E               log "editable source has non-sync drift; leaving uncommitted"
E               report_item "$report_items" "editable-install" "sync" "sync_dirty" "source checkout has non-sync drift; not auto-committing" "$SRC_DIR" "$SYNC_BRANCH"
E             fi
E           
E             refresh_editable_install || {
E               log "editable install refresh after sync failed"
E               report_item "$report_items" "editable-install" "sync" "sync_failed" "refresh failed" "$SRC_DIR" "$SYNC_BRANCH"
E               return 1
E             }
E           
E             after="$(cd "$SRC_DIR" && git rev-parse --short HEAD 2>/dev/null || true)"
E             report_item "$report_items" "editable-install" "sync" "synced" "editable source branch synced and refreshed ($before -> $after)" "$SRC_DIR" "$SYNC_BRANCH"
E           
E             # ── Codex 2026-08-17: fail-closed promotion transaction ────────────────
E             # Replace the unconditional auto-advance. Publication of source and
E             # activation of a runtime generation are ONE atomic transaction. On any
E             # failure the old generation G stays dispatchable; the checkout being at
E             # G+1 must NOT invalidate a running G.
E             if [[ -n "$before" && -n "$after" && "$before" != "$after" && -n "${ARNOLD_RUNTIME_MANIFEST:-}" && -f "${ARNOLD_RUNTIME_MANIFEST:-}" ]]; then
E               candidate_full="$(cd "$SRC_DIR" && git rev-parse "refs/remotes/origin/$SYNC_BRANCH" 2>/dev/null || true)"
E               local_head="$(cd "$SRC_DIR" && git rev-parse HEAD 2>/dev/null || true)"
E               if [[ -z "$candidate_full" || ${#candidate_full} -ne 40 ]]; then
E                 log "promotion refused: cannot resolve full SHA of refs/remotes/origin/$SYNC_BRANCH"
E               elif [[ "$local_head" != "$candidate_full" ]]; then
E                 log "promotion refused: local HEAD ($local_head) != origin/$SYNC_BRANCH ($candidate_full)"
E               elif [[ -n "$(cd "$SRC_DIR" && git status --porcelain)" ]]; then
E                 log "promotion refused: checkout is not clean"
E               else
E                 promotion_lock="${ARNOLD_RUNTIME_MANIFEST:-}.promotion.lock"
E                 (
E                   flock -x 9 || { log "promotion refused: could not acquire promotion lock"; exit 1; }
E                   PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$ARNOLD_RUNTIME_MANIFEST" "$candidate_full" "$SRC_DIR" "$before" "$after" <<'PY' >> "$LOG" 2>&1
E           import json, sys
E           from pathlib import Path
E           from arnold_pipelines.megaplan.cloud.runtime_manifest import (
E               ManifestError, advance_generation, load_manifest, write_active_pointer, active_manifest_path,
E           )
E           from arnold_pipelines.megaplan.cloud.install_sync import ensure_dependency_generation
E           
E           manifest_path, new_commit, runtime_root, before, after = sys.argv[1:6]
E           manifest = load_manifest(Path(manifest_path))
E           # no-op when already at the candidate generation
E           if str(manifest.epic.get("expected_head") or "") == new_commit:
E               print("promotion no-op: manifest already at", new_commit)
E               sys.exit(0)
E           # build/select the matching content-addressed dependency generation for the
E           # candidate checkout's frozen spec BEFORE advancing (fail-closed).
E           generations_root = Path(__import__("os").environ.get("ARNOLD_GENERATIONS_ROOT", "/workspace/.megaplan/generations"))
E           proof = ensure_dependency_generation(runtime_root, generations_root)
E           advanced = advance_generation(manifest, new_commit, reason=f"promotion after engine sync ({before} -> {after})", dependency_generation=proof)
E           pointer = active_manifest_path()
E           if Path(manifest_path).expanduser().resolve(strict=False) == pointer.expanduser().resolve(strict=False):
E               write_active_pointer(advanced, pointer)
E           else:
E               write_active_pointer(advanced, pointer)
E               from arnold_pipelines.megaplan.cloud.runtime_manifest import write_manifest
E               write_manifest(advanced, Path(manifest_path))
E           print("promotion advanced to generation", advanced.generation, "head", new_commit)
E           PY
E                   rc=$?
E                   if [[ $rc -eq 0 ]]; then
E                     log "manifest promotion succeeded after engine sync ($before -> $after)"
E                   else
E                     log "manifest promotion FAILED (rc=$rc) after engine sync; old generation stays dispatchable"
E                   fi
E                 ) 9>"${promotion_lock}"
E               fi
E             fi
E           }
E           
E           codex_repair_editable_install() {
E             local reason="$1"
E             if [[ "$REPAIR_ENABLED" != "1" ]]; then
E               log "editable install check failed; repair disabled (set ARNOLD_REPAIR_TRIGGER_ENABLED=1): $reason"
E               return 1
E             fi
E             if [[ ! -d "$SRC_DIR/.git" ]]; then
E               log "Codex repair skipped; source checkout missing at $SRC_DIR"
E               return 1
E             fi
E             if ! command -v codex >/dev/null 2>&1; then
E               log "Codex repair skipped; codex CLI unavailable"
E               return 1
E             fi
E           
E             local prompt reason_digest source_repair_id
E             prompt="$(mktemp)"
E             cat > "$prompt" <<EOF
E           You are running inside an Arnold cloud worker. The editable Arnold install failed this watchdog check:
E           
E           $reason
E           
E           Working directory: $SRC_DIR
E           
E           Fix only the Arnold source checkout so the cloud worker can import and run:
E           python3 -c "import arnold_pipelines.megaplan.cloud.cli"
E           
E           The editable install checkout must stay on branch $SYNC_BRANCH. Do not use
E           MEGAPLAN_REF or the active workflow checkout branch to choose the repair branch.
E           
E           Keep the patch narrowly scoped. Run the smallest relevant verification. Do not ask for input.
E           EOF
E             redact_file_in_place "$prompt"
E             reason_digest="$(printf '%s' "$reason" | sha256sum | awk '{print $1}')"
E             source_repair_id="watchdog-source-repair:${reason_digest}"
E           
E             log "starting Codex editable-install repair in $SRC_DIR"
E             # Step 57: managed-agent launches may NEVER become accepted repair outside
E             # canonical simple_fixer delegation.  Classify the launch before forking the
E             # Codex managed-agent process (SC38).
E             _child_gate_json="$(child_agent_launch_authority_or_reject live_watchdog arnold-watchdog)" || true
E             _child_gate_outcome="$(printf '%s' "$_child_gate_json" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("outcome",""))' 2>/dev/null || true)"
E             if [[ "$_child_gate_outcome" == "zero_authority_rejected" ]]; then
E               authority_fail_closed "T57-MANAGED-AGENT-FANOUT-01"
E               log "Codex editable-install managed-agent launch rejected by child-agent authority gate: $_child_gate_json"
E               return 1
E             fi
E             (
E               cd "$SRC_DIR" &&
E               python3 -m arnold_pipelines.megaplan.managed_agent run \
E                 --run-kind automatic_watchdog_source_repair \
E                 --identity-key "$source_repair_id" \
E                 --project-dir "$SRC_DIR" \
E                 --task-kind debugging \
E                 --difficulty 8 \
E                 --model "$CODEX_REPAIR_MODEL" \
E                 --reasoning-effort high \
E                 --route-class watchdog_editable_install_repair \
E                 --backend codex \
E                 --command-display "watchdog editable-install Codex repair" \
E                 --origin-kind watchdog_source_repair \
E                 --origin-id "$source_repair_id" \
E                 --origin-component arnold-watchdog \
E                 --trigger-id "$reason_digest" \
E                 --lineage-key watchdog-source-repair \
E                 --stdin-file "$prompt" \
E                 --require-output \
E                 --link phase=editable_install_repair \
E                 -- timeout "$CODEX_TIMEOUT" codex exec --sandbox danger-full-access \
E                   -c model="$CODEX_REPAIR_MODEL" -c model_reasoning_effort=high -
E             ) >> "$LOG" 2>&1
E             local rc=$?
E             rm -f "$prompt"
E             if [[ $rc -ne 0 ]]; then
E               log "Codex repair failed rc=$rc"
E               return "$rc"
E             fi
E           
E             if ! (cd "$SRC_DIR" && python3 - <<'PY' >> "$LOG" 2>&1
E           import arnold_pipelines.megaplan.cloud.cli  # noqa: F401
E           PY
E             ); then
E               log "Codex repair completed but import check still fails"
E               return 1
E             fi
E           
E             if (cd "$SRC_DIR" && git diff --quiet && git diff --cached --quiet); then
E               log "Codex repair produced no source changes"
E               return 0
E             fi
E           
E             (
E               cd "$SRC_DIR" &&
E               git add -A &&
E               git commit -m "Fix cloud editable install from watchdog"
E             ) >> "$LOG" 2>&1 || {
E               log "repair commit failed"
E               return 1
E             }
E           
E             if [[ "$PUSH_REPAIRS" == "1" ]]; then
E               log "pushing watchdog repair commit"
E               (cd "$SRC_DIR" && git push) >> "$LOG" 2>&1 || {
E                 log "repair push failed"
E                 return 1
E               }
E             else
E               log "repair committed locally; push disabled (set CLOUD_WATCHDOG_PUSH_REPAIRS=1)"
E             fi
E           }
E           
E           ensure_install_or_repair() {
E             local output
E             output="$(mktemp)"
E             if refresh_editable_install > "$output" 2>&1; then
E               cat "$output" >> "$LOG"
E               rm -f "$output"
E               return 0
E             fi
E             local reason
E             reason="$(cat "$output")"
E             cat "$output" >> "$LOG"
E             rm -f "$output"
E             codex_repair_editable_install "$reason"
E           }
E           
E           write_watchdog_observation_error() {
E             local reason="$1"
E             local status_dir="${2:-$STATUS_DIR}"
E             local stamp tmp target
E             mkdir -p "$status_dir" 2>/dev/null || return 1
E             stamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
E             target="$status_dir/watchdog-observation-failure.json"
E             tmp="$(mktemp "$status_dir/.watchdog-observation-failure.XXXXXX")" || return 1
E             printf '{"at":"%s","error":"watchdog observation bootstrap failed; watchdog report may be stale","reason":"observation_runtime_not_ready","schema_version":"arnold-watchdog-observation-failure-v1","status":"failed"}\n' \
E               "$stamp" > "$tmp"
E             mv -f "$tmp" "$target"
E             # Preserve the legacy consumer path with the same atomic payload.
E             tmp="$(mktemp "$status_dir/.cloud-status.write-error.XXXXXX")" || return 1
E             cp "$target" "$tmp"
E             mv -f "$tmp" "$status_dir/cloud-status.write-error.json"
E             log "watchdog observation failure persisted atomically: ${reason:-unknown}"
E           }
E           
E           write_watchdog_sweep_health() {
E             local phase="$1"
E             local status_dir="${2:-$STATUS_DIR}"
E             local target="$status_dir/watchdog-sweep.${phase}.json"
E             local tmp stamp
E             mkdir -p "$status_dir"
E             stamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
E             tmp="$(mktemp "$status_dir/.watchdog-sweep.${phase}.XXXXXX")" || return 1
E             printf '{"at":"%s","phase":"%s","schema_version":"arnold-watchdog-sweep-health-v1"}\n' \
E               "$stamp" "$phase" > "$tmp"
E             mv -f "$tmp" "$target"
E           }
E           
E           watchdog_observation_runtime_check() {
E             local output rc
E             output="$(mktemp)"
E             if ! PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - <<'PY' >"$output" 2>&1; then
E           import yaml  # noqa: F401
E           import arnold_pipelines.megaplan.cloud.cli  # noqa: F401
E           import arnold_pipelines.megaplan.cloud.status_snapshot  # noqa: F401
E           PY
E               cat "$output"
E               rm -f "$output"
E               return 1
E             fi
E             rm -f "$output"
E             return 0
E           }
E           
E           bootstrap_watchdog_observation() {
E             local report_items="$1"
E             local reason=""
E             WATCHDOG_BOOTSTRAP_RECOVERED=0
E             if reason="$(watchdog_observation_runtime_check 2>&1)"; then
E               return 0
E             fi
E             # Fail closed. Attempting pip/source repair from a blind observer caused the
E             # original boot/install race and could leave a live-but-sleeping watchdog.
E             reason="$(printf '%s' "$reason" | tr '\n' ' ' | sed 's/[[:space:]]\\+/ /g' | sed 's/^ //; s/ $//')"
E             [[ -n "$reason" ]] || reason="watchdog observation runtime check failed"
E             log "watchdog observation bootstrap failed closed: $reason"
E             report_item "$report_items" "watchdog" "observe" "observation_blind" "watchdog observation bootstrap failed closed: $reason" "$SRC_DIR" "$SYNC_BRANCH"
E             write_watchdog_observation_error "$reason"
E             return 1
E           }
E           
E           matching_runner_process_alive() {
E             local workspace="$1"
E             local remote_spec="$2"
E             local run_kind="${3:-chain}"
E             local plan_name="${4:-}"
E             PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$workspace" "$remote_spec" "$run_kind" "$plan_name" <<'PY'
E           import hashlib
E           import json
E           import os
E           import subprocess
E           import sys
E           from pathlib import Path
E           
E           workspace = Path(sys.argv[1])
E           remote_spec_raw = sys.argv[2]
E           run_kind = sys.argv[3]
E           plan_name = sys.argv[4]
E           
E           
E           def pid_alive(value: object) -> bool:
E               try:
E                   pid = int(value)
E               except (TypeError, ValueError):
E                   return False
E               if pid <= 0:
E                   return False
E               try:
E                   os.kill(pid, 0)
E               except OSError:
E                   return False
E               return True
E           
E           
E           def add_unique(values: list[str], value: object) -> None:
E               if isinstance(value, str):
E                   cleaned = value.strip()
E                   if cleaned and cleaned not in values:
E                       values.append(cleaned)
E           
E           
E           def load_json(path: Path) -> dict[str, object]:
E               try:
E                   payload = json.loads(path.read_text(encoding="utf-8"))
E               except Exception:
E                   return {}
E               return payload if isinstance(payload, dict) else {}
E           
E           
E           def process_matches() -> bool:
E               if run_kind not in {"chain", "epic_chain"} or not remote_spec_raw:
E                   return False
E               try:
E                   proc = subprocess.run(
E                       ["ps", "-eww", "-o", "pid=", "-o", "args="],
E                       check=False,
E                       capture_output=True,
E                       text=True,
E                   )
E               except Exception:
E                   return False
E               if proc.returncode != 0:
E                   return False
E               ignored_pids = {os.getpid(), os.getppid()}
E               command = "arnold_pipelines.megaplan chain start" if run_kind == "chain" else "arnold_pipelines.megaplan epic-chain start"
E               for line in proc.stdout.splitlines():
E                   stripped = line.strip()
E                   if not stripped:
E                       continue
E                   try:
E                       pid_text, args = stripped.split(None, 1)
E                       pid = int(pid_text)
E                   except (ValueError, TypeError):
E                       continue
E                   if pid in ignored_pids:
E                       continue
E                   if command in args and "--spec" in args and remote_spec_raw in args:
E                       return True
E               return False
E           
E           
E           if process_matches():
E               raise SystemExit(0)
E           
E           candidate_plans: list[str] = []
E           add_unique(candidate_plans, plan_name)
E           
E           if remote_spec_raw:
E               try:
E                   spec_path = Path(remote_spec_raw)
E                   try:
E                       spec_resolved = spec_path.resolve()
E                   except Exception:
E                       spec_resolved = spec_path
E                   digest = hashlib.sha1(str(spec_resolved).encode("utf-8")).hexdigest()[:12]
E                   chain_state_candidates = (
E                       workspace / ".megaplan" / "plans" / ".chains" / f"chain-{digest}.json",
E                       workspace / ".megaplan" / "plans" / ".chains" / f"{spec_resolved.stem}-{digest}.json",
E                       spec_resolved.parent / ".megaplan" / "plans" / ".chains" / f"chain-{digest}.json",
E                       spec_resolved.parent / ".megaplan" / "plans" / ".chains" / f"{spec_resolved.stem}-{digest}.json",
E                       spec_resolved.with_name("chain_state.json"),
E                   )
E                   for candidate in chain_state_candidates:
E                       if not candidate.exists():
E                           continue
E                       chain_state = load_json(candidate)
E                       add_unique(candidate_plans, chain_state.get("current_plan_name"))
E                       add_unique(candidate_plans, chain_state.get("plan_name"))
E                       break
E               except Exception:
E                   pass
E           
E           for current_plan in candidate_plans:
E               state_path = workspace / ".megaplan" / "plans" / current_plan / "state.json"
E               if not state_path.exists():
E                   continue
E               state = load_json(state_path)
E               active = state.get("active_step")
E               if isinstance(active, dict) and pid_alive(active.get("worker_pid")):
E                   raise SystemExit(0)
E           
E           raise SystemExit(1)
E           PY
E           }
E           
E           plan_process_is_alive() {
E             local plan_name="$1"
E             if [[ -z "$plan_name" ]]; then
E               return 1
E             fi
E             if ps -eww -o args= \
E               | grep -E "[p]ython[0-9.]*([[:space:]]+-P)?[[:space:]]+-m arnold_pipelines.megaplan (init|auto|resume|plan|prep|critique|revise|gate|finalize|execute|review)" \
E               | grep -Eq -- "(--plan[=[:space:]]$plan_name|--name[=[:space:]]$plan_name.*--auto-start|--auto-start.*--name[=[:space:]]$plan_name)"; then
E               return 0
E             fi
E             if ps -eww -o args= \
E               | grep -E "[a]rnold (auto|resume)|[m]egaplan (auto|resume)" \
E               | grep -Fq -- "--plan $plan_name"; then
E               return 0
E             fi
E             return 1
E           }
E           
E           chain_process_is_alive() {
E             local remote_spec="$1"
E             if [[ -z "$remote_spec" ]]; then
E               return 1
E             fi
E             if ps -eww -o args= \
E               | grep -E "[p]ython[0-9.]*([[:space:]]+-P)?[[:space:]]+-m arnold_pipelines.megaplan chain start" \
E               | grep -F -- "--spec" \
E               | grep -Fq -- "$remote_spec"; then
E               return 0
E             fi
E             return 1
E           }
E           
E           epic_chain_process_is_alive() {
E             local remote_spec="$1"
E             if [[ -z "$remote_spec" ]]; then
E               return 1
E             fi
E             if ps -eww -o args= \
E               | grep -E "[p]ython[0-9.]*([[:space:]]+-P)?[[:space:]]+-m arnold_pipelines.megaplan epic-chain start" \
E               | grep -F -- "--spec" \
E               | grep -Fq -- "$remote_spec"; then
E               return 0
E             fi
E             return 1
E           }
E           
E           session_health_status() {
E             local session="$1"
E             local workspace="$2"
E             local remote_spec="$3"
E             local run_kind="${4:-chain}"
E             local plan_name="${5:-}"
E             local wait_status
E             if ! tmux has-session -t "$session" 2>/dev/null; then
E               if matching_runner_process_alive "$workspace" "$remote_spec" "$run_kind" "$plan_name"; then
E                 echo "alive"
E                 return 0
E               fi
E               if [[ "$run_kind" == "chain" ]]; then
E                 if chain_process_is_alive "$remote_spec" || plan_process_is_alive "$plan_name"; then
E                   echo "alive"
E                   return 0
E                 fi
E                 wait_status="$(chain_wait_status "$workspace" "$remote_spec")"
E                 if [[ "$wait_status" != "none" ]]; then
E                   echo "$wait_status"
E                   return 0
E                 fi
E               elif [[ "$run_kind" == "epic_chain" ]]; then
E                 if epic_chain_process_is_alive "$remote_spec"; then
E                   echo "alive"
E                   return 0
E                 fi
E               elif [[ -n "$plan_name" ]] && plan_process_is_alive "$plan_name"; then
E                 echo "alive"
E                 return 0
E               fi
E               echo "stopped"
E               return 0
E             fi
E           
E             local pane log_path
E             pane="$(tmux capture-pane -pt "$session" -S -120 2>/dev/null || true)"
E             if printf '%s\n' "$pane" | grep -Eq 'cmd exited rc=[1-9]|error retry [0-9]+/[0-9]+'; then
E               echo "retrying_failure"
E               return 0
E             fi
E           
E             if [[ "$run_kind" == "chain" ]]; then
E               if [[ "$session" == "megaplan-chain" ]]; then
E                 log_path="$workspace/.megaplan/cloud-chain.log"
E               else
E                 log_path="$workspace/.megaplan/cloud-chain-${session}.log"
E               fi
E               if [[ -f "$log_path" ]] && tail -80 "$log_path" 2>/dev/null | grep -Eq '"error": "invalid_spec"|invalid_spec|"error": "git_refresh_failed"|git_refresh_failed|fatal: couldn'\''t find remote ref'; then
E                 echo "chain_log_failure"
E                 return 0
E               fi
E           
E               if chain_process_is_alive "$remote_spec"; then
E                 echo "alive"
E                 return 0
E               fi
E           
E               wait_status="$(chain_wait_status "$workspace" "$remote_spec")"
E               if [[ "$wait_status" != "none" ]]; then
E                 echo "$wait_status"
E                 return 0
E               fi
E             elif [[ "$run_kind" == "epic_chain" ]]; then
E               log_path="$workspace/.megaplan/cloud-epic-chain-${session}.log"
E               if [[ -f "$log_path" ]] && tail -80 "$log_path" 2>/dev/null | grep -Eq '"error": "invalid_spec"|invalid_spec|"error": "git_refresh_failed"|git_refresh_failed|fatal: couldn'\''t find remote ref'; then
E                 echo "chain_log_failure"
E                 return 0
E               fi
E           
E               if epic_chain_process_is_alive "$remote_spec"; then
E                 echo "alive"
E                 return 0
E               fi
E             elif [[ -n "$plan_name" ]]; then
E               if plan_process_is_alive "$plan_name"; then
E                 echo "alive"
E                 return 0
E               fi
E             fi
E           
E             echo "stopped"
E           }
E           
E           verify_relaunch_health() {
E             local session="$1"
E             local workspace="$2"
E             local remote_spec="$3"
E             local run_kind="${4:-chain}"
E             local plan_name="${5:-}"
E             local attempts="${6:-15}"
E             local health="stopped"
E             local attempt
E             for ((attempt = 1; attempt <= attempts; attempt++)); do
E               health="$(session_health_status "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name")"
E               case "$health" in
E                 alive|awaiting_pr_merge)
E                   printf '%s\n' "$health"
E                   return 0
E                   ;;
E                 chain_log_failure|retrying_failure)
E                   printf '%s\n' "$health"
E                   return 1
E                   ;;
E               esac
E               sleep 1
E             done
E             printf '%s\n' "$health"
E             return 1
E           }
E           
E           kimi_operator_running() {
E             local session="$1"
E             local pgid_path pgid
E             # The layered L1 repair-loop / kimi-goal-operator process scans were removed
E             # with the layered repair stack. The pgid marker (legacy dispatch custody)
E             # remains the liveness source for the Stage-0 marker state machine: any
E             # process group still alive under a recorded dispatch pgid counts as
E             # running.
E             pgid_path="$(kimi_pgid_path "$session")"
E             [[ -r "$pgid_path" ]] || return 1
E             read -r pgid < "$pgid_path" || return 1
E             [[ "$pgid" =~ ^[0-9]+$ ]] || return 1
E             if kill -0 "$pgid" >/dev/null 2>&1; then
E               return 0
E             fi
E             kill -0 -- "-$pgid" >/dev/null 2>&1 || return 1
E             if ps -eo pgid= 2>/dev/null \
E               | awk -v target="$pgid" '$1 == target { found=1 } END { exit found ? 0 : 1 }'; then
E               return 0
E             fi
E             return 1
E           }
E           
E           # Per-session repair-cycle marker. The watchdog sets it when a stopped session
E           # gets a mechanical relaunch; if the session re-stops before becoming healthy,
E           # the next tick escalates to the primary repair operator. The historical
E           # ".kimi-*" sidecars stay in place because the deduper/reaper already keys on
E           # them and the focused Kimi fallback reuses the same process-group tracking.
E           # Once repair is actually dispatched, its PGID sidecar distinguishes
E           # "repair currently/ran" from the mechanical-first stage.
E           # Cleared whenever the session is observed healthy or the direct relaunch
E           # fallback consumes the cycle after the repair operator exits without recovery.
E           kimi_dispatch_marker_path() {
E             printf '%s/%s.kimi-dispatch' "$MARKER_DIR" "$1"
E           }
E           
E           kimi_pgid_path() {
E             printf '%s/%s.kimi-pgid' "$MARKER_DIR" "$1"
E           }
E           
E           meta_dispatch_marker_path() {
E             printf '%s/%s.meta-dispatch' "$MARKER_DIR" "$1"
E           }
E           
E           meta_pgid_path() {
E             printf '%s/%s.meta-pgid' "$MARKER_DIR" "$1"
E           }
E           
E           session_marker_path() {
E             printf '%s/%s.json' "$MARKER_DIR" "$1"
E           }
E           
E           repair_progress_snapshot_path() {
E             printf '%s/%s.reap-progress.json' "$MARKER_DIR" "$1"
E           }
E           
E           repair_needs_human_path() {
E             printf '%s/%s.needs-human.json' "$REPAIR_DATA_DIR" "$1"
E           }
E           
E           chain_health_snapshot_path() {
E             printf '%s/%s.chain-health.progress.json' "$MARKER_DIR" "$1"
E           }
E           
E           chain_health_artifact_path() {
E             printf '%s/%s.chain-health.json' "$REPAIR_DATA_DIR" "$1"
E           }
E           
E           repair_needs_human_summary() {
E             local session="$1"
E             python3 - "$(repair_needs_human_path "$session")" <<'PY'
E           import json
E           import pathlib
E           import sys
E           
E           path = pathlib.Path(sys.argv[1])
E           try:
E               payload = json.loads(path.read_text(encoding="utf-8"))
E           except Exception:
E               print("repair loop exhausted; needs human")
E               raise SystemExit(0)
E           summary = payload.get("summary")
E           repair_data_path = payload.get("repair_data_path")
E           discord_status = payload.get("discord_status")
E           parts = []
E           if isinstance(summary, str) and summary:
E               parts.append(summary)
E           if isinstance(repair_data_path, str) and repair_data_path:
E               parts.append(f"repair_data={repair_data_path}")
E           if isinstance(discord_status, str) and discord_status:
E               parts.append(f"discord={discord_status}")
E           print("; ".join(parts) if parts else "repair loop exhausted; needs human")
E           PY
E           }
E           
E           repair_needs_human_matches_current_plan() {
E             local session="$1"
E             local current_plan="${2:-}"
E             python3 - "$(repair_needs_human_path "$session")" "$current_plan" <<'PY'
E           import json
E           import pathlib
E           import sys
E           
E           path = pathlib.Path(sys.argv[1])
E           current_plan = (sys.argv[2] or "").strip()
E           if not current_plan:
E               raise SystemExit(0)
E           try:
E               marker = json.loads(path.read_text(encoding="utf-8"))
E           except Exception:
E               raise SystemExit(0)
E           
E           plans: set[str] = set()
E           
E           def add(value: object) -> None:
E               if isinstance(value, str):
E                   value = value.strip()
E                   if value and "/" not in value:
E                       plans.add(value)
E           
E           def collect_from_context(context: object) -> None:
E               if not isinstance(context, dict):
E                   return
E               add(context.get("current_plan_name"))
E               chain_state = context.get("chain_state_summary")
E               if isinstance(chain_state, dict):
E                   add(chain_state.get("current_plan_name"))
E               current = context.get("current")
E               if isinstance(current, dict):
E                   add(current.get("milestone_or_plan"))
E                   add(current.get("current_plan_name"))
E           
E           for key in ("plan_name", "current_plan_name", "chain_current_plan_name", "milestone_or_plan"):
E               add(marker.get(key))
E           
E           collect_from_context(marker)
E           repair_data_path = marker.get("repair_data_path")
E           if isinstance(repair_data_path, str) and repair_data_path:
E               try:
E                   data = json.loads(pathlib.Path(repair_data_path).read_text(encoding="utf-8"))
E               except Exception:
E                   data = {}
E               if isinstance(data, dict):
E                   add(data.get("plan_name"))
E                   collect_from_context(data.get("current_failure_context"))
E                   iterations = data.get("iterations")
E                   if isinstance(iterations, list):
E                       for item in iterations[-3:]:
E                           if not isinstance(item, dict):
E                               continue
E                           add(item.get("plan_name"))
E                           collect_from_context(item)
E                           collect_from_context(item.get("failure_context"))
E                           collect_from_context(item.get("current_failure_context"))
E           
E           if plans and current_plan not in plans:
E               print(",".join(sorted(plans)))
E               raise SystemExit(1)
E           raise SystemExit(0)
E           PY
E           }
E           
E           repair_needs_human_should_remain_human() {
E             local session="$1"
E             local current_plan="${2:-}"
E             local needs_human_path
E             needs_human_path="$(repair_needs_human_path "$session")"
E             PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - \
E               "$session" "$current_plan" "$MARKER_DIR" "$REPAIR_DATA_DIR" "$needs_human_path" "${current_target_observation:-}" <<'PY' 2>>"${LOG:-/dev/null}"
E           import json
E           import pathlib
E           import sys
E           
E           from arnold_pipelines.megaplan.cloud.human_blockers import (
E               BlockerVerdict,
E               classify_needs_human_blocker,
E           )
E           
E           session, current_plan, marker_dir, repair_data_dir, needs_human_path, resolver_json = sys.argv[1:7]
E           path = pathlib.Path(needs_human_path)
E           try:
E               payload = json.loads(path.read_text(encoding="utf-8"))
E           except Exception as exc:
E               print(f"needs_human_fresh_classifier verdict=AMBIGUOUS_BLOCKER error={type(exc).__name__}", file=sys.stderr)
E               raise SystemExit(0)
E           
E           resolver_record = None
E           if resolver_json:
E               try:
E                   resolver_record = json.loads(resolver_json)
E               except Exception:
E                   resolver_record = None
E           
E           try:
E               classification = classify_needs_human_blocker(
E                   session,
E                   current_plan=current_plan,
E                   marker_dir=marker_dir,
E                   repair_data_dir=repair_data_dir,
E                   needs_human_path=path,
E                   needs_human_payload=payload if isinstance(payload, dict) else None,
E                   resolver_record=resolver_record if isinstance(resolver_record, dict) else None,
E               )
E           except Exception as exc:
E               print(f"needs_human_fresh_classifier verdict=AMBIGUOUS_BLOCKER error={type(exc).__name__}", file=sys.stderr)
E               raise SystemExit(0)
E           
E           print(f"needs_human_fresh_classifier verdict={classification.verdict.name}", file=sys.stderr)
E           plan_state_path = ""
E           if isinstance(classification.resolver_record, dict):
E               plan_state = classification.resolver_record.get("plan_state")
E               if isinstance(plan_state, dict):
E                   plan_state_path = str(plan_state.get("path") or "")
E           if plan_state_path:
E               try:
E                   plan_state_payload = json.loads(pathlib.Path(plan_state_path).read_text(encoding="utf-8"))
E               except Exception:
E                   plan_state_payload = {}
E               if isinstance(plan_state_payload, dict):
E                   latest_failure = plan_state_payload.get("latest_failure")
E                   failure_kind = ""
E                   if isinstance(latest_failure, dict):
E                       failure_kind = str(latest_failure.get("kind") or "")
E                   if failure_kind in {"execution_blocked", "blocked_recovery_not_resolved"}:
E                       print(f"needs_human_fresh_classifier repairable_failure={failure_kind}", file=sys.stderr)
E                       raise SystemExit(1)
E           if classification.verdict in {BlockerVerdict.TRUE_BLOCKER, BlockerVerdict.AMBIGUOUS_BLOCKER}:
E               raise SystemExit(0)
E           raise SystemExit(1)
E           PY
E           }
E           
E           workspace_has_other_alive_session() {
E             local session="$1"
E             local workspace="$2"
E             local candidates other_session other_workspace other_remote_spec other_run_kind other_plan_name other_health
E             candidates="$(PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$MARKER_DIR" "$session" "$workspace" <<'PY'
E           import json
E           import pathlib
E           import sys
E           
E           from arnold_pipelines.megaplan.cloud.session_markers import is_canonical_session_marker_path
E           
E           marker_dir = pathlib.Path(sys.argv[1])
E           session = sys.argv[2]
E           workspace = sys.argv[3]
E           for path in sorted(marker_dir.glob("*.json")):
E               if not is_canonical_session_marker_path(path):
E                   continue
E               try:
E                   payload = json.loads(path.read_text(encoding="utf-8"))
E               except Exception:
E                   continue
E               other_session = payload.get("session")
E               other_workspace = payload.get("workspace")
E               if not isinstance(other_session, str) or not isinstance(other_workspace, str):
E                   continue
E               if other_session == session or other_workspace != workspace:
E                   continue
E               remote_spec = payload.get("remote_spec")
E               if not isinstance(remote_spec, str) or not remote_spec:
E                   continue
E               run_kind = payload.get("run_kind")
E               plan_name = payload.get("plan_name")
E               print("\t".join([
E                   other_session,
E                   other_workspace,
E                   remote_spec,
E                   run_kind if isinstance(run_kind, str) and run_kind else "chain",
E                   plan_name if isinstance(plan_name, str) else "",
E               ]))
E           PY
E           )"
E             while IFS=$'\t' read -r other_session other_workspace other_remote_spec other_run_kind other_plan_name; do
E               [[ -n "${other_session:-}" ]] || continue
E               other_health="$(session_health_status "$other_session" "$other_workspace" "$other_remote_spec" "${other_run_kind:-chain}" "${other_plan_name:-}")"
E               if [[ "$other_health" == "alive" || "$other_health" == "awaiting_pr_merge" ]]; then
E                 printf '%s:%s\n' "$other_session" "$other_health"
E                 return 0
E               fi
E             done <<< "$candidates"
E             return 1
E           }
E           
E           chain_health_status() {
E             local session="$1"
E             local workspace="$2"
E             local remote_spec_path="$3"
E             local health="${4:-unknown}"
E             CHAIN_HEALTH_STATUS="ok"
E             CHAIN_HEALTH_KIND=""
E             CHAIN_HEALTH_SUMMARY=""
E             CHAIN_HEALTH_ARTIFACT_PATH=""
E             CHAIN_HEALTH_STATE_PATH=""
E             CHAIN_HEALTH_LOG_PATH=""
E             CHAIN_HEALTH_LOG_MESSAGE=""
E             eval "$(python3 - "$session" "$workspace" "$remote_spec_path" "$health" "$MARKER_DIR" "$REPAIR_DATA_DIR" <<'PY'
E           import collections
E           import datetime as dt
E           import hashlib
E           import json
E           import os
E           import re
E           import shlex
E           import subprocess
E           import sys
E           from pathlib import Path
E           
E           from arnold_pipelines.megaplan.watchdog.signals import compute_signal_bundle
E           
E           session = sys.argv[1]
E           workspace = Path(sys.argv[2])
E           remote_spec_raw = sys.argv[3]
E           health = sys.argv[4]
E           marker_dir = Path(sys.argv[5])
E           repair_data_dir = Path(sys.argv[6])
E           
E           CYCLE_REPEATS = max(2, int(os.environ.get("CLOUD_WATCHDOG_CHAIN_CYCLE_REPEATS", "3")))
E           STUCK_TICKS = max(2, int(os.environ.get("CLOUD_WATCHDOG_CHAIN_STUCK_TICKS", "3")))
E           NO_ADVANCE_TICKS = max(
E               2,
E               int(os.environ.get("CLOUD_WATCHDOG_CHAIN_NO_ADVANCE_TICKS", os.environ.get("CLOUD_WATCHDOG_CHAIN_STUCK_TICKS", "3"))),
E           )
E           GUARD_REPEATS = max(
E               2,
E               int(
E                   os.environ.get(
E                       "CLOUD_WATCHDOG_CHAIN_COMPLETION_GUARD_REPEATS",
E                       os.environ.get("CLOUD_WATCHDOG_CHAIN_CYCLE_REPEATS", "3"),
E                   )
E               ),
E           )
E           LOG_WINDOW = max(120, int(os.environ.get("CLOUD_WATCHDOG_CHAIN_LOG_WINDOW_LINES", "1500")))
E           NONTERMINAL_STATES = {"authority_divergence", "blocked", "error", "awaiting_human", "between_milestones"}
E           STOPPED_COMPLETION_GUARD_STATES = {"authority_divergence", "blocked", "error"}
E           
E           
E           def emit(name: str, value: str) -> None:
E               print(f"{name}={shlex.quote(value)}")
E           
E           
E           def safe_session_name(raw: str) -> str:
E               cleaned = re.sub(r"[^A-Za-z0-9_.-]+", "-", raw).strip("-")
E               return cleaned or "chain"
E           
E           
E           def clear_artifact(path: Path) -> None:
E               try:
E                   path.unlink()
E               except FileNotFoundError:
E                   return
E               except Exception:
E                   return
E           
E           
E           def load_json(path: Path) -> dict[str, object]:
E               try:
E                   raw = json.loads(path.read_text(encoding="utf-8"))
E               except Exception:
E                   return {}
E               return raw if isinstance(raw, dict) else {}
E           
E           
E           def resolve_chain_state_path() -> Path | None:
E               candidates: list[Path] = []
E               if remote_spec_raw:
E                   try:
E                       spec_path = Path(remote_spec_raw)
E                       if not spec_path.is_absolute():
E                           spec_path = workspace / spec_path
E                       try:
E                           spec_resolved = spec_path.resolve()
E                       except Exception:
E                           spec_resolved = spec_path
E                       digest = hashlib.sha1(str(spec_resolved).encode("utf-8")).hexdigest()[:12]
E                       candidates.extend(
E                           [
E                               workspace / ".megaplan" / "plans" / ".chains" / f"chain-{digest}.json",
E                               workspace / ".megaplan" / "plans" / ".chains" / f"{spec_resolved.stem}-{digest}.json",
E                               spec_resolved.parent / ".megaplan" / "plans" / ".chains" / f"chain-{digest}.json",
E                               spec_resolved.parent / ".megaplan" / "plans" / ".chains" / f"{spec_resolved.stem}-{digest}.json",
E                               spec_resolved.with_name("chain_state.json"),
E                           ]
E                       )
E                   except Exception:
E                       pass
E               fallback: list[Path] = []
E               for glob_pat in (
E                   ".megaplan/plans/.chains/*.json",
E                   ".megaplan/initiatives/*/.megaplan/plans/.chains/*.json",
E                   ".megaplan/**/chain_state.json",
E               ):
E                   try:
E                       fallback.extend(workspace.glob(glob_pat))
E                   except Exception:
E                       continue
E               candidates.extend(sorted(set(fallback), key=lambda path: path.stat().st_mtime, reverse=True))
E               for candidate in candidates:
E                   if not candidate.exists():
E                       continue
E                   payload = load_json(candidate)
E                   if payload:
E                       return candidate
E               return None
E           
E           
E           def resolve_spec_path() -> Path | None:
E               if not remote_spec_raw:
E                   return None
E               try:
E                   spec_path = Path(remote_spec_raw)
E                   if not spec_path.is_absolute():
E                       spec_path = workspace / spec_path
E                   try:
E                       return spec_path.resolve()
E                   except Exception:
E                       return spec_path
E               except Exception:
E                   return None
E           
E           
E           def spec_milestone_labels() -> tuple[list[str], bool]:
E               spec_path = resolve_spec_path()
E               if spec_path is None:
E                   return [], False
E               try:
E                   raw = spec_path.read_text(encoding="utf-8")
E               except Exception:
E                   return [], False
E               try:
E                   import yaml  # type: ignore
E           
E                   data = yaml.safe_load(raw)
E                   milestones = data.get("milestones") if isinstance(data, dict) else None
E                   if isinstance(milestones, list):
E                       labels: list[str] = []
E                       for item in milestones:
E                           if not isinstance(item, dict):
E                               continue
E                           label = item.get("label")
E                           if isinstance(label, str) and label:
E                               labels.append(label)
E                       return labels, True
E               except Exception:
E                   pass
E               labels = []
E               in_milestones = False
E               for line in raw.splitlines():
E                   if re.match(r"^milestones:\s*$", line):
E                       in_milestones = True
E                       continue
E                   if in_milestones and re.match(r"^[A-Za-z_][\w-]*:", line):
E                       break
E                   match = re.match(r"^\s*-\s*label:\s*['\"]?([^'\"\s#]+)", line)
E                   if in_milestones and match:
E                       labels.append(match.group(1))
E               return labels, True
E           
E           
E           def chain_state_is_complete(chain_state: dict[str, object]) -> tuple[bool, int]:
E               labels, spec_known = spec_milestone_labels()
E               milestone_count = len(labels)
E               completed = chain_state.get("completed")
E               completed_list = completed if isinstance(completed, list) else []
E               completed_labels = {
E                   item.get("label")
E                   for item in completed_list
E                   if isinstance(item, dict) and isinstance(item.get("label"), str)
E               }
E               try:
E                   current_index = int(chain_state.get("current_milestone_index") or 0)
E               except Exception:
E                   current_index = 0
E               if spec_known and milestone_count == 0:
E                   return True, milestone_count
E               if not spec_known:
E                   return False, milestone_count
E               return current_index >= milestone_count or set(labels).issubset(completed_labels), milestone_count
E           
E           
E           def resolve_chain_log_path() -> Path | None:
E               candidates = []
E               if session == "megaplan-chain":
E                   candidates.append(workspace / ".megaplan" / "cloud-chain.log")
E               else:
E                   candidates.extend(
E                       [
E                           workspace / ".megaplan" / f"cloud-chain-{session}.log",
E                           workspace / ".megaplan" / "cloud-chain.log",
E                       ]
E                   )
E               for candidate in candidates:
E                   if candidate.exists():
E                       return candidate
E               return None
E           
E           
E           def read_tail_lines(path: Path | None, *, max_lines: int) -> list[str]:
E               if path is None or not path.exists():
E                   return []
E               try:
E                   with path.open("r", encoding="utf-8", errors="replace") as handle:
E                       return list(collections.deque((line.rstrip("\n") for line in handle), maxlen=max_lines))
E               except Exception:
E                   return []
E           
E           
E           def run_git(args: list[str], *, timeout: int = 15) -> subprocess.CompletedProcess[str] | None:
E               try:
E                   return subprocess.run(
E                       ["git", *args],
E                       cwd=str(workspace),
E                       text=True,
E                       capture_output=True,
E                       timeout=timeout,
E                       check=False,
E                   )
E               except (OSError, subprocess.TimeoutExpired):
E                   return None
E           
E           
E           def first_string(*values: object) -> str:
E               for value in values:
E                   if isinstance(value, str) and value.strip():
E                       return value.strip()
E               return ""
E           
E           
E           def milestone_base_sha_from_state_or_reason(plan_state: dict[str, object], reason: str) -> str:
E               meta = plan_state.get("meta")
E               chain_policy = meta.get("chain_policy") if isinstance(meta, dict) else None
E               if isinstance(chain_policy, dict):
E                   value = first_string(chain_policy.get("milestone_base_sha"))
E                   if value:
E                       return value
E               value = first_string(chain_state.get("current_milestone_base_sha"))
E               if value:
E                   return value
E               match = re.search(r"\bmilestone_base_sha\s+([0-9a-fA-F]{7,40})\b", reason)
E               if match:
E                   return match.group(1)
E               return ""
E           
E           
E           def completion_guard_advancement(base_sha: str, previous_snapshot: dict[str, object]) -> dict[str, object]:
E               if not base_sha:
E                   return {"available": False, "reason": "missing_milestone_base_sha"}
E               inside = run_git(["rev-parse", "--is-inside-work-tree"])
E               if inside is None:
E                   return {"available": False, "base_sha": base_sha, "reason": "git_unavailable"}
E               if inside.returncode != 0 or inside.stdout.strip().lower() != "true":
E                   return {"available": False, "base_sha": base_sha, "reason": "not_git_worktree"}
E               head = run_git(["rev-parse", "HEAD"])
E               if head is None:
E                   return {"available": False, "base_sha": base_sha, "reason": "git_head_unavailable"}
E               if head.returncode != 0:
E                   return {
E                       "available": False,
E                       "base_sha": base_sha,
E                       "reason": "git_head_failed",
E                       "stderr": (head.stderr or "").strip()[-500:],
E                   }
E               rev_list = run_git(["rev-list", "--count", f"{base_sha}..HEAD"])
E               if rev_list is None:
E                   return {
E                       "available": False,
E                       "base_sha": base_sha,
E                       "head": head.stdout.strip(),
E                       "reason": "git_rev_list_unavailable",
E                   }
E               if rev_list.returncode != 0:
E                   return {
E                       "available": False,
E                       "base_sha": base_sha,
E                       "head": head.stdout.strip(),
E                       "reason": "git_rev_list_failed",
E                       "stderr": (rev_list.stderr or "").strip()[-500:],
E                   }
E               try:
E                   ahead_count = int(rev_list.stdout.strip())
E               except ValueError:
E                   return {
E                       "available": False,
E                       "base_sha": base_sha,
E                       "head": head.stdout.strip(),
E                       "reason": "git_rev_list_non_integer",
E                       "stdout": (rev_list.stdout or "").strip()[-120:],
E                   }
E               return {
E                   "available": True,
E                   "base_sha": base_sha,
E                   "head": head.stdout.strip(),
E                   "ahead_count": ahead_count,
E                   "zero_advancement": ahead_count == 0,
E                   "command": f"git rev-list --count {base_sha}..HEAD",
E               }
E           
E           
E           def working_tree_status() -> dict[str, object]:
E               status = run_git(["status", "--porcelain"])
E               if status is None:
E                   return {"available": False, "reason": "git_status_unavailable"}
E               if status.returncode != 0:
E                   return {
E                       "available": False,
E                       "reason": "git_status_failed",
E                       "stderr": (status.stderr or "").strip()[-500:],
E                   }
E               lines = [line for line in (status.stdout or "").splitlines() if line.strip()]
E               non_megaplan_lines: list[str] = []
E               for line in lines:
E                   path = line[3:] if len(line) >= 4 else line
E                   if " -> " in path:
E                       path = path.rsplit(" -> ", 1)[-1]
E                   path = path.strip().strip('"')
E                   if path == ".megaplan" or path.startswith(".megaplan/"):
E                       continue
E                   non_megaplan_lines.append(line)
E               return {
E                   "available": True,
E                   "dirty": bool(non_megaplan_lines),
E                   "uncommitted_file_count": len(non_megaplan_lines),
E                   "sample": non_megaplan_lines[:12],
E                   "raw_uncommitted_file_count": len(lines),
E                   "command": "git status --porcelain",
E               }
E           
E           
E           def state_fallback_zero_advancement(previous_snapshot: dict[str, object]) -> dict[str, object]:
E               if not previous_snapshot:
E                   return {
E                       "used": True,
E                       "zero_advancement": None,
E                       "reason": "no_previous_snapshot_for_state_fallback",
E                   }
E               previous_completed = int(previous_snapshot.get("completed_count") or -1)
E               previous_index = int(previous_snapshot.get("current_milestone_index") or -1)
E               zero = previous_completed == completed_count and previous_index == current_index
E               return {
E                   "used": True,
E                   "zero_advancement": zero,
E                   "reason": "git_unavailable; falling back to state-file completed-count/current-index",
E                   "previous_completed_count": previous_completed,
E                   "current_completed_count": completed_count,
E                   "previous_milestone_index": previous_index,
E                   "current_milestone_index": current_index,
E               }
E           
E           
E           artifact_path = repair_data_dir / f"{safe_session_name(session)}.chain-health.json"
E           snapshot_path = marker_dir / f"{safe_session_name(session)}.chain-health.progress.json"
E           marker_dir.mkdir(parents=True, exist_ok=True)
E           repair_data_dir.mkdir(parents=True, exist_ok=True)
E           
E           chain_state_path = resolve_chain_state_path()
E           chain_state = load_json(chain_state_path) if chain_state_path is not None else {}
E           chain_log_path = resolve_chain_log_path()
E           log_lines = read_tail_lines(chain_log_path, max_lines=LOG_WINDOW)
E           current_plan_name = str(chain_state.get("current_plan_name") or "").strip()
E           last_state = str(chain_state.get("last_state") or "").strip()
E           pr_state = str(chain_state.get("pr_state") or "").strip()
E           pr_number = chain_state.get("pr_number")
E           current_index = int(chain_state.get("current_milestone_index") or 0)
E           completed = chain_state.get("completed")
E           completed_list = completed if isinstance(completed, list) else []
E           completed_count = len(completed_list)
E           chain_complete, milestone_count = chain_state_is_complete(chain_state)
E           
E           plan_dir = workspace / ".megaplan" / "plans" / current_plan_name if current_plan_name else None
E           plan_state_path = plan_dir / "state.json" if plan_dir is not None else None
E           plan_state = load_json(plan_state_path) if plan_state_path is not None else {}
E           plan_current_state = str(plan_state.get("current_state") or "").strip()
E           active_step = plan_state.get("active_step")
E           plan_has_active_step = isinstance(active_step, dict) and bool(active_step.get("phase") or active_step.get("worker_pid"))
E           plan_signal_liveness = ""
E           plan_signal_reason = ""
E           plan_has_in_flight_llm = False
E           if plan_dir is not None and plan_dir.exists():
E               try:
E                   signal_bundle = compute_signal_bundle(plan_dir, plan_state if isinstance(plan_state, dict) else None)
E                   plan_signal_liveness = str(signal_bundle.liveness or "").strip()
E                   plan_signal_reason = str(signal_bundle.liveness_reason or "").strip()
E                   plan_has_in_flight_llm = bool(signal_bundle.has_in_flight_llm)
E               except Exception:
E                   pass
E           plan_has_live_activity = plan_has_active_step or plan_signal_liveness == "progressing" or plan_has_in_flight_llm
E           plan_state_nonterminal = bool(plan_current_state) and plan_current_state not in {
E               "done",
E               "aborted",
E               "cancelled",
E               "failed",
E           }
E           plan_projected_nonterminal = (
E               bool(current_plan_name)
E               and not plan_has_live_activity
E               and plan_state_nonterminal
E               and (
E                   (last_state in {"blocked", "awaiting_human"} and plan_current_state == last_state)
E                   or (last_state in NONTERMINAL_STATES and plan_current_state != last_state)
E               )
E           )
E           events_path = plan_dir / "events.ndjson" if plan_dir is not None else None
E           events_exists = events_path is not None and events_path.exists()
E           events_mtime = events_path.stat().st_mtime if events_exists else 0.0
E           events_size = events_path.stat().st_size if events_exists else 0
E           
E           previous = load_json(snapshot_path)
E           stuck_ticks = 1 if last_state in NONTERMINAL_STATES else 0
E           if (
E               previous
E               and last_state in NONTERMINAL_STATES
E               and previous.get("last_state") == last_state
E               and int(previous.get("current_milestone_index") or -1) == current_index
E               and int(previous.get("completed_count") or -1) == completed_count
E           ):
E               stuck_ticks = int(previous.get("stuck_ticks") or 0) + 1
E           
E           no_advance_ticks = 0
E           events_advanced = False
E           if previous:
E               prev_events_mtime = float(previous.get("events_mtime") or 0.0)
E               prev_events_size = int(previous.get("events_size") or 0)
E               events_advanced = events_exists and (
E                   events_mtime > prev_events_mtime or events_size > prev_events_size
E               )
E               if (
E                   events_advanced
E                   and not plan_has_live_activity
E                   and int(previous.get("current_milestone_index") or -1) == current_index
E                   and int(previous.get("completed_count") or -1) == completed_count
E               ):
E                   no_advance_ticks = int(previous.get("no_advance_ticks") or 0) + 1
E           
E           snapshot = {
E               "session": session,
E               "current_plan_name": current_plan_name,
E               "last_state": last_state,
E               "current_milestone_index": current_index,
E               "completed_count": completed_count,
E               "milestone_count": milestone_count,
E               "chain_complete": chain_complete,
E               "pr_state": pr_state,
E               "pr_number": pr_number,
E               "events_mtime": events_mtime,
E               "events_size": events_size,
E               "plan_has_active_step": plan_has_active_step,
E               "plan_has_live_activity": plan_has_live_activity,
E               "plan_signal_liveness": plan_signal_liveness,
E               "plan_signal_reason": plan_signal_reason,
E               "plan_has_in_flight_llm": plan_has_in_flight_llm,
E               "stuck_ticks": stuck_ticks,
E               "no_advance_ticks": no_advance_ticks,
E               "updated_at": dt.datetime.now(dt.timezone.utc).isoformat(),
E           }
E           try:
E               snapshot_path.write_text(json.dumps(snapshot, indent=2, sort_keys=True) + "\n", encoding="utf-8")
E           except Exception:
E               pass
E           
E           skip_detection = (
E               health == "awaiting_pr_merge"
E               or last_state == "awaiting_pr_merge"
E               or (last_state in {"done", "complete"} and chain_complete)
E               or not chain_state
E           )
E           if skip_detection:
E               clear_artifact(artifact_path)
E               emit("CHAIN_HEALTH_STATUS", "ok")
E               emit("CHAIN_HEALTH_KIND", "")
E               emit("CHAIN_HEALTH_SUMMARY", "")
E               emit("CHAIN_HEALTH_ARTIFACT_PATH", "")
E               emit("CHAIN_HEALTH_STATE_PATH", str(chain_state_path) if chain_state_path is not None else "")
E               emit("CHAIN_HEALTH_LOG_PATH", str(chain_log_path) if chain_log_path is not None else "")
E               emit("CHAIN_HEALTH_LOG_MESSAGE", "")
E               raise SystemExit(0)
E           
E           merged_counts: collections.Counter[str] = collections.Counter()
E           merged_examples: dict[str, str] = {}
E           guard_counts: collections.Counter[str] = collections.Counter()
E           guard_examples: dict[str, str] = {}
E           guard_reasons: dict[str, str] = {}
E           guard_kinds: dict[str, str] = {}
E           interesting_lines: list[str] = []
E           merged_pattern = re.compile(r"^\[chain\] PR #(?P<pr>\d+) merged; advancing past (?P<milestone>.+)$")
E           guard_pattern = re.compile(r"^\[chain\] completion guard blocked (?P<milestone>[^:]+): (?P<reason>.+)$")
E           pr_progression_guard_pattern = re.compile(r"^\[chain\] PR progression blocked (?P<milestone>[^:]+): (?P<reason>.+)$")
E           
E           for raw_line in log_lines:
E               line = raw_line.strip()
E               if not line:
E                   continue
E               merged_match = merged_pattern.match(line)
E               if merged_match:
E                   milestone = merged_match.group("milestone").strip()
E                   merged_counts[milestone] += 1
E                   merged_examples.setdefault(milestone, line)
E                   interesting_lines.append(line)
E                   continue
E               guard_kind = "completion_guard"
E               guard_match = guard_pattern.match(line)
E               if not guard_match:
E                   guard_match = pr_progression_guard_pattern.match(line)
E                   if guard_match:
E                       guard_kind = "pr_progression"
E               if guard_match:
E                   milestone = guard_match.group("milestone").strip()
E                   guard_counts[milestone] += 1
E                   guard_examples.setdefault(milestone, line)
E                   guard_reasons[milestone] = guard_match.group("reason").strip()
E                   guard_kinds[milestone] = guard_kind
E                   interesting_lines.append(line)
E                   continue
E               if "authority_divergence" in line or '"last_state": "authority_divergence"' in line:
E                   interesting_lines.append(line)
E           
E           latest_failure = plan_state.get("latest_failure")
E           latest_failure = latest_failure if isinstance(latest_failure, dict) else {}
E           large_file_signal_text = "\n".join(
E               [
E                   "\n".join(log_lines[-80:]),
E                   str(latest_failure.get("kind") or ""),
E                   str(latest_failure.get("message") or ""),
E                   json.dumps(latest_failure.get("metadata") or {}, sort_keys=True),
E               ]
E           ).lower()
E           has_large_file_push_rejection = (
E               last_state == "failed"
E               and (
E                   "phase-complete callback failed" in large_file_signal_text
E                   or "phase_callback_failed" in large_file_signal_text
E               )
E               and "git push" in large_file_signal_text
E               and (
E                   "gh001" in large_file_signal_text
E                   or "large files detected" in large_file_signal_text
E                   or "exceeds github" in large_file_signal_text
E                   or "exceeds file size limit" in large_file_signal_text
E                   or "100.00 mb" in large_file_signal_text
E               )
E           )
E           
E           status = "ok"
E           issue_kind = ""
E           summary = ""
E           recurring_lines: list[str] = []
E           evidence_extra_lines: list[str] = []
E           completion_guard = {
E               "milestone": "",
E               "reason": "",
E               "repeat_count": 0,
E           }
E           details: dict[str, object] = {}
E           chain_health_log_message = ""
E           completion_guard_repair_eligible = False
E           
E           if last_state in {"done", "complete"} and not chain_complete:
E               status = "chain_inconsistent_done"
E               issue_kind = "chain_inconsistent_done"
E               summary = (
E                   f"chain state advertises last_state={last_state} but only "
E                   f"{completed_count}/{milestone_count or '?'} milestones are complete; "
E                   "treating as incomplete/stuck instead of terminal"
E               )
E               chain_health_log_message = (
E                   "CHAIN HEALTH EVIDENCE: chain last_state is terminal-looking but "
E                   "completed milestones do not cover the chain spec."
E               )
E           
E           if status == "ok" and has_large_file_push_rejection:
E               status = "chain_large_file_push_rejection"
E               issue_kind = "git_large_file_push_rejection"
E               recurring_lines = [
E                   line
E                   for line in log_lines[-40:]
E                   if (
E                       "GH001" in line
E                       or "Large files detected" in line
E                       or "exceeds GitHub" in line
E                       or "100.00 MB" in line
E                       or "phase-complete callback failed" in line
E                       or "git push" in line
E                   )
E               ]
E               summary = (
E                   "chain failed after a successful phase because the post-phase git push was rejected "
E                   "for an oversized runtime journal; exclude .megaplan runtime event logs from commits "
E                   "and replay the post-phase publish/chain transition"
E               )
E               chain_health_log_message = (
E                   "CHAIN HEALTH EVIDENCE: git push rejected by GitHub large-file limit after phase callback; "
E                   "runtime journals such as .megaplan/epics/*/events.jsonl must not be pushed"
E               )
E               evidence_extra_lines.append(
E                   "- Large-file push rejection: GitHub rejected the milestone branch because a runtime journal exceeded the file-size limit. "
E                   "Exclude runtime journals from chain commits and replay the post-phase transition."
E               )
E               details = {
E                   "latest_failure_kind": latest_failure.get("kind") or "",
E                   "latest_failure_message": latest_failure.get("message") or "",
E                   "runtime_journal_patterns": [
E                       ".megaplan/epics/*/events.jsonl",
E                       ".megaplan/plans/*/events.ndjson",
E                       ".megaplan/plans/*/execution_trace.jsonl",
E                   ],
E               }
E           
E           cycle_milestone = next(
E               (
E                   milestone
E                   for milestone, repeat_count in merged_counts.items()
E                   if repeat_count >= CYCLE_REPEATS and guard_counts.get(milestone, 0) >= CYCLE_REPEATS
E               ),
E               "",
E           )
E           if cycle_milestone:
E               status = "chain_cycle"
E               issue_kind = "chain_cycle"
E               repeat_count = min(merged_counts[cycle_milestone], guard_counts[cycle_milestone])
E               recurring_lines = [
E                   merged_examples.get(cycle_milestone, ""),
E                   guard_examples.get(cycle_milestone, ""),
E               ]
E               completion_guard = {
E                   "milestone": cycle_milestone,
E                   "reason": guard_reasons.get(cycle_milestone, ""),
E                   "repeat_count": repeat_count,
E               }
E               summary = (
E                   f"chain-layer cycle on {cycle_milestone}: merged PR/completion-guard pattern repeated "
E                   f"{repeat_count}x; do not route to plan repair"
E               )
E               details = {
E                   "cycle_milestone": cycle_milestone,
E                   "merged_repeats": merged_counts[cycle_milestone],
E                   "completion_guard_repeats": guard_counts[cycle_milestone],
E               }
E           if status == "ok" and guard_counts:
E               guard_milestone, guard_repeat_count = max(guard_counts.items(), key=lambda item: item[1])
E               if guard_repeat_count >= GUARD_REPEATS:
E                   status = "chain_completion_guard_rejections"
E                   issue_kind = "chain_completion_guard_rejections"
E                   recurring_lines = [guard_examples.get(guard_milestone, "")]
E                   completion_guard = {
E                       "milestone": guard_milestone,
E                       "reason": guard_reasons.get(guard_milestone, ""),
E                       "repeat_count": guard_repeat_count,
E                       "kind": guard_kinds.get(guard_milestone, "completion_guard"),
E                   }
E                   summary = (
E                       f"chain completion guard rejected {guard_milestone} {guard_repeat_count}x; "
E                       "plan repair loop will not fix a chain-driver completion pathology"
E                   )
E                   details = {
E                       "completion_guard_repeats": guard_repeat_count,
E                       "completion_guard_kind": guard_kinds.get(guard_milestone, "completion_guard"),
E                   }
E           
E           if status in {"chain_cycle", "chain_completion_guard_rejections"}:
E               guard_milestone = str(completion_guard.get("milestone") or "")
E               guard_reason = str(completion_guard.get("reason") or "")
E               guard_repeat_count = int(completion_guard.get("repeat_count") or 0)
E               base_sha = milestone_base_sha_from_state_or_reason(plan_state, guard_reason)
E               advancement_check = completion_guard_advancement(base_sha, previous)
E               worktree_check = working_tree_status()
E               fallback_check: dict[str, object] = {"used": False}
E               zero_advancement = False
E               if advancement_check.get("available") is True:
E                   zero_advancement = advancement_check.get("zero_advancement") is True
E               else:
E                   fallback_check = state_fallback_zero_advancement(previous)
E                   chain_health_log_message = (
E                       "completion guard git advancement check unavailable "
E                       f"session={session} base={base_sha or 'unknown'} reason={advancement_check.get('reason')}; "
E                       "falling back to state-file completed-count/current-index"
E                   )
E                   zero_advancement = fallback_check.get("zero_advancement") is True
E               details = {
E                   **details,
E                   "completion_guard_advancement": advancement_check,
E                   "completion_guard_worktree": worktree_check,
E                   "completion_guard_state_fallback": fallback_check,
E               }
E               if zero_advancement:
E                   base_label = base_sha or "unknown"
E                   if worktree_check.get("available") is True and worktree_check.get("dirty") is True:
E                       uncommitted_count = int(worktree_check.get("uncommitted_file_count") or 0)
E                       status = "chain_uncommitted_execute_output"
E                       issue_kind = "chain_uncommitted_execute_output"
E                       summary = (
E                           f"milestone {guard_milestone or 'unknown'} has 0 committed changes vs base {base_label} "
E                           f"but the working tree has {uncommitted_count} uncommitted files; unpublished claimed changes "
E                           "were left unpublished in a dirty worktree; execute output was not "
E                           "committed, so this is a CHAIN-DRIVER commit-step bug, not a plan no-op waiver case"
E                       )
E                       chain_health_log_message = (
E                           "CHAIN HEALTH EVIDENCE: working tree has "
E                           f"{uncommitted_count} uncommitted files vs committed HEAD; execute output was not "
E                           "committed -> repeated publish guards indicate the commit step skipped; investigate "
E                           "arnold_pipelines/megaplan/chain commit-and-push gating"
E                       )
E                       evidence_extra_lines.append(
E                           "- Working tree evidence: "
E                           f"{uncommitted_count} uncommitted files vs committed HEAD; execute output was not "
E                           "committed -> commit step skipped; investigate "
E                           "arnold_pipelines/megaplan/chain commit-and-push gating."
E                       )
E                       details["chain_driver_diagnosis"] = summary
E                   else:
E                       status = "needs_human"
E                       issue_kind = "plan_noop_completion_guard"
E                       summary = (
E                           f"milestone {guard_milestone or 'unknown'} produces NO code changes vs base {base_label} "
E                           f"across {guard_repeat_count} attempts "
E                           "(git rev-list base..HEAD == 0 and working tree is clean); completion guard correctly blocks; "
E                           "this is a PLAN decision: rework the milestone so its execute lands work, OR grant a typed no-op "
E                           "completion waiver. Not auto-repairable."
E                       )
E                       details["plan_level_diagnosis"] = summary
E               elif advancement_check.get("available") is True:
E                   # Code landed after the milestone base, so this is a repair-eligible
E                   # completion-guard edge case (for example a stale base SHA), not a
E                   # plan-level no-op. Return ok so launch_chain_tick continues into the
E                   # existing repair/relaunch path.
E                   completion_guard_repair_eligible = True
E                   status = "ok"
E                   issue_kind = ""
E                   summary = ""
E                   recurring_lines = []
E                   details = {}
E               elif fallback_check.get("used") is True and fallback_check.get("zero_advancement") is False:
E                   completion_guard_repair_eligible = True
E                   status = "ok"
E                   issue_kind = ""
E                   summary = ""
E                   recurring_lines = []
E                   details = {}
E           
E           unclean_base_lines = [
E               line
E               for line in log_lines[-120:]
E               if (
E                   '"error": "unclean_base"' in line
E                   or "require_clean_base:" in line
E                   or "working base carries uncommitted WIP" in line
E                   or "clean base" in line.lower()
E                   and "uncommitted" in line.lower()
E                   and "wip" in line.lower()
E               )
E           ]
E           if (
E               status == "ok"
E               and not completion_guard_repair_eligible
E               and last_state in NONTERMINAL_STATES
E               and unclean_base_lines
E           ):
E               status = "chain_unclean_base"
E               issue_kind = "chain_unclean_base"
E               recurring_lines = unclean_base_lines[-6:]
E               summary = (
E                   "chain retry/relaunch cannot start because require_clean_base found carried WIP; "
E                   "preserve the abandoned attempt output before re-initializing the milestone"
E               )
E               details = {
E                   "stuck_ticks": stuck_ticks,
E                   "dirty_base_signal": True,
E                   "unclean_base_line_count": len(unclean_base_lines),
E               }
E               chain_health_log_message = (
E                   "CHAIN HEALTH EVIDENCE: require_clean_base reported carried WIP during chain retry; "
E                   "this is a chain-driver retry-preservation issue, not a plan-level repair target"
E               )
E               evidence_extra_lines.append(
E                   "- Unclean-base evidence: require_clean_base reported carried WIP while the chain was retrying/relaunching. "
E                   "Preserve or stash the abandoned attempt output before re-initializing the milestone."
E               )
E           
E           if (
E               status == "ok"
E               and not completion_guard_repair_eligible
E               and last_state in NONTERMINAL_STATES
E               and not plan_has_live_activity
E               and not plan_projected_nonterminal
E               and stuck_ticks >= STUCK_TICKS
E           ):
E               status = "chain_stuck"
E               issue_kind = "chain_stuck_nonterminal"
E               recurring_lines = interesting_lines[-3:] if interesting_lines else log_lines[-3:]
E               summary = (
E                   f"chain stuck in nonterminal state {last_state} for {stuck_ticks} ticks with no completed[] growth; "
E                   "treat as chain-layer sickness"
E               )
E               details = {"stuck_ticks": stuck_ticks}
E           if (
E               status == "ok"
E               and not completion_guard_repair_eligible
E               and not plan_projected_nonterminal
E               and not plan_has_live_activity
E               and no_advance_ticks >= NO_ADVANCE_TICKS
E           ):
E               status = "chain_no_advance"
E               issue_kind = "chain_no_advance"
E               recurring_lines = interesting_lines[-3:] if interesting_lines else log_lines[-3:]
E               summary = (
E                   f"current_milestone_index stayed at {current_index} for {no_advance_ticks} busy ticks while "
E                   "plan events kept moving; the chain is busy but not advancing"
E               )
E               details = {"no_advance_ticks": no_advance_ticks, "events_advanced": events_advanced}
E           
E           chain_state_summary = {
E               "path": str(chain_state_path) if chain_state_path is not None else "",
E               "current_plan_name": current_plan_name,
E               "current_milestone_index": current_index,
E               "completed_count": completed_count,
E               "last_state": last_state,
E               "pr_number": pr_number,
E               "pr_state": pr_state,
E           }
E           
E           why_chain_layer = (
E               "This evidence points at chain-driver state progression or completion-guard behavior after the plan "
E               "already executed or the PR already merged. Route to arnold_pipelines/megaplan/chain/, not the plan repair loop."
E           )
E           
E           if status == "ok":
E               clear_artifact(artifact_path)
E           else:
E               rendered_lines = [line for line in recurring_lines if line]
E               if not rendered_lines:
E                   rendered_lines = log_lines[-5:]
E               evidence_lines = [
E                   "## CHAIN HEALTH EVIDENCE",
E                   f"- Issue: {issue_kind or status}",
E                   (
E                       "- Chain state summary: "
E                       f"last_state={last_state or 'unknown'} "
E                       f"pr_state={pr_state or 'unknown'} "
E                       f"current_milestone_index={current_index} "
E                       f"completed_count={completed_count}"
E                   ),
E                   "- Recurring chain-log lines:",
E                   *[f"> {line}" for line in rendered_lines[:6]],
E                   (
E                       "- Completion guard verdict: "
E                       f"{completion_guard['milestone'] or 'n/a'} -> "
E                       f"{completion_guard['reason'] or 'n/a'}"
E                   ),
E                   *(
E                       ["- PR progression guard evidence: repeated publish guards blocked advancement after the PR was already merged."]
E                       if completion_guard.get("kind") == "pr_progression"
E                       else []
E                   ),
E                   *evidence_extra_lines,
E                   f"- Why this is chain-layer: {why_chain_layer}",
E                   "- Investigate: arnold_pipelines/megaplan/chain/__init__.py and arnold_pipelines/megaplan/chain/status.py",
E               ]
E               evidence_markdown = "\n".join(evidence_lines)
E               artifact = {
E                   "session": session,
E                   "workspace": str(workspace),
E                   "remote_spec": remote_spec_raw,
E                   "detected_at": dt.datetime.now(dt.timezone.utc).isoformat(),
E                   "status": status,
E                   "issue_kind": issue_kind or status,
E                   "summary": summary,
E                   "health": health,
E                   "thresholds": {
E                       "chain_cycle_repeats": CYCLE_REPEATS,
E                       "chain_stuck_ticks": STUCK_TICKS,
E                       "chain_no_advance_ticks": NO_ADVANCE_TICKS,
E                       "chain_completion_guard_repeats": GUARD_REPEATS,
E                       "chain_log_window_lines": LOG_WINDOW,
E                   },
E                   "chain_state_summary": chain_state_summary,
E                   "chain_state_path": str(chain_state_path) if chain_state_path is not None else "",
E                   "chain_log_path": str(chain_log_path) if chain_log_path is not None else "",
E                   "chain_log_tail": log_lines[-40:],
E                   "recurring_cycle_lines": rendered_lines[:10],
E                   "completion_guard": completion_guard,
E                   "details": details,
E                   "snapshot": snapshot,
E                   "why_chain_layer_issue": why_chain_layer,
E                   "investigation_hint": "arnold_pipelines/megaplan/chain/",
E                   "evidence_markdown": evidence_markdown,
E               }
E               try:
E                   artifact_path.write_text(json.dumps(artifact, indent=2, sort_keys=True) + "\n", encoding="utf-8")
E               except Exception:
E                   pass
E           
E           emit("CHAIN_HEALTH_STATUS", status)
E           emit("CHAIN_HEALTH_KIND", (issue_kind or status) if status != "ok" else "")
E           emit("CHAIN_HEALTH_SUMMARY", summary)
E           emit("CHAIN_HEALTH_ARTIFACT_PATH", str(artifact_path) if status != "ok" else "")
E           emit("CHAIN_HEALTH_STATE_PATH", str(chain_state_path) if chain_state_path is not None else "")
E           emit("CHAIN_HEALTH_LOG_PATH", str(chain_log_path) if chain_log_path is not None else "")
E           emit("CHAIN_HEALTH_LOG_MESSAGE", chain_health_log_message)
E           PY
E           )"
E           }
E           
E           # Per-session runtime-binding preflight.  Identity is the marker session
E           # (canonical producer: cli.py _chain_runtime_manifest_path -> {manifest_dir}/{session}.json),
E           # NOT this watchdog process's ARNOLD_RUNTIME_MANIFEST / MANIFEST_RUNTIME_ROOT /
E           # LIVE_IMPORT_ROOT.  A multi-engine box (per-epic worktrees) has one supervisor
E           # observing many sessions; comparing a session's recorded root to the
E           # supervisor's own root is env-scoped, not identity-scoped (T-0022 1:1 leak).
E           # The session's own manifest epic.runtime_root is the only truth.
E           chain_engine_root_preflight() {
E             local workspace="$1"
E             local remote_spec="$2"
E             local session="$3"
E             local plan_name="${4:-}"
E             local manifest_dir="${ARNOLD_RUNTIME_MANIFEST_DIR:-/workspace/.megaplan}"
E             [[ -n "$workspace" && -n "$session" ]] || {
E               echo "chain_runtime_binding_drift: relaunch preflight missing workspace or session identity" >&2
E               return 24
E             }
E             if [[ -z "$remote_spec" && -n "$plan_name" ]]; then
E               # A plan relaunch carries no spec: resolve the one canonical chain whose
E               # persisted execution binding owns the plan.  A plan with no bound chain
E               # (standalone) still MUST prove recorded == session manifest below.
E               remote_spec="$(python3 - "$workspace" "$plan_name" <<'PY' 2>/dev/null || true
E           import pathlib
E           import sys
E           
E           try:
E               from arnold_pipelines.megaplan.chain.execution_binding import find_bound_chain_spec
E           except Exception:
E               raise SystemExit(1)
E           spec = find_bound_chain_spec(pathlib.Path(sys.argv[1]), plan_name=sys.argv[2])
E           if spec:
E               print(spec)
E           PY
E           )"
E             fi
E             python3 - "$workspace" "$remote_spec" "$session" "$manifest_dir" <<'PY'
E           import hashlib
E           import json
E           import pathlib
E           import sys
E           
E           workspace, remote_spec, session, manifest_dir = sys.argv[1:5]
E           workspace_path = pathlib.Path(workspace)
E           
E           
E           def drift(reason: str) -> None:
E               print(f"chain_runtime_binding_drift: {reason}", file=sys.stderr)
E               raise SystemExit(24)
E           
E           
E           session_manifest_path = pathlib.Path(manifest_dir) / f"{session}.json"
E           try:
E               payload = json.loads(session_manifest_path.read_text(encoding="utf-8"))
E           except Exception:
E               drift(f"session runtime manifest missing: {session_manifest_path}")
E           if not isinstance(payload, dict):
E               drift(f"session runtime manifest {session_manifest_path} is not an object")
E           epic = payload.get("epic")
E           if not isinstance(epic, dict):
E               drift(f"session runtime manifest {session_manifest_path} lacks epic")
E           raw_root = epic.get("runtime_root")
E           if not isinstance(raw_root, str) or not raw_root.strip():
E               drift(f"session runtime manifest {session_manifest_path} lacks epic.runtime_root")
E           manifest = pathlib.Path(raw_root).expanduser().resolve()
E           
E           
E           def require_engine(root: pathlib.Path, label: str) -> None:
E               if not root.is_dir() or not (root / ".git").exists():
E                   drift(f"{label} {root} is missing or dangling")
E               if not (root / "arnold_pipelines").is_dir():
E                   drift(f"{label} {root} has no arnold_pipelines package")
E           
E           
E           if not remote_spec:
E               # A STANDALONE plan carries no recorded engine root; the session manifest
E               # epic.runtime_root IS the binding.  Prove it is a real engine checkout.
E               require_engine(manifest, "session manifest runtime root")
E               print(manifest)
E               raise SystemExit(0)
E           
E           spec_path = pathlib.Path(remote_spec)
E           if not spec_path.is_absolute():
E               spec_path = workspace_path / spec_path
E           try:
E               spec_path = spec_path.resolve()
E           except OSError:
E               pass
E           digest = hashlib.sha1(str(spec_path).encode("utf-8")).hexdigest()[:12]
E           state_path = workspace_path / ".megaplan" / "plans" / ".chains" / f"chain-{digest}.json"
E           
E           try:
E               payload = json.loads(state_path.read_text(encoding="utf-8"))
E           except Exception:
E               drift(f"chain state {state_path} missing or unreadable")
E           if not isinstance(payload, dict):
E               drift(f"chain state {state_path} is not an object")
E           metadata = payload.get("metadata")
E           if not isinstance(metadata, dict):
E               drift(f"chain state {state_path} lacks metadata")
E           execution_environment = metadata.get("execution_environment")
E           if not isinstance(execution_environment, dict):
E               drift(f"chain state {state_path} lacks metadata.execution_environment")
E           recorded_root = execution_environment.get("engine_root")
E           if not isinstance(recorded_root, str) or not recorded_root.strip():
E               drift(f"chain state {state_path} lacks metadata.execution_environment.engine_root")
E           recorded = pathlib.Path(recorded_root).expanduser().resolve()
E           require_engine(recorded, "recorded engine root")
E           if recorded != manifest:
E               drift(f"engine root mismatch: recorded={recorded} manifest={manifest}")
E           print(recorded)
E           PY
E           }
E           
E           default_plan_relaunch_command() {
E             local plan_name="$1"
E             local workspace="$2"
E             local session="$3"
E             local log_path="$workspace/.megaplan/cloud-logs/${plan_name}.log"
E             local accepted_root
E             # T-0022: re-read the persisted engine root (bound chain, when this plan
E             # belongs to one) and fail closed on drift BEFORE building PYTHONPATH; only
E             # the accepted root goes on PYTHONPATH.
E             accepted_root="$(chain_engine_root_preflight "$workspace" "" "$session" "$plan_name")" || return $?
E             [[ -n "$accepted_root" ]] || return 24
E             printf 'if [[ -f /workspace/.cloud-hot-env ]]; then set -a; . /workspace/.cloud-hot-env; set +a; fi; unset ARNOLD_LIVENESS_OWNER_PID ARNOLD_LIVENESS_OWNER_PROCESS_START; cd %q && PLAN_STATE_FILE=%q/.megaplan/plans/%q/state.json && PLAN_CMD=auto && PLAN_AUTO_CMD='\''PYTHONSAFEPATH=1 PYTHONPATH=%q MEGAPLAN_TRUSTED_CONTAINER=1 python3 -P -m arnold_pipelines.megaplan auto --plan %q --project-dir %q >> %q 2>&1'\'' && if [[ -f "$PLAN_STATE_FILE" ]] && python3 - "$PLAN_STATE_FILE" <<'\''PY'\'' >/dev/null 2>&1
E           import json
E           import sys
E           from pathlib import Path
E           
E           try:
E               payload = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
E           except Exception:
E               raise SystemExit(1)
E           
E           raise SystemExit(0 if str(payload.get("current_state") or "").strip() == "failed" else 1)
E           PY
E             then PLAN_CMD=resume; fi && PYTHONSAFEPATH=1 PYTHONPATH=%q MEGAPLAN_TRUSTED_CONTAINER=1 python3 -P -m arnold_pipelines.megaplan "$PLAN_CMD" --plan %q --project-dir %q >> %q 2>&1' \
E               "$workspace" "$workspace" "$plan_name" "$accepted_root" "$plan_name" "$workspace" "$log_path" "$accepted_root" "$plan_name" "$workspace" "$log_path"
E           }
E           
E           resume_plan_relaunch_command() {
E             local plan_name="$1"
E             local workspace="$2"
E             local session="$3"
E             local log_path="$workspace/.megaplan/cloud-logs/${plan_name}.log"
E             local accepted_root
E             # T-0022: re-read the persisted engine root (bound chain, when this plan
E             # belongs to one) and fail closed on drift BEFORE building PYTHONPATH; only
E             # the accepted root goes on PYTHONPATH.
E             accepted_root="$(chain_engine_root_preflight "$workspace" "" "$session" "$plan_name")" || return $?
E             [[ -n "$accepted_root" ]] || return 24
E             printf 'if [[ -f /workspace/.cloud-hot-env ]]; then set -a; . /workspace/.cloud-hot-env; set +a; fi; cd %q && PYTHONSAFEPATH=1 PYTHONPATH=%q MEGAPLAN_TRUSTED_CONTAINER=1 python3 -P -m arnold_pipelines.megaplan resume --plan %q --project-dir %q >> %q 2>&1' \
E               "$workspace" "$accepted_root" "$plan_name" "$workspace" "$log_path"
E           }
E           
E           chain_resume_plan_relaunch_command_if_needed() {
E             local workspace="$1"
E             local plan_name="$2"
E             local remote_spec="${3:-}"
E             local session="${4:-}"
E             # T-0021 (G5): the engine-root preflight runs BEFORE any chain/plan state
E             # read — no plan-name derivation from chain state, no plan state.json, no
E             # marker.  A missing/dangling/mismatched recorded engine_root (or a missing
E             # manifest pin) fails closed with typed drift exit 24 here, before any
E             # resume decision is made.
E             chain_engine_root_preflight "$workspace" "$remote_spec" "$session" "$plan_name" >/dev/null || return $?
E             if [[ -z "$plan_name" && -n "$remote_spec" ]]; then
E               plan_name="$(python3 - "$workspace" "$remote_spec" <<'PY' 2>/dev/null || authority_gap_continue "T29-BYPASS-142" "authority-risk bypass converted to typed evidence gap"
E           import hashlib
E           import json
E           import pathlib
E           import sys
E           
E           workspace = pathlib.Path(sys.argv[1])
E           spec_path = pathlib.Path(sys.argv[2])
E           if not spec_path.is_absolute():
E               spec_path = workspace / spec_path
E           try:
E               spec_path = spec_path.resolve()
E           except OSError:
E               pass
E           digest = hashlib.sha1(str(spec_path).encode("utf-8")).hexdigest()[:12]
E           state_path = workspace / ".megaplan" / "plans" / ".chains" / f"chain-{digest}.json"
E           try:
E               payload = json.loads(state_path.read_text(encoding="utf-8"))
E           except Exception:
E               raise SystemExit(0)
E           plan_name = payload.get("current_plan_name") if isinstance(payload, dict) else ""
E           if isinstance(plan_name, str) and plan_name and "/" not in plan_name:
E               print(plan_name)
E           PY
E           )"
E             fi
E             [[ -n "$plan_name" ]] || return 1
E             local plan_state_file="$workspace/.megaplan/plans/$plan_name/state.json"
E             [[ -f "$plan_state_file" ]] || return 1
E             if ! python3 - "$plan_state_file" <<'PY' >/dev/null 2>&1
E           import json
E           import sys
E           from pathlib import Path
E           
E           try:
E               payload = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
E           except Exception:
E               raise SystemExit(1)
E           
E           if str(payload.get("current_state") or "").strip() != "blocked":
E               raise SystemExit(1)
E           resume_cursor = payload.get("resume_cursor")
E           if not isinstance(resume_cursor, dict):
E               raise SystemExit(1)
E           phase = str(resume_cursor.get("phase") or "").strip()
E           retry_strategy = str(resume_cursor.get("retry_strategy") or "").strip()
E           latest_failure = payload.get("latest_failure")
E           if not isinstance(latest_failure, dict):
E               raise SystemExit(1)
E           failure_kind = str(latest_failure.get("kind") or "").strip()
E           failure_phase = str(latest_failure.get("phase") or "").strip()
E           
E           raise SystemExit(
E               0
E               if (
E                   phase
E                   and phase != "recover-blocked"
E                   and retry_strategy in {"check_provider_and_retry", "wait_and_retry"}
E                   and failure_kind == "external_error_resume_required"
E                   and failure_phase == "recover-blocked"
E               )
E               else 1
E           )
E           PY
E             then
E               return 1
E             fi
E             resume_plan_relaunch_command "$plan_name" "$workspace" "$session"
E           }
E           
E           stale_marker_relaunch_command() {
E             local relaunch_command="${1:-}"
E             local accepted_root="${2:-}"
E             if PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 -P - "$relaunch_command" "$accepted_root" <<'PY'
E           import sys
E           from arnold_pipelines.megaplan.cloud.relaunch_resolution import is_stale_marker_relaunch_command
E           raise SystemExit(0 if is_stale_marker_relaunch_command(sys.argv[1], sys.argv[2] if len(sys.argv) > 2 else "") else 1)
E           PY
E             then
E               return 0
E             fi
E             return 1
E           }
E           
E           default_chain_relaunch_command() {
E             local session="$1"
E             local workspace="$2"
E             local remote_spec="$3"
E             local log_relative repair_queue_root repair_marker_dir accepted_root
E             if [[ "$session" == "megaplan-chain" ]]; then
E               log_relative=".megaplan/cloud-chain.log"
E             else
E               log_relative=".megaplan/cloud-chain-${session}.log"
E             fi
E             # The runtime IS the code (P4): the launch bound this session to the
E             # per-epic manifest runtime; this safety fallback re-runs the same chain
E             # start from the accepted (manifest) runtime root (fixed /workspace/arnold
E             # for permit-admitted manifest-less sessions).  T-0022: re-read the
E             # persisted engine root from the chain state and fail closed on drift
E             # BEFORE building PYTHONPATH; only the accepted root goes on PYTHONPATH.
E             # No editable-install refresh, no source checkout mutation, no
E             # env-selector re-resolution.
E             accepted_root="$(chain_engine_root_preflight "$workspace" "$remote_spec" "$session")" || return $?
E             [[ -n "$accepted_root" ]] || return 24
E             repair_marker_dir="${MARKER_DIR:-/workspace/.megaplan/cloud-sessions}"
E             repair_queue_root="${ARNOLD_REPAIR_QUEUE_ROOT:-${repair_marker_dir%/*}/repair-queue}"
E             printf 'unset ARNOLD_LIVENESS_OWNER_PID ARNOLD_LIVENESS_OWNER_PROCESS_START
E           export ARNOLD_REPAIR_QUEUE_ROOT=%q
E           export ARNOLD_REPAIR_MARKER_DIR=%q
E           export ARNOLD_REPAIR_SESSION=%q
E           export ARNOLD_REPAIR_RUN_KIND=%q
E           if [[ -f /workspace/.cloud-hot-env ]]; then set -a; . /workspace/.cloud-hot-env; set +a; fi; unset ARNOLD_LIVENESS_OWNER_PID ARNOLD_LIVENESS_OWNER_PROCESS_START; cd %q && PYTHONSAFEPATH=1 PYTHONPATH=%q MEGAPLAN_TRUSTED_CONTAINER=1 python3 -P -m arnold_pipelines.megaplan chain start --spec %q --project-dir %q >> %q 2>&1' \
E               "$repair_queue_root" "$repair_marker_dir" "$session" "chain" \
E               "$workspace" "$accepted_root" "$remote_spec" "$workspace" "$workspace/$log_relative"
E           }
E           
E           resolve_relaunch_command() {
E             local session="$1"
E             local workspace="$2"
E             local remote_spec="$3"
E             local run_kind="${4:-chain}"
E             local plan_name="${5:-}"
E             local relaunch_command="${6:-}"
E           
E             # A chain marker commonly preserves its original `chain start` command and
E             # omits plan_name. Once the active plan records explicit resume authority,
E             # that current state must outrank the stale launch-time marker command.
E             if [[ "$run_kind" != "plan" ]]; then
E               local resume_rc
E               chain_resume_plan_relaunch_command_if_needed "$workspace" "$plan_name" "$remote_spec" "$session" || resume_rc=$?
E               # G5 (T-0021): the engine-root preflight runs first inside the resume
E               # check; a typed drift (24) must fail closed here rather than fall
E               # through to the marker/default relaunch paths.
E               if [[ "${resume_rc:-0}" -eq 24 ]]; then
E                 return 24
E               fi
E               if [[ "${resume_rc:-0}" -eq 0 ]]; then
E                 return 0
E               fi
E             fi
E             # G5 (round-6 finding 1b): the default-plan preflight gates ANY persisted
E             # plan command before it is returned verbatim — a persisted command cannot
E             # bypass the engine-root preflight (chain commands are already gated by the
E             # preflight inside the resume check above).
E             if [[ "$run_kind" == "plan" && -n "$relaunch_command" ]]; then
E               chain_engine_root_preflight "$workspace" "" "$session" "$plan_name" >/dev/null || return $?
E             fi
E             # G5 (round-2 finding 2): the blacklist gate below (relaunch_resolution)
E             # also rejects shared-root PYTHONPATH=/workspace/arnold patterns, so a
E             # persisted builder-selection command is never returned verbatim — it is
E             # regenerated from the preflight-accepted manifest root or fails closed
E             # (typed drift 24) instead.  G5 (round-14 finding 1): the gate additionally
E             # passes the accepted manifest root so a persisted command referencing a
E             # DIFFERENT per-epic runtime path is regenerated, not returned verbatim.
E             if [[ -n "$relaunch_command" ]] && ! stale_marker_relaunch_command "$relaunch_command" "$SRC_DIR"; then
E               printf '%s' "$relaunch_command"
E               return 0
E             fi
E             if [[ "$run_kind" == "plan" ]]; then
E               [[ -n "$plan_name" ]] || return 1
E               default_plan_relaunch_command "$plan_name" "$workspace" "$session"
E               return 0
E             fi
E             default_chain_relaunch_command "$session" "$workspace" "$remote_spec"
E           }
E           
E           # Step 53 relaunch-materializer authority gate.
E           #
E           # Every relaunch command and arnold-supervise bash -lc script produced by this
E           # watchdog is a NON-AUTHORITATIVE relaunch materializer: a successful relaunch
E           # (return code 0) resumes plan/chain execution but can never become accepted
E           # repair.  Accepted repair requires canonical simple_fixer delegation with an
E           # exact F01 occurrence tuple; authority is never derived from a label, liveness
E           # signal, WBC receipt, or rebuildable projection (SC19).
E           #
E           # The gate classifies a relaunch command into a closed vocabulary of
E           # non-authoritative families and proves no forbidden authority source is
E           # present.  Output is a single JSON object on stdout.
E           relaunch_materializer_authority_gate() {
E             local relaunch_command="${1:-}"
E             python3 - "$relaunch_command" <<'GATE_PY'
E           import json
E           import re
E           import sys
E           
E           cmd = sys.argv[1] if len(sys.argv) > 1 else ""
E           
E           NON_AUTHORITATIVE_FAMILIES = (
E               "direct_module.auto",
E               "direct_module.resume",
E               "direct_module.auto_or_resume",
E               "direct_module.chain_start",
E               "arnold_supervise.bash_lc",
E           )
E           
E           _DIRECT_MODULE_RE = re.compile(
E               r"python3\b.*?\s+-m\s+arnold_pipelines\.megaplan\s+(\S+)"
E           )
E           _SUPERVISE_RE = re.compile(r"arnold-supervise\b.*?\sbash\s+-lc\b")
E           
E           _FORBIDDEN_AUTHORITY_SOURCES = (
E               ("label", re.compile(r"--authority-label|REPAIR_AUTHORITY_LABEL|repair-authority-label")),
E               ("liveness", re.compile(r"repair_accepted|accepted_repair_on|repair.*\$\?|repair.*returncode")),
E               ("wbc_receipt", re.compile(r"wbc[-_ ]?receipt|well[-_ ]?behaved[-_ ]?client")),
E               (
E                   "rebuildable_projection",
E                   re.compile(r"rebuildable[-_ ]?projection|reproject[-_ ]?authority"),
E               ),
E           )
E           
E           
E           def _classify(command):
E               if _SUPERVISE_RE.search(command):
E                   return "arnold_supervise.bash_lc"
E               match = _DIRECT_MODULE_RE.search(command)
E               if match:
E                   verb = match.group(1).strip("\"'")
E                   tail = command[match.end():]
E                   if verb in ("auto", "resume"):
E                       return "direct_module." + verb
E                   if verb == "chain" and tail.lstrip().startswith("start"):
E                       return "direct_module.chain_start"
E                   if "PLAN_CMD" in verb:
E                       return "direct_module.auto_or_resume"
E               return ""
E           
E           
E           family = _classify(cmd)
E           forbidden_present = [
E               name
E               for name, pattern in _FORBIDDEN_AUTHORITY_SOURCES
E               if pattern.search(cmd)
E           ]
E           result = dict(
E               family=family,
E               is_non_authoritative_family=family in NON_AUTHORITATIVE_FAMILIES,
E               is_repair_authority=False,
E               can_become_accepted_repair_on_success=False,
E               accepted_repair_requires_canonical_delegation=True,
E               canonical_delegation_path="simple_fixer.singleton_claim.exact_f01_tuple",
E               forbidden_authority_sources=[
E                   "label",
E                   "liveness",
E                   "wbc_receipt",
E                   "rebuildable_projection",
E               ],
E               forbidden_sources_present=forbidden_present,
E           )
E           print(json.dumps(result))
E           GATE_PY
E           }
E           
E           child_agent_launch_authority_or_reject() {
E             # Step 55-58: classify a watchdog child-agent launch (repair-loop, meta-repair,
E             # managed-agent, or Kimi family).  A child launch may NEVER become accepted
E             # repair outside canonical simple_fixer delegation; authority is never derived
E             # from a label, liveness signal, WBC receipt, or rebuildable projection (SC38).
E             # Forbidden sources emit a typed zero-authority rejection; exact-F01 occurrences
E             # delegate to the simple_fixer singleton claim with no child agent fan-out.
E             # Emits JSON on stdout with an ``outcome`` key in
E             # {zero_authority_rejected, delegated, no_authority_claim}.
E             local caller_kind="${1:-live_watchdog}"
E             local caller_id="${2:-arnold-watchdog}"
E             local _py_root="${WRAPPER_REPO_ROOT:-${ARNOLD_SRC:-}}"
E             PYTHONSAFEPATH=1 PYTHONPATH="${_py_root:+$_py_root:}${PYTHONPATH:-}" python3 -P - \
E               "$caller_kind" "$caller_id" <<'CHILD_AGENT_PY'
E           import json, os, sys
E           from arnold_pipelines.megaplan.cloud.wrappers.repair_delegation import (
E               build_repair_delegation, emit_zero_authority_rejection,
E           )
E           from arnold_pipelines.megaplan.custody.contracts import F01_REPAIR_OCCURRENCE_FIELDS
E           
E           caller_kind = sys.argv[1] if len(sys.argv) > 1 else "live_watchdog"
E           caller_id = sys.argv[2] if len(sys.argv) > 2 else "arnold-watchdog"
E           
E           forbidden = dict(
E               authority_label=os.environ.get("ARNOLD_REPAIR_AUTHORITY_LABEL", ""),
E               liveness_receipt=os.environ.get("ARNOLD_REPAIR_LIVENESS_RECEIPT", ""),
E               wbc_receipt=os.environ.get("ARNOLD_REPAIR_WBC_RECEIPT", ""),
E               rebuildable_projection=os.environ.get("ARNOLD_REPAIR_REBUILDABLE_PROJECTION", ""),
E           )
E           if any(v for v in forbidden.values()):
E               result = emit_zero_authority_rejection(
E                   caller_kind, caller_id,
E                   reason="child-agent launch authority derived from forbidden source: "
E                          + ",".join(sorted(k for k, v in forbidden.items() if v)),
E               )
E               print(json.dumps({
E                   "outcome": result.outcome,
E                   "delegated": False,
E                   "child_agent_fanout": False,
E                   "canonical_delegation_path": "simple_fixer.singleton_claim.exact_f01_tuple",
E               }))
E               sys.exit(0)
E           
E           f01_env = os.environ.get("ARNOLD_REPAIR_F01_OCCURRENCE", "")
E           target = {}
E           if f01_env:
E               try:
E                   target = json.loads(f01_env)
E               except Exception:
E                   target = {}
E           
E           if not target:
E               print(json.dumps({
E                   "outcome": "no_authority_claim",
E                   "delegated": False,
E                   "child_agent_fanout": False,
E                   "canonical_delegation_path": "simple_fixer.singleton_claim.exact_f01_tuple",
E               }))
E               sys.exit(0)
E           
E           for name in F01_REPAIR_OCCURRENCE_FIELDS:
E               target.setdefault(name, "")
E           
E           delegation = build_repair_delegation(caller_kind, caller_id, target)
E           if delegation is None:
E               result = emit_zero_authority_rejection(
E                   caller_kind, caller_id,
E                   reason="child-agent launch path could not construct exact F01 occurrence tuple",
E               )
E               print(json.dumps({
E                   "outcome": result.outcome,
E                   "delegated": False,
E                   "child_agent_fanout": False,
E                   "canonical_delegation_path": "simple_fixer.singleton_claim.exact_f01_tuple",
E               }))
E               sys.exit(0)
E           
E           print(json.dumps({
E               "outcome": "delegated",
E               "delegated": True,
E               "child_agent_fanout": False,
E               "canonical_delegation_path": "simple_fixer.singleton_claim.exact_f01_tuple",
E               "occurrence_fingerprint": delegation.occurrence.occurrence_fingerprint,
E           }))
E           CHILD_AGENT_PY
E           }
E           
E           watchdog_repair_state_authority_or_reject() {
E             # Steps 59-65: classify a watchdog repair-state mutation (claim write, claim
E             # adoption/existing-owner, stale-state cleanup, process reaping, retry loop,
E             # unchanged-fingerprint escalation, or retry-budget mutation).  A repair-state
E             # mutation may NEVER become accepted repair outside canonical simple_fixer
E             # delegation; authority is never derived from a label, liveness signal, WBC
E             # receipt, or rebuildable projection (SC39).  Forbidden sources emit a typed
E             # zero-authority rejection; exact-F01 occurrences delegate to the simple_fixer
E             # singleton claim with no child agent fan-out.  Emits JSON on stdout with an
E             # ``outcome`` key in {zero_authority_rejected, delegated, no_authority_claim}.
E             local caller_kind="${1:-live_watchdog}"
E             local caller_id="${2:-arnold-watchdog}"
E             local _py_root="${WRAPPER_REPO_ROOT:-${ARNOLD_SRC:-}}"
E             PYTHONSAFEPATH=1 PYTHONPATH="${_py_root:+$_py_root:}${PYTHONPATH:-}" python3 -P - \
E               "$caller_kind" "$caller_id" <<'REPAIR_STATE_PY'
E           import json, os, sys
E           from arnold_pipelines.megaplan.cloud.wrappers.repair_delegation import (
E               build_repair_delegation, emit_zero_authority_rejection,
E           )
E           from arnold_pipelines.megaplan.custody.contracts import F01_REPAIR_OCCURRENCE_FIELDS
E           
E           caller_kind = sys.argv[1] if len(sys.argv) > 1 else "live_watchdog"
E           caller_id = sys.argv[2] if len(sys.argv) > 2 else "arnold-watchdog"
E           
E           forbidden = dict(
E               authority_label=os.environ.get("ARNOLD_REPAIR_AUTHORITY_LABEL", ""),
E               liveness_receipt=os.environ.get("ARNOLD_REPAIR_LIVENESS_RECEIPT", ""),
E               wbc_receipt=os.environ.get("ARNOLD_REPAIR_WBC_RECEIPT", ""),
E               rebuildable_projection=os.environ.get("ARNOLD_REPAIR_REBUILDABLE_PROJECTION", ""),
E           )
E           if any(v for v in forbidden.values()):
E               result = emit_zero_authority_rejection(
E                   caller_kind, caller_id,
E                   reason="repair-state mutation authority derived from forbidden source: "
E                          + ",".join(sorted(k for k, v in forbidden.items() if v)),
E               )
E               print(json.dumps({
E                   "outcome": result.outcome,
E                   "delegated": False,
E                   "repair_state_mutation": False,
E                   "canonical_delegation_path": "simple_fixer.singleton_claim.exact_f01_tuple",
E               }))
E               sys.exit(0)
E           
E           f01_env = os.environ.get("ARNOLD_REPAIR_F01_OCCURRENCE", "")
E           target = {}
E           if f01_env:
E               try:
E                   target = json.loads(f01_env)
E               except Exception:
E                   target = {}
E           
E           if not target:
E               print(json.dumps({
E                   "outcome": "no_authority_claim",
E                   "delegated": False,
E                   "repair_state_mutation": False,
E                   "canonical_delegation_path": "simple_fixer.singleton_claim.exact_f01_tuple",
E               }))
E               sys.exit(0)
E           
E           for name in F01_REPAIR_OCCURRENCE_FIELDS:
E               target.setdefault(name, "")
E           
E           delegation = build_repair_delegation(caller_kind, caller_id, target)
E           if delegation is None:
E               result = emit_zero_authority_rejection(
E                   caller_kind, caller_id,
E                   reason="repair-state mutation path could not construct exact F01 occurrence tuple",
E               )
E               print(json.dumps({
E                   "outcome": result.outcome,
E                   "delegated": False,
E                   "repair_state_mutation": False,
E                   "canonical_delegation_path": "simple_fixer.singleton_claim.exact_f01_tuple",
E               }))
E               sys.exit(0)
E           
E           print(json.dumps({
E               "outcome": "delegated",
E               "delegated": True,
E               "repair_state_mutation": True,
E               "canonical_delegation_path": "simple_fixer.singleton_claim.exact_f01_tuple",
E               "occurrence_fingerprint": delegation.occurrence.occurrence_fingerprint,
E           }))
E           REPAIR_STATE_PY
E           }
E           
E           kimi_dispatch_marker_set() {
E             local session="$1" marker_kind="${2:-deterministic_relaunch}" run_id="${3:-}" manifest_path="${4:-}"
E             if [[ "$marker_kind" == "managed_agent" && ( -z "$run_id" || -z "$manifest_path" ) ]]; then
E               return 1
E             fi
E             printf 'arnold-dispatch-marker-v2\t%s\t%s\t%s\t%s\n' \
E               "$marker_kind" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$run_id" "$manifest_path" \
E               > "$(kimi_dispatch_marker_path "$session")" 2>/dev/null || authority_gap_continue "T29-BYPASS-146" "authority-risk bypass converted to typed evidence gap"
E           }
E           
E           kimi_dispatch_marker_clear() {
E             if [[ "${MUTATION_CAPABILITY_PRESENT:-0}" != "1" ]]; then
E               log "kimi dispatch marker clear observe-only without minted MutationCapability session=${1:-}"
E               return 0
E             fi
E             rm -f "$(kimi_dispatch_marker_path "$1")" "$(kimi_pgid_path "$1")" 2>/dev/null || authority_gap_continue "T29-BYPASS-147" "authority-risk bypass converted to typed evidence gap"
E           }
E           
E           meta_dispatch_marker_set() {
E             local session="$1" run_id="$2" manifest_path="$3"
E             [[ -n "$run_id" && -n "$manifest_path" ]] || return 1
E             printf 'arnold-dispatch-marker-v2\tmanaged_agent\t%s\t%s\t%s\n' \
E               "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$run_id" "$manifest_path" \
E               > "$(meta_dispatch_marker_path "$session")" 2>/dev/null || authority_gap_continue "T29-BYPASS-148" "authority-risk bypass converted to typed evidence gap"
E           }
E           
E           meta_dispatch_marker_clear() {
E             if [[ "${MUTATION_CAPABILITY_PRESENT:-0}" != "1" ]]; then
E               log "meta dispatch marker clear observe-only without minted MutationCapability session=${1:-}"
E               return 0
E             fi
E             rm -f "$(meta_dispatch_marker_path "$1")" "$(meta_pgid_path "$1")" 2>/dev/null || authority_gap_continue "T29-BYPASS-149" "authority-risk bypass converted to typed evidence gap"
E           }
E           
E           write_partial_liveness_tick() {
E             local session="$1"
E             local workspace="$2"
E             local remote_spec="$3"
E             local run_kind="${4:-chain}"
E             local plan_name="${5:-}"
E             local health="${6:-alive}"
E             local sidecar_dir events_path
E             sidecar_dir="${CLOUD_WATCHDOG_REPAIR_SIDECAR_DIR:-${REPAIR_DATA_DIR}.d}"
E             events_path="$sidecar_dir/events/events.jsonl"
E             mkdir -p "$(dirname "$events_path")" 2>/dev/null || true
E             PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$events_path" "$session" "$health" "$workspace" "$remote_spec" "$run_kind" "$plan_name" <<'PY'
E           import json
E           import os
E           import sys
E           from datetime import datetime, timezone
E           
E           events_path, session, health, workspace, remote_spec, run_kind, plan_name = sys.argv[1:8]
E           
E           MAX_TICKS = 20
E           
E           tick = {
E               "session": session,
E               "outcome": "partial_liveness",
E               "health": health,
E               "recorded_at": datetime.now(timezone.utc).isoformat(),
E               "run_kind": run_kind,
E               "plan_name": plan_name,
E           }
E           
E           # Read existing events, append the new tick, and truncate to MAX_TICKS
E           events = []
E           try:
E               if os.path.exists(events_path):
E                   with open(events_path, "r", encoding="utf-8") as fh:
E                       for line in fh:
E                           line = line.strip()
E                           if not line:
E                               continue
E                           try:
E                               events.append(json.loads(line))
E                           except json.JSONDecodeError:
E                               continue
E           except Exception:
E               pass
E           
E           events.append(tick)
E           
E           # Keep only the most recent MAX_TICKS
E           if len(events) > MAX_TICKS:
E               events = events[-MAX_TICKS:]
E           
E           # Write atomically via temp file
E           tmp_path = events_path + ".tmp"
E           try:
E               with open(tmp_path, "w", encoding="utf-8") as fh:
E                   for entry in events:
E                       fh.write(json.dumps(entry, sort_keys=True) + "\n")
E               os.replace(tmp_path, events_path)
E           except Exception:
E               pass
E           PY
E           }
E           
E           env_gone_sidecar_path() {
E             printf '%s/%s.env-gone' "$MARKER_DIR" "$(safe_name "$1")"
E           }
E           
E           # Detect whether a session's environment has been wiped (workspace dir or
E           # chain/epic-chain spec gone — typically after a box reset/redeploy). Uses a
E           # strike counter so a transient deploy gap doesn't retire a live session.
E           #
E           #stdout: prints one of:
E           #   - "gone"    and exits 0  -> env missing AND strikes >= $ENV_GONE_STRIKES
E           #   - "<count>" and exits 1  -> env missing, strikes below threshold (count printed)
E           #   - "present" and exits 1  -> env present (any prior sidecar cleared; recovers
E           #                              from a transient deploy that has since resolved)
E           environment_gone_check() {
E             local session="$1"
E             local workspace="$2"
E             local spec_path="${3:-}"
E             local sidecar count
E             sidecar="$(env_gone_sidecar_path "$session")"
E           
E             # Env present: clear any stale strike sidecar and signal fall-through.
E             if [[ -d "$workspace" ]] && { [[ -z "$spec_path" ]] || [[ -f "$spec_path" ]]; }; then
E               if [[ -f "$sidecar" ]]; then
E                 if [[ "${MUTATION_CAPABILITY_PRESENT:-0}" != "1" ]]; then
E                   log "env-gone strikes preserved; observe-only without minted MutationCapability session=$session workspace=$workspace spec=${spec_path:-}"
E                 else
E                   rm -f "$sidecar" 2>/dev/null || authority_gap_continue "T29-BYPASS-151" "authority-risk bypass converted to typed evidence gap"
E                   log "env-gone strikes cleared; environment recovered session=$session workspace=$workspace spec=${spec_path:-}"
E                 fi
E               fi
E               printf 'present\n'
E               return 1
E             fi
E           
E             count=0
E             if [[ -f "$sidecar" ]]; then
E               count="$(cat "$sidecar" 2>/dev/null || authority_gap_continue "T29-BYPASS-152" "authority-risk bypass converted to typed evidence gap")"
E               count="${count//[!0-9]/}"
E               count="${count:-0}"
E             fi
E             count=$((count + 1))
E             printf '%s\n' "$count" >"$sidecar" 2>/dev/null || authority_gap_continue "T29-BYPASS-153" "authority-risk bypass converted to typed evidence gap"
E           
E             if (( count >= ENV_GONE_STRIKES )); then
E               printf 'gone\n'
E               return 0
E             fi
E             printf '%s\n' "$count"
E             return 1
E           }
E           
E           # Persist an environment_gone terminal outcome to repair-data for audit.
E           # Writes via save_repair_data directly (NOT repair_data_set_outcome, which
E           # requires the repair lock the watchdog does not hold). Best-effort: a failed
E           # write must not block session retirement.
E           persist_environment_gone_outcome() {
E             local session="$1"
E             local workspace="$2"
E             local remote_spec="$3"
E             local run_kind="${4:-chain}"
E             local plan_name="${5:-}"
E             if [[ "${MUTATION_CAPABILITY_PRESENT:-0}" != "1" ]]; then
E               log "environment-gone retirement observe-only without minted MutationCapability session=$session"
E               return 0
E             fi
E             local data_file="${REPAIR_DATA_DIR:-$MARKER_DIR/repair-data}/${session}.repair-data.json"
E             PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$data_file" "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" <<'PY' 2>>"${LOG:-/dev/null}" || authority_gap_continue "T29-BYPASS-154" "authority-risk bypass converted to typed evidence gap"
E           import pathlib
E           import sys
E           
E           from arnold_pipelines.megaplan.cloud.repair_contract import (
E               ENVIRONMENT_GONE,
E               load_json,
E               save_repair_data,
E           )
E           
E           data_path_raw, session, workspace, remote_spec, run_kind, plan_name = sys.argv[1:]
E           data_path = pathlib.Path(data_path_raw)
E           payload = load_json(data_path, default={})
E           if not isinstance(payload, dict):
E               payload = {}
E           payload.setdefault("session", session)
E           payload.setdefault("workspace", workspace)
E           payload.setdefault("run_kind", run_kind)
E           payload.setdefault("plan_name", plan_name)
E           payload["workspace"] = workspace
E           payload["run_kind"] = run_kind
E           payload["plan_name"] = plan_name
E           payload["outcome"] = ENVIRONMENT_GONE
E           save_repair_data(data_path, payload)
E           PY
E           }
E           
E           clear_session_tracking_artifacts() {
E             local session="$1"
E             local plan_name="${2:-}"
E             if [[ "${MUTATION_CAPABILITY_PRESENT:-0}" != "1" ]]; then
E               log "session tracking artifacts observe-only without minted MutationCapability session=$session"
E               return 0
E             fi
E             rm -f "$(session_marker_path "$session")" 2>/dev/null || authority_gap_continue "T29-BYPASS-155" "authority-risk bypass converted to typed evidence gap"
E             kimi_dispatch_marker_clear "$session"
E             rm -f "$(repair_needs_human_path "$session")" 2>/dev/null || authority_gap_continue "T29-BYPASS-156" "authority-risk bypass converted to typed evidence gap"
E             rm -f "$(chain_health_snapshot_path "$session")" "$(chain_health_artifact_path "$session")" 2>/dev/null || authority_gap_continue "T29-BYPASS-157" "authority-risk bypass converted to typed evidence gap"
E             if [[ -n "$plan_name" ]]; then
E               rm -f "$MARKER_DIR/$plan_name.progress.json" 2>/dev/null || authority_gap_continue "T29-BYPASS-158" "authority-risk bypass converted to typed evidence gap"
E             fi
E           }
E           
E           plan_terminal_status() {
E             local workspace="$1"
E             local plan_name="$2"
E             python3 - "$workspace" "$plan_name" <<'PY'
E           import json
E           import pathlib
E           import sys
E           
E           workspace = pathlib.Path(sys.argv[1])
E           plan_name = sys.argv[2]
E           plans_dir = workspace / ".megaplan" / "plans"
E           state_paths = []
E           if plan_name:
E               state_paths.append(plans_dir / plan_name / "state.json")
E           else:
E               state_paths.extend(
E                   sorted(
E                       plans_dir.glob("*/state.json"),
E                       key=lambda path: path.stat().st_mtime,
E                       reverse=True,
E                   )
E               )
E           if not state_paths:
E               print("none")
E               raise SystemExit(0)
E           
E           state_path = state_paths[0]
E           try:
E               state = json.loads(state_path.read_text(encoding="utf-8"))
E           except Exception:
E               print("none")
E               raise SystemExit(0)
E           
E           current_state = state.get("current_state")
E           if str(current_state or "").strip().lower() in {
E               "done",
E               "completed",
E               "reviewed",
E               "abandoned",
E           }:
E               print(f"{state_path.parent.name}\t{current_state}")
E           else:
E               print("none")
E           PY
E           }
E           
E           kimi_dispatch_failed_previously() {
E             local session="$1"
E             [[ -f "$(kimi_dispatch_marker_path "$session")" ]] \
E               && [[ -f "$(kimi_pgid_path "$session")" ]] \
E               && ! kimi_operator_running "$session"
E           }
E           
E           mechanical_relaunch_attempted_previously() {
E             local session="$1"
E             [[ -f "$(kimi_dispatch_marker_path "$session")" ]] \
E               && [[ ! -f "$(kimi_pgid_path "$session")" ]] \
E               && ! kimi_operator_running "$session"
E           }
E           
E           repair_data_outcome_for_session() {
E             local session="$1"
E             local data_path="${REPAIR_DATA_DIR:-$MARKER_DIR/repair-data}/$session.repair-data.json"
E             [[ -r "$data_path" ]] || return 0
E             python3 - "$data_path" <<'PY'
E           import json
E           import pathlib
E           import sys
E           
E           try:
E               payload = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
E           except Exception:
E               payload = {}
E           if isinstance(payload, dict):
E               outcome = str(payload.get("outcome") or "").strip()
E               if outcome:
E                   print(outcome)
E           PY
E           }
E           
E           repair_outcome_wants_repair_retry() {
E             case "${1:-}" in
E               recurring_retry_pending)
E                 return 0
E                 ;;
E               *)
E                 return 1
E                 ;;
E             esac
E           }
E           
E           emit_watchdog_incident_bridge_event() {
E             local event_kind="$1"
E             local session="$2"
E             local workspace="$3"
E             local remote_spec="$4"
E             local summary="$5"
E             local status="$6"
E             local repair_actor="${7:-immediate_repair}"
E             local extra_evidence_json="${8:-[]}"
E             PYTHONPATH="${WRAPPER_REPO_ROOT}:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - \
E               "$event_kind" "$session" "$workspace" "$remote_spec" "$summary" "$status" "$repair_actor" \
E               "${REPAIR_DATA_DIR:-$MARKER_DIR/repair-data}" "$extra_evidence_json" <<'PY' \
E               >> "${LOG:-/dev/null}" 2>&1 || authority_gap_continue "T29-BYPASS-159" "authority-risk bypass converted to typed evidence gap"
E           import json
E           import pathlib
E           import sys
E           
E           from arnold_pipelines.megaplan.cloud.incident_bridge import (
E               append_watchdog_detection,
E               append_watchdog_dispatch,
E           )
E           
E           (
E               event_kind,
E               session,
E               workspace_raw,
E               remote_spec,
E               summary,
E               status,
E               repair_actor,
E               repair_data_dir_raw,
E               extra_evidence_json,
E           ) = sys.argv[1:]
E           repair_data_dir = pathlib.Path(repair_data_dir_raw)
E           data_path = repair_data_dir / f"{session}.repair-data.json"
E           if not data_path.exists():
E               raise SystemExit(0)
E           try:
E               payload = json.loads(data_path.read_text(encoding="utf-8"))
E           except Exception:
E               payload = {}
E           if not isinstance(payload, dict):
E               raise SystemExit(0)
E           incident_id = str(payload.get("incident_id") or "").strip()
E           if not incident_id:
E               raise SystemExit(0)
E           problem_id = str(payload.get("problem_id") or "").strip() or None
E           workspace = pathlib.Path(workspace_raw) if workspace_raw else pathlib.Path.cwd()
E           evidence = [
E               {
E                   "kind": "watchdog_observation",
E                   "status": status,
E                   "repair_actor": repair_actor,
E                   "workspace": workspace_raw,
E                   "remote_spec": remote_spec,
E               }
E           ]
E           try:
E               loaded_extra = json.loads(extra_evidence_json)
E           except Exception:
E               loaded_extra = []
E           if isinstance(loaded_extra, list):
E               evidence.extend(loaded_extra)
E           elif isinstance(loaded_extra, dict):
E               evidence.append(loaded_extra)
E           
E           if event_kind == "detection":
E               append_watchdog_detection(
E                   incident_id=incident_id,
E                   summary=summary,
E                   outcome=status,
E                   evidence=evidence,
E                   session_id=session,
E                   problem_id=problem_id,
E                   next_expected_event="watchdog.dispatch",
E                   root=workspace,
E               )
E               raise SystemExit(0)
E           
E           next_expected_event = None
E           if status == "dispatched":
E               if repair_actor == "meta_repair":
E                   next_expected_event = "meta_repair.repair_attempt"
E               else:
E                   next_expected_event = "immediate_repair.repair_attempt"
E           append_watchdog_dispatch(
E               incident_id=incident_id,
E               summary=summary,
E               outcome=status,
E               evidence=evidence,
E               session_id=session,
E               problem_id=problem_id,
E               next_expected_event=next_expected_event,
E               decision={
E                   "repair_actor": repair_actor,
E                   "status": status,
E                   "workspace": workspace_raw,
E                   "remote_spec": remote_spec,
E               },
E               root=workspace,
E           )
E           PY
E           }
E           
E           # ── P2 typed runtime transitions ──────────────────────────────────────────
E           # One typed deviation/fallback event path.  Every runtime deviation and
E           # fallback decision is appended to the incident ledger BEFORE the caller
E           # performs a dispatch side effect.  The append is synchronous and never
E           # swallowed: a non-zero CLI exit (policy rejection or journal write failure)
E           # returns 1 and the caller MUST block dispatch (no event = no side effect).
E           # Emitting is a pure append-only ledger write — it never dispatches repair
E           # and never triggers a scan (mirror of emit_watchdog_incident_bridge_event).
E           # Missing inputs (no workspace, no spec, unreadable spec) FAIL CLOSED: the
E           # event cannot be durably recorded without a contract digest, so the caller
E           # MUST treat a non-zero return as "do not dispatch" — never succeed
E           # eventless.
E           emit_runtime_transition_event() {
E             local event_name="$1"
E             local session="$2"
E             local workspace="$3"
E             local remote_spec="$4"
E             local failure_class="${5:-}"
E             local error_text="${6:-}"
E             local candidate_to="${7:-}"
E             local candidate_from="${8:-}"
E             local attempt_num="${9:-}"
E             local summary_text="${10:-}"
E             local chain_digest ledger_rc
E             local -a ledger_args
E             if [[ -z "$workspace" || -z "$remote_spec" || ! -f "$remote_spec" ]]; then
E               printf '[watchdog %s] runtime transition ledger input missing (workspace/spec) for %s; blocking dispatch session=%s\n' \
E                 "$(date -Iseconds)" "$event_name" "$session" >>"${LOG:-/dev/null}" 2>&1 || true
E               return 1
E             fi
E             chain_digest="$(PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$remote_spec" <<'PY'
E           import pathlib
E           import sys
E           
E           from arnold_pipelines.megaplan.chain.spec import chain_spec_sha256
E           
E           print(chain_spec_sha256(pathlib.Path(sys.argv[1])))
E           PY
E           )"
E             if [[ -z "$chain_digest" ]]; then
E               return 1
E             fi
E             ledger_args=(
E               "$event_name"
E               --root "$workspace"
E               --scope "chain:$session"
E               --session-id "$session"
E               --actor "arnold-watchdog"
E               --failure-class "$failure_class"
E               --error "$error_text"
E               --candidate-to "$candidate_to"
E               --candidate-from "$candidate_from"
E               --attempt "$attempt_num"
E               --chain-spec-sha256 "$chain_digest"
E             )
E             if [[ -n "$summary_text" ]]; then
E               ledger_args+=(--summary "$summary_text")
E             fi
E             PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 -W ignore::RuntimeWarning \
E               -m arnold_pipelines.megaplan.incident.ledger "${ledger_args[@]}" \
E               >> "${LOG:-/dev/null}" 2>&1
E             ledger_rc=$?
E             if [[ "$ledger_rc" != "0" ]]; then
E               printf '[watchdog %s] runtime transition ledger write failed (%s) rc=%s; blocking dispatch session=%s\n' \
E                 "$(date -Iseconds)" "$event_name" "$ledger_rc" "$session" >>"${LOG:-/dev/null}" 2>&1 || true
E               return 1
E             fi
E             return 0
E           }
E           
E           # ---- meta-repair dispatch ----------------------------------------------------
E           # Meta-repair diagnoses and fixes repair-system failures when ordinary repair
E           # has proven insufficient.  It is gated behind META_REPAIR_ENABLED (default-on),
E           # guarded against recursion, and tracked with dedicated marker/pgid sidecars so
E           # the watchdog can observe its lifecycle independently of ordinary repair.
E           
E           run_repair_data_maintenance() {
E             local throttle_secs="${REPAIR_DATA_RETENTION_INTERVAL_SECS:-21600}"
E             [[ "$throttle_secs" =~ ^[0-9]+$ ]] || throttle_secs=21600
E             if (( throttle_secs <= 0 )); then
E               return 0
E             fi
E           
E             PYTHONPATH="${WRAPPER_REPO_ROOT}:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$MARKER_DIR" "$REPAIR_DATA_DIR" "$throttle_secs" <<'PY'
E           import json
E           import pathlib
E           import sys
E           from datetime import datetime, timezone
E           
E           from arnold_pipelines.megaplan.cloud.repair_contract import cleanup_repair_data_retention, load_json
E           from arnold_pipelines.megaplan.cloud.repair_lock import inspect_repair_lock
E           from arnold_pipelines.megaplan.cloud.session_markers import is_canonical_session_marker_path
E           
E           marker_dir = pathlib.Path(sys.argv[1])
E           repair_data_dir = pathlib.Path(sys.argv[2])
E           throttle_secs = int(sys.argv[3])
E           sidecar_dir = repair_data_dir.with_name(f"{repair_data_dir.name}.d")
E           stamp_path = sidecar_dir / "cleanup" / "retention-maintenance.json"
E           now = datetime.now(timezone.utc)
E           
E           previous = load_json(stamp_path, default={})
E           last_started_at = str(previous.get("started_at") or "").strip() if isinstance(previous, dict) else ""
E           if last_started_at:
E               try:
E                   started_at = datetime.fromisoformat(last_started_at)
E               except ValueError:
E                   started_at = None
E               if started_at is not None and (now - started_at).total_seconds() < throttle_secs:
E                   print("THROTTLED")
E                   raise SystemExit(0)
E           
E           for lock_dir in sorted(marker_dir.glob("*.repair-loop.lock")):
E               result = inspect_repair_lock(lock_dir)
E               if result.busy:
E                   print("LOCK_BUSY")
E                   raise SystemExit(0)
E           
E           active_sessions: set[str] = set()
E           for path in sorted(marker_dir.glob("*.json")):
E               if not is_canonical_session_marker_path(path):
E                   continue
E               try:
E                   payload = json.loads(path.read_text(encoding="utf-8"))
E               except Exception:
E                   continue
E               if isinstance(payload, dict):
E                   session = str(payload.get("session") or "").strip()
E                   if session:
E                       active_sessions.add(session)
E           
E           stamp_path.parent.mkdir(parents=True, exist_ok=True)
E           stamp_path.write_text(json.dumps({"started_at": now.isoformat()}, sort_keys=True), encoding="utf-8")
E           summary = cleanup_repair_data_retention(
E               repair_data_dir,
E               sidecar_dir=sidecar_dir,
E               index_path=repair_data_dir / "index.json",
E               now=now,
E               active_session_ids=active_sessions,
E           )
E           stamp_path.write_text(
E               json.dumps(
E                   {
E                       "started_at": now.isoformat(),
E                       "completed_at": datetime.now(timezone.utc).isoformat(),
E                       "cleanup_id": summary.get("cleanup_id", ""),
E                   },
E                   sort_keys=True,
E               ),
E               encoding="utf-8",
E           )
E           print(f"RAN:{summary.get('cleanup_id', '')}")
E           PY
E           }
E           
E           reap_stale_repair_candidates() {
E             python3 - "$REAP_AGE_SECS" "$REAP_ORPHAN_AGE_SECS" <<'PY'
E           import re
E           import sys
E           
E           SESSION_RE = re.compile(r"Session:\s+([^\s]+)")
E           CODEX_RE = re.compile(r"(^|\s)codex exec(\s|$)")
E           RUN_AGENT_HINTS = (
E               "workflows on this Hetzner worker should never pause unexpectedly",
E               "cloud watchdog",
E               "Kimi launch/diagnosis turn",
E           )
E           CODEX_HINTS = (
E               "You are the watchdog repair-loop dev-fix agent",
E               "bounded 3-iteration repair loop",
E               "repair data file",
E               "workflows on this Hetzner worker should not pause unexpectedly",
E           )
E           PROTECTED_HINTS = (
E               "arnold-watchdog",
E               "arnold-progress-auditor",
E           )
E           RULE_PRIORITY = {
E               "orphan_fast_path": 0,
E               "age_backstop": 1,
E           }
E           KIND_PRIORITY = {
E               "arnold.agent.run_agent": 0,
E               "codex exec": 1,
E           }
E           
E           
E           def parse_ps_row(raw: str):
E               parts = raw.strip().split(None, 4)
E               if len(parts) < 5:
E                   return None
E               try:
E                   return {
E                       "pid": int(parts[0]),
E                       "ppid": int(parts[1]),
E                       "pgid": int(parts[2]),
E                       "etimes": int(parts[3]),
E                       "args": parts[4],
E                   }
E               except ValueError:
E                   return None
E           
E           
E           def extract_session(kind: str, args: str) -> str:
E               match = SESSION_RE.search(args)
E               return match.group(1) if match else ""
E           
E           
E           def classify_kind(args: str) -> str:
E               if any(hint in args for hint in PROTECTED_HINTS):
E                   return ""
E               if "arnold.agent.run_agent" in args:
E                   session = extract_session("arnold.agent.run_agent", args)
E                   if session and any(hint in args for hint in RUN_AGENT_HINTS):
E                       return "arnold.agent.run_agent"
E               if CODEX_RE.search(args):
E                   session = extract_session("codex exec", args)
E                   if session and any(hint in args for hint in CODEX_HINTS):
E                       return "codex exec"
E               return ""
E           
E           
E           def decide_reap(row: dict[str, object], age_secs: int, orphan_age_secs: int) -> dict[str, object]:
E               args = str(row.get("args") or "")
E               kind = classify_kind(args)
E               session = extract_session(kind, args) if kind else ""
E               decision = {
E                   "pid": int(row.get("pid") or 0),
E                   "ppid": int(row.get("ppid") or 0),
E                   "pgid": int(row.get("pgid") or 0),
E                   "etimes": int(row.get("etimes") or 0),
E                   "kind": kind,
E                   "session": session,
E                   "reap": False,
E                   "rule": "",
E                   "reason": "non_target" if not kind else "under_age",
E               }
E               if not kind:
E                   return decision
E               if (
E                   kind in {"arnold.agent.run_agent", "codex exec"}
E                   and decision["ppid"] == 1
E                   and decision["etimes"] > orphan_age_secs
E               ):
E                   decision["reap"] = True
E                   decision["rule"] = "orphan_fast_path"
E                   decision["reason"] = "orphaned_ppid_1"
E                   return decision
E               if decision["etimes"] > age_secs:
E                   decision["reap"] = True
E                   decision["rule"] = "age_backstop"
E                   decision["reason"] = "elapsed_exceeded"
E               return decision
E           
E           
E           def choose_reap_candidates(rows: list[dict[str, object]], age_secs: int, orphan_age_secs: int):
E               candidates = [
E                   decide_reap(row, age_secs, orphan_age_secs)
E                   for row in rows
E               ]
E               candidates = [item for item in candidates if item["reap"]]
E               candidates.sort(
E                   key=lambda item: (
E                       item["session"] or "",
E                       item["pgid"],
E                       RULE_PRIORITY[item["rule"]],
E                       KIND_PRIORITY[item["kind"]],
E                       -item["etimes"],
E                       item["pid"],
E                   )
E               )
E               seen_sessions = set()
E               seen_pgids = set()
E               selected = []
E               for item in candidates:
E                   session = item["session"]
E                   pgid = item["pgid"]
E                   if session and session in seen_sessions:
E                       continue
E                   if pgid in seen_pgids:
E                       continue
E                   selected.append(item)
E                   if session:
E                       seen_sessions.add(session)
E                   seen_pgids.add(pgid)
E               return selected
E           
E           
E           def main() -> int:
E               age_secs = int(sys.argv[1])
E               orphan_age_secs = int(sys.argv[2])
E               rows = []
E               for raw in sys.stdin:
E                   row = parse_ps_row(raw)
E                   if row:
E                       rows.append(row)
E               for item in choose_reap_candidates(rows, age_secs, orphan_age_secs):
E                   print(
E                       "\t".join(
E                           [
E                               str(item["pid"]),
E                               str(item["ppid"]),
E                               str(item["pgid"]),
E                               str(item["etimes"]),
E                               str(item["kind"]),
E                               str(item["session"]),
E                               str(item["rule"]),
E                               str(item["reason"]),
E                           ]
E                       )
E                   )
E               return 0
E           
E           
E           if __name__ == "__main__":
E               raise SystemExit(main())
E           PY
E           }
E           
E           reap_stalled_repair_candidates() {
E             python3 - "$MARKER_DIR" "$REPAIR_OPERATOR_ROOT" "$REAP_STALL_GRACE_SECS" "$REAP_STALL_IDLE_SECS" "$REAP_AGE_SECS" <<'PY'
E           import datetime as dt
E           import json
E           import pathlib
E           import re
E           import sys
E           
E           marker_dir = pathlib.Path(sys.argv[1])
E           operator_root = pathlib.Path(sys.argv[2])
E           stall_grace_secs = int(sys.argv[3])
E           stall_idle_secs = int(sys.argv[4])
E           reap_age_secs = int(sys.argv[5])
E           
E           SESSION_RE = re.compile(r"Session:\s+([^\s]+)")
E           CODEX_RE = re.compile(r"(^|\s)codex exec(\s|$)")
E           RUN_AGENT_HINTS = (
E               "workflows on this Hetzner worker should never pause unexpectedly",
E               "cloud watchdog",
E               "Kimi launch/diagnosis turn",
E           )
E           CODEX_HINTS = (
E               "You are the watchdog repair-loop dev-fix agent",
E               "bounded 3-iteration repair loop",
E               "repair data file",
E               "workflows on this Hetzner worker should not pause unexpectedly",
E           )
E           PROTECTED_HINTS = (
E               "arnold-watchdog",
E               "arnold-progress-auditor",
E           )
E           KIND_PRIORITY = {
E               "arnold.agent.run_agent": 0,
E               "codex exec": 1,
E           }
E           RECENT_WINDOW_SECS = max(reap_age_secs, stall_grace_secs + stall_idle_secs, 1800)
E           now = dt.datetime.now(dt.timezone.utc)
E           
E           
E           def parse_ps_row(raw: str):
E               parts = raw.strip().split(None, 4)
E               if len(parts) < 5:
E                   return None
E               try:
E                   return {
E                       "pid": int(parts[0]),
E                       "ppid": int(parts[1]),
E                       "pgid": int(parts[2]),
E                       "etimes": int(parts[3]),
E                       "args": parts[4],
E                   }
E               except ValueError:
E                   return None
E           
E           
E           def extract_session(kind: str, args: str) -> str:
E               match = SESSION_RE.search(args)
E               return match.group(1) if match else ""
E           
E           
E           def classify_kind(args: str) -> str:
E               if any(hint in args for hint in PROTECTED_HINTS):
E                   return ""
E               if "arnold.agent.run_agent" in args:
E                   session = extract_session("arnold.agent.run_agent", args)
E                   if session and any(hint in args for hint in RUN_AGENT_HINTS):
E                       return "arnold.agent.run_agent"
E               if CODEX_RE.search(args):
E                   session = extract_session("codex exec", args)
E                   if session and any(hint in args for hint in CODEX_HINTS):
E                       return "codex exec"
E               return ""
E           
E           
E           def safe_name(value: str) -> str:
E               return re.sub(r"[^A-Za-z0-9_.-]", "-", value)
E           
E           
E           def iso_to_dt(raw: object):
E               if not isinstance(raw, str) or not raw:
E                   return None
E               try:
E                   return dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
E               except ValueError:
E                   return None
E           
E           
E           def file_stats(path: pathlib.Path) -> tuple[float, int]:
E               try:
E                   stat = path.stat()
E               except OSError:
E                   return (0.0, 0)
E               return (float(stat.st_mtime), int(stat.st_size))
E           
E           
E           def snapshot_path_for(session: str) -> pathlib.Path:
E               return marker_dir / f"{session}.reap-progress.json"
E           
E           
E           def find_recent_operator_dir(session: str):
E               if not session or not operator_root.is_dir():
E                   return None
E               safe_session = safe_name(session)
E               candidates = []
E               for path in operator_root.glob(f"*-{safe_session}"):
E                   if not path.is_dir():
E                       continue
E                   log_paths = [candidate for candidate in path.glob("*.log") if candidate.is_file()]
E                   mtimes = [file_stats(path)[0], *(file_stats(candidate)[0] for candidate in log_paths)]
E                   newest_mtime = max(mtimes)
E                   if newest_mtime <= 0:
E                       continue
E                   age_secs = max(0, int((now - dt.datetime.fromtimestamp(newest_mtime, tz=dt.timezone.utc)).total_seconds()))
E                   if age_secs > RECENT_WINDOW_SECS:
E                       continue
E                   candidates.append((newest_mtime, path))
E               if not candidates:
E                   return None
E               candidates.sort(key=lambda item: (item[0], str(item[1])), reverse=True)
E               return candidates[0][1]
E           
E           
E           def assess_session_progress(session: str) -> dict[str, object]:
E               operator_dir = find_recent_operator_dir(session)
E               if operator_dir is None:
E                   return {"mapped": False, "reason": "unmappable"}
E           
E               log_paths = [candidate for candidate in operator_dir.glob("*.log") if candidate.is_file()]
E               stats = [(candidate.name, *file_stats(candidate)) for candidate in log_paths]
E               if not stats:
E                   return {"mapped": False, "reason": "no_logs"}
E               stats.sort(key=lambda item: (item[1], item[2], item[0]), reverse=True)
E               newest_name, newest_mtime, newest_size = stats[0]
E           
E               snapshot = {
E                   "operator_dir": str(operator_dir),
E                   "log_name": newest_name,
E                   "log_mtime": newest_mtime,
E                   "log_size": newest_size,
E               }
E               snapshot_dir = snapshot_path_for(session).parent
E               snapshot_dir.mkdir(parents=True, exist_ok=True)
E               prev = {}
E               snapshot_path = snapshot_path_for(session)
E               if snapshot_path.exists():
E                   try:
E                       prev = json.loads(snapshot_path.read_text(encoding="utf-8"))
E                   except Exception:
E                       prev = {}
E           
E               same_observation = (
E                   prev.get("operator_dir") == snapshot["operator_dir"]
E                   and prev.get("log_name") == snapshot["log_name"]
E                   and prev.get("log_mtime") == snapshot["log_mtime"]
E                   and prev.get("log_size") == snapshot["log_size"]
E               )
E               if same_observation:
E                   last_advance = (
E                       iso_to_dt(prev.get("last_advance_ts"))
E                       or iso_to_dt(prev.get("ts"))
E                       or dt.datetime.fromtimestamp(newest_mtime, tz=dt.timezone.utc)
E                   )
E               else:
E                   if prev:
E                       last_advance = now
E                   else:
E                       last_advance = dt.datetime.fromtimestamp(newest_mtime, tz=dt.timezone.utc)
E               idle_secs = max(0, int((now - last_advance).total_seconds()))
E           
E               persisted = dict(snapshot)
E               persisted["last_advance_ts"] = last_advance.isoformat()
E               persisted["ts"] = now.isoformat()
E               try:
E                   snapshot_path.write_text(json.dumps(persisted, sort_keys=True) + "\n", encoding="utf-8")
E               except Exception:
E                   pass
E           
E               return {
E                   "mapped": True,
E                   "operator_dir": str(operator_dir),
E                   "idle_secs": idle_secs,
E                   "stalled": idle_secs >= stall_idle_secs,
E               }
E           
E           
E           rows_by_session = {}
E           progress_cache = {}
E           for raw in sys.stdin:
E               row = parse_ps_row(raw)
E               if not row:
E                   continue
E               kind = classify_kind(str(row["args"]))
E               if not kind:
E                   continue
E               session = extract_session(kind, str(row["args"]))
E               if not session:
E                   continue
E               row["kind"] = kind
E               row["session"] = session
E               rows_by_session.setdefault(session, []).append(row)
E           
E           candidates = []
E           for session, rows in rows_by_session.items():
E               progress = progress_cache.setdefault(session, assess_session_progress(session))
E               if not progress.get("mapped"):
E                   continue
E               eligible = [row for row in rows if int(row["etimes"]) >= stall_grace_secs]
E               if not eligible or not progress.get("stalled"):
E                   continue
E               eligible.sort(
E                   key=lambda row: (
E                       KIND_PRIORITY[str(row["kind"])],
E                       -int(row["etimes"]),
E                       int(row["pid"]),
E                   )
E               )
E               chosen = eligible[0]
E               candidates.append(
E                   {
E                       "pid": int(chosen["pid"]),
E                       "ppid": int(chosen["ppid"]),
E                       "pgid": int(chosen["pgid"]),
E                       "etimes": int(chosen["etimes"]),
E                       "kind": str(chosen["kind"]),
E                       "session": session,
E                       "rule": "stalled",
E                       "reason": f"stall_idle_{int(progress['idle_secs'])}s",
E                       "operator_dir": str(progress["operator_dir"]),
E                       "idle_secs": int(progress["idle_secs"]),
E                   }
E               )
E           
E           candidates.sort(
E               key=lambda item: (
E                   item["session"],
E                   KIND_PRIORITY[item["kind"]],
E                   -item["etimes"],
E                   item["pid"],
E               )
E           )
E           seen_pgids = set()
E           for item in candidates:
E               pgid = item["pgid"]
E               if pgid in seen_pgids:
E                   continue
E               seen_pgids.add(pgid)
E               print(
E                   "\t".join(
E                       [
E                           str(item["pid"]),
E                           str(item["ppid"]),
E                           str(item["pgid"]),
E                           str(item["etimes"]),
E                           item["kind"],
E                           item["session"],
E                           item["rule"],
E                           item["reason"],
E                           item["operator_dir"],
E                           str(item["idle_secs"]),
E                       ]
E                   )
E               )
E           PY
E           }
E           
E           kill_process_group() {
E             local pgid="$1"
E             [[ "$pgid" =~ ^[0-9]+$ ]] || return 1
E             kill -- "-$pgid" >/dev/null 2>&1 || return 1
E             sleep 0.5
E             if kill -0 -- "-$pgid" >/dev/null 2>&1; then
E               kill -9 -- "-$pgid" >/dev/null 2>&1 || true
E               sleep 0.2
E             fi
E             ! kill -0 -- "-$pgid" >/dev/null 2>&1
E           }
E           
E           repair_tree_pgids() {
E             local root_pid="$1"
E             local root_pgid="$2"
E             [[ "$root_pid" =~ ^[0-9]+$ ]] || return 1
E             [[ "$root_pgid" =~ ^[0-9]+$ ]] || return 1
E             python3 - "$root_pid" "$root_pgid" <<'PY'
E           import subprocess
E           import sys
E           
E           root_pid = int(sys.argv[1])
E           root_pgid = int(sys.argv[2])
E           proc = subprocess.run(
E               ["ps", "-eo", "pid=,ppid=,pgid="],
E               capture_output=True,
E               text=True,
E               check=False,
E           )
E           children = {}
E           pgids = {}
E           for line in proc.stdout.splitlines():
E               parts = line.strip().split()
E               if len(parts) != 3:
E                   continue
E               try:
E                   pid = int(parts[0])
E                   ppid = int(parts[1])
E                   pgid = int(parts[2])
E               except ValueError:
E                   continue
E               children.setdefault(ppid, []).append(pid)
E               pgids[pid] = pgid
E           
E           seen_groups = [root_pgid]
E           
E           def walk(pid: int) -> None:
E               for child in children.get(pid, []):
E                   child_pgid = pgids.get(child)
E                   if child_pgid and child_pgid not in seen_groups:
E                       seen_groups.append(child_pgid)
E                   walk(child)
E           
E           walk(root_pid)
E           print(" ".join(str(group) for group in seen_groups))
E           PY
E           }
E           
E           kill_pid_and_descendants() {
E             local root_pid="$1"
E             local pid_list
E             [[ "$root_pid" =~ ^[0-9]+$ ]] || return 1
E             pid_list="$(
E               python3 - "$root_pid" <<'PY'
E           import subprocess
E           import sys
E           
E           root = int(sys.argv[1])
E           proc = subprocess.run(
E               ["ps", "-eo", "pid=,ppid="],
E               capture_output=True,
E               text=True,
E               check=False,
E           )
E           children = {}
E           for line in proc.stdout.splitlines():
E               parts = line.strip().split()
E               if len(parts) != 2:
E                   continue
E               try:
E                   pid = int(parts[0])
E                   ppid = int(parts[1])
E               except ValueError:
E                   continue
E               children.setdefault(ppid, []).append(pid)
E           
E           order = []
E           
E           def walk(pid: int) -> None:
E               for child in children.get(pid, []):
E                   walk(child)
E                   order.append(child)
E           
E           walk(root)
E           order.append(root)
E           print(" ".join(str(pid) for pid in order))
E           PY
E             )"
E             [[ -n "$pid_list" ]] || return 1
E             local pid
E             for pid in $pid_list; do
E               kill "$pid" >/dev/null 2>&1 || true
E             done
E             sleep 0.5
E             for pid in $pid_list; do
E               kill -0 "$pid" >/dev/null 2>&1 || continue
E               kill -9 "$pid" >/dev/null 2>&1 || true
E             done
E             ! kill -0 "$root_pid" >/dev/null 2>&1
E           }
E           
E           kill_repair_tree_complete() {
E             local root_pid="$1"
E             local root_pgid="$2"
E             local groups group
E             local tried=1
E             [[ "$root_pid" =~ ^[0-9]+$ ]] || return 1
E             [[ "$root_pgid" =~ ^[0-9]+$ ]] || return 1
E             groups="$(repair_tree_pgids "$root_pid" "$root_pgid" 2>/dev/null || true)"
E             if [[ -z "$groups" ]]; then
E               groups="$root_pgid"
E             fi
E             for group in $groups; do
E               if kill_process_group "$group"; then
E                 tried=0
E               fi
E             done
E             if kill_pid_and_descendants "$root_pid"; then
E               tried=0
E             fi
E             for group in $groups; do
E               if kill -0 -- "-$group" >/dev/null 2>&1; then
E                 return 1
E               fi
E             done
E             ! kill -0 "$root_pid" >/dev/null 2>&1 || return 1
E             return "$tried"
E           }
E           
E           reap_stale_repairs() {
E             local report_items="$1"
E             # Step 62: process-reaping family.  Reaping a stale or stalled repair
E             # process may NEVER become accepted repair outside canonical simple_fixer
E             # delegation; a forbidden authority source fails closed with a typed
E             # zero-authority rejection (SC39).  The gate is fail-closed only for
E             # forbidden sources; normal reaping proceeds otherwise.
E             local _wrs_gate_json _wrs_gate_outcome
E             _wrs_gate_json="$(watchdog_repair_state_authority_or_reject live_watchdog arnold-watchdog)" || true
E             _wrs_gate_outcome="$(printf '%s' "$_wrs_gate_json" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("outcome",""))' 2>/dev/null || true)"
E             if [[ "$_wrs_gate_outcome" == "zero_authority_rejected" ]]; then
E               authority_fail_closed "T62-PROCESS-REAP-01"
E               return 0
E             fi
E             local ps_rows candidates marker_path workspace remote_spec
E             local pid ppid pgid etimes kind session rule reason operator_dir stall_idle
E             local live_pgid session_pgid method message
E             declare -A seen_sessions=()
E             declare -A seen_pgids=()
E             ps_rows="$(mktemp)"
E             candidates="$(mktemp)"
E             ps -eww -o pid=,ppid=,pgid=,etimes=,args= 2>/dev/null > "$ps_rows"
E             reap_stale_repair_candidates < "$ps_rows" \
E               | awk -F'\t' 'BEGIN{OFS="\t"} {print $1,$2,$3,$4,$5,$6,$7,$8,"",""}' > "$candidates"
E             reap_stalled_repair_candidates < "$ps_rows" >> "$candidates"
E             while IFS=$'\t' read -r pid ppid pgid etimes kind session rule reason operator_dir stall_idle; do
E               [[ "$pid" =~ ^[0-9]+$ ]] || continue
E               if [[ -n "$session" && -n "${seen_sessions[$session]:-}" ]]; then
E                 continue
E               fi
E               if [[ -n "${seen_pgids[$pgid]:-}" ]]; then
E                 continue
E               fi
E               if ! kill -0 "$pid" >/dev/null 2>&1; then
E                 continue
E               fi
E               method=""
E               session_pgid=""
E               if [[ -n "$session" ]]; then
E                 marker_path="$(session_marker_path "$session")"
E                 if [[ -r "$(kimi_pgid_path "$session")" ]]; then
E                   read -r session_pgid < "$(kimi_pgid_path "$session")" || session_pgid=""
E                   live_pgid="$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ' || true)"
E                   if [[ ! "$session_pgid" =~ ^[0-9]+$ || "$session_pgid" != "$live_pgid" ]]; then
E                     session_pgid=""
E                   fi
E                 fi
E               else
E                 marker_path=""
E               fi
E               if [[ -n "$session_pgid" ]] && kill_repair_tree_complete "$pid" "$session_pgid"; then
E                 method="session_pgid_complete:$session_pgid"
E               elif kill_repair_tree_complete "$pid" "$pgid"; then
E                 method="pgid_complete:$pgid"
E               elif kill_pid_and_descendants "$pid"; then
E                 method="pid_tree:$pid"
E               else
E                 log "stale repair reap failed pid=$pid kind=$kind session=${session:-unknown} rule=$rule age=${etimes}s"
E                 continue
E               fi
E               workspace=""
E               remote_spec=""
E               if [[ -n "$marker_path" && -f "$marker_path" ]]; then
E                 workspace="$(json_field "$marker_path" workspace 2>/dev/null || true)"
E                 remote_spec="$(json_field "$marker_path" remote_spec 2>/dev/null || true)"
E               fi
E               message="reaped stale repair pid=$pid kind=$kind session=${session:-unknown} rule=$rule reason=$reason age=${etimes}s method=$method"
E               if [[ "$rule" == "stalled" ]]; then
E                 message="$message idle=${stall_idle:-unknown}s"
E                 if [[ -n "$operator_dir" ]]; then
E                   message="$message operator_dir=$operator_dir"
E                 fi
E               fi
E               log "$message"
E               report_item "$report_items" "${session:-}" "reap" "reaped" "$message" "$workspace" "$remote_spec"
E               if [[ -n "$session" ]]; then
E                 kimi_dispatch_marker_clear "$session"
E                 seen_sessions["$session"]=1
E               fi
E               seen_pgids["$pgid"]=1
E             done < "$candidates"
E             rm -f "$ps_rows" "$candidates"
E           }
E           
E           chain_current_pr_merged() {
E             # Ground-truth check: is the chain's current-milestone PR merged LIVE (gh)?
E             # Returns "merged", "open", or "unknown". Used to verify a stale
E             # repair-exhausted marker: if the PR merged after the marker was written, the
E             # chain can now reconcile+complete on relaunch, so the marker is stale.
E             local workspace="$1" remote_spec="${2:-}"
E             python3 - "$workspace" "$remote_spec" <<'PY'
E           import json
E           import pathlib
E           import subprocess
E           import sys
E           
E           workspace = pathlib.Path(sys.argv[1])
E           plans_dir = workspace / ".megaplan" / "plans"
E           chain_paths = sorted(
E               {
E                   *plans_dir.glob(".chains/*.json"),
E                   *workspace.glob(".megaplan/initiatives/*/.megaplan/plans/.chains/*.json"),
E                   *(workspace / ".megaplan").glob("**/chain_state.json"),
E               },
E               key=lambda path: path.stat().st_mtime,
E               reverse=True,
E           )
E           for path in chain_paths:
E               try:
E                   payload = json.loads(path.read_text(encoding="utf-8"))
E               except Exception:
E                   continue
E               pr_number = payload.get("pr_number")
E               if not pr_number:
E                   continue
E               try:
E                   proc = subprocess.run(
E                       ["gh", "pr", "view", str(pr_number), "--json", "state"],
E                       cwd=workspace,
E                       check=False,
E                       capture_output=True,
E                       text=True,
E                       timeout=120,
E                   )
E                   if proc.returncode != 0:
E                       continue
E                   state = json.loads(proc.stdout or "{}").get("state", "")
E                   state = state.lower() if isinstance(state, str) else ""
E                   print("merged" if state == "merged" else "open" if state == "open" else "unknown")
E                   raise SystemExit(0)
E               except Exception:
E                   continue
E           print("unknown")
E           PY
E           }
E           
E           chain_wait_status() {
E             local workspace="$1"
E             local remote_spec="${2:-}"
E             PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$workspace" "$remote_spec" <<'PY'
E           import json
E           import os
E           import pathlib
E           import subprocess
E           import sys
E           import time
E           
E           workspace = pathlib.Path(sys.argv[1])
E           remote_spec = sys.argv[2]
E           plans_dir = workspace / ".megaplan" / "plans"
E           chain_paths = sorted(
E               {
E                   *plans_dir.glob(".chains/*.json"),
E                   *workspace.glob(".megaplan/initiatives/*/.megaplan/plans/.chains/*.json"),
E                   *(workspace / ".megaplan").glob("**/chain_state.json"),
E               },
E               key=lambda path: path.stat().st_mtime,
E               reverse=True,
E           )
E           
E           
E           def _spec_path() -> pathlib.Path | None:
E               if not remote_spec:
E                   return None
E               path = pathlib.Path(remote_spec)
E               if not path.is_absolute():
E                   path = workspace / path
E               return path
E           
E           
E           def _merge_policy() -> str:
E               path = _spec_path()
E               if path is None:
E                   return ""
E               try:
E                   for raw_line in path.read_text(encoding="utf-8").splitlines():
E                       line = raw_line.split("#", 1)[0].strip()
E                       if not line.startswith("merge_policy:"):
E                           continue
E                       value = line.split(":", 1)[1].strip().strip("'\"")
E                       if value == "manual":
E                           return "review"
E                       return value
E               except Exception:
E                   return ""
E               return ""
E           
E           
E           def _pr_state(pr_number: int) -> str:
E               proc = subprocess.run(
E                   ["gh", "pr", "view", str(pr_number), "--json", "state"],
E                   cwd=workspace,
E                   check=False,
E                   capture_output=True,
E                   text=True,
E                   timeout=120,
E               )
E               if proc.returncode != 0:
E                   return ""
E               state = json.loads(proc.stdout or "{}").get("state", "")
E               return state.lower() if isinstance(state, str) else ""
E           
E           
E           def _run_merge_command(pr_number: int, *flags: str) -> subprocess.CompletedProcess[str]:
E               return subprocess.run(
E                   ["gh", "pr", "merge", str(pr_number), *flags],
E                   cwd=workspace,
E                   check=False,
E                   capture_output=True,
E                   text=True,
E                   timeout=120,
E               )
E           
E           
E           def _reference_census(root: str) -> tuple[str, list[str]]:
E               """Canonical runtime reference census for *root* (T-0027).
E           
E               Fail-closed gate: ``(CLEAR, [])`` only when every reference store is
E               readable and holds no exact reference to *root*; otherwise the verdict
E               (``REFERENCED`` / ``DANGLING`` / ``UNKNOWN``) plus the census reasons.
E               Callers MUST treat any non-CLEAR verdict as a hard deletion refusal —
E               no route may treat ``--force`` / ``--auto`` as evidence of safety.
E           
E               Store dirs come from the SAME env vars as ``arnold-gc-sweep``
E               (``ARNOLD_REFERENCE_CHAIN_STORE``, ``ARNOLD_REFERENCE_MARKER_STORE``,
E               ``ARNOLD_REFERENCE_SCHEDULE_STORES``, ``ARNOLD_REFERENCE_REPAIR_QUEUE``,
E               ``ARNOLD_REFERENCE_LEASE_STORE``, ``ARNOLD_RUNTIME_MANIFEST_DIR``,
E               ``ARNOLD_BASE_DIR``) with the census module defaults as fallback, so
E               tests sandbox the stores exactly like the sweep.  A raising or
E               unavailable census is ``UNKNOWN`` — delete-on-unknown never happens.
E               """
E               try:
E                   from arnold_pipelines.megaplan.cloud.runtime_references import (
E                       DEFAULT_CHAIN_STORE,
E                       DEFAULT_LEASE_STORE,
E                       DEFAULT_MARKER_STORE,
E                       DEFAULT_REPAIR_QUEUE,
E                       DEFAULT_SCHEDULE_STORE,
E                       normalize_root,
E                       run_census,
E                   )
E               except Exception as exc:  # pragma: no cover - defensive boundary
E                   return "UNKNOWN", [f"reference census unavailable: {exc}"]
E               normalized = normalize_root(str(root))
E               if not normalized:
E                   return "UNKNOWN", [f"root {root!r} is not an absolute runtime root"]
E               try:
E                   return run_census(
E                       root=normalized,
E                       workspace=os.environ.get("ARNOLD_BASE_DIR", ""),
E                       manifest_store=os.environ.get(
E                           "ARNOLD_RUNTIME_MANIFEST_DIR", "/workspace/.megaplan"
E                       ),
E                       current_manifest="",
E                       chain_store=os.environ.get(
E                           "ARNOLD_REFERENCE_CHAIN_STORE", DEFAULT_CHAIN_STORE
E                       ),
E                       marker_store=os.environ.get(
E                           "ARNOLD_REFERENCE_MARKER_STORE", DEFAULT_MARKER_STORE
E                       ),
E                       schedule_store=os.environ.get(
E                           "ARNOLD_REFERENCE_SCHEDULE_STORES", DEFAULT_SCHEDULE_STORE
E                       ),
E                       repair_queue=os.environ.get(
E                           "ARNOLD_REFERENCE_REPAIR_QUEUE", DEFAULT_REPAIR_QUEUE
E                       ),
E                       lease_store=os.environ.get(
E                           "ARNOLD_REFERENCE_LEASE_STORE", DEFAULT_LEASE_STORE
E                       ),
E                   )
E               except Exception as exc:  # pragma: no cover - defensive boundary
E                   return "UNKNOWN", [f"reference census raised: {exc}"]
E           
E           
E           def _census_note(message: str) -> None:
E               # The watchdog's canonical log (LOG in the wrapper) is the durable writer
E               # channel for the census refusal; never let a log failure mask the merge.
E               log_path = os.environ.get("CLOUD_WATCHDOG_LOG", "/workspace/watchdog.log")
E               try:
E                   with open(log_path, "a", encoding="utf-8") as handle:
E                       handle.write(f"[watchdog {time.strftime('%Y-%m-%dT%H:%M:%S%z')}] {message}\n")
E               except Exception:
E                   pass
E           
E           
E           def _attempt_auto_merge(pr_number: int) -> None:
E               subprocess.run(
E                   ["gh", "pr", "ready", str(pr_number)],
E                   cwd=workspace,
E                   check=False,
E                   capture_output=True,
E                   text=True,
E                   timeout=120,
E               )
E               # T-0027: the PR head branch must never be deleted while a runtime store
E               # still references this checkout root (an open PR / manifest / job
E               # reference is load-bearing).  REFERENCED / DANGLING / UNKNOWN all skip
E               # the --delete-branch flag — fail-closed, the deletion is refused even
E               # though the non-destructive merge itself proceeds.  CLEAR keeps the
E               # existing route authority (merge + delete-branch).  The verdict gates
E               # BOTH the auto attempt and the immediate-squash fallback below.
E               census_verdict, census_reasons = _reference_census(str(workspace))
E               delete_branch = census_verdict == "CLEAR"
E               if not delete_branch:
E                   detail = "; ".join(census_reasons) or census_verdict
E                   _census_note(
E                       f"reference census {census_verdict}: refusing --delete-branch for "
E                       f"PR #{pr_number} head branch ({detail})"
E                   )
E               proc = _run_merge_command(
E                   pr_number, "--auto", "--squash", *(["--delete-branch"] if delete_branch else [])
E               )
E               combined = f"{proc.stdout or ''} {proc.stderr or ''}"
E               if proc.returncode == 0:
E                   return
E               if "already checked out" in combined:
E                   _run_merge_command(pr_number, "--auto", "--squash")
E                   return
E               if "Auto merge is not allowed" in combined:
E                   proc = _run_merge_command(
E                       pr_number, "--squash", *(["--delete-branch"] if delete_branch else [])
E                   )
E                   combined = f"{proc.stdout or ''} {proc.stderr or ''}"
E                   if proc.returncode != 0 and "already checked out" in combined:
E                       _run_merge_command(pr_number, "--squash")
E           
E           
E           for path in chain_paths:
E               try:
E                   payload = json.loads(path.read_text(encoding="utf-8"))
E               except Exception:
E                   continue
E               last_state = payload.get("last_state")
E               pr_number = payload.get("pr_number")
E               merge_policy = _merge_policy()
E               finalized_review_wait = False
E               if last_state == "awaiting_pr_merge":
E                   pass
E               elif last_state == "finalized" and pr_number and merge_policy == "review":
E                   try:
E                       finalized_review_wait = _pr_state(int(pr_number)) == "open"
E                   except Exception:
E                       finalized_review_wait = False
E                   if not finalized_review_wait:
E                       continue
E               else:
E                   # ``finalized`` is the pre-execute plan state, not completion evidence.
E                   # External merge authority is available only after the chain driver has
E                   # durably entered awaiting_pr_merge, except for a review-policy PR whose
E                   # external OPEN state proves that execution already crossed that
E                   # boundary. Never infer it from a terminal-looking label alone.
E                   continue
E               if not pr_number:
E                   print("awaiting_pr_merge")
E                   raise SystemExit(0)
E               try:
E                   pr_number_int = int(pr_number)
E                   if _pr_state(pr_number_int) == "merged":
E                       print("none")
E                       raise SystemExit(0)
E                   if merge_policy == "auto":
E                       _attempt_auto_merge(pr_number_int)
E                       if _pr_state(pr_number_int) == "merged":
E                           print("none")
E                           raise SystemExit(0)
E               except Exception:
E                   pass
E               print("awaiting_pr_merge")
E               raise SystemExit(0)
E           
E           print("none")
E           PY
E           }
E           
E           resolve_existing_remote_spec() {
E             local session="$1" workspace="$2" remote_spec="$3" run_kind="${4:-chain}"
E             PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$session" "$workspace" "$remote_spec" "$run_kind" "$MARKER_DIR" <<'PY'
E           import json
E           import pathlib
E           import sys
E           
E           session, workspace_raw, remote_spec_raw, run_kind, marker_dir_raw = sys.argv[1:]
E           workspace = pathlib.Path(workspace_raw)
E           marker_path = pathlib.Path(marker_dir_raw) / f"{session}.json"
E           remote_spec = pathlib.Path(remote_spec_raw) if remote_spec_raw else None
E           if remote_spec is not None and not remote_spec.is_absolute():
E               remote_spec = workspace / remote_spec
E           
E           if remote_spec is not None and remote_spec.exists():
E               print(str(remote_spec))
E               raise SystemExit(0)
E           
E           patterns = []
E           if run_kind == "epic_chain":
E               patterns.extend([
E                   ".megaplan/initiatives/*/assets/epic-chain.yaml",
E                   ".megaplan/initiatives/*/epic-chain.yaml",
E               ])
E           patterns.extend([
E               ".megaplan/initiatives/*/chain.yaml",
E               ".megaplan/briefs/*/chain.yaml",
E           ])
E           
E           candidates: list[pathlib.Path] = []
E           for pattern in patterns:
E               candidates.extend(path for path in workspace.glob(pattern) if path.is_file())
E           
E           if not candidates:
E               print(str(remote_spec or remote_spec_raw or ""))
E               raise SystemExit(0)
E           
E           selected = sorted(candidates, key=lambda path: path.stat().st_mtime, reverse=True)[0]
E           try:
E               payload = json.loads(marker_path.read_text(encoding="utf-8"))
E               if isinstance(payload, dict):
E                   payload["remote_spec"] = str(selected)
E                   marker_path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
E           except Exception:
E               pass
E           
E           print(str(selected))
E           PY
E           }
E           
E           reconcile_awaiting_pr_merge() {
E             local session="$1" workspace="$2" remote_spec="${3:-}"
E             PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$session" "$workspace" "$remote_spec" "$MARKER_DIR" <<'PY'
E           import json
E           import pathlib
E           import subprocess
E           import sys
E           import time
E           
E           session, workspace_raw, remote_spec_raw, marker_dir = sys.argv[1:]
E           workspace = pathlib.Path(workspace_raw)
E           remote_spec = pathlib.Path(remote_spec_raw) if remote_spec_raw else None
E           if remote_spec is not None and not remote_spec.is_absolute():
E               remote_spec = workspace / remote_spec
E           plans_dir = workspace / ".megaplan" / "plans"
E           
E           
E           def emit(status: str, message: str = "") -> None:
E               print(f"{status}\t{message}")
E           
E           
E           def load_json(path: pathlib.Path) -> dict:
E               try:
E                   payload = json.loads(path.read_text(encoding="utf-8"))
E               except Exception:
E                   return {}
E               return payload if isinstance(payload, dict) else {}
E           
E           
E           def advancement_policy() -> tuple[bool, str]:
E               if remote_spec is None:
E                   return False, "chain spec is missing"
E               try:
E                   from arnold_pipelines.megaplan.chain.advancement import policy_for_spec_path
E           
E                   policy = policy_for_spec_path(remote_spec)
E               except Exception as exc:
E                   return False, f"chain advancement policy unreadable: {exc}"
E               return (
E                   policy.automatic_pr_progression,
E                   f"merge_policy={policy.merge_policy} "
E                   f"clean_milestone_pr={policy.clean_milestone_pr} source={policy.source}",
E               )
E           
E           
E           def chain_state_paths() -> list[pathlib.Path]:
E               paths = {
E                   *plans_dir.glob(".chains/*.json"),
E                   *workspace.glob(".megaplan/initiatives/*/.megaplan/plans/.chains/*.json"),
E                   *(workspace / ".megaplan").glob("**/chain_state.json"),
E               }
E               if remote_spec is not None:
E                   sibling = remote_spec.with_name("chain_state.json")
E                   if sibling.exists():
E                       paths.add(sibling)
E               return sorted(paths, key=lambda path: path.stat().st_mtime, reverse=True)
E           
E           
E           def gh_pr_state(pr_number: int) -> tuple[str, str, str]:
E               proc = subprocess.run(
E                   ["gh", "pr", "view", str(pr_number), "--json", "state,mergeCommit,headRefOid"],
E                   cwd=workspace,
E                   check=False,
E                   capture_output=True,
E                   text=True,
E                   timeout=120,
E               )
E               if proc.returncode != 0:
E                   return "", "", ""
E               try:
E                   payload = json.loads(proc.stdout or "{}")
E               except Exception:
E                   return "", "", ""
E               state = payload.get("state")
E               merge_commit = payload.get("mergeCommit")
E               oid = ""
E               if isinstance(merge_commit, dict):
E                   raw_oid = merge_commit.get("oid")
E                   oid = raw_oid if isinstance(raw_oid, str) else ""
E               head_oid = ""
E               raw_head = payload.get("headRefOid")
E               if isinstance(raw_head, str) and raw_head:
E                   head_oid = raw_head
E               return (state.lower() if isinstance(state, str) else "", oid, head_oid)
E           
E           
E           def enqueue_wait_evidence(path: pathlib.Path, pr_number: int, pr_state: str) -> str:
E               # Awaiting a PR merge is expected wait state, not a repair occurrence.
E               # ``watchdog_pr_merge_reconciliation`` and ``pr_boundary_evidence`` are
E               # persisted on the chain state immediately above this call.  Do not mint a
E               # repair identity from PR labels or enqueue an unclaimable repair request.
E               del path, pr_number, pr_state
E               return "read_only"
E           
E           
E           automatic_progression, policy_reason = advancement_policy()
E           if not automatic_progression:
E               emit("review_policy", policy_reason)
E               raise SystemExit(0)
E           
E           for path in chain_state_paths():
E               payload = load_json(path)
E               if payload.get("last_state") != "awaiting_pr_merge":
E                   continue
E               pr_number = payload.get("pr_number")
E               try:
E                   pr_number_int = int(pr_number)
E               except Exception:
E                   emit("missing_pr", f"{path} has no PR number")
E                   raise SystemExit(0)
E               pr_state, merge_oid, pr_head_sha = gh_pr_state(pr_number_int)
E               payload["pr_state"] = pr_state or payload.get("pr_state")
E               payload.setdefault("metadata", {})
E               evidence_ts = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
E               if isinstance(payload["metadata"], dict):
E                   payload["metadata"]["watchdog_pr_merge_reconciliation"] = {
E                       "checked_at": evidence_ts,
E                       "pr_number": pr_number_int,
E                       "pr_state": pr_state or "unknown",
E                       "merge_commit": merge_oid,
E                   }
E                   # PR boundary-contract conformant evidence — queued/waiting/merged
E                   # reconciliation conforms to pr_ready / pr_merged boundary contracts
E                   # (pr.ready.1 / pr.merged.1) while preserving the existing
E                   # watchdog_pr_merge_reconciliation metadata.
E                   boundary_contract_id = "pr.merged.1" if pr_state == "merged" else "pr.ready.1"
E                   boundary_evidence = {
E                       "contract_id": boundary_contract_id,
E                       "boundary_id": "pr_merged" if pr_state == "merged" else "pr_ready",
E                       "workflow_id": "megaplan-review",
E                       "pr_number": pr_number_int,
E                       "pr_state": pr_state or "unknown",
E                       "pr_head_sha": pr_head_sha or None,
E                       "evidence_timestamp": evidence_ts,
E                       "expected_state_delta": {
E                           "pr_stage": "merged" if pr_state == "merged" else pr_state or "ready",
E                       },
E                   }
E                   if pr_state == "merged":
E                       boundary_evidence["merge_commit_sha"] = merge_oid or None
E                   payload["metadata"]["pr_boundary_evidence"] = boundary_evidence
E               try:
E                   path.write_text(json.dumps(payload, sort_keys=True, indent=2) + "\n", encoding="utf-8")
E               except Exception:
E                   pass
E               if pr_state == "merged":
E                   subprocess.run(
E                       ["git", "fetch", "origin", "--prune"],
E                       cwd=workspace,
E                       check=False,
E                       capture_output=True,
E                       text=True,
E                       timeout=180,
E                   )
E                   if merge_oid:
E                       subprocess.run(
E                           ["git", "cat-file", "-e", f"{merge_oid}^{{commit}}"],
E                           cwd=workspace,
E                           check=False,
E                           capture_output=True,
E                           text=True,
E                           timeout=30,
E                       )
E                   emit("merged", f"PR #{pr_number_int} merged; fetched origin for chain relaunch")
E                   raise SystemExit(0)
E               evidence_status = enqueue_wait_evidence(path, pr_number_int, pr_state)
E               emit("waiting", f"PR #{pr_number_int} state={pr_state or 'unknown'} evidence={evidence_status}")
E               raise SystemExit(0)
E           
E           emit("none", "no awaiting auto-policy PR merge state")
E           PY
E           }
E           
E           plan_phase_health_status() {
E             local workspace="$1"
E             local run_kind="${2:-chain}"
E             local plan_name="${3:-}"
E             python3 - "$workspace" "$run_kind" "$plan_name" <<'PY'
E           import datetime as dt
E           import json
E           import pathlib
E           import sys
E           
E           workspace = pathlib.Path(sys.argv[1])
E           run_kind = sys.argv[2]
E           plan_name = sys.argv[3]
E           plans_dir = workspace / ".megaplan" / "plans"
E           if run_kind == "plan" and plan_name:
E               state_files = [plans_dir / plan_name / "state.json"]
E           else:
E               state_files = sorted(
E                   plans_dir.glob("*/state.json"),
E                   key=lambda path: path.stat().st_mtime,
E                   reverse=True,
E               )
E           if not state_files:
E               print("ok")
E               raise SystemExit(0)
E           
E           state_path = state_files[0]
E           if run_kind == "plan" and plan_name and not state_path.exists():
E               print(f"plan_state_missing:{plan_name}")
E               raise SystemExit(0)
E           try:
E               state = json.loads(state_path.read_text(encoding="utf-8"))
E           except Exception as exc:
E               print(f"state_unreadable:{state_path.parent.name}:{exc}")
E               raise SystemExit(0)
E           
E           def _parse_timestamp(value: str) -> dt.datetime | None:
E               text = str(value or "").strip()
E               if not text:
E                   return None
E               if text.endswith("Z"):
E                   text = text[:-1] + "+00:00"
E               try:
E                   parsed = dt.datetime.fromisoformat(text)
E               except ValueError:
E                   return None
E               if parsed.tzinfo is None:
E                   parsed = parsed.replace(tzinfo=dt.timezone.utc)
E               return parsed.astimezone(dt.timezone.utc)
E           
E           
E           now = dt.datetime.now(dt.timezone.utc)
E           active = state.get("active_step") or {}
E           active_phase = str(active.get("phase") or "").strip()
E           active_last_activity = (
E               _parse_timestamp(active.get("last_activity_at"))
E               or _parse_timestamp(active.get("started_at"))
E           )
E           recent_active_state = False
E           events_path = state_path.parent / "events.ndjson"
E           if active_phase:
E               if active_last_activity is not None and (now - active_last_activity) <= dt.timedelta(minutes=5):
E                   recent_active_state = True
E           if not recent_active_state and events_path.exists():
E               try:
E                   events_mtime = dt.datetime.fromtimestamp(events_path.stat().st_mtime, tz=dt.timezone.utc)
E               except OSError:
E                   events_mtime = None
E               if events_mtime is not None and (now - events_mtime) <= dt.timedelta(minutes=5):
E                   recent_active_state = True
E           
E           log_candidates = []
E           for pattern in ("cloud-chain*.log", "cloud-logs/*.log"):
E               log_candidates.extend((workspace / ".megaplan").glob(pattern))
E           log_candidates = sorted(
E               [path for path in log_candidates if path.is_file()],
E               key=lambda path: path.stat().st_mtime,
E               reverse=True,
E           )
E           for log_path in log_candidates[:3]:
E               try:
E                   recent = log_path.read_text(encoding="utf-8", errors="replace").splitlines()[-240:]
E               except Exception:
E                   continue
E               last_sandbox_refusal = -1
E               for idx, line in enumerate(recent):
E                   if "sandbox refused terminal" not in line:
E                       continue
E                   if (
E                       "outside the sandbox root/project directory" in line
E                       or "outside the worktree" in line
E                   ):
E                       last_sandbox_refusal = idx
E               if last_sandbox_refusal >= 0:
E                   later_progress = any(
E                       marker in line
E                       for line in recent[last_sandbox_refusal + 1 :]
E                       for marker in ("[tool]", "[auto ", "[chain]")
E                   )
E                   if later_progress or recent_active_state:
E                       continue
E                   print(
E                       "workspace_drift:"
E                       f"{state_path.parent.name}:"
E                       f"log={log_path.name}:"
E                       "sandbox_refused_outside_project_root"
E                   )
E                   raise SystemExit(0)
E           
E           latest_failure = state.get("latest_failure") or {}
E           failure_kind = latest_failure.get("kind")
E           if failure_kind in {"execution_blocked", "blocked_recovery_not_resolved"}:
E               phase = latest_failure.get("phase") or "execute"
E               recorded_at = latest_failure.get("recorded_at") or ""
E               active = state.get("active_step") or {}
E               active_phase = active.get("phase") or ""
E               active_pid = active.get("worker_pid") or ""
E               active_started = active.get("started_at") or ""
E               current_state = state.get("current_state") or ""
E               message = latest_failure.get("message") or ""
E               print(
E                   "phase_failure:"
E                   f"{state_path.parent.name}:"
E                   f"{phase}:"
E                   "consecutive=1:"
E                   f"recorded={recorded_at or 'unknown'}:"
E                   f"state={current_state or 'unknown'}:"
E                   f"active={active_phase or 'none'}:"
E                   f"started={active_started or 'unknown'}:"
E                   f"pid={active_pid or 'none'}:"
E                   f"{failure_kind}:{message[:140]}"
E               )
E               raise SystemExit(0)
E           if failure_kind != "phase_failed":
E               print("ok")
E               raise SystemExit(0)
E           
E           phase = latest_failure.get("phase") or "unknown"
E           recorded_at = latest_failure.get("recorded_at") or ""
E           history = state.get("history") or []
E           consecutive = 0
E           for item in reversed(history):
E               if item.get("step") == phase and item.get("result") == "error":
E                   consecutive += 1
E                   continue
E               if item.get("step") == phase and item.get("result") == "success":
E                   break
E               if consecutive:
E                   break
E           
E           active = state.get("active_step") or {}
E           active_phase = active.get("phase") or ""
E           active_pid = active.get("worker_pid") or ""
E           active_started = active.get("started_at") or ""
E           current_state = state.get("current_state") or ""
E           message = latest_failure.get("message") or ""
E           
E           success_after_failure = False
E           for item in history:
E               if item.get("step") != phase or item.get("result") != "success":
E                   continue
E               timestamp = item.get("timestamp") or item.get("completed_at") or ""
E               if recorded_at and timestamp and timestamp > recorded_at:
E                   success_after_failure = True
E                   break
E           
E           if success_after_failure:
E               print("ok")
E               raise SystemExit(0)
E           
E           print(
E               "phase_failure:"
E               f"{state_path.parent.name}:"
E               f"{phase}:"
E               f"consecutive={consecutive}:"
E               f"recorded={recorded_at or 'unknown'}:"
E               f"state={current_state or 'unknown'}:"
E               f"active={active_phase or 'none'}:"
E               f"started={active_started or 'unknown'}:"
E               f"pid={active_pid or 'none'}:"
E               f"{message[:160]}"
E           )
E           PY
E           }
E           
E           plan_progress_stall_status() {
E             local workspace="$1"
E             local run_kind="${2:-chain}"
E             local plan_name="${3:-}"
E             python3 - "$workspace" "$MARKER_DIR" "$run_kind" "$plan_name" <<'PY'
E           import datetime as dt
E           import json
E           import os
E           import pathlib
E           import sys
E           
E           workspace = pathlib.Path(sys.argv[1])
E           marker_dir = pathlib.Path(sys.argv[2])
E           run_kind = sys.argv[3]
E           plan_name_arg = sys.argv[4]
E           
E           # Env-tunable thresholds (defaults from the cloud-watchdog progress-stall contract).
E           ITER_MAX = int(os.environ.get("CLOUD_WATCHDOG_STALL_ITERATIONS", "8"))
E           ATTEMPT_MAX = int(os.environ.get("CLOUD_WATCHDOG_STALL_ATTEMPTS", "10"))
E           PLAN_GROWTH_MINS = int(os.environ.get("CLOUD_WATCHDOG_STALL_PLANGROWTH_MINS", "15"))
E           EVENTS_MINS = int(os.environ.get("CLOUD_WATCHDOG_STALL_EVENTS_MINS", "10"))
E           
E           plans_dir = workspace / ".megaplan" / "plans"
E           if run_kind == "plan" and plan_name_arg:
E               state_files = [plans_dir / plan_name_arg / "state.json"]
E           else:
E               state_files = sorted(
E                   plans_dir.glob("*/state.json"),
E                   key=lambda path: path.stat().st_mtime,
E                   reverse=True,
E               )
E           if not state_files:
E               print("ok")
E               raise SystemExit(0)
E           
E           state_path = state_files[0]
E           plan_dir = state_path.parent
E           plan_name = plan_dir.name
E           if run_kind == "plan" and plan_name_arg and not state_path.exists():
E               print(f"plan_state_missing:{plan_name_arg}")
E               raise SystemExit(0)
E           try:
E               state = json.loads(state_path.read_text(encoding="utf-8"))
E           except Exception as exc:
E               print(f"stall_unreadable:{plan_name}:{exc}")
E               raise SystemExit(0)
E           
E           now = dt.datetime.now(dt.timezone.utc)
E           
E           def _age_minutes(mtime_ts):
E               if not mtime_ts:
E                   return None
E               try:
E                   when = dt.datetime.fromtimestamp(mtime_ts, tz=dt.timezone.utc)
E               except (OSError, ValueError, OverflowError):
E                   return None
E               return max(0, int((now - when).total_seconds() // 60))
E           
E           iteration = int(state.get("iteration") or 0)
E           # Top-level iteration can lag the internal milestone counter; the recovery
E           # layer records the live milestone iteration in latest_failure.metadata.iteration.
E           latest_failure = state.get("latest_failure") or {}
E           failure_meta = latest_failure.get("metadata") or {}
E           milestone_iteration = iteration
E           meta_iter = failure_meta.get("iteration")
E           if isinstance(meta_iter, (int, float)) and meta_iter > milestone_iteration:
E               milestone_iteration = int(meta_iter)
E           stall_count = int(failure_meta.get("stall_count") or 0)
E           
E           active_step = state.get("active_step") or {}
E           attempt = int(active_step.get("attempt") or 0)
E           
E           plan_v_files = sorted(plan_dir.glob("plan_v*.md"))
E           plan_v_count = len(plan_v_files)
E           events_path = plan_dir / "events.ndjson"
E           events_mtime = events_path.stat().st_mtime if events_path.exists() else 0
E           
E           # Tick-over-tick snapshot for "no growth while iteration advances" detection.
E           snapshot_dir = marker_dir
E           snapshot_dir.mkdir(parents=True, exist_ok=True)
E           snapshot_path = snapshot_dir / f"{plan_name}.progress.json"
E           prev = {}
E           if snapshot_path.exists():
E               try:
E                   prev = json.loads(snapshot_path.read_text(encoding="utf-8"))
E               except Exception:
E                   prev = {}
E           
E           unchanged_ticks = 0
E           prev_iter = int(prev.get("iteration") or -1)
E           prev_plan_count = int(prev.get("plan_v_count") or -1)
E           if prev:
E               if plan_v_count == prev_plan_count and milestone_iteration >= prev_iter:
E                   unchanged_ticks = int(prev.get("unchanged_ticks") or 0) + 1
E               elif plan_v_count != prev_plan_count:
E                   unchanged_ticks = 0
E               else:
E                   unchanged_ticks = int(prev.get("unchanged_ticks") or 0)
E           
E           snapshot = {
E               "iteration": milestone_iteration,
E               "plan_v_count": plan_v_count,
E               "events_mtime": events_mtime,
E               "unchanged_ticks": unchanged_ticks,
E               "ts": now.isoformat(),
E           }
E           try:
E               snapshot_path.write_text(json.dumps(snapshot, sort_keys=True) + "\n", encoding="utf-8")
E           except Exception:
E               pass
E           
E           newest_plan_age = None
E           if plan_v_files:
E               newest_mtime = max(p.stat().st_mtime for p in plan_v_files)
E               newest_plan_age = _age_minutes(newest_mtime)
E           events_age = _age_minutes(events_mtime)
E           
E           signals = []
E           if milestone_iteration >= ITER_MAX:
E               signals.append(f"iteration={milestone_iteration}>={ITER_MAX}")
E           if attempt and attempt >= ATTEMPT_MAX:
E               signals.append(f"active_step.attempt={attempt}>={ATTEMPT_MAX}")
E           if stall_count >= 3:
E               signals.append(f"stall_count={stall_count}")
E           if (
E               unchanged_ticks >= 2
E               and milestone_iteration > prev_iter
E               and plan_v_count == prev_plan_count
E           ):
E               signals.append(f"plan_v_count={plan_v_count} unchanged-{unchanged_ticks}-ticks")
E           if newest_plan_age is not None and newest_plan_age >= PLAN_GROWTH_MINS and milestone_iteration >= max(2, ITER_MAX - 2):
E               signals.append(f"plan_v_unchanged_{newest_plan_age}m")
E           if events_age is not None and events_age >= EVENTS_MINS and state.get("current_state") not in {None, "completed", "abandoned", "awaiting_review"}:
E               signals.append(f"events_stale={events_age}m")
E           
E           if not signals:
E               print("ok")
E               raise SystemExit(0)
E           
E           detail = " ".join(signals)
E           print(
E               f"progress_stall:{plan_name}:"
E               f"iteration={iteration}:"
E               f"attempt={attempt}:"
E               f"plan_v_count={plan_v_count}:"
E               f"{detail}"
E           )
E           PY
E           }
E           
E           session_terminal_status() {
E             local session="$1"
E             local workspace="$2"
E             local remote_spec="$3"
E             local run_kind="${4:-chain}"
E             local current_target_observation="${5:-}"
E             local marker_dir="${6:-$MARKER_DIR}"
E             [[ "$run_kind" == "chain" || "$run_kind" == "epic_chain" ]] || return 0
E             python3 - "$session" "$workspace" "$remote_spec" "${REPAIR_DATA_DIR:-$MARKER_DIR/repair-data}" "$current_target_observation" "$marker_dir" <<'PY'
E           import hashlib
E           import json
E           import pathlib
E           import sys
E           
E           session, workspace_raw, remote_spec_raw, repair_data_raw, current_target_raw, marker_dir_raw = sys.argv[1:]
E           workspace = pathlib.Path(workspace_raw)
E           remote_spec = pathlib.Path(remote_spec_raw)
E           if not remote_spec.is_absolute():
E               remote_spec = workspace / remote_spec
E           repair_data_dir = pathlib.Path(repair_data_raw)
E           marker_dir = pathlib.Path(marker_dir_raw)
E           
E           
E           def spec_milestone_count() -> int | None:
E               try:
E                   raw = remote_spec.read_text(encoding="utf-8")
E               except Exception:
E                   return None
E               try:
E                   import yaml  # type: ignore
E           
E                   data = yaml.safe_load(raw)
E                   milestones = data.get("milestones") if isinstance(data, dict) else None
E                   if isinstance(milestones, list):
E                       return len(milestones)
E               except Exception:
E                   pass
E               count = 0
E               in_milestones = False
E               for line in raw.splitlines():
E                   if line.startswith("milestones:"):
E                       in_milestones = True
E                       continue
E                   if in_milestones and line and not line.startswith((" ", "-")):
E                       break
E                   if in_milestones and line.lstrip().startswith("-"):
E                       count += 1
E               return count if in_milestones else None
E           
E           
E           SPEC_MILESTONE_COUNT = spec_milestone_count()
E           
E           
E           def is_complete_state(payload: object) -> bool:
E               if not isinstance(payload, dict):
E                   return False
E               last_state = str(payload.get("last_state") or payload.get("current_state") or "").strip()
E               current_plan = str(payload.get("current_plan_name") or "").strip()
E               if last_state not in {"done", "complete", "completed"}:
E                   return False
E               milestones = payload.get("milestones")
E               completed = payload.get("completed")
E               completed_list = completed if isinstance(completed, list) else []
E               if isinstance(milestones, list) and milestones:
E                   if len(completed_list) < len(milestones):
E                       return False
E               elif SPEC_MILESTONE_COUNT is not None and SPEC_MILESTONE_COUNT > 0:
E                   try:
E                       current_index = int(payload.get("current_milestone_index") or 0)
E                   except Exception:
E                       current_index = 0
E                   if len(completed_list) < SPEC_MILESTONE_COUNT and current_index < SPEC_MILESTONE_COUNT:
E                       return False
E               if completed_list:
E                   incomplete = [
E                       item for item in completed_list
E                       if isinstance(item, dict) and str(item.get("status") or "").strip() not in {"done", "complete", "completed"}
E                       and "label" not in item
E                   ]
E                   if incomplete:
E                       return False
E               events = payload.get("events")
E               event_items = events if isinstance(events, list) else []
E               event_text = " ".join(
E                   str(item.get("msg") or item.get("message") or item)
E                   for item in event_items
E               )
E               explicit_chain_complete = payload.get("chain_complete") is True
E               explicit_completion_event = "all milestones complete" in event_text.lower()
E               if (
E                   SPEC_MILESTONE_COUNT is None
E                   and not explicit_chain_complete
E                   and not explicit_completion_event
E               ):
E                   return False
E               if current_plan and not explicit_completion_event:
E                   return False
E               return True
E           
E           
E           def iter_chain_states() -> list[pathlib.Path]:
E               paths: list[pathlib.Path] = []
E               chain_dirs: list[pathlib.Path] = []
E               for base in (workspace, remote_spec.parent):
E                   chain_dir = base / ".megaplan" / "plans" / ".chains"
E                   if chain_dir not in chain_dirs:
E                       chain_dirs.append(chain_dir)
E               for chain_dir in chain_dirs:
E                   if not chain_dir.exists():
E                       continue
E                   digest = hashlib.sha1(str(remote_spec.resolve()).encode("utf-8")).hexdigest()[:12]
E                   expected_paths = [
E                       chain_dir / f"{remote_spec.stem}-{digest}.json",
E                       chain_dir / f"chain-{digest}.json",
E                   ]
E                   paths.extend(path for path in expected_paths if path.exists())
E                   if paths:
E                       return paths
E                   paths.extend(
E                       [
E                           path
E                           for path in expected_paths
E                           if path not in paths
E                       ]
E                   )
E                   paths.extend(sorted(chain_dir.glob("*.json")))
E               return paths
E           
E           
E           def current_target_marks_terminal_stale_chain() -> bool:
E               if not current_target_raw:
E                   return False
E               try:
E                   payload = json.loads(current_target_raw)
E               except Exception:
E                   return False
E               if not isinstance(payload, dict):
E                   return False
E               plan_state = payload.get("plan_state")
E               if not isinstance(plan_state, dict):
E                   return False
E               plan_current_state = str(plan_state.get("current_state") or "").strip().lower()
E               if plan_current_state not in {"done", "complete", "completed"}:
E                   return False
E               stale_evidence = payload.get("stale_evidence")
E               if not isinstance(stale_evidence, list):
E                   return False
E               return any(
E                   isinstance(item, dict)
E                   and str(item.get("kind") or "").strip() == "stale_chain_state_after_terminal_plan"
E                   for item in stale_evidence
E               )
E           
E           def manifest_marks_chain_complete() -> bool:
E               manifest_path = remote_spec.parent / "completion-manifest.json"
E               try:
E                   payload = json.loads(manifest_path.read_text(encoding="utf-8"))
E               except Exception:
E                   return False
E               if not isinstance(payload, dict):
E                   return False
E               if str(payload.get("schema") or "").strip() != "arnold.megaplan.chain_completion_manifest.v1":
E                   return False
E               milestones = payload.get("milestones")
E               if not isinstance(milestones, list) or not milestones:
E                   return False
E               terminal = {"done", "complete", "completed"}
E               statuses = [
E                   str(item.get("status") or "").strip().lower()
E                   for item in milestones
E                   if isinstance(item, dict)
E               ]
E               return len(statuses) == len(milestones) and all(status in terminal for status in statuses)
E           
E           def chain_health_blocks_terminal_shortcut() -> bool:
E               path = marker_dir / f"{session}.chain-health.progress.json"
E               try:
E                   payload = json.loads(path.read_text(encoding="utf-8"))
E               except Exception:
E                   return False
E               if not isinstance(payload, dict):
E                   return False
E               snapshot = payload.get("snapshot")
E               if not isinstance(snapshot, dict):
E                   snapshot = {}
E               chain_complete = payload.get("chain_complete")
E               if chain_complete is None:
E                   chain_complete = snapshot.get("chain_complete")
E               if chain_complete is not False:
E                   return False
E               try:
E                   completed_count = int(payload.get("completed_count") or snapshot.get("completed_count") or 0)
E               except Exception:
E                   completed_count = 0
E               try:
E                   milestone_count = int(payload.get("milestone_count") or snapshot.get("milestone_count") or 0)
E               except Exception:
E                   milestone_count = 0
E               pr_state = str(payload.get("pr_state") or snapshot.get("pr_state") or "").strip().lower()
E               if milestone_count and completed_count < milestone_count:
E                   return True
E               if pr_state and pr_state not in {"merged", "closed"}:
E                   return True
E               return True
E           
E           
E           def current_chain_state_blocks_terminal_shortcut() -> bool:
E               try:
E                   digest = hashlib.sha1(str(remote_spec.resolve()).encode("utf-8")).hexdigest()[:12]
E               except Exception:
E                   digest = ""
E               chain_dirs = [workspace / ".megaplan" / "plans" / ".chains"]
E               if remote_spec.parent != workspace:
E                   chain_dirs.append(remote_spec.parent / ".megaplan" / "plans" / ".chains")
E               candidate_names = ["chain.json"]
E               if digest:
E                   candidate_names.extend([f"{remote_spec.stem}-{digest}.json", f"chain-{digest}.json"])
E               for chain_dir in chain_dirs:
E                   for name in candidate_names:
E                       path = chain_dir / name
E                       if not path.exists():
E                           continue
E                       try:
E                           payload = json.loads(path.read_text(encoding="utf-8"))
E                       except Exception:
E                           continue
E                       if isinstance(payload, dict) and not is_complete_state(payload):
E                           return True
E               return False
E           
E           
E           if (
E               current_target_marks_terminal_stale_chain()
E               and not chain_health_blocks_terminal_shortcut()
E               and not current_chain_state_blocks_terminal_shortcut()
E           ):
E               print("complete\tterminal plan state supersedes stale chain state")
E               raise SystemExit(0)
E           
E           if manifest_marks_chain_complete():
E               print("complete\tcompletion manifest marks chain complete")
E               raise SystemExit(0)
E           
E           
E           for path in iter_chain_states():
E               if not path.exists():
E                   continue
E               try:
E                   payload = json.loads(path.read_text(encoding="utf-8"))
E               except Exception:
E                   continue
E               if is_complete_state(payload):
E                   print("complete\tchain complete")
E                   raise SystemExit(0)
E           
E           data_path = repair_data_dir / f"{session}.repair-data.json"
E           if data_path.exists():
E               try:
E                   payload = json.loads(data_path.read_text(encoding="utf-8"))
E               except Exception:
E                   payload = {}
E               attempts = payload.get("attempts") if isinstance(payload, dict) else []
E               if isinstance(attempts, list):
E                   for attempt in reversed(attempts):
E                       if not isinstance(attempt, dict):
E                           continue
E                       if str(attempt.get("failure_classification") or "") != "chain_completed":
E                           continue
E                       summary = attempt.get("chain_state_summary")
E                       if is_complete_state(summary):
E                           print("complete\tchain complete")
E                           raise SystemExit(0)
E                       context = attempt.get("failure_context")
E                       if isinstance(context, dict) and is_complete_state(context.get("chain_state_summary")):
E                           print("complete\tchain complete")
E                           raise SystemExit(0)
E           PY
E           }
E           
E           repair_goal_watchdog_status() {
E             local session="$1"
E             PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" "$MEGAPLAN_SUPERVISOR_PYTHON" -P - "$MARKER_DIR" "$session" <<'PY' 2>>"${LOG:-/dev/null}"
E           import json
E           import os
E           import pathlib
E           import sys
E           
E           from arnold_pipelines.megaplan.cloud.repair_goal import evaluate_repair_goal
E           
E           marker_dir = pathlib.Path(sys.argv[1])
E           session = "".join(ch if ch.isalnum() or ch in "._-" else "_" for ch in sys.argv[2]) or "unknown"
E           goal_dir = marker_dir / "repair-goals" / session
E           goals = sorted(goal_dir.glob("goal-*.json"), key=lambda path: path.stat().st_mtime, reverse=True)
E           for path in goals:
E               try:
E                   payload = json.loads(path.read_text(encoding="utf-8"))
E               except Exception:
E                   continue
E               if payload.get("status") != "active":
E                   continue
E               result = evaluate_repair_goal(path, action="watchdog_authority_check")
E               status = str(result.get("status") or "active")
E               evaluation = result.get("evaluation") or {}
E               reason = str(evaluation.get("reason") or "")
E               control_action = str(evaluation.get("control_action") or "")
E               observation = result.get("observation") or {}
E               from arnold_pipelines.megaplan.cloud.current_target_liveness import (
E                   control_liveness_from_current_target,
E               )
E               target_liveness = control_liveness_from_current_target(
E                   {"current_target_liveness": observation.get("current_target_liveness")}
E                   if isinstance(observation, dict)
E                   else None,
E                   action="control",
E               )
E               target_worker_live = bool(
E                   target_liveness.get("state") == "live"
E                   and target_liveness.get("known") is True
E               )
E               if status != "active":
E                   print(
E                       f"{status}\t{result.get('goal_id') or ''}\t{reason}\t{control_action}\t"
E                       f"{'true' if target_worker_live else 'false'}"
E                   )
E                   raise SystemExit(0)
E               refreshed = json.loads(path.read_text(encoding="utf-8"))
E               owner_live = False
E               for owner in reversed(refreshed.get("owners") or []):
E                   if not isinstance(owner, dict) or not owner.get("manifest_path"):
E                       continue
E                   try:
E                       manifest = json.loads(pathlib.Path(owner["manifest_path"]).read_text(encoding="utf-8"))
E                       pid = int(manifest.get("pid") or 0)
E                       if manifest.get("status") in {"reserved", "launching", "running", "adopting"} and pid > 0:
E                           os.kill(pid, 0)
E                           owner_live = True
E                           break
E                   except Exception:
E                       continue
E               print(
E                   f"{'active_owner' if owner_live else 'active_unowned'}\t"
E                   f"{result.get('goal_id') or ''}\t{reason}\t{control_action}\t"
E                   f"{'true' if target_worker_live else 'false'}"
E               )
E               raise SystemExit(0)
E           print("none\t\t\t\tfalse")
E           PY
E           }
E           
E           current_target_has_live_worker() {
E             local observation="${1:-}"
E             [[ -n "$observation" ]] || return 1
E             PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$observation" <<'PY'
E           import json
E           import sys
E           
E           from arnold_pipelines.megaplan.cloud.current_target_liveness import (
E               control_liveness_from_current_target,
E           )
E           
E           try:
E               record = json.loads(sys.argv[1])
E           except (IndexError, json.JSONDecodeError, TypeError):
E               raise SystemExit(1)
E           liveness = control_liveness_from_current_target(record, action="control")
E           raise SystemExit(0 if liveness.get("state") == "live" and liveness.get("known") is True else 1)
E           PY
E           }
E           
E           launch_chain_tick() {
E             local session="$1"
E             local workspace="$2"
E             local remote_spec="$3"
E             local report_items="$4"
E             local run_kind="${5:-chain}"
E             local plan_name="${6:-}"
E             local relaunch_command="${7:-}"
E             local remote_spec_path="$remote_spec"
E             local current_target_observation=""
E           
E             if [[ -n "$plan_name" ]]; then
E               run_kind="plan"
E             fi
E           
E             # G5 (T-0021/T-0022, round-6 finding 1b): the engine-root preflight is the
E             # FIRST mutation-gating step in the tick — it runs BEFORE the current-target
E             # subprocesses, before any marker/publication/repair side effect.  A missing
E             # manifest pin or recorded engine-root drift fails closed (typed drift, exit
E             # 24) with ZERO side effects.
E             if [[ "$run_kind" == "plan" ]]; then
E               chain_engine_root_preflight "$workspace" "" "$session" "$plan_name" >/dev/null || return $?
E             else
E               chain_engine_root_preflight "$workspace" "$remote_spec" "$session" >/dev/null || return $?
E             fi
E           
E             # Resolve the one namespace-bound liveness record before any repair,
E             # retrigger, retirement, or relaunch path.  An unreadable/missing/corrupt
E             # record is UNKNOWN and fails closed; raw PID, runner-transition, heartbeat,
E             # tmux, and watchdog-health observations remain report diagnostics only.
E             current_target_observation="$(
E               PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" "$MARKER_DIR" "${REPAIR_DATA_DIR:-$MARKER_DIR/repair-data}" <<'PY' 2>>"${LOG:-/dev/null}" || true
E           import json
E           import pathlib
E           import sys
E           
E           from arnold_pipelines.megaplan.cloud.current_target import resolve_current_target
E           
E           session, workspace, remote_spec, run_kind, plan_name, marker_dir, repair_data_dir = sys.argv[1:]
E           record = resolve_current_target(
E               session,
E               marker_dir=pathlib.Path(marker_dir),
E               repair_data_dir=pathlib.Path(repair_data_dir),
E           )
E           print(json.dumps(record, sort_keys=True))
E           PY
E             )"
E             local canonical_control_state
E             canonical_control_state="$(
E               PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$current_target_observation" <<'PY' 2>>"${LOG:-/dev/null}" || printf unknown
E           import json
E           import sys
E           from arnold_pipelines.megaplan.cloud.current_target_liveness import control_liveness_from_current_target
E           try:
E               target = json.loads(sys.argv[1])
E           except (IndexError, TypeError, ValueError):
E               target = None
E           record = control_liveness_from_current_target(target, action="mutation")
E           # Diagnostic tri-state only. MutationCapability is the grant; unknown remains
E           # readable but cannot authorize babysitter/relaunch.
E           print(record["state"] if record.get("known") is True else "unknown")
E           PY
E             )"
E             # Known live/dead is diagnostic eligibility only. It is never a grant.
E             # Babysitter/relaunch/drive require a minted MutationCapability; without
E             # one this wrapper stays observe-only. UNKNOWN remains a non-granting
E             # denial so incomplete identity cannot relaunch.
E             # Env-gone retirement, alive-path marker-clear, and sidecar stale-clear
E             # are also observe-only unless a minted MutationCapability is attached.
E             local canonical_liveness_known=1
E             if [[ "$canonical_control_state" == "unknown" ]]; then
E               canonical_liveness_known=0
E               log "canonical target liveness is UNKNOWN; continuing read-only classification while mutation/retrigger/escalation/retirement remain fenced session=$session"
E             fi
E             local MUTATION_CAPABILITY_PRESENT="${MUTATION_CAPABILITY_PRESENT:-0}"
E             if [[ "$MUTATION_CAPABILITY_PRESENT" != "1" ]]; then
E               MUTATION_CAPABILITY_PRESENT=0
E             fi
E             log "current-target canonical-control session=$session state=$canonical_control_state known=$canonical_liveness_known capability=$MUTATION_CAPABILITY_PRESENT evidence=$current_target_observation"
E           
E             canonical_mutation_fenced() {
E               local action="${1:-mutation}"
E               log "canonical MutationCapability absent; observe-only fenced action=$action session=$session liveness=$canonical_control_state"
E               report_item "$report_items" "$session" "observe" "capability_absent" \
E                 "known liveness is eligibility only; babysitter/relaunch/drive require a minted MutationCapability; fenced $action" \
E                 "$workspace" "$remote_spec"
E               return 0
E             }
E           
E             # STOPPED PRE-EXECUTE STALL is still a mutation (drive). Known liveness
E             # does not authorize it; without a minted capability the wrapper observes.
E             if babysitter_parked_chain_stall "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" 2>>"${LOG:-/dev/null}"; then
E               if canonical_mutation_fenced "parked pre-execute drive"; then
E                 return 0
E               fi
E             fi
E           
E           
E           
E             # A deterministic phase-contract failure is not a stopped process waiting
E             # for a mechanical restart: the same input will deterministically fail
E             # again.  Read this narrow durable state before any general supervision
E             # helpers and fence relaunch until the canonical repair queue has taken
E             # custody.  Keeping this gate at the top also makes it impossible for a
E             # missing/stale sidecar helper to fall through into tmux relaunch.
E             local phase_contract_status_env
E             phase_contract_status_env="$(
E               plan_attention_status_env \
E                 "$workspace" "$remote_spec" "$run_kind" "$plan_name" \
E                 2>>"${LOG:-/dev/null}" || true
E             )"
E             if [[ -n "$phase_contract_status_env" ]]; then
E               eval "$phase_contract_status_env"
E             fi
E             if [[ "${PLAN_STATUS_FAILURE_KIND:-}" == "deterministic_phase_failure" \
E               && "${PLAN_STATUS_RETRY_STRATEGY:-}" == "repair_phase_contract" ]]; then
E               # Phase-contract fence (Q2 step 2): a deterministic phase-contract failure
E               # is NEVER mechanically relaunched — the same input fails again. The ONLY
E               # repair dispatch is the single-flash babysitter (mode-gated by
E               # driver.babysitter); there is no L1/L2 fallthrough.
E               if canonical_mutation_fenced "phase-contract babysitter dispatch"; then
E                 return 0
E               fi
E               babysitter_policy_dispatch "$session" "$workspace" "$remote_spec_path" "$run_kind" \
E                 "${PLAN_STATUS_PLAN_NAME:-$plan_name}" "$report_items" \
E                 "deterministic phase-contract failure (no mechanical relaunch)"
E               return 0
E             fi
E           
E             PLAN_STATUS_FOUND=0
E             PLAN_STATUS_PLAN_NAME=
E             PLAN_STATUS_CURRENT_STATE=
E             PLAN_STATUS_ACTIVE_STEP_PRESENT=0
E             PLAN_STATUS_ACTIVE_STEP_PHASE=
E             PLAN_STATUS_ACTIVE_STEP_WORKER_PID=
E             PLAN_STATUS_ACTIVE_STEP_PID_ALIVE=
E             PLAN_STATUS_RETRY_STRATEGY=
E             PLAN_STATUS_FAILURE_KIND=
E             PLAN_STATUS_FAILURE_MESSAGE=
E             PLAN_STATUS_FAILURE_PHASE=
E             PLAN_STATUS_FAILURE_RECORDED_AT=
E             PLAN_STATUS_MANUAL_REVIEW_ORIGIN=
E             PLAN_STATUS_TIERS_TRIED=
E             PLAN_STATUS_PUSHED_COMMITS=
E             PLAN_STATUS_MANUAL_REVIEW=0
E             PLAN_STATUS_AWAITING_HUMAN=0
E             PLAN_STATUS_AWAITING_HUMAN_REASON=
E             PLAN_STATUS_STATE_MISMATCH=0
E             PLAN_STATUS_STATE_MISMATCH_SUMMARY=
E             PLAN_STATUS_CHAIN_COMPLETE=0
E             PLAN_STATUS_CHAIN_CURRENT_INDEX=
E             PLAN_STATUS_CHAIN_MILESTONE_COUNT=
E             PLAN_STATUS_DISPATCH_DECISION=
E             PLAN_STATUS_DISPATCH_INTENT=
E             PLAN_STATUS_CUSTODY_BUCKET=
E             PLAN_STATUS_BLOCKER_ID=
E             PLAN_STATUS_REQUEST_ID=
E             PLAN_STATUS_DECISION_ID=
E             PLAN_STATUS_REPAIR_IDENTITY_KEY=
E             PLAN_STATUS_TARGET_SOURCE=
E           
E             local repair_goal_status repair_goal_id repair_goal_reason repair_goal_control_action repair_goal_target_worker_live
E             IFS=$'\t' read -r repair_goal_status repair_goal_id repair_goal_reason repair_goal_control_action repair_goal_target_worker_live <<< "$(repair_goal_watchdog_status "$session" || printf 'none\t\t\t\tfalse')"
E             case "$repair_goal_status" in
E               active_owner)
E                 log "durable repair goal still owns frozen target session=$session goal_id=$repair_goal_id; waiting for authoritative acceptance progress"
E                 report_item "$report_items" "$session" "repair" "repair_running" "durable goal active; target has not moved beyond frozen checkpoint" "$workspace" "$remote_spec"
E                 return 0
E                 ;;
E               active_unowned)
E                 if [[ "$repair_goal_target_worker_live" == "true" ]] \
E                   || current_target_has_live_worker "$current_target_observation"; then
E                   log "durable repair goal is unowned while authoritative target worker remains live; suppressing replacement-owner dispatch session=$session goal_id=$repair_goal_id reason=$repair_goal_reason"
E                   report_item "$report_items" "$session" "observe" "recovery_observation" "preserve authoritative live target worker while durable goal remains open: $repair_goal_reason" "$workspace" "$remote_spec"
E                   return 0
E                 fi
E                 if [[ "$repair_goal_control_action" == "preserve_live" ]]; then
E                   log "durable repair goal is unowned while its fresh matching worker progresses; observing without repair launch session=$session goal_id=$repair_goal_id reason=$repair_goal_reason"
E                   report_item "$report_items" "$session" "observe" "recovery_observation" "preserve fresh matching worker while durable goal remains open: $repair_goal_reason" "$workspace" "$remote_spec"
E                   return 0
E                 fi
E                 if canonical_mutation_fenced "unowned durable-goal babysitter dispatch"; then
E                   return 0
E                 fi
E                 # The durable goal lost its process owner while the target stayed
E                 # frozen (or the post-fixer recovery gate failed). The ONLY repair
E                 # dispatch is the single-flash babysitter; no L1/L2 redispatch.
E                 log "durable repair goal lost its process owner while target remained frozen; dispatching single-flash babysitter session=$session goal_id=$repair_goal_id reason=$repair_goal_reason"
E                 babysitter_policy_dispatch "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" "$report_items" \
E                   "unowned durable repair goal $repair_goal_id; $repair_goal_reason"
E                 return 0
E                 ;;
E               approval_required)
E                 log "durable repair goal reached explicit approval gate session=$session goal_id=$repair_goal_id reason=$repair_goal_reason"
E                 report_item "$report_items" "$session" "observe" "awaiting_human" "explicit approval/authorization gate: $repair_goal_reason" "$workspace" "$remote_spec"
E                 return 0
E                 ;;
E               progressed)
E                 log "durable repair goal verified target progress session=$session goal_id=$repair_goal_id reason=$repair_goal_reason"
E                 ;;
E             esac
E           
E           resolver_needs_human_verdict() {
E             # Consult the canonical resolver to decide whether a watchdog needs-human
E             # escalation should be suppressed in favor of the machine repair/replan path.
E             local session="$1"
E             local current_target_observation="${2:-}"
E             if [[ -z "$current_target_observation" ]]; then
E               return 0
E             fi
E             PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$current_target_observation" <<'PY' 2>>"${LOG:-/dev/null}" || authority_gap_continue "T29-BYPASS-182" "authority-risk bypass converted to typed evidence gap"
E           import json
E           import os
E           import sys
E           
E           from arnold_pipelines.megaplan.cloud.feature_flags import resolver_enforcement_enabled
E           from arnold_pipelines.megaplan.run_state.resolver import resolve_run_state
E           
E           MACHINE_ACTIONABLE_STATES = {
E               "REAL_IMPLEMENTATION_BLOCK",
E               "RETRYABLE_EXECUTION_BLOCK",
E               "BROKEN_STATE_MACHINE",
E           }
E           
E           raw = sys.argv[1] if len(sys.argv) > 1 else ""
E           try:
E               evidence = json.loads(raw) if raw else {}
E           except Exception:
E               evidence = {}
E           
E           provider_retry_enabled = os.environ.get("CLOUD_WATCHDOG_PROVIDER_RETRY_ONCE", "").strip().lower() in {
E               "1", "true", "yes", "on",
E           }
E           if not resolver_enforcement_enabled() and not provider_retry_enabled:
E               sys.exit(0)
E           
E           try:
E               result = resolve_run_state(evidence)
E           except Exception:
E               sys.exit(0)
E           
E           state = result.canonical_state.name
E           human_gate = result.human_gate.name if result.human_gate is not None else None
E           if provider_retry_enabled and state == "HUMAN_ACTION_REQUIRED" and human_gate in {
E               "QUOTA", "CREDENTIAL_ACCOUNT",
E           }:
E               print("provider_retry:{}".format(human_gate))
E               sys.exit(0)
E           if state in MACHINE_ACTIONABLE_STATES and human_gate is None:
E               print("suppress:{}".format(state))
E           PY
E           }
E           
E             local resolver_human_verdict
E             resolver_human_verdict="$(resolver_needs_human_verdict "$session" "$current_target_observation")"
E           
E             local terminal_status terminal_observe terminal_summary
E             terminal_status="$(session_terminal_status "$session" "$workspace" "$remote_spec" "$run_kind" "$current_target_observation" "$MARKER_DIR" 2>>"${LOG:-/dev/null}" || authority_gap_continue "T29-BYPASS-185" "authority-risk bypass converted to typed evidence gap")"

    try:
        target = json.loads(sys.argv[1])
    except (IndexError, TypeError, ValueError):
        target = None
    record = control_liveness_from_current_target(target, action="mutation")
    # Diagnostic tri-state only. MutationCapability is the grant; unknown remains
    # readable but cannot authorize babysitter/relaunch.
    print(record["state"] if record.get("known") is True else "unknown")
    PY
      )"
      # Known live/dead is diagnostic eligibility only. It is never a grant.
      # Babysitter/relaunch/drive require a minted MutationCapability; without
      # one this wrapper stays observe-only. UNKNOWN remains a non-granting
      # denial so incomplete identity cannot relaunch.
      # Env-gone retirement, alive-path marker-clear, and sidecar stale-clear
      # are also observe-only unless a minted MutationCapability is attached.
      local canonical_liveness_known=1
      if [[ "$canonical_control_state" == "unknown" ]]; then
        canonical_liveness_known=0
        log "canonical target liveness is UNKNOWN; continuing read-only classification while mutation/retrigger/escalation/retirement remain fenced session=$session"
      fi
      local MUTATION_CAPABILITY_PRESENT="${MUTATION_CAPABILITY_PRESENT:-0}"
      if [[ "$MUTATION_CAPABILITY_PRESENT" != "1" ]]; then
        MUTATION_CAPABILITY_PRESENT=0
      fi
      log "current-target canonical-control session=$session state=$canonical_control_state known=$canonical_liveness_known capability=$MUTATION_CAPABILITY_PRESENT evidence=$current_target_observation"
    
      canonical_mutation_fenced() {
        local action="${1:-mutation}"
        log "canonical MutationCapability absent; observe-only fenced action=$action session=$session liveness=$canonical_control_state"
        report_item "$report_items" "$session" "observe" "capability_absent" \
          "known liveness is eligibility only; babysitter/relaunch/drive require a minted MutationCapability; fenced $action" \
          "$workspace" "$remote_spec"
        return 0
      }
    
      # STOPPED PRE-EXECUTE STALL is still a mutation (drive). Known liveness
      # does not authorize it; without a minted capability the wrapper observes.
      if babysitter_parked_chain_stall "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" 2>>"${LOG:-/dev/null}"; then
        if canonical_mutation_fenced "parked pre-execute drive"; then
          return 0
        fi
      fi
    
    
    
      # A deterministic phase-contract failure is not a stopped process waiting
      # for a mechanical restart: the same input will deterministically fail
      # again.  Read this narrow durable state before any general supervision
      # helpers and fence relaunch until the canonical repair queue has taken
      # custody.  Keeping this gate at the top also makes it impossible for a
      # missing/stale sidecar helper to fall through into tmux relaunch.
      local phase_contract_status_env
      phase_contract_status_env="$(
        plan_attention_status_env \
          "$workspace" "$remote_spec" "$run_kind" "$plan_name" \
          2>>"${LOG:-/dev/null}" || true
      )"
      if [[ -n "$phase_contract_status_env" ]]; then
        eval "$phase_contract_status_env"
      fi
      if [[ "${PLAN_STATUS_FAILURE_KIND:-}" == "deterministic_phase_failure" \
        && "${PLAN_STATUS_RETRY_STRATEGY:-}" == "repair_phase_contract" ]]; then
        # Phase-contract fence (Q2 step 2): a deterministic phase-contract failure
        # is NEVER mechanically relaunched — the same input fails again. The ONLY
        # repair dispatch is the single-flash babysitter (mode-gated by
        # driver.babysitter); there is no L1/L2 fallthrough.
        if canonical_mutation_fenced "phase-contract babysitter dispatch"; then
          return 0
        fi
        babysitter_policy_dispatch "$session" "$workspace" "$remote_spec_path" "$run_kind" \
          "${PLAN_STATUS_PLAN_NAME:-$plan_name}" "$report_items" \
          "deterministic phase-contract failure (no mechanical relaunch)"
        return 0
      fi
    
      PLAN_STATUS_FOUND=0
      PLAN_STATUS_PLAN_NAME=
      PLAN_STATUS_CURRENT_STATE=
      PLAN_STATUS_ACTIVE_STEP_PRESENT=0
      PLAN_STATUS_ACTIVE_STEP_PHASE=
      PLAN_STATUS_ACTIVE_STEP_WORKER_PID=
      PLAN_STATUS_ACTIVE_STEP_PID_ALIVE=
      PLAN_STATUS_RETRY_STRATEGY=
      PLAN_STATUS_FAILURE_KIND=
      PLAN_STATUS_FAILURE_MESSAGE=
      PLAN_STATUS_FAILURE_PHASE=
      PLAN_STATUS_FAILURE_RECORDED_AT=
      PLAN_STATUS_MANUAL_REVIEW_ORIGIN=
      PLAN_STATUS_TIERS_TRIED=
      PLAN_STATUS_PUSHED_COMMITS=
      PLAN_STATUS_MANUAL_REVIEW=0
      PLAN_STATUS_AWAITING_HUMAN=0
      PLAN_STATUS_AWAITING_HUMAN_REASON=
      PLAN_STATUS_STATE_MISMATCH=0
      PLAN_STATUS_STATE_MISMATCH_SUMMARY=
      PLAN_STATUS_CHAIN_COMPLETE=0
      PLAN_STATUS_CHAIN_CURRENT_INDEX=
      PLAN_STATUS_CHAIN_MILESTONE_COUNT=
      PLAN_STATUS_DISPATCH_DECISION=
      PLAN_STATUS_DISPATCH_INTENT=
      PLAN_STATUS_CUSTODY_BUCKET=
      PLAN_STATUS_BLOCKER_ID=
      PLAN_STATUS_REQUEST_ID=
      PLAN_STATUS_DECISION_ID=
      PLAN_STATUS_REPAIR_IDENTITY_KEY=
      PLAN_STATUS_TARGET_SOURCE=
    
      local repair_goal_status repair_goal_id repair_goal_reason repair_goal_control_action repair_goal_target_worker_live
      IFS=$'\t' read -r repair_goal_status repair_goal_id repair_goal_reason repair_goal_control_action repair_goal_target_worker_live <<< "$(repair_goal_watchdog_status "$session" || printf 'none\t\t\t\tfalse')"
      case "$repair_goal_status" in
        active_owner)
          log "durable repair goal still owns frozen target session=$session goal_id=$repair_goal_id; waiting for authoritative acceptance progress"
          report_item "$report_items" "$session" "repair" "repair_running" "durable goal active; target has not moved beyond frozen checkpoint" "$workspace" "$remote_spec"
          return 0
          ;;
        active_unowned)
          if [[ "$repair_goal_target_worker_live" == "true" ]] \
            || current_target_has_live_worker "$current_target_observation"; then
            log "durable repair goal is unowned while authoritative target worker remains live; suppressing replacement-owner dispatch session=$session goal_id=$repair_goal_id reason=$repair_goal_reason"
            report_item "$report_items" "$session" "observe" "recovery_observation" "preserve authoritative live target worker while durable goal remains open: $repair_goal_reason" "$workspace" "$remote_spec"
            return 0
          fi
          if [[ "$repair_goal_control_action" == "preserve_live" ]]; then
            log "durable repair goal is unowned while its fresh matching worker progresses; observing without repair launch session=$session goal_id=$repair_goal_id reason=$repair_goal_reason"
            report_item "$report_items" "$session" "observe" "recovery_observation" "preserve fresh matching worker while durable goal remains open: $repair_goal_reason" "$workspace" "$remote_spec"
            return 0
          fi
          if canonical_mutation_fenced "unowned durable-goal babysitter dispatch"; then
            return 0
          fi
          # The durable goal lost its process owner while the target stayed
          # frozen (or the post-fixer recovery gate failed). The ONLY repair
          # dispatch is the single-flash babysitter; no L1/L2 redispatch.
          log "durable repair goal lost its process owner while target remained frozen; dispatching single-flash babysitter session=$session goal_id=$repair_goal_id reason=$repair_goal_reason"
          babysitter_policy_dispatch "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" "$report_items" \
            "unowned durable repair goal $repair_goal_id; $repair_goal_reason"
          return 0
          ;;
        approval_required)
          log "durable repair goal reached explicit approval gate session=$session goal_id=$repair_goal_id reason=$repair_goal_reason"
          report_item "$report_items" "$session" "observe" "awaiting_human" "explicit approval/authorization gate: $repair_goal_reason" "$workspace" "$remote_spec"
          return 0
          ;;
        progressed)
          log "durable repair goal verified target progress session=$session goal_id=$repair_goal_id reason=$repair_goal_reason"
          ;;
      esac
    
    resolver_needs_human_verdict() {
      # Consult the canonical resolver to decide whether a watchdog needs-human
      # escalation should be suppressed in favor of the machine repair/replan path.
      local session="$1"
      local current_target_observation="${2:-}"
      if [[ -z "$current_target_observation" ]]; then
        return 0
      fi
      PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$current_target_observation" <<'PY' 2>>"${LOG:-/dev/null}" || authority_gap_continue "T29-BYPASS-182" "authority-risk bypass converted to typed evidence gap"
    import json
    import os
    import sys
    
    from arnold_pipelines.megaplan.cloud.feature_flags import resolver_enforcement_enabled
    from arnold_pipelines.megaplan.run_state.resolver import resolve_run_state
    
    MACHINE_ACTIONABLE_STATES = {
        "REAL_IMPLEMENTATION_BLOCK",
        "RETRYABLE_EXECUTION_BLOCK",
        "BROKEN_STATE_MACHINE",
    }
    
    raw = sys.argv[1] if len(sys.argv) > 1 else ""
    try:
        evidence = json.loads(raw) if raw else {}
    except Exception:
        evidence = {}
    
    provider_retry_enabled = os.environ.get("CLOUD_WATCHDOG_PROVIDER_RETRY_ONCE", "").strip().lower() in {
        "1", "true", "yes", "on",
    }
    if not resolver_enforcement_enabled() and not provider_retry_enabled:
        sys.exit(0)
    
    try:
        result = resolve_run_state(evidence)
    except Exception:
        sys.exit(0)
    
    state = result.canonical_state.name
    human_gate = result.human_gate.name if result.human_gate is not None else None
    if provider_retry_enabled and state == "HUMAN_ACTION_REQUIRED" and human_gate in {
        "QUOTA", "CREDENTIAL_ACCOUNT",
    }:
        print("provider_retry:{}".format(human_gate))
        sys.exit(0)
    if state in MACHINE_ACTIONABLE_STATES and human_gate is None:
        print("suppress:{}".format(state))
    PY
    }
    
      local resolver_human_verdict
      resolver_human_verdict="$(resolver_needs_human_verdict "$session" "$current_target_observation")"
    
      local terminal_status terminal_observe terminal_summary
      terminal_status="$(session_terminal_status "$session" "$workspace" "$remote_spec" "$run_kind" "$current_target_observation" "$MARKER_DIR" 2>>"${LOG:-/dev/null}" || authority_gap_continue "T29-BYPASS-185" "authority-risk bypass converted to typed evidence gap")"
      if [[ "$terminal_status" == complete$'\t'* ]]; then
        terminal_observe="${terminal_status%%$'\t'*}"
        terminal_summary="${terminal_status#*$'\t'}"
        log "terminal chain state observed; skipping repair/relaunch session=$session summary=$terminal_summary"
        report_item "$report_items" "$session" "observe" "$terminal_observe" "$terminal_summary" "$workspace" "$remote_spec"
        return 0
      fi
    
      local health
      health="$(session_health_status "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name")"
    
      # Human gates are durable wait dispositions, not failed executions. Resolve
      # them before liveness, stale-sidecar, chain-health, or relaunch policy can
      # accidentally turn the wait into L1/L2 repair. A canonical resolver may
      # still admit a separately typed machine-repair disposition.
      local early_plan_status_env
      early_plan_status_env="$(plan_attention_status_env "$workspace" "$remote_spec_path" "$run_kind" "$plan_name" 2>>"${LOG:-/dev/null}" || authority_gap_continue "T29-BYPASS-186A" "authority-risk bypass converted to typed evidence gap")"
      if [[ -n "$early_plan_status_env" ]]; then
        eval "$early_plan_status_env"
      fi
      # A gate escalation (latest_failure.kind=gate_escalated with
      # resume_cursor.retry_strategy=human_decision) is a REAL human gate that
      # parks the plan in blocked state — the watchdog previously never
      # classified it as needs-human, so the user got no DM and the fixer
      # burned cycles "repairing" a plan awaiting a human decision. Route it
      # into the existing stable_human_gate notify path (codex consult,
      # astrid m4 NSA-1 Reigh-authority gate).
      if [[ "${PLAN_STATUS_FAILURE_KIND:-}" == "gate_escalated" \
        || "${PLAN_STATUS_RETRY_STRATEGY:-}" == "human_decision" ]]; then
        PLAN_STATUS_AWAITING_HUMAN=1
        resolver_human_verdict=
      fi
      if [[ "$resolver_human_verdict" != provider_retry:* && "${PLAN_STATUS_AWAITING_HUMAN:-0}" == "1" ]]; then
        local early_human_summary early_stale_marker_plans
        early_human_summary="awaiting_human halt; state=${PLAN_STATUS_CURRENT_STATE:-unknown}; reason=${PLAN_STATUS_AWAITING_HUMAN_REASON:-plan is awaiting human action}"
        if [[ -n "${PLAN_STATUS_FAILURE_KIND:-}" ]]; then
          early_human_summary="$early_human_summary; failure=${PLAN_STATUS_FAILURE_KIND}"
        fi
        if [[ "$resolver_human_verdict" == suppress:* ]]; then
          # The canonical resolver suppressed the human gate and admitted a

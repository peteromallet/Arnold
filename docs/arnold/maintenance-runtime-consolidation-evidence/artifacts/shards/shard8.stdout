E                   log "session awaits human action; preserving matching repair evidence without suppressing typed gate session=$session summary=$repair_summary"
E                 fi
E               fi
E               log "session reached stable human gate; notifying without repair or relaunch session=$session plan=${PLAN_STATUS_PLAN_NAME:-} summary=$human_summary"

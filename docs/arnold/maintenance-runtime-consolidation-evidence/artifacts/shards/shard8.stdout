E             # scan. If the watchdog cannot import its own cloud modules, never continue
E             # silently on a stale report.
E             if ! bootstrap_watchdog_observation "$report_items"; then
E               emit_report "$report_items" 0
E               rm -f "$report_items"
E               return 1
E             fi

E                 rm -f "$(repair_needs_human_path "$session")" 2>/dev/null || authority_gap_continue "T29-BYPASS-204" "authority-risk bypass converted to typed evidence gap"
E                 log "stale repair needs-human marker cleared; sibling session is alive session=$session sibling=$sibling_alive"

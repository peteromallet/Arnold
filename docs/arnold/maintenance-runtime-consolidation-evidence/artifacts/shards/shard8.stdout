E                 local repair_summary
E                 repair_summary="$(repair_needs_human_summary "$session")"
E                 log "session marked needs human by repair loop; observe-only without MutationCapability session=$session summary=$repair_summary"
E                 report_item "$report_items" "$session" "observe" "needs_human" "$repair_summary" "$workspace" "$remote_spec"
E                 return 0
E               fi

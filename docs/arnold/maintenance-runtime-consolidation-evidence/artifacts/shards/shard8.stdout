E                 report_item "$report_items" "$session" "observe" "awaiting_human" "$human_summary" "$workspace" "$remote_spec"
E                 return 0
E               fi
E               notify_needs_human \
E                 "$report_items" "$session" "$workspace" "$remote_spec" "$run_kind" "$health" \
E                 "$human_summary" "stable_human_gate"
E               return 0
E             fi
E             if [[ "$resolver_human_verdict" != provider_retry:* && "${PLAN_STATUS_MANUAL_REVIEW:-0}" == "1" ]]; then
E               local human_summary manual_review_origin
E               manual_review_origin="${PLAN_STATUS_MANUAL_REVIEW_ORIGIN:-}"
E               human_summary="manual_review halt; state=${PLAN_STATUS_CURRENT_STATE:-unknown}; retry=${PLAN_STATUS_RETRY_STRATEGY:-unknown}; failure=${PLAN_STATUS_FAILURE_KIND:-unknown}"
E               if [[ -n "$manual_review_origin" ]]; then
E                 human_summary="$human_summary; origin=$manual_review_origin"
E               fi
E               if [[ -n "${PLAN_STATUS_FAILURE_MESSAGE:-}" ]]; then
E                 human_summary="$human_summary; detail=${PLAN_STATUS_FAILURE_MESSAGE}"
E               fi
E               if [[ -n "${PLAN_STATUS_TIERS_TRIED:-}" ]]; then
E                 human_summary="$human_summary; tiers=${PLAN_STATUS_TIERS_TRIED}"
E               fi
E               if [[ -n "${PLAN_STATUS_PUSHED_COMMITS:-}" ]]; then
E                 human_summary="$human_summary; commits=${PLAN_STATUS_PUSHED_COMMITS}"
E               fi
E               if [[ "$resolver_human_verdict" == suppress:* ]]; then
E                 # The canonical resolver suppressed the human gate and admitted a
E                 # machine-repair disposition (old resolver L1). The ONLY repair
E                 # dispatch is the single-flash babysitter.
E                 if canonical_mutation_fenced "resolver babysitter dispatch"; then
E                   return 0
E                 fi
E                 babysitter_policy_dispatch "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" "$report_items" \
E                   "resolver suppressed human gate: ${resolver_human_verdict#suppress:}; $human_summary"
E                 return 0
E               fi
E               quality_block_dispatch="${PLAN_STATUS_DISPATCH_DECISION:-}"
E               if [[ "${PLAN_STATUS_FAILURE_KIND:-}" == "blocked_recovery_not_resolved" ]] \
E                 || [[ "$quality_block_dispatch" == "dispatch_l1_repair" ]] \
E                 || [[ "$manual_review_origin" == "auto_stall" || "$manual_review_origin" == "auto_stall_legacy" ]]; then
E                 # Quality-block babysitter admission is SOLELY the classifier decision
E                 # emitted by plan_attention_status_env. quality_gate_blocked /
E                 # review_quality_blocked_unknown / quality_gate_circuit_open MUST NOT
E                 # OR into this predicate. They reach babysitter only when
E                 # classify_repair_dispatch already classified dispatch_l1_repair from
E                 # complete evidence-bound quality-block shape.
E                 # blocked_recovery_not_resolved and auto_stall remain non-quality paths.
E                 # A durable needs-human marker that survives the fresh-classifier

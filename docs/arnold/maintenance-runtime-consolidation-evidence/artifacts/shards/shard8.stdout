E                       log "stale repair needs-human marker cleared; fresh classifier no longer requires human session=$session live_plan=${PLAN_STATUS_PLAN_NAME:-unknown}"
E                     fi
E                   fi
E                   if [[ -f "$(repair_needs_human_path "$session")" ]]; then
E                     local repair_summary
E                     repair_summary="$(repair_needs_human_summary "$session")"
E                     log "session auto-stalled into manual_review and repair loop already requested human session=$session summary=$repair_summary"
E                     report_item "$report_items" "$session" "observe" "needs_human" "$repair_summary" "$workspace" "$remote_spec"
E                     return 0
E                   fi
E                 fi

E                 elif race_health="$(verify_relaunch_health "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name")"; then
E                   log "relaunch raced with existing tmux session; verified health=$race_health session=$session"
E                   report_item "$report_items" "$session" "restart" "restarted" "session exists after relaunch race" "$workspace" "$remote_spec"
E                 else

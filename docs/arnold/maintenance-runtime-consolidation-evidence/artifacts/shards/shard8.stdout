E           export ARNOLD_SUPERVISE_SESSION=$(printf '%q' "$session")
E           export ARNOLD_SUPERVISE_WORKSPACE=$(printf '%q' "$workspace")
E           export ARNOLD_SUPERVISE_REMOTE_SPEC=$(printf '%q' "$remote_spec")

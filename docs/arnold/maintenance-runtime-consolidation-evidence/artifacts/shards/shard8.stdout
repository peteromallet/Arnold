E                   local stale_marker_plans
E                   stale_marker_plans="$(repair_needs_human_matches_current_plan "$session" "${PLAN_STATUS_PLAN_NAME:-}" 2>/dev/null)" || {
E                     if [[ "${MUTATION_CAPABILITY_PRESENT:-0}" != "1" ]]; then
E                       log "stale repair needs-human marker preserved; observe-only without minted MutationCapability session=$session live_plan=${PLAN_STATUS_PLAN_NAME:-unknown} marker_plans=${stale_marker_plans:-unknown}"
E                     else
E                       rm -f "$(repair_needs_human_path "$session")" 2>/dev/null || authority_gap_continue "T29-BYPASS-200" "authority-risk bypass converted to typed evidence gap"
E                       log "stale repair needs-human marker cleared; live current plan supersedes marker session=$session live_plan=${PLAN_STATUS_PLAN_NAME:-unknown} marker_plans=${stale_marker_plans:-unknown}"
E                     fi
E                   }
E                   if [[ -n "${stale_marker_plans:-}" ]]; then
E                     compare_needs_human_to_resolver "$session" "${PLAN_STATUS_PLAN_NAME:-}" "true" "$stale_marker_plans"
E                   else
E                     compare_needs_human_to_resolver "$session" "${PLAN_STATUS_PLAN_NAME:-}" "false" ""
E                   fi
E                   if [[ -f "$(repair_needs_human_path "$session")" ]] && command -v repair_needs_human_should_remain_human >/dev/null 2>&1 && ! repair_needs_human_should_remain_human "$session" "${PLAN_STATUS_PLAN_NAME:-}"; then
E                     if [[ "${MUTATION_CAPABILITY_PRESENT:-0}" != "1" ]]; then
E                       log "stale repair needs-human marker preserved; observe-only without minted MutationCapability session=$session live_plan=${PLAN_STATUS_PLAN_NAME:-unknown}"
E                     else

E                   log "relaunch raced with existing tmux session but substantive launch failed health=$race_health session=$session"
E                   report_item "$report_items" "$session" "restart" "restart_failed" "session exists after relaunch race but launch health=$race_health" "$workspace" "$remote_spec"

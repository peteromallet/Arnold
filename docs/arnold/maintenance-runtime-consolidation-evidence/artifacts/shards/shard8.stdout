E                 return 0
E               fi
E               notify_needs_human "$report_items" "$session" "$workspace" "$remote_spec" "$run_kind" "$health" "$human_summary"
E               return 0
E             fi
E           
E             # The repair loop leaves a persistent sidecar after 3 bounded failures so the
E             # watchdog reports needs-human instead of immediately re-arming automation.
E             # Ground-truth guard: that marker reflects a PAST exhaustion. If the chain's
E             # current-milestone PR has since MERGED, the chain can now reconcile+complete
E             # on relaunch, so the marker is stale -- clear it and fall through to the
E             # relaunch path instead of suppressing it with a stale needs_human.

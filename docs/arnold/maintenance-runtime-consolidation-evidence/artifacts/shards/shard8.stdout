      current_target_observation="$(
        PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" "$MARKER_DIR" "${REPAIR_DATA_DIR:-$MARKER_DIR/repair-data}" <<'PY' 2>>"${LOG:-/dev/null}" || true
    import json
    import pathlib
    import sys
    
    from arnold_pipelines.megaplan.cloud.current_target import resolve_current_target
    
    session, workspace, remote_spec, run_kind, plan_name, marker_dir, repair_data_dir = sys.argv[1:]
    record = resolve_current_target(
        session,
        marker_dir=pathlib.Path(marker_dir),
        repair_data_dir=pathlib.Path(repair_data_dir),
    )
    print(json.dumps(record, sort_keys=True))
    PY
      )"
      local canonical_control_state
      canonical_control_state="$(
        PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$current_target_observation" <<'PY' 2>>"${LOG:-/dev/null}" || printf unknown
    import json
    import sys

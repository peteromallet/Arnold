+def validation_failure_recoverable_shape(
+    state: Mapping[str, Any],
+    resume_cursor: Mapping[str, Any],
+) -> bool:
+    """Recognize the narrow, pre-dispatch validation-failure repair route.
+
+    This is deliberately separate from generic blocked recovery: a validation
+    job that failed before worker dispatch may be repaired, but only for the
+    exact execute occurrence recorded by the state machine.  Provider,
+    quality, admission, and human-action blockers remain independently
+    authoritative after the repair transition.
+    """
+    latest_failure = state.get("latest_failure")
+    if not isinstance(latest_failure, Mapping):
+        return False
+    metadata = latest_failure.get("metadata")
+    metadata = metadata if isinstance(metadata, Mapping) else {}
+    return bool(
+        state.get("current_state") == "blocked"
+        and latest_failure.get("kind") == "pre_dispatch_validation_failed"
+        and latest_failure.get("phase") == "execute"
+        and resume_cursor.get("phase") == "execute"
+        and resume_cursor.get("retry_strategy") == "repair_validation_failure"
+        and metadata.get("worker_dispatched") is False
+        and str(metadata.get("occurrence_id") or "").strip()
+        and str(metadata.get("signature") or "").strip()
+    )
+
+
+def validated_validation_failure_repair(
+    project_dir: Path,
+    plan_dir: Path,
+    state: Mapping[str, Any],
+    resume_cursor: Mapping[str, Any],
+    repair_commit: object,
+    failure_fingerprint: object,
+) -> dict[str, str] | None:
+    """Validate an occurrence-bound, passing repair receipt for a VJ failure.
+
+    The receipt is intentionally file-backed and content-bound.  A caller
+    cannot clear a validation block by merely repeating ``recover-blocked``:
+    the exact occurrence signature, current source revision, and a fresh
+    passing command receipt must all agree.
+    """
+    if not validation_failure_recoverable_shape(state, resume_cursor):
+        return None
+    latest_failure = state["latest_failure"]
+    metadata = latest_failure.get("metadata")
+    assert isinstance(metadata, Mapping)
+    occurrence_id = str(metadata.get("occurrence_id") or "").strip()
+    signature = str(metadata.get("signature") or "").strip()
+    expected_signature = signature.removeprefix("sha256:").lower()
+    supplied_signature = str(failure_fingerprint or "").strip().removeprefix("sha256:").lower()
+    if not supplied_signature or supplied_signature != expected_signature:
+        raise CliError(
+            "validation_repair_fingerprint_mismatch",
+            "validation repair must bind the exact current VJ occurrence signature",
+            extra={"expected": expected_signature, "supplied": supplied_signature},
+        )
+
+    commit = str(repair_commit or "").strip().lower()
+    if len(commit) != 40 or any(char not in "0123456789abcdef" for char in commit):
+        raise CliError(
+            "missing_validation_repair_commit",
+            "validation repair requires --repair-commit bound to the target workspace HEAD",
+        )
+    try:
+        result = subprocess.run(
+            ["git", "rev-parse", "HEAD"],
+            cwd=project_dir,
+            capture_output=True,
+            text=True,
+            timeout=10,
+            check=False,
+        )
+    except (OSError, subprocess.TimeoutExpired) as error:
+        raise CliError(
+            "validation_repair_head_unavailable",
+            "validation repair could not verify the target workspace HEAD",
+            extra={"project_dir": str(project_dir), "error": str(error)},
+        ) from error
+    current_head = result.stdout.strip().lower() if result.returncode == 0 else ""
+    if current_head != commit:
+        raise CliError(
+            "validation_repair_commit_mismatch",
+            "validation repair commit does not match the target workspace HEAD",
+            extra={"repair_commit": commit, "workspace_head": current_head},
+        )
+
+    safe_occurrence = re.sub(r"[^A-Za-z0-9_.-]", "_", occurrence_id)
+    artifact_path = plan_dir / "validation_repairs" / f"VJ8-{safe_occurrence}.json"
+    try:
+        artifact = json.loads(artifact_path.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError) as error:
+        raise CliError(
+            "missing_validation_repair_evidence",
+            "validation repair requires a readable occurrence-bound passing receipt",
+            extra={"path": str(artifact_path), "error": str(error)},
+        ) from error
+    if not isinstance(artifact, Mapping):
+        raise CliError("invalid_validation_repair_evidence", "validation repair receipt must be an object")
+    artifact_signature = str(artifact.get("failure_signature") or "").strip().removeprefix("sha256:").lower()
+    if (
+        artifact.get("schema_version") != 1
+        or artifact.get("occurrence_id") != occurrence_id
+        or artifact_signature != expected_signature
+        or artifact.get("job_id") != metadata.get("job_id")
+        or artifact.get("exit_code") != 0
+        or artifact.get("tests_passed") is not True
+        or artifact.get("source_revision") != current_head
+        or not str(artifact.get("runtime_code_hash") or "").strip()
+    ):
+        raise CliError(
+            "invalid_validation_repair_evidence",
+            "validation repair receipt is not bound to the current VJ occurrence and source",
+            extra={"path": str(artifact_path), "artifact": dict(artifact)},
+        )
+    return {
+        "failure_kind": "pre_dispatch_validation_failed",
+        "phase": "execute",
+        "job_id": str(metadata.get("job_id") or ""),
+        "occurrence_id": occurrence_id,
+        "failure_signature": expected_signature,
+        "repair_commit": commit,
+        "workspace_head": current_head,
+        "runtime_code_hash": str(artifact.get("runtime_code_hash")),
+        "artifact": str(artifact_path),
+        "authority": "occurrence_bound_validation_receipt",
+    }
+

            }
        ],
        "validation_jobs": [],
        "sense_checks": [],
    }


def _report() -> dict[str, object]:
    return {
        "admitted": False,
        "task_contract_hash": "candidate-hash",
        "diagnostics": [
            {
                "code": "routing_dependency_forbidden",
                "task_ids": ["T15", "T6"],
            },
            {
                "code": "write_overlap_unordered",
                "task_ids": ["T15", "T6"],

+    "canonical_owner": "Megaplan finalize contract owner: orchestration/task_splitter.py transform, handlers/finalize.py mutation/publication order, orchestration/task_feasibility.py and critique_custody.py consumers, graph_admission/control_interface circuit transition, and Run Authority/Custody/WBC recovery admission.",
+    "machine_readable_contract": "Adopt arnold.megaplan.task_reference_closure.v1: a versioned split map containing original_id, impl_id, proof_id, mapping semantics per typed field, source runtime content/revision, deterministic collision diagnostics, and a closure digest over every typed task-reference family. Bind that digest into task_feasibility, critique_custody, finalize publication, recovery request, and terminal verification.",
+    "changes": {
+      "modules": [
+        "Centralize the two-pass split map and typed reference normalization in orchestration/task_splitter.py; eliminate callers that consume only the replacement task list.",
+        "Move the closure assertion and critique-custody validation before the first task_feasibility.json write in handlers/finalize.py; compile validation_jobs only from the transformed graph.",
+        "Make graph_admission/control_interface persist a recoverable circuit-open failure/cursor atomically and expose a narrow, authority-bound migration for legacy projections.",
+        "Make execute/review/recovery consumers verify the bound closure digest rather than assuming task IDs survived producer transforms."
+      ],
+      "schema": [
+        "Declare every task-ID-bearing field in one registry: tasks.depends_on and dependency_reasons keys, critique_resolution_coverage.task_ids, sense_checks.task_id, validation.plan_steps_covered.finalize_item_ids, validation.orphan_tasks, user_actions.blocks_task_ids, validation_jobs.task_id/scope, and any profile-specific stance/task target fields.",
+        "Reject unknown task-reference families and nonempty model-authored validation_jobs; do not recursively rewrite arbitrary strings."
+      ],
+      "tests": [
+        "Promote the exact incident candidate to a redacted immutable fixture and test every mapping family, collisions, duplicate/self edges, chained splits, double invocation, publication ordering, and rollback compatibility.",
+        "Add cross-version replay tests for pre-contract finalize payloads and circuit-open states missing latest_failure/resume_cursor.",
+        "Add crash/retry tests at split, closure assertion, feasibility write, custody bind, finalize CAS, repair request, authority decision, claim, WBC effect, release, and notification."
+      ],
+      "migration": [
+        "For unpublished rejected candidates, recompute from the immutable raw candidate under the bound runtime; never patch candidate/finalize artifacts in place.",
+        "For legacy circuit-open projections, permit one CAS migration only when state, candidate, fingerprint, runtime, and absence of admitted authority match; record the migration receipt and retain the old planner_repair artifact as history."
+      ],
+      "observability": [
+        "Emit split-map digest, removed/generated ID counts, per-field rewrite counts, collision diagnostics, closure assertion outcome, circuit clear transition, and request/grant/claim/WBC/finalize join keys.",
+        "Distinguish phase-harness success from admitted finalize publication and alert on completed phase attempts with zero admitted artifacts or on blocked next_step=recover-blocked without a usable cursor."
+      ],
+      "notification": [
+        "Create notification intent only after terminal verification, dedupe by notification_key, bind it to the same occurrence/request/claim/WBC/runtime identities, and record exactly one effect or an explicit no-provider terminal outcome."
+      ],
+      "rollout": [
+        "Shadow-compute closure digests on stored candidates, then canary the new transform on splitter fixtures and one non-authoritative plan before enabling admission enforcement.",
+        "Roll back by CAS runtime rebind to the prior content identity and stop new affected finalizations; never reverse-transform or delete already accepted artifacts. Preserve requests, claims, WBC, migration, and notification receipts."
+      ],
+      "parallel_work": [
+        "Splitter/schema/test work may proceed in parallel with observability/notification schema work after the field registry and mapping semantics are frozen.",
+        "Circuit migration and Run Authority/Custody/WBC replay work may proceed in parallel against fixtures, but live rollout waits for the same closure-contract version and terminal join schema."
+      ],
+      "very_hard_decisions": [
+        "Keep _impl as the output-bearing successor and _proof as verification custody; changing dependency edges to _proof would serialize consumers and is a separate policy migration.",
+        "Do not preserve removed IDs as aliases in the executable graph; aliases conceal closure bugs and make authority ambiguous.",
+        "Treat collision, unknown reference family, and stale runtime/fingerprint as fail-closed; do not auto-dedupe or heuristically rewrite.",
+        "The authoritative circuit state is persisted state.meta.planner_repair, not existence of planner_repair.json and not the write-only implementation_dispatch_allowed field."
+      ]
+    },

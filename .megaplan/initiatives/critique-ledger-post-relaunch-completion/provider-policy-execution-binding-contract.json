    "durable_audit_event_on_detection": true,
    "notify_on_initial_detection": false,
    "notify_after": "CONTAINMENT_OR_ROLLBACK_OR_SINGLE_RELAUNCH_FAILS_IS_UNSAFE_OR_EXHAUSTS",
    "successful_automatic_repair_notifications": 0,
    "failed_bounded_repair_notifications": 1,
    "dedupe_key_fields": ["occurrence_id", "accepted_state_version", "failure_class"],
    "recovery_notification_requires_prior_failure_notification": true

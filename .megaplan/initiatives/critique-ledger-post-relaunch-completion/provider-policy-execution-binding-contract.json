  "watchdog_contract": {
    "deterministic_classes": ["PROVIDER_POLICY_DRIFT", "PROFILE_POLICY_DRIFT", "PHASE_MODEL_POLICY_DRIFT", "EXECUTION_BINDING_DRIFT", "LOADED_BYTES_DRIFT"],
    "containment_order": ["FENCE_NEW_DISPATCH", "TARGET_CGROUP_AND_PID_START_IDENTITY", "BOUNDED_GRACEFUL_THEN_HARD_KILL", "PROVE_PROCESS_TREE_GONE"],
    "rollback": "LAST_APPROVED_STILL_ADMISSIBLE_PROFILE_MAP_AND_REMOTE_BINDING_ONLY",
    "relaunch_limit": 1,
    "relaunch_key_fields": ["occurrence_id", "intended_map_digest", "remote_bundle_digest"],
    "relaunch_semantics": "DURABLE_COMPARE_AND_SWAP_IDEMPOTENT_ACROSS_PROCESS_AND_HOST_RESTART"

/bin/zsh -lc "python - <<'PY'
from pathlib import Path
import hashlib, yaml
class StrictLoader(yaml.SafeLoader): pass
def no_dupes(loader, node, deep=False):
    out={}
    for kn,vn in node.value:
        k=loader.construct_object(kn, deep=deep)
        if k in out: raise RuntimeError(f'duplicate YAML key {k} at line {kn.start_mark.line+1}')
        out[k]=loader.construct_object(vn, deep=deep)
    return out
StrictLoader.add_constructor(yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG, no_dupes)
base=Path('.megaplan/initiatives/standardized-completion-specifications')
cross=yaml.load((base/'SUPERSESSION_CROSSWALK.yaml').read_text(), Loader=StrictLoader)
reqs=cross['requirements']; srcs=cross['source_rules']; proofs=cross['proof_rules']
assert len(reqs)==83==len({r['id'] for r in reqs})
assert len(srcs)==30 and len(proofs)==40 and len(cross['oracle_amendments'])==19
required=set(cross['coverage_summary']['required_fields'])
for r in reqs:
    assert required <= r.keys(), (r['id'], required-r.keys())
    assert r['source_rule_id'] in srcs
    assert all(x in proofs for x in r['proof_rule_ids'])
for sid,s in srcs.items():
    p=base/s['path']; lines=p.read_text().splitlines(keepends=True)
    chunk=''.join(lines[s['line_start']-1:s['line_end']]).encode()
    assert hashlib.sha256(chunk).hexdigest()==s['sha256'], sid
# exact live labels from all referenced active chains
labels=set()
for p in [Path('.megaplan/initiatives/custody-control-plane/chain.yaml'),Path('.megaplan/initiatives/megaplan-chain-milestone-gates/chain.yaml'),Path('.megaplan/initiatives/megaplan-native-parity-corrective/chain.yaml'),Path('.megaplan/initiatives/native-workflow-platformization/chain.yaml')]:
    d=yaml.safe_load(p.read_text()); labels.update(m['label'] for m in d['milestones'])
for r in reqs:
    assert set(r['canonical_owner_labels']) <= labels, (r['id'], set(r['canonical_owner_labels'])-labels)
print('PASS mechanical crosswalk: 83 rows, 30 hashed source slices, 40 proof rules, 19 amendments, exact active owner labels')

        assert (ROOT / data[key]).exists(), (owner, key, data[key])
for a in amendments:
    assert a['proof_rule'] in rules, (a['id'], a['proof_rule'])
    for owner in a['owners']:
        assert owner in owners, (a['id'], owner)
print(f'PASS crosswalk: {len(reqs)} retained requirements, {len(amendments)} oracle amendments, {len(owners)} canonical owners, {len(rules)} proof rules')

completion_chain = parsed[DIRS[1] / 'chain.yaml']
completion_cloud = parsed[DIRS[1] / 'cloud.yaml']
assert completion_chain.get('launchable') is False
assert completion_cloud.get('launchable') is False

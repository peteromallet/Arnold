from pathlib import Path
import yaml

ROOT = Path('.')
DIRS = [
    Path('.megaplan/initiatives/megaplan-native-parity-corrective'),
    Path('.megaplan/initiatives/standardized-completion-specifications'),
    Path('.megaplan/initiatives/native-workflow-platformization'),
]
class StrictLoader(yaml.SafeLoader):
    pass

def no_dupes(loader, node, deep=False):
    out = {}
    for key_node, value_node in node.value:
        key = loader.construct_object(key_node, deep=deep)
        if key in out:
            raise yaml.constructor.ConstructorError('mapping', node.start_mark, f'duplicate key: {key}', key_node.start_mark)
        out[key] = loader.construct_object(value_node, deep=deep)
    return out
StrictLoader.add_constructor(yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG, no_dupes)

parsed = {}
for d in DIRS:
    for p in sorted(d.rglob('*.yaml')):
        parsed[p] = yaml.load(p.read_text(), Loader=StrictLoader)
print(f'PASS strict YAML parse: {len(parsed)} files')

native = parsed[DIRS[0] / 'chain.yaml']
platform = parsed[DIRS[2] / 'chain.yaml']
expected_native = ['s1-custody-admission-semantic-preservation','s2f-pype-compiler-identity-converter','c1-completion-contract-identity-shadow','c2-completion-binding-evaluation-shadow','s2r-durable-control-primitives-custody-binding','s3a-prep-plan-critique-native-cutover','s3b-gate-revise-front-half-cutover','s4-tiebreaker-finalize-durable-reentry','s5a-delivery-shadow-effect-class-proof','s5b-live-delivery-cutover-review-rework','s6-override-auto-control-adoption','s7-native-topology-conformance']
expected_platform = ['s1-component-standard-extraction-inventory','s2a-enforced-composition-resolution-package-surface','s2b-pype-authoring-core','s3-developer-experience-tooling','s4-isolated-extraction-recomposition','s5-adversarial-second-consumer-substitutability','s6-certification-evolution-adoption']

def validate_chain(name, chain, expected, transition_labels, final_label):
    milestones = chain['milestones']
    labels = [m['label'] for m in milestones]
    assert labels == expected, (name, labels)
    for i, m in enumerate(milestones):
        deps = m.get('depends_on', [])
        assert deps == ([] if i == 0 else [labels[i-1]]), (name, m['label'], deps)
        vals = m.get('validate', [])
        assert len(vals) == 1, (name, m['label'], vals)
        kind = vals[0].get('kind')
        assert kind == ('final_conformance_gate' if m['label'] == final_label else 'conformance_gate'), (name, m['label'], kind)
        for k in ('validator','conformance','traceability','proof_map','receipt'):
            assert vals[0].get(k), (name, m['label'], f'missing validate.{k}')
        if m['label'] in transition_labels:
            t = m.get('transition')
            assert t and t.get('kind') == 'receipt_consuming_transition', (name, m['label'], t)
            for k in ('transition_id','handler','input_receipts','output_receipt','verify'):
                assert t.get(k), (name, m['label'], f'missing transition.{k}')
            assert 'current_validation' in t['input_receipts'], (name, m['label'], t['input_receipts'])
            v = t['verify']
            for k in ('kind','validator','conformance','traceability','proof_map','receipt'):
                assert v.get(k), (name, m['label'], f'missing transition.verify.{k}')
        else:
            assert 'transition' not in m, (name, m['label'], 'unexpected transition')
    print(f'PASS {name}: exact order, serial dependencies, {len(milestones)} gates, {len(transition_labels)} transitions')

validate_chain('native', native, expected_native, {'s2f-pype-compiler-identity-converter','s2r-durable-control-primitives-custody-binding','s3a-prep-plan-critique-native-cutover','s3b-gate-revise-front-half-cutover','s4-tiebreaker-finalize-durable-reentry','s5b-live-delivery-cutover-review-rework','s6-override-auto-control-adoption'}, expected_native[-1])
validate_chain('platform', platform, expected_platform, {'s2a-enforced-composition-resolution-package-surface','s4-isolated-extraction-recomposition','s6-certification-evolution-adoption'}, expected_platform[-1])

for name, chain in [('native', native), ('platform', platform)]:
    cps = [p for p in chain['launch_preconditions'] if p.get('kind') == 'chain_completed']
    assert cps, name
    for p in cps:
        assert p.get('require_manifest') is True
        assert p.get('required_proof_artifacts'), (name, p['name'])
    print(f'PASS {name}: chain_completed predecessors require manifests and bound proof artifacts')

cross = parsed[DIRS[1] / 'SUPERSESSION_CROSSWALK.yaml']
owners = cross['canonical_active_owners']
rules = cross['proof_rules']
amendments = cross['oracle_amendments']
reqs = cross['requirements']
assert len(reqs) == 83 and len({r['id'] for r in reqs}) == 83
assert len(amendments) == 19 and len({a['id'] for a in amendments}) == 19
assert len(rules) == len(set(rules))
for owner, data in owners.items():

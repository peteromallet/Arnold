from pathlib import Path
import yaml

ROOT = Path('.')
DIRS = [Path('.megaplan/initiatives/megaplan-native-parity-corrective'), Path('.megaplan/initiatives/standardized-completion-specifications'), Path('.megaplan/initiatives/native-workflow-platformization')]
class StrictLoader(yaml.SafeLoader): pass
def no_dupes(loader, node, deep=False):
    out = {}
    for kn, vn in node.value:
        key = loader.construct_object(kn, deep=deep)
        if key in out:
            raise yaml.constructor.ConstructorError('mapping', node.start_mark, f'duplicate key: {key}', kn.start_mark)
        out[key] = loader.construct_object(vn, deep=deep)
    return out
StrictLoader.add_constructor(yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG, no_dupes)
parsed = {p: yaml.load(p.read_text(), Loader=StrictLoader) for d in DIRS for p in sorted(d.rglob('*.yaml'))}
print(f'PASS strict YAML parse: {len(parsed)} files')

cross = parsed[DIRS[1] / 'SUPERSESSION_CROSSWALK.yaml']
owners = cross['canonical_active_owners']
owner_labels = {v['label'] for v in owners.values()}
rules = cross['proof_rules']
amendments = cross['oracle_amendments']
reqs = cross['requirements']
assert len(reqs) == 83 and len({r['id'] for r in reqs}) == 83
assert len(amendments) == 19 and len({a['id'] for a in amendments}) == 19
for owner, data in owners.items():
    for key in ('chain','brief'):
        assert (ROOT / data[key]).exists(), (owner, key, data[key])
for rid, rule in rules.items():
    assert (ROOT / rule['path']).exists(), (rid, rule['path'])
    if rule.get('supporting_path'):
        assert (ROOT / rule['supporting_path']).exists(), (rid, rule['supporting_path'])
    for label in rule['owners']:
        assert label in owner_labels, (rid, label)
for a in amendments:
    for rid in a['proof_rule_ids']:
        assert rid in rules, (a['id'], rid)
    for label in a['owners']:
        assert label in owner_labels, (a['id'], label)
print(f'PASS crosswalk: {len(reqs)} retained requirements, {len(amendments)} oracle amendments, {len(owners)} canonical owners, {len(rules)} proof rules')

for p in (DIRS[1]/'chain.yaml', DIRS[1]/'cloud.yaml'):
    assert parsed[p]['launchable'] is False, p
print('PASS completion archive: chain/cloud non-launchable')

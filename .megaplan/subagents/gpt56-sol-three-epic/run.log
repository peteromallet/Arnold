import yaml
specs = {
'native': (Path('.megaplan/initiatives/megaplan-native-parity-corrective/chain.yaml'), ['s1-custody-admission-semantic-preservation','s2f-pype-compiler-identity-converter','c1-completion-contract-identity-shadow','c2-completion-binding-evaluation-shadow','s2r-durable-control-primitives-custody-binding','s3a-prep-plan-critique-native-cutover','s3b-gate-revise-front-half-cutover','s4-tiebreaker-finalize-durable-reentry','s5a-delivery-shadow-effect-class-proof','s5b-live-delivery-cutover-review-rework','s6-override-auto-control-adoption','s7-native-topology-conformance'], {'s2f-pype-compiler-identity-converter','s2r-durable-control-primitives-custody-binding','s3a-prep-plan-critique-native-cutover','s3b-gate-revise-front-half-cutover','s4-tiebreaker-finalize-durable-reentry','s5b-live-delivery-cutover-review-rework','s6-override-auto-control-adoption'}),
'platform': (Path('.megaplan/initiatives/native-workflow-platformization/chain.yaml'), ['s1-component-standard-extraction-inventory','s2a-enforced-composition-resolution-package-surface','s2b-pype-authoring-core','s3-developer-experience-tooling','s4-isolated-extraction-recomposition','s5-adversarial-second-consumer-substitutability','s6-certification-evolution-adoption'], {'s2a-enforced-composition-resolution-package-surface','s4-isolated-extraction-recomposition','s6-certification-evolution-adoption'})}
for name,(path,expected,transition_labels) in specs.items():
    d=yaml.safe_load(path.read_text()); ms=d['milestones']; labels=[m['label'] for m in ms]
    assert labels==expected
    for i,m in enumerate(ms):
        assert m.get('depends_on',[]) == ([] if i==0 else [labels[i-1]])
        assert len(m.get('validate',[]))==1 and m['validate'][0].get('receipt')
        assert bool(m.get('transition')) == (m['label'] in transition_labels)
        if m.get('transition'):
            assert 'current_validation' in m['transition']['input_receipts']
            assert m['transition']['verify'].get('receipt')
        assert Path(m['idea']).exists()
    for pre in [x for x in d['launch_preconditions'] if x.get('kind')=='chain_completed']:
        assert pre.get('require_manifest') is True and pre.get('required_proof_artifacts')
    print(f'PASS {name}: exact serial order, {len(ms)} executable gates, {len(transition_labels)} typed transitions, bound predecessors')

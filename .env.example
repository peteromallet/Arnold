# Copy to .env only for local development. Do not commit real secrets.

# Premium model access. Megaplan setup can also use existing Claude/Codex logins.
ANTHROPIC_API_KEY=
# Anthropic OAuth token takes precedence over the API key for omp routes.
ANTHROPIC_OAUTH_TOKEN=
OPENAI_API_KEY=

# Cheap-phase provider access (omp routes read these from the process env).
# Use DeepSeek by default, or Fireworks with --deepseek-provider fireworks.
DEEPSEEK_API_KEY=
FIREWORKS_API_KEY=

# Optional: direct Moonshot Kimi API (used by partnered-3/4 profiles).
# MOONSHOT_API_KEY and KIMI_API_KEY are accepted aliases for the same key.
MOONSHOT_API_KEY=
KIMI_API_KEY=

# zAI / Zhipu GLM routes (omp:zai/...). ZAI_API_KEY is canonical;
# ZHIPU_API_KEY is accepted as a legacy alias.
ZAI_API_KEY=
ZHIPU_API_KEY=

# OpenRouter routes (omp:openrouter/...).
OPENROUTER_API_KEY=

# xAI Grok (OpenAI-compatible). Use via omp: prefix e.g. omp:xai/grok-4-fast-non-reasoning
# or xai:grok-4-fast-non-reasoning in appropriate contexts. Matches the direct endpoint https://api.x.ai/v1
XAI_API_KEY=

# Kimi Code OAuth (omp:kimi-code/...). May be tokenless when OAuth is persisted.
# KIMI_API_KEY is used when no OAuth session exists.

# Optional: cloud runs that need to clone private GitHub repositories.
GITHUB_TOKEN=

# Optional: shared database/progress backends.
SUPABASE_DB_URL=
MEGAPLAN_ACTOR_ID=

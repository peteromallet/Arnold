  1134	                continue
  1135	
  1136	            hits: set[str] = set()
  1137	            for node in ast.walk(tree):
  1138	                if isinstance(node, ast.Import):
  1139	                    for alias in node.names:
  1140	                        if alias.name == "arnold.pipelines.megaplan" or alias.name.startswith(
  1141	                            "arnold.pipelines.megaplan."
  1142	                        ):
  1143	                            hits.add(alias.name)
  1144	                elif isinstance(node, ast.ImportFrom) and node.module:
  1145	                    if node.module == "arnold.pipelines.megaplan" or node.module.startswith(
  1146	                        "arnold.pipelines.megaplan."
  1147	                    ):
  1148	                        hits.add(node.module)
  1149	
  1150	            if hits:
  1151	                violations[str(source.relative_to(repo_root))] = tuple(sorted(hits))
  1152	
  1153	    return violations

   324	    def _suspension_route_id(self, node_id: str, response: Mapping[str, Any]) -> str | None:
   325	        """Return a suspension route when a handler halts for human input."""
   326	
   327	        state = response.get("state")
   328	        if state in {"awaiting_human", "clarified", "suspended"}:
   329	            return f"{node_id}:human"
   330	        if response.get("next_step") == "suspend":
   331	            return f"{node_id}:suspend"
   332	        return None

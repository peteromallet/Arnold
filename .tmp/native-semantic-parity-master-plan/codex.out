    45	
    46	def resolve_route_binding_for_signal(step: str, route_signal: object) -> Mapping[str, object] | None:
    47	    if not isinstance(route_signal, str) or not route_signal:
    48	        return None
    49	    for binding in _declared_route_bindings_for_step(step):

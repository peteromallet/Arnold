  1615	    conformance = _load_yaml(conformance_path)
  1616	    rows = conformance.get("rows")
  1617	    if not isinstance(rows, list):
  1618	        raise ValueError(f"{conformance_path} rows must be a list")
  1619	    resolved_traceability_path = traceability_path or (repo_root / DEFAULT_TRACEABILITY)
  1620	    traceability = _load_yaml(resolved_traceability_path)
  1621	    resolved_boundary_fixture_root = boundary_fixture_root or (repo_root / DEFAULT_BOUNDARY_FIXTURE_ROOT)
  1622	    resolved_scenarios_path = scenarios_path or (repo_root / DEFAULT_SCENARIOS)
  1623	
  1624	    records: list[dict[str, Any]] = []
  1625	    for row in rows:
  1626	        if not isinstance(row, dict):
  1627	            raise ValueError(f"{conformance_path} rows entries must be mappings")
  1628	        if row.get("status") != "implemented":
  1629	            continue
  1630	        row_id = row.get("id")
  1631	        if not isinstance(row_id, str) or not row_id:
  1632	            raise ValueError("implemented rows must have non-empty ids")
  1633	        carrier_evidence = row.get("carrier_evidence")
  1634	        proof_artifacts = row.get("proof_artifacts")
  1635	        if not isinstance(carrier_evidence, list) or not carrier_evidence:
  1636	            raise ValueError(f"implemented row {row_id!r} must declare non-empty carrier_evidence")
  1637	        if not isinstance(proof_artifacts, list) or not proof_artifacts:
  1638	            raise ValueError(f"implemented row {row_id!r} must declare non-empty proof_artifacts")
  1639	        for carrier_path in carrier_evidence:
  1640	            if not isinstance(carrier_path, str) or not carrier_path:
  1641	                raise ValueError(f"implemented row {row_id!r} has invalid carrier path {carrier_path!r}")
  1642	            if carrier_path in FORBIDDEN_AUTHORITY_PATHS:
  1643	                raise ValueError(
  1644	                    f"implemented row {row_id!r} cannot use forbidden authority carrier {carrier_path!r}"
  1645	                )
  1646	            carrier_name = APPROVED_CARRIER_NAMES.get(carrier_path)
  1647	            if carrier_name is None:
  1648	                raise ValueError(f"implemented row {row_id!r} uses unapproved carrier {carrier_path!r}")
  1649	            proof_artifact_path = _select_proof_artifact(carrier_path, proof_artifacts)
  1650	            records.append(
  1651	                _build_source_checker_record(
  1652	                    row=row,
  1653	                    carrier_path=carrier_path,
  1654	                    carrier_name=carrier_name,
  1655	                    proof_artifact_path=proof_artifact_path,
  1656	                    repo_root=repo_root,
  1657	                )
  1658	            )
  1659	
  1660	    (
  1661	        boundary_contract_records,
  1662	        boundary_receipt_records,
  1663	        boundary_semantic_health_records,
  1664	        boundary_phase_result_records,
  1665	        boundary_fixture_hashes,
  1666	    ) = _build_boundary_fixture_bundle(
  1667	        rows=[row for row in rows if isinstance(row, dict)],
  1668	        traceability=traceability,
  1669	        repo_root=repo_root,
  1670	        fixture_root=resolved_boundary_fixture_root,
  1671	    )
  1672	    scenario_hashes = _build_split_outcome_hashes(
  1673	        repo_root=repo_root,
  1674	        traceability=traceability,
  1675	        scenarios_path=resolved_scenarios_path,
  1676	    )
  1677	    quarantine_records = _build_quarantine_scans(rows, repo_root=repo_root)
  1678	
  1679	    return {
  1680	        "schema": EVIDENCE_SCHEMA,
  1681	        "records": records,
  1682	        "boundary_contract_records": boundary_contract_records,
  1683	        "boundary_receipt_records": boundary_receipt_records,
  1684	        "boundary_semantic_health_records": boundary_semantic_health_records,
  1685	        "boundary_phase_result_records": boundary_phase_result_records,
  1686	        "scenario_hashes": scenario_hashes,
  1687	        "installed_package_fingerprints": _build_installed_package_fingerprints(
  1688	            [row for row in rows if isinstance(row, dict)],
  1689	            repo_root=repo_root,
  1690	        ),
  1691	        "topology_regeneration_checks": _build_topology_regeneration_checks(
  1692	            [row for row in rows if isinstance(row, dict)],
  1693	            repo_root=repo_root,
  1694	        ),
  1695	        "handler_purity_checks": _build_handler_purity_checks(
  1696	            [row for row in rows if isinstance(row, dict)],
  1697	            repo_root=repo_root,
  1698	        ),
  1699	        "compatibility_quarantine_checks": _build_compatibility_quarantine_checks(
  1700	            [row for row in rows if isinstance(row, dict)],
  1701	            quarantine_records=quarantine_records,
  1702	            repo_root=repo_root,

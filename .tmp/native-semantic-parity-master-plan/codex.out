    parents={}
    for node in ast.walk(tree):
      for child in ast.iter_child_nodes(node): parents[child]=node
    def func_name(n):
      cur=n
      while cur in parents:
        cur=parents[cur]
        if isinstance(cur,(ast.FunctionDef,ast.AsyncFunctionDef)): return cur.name
      return '<module>'
    for node in ast.walk(tree):
      targets=[]
      if isinstance(node,(ast.Assign,ast.AnnAssign,ast.AugAssign)):
        ts=node.targets if isinstance(node,ast.Assign) else [node.target]
        for t in ts:
          # state['current_state'] or dict key in literal not assignment
          if isinstance(t, ast.Subscript):
            sl=t.slice
            key=None
            if isinstance(sl, ast.Constant): key=sl.value
            if key in {'current_state','next_step','resume_cursor'}:
              targets.append(key)
          elif isinstance(t, ast.Name) and t.id in {'current_state','next_step','resume_cursor'}:
            targets.append(t.id)
      if targets:
        hits.append((node.lineno, func_name(node), sorted(set(targets))))
    if hits:
      print(p)
      for line, fn, keys in hits[:80]:
        print(f'  {line}: {fn}: {keys}')

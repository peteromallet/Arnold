   134	        except Exception as exc:  # noqa: BLE001
   135	            return NodeOutcome(
   136	                state=NodeState.FAILED,
   137	                error=f"{node_id} handler failed: {exc}",
   138	            )
   139	
   140	        return self._response_to_outcome(node_id, response)
   141	

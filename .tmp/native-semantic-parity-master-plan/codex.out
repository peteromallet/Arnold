   100	
   101	def build_compatibility_shell(pipeline: DslPipeline) -> CompatibilityPipelineShell:
   102	    """Project an authored DSL pipeline to a native-backed neutral shell."""
   103	
   104	    manifest = compile_workflow_manifest(pipeline)
   105	    native_program = _native_program_from_dsl(pipeline)
   106	    stages = _stages_from_dsl(pipeline)
   107	    return CompatibilityPipelineShell(
   108	        stages=stages,
   109	        entry=pipeline.entry,
   110	        binding_map=None,
   111	        resource_bundles=(),
   112	        native_program=native_program,
   113	        manifest=manifest,
   114	        authored_pipeline=pipeline,
   115	    )
   116	
   117	
   118	def _stages_from_dsl(pipeline: DslPipeline) -> dict[str, Stage]:
   119	    routes_by_source: dict[str, list[Any]] = {}
   120	    for route in pipeline.routes:
   121	        routes_by_source.setdefault(route.source, []).append(route)
   122	
   123	    stages: dict[str, Stage] = {}
   124	    for step in pipeline.steps:
   125	        outgoing = tuple(routes_by_source.get(step.id, ()))
   126	        default_next = outgoing[0].label if outgoing else "halt"
   127	        edges = tuple(Edge(label=route.label, target=route.target) for route in outgoing)
   128	        labels = frozenset(route.label for route in outgoing)
   129	        handler_ref = _handler_ref(step)
   130	        stages[step.id] = Stage(
   131	            name=step.id,
   132	            step=_CompatibilityStep(
   133	                name=step.id,
   134	                kind=step.kind,
   135	                handler_ref=handler_ref,
   136	                metadata=dict(step.metadata),
   137	                default_next=default_next,
   138	            ),
   139	            edges=edges,
   140	            decision_vocabulary=labels if len(labels) > 1 else frozenset(),
   141	        )
   142	    return stages
   143	
   144	
   145	def _routing_topology_from_dsl(pipeline: DslPipeline) -> dict[str, Any]:
   146	    """Build generic static routing topology records from authored DSL routes.
   147	
   148	    The returned dict uses the product-neutral structure expected by
   149	    :func:`arnold.pipeline.native.validator._validate_routing_topology`:
   150	
   151	    * ``nodes`` – a list of ``{"name": "<step.id>"}`` records for every step.
   152	    * ``routes`` – a list of ``{"source", "label", "target"[, "condition_ref"]}``
   153	      records for every authored route.
   154	
   155	    This allows the generic native validator to perform static label/target
   156	    resolution without importing any Megaplan-specific semantics.
   157	    """
   158	    nodes: list[dict[str, str]] = [{"name": step.id} for step in pipeline.steps]
   159	    routes: list[dict[str, str | None]] = []
   160	    for route in pipeline.routes:
   161	        record: dict[str, str | None] = {
   162	            "source": route.source,
   163	            "label": route.label,
   164	            "target": route.target,
   165	        }
   166	        if route.condition_ref is not None:
   167	            record["condition_ref"] = route.condition_ref
   168	        routes.append(record)
   169	
   170	    return {"nodes": nodes, "routes": routes}
   171	
   172	
   173	def _native_program_from_dsl(pipeline: DslPipeline) -> NativeProgram:
   174	    routes_by_source: dict[str, list[Any]] = {}
   175	    for route in pipeline.routes:
   176	        routes_by_source.setdefault(route.source, []).append(route)
   177	    step_pc = {step.id: index for index, step in enumerate(pipeline.steps)}
   178	
   179	    phases: list[NativePhase] = []
   180	    instructions: list[NativeInstruction] = []
   181	    for pc, step in enumerate(pipeline.steps):
   182	        func = _native_phase_func(step)
   183	        phase = NativePhase(name=step.id, func=func)
   184	        phases.append(phase)
   185	        outgoing = routes_by_source.get(step.id, [])
   186	        next_pc = _default_next_pc(outgoing, step_pc)
   187	        instructions.append(
   188	            NativeInstruction(
   189	                pc=pc,
   190	                op="phase",
   191	                name=step.id,
   192	                func=func,
   193	                next_pc=next_pc,
   194	            )
   195	        )
   196	
   197	    program = NativeProgram(
   198	        name=pipeline.id,
   199	        instructions=tuple(instructions),
   200	        phases=tuple(phases),
   201	        routing_topology=_routing_topology_from_dsl(pipeline),
   202	        description=(
   203	            "Substrate proof only: compatibility projection from authored "
   204	            "Megaplan workflow DSL to neutral native shell."
   205	        ),
   206	    )
   207	    return attach_composition_graph(program)

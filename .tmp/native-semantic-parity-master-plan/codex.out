   235	def _run_megaplan_native_phase(
   236	    phase_name: str,
   237	    ctx: Mapping[str, Any],
   238	    *,
   239	    handler_ref: str | None,
   240	) -> dict[str, Any]:
   241	    """Execute one canonical Megaplan phase through the native phase function."""
   242	
   243	    del handler_ref
   244	    root = _ctx_path(ctx.get("cwd")) or Path.cwd()
   245	    plan = ctx.get("plan")
   246	    if not isinstance(plan, str) or not plan:
   247	        return {"exit_code": 1, "stdout": "", "stderr": "missing --plan"}
   248	    argv = ctx.get("argv")
   249	    args = _namespace_from_argv(
   250	        phase_name,
   251	        plan=plan,
   252	        argv=argv if isinstance(argv, list) else [],
   253	    )
   254	    try:
   255	        from arnold_pipelines.megaplan.cli import COMMAND_HANDLERS
   256	        from arnold_pipelines.megaplan._core.io import json_dump
   257	        from arnold_pipelines.megaplan.types import CliError
   258	
   259	        handler = COMMAND_HANDLERS.get(phase_name)
   260	        if handler is None:
   261	            return {
   262	                "exit_code": 1,
   263	                "stdout": "",
   264	                "stderr": f"native phase {phase_name!r} is unsupported",
   265	            }
   266	        response = handler(root, args)
   267	        return {"exit_code": 0, "stdout": json_dump(response), "stderr": ""}
   268	    except CliError as error:
   269	        payload: dict[str, Any] = {
   270	            "success": False,
   271	            "error": error.code,
   272	            "message": error.message,
   273	        }
   274	        if error.extra:
   275	            payload["details"] = dict(error.extra)
   276	        import json
   277	
   278	        return {
   279	            "exit_code": error.exit_code,
   280	            "stdout": "",
   281	            "stderr": json.dumps(payload),
   282	        }
   283	    except Exception as error:  # noqa: BLE001 - preserve CLI-shaped failure surface.
   284	        return {
   285	            "exit_code": 1,
   286	            "stdout": "",
   287	            "stderr": f"{type(error).__name__}: {error}",
   288	        }
   289	
   290	
   291	def _ctx_path(value: Any) -> Path | None:
   292	    if isinstance(value, Path):
   293	        return value
   294	    if isinstance(value, str) and value:
   295	        return Path(value)
   296	    return None

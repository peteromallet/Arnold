   146	    def _resolve_handler(self, node_id: str):
   147	        """Return the product handler callable for a node ID."""
   148	
   149	        from arnold_pipelines.megaplan import handlers
   150	
   151	        mapping = {
   152	            "prep": handlers.handle_prep,
   153	            "plan": handlers.handle_plan,
   154	            "critique": handlers.handle_critique,
   155	            "gate": handlers.handle_gate,
   156	            "revise": handlers.handle_revise,
   157	            "finalize": handlers.handle_finalize,
   158	            "execute": handlers.handle_execute,
   159	            "review": handlers.handle_review,
   160	            "tiebreaker_run": handlers.handle_tiebreaker_run,
   161	            "tiebreaker_decide": handlers.handle_tiebreaker_decide,
   162	            "override": handlers.handle_override,
   163	        }
   164	        try:
   165	            return mapping[node_id]
   166	        except KeyError as exc:
   167	            raise LookupError(f"no handler registered for node {node_id!r}") from exc
   168	
   169	    # ------------------------------------------------------------------
   170	    # Outcome translation
   171	    # ------------------------------------------------------------------
   172	
   173	    def _route_binding_for_signal(self, node_id: str, route_signal: object) -> tuple[str, str] | None:
   174	        if not isinstance(route_signal, str) or not route_signal:
   175	            return None
   176	        try:
   177	            from arnold_pipelines.megaplan.workflows.components import STEP_COMPONENTS_BY_ID
   178	
   179	            component = STEP_COMPONENTS_BY_ID[node_id]
   180	        except Exception:
   181	            return None
   182	        for binding in component.metadata.get("route_bindings", ()):
   183	            if not isinstance(binding, Mapping) or binding.get("label") != route_signal:
   184	                continue
   185	            route_id = binding.get("id")
   186	            target_ref = binding.get("target_ref")
   187	            if isinstance(route_id, str) and route_id and isinstance(target_ref, str) and target_ref:
   188	                return route_id, target_ref
   189	        return None
   190	
   191	    def _response_to_outcome(
   192	        self,
   193	        node_id: str,
   194	        response: Mapping[str, Any],
   195	    ) -> NodeOutcome:
   196	        """Translate a Megaplan StepResponse into a neutral NodeOutcome."""
   197	
   198	        success = bool(response.get("success", True))
   199	
   200	        outputs = dict(response)
   201	        outputs["node_id"] = node_id
   202	
   203	        branch_edge_id = self._branch_edge_id(node_id, response)
   204	        suspension_route_id = self._suspension_route_id(node_id, response)
   205	        control_signals = self._build_control_signals(node_id, response)
   206	
   207	        state: NodeState
   208	        if not success:
   209	            state = NodeState.FAILED
   210	        elif suspension_route_id is not None:
   211	            state = NodeState.SUSPENDED
   212	        else:
   213	            state = NodeState.COMPLETED
   214	        error: str | None = None
   215	        if not success:
   216	            error = str(response.get("message") or response.get("error") or f"{node_id} failed")
   217	
   218	        return NodeOutcome(
   219	            state=state,
   220	            outputs=outputs,
   221	            error=error,
   222	            branch_edge_id=branch_edge_id,
   223	            suspension_route_id=suspension_route_id,
   224	            control_signals=tuple(control_signals),
   225	        )
   226	

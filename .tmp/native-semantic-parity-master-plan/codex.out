  1125	def _deleted_product_import_violations(repo_root: Path) -> dict[str, tuple[str, ...]]:
  1126	    product_roots = (repo_root / "arnold_pipelines",)
  1127	    violations: dict[str, tuple[str, ...]] = {}
  1128	
  1129	    for root in product_roots:
  1130	        for source in sorted(root.rglob("*.py")):
  1131	            try:
  1132	                tree = ast.parse(source.read_text(encoding="utf-8"), filename=str(source))

  1707	        ),
  1708	        "approved_carriers": _build_approved_carrier_inventory(rows, repo_root=repo_root),
  1709	        "fixture_hashes": _build_fixture_hashes(rows, repo_root=repo_root),
  1710	        "boundary_fixture_hashes": boundary_fixture_hashes,
  1711	        "quarantine_records": quarantine_records,
  1712	    }


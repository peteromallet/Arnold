   300	                return {
   301	                    "finalize": "review:halt",
   302	                    "revise": "review:revise",
   303	                    "halt": "review:halt",
   304	                }.get(next_step)
   305	            return None
   306	
   307	        if node_id == "override":
   308	            if isinstance(override_action, str):
   309	                return {
   310	                    "finalize": "override:finalize",
   311	                    "abort": "override:halt",
   312	                    "replan": "override:revise",
   313	                }.get(override_action)
   314	            if isinstance(next_step, str):

   334	    def _build_control_signals(
   335	        self,
   336	        node_id: str,
   337	        response: Mapping[str, Any],
   338	    ) -> list[Mapping[str, Any] | ControlTransition]:
   339	        """Build neutral control transitions from handler response fields."""
   340	
   341	        signals: list[Mapping[str, Any] | ControlTransition] = []
   342	        recommendation = response.get("recommendation")
   343	        route_signal = response.get("route_signal")
   344	        binding = self._route_binding_for_signal(node_id, route_signal)
   345	        if binding is not None:
   346	            _, target = binding
   347	            signals.append(
   348	                ControlTransition(
   349	                    transition_type=ControlTransitionType.OVERRIDE,
   350	                    source=KernelControlTarget(node_ref=node_id),
   351	                    target=KernelControlTarget(node_ref=target),
   352	                    trigger=f"{node_id}:{route_signal}",
   353	                    payload_schema_hash="",
   354	                    policy_ref=f"megaplan:{node_id}",
   355	                    idempotency_key=f"{node_id}:{route_signal}",
   356	                    payload={"route_signal": route_signal},
   357	                )
   358	            )
   359	            return signals
   360	        if recommendation in {"PROCEED", "ITERATE", "ESCALATE", "TIEBREAKER", "ABORT"}:
   361	            target = {
   362	                "PROCEED": "finalize",
   363	                "ITERATE": "revise",
   364	                "ESCALATE": "override",
   365	                "TIEBREAKER": "tiebreaker",
   366	                "ABORT": "halt",
   367	            }[recommendation]
   368	            signals.append(
   369	                ControlTransition(
   370	                    transition_type=ControlTransitionType.OVERRIDE,
   371	                    source=KernelControlTarget(node_ref=node_id),
   372	                    target=KernelControlTarget(node_ref=target),
   373	                    trigger=f"gate:{recommendation.lower()}",
   374	                    payload_schema_hash="",
   375	                    policy_ref="megaplan:gate",
   376	                    idempotency_key=f"{node_id}:{recommendation.lower()}",
   377	                    payload={"recommendation": recommendation},
   378	                )

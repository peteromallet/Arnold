+_CHAIN_TASK_PROJECTION_RECONCILIATION_SCHEMA = (
+    "arnold.megaplan.chain_task_projection_reconciliation.v1"
+)
+
+
+def _chain_task_projection_reconciliations(
+    plan_dir: Path,
+) -> dict[str, dict[str, Any]]:
+    """Load evidence-bound reconciliations for stale task-status projections.
+
+    Raw worker status remains immutable evidence. A reconciliation is accepted
+    only when a fixed quality resolution, a passing validation receipt, and a
+    passing final-review verdict all bind the same task.
+    """
+
+    try:
+        state = json.loads((plan_dir / "state.json").read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError, UnicodeDecodeError):
+        return {}
+    if not isinstance(state, dict):
+        return {}
+    meta = state.get("meta")
+    if not isinstance(meta, dict):
+        return {}
+    raw_receipts = meta.get("chain_task_projection_reconciliations")
+    if not isinstance(raw_receipts, list):
+        return {}
+    quality_resolutions = {
+        str(item.get("blocker_id") or ""): item
+        for item in meta.get("quality_gate_resolutions", [])
+        if isinstance(item, dict) and item.get("resolution") == "fixed"
+    }
+    try:
+        review_path = plan_dir / "review.json"
+        review = json.loads(review_path.read_text(encoding="utf-8"))
+        review_sha256 = hashlib.sha256(review_path.read_bytes()).hexdigest()
+    except (OSError, json.JSONDecodeError, UnicodeDecodeError):
+        return {}
+    review_verdicts = {
+        str(item.get("task_id") or ""): str(item.get("reviewer_verdict") or "")
+        for item in review.get("task_verdicts", [])
+        if isinstance(item, dict)
+    } if isinstance(review, dict) else {}
+
+    accepted: dict[str, dict[str, Any]] = {}
+    plan_root = plan_dir.resolve(strict=False)
+    for receipt in raw_receipts:
+        if not isinstance(receipt, dict):
+            continue
+        core = {key: value for key, value in receipt.items() if key != "content_sha256"}
+        digest = hashlib.sha256(
+            json.dumps(core, sort_keys=True, separators=(",", ":")).encode("utf-8")
+        ).hexdigest()
+        task_id = str(receipt.get("task_id") or "")
+        validation = receipt.get("validation")
+        if (
+            receipt.get("schema") != _CHAIN_TASK_PROJECTION_RECONCILIATION_SCHEMA
+            or receipt.get("content_sha256") != digest
+            or not task_id
+            or receipt.get("reconciled_status") not in _CHAIN_SHADOW_TERMINAL_STATUSES
+            or str(receipt.get("quality_resolution_blocker_id") or "")
+            not in quality_resolutions
+            or receipt.get("review_sha256") != review_sha256
+            or not review_verdicts.get(task_id, "").strip().lower().startswith("pass")
+            or not isinstance(validation, dict)
+        ):
+            continue
+        relative = str(validation.get("path") or "")
+        validation_path = (plan_dir / relative).resolve(strict=False)
+        if not relative or not validation_path.is_relative_to(plan_root):
+            continue
+        try:
+            validation_sha256 = hashlib.sha256(validation_path.read_bytes()).hexdigest()
+            validation_payload = json.loads(
+                validation_path.read_text(encoding="utf-8")
+            )
+        except (OSError, json.JSONDecodeError, UnicodeDecodeError):
+            continue
+        if (
+            validation.get("sha256") != validation_sha256
+            or not isinstance(validation_payload, dict)
+            or validation_payload.get("status") != "passed"
+            or validation_payload.get("exit_code") not in {0, None}
+        ):
+            continue
+        accepted[task_id] = receipt
+    return accepted
+
+

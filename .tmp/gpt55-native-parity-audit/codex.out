   935	def _review_parallel_map_calls(block: ParsedSourceBlock) -> tuple[ParsedParallelMapCall, ...]:
   936	    return tuple(
   937	        call
   938	        for call in _collect_parallel_map_calls(block)
   939	        if _component_ref_matches_exports(call.mapper_ref, _MEGAPLAN_REVIEW_PANEL_EXPORTS)
   940	    )

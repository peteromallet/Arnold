  1103	def _megaplan_surface_ref_exists(surface_ref: str) -> bool:
  1104	    if not surface_ref or "." not in surface_ref:
  1105	        return False
  1106	    try:
  1107	        module = import_module(_MEGAPLAN_COMPONENT_MODULE)
  1108	    except Exception:
  1109	        return False
  1110	    current: Any = module
  1111	    for segment in surface_ref.split("."):
  1112	        if isinstance(current, Mapping):
  1113	            current = current.get(segment, _INVALID_REF)
  1114	        else:
  1115	            current = getattr(current, segment, _INVALID_REF)
  1116	        if current is _INVALID_REF:
  1117	            return False
  1118	    return True

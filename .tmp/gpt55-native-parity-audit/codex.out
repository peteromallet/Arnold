  1725	                    "artifact": None,
  1726	                },
  1727	                "deferred_human": {
  1728	                    "route_signal": "deferred_human",
  1729	                    "target_ref": "halt",
  1730	                    "artifact": "review.json",
  1731	                },
  1732	            },
  1733	            # ------------------------------------------------- explicit branches
  1734	            # Every execute branch point, visible in the workflow policy
  1735	            # component.  ``branch_surface_ref`` points to the comprehensive
  1736	            # typed enumeration in the policy authority
  1737	            # (``EXECUTE_BRANCH_SURFACE``); the inline entries below mirror
  1738	            # the workflow-source-visible subset so a reviewer can read the
  1739	            # full topology without leaving this component.
  1740	            "branch_surface_ref": (
  1741	                "arnold_pipelines.megaplan.execute.policy:EXECUTE_BRANCH_SURFACE"
  1742	            ),
  1743	            "batch_continuation": {
  1744	                "route_signal": "execute",
  1745	                "target_ref": "execute-batches",
  1746	                "transition": "NextExecuteTransition.EXECUTE",
  1747	                "policy_helper": (
  1748	                    "arnold_pipelines.megaplan.execute.policy:"
  1749	                    "resolve_single_batch_next_step"
  1750	                ),
  1751	                "condition": "current batch complete AND more batches remain",
  1752	            },
  1753	            "timeout_retry": {
  1754	                "route_signal": "retry",
  1755	                "target_ref": "execute-batches",
  1756	                "outcome": "BlockedRetryOutcome.RETRY",
  1757	                "governed_by": "EXECUTE_POLICY.config.retry",
  1758	                "budget": {
  1759	                    "max_attempts": 2,
  1760	                    "retry_on": ("timeout", "worker_transient"),
  1761	                },
  1762	            },
  1763	            "aggregate_promotion": {
  1764	                "route_signal": "execute_payload",
  1765	                "reducer_ref": "SOURCE_EXECUTE",
  1766	                "target_ref": "review-fan-in",
  1767	                "condition": "all batch payloads reduced into execute_payload",
  1768	            },
  1769	            "review_handoff": {
  1770	                "route_signal": "review",
  1771	                "target_ref": "review-fan-in",
  1772	                "transition": "NextExecuteTransition.REVIEW",
  1773	                "policy_helper": (
  1774	                    "arnold_pipelines.megaplan.execute.policy:"
  1775	                    "resolve_single_batch_next_step"
  1776	                ),
  1777	                "condition": (
  1778	                    "final batch complete AND all tasks/sense-checks tracked"
  1779	                ),
  1780	            },
  1781	        },
  1782	    },
  1783	)

    98	    """Return stable source and lowered-semantic fingerprints for Megaplan resources."""
    99	
   100	    resolved_source_path = workflow_source_path.resolve()
   101	    resolved_module_path = workflow_module_path.resolve()
   102	    workflow_source_text = resolved_source_path.read_text(encoding="utf-8")
   103	    workflow_module_text = resolved_module_path.read_text(encoding="utf-8")
   104	
   105	    lowered_pipeline = lower_workflow_file(resolved_source_path)
   106	    manifest = compile_pipeline(lowered_pipeline)
   107	    lowered_payload = _normalize_for_fingerprint(
   108	        lowered_pipeline,
   109	        path_aliases=_build_path_aliases(resolved_source_path, resolved_module_path),
   110	    )
   111	
   112	    workflow_tree = ast.parse(workflow_source_text)
   113	    function = next(node for node in workflow_tree.body if isinstance(node, ast.FunctionDef))
   114	
   115	    return {
   116	        "canonical_source_path": CANONICAL_SOURCE_RESOURCE_PATH,
   117	        "canonical_source_sha256": _sha256_text(workflow_source_text),
   118	        "workflow_module_path": WORKFLOW_MODULE_RESOURCE_PATH,

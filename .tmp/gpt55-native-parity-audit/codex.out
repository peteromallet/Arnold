   138	    compatibility_quarantine: tuple[CompatibilityQuarantineEntry, ...] = ()
   139	    details: Mapping[str, Any] = field(default_factory=dict)
   140	
   141	    def __post_init__(self) -> None:
   142	        object.__setattr__(self, "diagnostic_code", DiagnosticCode(self.diagnostic_code))
   143	        if self.construct_type is not None:
   144	            object.__setattr__(self, "construct_type", ConstructType(self.construct_type))
   145	        object.__setattr__(
   146	            self, "compatibility_quarantine",
   147	            tuple(
   148	                CompatibilityQuarantineEntry(
   149	                    category=e.category if isinstance(e, CompatibilityQuarantineEntry) else e["category"],
   150	                    adapter_location=e.adapter_location if isinstance(e, CompatibilityQuarantineEntry) else e["adapter_location"],
   151	                    enum_type=e.enum_type if isinstance(e, CompatibilityQuarantineEntry) else e["enum_type"],
   152	                    note=e.note if isinstance(e, CompatibilityQuarantineEntry) else e.get("note", ""),
   153	                )
   154	                for e in self.compatibility_quarantine
   155	            ),
   156	        )
   157	        object.__setattr__(self, "details", _freeze_evidence_mapping(self.details))
   158	
   159	    def to_dict(self) -> dict[str, Any]:
   160	        """Return a sidecar-safe evidence payload with primitive values."""
   161	        payload: dict[str, Any] = {
   162	            "diagnostic_code": self.diagnostic_code.value,
   163	            "checker_version": self.checker_version,
   164	        }
   165	        if self.source_span is not None:
   166	            payload["source_span"] = {
   167	                "path": self.source_span.path,
   168	                "start_line": self.source_span.start_line,
   169	                "start_column": self.source_span.start_column,
   170	                "end_line": self.source_span.end_line,
   171	                "end_column": self.source_span.end_column,
   172	            }
   173	        if self.construct_type is not None:
   174	            payload["construct_type"] = self.construct_type.value
   175	        if self.row_id is not None:
   176	            payload["row_id"] = self.row_id
   177	        if self.compatibility_quarantine:
   178	            payload["compatibility_quarantine"] = [
   179	                {
   180	                    "category": e.category.value,
   181	                    "adapter_location": e.adapter_location,
   182	                    "enum_type": e.enum_type,
   183	                    "note": e.note,
   184	                }
   185	                for e in self.compatibility_quarantine
   186	            ]
   187	        if self.details:
   188	            payload["details"] = _thaw_evidence_value(self.details)
   189	        return payload

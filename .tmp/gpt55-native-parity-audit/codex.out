   440	
   441	def _policy_from_config(config: Mapping[str, Any], *, timeout_seconds: float | None) -> WorkflowPolicy:
   442	    suspension_routes = tuple(
   443	        SuspensionRoute(
   444	            route_id=route["route_id"],
   445	            capability_id=route.get("capability_id"),
   446	            reentry_id=route.get("reentry_id"),
   447	            payload_schema_hash=route.get("payload_schema_hash"),
   448	            resume_schema_hash=route.get("resume_schema_hash"),
   449	            resume_schema_ref=route.get("resume_schema_ref"),
   450	            resume_payload_ref=route.get("resume_payload_ref"),
   451	        )
   452	        for route in config.get("suspension_routes", ())
   453	    )
   454	    control_transitions = tuple(
   455	        ControlTransitionSlot(
   456	            transition_id=transition["transition_id"],
   457	            transition_type=transition["transition_type"],
   458	            trigger_ref=transition.get("trigger_ref"),
   459	            target_ref=transition.get("target_ref"),
   460	            policy_ref=transition.get("policy_ref"),
   461	        )
   462	        for transition in config.get("control_transitions", ())
   463	    )
   464	    retry = None
   465	    if isinstance(config.get("retry"), Mapping):
   466	        retry_config = config["retry"]
   467	        retry = RetryPolicy(
   468	            max_attempts=int(retry_config.get("max_attempts", 1)),
   469	            backoff=str(retry_config.get("backoff", "none")),
   470	            retry_on=tuple(str(item) for item in retry_config.get("retry_on", ())),
   471	        )
   472	    escalation = None
   473	    if isinstance(config.get("escalation"), Mapping):
   474	        escalation_config = config["escalation"]
   475	        escalation = EscalationPolicy(
   476	            targets=tuple(str(item) for item in escalation_config.get("targets", ())),
   477	            escalate_after_attempts=escalation_config.get("escalate_after_attempts"),
   478	            policy_ref=escalation_config.get("policy_ref"),
   479	            backoff=str(escalation_config.get("backoff", "none")),
   480	        )
   481	    budget = None
   482	    if isinstance(config.get("budget"), Mapping):
   483	        budget_config = config["budget"]
   484	        budget = BudgetPolicy(
   485	            max_cost=budget_config.get("max_cost"),
   486	            max_seconds=budget_config.get("max_seconds"),
   487	            max_attempts=budget_config.get("max_attempts"),
   488	            token_budget=budget_config.get("token_budget"),
   489	        )
   490	    effects = tuple(
   491	        EffectRef(
   492	            effect_id=str(effect["effect_id"]),
   493	            route=str(effect.get("route", "default")),
   494	            payload_ref=effect.get("payload_ref"),
   495	            payload_schema_hash=effect.get("payload_schema_hash"),
   496	            idempotency=(
   497	                IdempotencyPolicy(
   498	                    key_ref=effect["idempotency"].get("key_ref"),
   499	                    key_template=effect["idempotency"].get("key_template"),
   500	                    required=bool(effect["idempotency"].get("required", True)),
   501	                )
   502	                if isinstance(effect.get("idempotency"), Mapping)
   503	                else None
   504	            ),
   505	        )
   506	        for effect in config.get("effects", ())
   507	    )
   508	    topology_overlays = tuple(
   509	        TopologyOverlaySlot(
   510	            overlay_id=str(overlay["overlay_id"]),
   511	            overlay_type=str(overlay["overlay_type"]),
   512	            source_ref=overlay.get("source_ref"),
   513	            target_refs=tuple(str(item) for item in overlay.get("target_refs", ())),
   514	            condition_ref=overlay.get("condition_ref"),
   515	            payload_schema_hash=overlay.get("payload_schema_hash"),
   516	        )
   517	        for overlay in config.get("topology_overlays", ())
   518	    )
   519	    authority = tuple(
   520	        AuthorityRequirement(
   521	            authority_id=str(requirement["authority_id"]),
   522	            action=str(requirement["action"]),
   523	            evidence_schema_hash=requirement.get("evidence_schema_hash"),
   524	            capability_id=requirement.get("capability_id"),
   525	        )
   526	        for requirement in config.get("authority", ())
   527	    )
   528	    loop_policy = None
   529	    if "max_iterations" in config or "until_ref" in config:
   530	        loop_policy = LoopPolicy(
   531	            max_iterations=config.get("max_iterations"),
   532	            until_ref=config.get("until_ref"),
   533	        )
   534	    effective_timeout = timeout_seconds if "timeout_seconds_ref" in config else None
   535	    timing = None
   536	    if effective_timeout is not None or "deadline_ref" in config or "ttl_seconds" in config:
   537	        timing = TimingPolicy(
   538	            timeout_seconds=effective_timeout,
   539	            deadline_ref=config.get("deadline_ref"),
   540	            ttl_seconds=config.get("ttl_seconds"),
   541	        )
   542	    return WorkflowPolicy(
   543	        budget=budget,
   544	        retry=retry,
   545	        timing=timing,
   546	        loop=loop_policy,
   547	        effects=effects,
   548	        escalation=escalation,
   549	        suspension_routes=suspension_routes,
   550	        control_transitions=control_transitions,
   551	        topology_overlays=topology_overlays,
   552	        authority=authority,
   553	    )
   554	
   555	
   556	def _policy_for_step(step_id: str, *, timeout_seconds: float | None) -> WorkflowPolicy:
   557	    component = PIPELINE_STEP_COMPONENTS_BY_ID[step_id]
   558	    policy = component.policy or DEFAULT_POLICY
   559	    canonical_policy = _policy_from_config(policy.config, timeout_seconds=timeout_seconds)
   560	    route_targets = _canonical_lowered_route_targets_by_source(_lowered_workflow().routes).get(step_id, {})
   561	    transition_labels = _ROUTE_LABEL_BY_TRANSITION_ID.get(step_id, {})
   562	    control_transitions = []
   563	    for transition in canonical_policy.control_transitions:
   564	        target_ref = transition.target_ref
   565	        route_label = transition_labels.get(transition.transition_id)
   566	        if route_label is not None:
   567	            target_ref = route_targets.get(route_label, target_ref)
   568	        trigger_ref = transition.trigger_ref
   569	        if step_id == "tiebreaker_decision" and isinstance(trigger_ref, str):
   570	            trigger_ref = trigger_ref.replace("tiebreaker_decide.", "tiebreaker_decision.")
   571	        control_transitions.append(
   572	            replace(
   573	                transition,
   574	                trigger_ref=trigger_ref,
   575	                target_ref=target_ref,
   576	            )
   577	        )
   578	    if control_transitions == list(canonical_policy.control_transitions):
   579	        return canonical_policy
   580	    return replace(canonical_policy, control_transitions=tuple(control_transitions))
   581	
   582	
   583	def _metadata_for_step(step_id: str) -> dict[str, Any]:
   584	    component = PIPELINE_STEP_COMPONENTS_BY_ID[step_id]
   585	    declared = declared_step_interface(step_id)
   586	    metadata: dict[str, Any] = {}
   587	    handler_ref = declared.get("handler_ref", component.metadata.get("handler_ref"))
   588	    if isinstance(handler_ref, str):
   589	        metadata["handler_ref"] = handler_ref
   590	    if declared.get("terminal", component.metadata.get("terminal")) is True:
   591	        metadata["terminal"] = True
   592	    if step_id == "revise":
   593	        metadata["max_iterations"] = M4_LOOP_MAX_ITERATIONS
   594	    for key in ("policy_refs", "override_actions"):
   595	        value = declared.get(key, component.metadata.get(key))
   596	        if isinstance(value, Sequence) and not isinstance(value, (str, bytes)) and value:
   597	            metadata[key] = tuple(value)
   598	    return metadata
   599	
   600	
   601	def _merge_policies(*policies: WorkflowPolicy) -> WorkflowPolicy:
   602	    return WorkflowPolicy(
   603	        budget=next((policy.budget for policy in reversed(policies) if policy.budget is not None), None),
   604	        retry=next((policy.retry for policy in reversed(policies) if policy.retry is not None), None),
   605	        loop=next((policy.loop for policy in reversed(policies) if policy.loop is not None), None),
   606	        fanout=next((policy.fanout for policy in reversed(policies) if policy.fanout is not None), None),
   607	        timing=next((policy.timing for policy in reversed(policies) if policy.timing is not None), None),
   608	        idempotency=next(
   609	            (policy.idempotency for policy in reversed(policies) if policy.idempotency is not None),
   610	            None,
   611	        ),
   612	        effects=tuple(effect for policy in policies for effect in policy.effects),
   613	        reducers=tuple(reducer for policy in policies for reducer in policy.reducers),
   614	        compensation=next(
   615	            (policy.compensation for policy in reversed(policies) if policy.compensation is not None),
   616	            None,
   617	        ),
   618	        escalation=next(
   619	            (policy.escalation for policy in reversed(policies) if policy.escalation is not None),
   620	            None,
   621	        ),
   622	        control_transitions=tuple(
   623	            transition for policy in policies for transition in policy.control_transitions
   624	        ),
   625	        topology_overlays=tuple(
   626	            overlay for policy in policies for overlay in policy.topology_overlays
   627	        ),
   628	        authority=tuple(requirement for policy in policies for requirement in policy.authority),
   629	        suspension_routes=tuple(route for policy in policies for route in policy.suspension_routes),
   630	    )
   631	
   632	
   633	def _manifest_policy(*, timeout_seconds: float | None) -> WorkflowPolicy:
   634	    return _merge_policies(
   635	        _policy_from_config(DEFAULT_POLICY.config, timeout_seconds=timeout_seconds),
   636	        _policy_from_config(MODEL_ROUTING_POLICY.config, timeout_seconds=None),
   637	        _policy_from_config(ROBUSTNESS_POLICY.config, timeout_seconds=None),
   638	        _policy_from_config(ARTIFACT_CONTRACT_POLICY.config, timeout_seconds=None),
   639	        _policy_from_config(SUSPENSION_POLICY.config, timeout_seconds=None),
   640	    )

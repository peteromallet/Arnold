   208	def _topology_step_id(step_id: str) -> str:
   209	    canonical_step_id = _canonical_step_id(step_id)
   210	    if canonical_step_id != step_id:
   211	        return canonical_step_id
   212	    if "review" in step_id:
   213	        if step_id.endswith(("-execute-batches", "_execute_batches")):
   214	            return "execute"
   215	        if step_id.endswith(("-fan-in", "_fan_in")):
   216	            return "review"
   217	    return step_id

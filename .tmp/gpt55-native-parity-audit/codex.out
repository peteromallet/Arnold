  1079	def _review_topology_contract_owns_cap_thresholds(contract: Mapping[str, Any]) -> bool:
  1080	    disallowed_keys = {
  1081	        "cap_thresholds",
  1082	        "max_review_rework_cycles",
  1083	        "max_rework_cycles",
  1084	        "review_cap_threshold",
  1085	        "rework_cycle_cap",
  1086	    }
  1087	    for key, value in contract.items():
  1088	        lowered_key = str(key).lower()
  1089	        if lowered_key in disallowed_keys or lowered_key.endswith("_threshold"):
  1090	            return True
  1091	        if lowered_key == "retry_and_cap" and isinstance(value, Mapping):
  1092	            for nested_key, nested_value in value.items():
  1093	                nested_lowered = str(nested_key).lower()
  1094	                if nested_lowered in disallowed_keys or nested_lowered.endswith("_threshold"):
  1095	                    return True
  1096	                if isinstance(nested_value, Mapping):
  1097	                    return True
  1098	        elif isinstance(value, Mapping) and _review_topology_contract_owns_cap_thresholds(value):
  1099	            return True
  1100	    return False

   343	    assert payloads[0]["construct_type"] == "critique"
   344	    assert payloads[1]["row_id"] == S2_REVISE_ROW_ID
   345	    assert payloads[1]["construct_type"] == "revise"
   346	
   347	
   348	def test_diagnostic_details_include_component_ref() -> None:
   349	    """AWF245 diagnostics must carry the component_ref of the offending
   350	    step so consumers can trace back to the import."""
   351	    result = check_workflow_source(_SOURCE_TEMPLATE, source_path="test.pypeline")
   352	    awf245_diags = [
   353	        d for d in result.diagnostics
   354	        if d.code is DiagnosticCode.ROW_EVIDENCE_INSUFFICIENCY
   355	    ]
   356	    assert len(awf245_diags) >= 1
   357	    component_refs = {d.component_ref for d in awf245_diags if d.component_ref}
   358	    assert len(component_refs) >= 1
   359	    # Both prep and plan should have component refs ending with the component name.
   360	    for ref in component_refs:
   361	        assert "SOURCE_PREP" in ref or "SOURCE_PLAN" in ref
   362	
   363	
   364	def test_check_workflow_file_passes_evidence_through() -> None:
   365	    """check_workflow_file must forward evidence to check_workflow_source
   366	    and produce the same result shape."""
   367	    import tempfile, os
   368	
   369	    evidence = (_evidence_for(S2_PREP_ROW_ID), _evidence_for(S2_PLAN_ROW_ID))
   370	    source = _SOURCE_TEMPLATE
   371	
   372	    with tempfile.NamedTemporaryFile(
   373	        mode="w", suffix=".py", delete=False, encoding="utf-8"
   374	    ) as tmp:
   375	        tmp.write(source)
   376	        tmp_path = tmp.name
   377	
   378	    try:
   379	        from arnold.workflow import check_workflow_file
   380	
   381	        result = check_workflow_file(tmp_path, evidence=evidence)
   382	        assert result.ok
   383	        assert result.evidence == evidence
   384	    finally:
   385	        os.unlink(tmp_path)
   386	

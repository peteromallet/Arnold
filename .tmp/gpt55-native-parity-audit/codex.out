  1734	def _front_half_row_specs() -> Mapping[str, tuple[str, str]]:
  1735	    try:
  1736	        from arnold_pipelines.megaplan.workflows.boundary_contracts import BOUNDARY_CONTRACTS
  1737	    except ImportError:
  1738	        return MappingProxyType({})
  1739	
  1740	    front_half_phases = frozenset(
  1741	        {
  1742	            "prep",
  1743	            "plan",
  1744	            "critique",
  1745	            "gate",
  1746	            "revise",
  1747	            "tiebreaker_researcher",
  1748	            "tiebreaker_challenger",
  1749	            "tiebreaker_synthesis",
  1750	            "tiebreaker_decision",
  1751	        }
  1752	    )
  1753	    row_specs: dict[str, tuple[str, str]] = {}
  1754	    for contract in BOUNDARY_CONTRACTS:
  1755	        if contract.phase is None or contract.row_id is None:
  1756	            continue
  1757	        if contract.phase.value not in front_half_phases:
  1758	            continue
  1759	        phase_name = contract.phase.value.upper()
  1760	        # Prefixed exports (SOURCE_*, AUTHORING_*) plus the bare export name
  1761	        # so that components like TIEBREAKER_RESEARCHER (which don't follow
  1762	        # the SOURCE_/AUTHORING_ convention) are still detected.
  1763	        for export_name in (f"SOURCE_{phase_name}", f"AUTHORING_{phase_name}", phase_name):
  1764	            row_specs[
  1765	                f"arnold_pipelines.megaplan.workflows.components:{export_name}"
  1766	            ] = (contract.row_id, contract.phase.value)
  1767	    return MappingProxyType(row_specs)

   532	        assert diag.details["missing_row_id"].startswith("s3.")
   533	        assert diag.details["missing_phase"].startswith("tiebreaker_")
   534	        assert "s3.tiebreaker_researcher.1" in diag.details["implemented_s3_rows"]

   271	def _canonical_lowered_routes(lowered_routes: Sequence[Route]) -> tuple[Route, ...]:
   272	    seen: set[tuple[str, str, str, str | None]] = set()
   273	    seen_route_ids: set[str] = set()
   274	    routes: list[Route] = []
   275	    for lowered in lowered_routes:
   276	        source = _canonical_step_id(lowered.source)
   277	        target = _canonical_step_id(lowered.target)
   278	        if source not in PIPELINE_STEP_COMPONENTS_BY_ID or target not in PIPELINE_STEP_COMPONENTS_BY_ID:
   279	            continue
   280	        signature = (source, target, lowered.label, lowered.condition_ref)
   281	        if signature in seen:
   282	            continue
   283	        seen.add(signature)
   284	        route = Route(
   285	            id=_route_id_for_lowered_route(lowered, source=source, target=target),
   286	            source=source,
   287	            target=target,
   288	            label=lowered.label,
   289	            condition_ref=lowered.condition_ref,
   290	            metadata={},
   291	        )
   292	        if route.id in seen_route_ids:
   293	            continue
   294	        seen_route_ids.add(route.id)
   295	        routes.append(route)
   296	    return tuple(routes)
   297	
   298	

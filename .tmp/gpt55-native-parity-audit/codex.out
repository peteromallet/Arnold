   537	# ── S4 execute evidence visibility ──────────────────────────────────────────
   538	# Prove that S4 execute row IDs, construct types, and boundary phases are
   539	# registered and visible to the semantic checker without false positives.
   540	
   541	
   542	_EXECUTE_SOURCE_TEMPLATE = """\
   543	from __future__ import annotations
   544	
   545	from arnold.workflow.authoring import workflow
   546	from arnold_pipelines.megaplan.workflows.components import SOURCE_EXECUTE
   547	

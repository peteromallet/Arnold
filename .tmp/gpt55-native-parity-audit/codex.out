    43	class _RouteSignalAlias(str):
    44	    def __new__(cls, value: str, *aliases: str) -> "_RouteSignalAlias":
    45	        obj = str.__new__(cls, value)
    46	        obj._aliases = frozenset(aliases)
    47	        return obj
    48	
    49	    def __eq__(self, other: object) -> bool:
    50	        return str.__eq__(self, other) or other in self._aliases
    51	
    52	    __hash__ = str.__hash__
    53	
    54	
    55	class _SupersetComparableMapping(dict):
    56	    __arnold_preserve_mapping__ = True
    57	
    58	    def __eq__(self, other: object) -> bool:
    59	        if not isinstance(other, Mapping):
    60	            return False
    61	        if set(other).issubset(set(self)):
    62	            return all(self[key] == value for key, value in other.items())
    63	        return dict.__eq__(self, other)
    64	
    65	
    66	def _superset_mapping(value: Mapping[str, Any]) -> _SupersetComparableMapping:
    67	    return _SupersetComparableMapping(
    68	        {
    69	            key: _superset_mapping(subvalue)
    70	            if isinstance(subvalue, Mapping)
    71	            else tuple(subvalue)
    72	            if isinstance(subvalue, list)
    73	            else subvalue
    74	            for key, subvalue in value.items()
    75	        }
    76	    )

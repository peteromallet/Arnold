   969	        if _normalized_topology_id(call.id).endswith("review-rework-fan-in")
   970	        and _component_ref_matches_exports(call.reducer_ref, _MEGAPLAN_REVIEW_REDUCER_EXPORTS)
   971	    ]
   972	    if execute_calls and review_calls:
   973	        return review_calls[0]

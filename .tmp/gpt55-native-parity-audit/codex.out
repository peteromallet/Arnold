   561	@decision(vocabulary={"approved", "needs_rework", "blocked", "human_verify", "retry_review"})
   562	def review_decision(
   563	    ctx: MegaplanContext,
   564	    review_payload: ReviewPayload,
   565	    rework_loop: LoopState,
   566	) -> ReviewDecision:
   567	    if review_payload.infrastructure_failure:
   568	        return "retry_review"
   569	    if review_payload.deferred_human_musts:
   570	        return "human_verify"
   571	    if review_payload.verdict == "needs_rework" and rework_loop.has_remaining:
   572	        return "needs_rework"
   573	    if review_payload.verdict == "needs_rework" and review_payload.has_blocking_rework:
   574	        return "blocked"
   575	    if review_payload.verdict == "needs_rework":
   576	        return "approved"
   577	    return review_payload.verdict

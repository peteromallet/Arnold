   856	
   857	def test_old_wrapper_fails_even_with_both_receipts_and_findings() -> None:
   858	    """Even when both boundary receipts AND semantic-health findings are present
   859	    for every S3 tiebreaker phase, the old SOURCE_TIEBREAKER_WORKFLOW single-call
   860	    wrapper must still emit AWF252.  No combination of boundary/semantic evidence
   861	    can compensate for missing source-visible topology."""
   862	    from arnold_pipelines.megaplan.workflows.boundary_contracts import (
   863	        BOUNDARY_CONTRACTS as _ALL_CONTRACTS,
   864	    )

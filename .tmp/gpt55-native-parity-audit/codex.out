   421	    if workflow_id is None:
   422	        return {}
   423	    topology_contract = declared_workflow_topology_contract(workflow_id)
   424	    fanout_contract = topology_contract.get("fanout_contract")
   425	    return fanout_contract if isinstance(fanout_contract, Mapping) else {}
   426	
   427	
   428	def declared_fan_in_contract(*, step_id: str | None = None, workflow_id: str | None = None) -> Mapping[str, Any]:
   429	    if step_id is not None:
   430	        route_surface = declared_route_surface(step_id)
   431	        fan_in_contract = route_surface.get("fan_in_contract")
   432	        if isinstance(fan_in_contract, Mapping):
   433	            return fan_in_contract
   434	    if workflow_id is None:
   435	        return {}
   436	    topology_contract = declared_workflow_topology_contract(workflow_id)
   437	    fan_in_contract = topology_contract.get("fan_in_contract")
   438	    return fan_in_contract if isinstance(fan_in_contract, Mapping) else {}

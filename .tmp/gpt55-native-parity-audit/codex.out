   122	
   123	
   124	@dataclass(frozen=True)
   125	class SemanticEvidence:
   126	    """Structured semantic evidence for a single checker finding.
   127	
   128	    Every proven conformance row must be backed by at least one
   129	    SemanticEvidence record. This is the machine-readable carrier that
   130	    replaces the old false-pass pattern of bare string status fields.
   131	    """
   132	
   133	    diagnostic_code: DiagnosticCode
   134	    source_span: SourceSpan | None = None

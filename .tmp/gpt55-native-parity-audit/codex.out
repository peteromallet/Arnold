   226	def check_outcome_vocabulary_parity() -> dict[str, dict[str, tuple[str, ...]]]:
   227	    """Return runtime/typed outcome vocabulary mismatches by step id."""
   228	
   229	    mismatches: dict[str, dict[str, tuple[str, ...]]] = {}
   230	    for step_id, outcome_type in _OUTCOME_VOCABULARY_BY_STEP.items():
   231	        runtime_values = set(RUNTIME_BRANCH_VOCABULARY.get(step_id, ()))
   232	        outcome_values = {member.value for member in outcome_type}
   233	        missing_from_runtime = tuple(sorted(outcome_values - runtime_values))
   234	        missing_from_outcome = tuple(sorted(runtime_values - outcome_values))
   235	        if missing_from_runtime or missing_from_outcome:
   236	            mismatches[step_id] = {
   237	                "missing_from_runtime": missing_from_runtime,
   238	                "missing_from_outcome": missing_from_outcome,
   239	            }
   240	    return mismatches

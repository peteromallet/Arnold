 ! -e tmp_repro_creative_invalid_form_cli.py && echo deleted\"],\"auto_attributed_files\":null},{\"task_id\":\"T9\",\"status\":\"done\",\"executor_notes\":\"Creative dispatch behavior stayed green: focused creative pipeline/prompt tests passed with joke-specific slots and non-joke generic slots intact.\",\"files_changed\":[],\"commands_run\":[\"pytest tests/test_pipeline_run_cli.py tests/test_prompts_creative.py tests/pipelines/test_creative_pipeline.py\"],\"auto_attributed_files\":null},{\"task_id\":\"T10\",\"status\":\"done\",\"executor_notes\":\"Judges demo tests passed unchanged, preserving the expected artifact behavior based on emitted `StepResult.outputs`.\",\"files_changed\":[],\"commands_run\":[\"pytest tests/test_pipeline_modes.py tests/pipelines/test_doc_pipeline.py tests/pipelines/test_creative_pipeline.py tests/test_pipeline_registry.py tests/test_pipeline_demo_judges.py\"],\"auto_attributed_files\":null},{\"task_id\":\"T11\",\"status\":\"done\",\"executor_notes\":\"Final validation was rerun. Residual removed-symbol search returned no active hits; the throwaway invalid-form repro passed and was deleted; targeted suites passed. Full `pytest` completed with 2680 passed, 25 skipped, 3 failed, all recurring `PermissionError` failures attempting to create `/Users/peteromalley/.megaplan/project-*` outside the writable workspace. Diff review still shows unrelated dirty files from prior work; this pass did not touch them and narrowed new writes to the three listed files.\",\"files_changed\":[\"megaplan/_pipeline/run_cli.py\",\"megaplan/pipelines/creative/__init__.py\",\"tests/test_pipeline_run_cli.py\"],\"commands_run\":[\"rg -n \\\"compile_pipeline_for|mode_overlay|robustness_overlay|with_prep_overlay|with_feedback_overlay|_step_for|_RuntimeStep\\\" megaplan tests docs README.md -g '!megaplan/agent/**' -g '!docs/briefs/**' -g '!**/__pycache__/**'\",\"python tmp_repro_creative_invalid_form_cli.py\",\"rm tmp_repro_creative_invalid_form_cli.py && test ! -e tmp_repro_creative_invalid_form_cli.py && echo deleted\",\"pytest tests/test_pipeline_modes.py tests/pipelines/test_doc_pipeline.py tests/pipelines/test_creative_pipeline.py tests/test_pipeline_registry.py tests/test_pipeline_demo_judges.py\",\"pytest tests/test_pipeline_run_cli.py tests/test_prompts_creative.py tests/pipelines/test_creative_pipeline.py\",\"pytest tests/test_pipeline_planning_e2e.py tests/test_pipeline_planning_parity.py tests/test_pipeline_runtime_e2e.py tests/test_pipeline_runnable_e2e.py tests/test_pipeline_composability.py tests/test_pipeline_integration.py tests/test_pipeline_parity.py\",\"pytest\",\"git status --short\",\"git diff --stat\",\"git diff --stat -- megaplan/_pipeline/run_cli.py megaplan/pipelines/creative/__init__.py tests/test_pipeline_run_cli.py\",\"git diff --name-only\"],\"auto_attributed_files\":null}],\"sense_check_acknowledgments\":[{\"sense_check_id\":\"SC1\",\"executor_note\":\"Confirmed by residual search and focused creative tests; this rework did not add planning-artifact-dependent prompt paths.\"},{\"sense_check_id\":\"SC2\",\"executor_note\":\"Confirmed: removed shim symbols remain absent from active source/tests/docs.\"},{\"sense_check_id\":\"SC3\",\"executor_note\":\"Confirmed: planning/runtime/composability suites pass against canonical planning behavior.\"},{\"sense_check_id\":\"SC4\",\"executor_note\":\"Confirmed by residual symbol search over active docs; no removed wrapper names were reintroduced.\"},{\"sense_check_id\":\"SC5\",\"executor_note\":\"Confirmed: doc pipeline tests pass with mechanics in `megaplan.pipelines.doc.steps`.\"},{\"sense_check_id\":\"SC6\",\"executor_note\":\"Confirmed: creative pipeline tests pass after the CLI fix, preserving prompt rendering and artifact flow.\"},{\"sense_check_id\":\"SC7\",\"executor_note\":\"Confirmed: creative prompt tests pass, including fresh-run-safe generic builders and non-joke-safe prep behavior.\"},{\"sense_check_id\":\"SC8\",\"executor_note\":\"Confirmed after rework: invalid forms now use the `CliError('invalid_args')` builder path before profile/preflight; existing tests still cover option rejection, state seeding, and `_pipeline` input injection.\"},{\"sense_check_id\":\"SC9\",\"executor_note\":\"Confirmed: focused creative tests still prove default joke uses runnable specialized keys while non-joke forms resolve generic keys.\"},{\"sense_check_id\":\"SC10\",\"executor_note\":\"Confirmed: judges demo targeted tests pass unchanged.\"},{\"sense_check_id\":\"SC11\",\"executor_note\":\"Partially confirmed with an explicit diff-scope caveat: searches, repro, targeted suites, and full-suite run completed; unrelated dirty files remain present but were not modified in this pass.\"}]}"}}
.megaplan/plans/pipeline-week1-cleanup/critique_v5.json:36:          "detail": "Searched the broader creative prompt dispatch concept: current `build_pipeline(form='poem')` and `tests/pipelines/test_creative_pipeline.py` still use form-baked keys such as `execute_creative:poem`, while the registry only has generic creative keys plus joke-specific registrations. The revised plan correctly narrows the solution to generic keys for non-joke forms, preserving joke-specific keys only where specialized runnable behavior exists, and it does not broaden into a new prompt plugin framework.",
.megaplan/plans/pipeline-week1-cleanup/critique_v5.json:68:          "detail": "Checked the actual `megaplan run` caller path: `cli_run()` currently reaches `_run_pipeline(args)`, resolves profile/preflight, parses `input_file` into `inputs['draft']`, then builds the pipeline through `_build_pipeline_for_run(args)`. The revised plan accounts for these caller arguments by adding creative-specific `--form` and `--primary-criterion` construction, rejecting those set options for non-creative pipelines, seeding creative state from CLI/existing state/positional input, and validating invalid creative forms before credential/profile preflight can mask them.",
.megaplan/plans/pipeline-week1-cleanup/execution_batch_11.json:6:      "executor_notes": "Final validation completed. Residual removed-symbol search over active source/tests/docs found no hits for compile_pipeline_for, mode_overlay, robustness_overlay, with_prep_overlay, with_feedback_overlay, or _RuntimeStep outside excluded archived/vendor paths. A throwaway fresh non-joke creative repro script exercised build_pipeline(form='poem') through run_pipeline with ctx inputs['_pipeline']='creative', verified prep/execute_creative/critique_creative/revise_creative prompts rendered without plan_versions, finalize.json, or gate.json, and was deleted afterward. Targeted validation passed: pipeline modes/doc/creative/registry/demo judges (30 passed); focused creative prompt/CLI tests (38 passed, 4 skipped); planning/runtime/composability suites (29 passed). Full pytest was run and reported 2677 passed, 25 skipped, 3 failed; the 3 failures are the recurring sandbox-only PermissionError failures in tests/test_epic_cli.py::test_migrate_local_plans_dry_run_does_not_write_and_import_preserves_nested_binary, tests/test_epic_cli.py::test_migrate_local_plans_all_projects_legacy_epic_and_db_promotion_preserve_binary, and tests/test_ops_recovery_docs.py::test_ops_missing_blob_export_and_partial_legacy_conflict when creating /Users/peteromalley/.megaplan/project-* outside writable roots. Final git diff review showed the accumulated expected plan files plus unrelated pre-existing dirty files; T11 itself only removed the unused Verdict import from tests/test_pipeline_registry.py while preserving prior judges assertions. Checkpoint JSON was written and validated with jq.",
.megaplan/plans/pipeline-week1-cleanup/plan_v5.meta.json:163:      "criterion": "Doc and creative pipeline `__init__.py` files primarily expose metadata and `build_pipeline()`, with step shell mechanics in dedicated `steps.py` modules.",
.megaplan/plans/pipeline-week1-cleanup/critique_v4.json:98:          "detail": "Existing creative pipeline tests are a concrete location the plan needs to update: `tests/pipelines/test_creative_pipeline.py` currently asserts that `build_pipeline(form='poem')` produces `prep:poem`, `execute_creative:poem`, `critique_creative:poem`, and `revise_creative:poem`. The revised plan says non-joke forms should use generic prompt keys, but it does not name this stale test as an update target, so an implementer following only the listed test additions could leave contradictory assertions in place until validation fails.",
.megaplan/plans/pipeline-week1-cleanup/critique_v4.json:116:          "detail": "The plan correctly handles the direct `_build_pipeline_for_run(args)` caller: `cli_run()` is the only production caller in the current tree, and the revised plan requires testing the actual `cli_run()` surface rather than only the helper.",
.megaplan/plans/pipeline-week1-cleanup/final.md:35:- [x] **T5:** Clean the doc pipeline module boundary and stale callers. Keep `megaplan/pipelines/doc/__init__.py` focused on metadata plus `build_pipeline()`, keep step shell mechanics in `megaplan/pipelines/doc/steps.py`, and update doc pipeline tests to import and patch public step shell classes such as `megaplan.pipelines.doc.steps.SectionDraftStep` instead of stale private package-root names.
.megaplan/plans/pipeline-week1-cleanup/final.md:43:- [x] **T6:** Make the creative pipeline table-driven with real runnable step shells. Keep `megaplan/pipelines/creative/__init__.py` to metadata, validation, stage-spec table, and `build_pipeline()`, implement `CreativeStep.run()` in `megaplan/pipelines/creative/steps.py` so it resolves registered prompt keys with `StepContext` state and inputs, writes real stage artifacts, passes prior stage artifacts forward, preserves form validation, and propagates `primary_criterion` through stage configuration.
.megaplan/plans/pipeline-week1-cleanup/final.md:60:  Executor notes: Fixed the reviewer blocker. `_run_pipeline()` now validates creative-only options, then builds the creative pipeline before profile resolution/preflight so unknown forms are raised by `build_pipeline()` as `CliError('invalid_args')`; CLI handling emits the structured invalid-argument payload and returns exit code 2. The repro script confirmed profile/preflight were not reached for an invalid form.
.megaplan/plans/pipeline-week1-cleanup/plan_v4.md:31:1. Keep `megaplan/pipelines/doc/__init__.py` primarily to metadata plus `build_pipeline()`.
.megaplan/plans/pipeline-week1-cleanup/plan_v4.md:38:1. Keep `megaplan/pipelines/creative/__init__.py` to metadata, validation, a stage-spec table, and `build_pipeline()`.
.megaplan/plans/pipeline-week1-cleanup/plan_v4.md:44:7. Update `tests/pipelines/test_creative_pipeline.py` directly: assertions for `build_pipeline(form='poem')` must expect generic non-joke keys such as `prep`, `execute_creative`, `critique_creative`, and `revise_creative`, while joke assertions may continue to expect specialized `:joke` keys when those registrations exist.
.megaplan/plans/pipeline-week1-cleanup/plan_v4.md:50:2. Keep the scope narrow: only the creative first-class pipeline needs parameterized construction for this cleanup. Prefer a small helper in `run_cli` that calls `megaplan.pipelines.creative.build_pipeline(form=args.form, primary_criterion=args.primary_criterion)` when `pipeline_name == 'creative'`; keep `get_pipeline(name)` nullary for ordinary registry use.
.megaplan/plans/pipeline-week1-cleanup/faults.json:54:      "concern": "Did the work fully address the issue hints, user notes, and approved plan requirements?: Creative run path: the plan says to preserve form validation, form-specific prompt keys like `execute_creative:joke`, and primary criterion propagation, but `megaplan/_pipeline/run_cli.py` has no `--form` or `--primary-criterion` options and calls `get_pipeline(pipeline_name)`, whose registry builder invokes `build_pipeline()` with no keyword arguments. That means `megaplan run creative --form poem` cannot work through the first-class pipeline path without additional CLI and registry-builder plumbing, despite tests and docs describing that surface.",
.megaplan/plans/pipeline-week1-cleanup/faults.json:106:      "concern": "Does the change touch all locations AND supporting infrastructure?: Existing creative pipeline tests are a concrete location the plan needs to update: `tests/pipelines/test_creative_pipeline.py` currently asserts that `build_pipeline(form='poem')` produces `prep:poem`, `execute_creative:poem`, `critique_creative:poem`, and `revise_creative:poem`. The revised plan says non-joke forms should use generic prompt keys, but it does not name this stale test as an update target, so an implementer following only the listed test additions could leave contradictory assertions in place until validation fails.",
.megaplan/plans/pipeline-week1-cleanup/faults.json:119:      "concern": "Find the callers of the changed function. What arguments do they actually pass? Does the fix handle all of them?: The registry caller contract is nullary: `PipelineBuilder = Callable[[], Pipeline]`, `PipelineRegistry.get()` calls `self.builders[name]()`, and discovered pipeline builders are stored directly. This handles `build_pipeline()` defaults but cannot pass `form='poem'` or `primary_criterion='...'` to `megaplan.pipelines.creative.build_pipeline`, so only the default joke form is reachable through `get_pipeline('creative')` today.",
.megaplan/plans/pipeline-week1-cleanup/faults.json:161:      "evidence": "`_run_pipeline()` calls `preflight_or_raise()` before `_build_pipeline_for_run(args)`. A direct `cli_run` with invalid creative form returned credential preflight code 7 in this environment; with preflight patched, `CliError invalid_args` propagated from `_build_pipeline_for_run()`.",
.megaplan/plans/pipeline-week1-cleanup/faults.json:170:      "concern": "Creative option scope: set creative-only options are silently accepted for non-creative pipelines because the parser adds them globally and `_build_pipeline_for_run()` ignores them unless `pipeline_name == 'creative'`.",
.megaplan/plans/pipeline-week1-cleanup/finalize_snapshot.json:75:      "description": "Clean the doc pipeline module boundary and stale callers. Keep `megaplan/pipelines/doc/__init__.py` focused on metadata plus `build_pipeline()`, keep step shell mechanics in `megaplan/pipelines/doc/steps.py`, and update doc pipeline tests to import and patch public step shell classes such as `megaplan.pipelines.doc.steps.SectionDraftStep` instead of stale private package-root names.",
.megaplan/plans/pipeline-week1-cleanup/finalize_snapshot.json:93:      "description": "Make the creative pipeline table-driven with real runnable step shells. Keep `megaplan/pipelines/creative/__init__.py` to metadata, validation, stage-spec table, and `build_pipeline()`, implement `CreativeStep.run()` in `megaplan/pipelines/creative/steps.py` so it resolves registered prompt keys with `StepContext` state and inputs, writes real stage artifacts, passes prior stage artifacts forward, preserves form validation, and propagates `primary_criterion` through stage configuration.",
.megaplan/plans/pipeline-week1-cleanup/plan_v3.md:31:1. Keep `megaplan/pipelines/doc/__init__.py` primarily to metadata plus `build_pipeline()`.
.megaplan/plans/pipeline-week1-cleanup/plan_v3.md:38:1. Keep `megaplan/pipelines/creative/__init__.py` to metadata, validation, a stage-spec table, and `build_pipeline()`.
.megaplan/plans/pipeline-week1-cleanup/plan_v3.md:48:2. Keep the scope narrow: only the creative first-class pipeline needs parameterized construction for this cleanup. Prefer a small helper in `run_cli` that calls `megaplan.pipelines.creative.build_pipeline(form=args.form, primary_criterion=args.primary_criterion)` when `pipeline_name == 'creative'`; keep `get_pipeline(name)` nullary for ordinary registry use unless existing tests make a registry-level hook cleaner.
.megaplan/plans/pipeline-week1-cleanup/plan_v3.md:53:7. Add or update focused `cli_run()`-level tests, not only `_build_pipeline_for_run()` tests, proving invalid creative forms fail before credential preflight, creative-only options are rejected on non-creative pipelines, creative config is seeded into state, and valid non-joke forms resolve through the prompt registry.
.megaplan/plans/pipeline-week1-cleanup/gate.json:124:        "criterion": "Doc and creative pipeline `__init__.py` files primarily expose metadata and `build_pipeline()`, with step shell mechanics in dedicated `steps.py` modules.",
.megaplan/plans/pipeline-week1-cleanup/gate.json:224:    "idea": "# Pipeline Week 1 Cleanup\n\n## Outcome\n\nMake pipeline modules describe topology, not compatibility shims or inline\nworkflow mechanics.\n\n## Scope\n\nIn scope:\n\n- Remove planning compatibility shims entirely.\n- Keep `compile_planning_pipeline()` as the only planning compiler.\n- Split doc and creative pipeline step shells into dedicated modules.\n- Make the creative pipeline table-driven.\n- Remove duplicate judges artifact path plumbing.\n- Update focused tests and docs that referenced removed shim APIs.\n\nOut of scope:\n\n- Unrelated execution, review, worker, profile, and ticket changes already\n  present in the worktree.\n- Broad desloppify queue work.\n- Public backward-compat wrappers for the removed planning APIs.\n\n## Locked Decisions\n\n- No shims.\n- No compatibility wrappers.\n- No legacy overlay path.\n- First-class `doc` and `creative` pipelines are the mode path.\n- Pipeline `__init__.py` files should primarily expose metadata and\n  `build_pipeline()`.\n\n## Done Criteria\n\n- Targeted pipeline tests pass.\n- `rg` finds no in-tree imports of `compile_pipeline_for`, `mode_overlay`,\n  `robustness_overlay`, `with_prep_overlay`, `with_feedback_overlay`,\n  `_step_for`, or `_RuntimeStep`, except historical docs that are explicitly\n  updated or clearly archived.\n- Unrelated dirty files are left untouched.",
.megaplan/plans/pipeline-week1-cleanup/gate.json:245:        "concern": "Did the work fully address the issue hints, user notes, and approved plan requirements?: Creative run path: the plan says to preserve form validation, form-specific prompt keys like `execute_creative:joke`, and primary criterion propagation, but `megaplan/_pipeline/run_cli.py` has no `--form` or `--primary-criterion` options and calls `get_pipeline(pipeline_name)`, whose registry builder invokes `build_pipeline()` with no keyword arguments. That means `megaplan run creative --form poem` cannot work through the first-class pipeline path without additional CLI and registry-builder plumbing, despite tests and docs describing that surface.",
.megaplan/plans/pipeline-week1-cleanup/gate.json:265:        "concern": "Does the change touch all locations AND supporting infrastructure?: Existing creative pipeline tests are a concrete location the plan needs to update: `tests/pipelines/test_creative_pipeline.py` currently asserts that `build_pipeline(form='poem')` produces `prep:poem`, `execute_creative:poem`, `critique_creative:poem`, and `revise_creative:poem`. The revised plan says non-joke forms should use generic prompt keys, but it does not name this stale test as an update target, so an implementer following only the listed test additions could leave contradictory assertions in place until validation fails.",
.megaplan/plans/pipeline-week1-cleanup/gate.json:270:        "concern": "Find the callers of the changed function. What arguments do they actually pass? Does the fix handle all of them?: The registry caller contract is nullary: `PipelineBuilder = Callable[[], Pipeline]`, `PipelineRegistry.get()` calls `self.builders[name]()`, and discovered pipeline builders are stored directly. This handles `build_pipeline()` defaults but cannot pass `form='poem'` or `primary_criterion='...'` to `megaplan.pipelines.creative.build_pipeline`, so only the default joke form is reachable through `get_pipeline('creative')` today.",
.megaplan/plans/pipeline-week1-cleanup/gate.json:286:        "resolution": "`_run_pipeline()` calls `preflight_or_raise()` before `_build_pipeline_for_run(args)`. A direct `cli_run` with invalid creative form returned credential preflight code 7 in this environment; with preflight patched, `CliError invalid_args` propagated from `_build_pipeline_for_run()`."
.megaplan/plans/pipeline-week1-cleanup/gate.json:290:        "concern": "Creative option scope: set creative-only options are silently accepted for non-creative pipelines because the parser adds them globally and `_build_pipeline_for_run()` ignores them unless `pipeline_name == 'creative'`.",
.megaplan/plans/pipeline-week1-cleanup/finalize.json:83:      "description": "Clean the doc pipeline module boundary and stale callers. Keep `megaplan/pipelines/doc/__init__.py` focused on metadata plus `build_pipeline()`, keep step shell mechanics in `megaplan/pipelines/doc/steps.py`, and update doc pipeline tests to import and patch public step shell classes such as `megaplan.pipelines.doc.steps.SectionDraftStep` instead of stale private package-root names.",
.megaplan/plans/pipeline-week1-cleanup/finalize.json:103:      "description": "Make the creative pipeline table-driven with real runnable step shells. Keep `megaplan/pipelines/creative/__init__.py` to metadata, validation, stage-spec table, and `build_pipeline()`, implement `CreativeStep.run()` in `megaplan/pipelines/creative/steps.py` so it resolves registered prompt keys with `StepContext` state and inputs, writes real stage artifacts, passes prior stage artifacts forward, preserves form validation, and propagates `primary_criterion` through stage configuration.",
.megaplan/plans/pipeline-week1-cleanup/finalize.json:149:      "executor_notes": "Fixed the reviewer blocker. `_run_pipeline()` now validates creative-only options, then builds the creative pipeline before profile resolution/preflight so unknown forms are raised by `build_pipeline()` as `CliError('invalid_args')`; CLI handling emits the structured invalid-argument payload and returns exit code 2. The repro script confirmed profile/preflight were not reached for an invalid form.",
.megaplan/plans/pipeline-week1-cleanup/gate_signals_v3.json:5:    "idea": "# Pipeline Week 1 Cleanup\n\n## Outcome\n\nMake pipeline modules describe topology, not compatibility shims or inline\nworkflow mechanics.\n\n## Scope\n\nIn scope:\n\n- Remove planning compatibility shims entirely.\n- Keep `compile_planning_pipeline()` as the only planning compiler.\n- Split doc and creative pipeline step shells into dedicated modules.\n- Make the creative pipeline table-driven.\n- Remove duplicate judges artifact path plumbing.\n- Update focused tests and docs that referenced removed shim APIs.\n\nOut of scope:\n\n- Unrelated execution, review, worker, profile, and ticket changes already\n  present in the worktree.\n- Broad desloppify queue work.\n- Public backward-compat wrappers for the removed planning APIs.\n\n## Locked Decisions\n\n- No shims.\n- No compatibility wrappers.\n- No legacy overlay path.\n- First-class `doc` and `creative` pipelines are the mode path.\n- Pipeline `__init__.py` files should primarily expose metadata and\n  `build_pipeline()`.\n\n## Done Criteria\n\n- Targeted pipeline tests pass.\n- `rg` finds no in-tree imports of `compile_pipeline_for`, `mode_overlay`,\n  `robustness_overlay`, `with_prep_overlay`, `with_feedback_overlay`,\n  `_step_for`, or `_RuntimeStep`, except historical docs that are explicitly\n  updated or clearly archived.\n- Unrelated dirty files are left untouched.",
.megaplan/plans/pipeline-week1-cleanup/gate_signals_v3.json:17:        "concern": "Does the change touch all locations AND supporting infrastructure?: Existing creative pipeline tests are a concrete location the plan needs to update: `tests/pipelines/test_creative_pipeline.py` currently asserts that `build_pipeline(form='poem')` produces `prep:poem`, `execute_creative:poem`, `critique_creative:poem`, and `revise_creative:poem`. The revised plan says non-joke forms should use generic prompt keys, but it does not name this stale test as an update target, so an implementer following only the listed test additions could leave contradictory assertions in place until validation fails.",
.megaplan/plans/pipeline-week1-cleanup/gate_signals_v3.json:83:        "concern": "Did the work fully address the issue hints, user notes, and approved plan requirements?: Creative run path: the plan says to preserve form validation, form-specific prompt keys like `execute_creative:joke`, and primary criterion propagation, but `megaplan/_pipeline/run_cli.py` has no `--form` or `--primary-criterion` options and calls `get_pipeline(pipeline_name)`, whose registry builder invokes `build_pipeline()` with no keyword arguments. That means `megaplan run creative --form poem` cannot work through the first-class pipeline path without additional CLI and registry-builder plumbing, despite tests and docs describing that surface.",
.megaplan/plans/pipeline-week1-cleanup/gate_signals_v3.json:93:        "concern": "Are the proposed changes technically correct?: Invalid creative form handling needs a stricter CLI-order requirement: in the current `run_cli` flow, profile preflight runs before `_build_pipeline_for_run(args)`, so `megaplan run creative --form not-a-real-form` can fail with missing credentials instead of surfacing the intended `CliError('invalid_args')`; when preflight is patched out, the `CliError` is raised outside the CLI's error-handling block.",
.megaplan/plans/pipeline-week1-cleanup/gate_signals_v3.json:98:        "concern": "Find the callers of the changed function. What arguments do they actually pass? Does the fix handle all of them?: The registry caller contract is nullary: `PipelineBuilder = Callable[[], Pipeline]`, `PipelineRegistry.get()` calls `self.builders[name]()`, and discovered pipeline builders are stored directly. This handles `build_pipeline()` defaults but cannot pass `form='poem'` or `primary_criterion='...'` to `megaplan.pipelines.creative.build_pipeline`, so only the default joke form is reachable through `get_pipeline('creative')` today.",
.megaplan/plans/pipeline-week1-cleanup/gate_signals_v3.json:114:        "resolution": "`_run_pipeline()` calls `preflight_or_raise()` before `_build_pipeline_for_run(args)`. A direct `cli_run` with invalid creative form returned credential preflight code 7 in this environment; with preflight patched, `CliError invalid_args` propagated from `_build_pipeline_for_run()`."
.megaplan/plans/pipeline-week1-cleanup/gate_signals_v3.json:118:        "concern": "Creative option scope: set creative-only options are silently accepted for non-creative pipelines because the parser adds them globally and `_build_pipeline_for_run()` ignores them unless `pipeline_name == 'creative'`.",
.megaplan/plans/pipeline-week1-cleanup/gate_signals_v3.json:212:        "criterion": "Doc and creative pipeline `__init__.py` files primarily expose metadata and `build_pipeline()`, with step shell mechanics in dedicated `steps.py` modules.",
.megaplan/plans/pipeline-week1-cleanup/gate_signals_v3.json:291:      "concern": "Does the change touch all locations AND supporting infrastructure?: Existing creative pipeline tests are a concrete location the plan needs to update: `tests/pipelines/test_creative_pipeline.py` currently asserts that `build_pipeline(form='poem')` produces `prep:poem`, `execute_creative:poem`, `critique_creative:poem`, and `revise_creative:poem`. The revised plan says non-joke forms should use generic prompt keys, but it does not name this stale test as an update target, so an implementer following only the listed test additions could leave contradictory assertions in place until validation fails.",
.megaplan/plans/pipeline-week1-cleanup/gate_signals_v3.json:294:      "evidence": "Existing creative pipeline tests are a concrete location the plan needs to update: `tests/pipelines/test_creative_pipeline.py` currently asserts that `build_pipeline(form='poem')` produces `prep:poem`, `execute_creative:poem`, `critique_creative:poem`, and `revise_creative:poem`. The revised plan says non-joke forms should use generic prompt keys, but it does not name this stale test as an update target, so an implementer following only the listed test additions could leave contradictory assertions in place until validation fails.",
.megaplan/plans/pipeline-week1-cleanup/plan_v3.meta.json:35:      "reason": "Added tests at the actual `cli_run()` and `PromptRegistry` caller surfaces, not only `_build_pipeline_for_run()`."
.megaplan/plans/pipeline-week1-cleanup/plan_v3.meta.json:114:      "criterion": "Doc and creative pipeline `__init__.py` files primarily expose metadata and `build_pipeline()`, with step shell mechanics in dedicated `steps.py` modules.",
.megaplan/plans/pipeline-week1-cleanup/plan_v2.md:30:1. Keep `megaplan/pipelines/doc/__init__.py` primarily to metadata plus `build_pipeline()`.
.megaplan/plans/pipeline-week1-cleanup/plan_v2.md:37:1. Keep `megaplan/pipelines/creative/__init__.py` to metadata, validation, a stage-spec table, and `build_pipeline()`.
.megaplan/plans/pipeline-week1-cleanup/plan_v2.md:45:2. Keep the scope narrow: only the creative first-class pipeline needs parameterized construction for this cleanup. Prefer a small helper in `run_cli` that calls `megaplan.pipelines.creative.build_pipeline(form=args.form, primary_criterion=args.primary_criterion)` when `pipeline_name == 'creative'`; keep `get_pipeline(name)` nullary for ordinary registry use unless existing tests make a registry-level hook cleaner.

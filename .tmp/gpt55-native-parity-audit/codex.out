   613	@pipeline(name="megaplan-planning-native")
   614	async def planning_native(ctx: MegaplanContext) -> MegaplanResult:
   615	    prep_payload = await prep(ctx)
   616	    if prep_clarification_gate(prep_payload) == "needs_human":
   617	        clarification = await collect_prep_clarification(prep_payload)
   618	        prep_payload = prep_payload.with_clarification(clarification)
   619	
   620	    plan_payload = await plan(ctx, prep_payload)
   621	
   622	    critique_loop = LoopState(max_iterations=ctx.max_critique_iterations)
   623	    while True:
   624	        critique_payload = await critique(ctx, plan_payload)
   625	        gate_action, gate_payload = await gate(ctx, plan_payload, critique_payload, critique_loop)
   626	
   627	        if gate_action in {"proceed", "force_proceed"}:
   628	            break
   629	
   630	        if gate_action == "iterate":
   631	            if not critique_loop.can_continue:
   632	                action = await override_control("critique loop exhausted", gate_payload)
   633	                if action.kind == "force-proceed":
   634	                    break
   635	                if action.kind == "abort":
   636	                    return MegaplanResult.aborted(action.reason)
   637	            plan_payload = await revise(ctx, plan_payload, gate_payload)
   638	            critique_loop = critique_loop.next_round(gate_payload)
   639	            continue
   640	
   641	        if gate_action == "tiebreaker":
   642	            tb = await tiebreaker(ctx, gate_payload)
   643	            if tb.action == "pick":
   644	                plan_payload = await revise(ctx, plan_payload, gate_payload.with_tiebreaker(tb))
   645	                critique_loop = critique_loop.next_round(gate_payload)
   646	                continue
   647	            if tb.action == "replan":
   648	                plan_payload = await plan(ctx, prep_payload)
   649	                critique_loop = LoopState(max_iterations=ctx.max_critique_iterations)
   650	                continue
   651	            if tb.action == "escalate":
   652	                action = await override_control("tiebreaker escalated", tb)
   653	                if action.kind == "abort":
   654	                    return MegaplanResult.aborted(action.reason)
   655	                if action.kind == "force-proceed":
   656	                    break
   657	
   658	        if gate_action in {"escalate", "blocked_preflight", "blocked"}:
   659	            action = await override_control(f"gate {gate_action}", gate_payload)
   660	            if action.kind == "abort":
   661	                return MegaplanResult.aborted(action.reason)
   662	            if action.kind == "replan":
   663	                plan_payload = await plan(ctx, prep_payload)
   664	                critique_loop = LoopState(max_iterations=ctx.max_critique_iterations)
   665	                continue
   666	            if action.kind == "force-proceed":
   667	                break
   668	
   669	        if gate_action == "abort":
   670	            return MegaplanResult.aborted("gate aborted")
   671	
   672	    try:
   673	        finalize_payload = await finalize(ctx, plan_payload, gate_payload)
   674	    except FinalizeBaselineSelectionError as error:
   675	        fallback_gate = await recover_finalize_baseline_failure(error)
   676	        plan_payload = await revise(ctx, plan_payload, fallback_gate)
   677	        finalize_payload = await finalize(ctx, plan_payload, fallback_gate)
   678	
   679	    rework_loop = LoopState(max_iterations=ctx.max_review_rework_cycles)
   680	    while True:
   681	        execute_payload = await execute(ctx, finalize_payload)
   682	        if execute_payload.blocked:
   683	            action = await override_control("execution blocked", execute_payload)
   684	            if action.kind == "recover-blocked":
   685	                continue
   686	            if action.kind == "force-proceed":
   687	                break
   688	            return MegaplanResult.blocked(execute_payload)
   689	
   690	        if ctx.robustness in {"bare", "light"} and not execute_payload.requires_human_verify:
   691	            return MegaplanResult.done(execute_payload)
   692	
   693	        review_action, review_payload = await review(ctx, execute_payload, rework_loop)
   694	
   695	        if review_action == "approved":
   696	            return MegaplanResult.done(review_payload)
   697	
   698	        if review_action == "human_verify":
   699	            await verify_human_criteria(review_payload)
   700	            return MegaplanResult.done(review_payload)
   701	
   702	        if review_action == "retry_review":
   703	            continue
   704	
   705	        if review_action == "needs_rework":
   706	            finalize_payload = finalize_payload.scope_to_rework(review_payload.rework_items)
   707	            rework_loop = rework_loop.next_round(review_payload)
   708	            continue
   709	
   710	        if review_action == "blocked":
   711	            action = await override_control("review blocked", review_payload)
   712	            if action.kind == "force-proceed":
   713	                return MegaplanResult.done(review_payload.force_proceeded())
   714	            if action.kind == "replan":
   715	                plan_payload = await revise(ctx, plan_payload, gate_payload)
   716	                finalize_payload = await finalize(ctx, plan_payload, gate_payload)
   717	                rework_loop = LoopState(max_iterations=ctx.max_review_rework_cycles)
   718	                continue
   719	            return MegaplanResult.blocked(review_payload)
   720	```
   721	
   722	Important properties of this imagined file:
   723	
   724	- There is no route table separate from the product flow.
   725	- The critique loop and review rework loop are visible as loops.
   726	- Human gates are suspension calls with reentry ids.
   727	- Tiebreaker is a subworkflow, not two arbitrary handler names.
   728	- Execute is a dynamic DAG-batch iterator over runtime tasks.
   729	- Gate retry, critique evaluator retry, and review infrastructure retry are policies at the call site.
   730	- Model routing is attached to phases rather than hidden in handler/profile code.
   731	- Edge effects such as debt recording and checkpoints are explicit effects.
   732	
   733	## 6. Required top-level constructs
   734	
   735	| Construct | Why Megaplan needs it | Exists today? | Evidence |
   736	| --- | --- | --- | --- |
   737	| Sequential durable phases | All major steps need checkpointed phase calls. | Yes. | `@phase` in `arnold/pipeline/native/decorators.py:16`; runtime in `arnold/pipeline/native/runtime.py:198`. |
   738	| Native pipeline functions | Top-level product flow should be a Python function. | Yes, partially. | `@pipeline` in `arnold/pipeline/native/decorators.py:59`; `compile_pipeline()` in `arnold/pipeline/native/compiler.py:53`. |
   739	| Decisions / branches | Gate, review, prep, tiebreaker, override. | Yes. | `@decision` in `arnold/pipeline/native/decorators.py:93`; branch pattern in `arnold/patterns/control.py:33`. |
   740	| Human suspension | Prep clarification, tiebreaker decide, review human verification, override. | Yes. | Human gate metadata in `@decision` (`arnold/pipeline/native/decorators.py:93`); generic `human_gate()` in `arnold/patterns/control.py:230`; `SuspensionRoute` in `arnold/manifest/manifests.py:216`. |
   741	| Bounded loops | Critique/gate/revise and review/rework need caps. | Yes, but awkward. | `LoopPolicy` in `arnold/manifest/manifests.py:87`; loop pattern in `arnold/patterns/control.py:70`; current `revise` loop in `planning.py:191`. |
   742	| While-until predicates | Loop should stop on gate pass, cap, no progress, or severity branch. | Partial. | `LoopPolicy.until_ref` exists (`arnold/manifest/manifests.py:91`), but source compiler only accepts `while True` with literal policy (`arnold/workflow/source_compiler.py:1451`). |
   743	| Break / continue or typed loop outcomes | Native Megaplan wants ordinary loop control. | Missing in compiler subsets. | Source compiler rejects break/continue (`arnold/workflow/source_compiler.py:1525`); native compiler also rejects them (`arnold/pipeline/native/compiler.py:659`). |
   744	| Static parallel fanout | Fixed review panels and fixed critique panels. | Yes. | `parallel()` in `arnold/pipeline/native/decorators.py:177`; `fanout()`/`panel()` in `arnold/patterns/control.py:105`. |
   745	| Dynamic parallel map over runtime lists | Critique selected lenses, finalize task batches, review checks. | Missing at source level. | Dynamic fanout exists as imperative runtime machinery, but native `parallel()` requires literal branches (`arnold/pipeline/native/decorators.py:177`). |
   746	| Fan-in / reducer | Merge critique, tiebreaker, review, execution results. | Yes. | Reducer support on `parallel()` (`arnold/pipeline/native/decorators.py:180`); `FanoutPolicy.reducer_ref` (`arnold/manifest/manifests.py:96`). |
   747	| Subworkflow invocation | Critique, gate, tiebreaker, execute, review should be nested workflows. | Yes, manifest-level. | `subpipeline()` in `arnold/patterns/base.py:112`; `SubpipelineRef` in `arnold/manifest/manifests.py:208`. |
   748	| Retry policy at call site | Critique evaluator, gate reprompt, review infrastructure, external failures. | Partial. | `RetryPolicy` in `arnold/manifest/manifests.py:78`; `retry()` pattern in `arnold/patterns/control.py:185`; no source-level phase-call retry keyword. |
   749	| Timeout/deadline policy | Phase timeouts, stale/dead process detection, auto-drive phase timeout. | Partial. | `TimingPolicy` in `arnold/manifest/manifests.py:154`; phase runtime policy exists in `_core/phase_runtime.py`; not ergonomic at native call site. |
   750	| Event-driven transitions | Override, resume, cancel, pause, recovery, auto-drive liveness events. | Partial. | `ControlTransitionSlot` in `arnold/manifest/manifests.py:173`; planning graph uses slots at `planning.py:141`; source-level event syntax remains limited. |
   751	| Topology overlays | Runtime route mutations or control overlays. | Exists as metadata slot. | `TopologyOverlaySlot` in `arnold/manifest/manifests.py:185`; `_node_policy()` accepts overlays in `planning.py:21`. |
   752	| Model routing | Tiered model choice by phase, task complexity, robustness, vendor overrides. | Missing from workflow manifest. | Agent-level routing exists elsewhere, but no first-class workflow policy slot was found. |
   753	| Edge effects / compensation | Gate debt recording, checkpoints, failure events, state recovery. | Partial. | Effect/compensation policy slots exist in `arnold/manifest/manifests.py:113`, but current Megaplan side effects remain handler code. |
   754	| Resume cursors | Human gates and long-running loops need durable resume. | Exists. | Suspension route support and native runtime resume support; current graph uses reentry ids in `planning.py:194` and `planning.py:219`. |
   755	| Dynamic DAG scheduling | Execute tasks need dependency-aware batching over finalized runtime data. | Missing at source/topology level. | Current implementation is inside `execute/batch.py:2278`. |
   756	

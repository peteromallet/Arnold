   255	def test_canonical_authoring_components_emit_awf245_for_unique_front_half_rows() -> None:
   256	    """The canonical AUTHORING_* source must detect prep/plan/critique/gate/revise
   257	    plus the four S3 tiebreaker phases exactly once each, including critique via the
   258	    reducer call and repeated revise call sites."""
   259	    result = check_workflow_source(
   260	        planning.AUTHORING_SOURCE_PATH.read_text(encoding="utf-8"),
   261	        source_path=planning.AUTHORING_SOURCE_PATH,
   262	    )
   263	
   264	    awf245_diags = [
   265	        d for d in result.diagnostics
   266	        if d.code is DiagnosticCode.ROW_EVIDENCE_INSUFFICIENCY
   267	    ]
   268	
   269	    assert len(awf245_diags) == 9  # 5 S2 + 4 S3
   270	    assert {
   271	        diag.details["row_id"] for diag in awf245_diags
   272	    } == {
   273	        S2_PREP_ROW_ID,
   274	        S2_PLAN_ROW_ID,
   275	        S2_CRITIQUE_ROW_ID,
   276	        S2_GATE_ROW_ID,
   277	        S2_REVISE_ROW_ID,
   278	        S3_TIEBREAKER_RESEARCHER_ROW_ID,
   279	        S3_TIEBREAKER_CHALLENGER_ROW_ID,
   280	        S3_TIEBREAKER_SYNTHESIS_ROW_ID,
   281	        S3_TIEBREAKER_DECISION_ROW_ID,
   282	    }
   283	    assert any(diag.component_ref and "AUTHORING_CRITIQUE" in diag.component_ref for diag in awf245_diags)
   284	    assert any(diag.component_ref and "AUTHORING_REVISE" in diag.component_ref for diag in awf245_diags)
   285	    assert any(diag.component_ref and "TIEBREAKER_RESEARCHER" in diag.component_ref for diag in awf245_diags)
   286	    assert any(diag.component_ref and "TIEBREAKER_DECISION" in diag.component_ref for diag in awf245_diags)
   287	

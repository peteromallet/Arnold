   100	
   101	def build_compatibility_shell(pipeline: DslPipeline) -> CompatibilityPipelineShell:
   102	    """Project an authored DSL pipeline to a native-backed neutral shell."""
   103	
   104	    manifest = compile_workflow_manifest(pipeline)
   105	    native_program = _native_program_from_dsl(pipeline)
   106	    stages = _stages_from_dsl(pipeline)
   107	    return CompatibilityPipelineShell(
   108	        stages=stages,
   109	        entry=pipeline.entry,
   110	        binding_map=None,
   111	        resource_bundles=(),
   112	        native_program=native_program,
   113	        manifest=manifest,
   114	        authored_pipeline=pipeline,
   115	    )
   116	
   117	
   118	def _stages_from_dsl(pipeline: DslPipeline) -> dict[str, Stage]:
   119	    routes_by_source: dict[str, list[Any]] = {}
   120	    for route in pipeline.routes:
   121	        routes_by_source.setdefault(route.source, []).append(route)
   122	
   123	    stages: dict[str, Stage] = {}
   124	    for step in pipeline.steps:
   125	        outgoing = tuple(routes_by_source.get(step.id, ()))
   126	        default_next = outgoing[0].label if outgoing else "halt"
   127	        edges = tuple(Edge(label=route.label, target=route.target) for route in outgoing)
   128	        labels = frozenset(route.label for route in outgoing)
   129	        handler_ref = _handler_ref(step)
   130	        stages[step.id] = Stage(
   131	            name=step.id,
   132	            step=_CompatibilityStep(
   133	                name=step.id,
   134	                kind=step.kind,
   135	                handler_ref=handler_ref,
   136	                metadata=dict(step.metadata),
   137	                default_next=default_next,
   138	            ),
   139	            edges=edges,
   140	            decision_vocabulary=labels if len(labels) > 1 else frozenset(),
   141	        )
   142	    return stages
   143	
   144	
   145	def _routing_topology_from_dsl(pipeline: DslPipeline) -> dict[str, Any]:
   146	    """Build generic static routing topology records from authored DSL routes.
   147	
   148	    The returned dict uses the product-neutral structure expected by
   149	    :func:`arnold.pipeline.native.validator._validate_routing_topology`:
   150	
   151	    * ``nodes`` – a list of ``{"name": "<step.id>"}`` records for every step.
   152	    * ``routes`` – a list of ``{"source", "label", "target"[, "condition_ref"]}``
   153	      records for every authored route.
   154	
   155	    This allows the generic native validator to perform static label/target
   156	    resolution without importing any Megaplan-specific semantics.
   157	    """
   158	    nodes: list[dict[str, str]] = [{"name": step.id} for step in pipeline.steps]
   159	    routes: list[dict[str, str | None]] = []
   160	    for route in pipeline.routes:
   161	        record: dict[str, str | None] = {
   162	            "source": route.source,
   163	            "label": route.label,
   164	            "target": route.target,
   165	        }
   166	        if route.condition_ref is not None:
   167	            record["condition_ref"] = route.condition_ref
   168	        routes.append(record)
   169	
   170	    return {"nodes": nodes, "routes": routes}
   171	
   172	
   173	def _native_program_from_dsl(pipeline: DslPipeline) -> NativeProgram:
   174	    routes_by_source: dict[str, list[Any]] = {}
   175	    for route in pipeline.routes:
   176	        routes_by_source.setdefault(route.source, []).append(route)
   177	    step_pc = {step.id: index for index, step in enumerate(pipeline.steps)}
   178	
   179	    phases: list[NativePhase] = []
   180	    instructions: list[NativeInstruction] = []
   181	    for pc, step in enumerate(pipeline.steps):
   182	        func = _native_phase_func(step)
   183	        phase = NativePhase(name=step.id, func=func)
   184	        phases.append(phase)
   185	        outgoing = routes_by_source.get(step.id, [])
   186	        next_pc = _default_next_pc(outgoing, step_pc)
   187	        instructions.append(
   188	            NativeInstruction(
   189	                pc=pc,
   190	                op="phase",
   191	                name=step.id,
   192	                func=func,
   193	                next_pc=next_pc,
   194	            )
   195	        )
   196	
   197	    program = NativeProgram(
   198	        name=pipeline.id,
   199	        instructions=tuple(instructions),
   200	        phases=tuple(phases),
   201	        routing_topology=_routing_topology_from_dsl(pipeline),
   202	        description=(
   203	            "Substrate proof only: compatibility projection from authored "
   204	            "Megaplan workflow DSL to neutral native shell."
   205	        ),
   206	    )
   207	    return attach_composition_graph(program)
   208	
   209	
   210	def _native_phase_func(step: DslStep) -> Any:
   211	    handler_ref = _handler_ref(step)
   212	    metadata = dict(step.metadata)
   213	    default_next = "halt"
   214	    phase_name = step.id
   215	
   216	    def _run(ctx: object) -> dict[str, Any]:
   217	        if isinstance(ctx, Mapping) and ctx.get("__megaplan_auto_phase__") is True:
   218	            return _run_megaplan_native_phase(
   219	                phase_name,
   220	                ctx,
   221	                handler_ref=handler_ref,
   222	            )
   223	        return {}
   224	
   225	    _run.__name__ = f"_megaplan_{step.id}_compat_phase"
   226	    _run.__qualname__ = _run.__name__
   227	    _run.__native_phase_name__ = step.id
   228	    _run.__handler_ref__ = handler_ref
   229	    _run.__dsl_step_kind__ = step.kind
   230	    _run.__dsl_step_metadata__ = metadata
   231	    _run.__default_next__ = default_next
   232	    return _run
   233	
   234	
   235	def _run_megaplan_native_phase(
   236	    phase_name: str,
   237	    ctx: Mapping[str, Any],
   238	    *,
   239	    handler_ref: str | None,
   240	) -> dict[str, Any]:
   241	    """Execute one canonical Megaplan phase through the native phase function."""
   242	
   243	    del handler_ref
   244	    root = _ctx_path(ctx.get("cwd")) or Path.cwd()
   245	    plan = ctx.get("plan")
   246	    if not isinstance(plan, str) or not plan:
   247	        return {"exit_code": 1, "stdout": "", "stderr": "missing --plan"}
   248	    argv = ctx.get("argv")
   249	    args = _namespace_from_argv(
   250	        phase_name,
   251	        plan=plan,
   252	        argv=argv if isinstance(argv, list) else [],
   253	    )
   254	    try:
   255	        from arnold_pipelines.megaplan.cli import COMMAND_HANDLERS
   256	        from arnold_pipelines.megaplan._core.io import json_dump
   257	        from arnold_pipelines.megaplan.types import CliError
   258	
   259	        handler = COMMAND_HANDLERS.get(phase_name)
   260	        if handler is None:
   261	            return {
   262	                "exit_code": 1,
   263	                "stdout": "",
   264	                "stderr": f"native phase {phase_name!r} is unsupported",
   265	            }
   266	        response = handler(root, args)
   267	        return {"exit_code": 0, "stdout": json_dump(response), "stderr": ""}
   268	    except CliError as error:
   269	        payload: dict[str, Any] = {
   270	            "success": False,
   271	            "error": error.code,
   272	            "message": error.message,
   273	        }
   274	        if error.extra:
   275	            payload["details"] = dict(error.extra)
   276	        import json
   277	
   278	        return {
   279	            "exit_code": error.exit_code,
   280	            "stdout": "",
   281	            "stderr": json.dumps(payload),
   282	        }
   283	    except Exception as error:  # noqa: BLE001 - preserve CLI-shaped failure surface.
   284	        return {
   285	            "exit_code": 1,
   286	            "stdout": "",
   287	            "stderr": f"{type(error).__name__}: {error}",
   288	        }
   289	
   290	
   291	def _ctx_path(value: Any) -> Path | None:
   292	    if isinstance(value, Path):
   293	        return value
   294	    if isinstance(value, str) and value:
   295	        return Path(value)
   296	    return None
   297	
   298	
   299	def _namespace_from_argv(
   300	    phase_name: str,
   301	    *,
   302	    plan: str,
   303	    argv: list[Any],
   304	) -> argparse.Namespace:
   305	    args = argparse.Namespace(
   306	        plan=plan,
   307	        fresh=False,
   308	        persist=False,
   309	        ephemeral=False,
   310	        confirm_destructive=False,
   311	        user_approved=False,
   312	        retry_blocked_tasks=False,
   313	        confirm_self_review=False,
   314	        batch=None,
   315	        agent=None,
   316	        hermes=None,
   317	        phase_model=[],
   318	        tier_models=None,
   319	        max_execute_tier=None,
   320	        profile=None,
   321	        vendor=None,
   322	        deepseek_provider=None,
   323	        critic=None,
   324	        progress_emitter=None,
   325	        prep_direction=None,
   326	    )
   327	    index = 1 if argv and str(argv[0]) == phase_name else 0
   328	    while index < len(argv):
   329	        token = str(argv[index])
   330	        if token == "--plan" and index + 1 < len(argv):
   331	            args.plan = str(argv[index + 1])
   332	            index += 2
   333	            continue
   334	        if token == "--fresh":
   335	            args.fresh = True
   336	        elif token == "--persist":
   337	            args.persist = True
   338	        elif token == "--ephemeral":
   339	            args.ephemeral = True
   340	        elif token == "--confirm-destructive":
   341	            args.confirm_destructive = True
   342	        elif token == "--user-approved":
   343	            args.user_approved = True
   344	        elif token == "--retry-blocked-tasks":
   345	            args.retry_blocked_tasks = True
   346	        elif token == "--confirm-self-review":
   347	            args.confirm_self_review = True
   348	        elif token == "--batch" and index + 1 < len(argv):
   349	            try:
   350	                args.batch = int(str(argv[index + 1]))
   351	            except ValueError:
   352	                args.batch = None
   353	            index += 1
   354	        elif token == "--agent" and index + 1 < len(argv):
   355	            args.agent = str(argv[index + 1])
   356	            index += 1
   357	        elif token == "--hermes" and index + 1 < len(argv):
   358	            args.hermes = str(argv[index + 1])
   359	            index += 1
   360	        elif token == "--phase-model" and index + 1 < len(argv):


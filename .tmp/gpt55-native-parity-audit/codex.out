   388	# ── S3 tiebreaker shape violation tests ──────────────────────────────────────
   389	
   390	_TIEBREAKER_SOURCE_TEMPLATE = """\
   391	from __future__ import annotations
   392	
   393	from arnold.workflow.authoring import workflow
   394	from arnold_pipelines.megaplan.workflows.components import (
   395	    TIEBREAKER_RESEARCHER,
   396	    TIEBREAKER_CHALLENGER,
   397	    TIEBREAKER_SYNTHESIS,
   398	    TIEBREAKER_DECISION,
   399	)
   400	
   401	@workflow(id="test", version="s3")
   402	def test_flow(brief: str) -> None:
   403	    research_findings = TIEBREAKER_RESEARCHER(
   404	        id="tiebreaker_researcher",
   405	        gate_payload=brief,
   406	    )
   407	    challenge_findings = TIEBREAKER_CHALLENGER(
   408	        id="tiebreaker_challenger",
   409	        research_findings=research_findings,
   410	    )
   411	    tiebreaker_payload = TIEBREAKER_SYNTHESIS(
   412	        id="tiebreaker_synthesis",
   413	        research_findings=research_findings,
   414	        challenge_findings=challenge_findings,
   415	    )
   416	    decision = TIEBREAKER_DECISION(
   417	        id="tiebreaker_decision",
   418	        tiebreaker_payload=tiebreaker_payload,
   419	    )
   420	"""
   421	
   422	
   423	def test_full_tiebreaker_shape_passes_without_awf252() -> None:
   424	    """A source with all four tiebreaker phases visible must not emit AWF252."""
   425	    result = check_workflow_source(
   426	        _TIEBREAKER_SOURCE_TEMPLATE, source_path="test_full_tb.pypeline",
   427	    )
   428	
   429	    awf252_diags = [
   430	        d for d in result.diagnostics
   431	        if d.code is DiagnosticCode.TIEBREAKER_SHAPE_VIOLATION
   432	    ]
   433	    assert len(awf252_diags) == 0, (
   434	        f"expected 0 AWF252 diagnostics, got {len(awf252_diags)}"
   435	    )
   436	
   437	
   438	def test_partial_tiebreaker_shape_produces_awf252() -> None:
   439	    """A source with only some tiebreaker phases must emit AWF252 for each
   440	    missing phase."""
   441	    source = """\
   442	from __future__ import annotations
   443	
   444	from arnold.workflow.authoring import workflow
   445	from arnold_pipelines.megaplan.workflows.components import (
   446	    TIEBREAKER_RESEARCHER,
   447	    TIEBREAKER_DECISION,
   448	)
   449	
   450	@workflow(id="test", version="s3")
   451	def test_flow(brief: str) -> None:
   452	    research_findings = TIEBREAKER_RESEARCHER(
   453	        id="tiebreaker_researcher",
   454	        gate_payload=brief,
   455	    )
   456	    decision = TIEBREAKER_DECISION(
   457	        id="tiebreaker_decision",
   458	        tiebreaker_payload=research_findings,
   459	    )
   460	"""
   461	    result = check_workflow_source(source, source_path="test_partial_tb.pypeline")
   462	
   463	    awf252_diags = [
   464	        d for d in result.diagnostics
   465	        if d.code is DiagnosticCode.TIEBREAKER_SHAPE_VIOLATION
   466	    ]
   467	    assert len(awf252_diags) == 2, (
   468	        f"expected 2 AWF252 diagnostics (missing challenger + synthesis), "
   469	        f"got {len(awf252_diags)}"
   470	    )
   471	    missing_phases = {d.details.get("missing_phase") for d in awf252_diags}
   472	    assert missing_phases == {"tiebreaker_challenger", "tiebreaker_synthesis"}, (
   473	        f"unexpected missing phases: {missing_phases}"
   474	    )

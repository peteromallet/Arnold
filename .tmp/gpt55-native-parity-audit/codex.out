   642	
   643	def _canonical_steps(
   644	    *,
   645	    timeout_seconds: float | None,
   646	    lowered_steps: Sequence[Step] = (),
   647	) -> tuple[Step, ...]:
   648	    lowered_by_id = _canonical_lowered_steps(lowered_steps)
   649	    steps = []
   650	    for component in PIPELINE_STEP_COMPONENTS:
   651	        step_id = component.id.removeprefix("megaplan:")
   652	        if step_id not in lowered_by_id:
   653	            continue
   654	        canonical = Step(
   655	            id=step_id,
   656	            kind=component.step_type,
   657	            inputs=_component_io(component.metadata.get("inputs", ()), Input),
   658	            outputs=_component_io(component.metadata.get("outputs", ()), Output),
   659	            policy=_policy_for_step(step_id, timeout_seconds=timeout_seconds),
   660	            metadata=_metadata_for_step(step_id),
   661	        )
   662	        lowered = lowered_by_id.get(step_id)
   663	        if lowered is not None:
   664	            canonical = replace(
   665	                canonical,
   666	                inputs=lowered.inputs or canonical.inputs,
   667	                outputs=lowered.outputs or canonical.outputs,
   668	                source_span=lowered.source_span,
   669	                metadata={**lowered.metadata, **canonical.metadata},
   670	            )
   671	        steps.append(canonical)
   672	    return tuple(steps)
   673	
   674	def _canonical_routes(*, lowered_routes: Sequence[Route] = ()) -> tuple[Route, ...]:
   675	    supported_labels = _supported_pipeline_route_labels_by_source()
   676	    return tuple(
   677	        route
   678	        for route in _canonical_lowered_routes(lowered_routes)
   679	        if route.source not in supported_labels
   680	        or route.label in supported_labels[route.source]
   681	    )
   682	
   683	
   684	def _canonical_capabilities() -> tuple[Capability, ...]:
   685	    return tuple(
   686	        Capability(
   687	            id=capability_id,
   688	            route=config["route"],
   689	            required=config["required"],
   690	        )
   691	        for capability_id, config in CAPABILITY_REQUIREMENTS.items()
   692	    )

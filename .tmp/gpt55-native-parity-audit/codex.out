   550	    SOURCE_EXECUTE(id="run", brief=brief)
   551	"""
   552	
   553	
   554	def test_execute_row_evidence_preserved_in_result() -> None:
   555	    """SemanticEvidence with S4_EXECUTE_ROW_ID and ConstructType.EXECUTE must
   556	    be preserved in the checker result carrier without modification."""
   557	    evidence = (
   558	        SemanticEvidence(
   559	            diagnostic_code=DiagnosticCode.ROW_EVIDENCE_INSUFFICIENCY,
   560	            source_span=SourceSpan("test.pypeline", 10, 1, 10, 20),
   561	            construct_type=ConstructType.EXECUTE,
   562	            row_id=S4_EXECUTE_ROW_ID,
   563	        ),
   564	    )
   565	    result = check_workflow_source(
   566	        _EXECUTE_SOURCE_TEMPLATE,
   567	        source_path="test.pypeline",
   568	        evidence=evidence,
   569	    )
   570	    assert result.evidence == evidence
   571	    assert len(result.evidence) == 1
   572	    assert result.evidence[0].row_id == S4_EXECUTE_ROW_ID
   573	    assert result.evidence[0].construct_type == ConstructType.EXECUTE
   574	

   695	def build_pipeline(
   696	    *,
   697	    timeout_seconds: float | None = 300.0,
   698	    max_critique_iterations: int = 4,
   699	) -> Pipeline:
   700	    """Return the canonical Megaplan planning workflow as a DSL pipeline."""
   701	
   702	    lowered = _lowered_workflow()
   703	    return Pipeline(
   704	        id=lowered.id,
   705	        version=lowered.version,
   706	        steps=_canonical_steps(timeout_seconds=timeout_seconds, lowered_steps=lowered.steps),
   707	        routes=_canonical_routes(lowered_routes=lowered.routes),
   708	        capabilities=_canonical_capabilities(),
   709	        policy=_manifest_policy(timeout_seconds=timeout_seconds),
   710	        metadata={
   711	            "product": "megaplan",
   712	            "max_critique_iterations": max_critique_iterations,
   713	            "policy_refs": (
   714	                DEFAULT_POLICY.id,
   715	                MODEL_ROUTING_POLICY.id,
   716	                ROBUSTNESS_POLICY.id,
   717	                ARTIFACT_CONTRACT_POLICY.id,
   718	                SUSPENSION_POLICY.id,
   719	            ),
   720	        },
   721	    )

     1	"""Focused tests for the S2 row-evidence checker rule (T2).
     2	
     3	These tests verify that ``check_workflow_source`` emits
     4	``AWF245_ROW_EVIDENCE_INSUFFICIENCY`` whenever an implemented front-half
     5	row (prep / plan / critique / gate / revise) lacks structured semantic
     6	evidence, and that the API / serialization contracts hold.
     7	"""
     8	
     9	from __future__ import annotations
    10	
    11	import json
    12	from pathlib import Path
    13	
    14	import arnold.workflow as workflow
    15	from arnold.manifest.refs import SourceSpan
    16	from arnold.workflow.boundary_evidence import AuthorityRecord, BoundaryOutcome, BoundaryReceipt
    17	from arnold.workflow import check_workflow_source
    18	from arnold.workflow.diagnostics import DiagnosticCode
    19	from arnold.workflow.semantic_evidence import (
    20	    ConstructType,
    21	    S2_CRITIQUE_ROW_ID,
    22	    S2_GATE_ROW_ID,
    23	    S2_PLAN_ROW_ID,
    24	    S2_PREP_ROW_ID,
    25	    S2_REVISE_ROW_ID,
    26	    S3_TIEBREAKER_RESEARCHER_ROW_ID,
    27	    S3_TIEBREAKER_CHALLENGER_ROW_ID,
    28	    S3_TIEBREAKER_SYNTHESIS_ROW_ID,
    29	    S3_TIEBREAKER_DECISION_ROW_ID,
    30	    S4_EXECUTE_ROW_ID,
    31	    SemanticEvidence,
    32	)
    33	from arnold_pipelines.megaplan.workflows import planning
    34	import arnold.workflow.source_compiler as source_compiler
    35	
    36	M3_FIXTURE_DIR = Path("tests/fixtures/workflow_authoring/m3")
    37	
    38	# ── minimal source templates ────────────────────────────────────────────────
    39	
    40	_SOURCE_TEMPLATE = """\
    41	from __future__ import annotations
    42	
    43	from arnold.workflow.authoring import workflow
    44	from arnold_pipelines.megaplan.workflows.components import (
    45	    SOURCE_PREP,
    46	    SOURCE_PLAN,
    47	    SOURCE_CRITIQUE,
    48	    SOURCE_GATE,
    49	    SOURCE_REVISE,
    50	)
    51	
    52	@workflow(id="test", version="s2")
    53	def test_flow(brief: str) -> None:
    54	    prep_signal = SOURCE_PREP(id="prep", brief=brief)
    55	    plan_payload = SOURCE_PLAN(id="plan", prep_payload=prep_signal)
    56	"""
    57	
    58	# ── helpers ─────────────────────────────────────────────────────────────────
    59	
    60	
    61	def _evidence_for(row_id: str, *, code: DiagnosticCode | None = None) -> SemanticEvidence:
    62	    return SemanticEvidence(
    63	        diagnostic_code=code or DiagnosticCode.ROW_EVIDENCE_INSUFFICIENCY,
    64	        source_span=SourceSpan("test.pypeline", 1, 1, 1, 10),
    65	        construct_type=ConstructType.PREP,
    66	        row_id=row_id,
    67	    )
    68	
    69	
    70	def _load_m3_sidecar(case_name: str) -> dict[str, object]:
    71	    with (M3_FIXTURE_DIR / f"{case_name}.expected.json").open(encoding="utf-8") as handle:
    72	        return json.load(handle)
    73	
    74	
    75	def _diagnostic_payloads(result: object) -> list[dict[str, object]]:
    76	    payloads: list[dict[str, object]] = []
    77	    for diagnostic in result.diagnostics:
    78	        payload: dict[str, object] = {
    79	            "code": diagnostic.code.value,
    80	            "message": diagnostic.message,
    81	        }
    82	        if diagnostic.import_ref is not None:
    83	            payload["import_ref"] = {
    84	                "module": diagnostic.import_ref.module,
    85	                "qualname": diagnostic.import_ref.qualname,
    86	            }
    87	        if diagnostic.component_ref is not None:
    88	            payload["component_ref"] = diagnostic.component_ref
    89	        if diagnostic.source_span is not None:
    90	            payload["source_span"] = {
    91	                "path": diagnostic.source_span.path,
    92	                "start_line": diagnostic.source_span.start_line,
    93	                "start_column": diagnostic.source_span.start_column,
    94	                "end_line": diagnostic.source_span.end_line,
    95	                "end_column": diagnostic.source_span.end_column,
    96	            }
    97	        payloads.append(payload)
    98	    return payloads
    99	
   100	
   101	def _run_s5_fixture(case_name: str):
   102	    source_path = M3_FIXTURE_DIR / f"{case_name}.py"
   103	    original_topology_contract = source_compiler._megaplan_review_topology_contract
   104	    original_route_surface = source_compiler._megaplan_policy_route_surface
   105	    try:
   106	        if case_name == "invalid_m3_handler_owned_review_cap":
   107	            source_compiler._megaplan_review_topology_contract = lambda: {
   108	                "retry_and_cap": {"cap_thresholds": {"max_review_rework_cycles": 1}},
   109	            }
   110	        elif case_name == "invalid_m3_hidden_finalize_fallback":
   111	            source_compiler._megaplan_policy_route_surface = (
   112	                lambda export_name: {}
   113	                if export_name == "FINALIZE_POLICY"
   114	                else original_route_surface(export_name)
   115	            )
   116	        return workflow.check_workflow_file(source_path)
   117	    finally:
   118	        source_compiler._megaplan_review_topology_contract = original_topology_contract
   119	        source_compiler._megaplan_policy_route_surface = original_route_surface
   120	
   121	
   122	def _receipt_for_contract(boundary_contract) -> BoundaryReceipt:
   123	    authority_records = ()
   124	    if boundary_contract.authority_required:
   125	        authority_records = (
   126	            AuthorityRecord(actor="review-policy", role="authority"),
   127	        )
   128	    return BoundaryReceipt(
   129	        boundary_id=boundary_contract.boundary_id,
   130	        workflow_id=boundary_contract.workflow_id,
   131	        row_id=boundary_contract.row_id,
   132	        artifact_refs=boundary_contract.required_artifacts,
   133	        state_observation=boundary_contract.expected_state_delta,
   134	        outcome=BoundaryOutcome.COMPLETE,
   135	        history_ref=boundary_contract.expected_history_entry,
   136	        phase_result_ref=(
   137	            f"phase/{boundary_contract.boundary_id}.json"
   138	            if boundary_contract.phase_result_required
   139	            else None
   140	        ),
   141	        authority_records=authority_records,
   142	    )
   143	
   144	
   145	# ── core checker rule tests ─────────────────────────────────────────────────
   146	
   147	
   148	def test_front_half_rows_without_evidence_produce_awf245() -> None:
   149	    """A source with implemented prep + plan steps but no evidence must
   150	    produce AWF245 for every front-half row that lacks evidence."""
   151	    result = check_workflow_source(_SOURCE_TEMPLATE, source_path="test.pypeline")
   152	
   153	    assert not result.ok
   154	    diag_codes = {d.code for d in result.diagnostics}
   155	    assert DiagnosticCode.ROW_EVIDENCE_INSUFFICIENCY in diag_codes
   156	
   157	    # Both prep and plan should trigger the diagnostic.
   158	    awf245_diags = [
   159	        d for d in result.diagnostics
   160	        if d.code is DiagnosticCode.ROW_EVIDENCE_INSUFFICIENCY
   161	    ]
   162	    assert len(awf245_diags) == 2  # prep + plan
   163	
   164	    missing_row_ids = {
   165	        S2_PREP_ROW_ID,
   166	        S2_PLAN_ROW_ID,
   167	    }
   168	    for diag in awf245_diags:
   169	        assert any(row_id in diag.message for row_id in missing_row_ids)
   170	
   171	
   172	def test_front_half_rows_with_evidence_pass() -> None:
   173	    """When every implemented front-half row has a matching evidence record
   174	    the checker must not emit AWF245."""
   175	    evidence = (
   176	        _evidence_for(S2_PREP_ROW_ID, code=DiagnosticCode.ROW_EVIDENCE_INSUFFICIENCY),
   177	        _evidence_for(S2_PLAN_ROW_ID, code=DiagnosticCode.ROW_EVIDENCE_INSUFFICIENCY),
   178	    )
   179	    result = check_workflow_source(
   180	        _SOURCE_TEMPLATE, source_path="test.pypeline", evidence=evidence,
   181	    )
   182	
   183	    # Should be OK (no parse errors in this simple source, and evidence covers
   184	    # both front-half rows).
   185	    assert result.ok
   186	    assert result.evidence == evidence
   187	
   188	
   189	def test_partial_evidence_flags_missing_rows_only() -> None:
   190	    """Evidence covering only some front-half rows must flag only the
   191	    uncovered rows."""
   192	    evidence = (_evidence_for(S2_PREP_ROW_ID),)
   193	    result = check_workflow_source(
   194	        _SOURCE_TEMPLATE, source_path="test.pypeline", evidence=evidence,
   195	    )
   196	
   197	    assert not result.ok
   198	    awf245_diags = [
   199	        d for d in result.diagnostics
   200	        if d.code is DiagnosticCode.ROW_EVIDENCE_INSUFFICIENCY
   201	    ]
   202	    assert len(awf245_diags) == 1  # only plan is missing
   203	    assert S2_PLAN_ROW_ID in awf245_diags[0].message
   204	    assert S2_PREP_ROW_ID not in awf245_diags[0].message
   205	
   206	
   207	def test_no_front_half_rows_passes_without_evidence() -> None:
   208	    """A source with no S2 front-half constructs must pass even when no
   209	    evidence is supplied (no false positives)."""
   210	    source = """\
   211	from __future__ import annotations
   212	
   213	from arnold.workflow.authoring import workflow
   214	from arnold_pipelines.megaplan.workflows.components import SOURCE_EXECUTE
   215	
   216	@workflow(id="plain", version="s2")
   217	def plain_flow(brief: str) -> None:
   218	    SOURCE_EXECUTE(id="run", brief=brief)
   219	"""
   220	    result = check_workflow_source(source, source_path="plain.pypeline")
   221	    assert result.ok
   222	

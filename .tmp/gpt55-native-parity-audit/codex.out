   371	    if not selection.active_checks:
   372	        return CritiquePayload.empty(reason="no_active_checks")
   373	
   374	    findings = await parallel.map(
   375	        selection.active_checks,
   376	        lambda check: critique_lens(ctx, check, plan_payload),
   377	        max_workers=selection.max_workers,

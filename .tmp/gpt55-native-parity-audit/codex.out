   595	    assert payloads[0]["construct_type"] == "execute"
   596	
   597	
   598	def test_execute_without_boundary_contract_does_not_produce_awf245() -> None:
   599	    """An execute-only source without evidence must NOT produce AWF245
   600	    for the execute row — execute is not a front-half row until a boundary
   601	    contract is registered for it."""
   602	    result = check_workflow_source(
   603	        _EXECUTE_SOURCE_TEMPLATE, source_path="test.pypeline",
   604	    )

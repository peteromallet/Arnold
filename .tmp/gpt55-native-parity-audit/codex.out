   623	def check_workflow_file(
   624	    source_path: str | Path,
   625	    *,
   626	    resolver: ComponentResolver | None = None,
   627	    evidence: Sequence[SemanticEvidence] | None = None,
   628	    boundary_contracts: Sequence[BoundaryContract] = (),
   629	    boundary_evidence: Sequence[BoundaryReceipt | SemanticFinding] = (),
   630	) -> CheckWorkflowSourceResult:
   631	    path = Path(source_path)
   632	    return check_workflow_source(
   633	        path.read_text(encoding="utf-8"),
   634	        source_path=path,
   635	        resolver=resolver,
   636	        evidence=evidence,
   637	        boundary_contracts=boundary_contracts,
   638	        boundary_evidence=boundary_evidence,
   639	    )
   640	
   641	
   642	def check_workflow_source(
   643	    source: str,
   644	    *,
   645	    source_path: str | Path | None = None,
   646	    resolver: ComponentResolver | None = None,
   647	    evidence: Sequence[SemanticEvidence] | None = (),
   648	    boundary_contracts: Sequence[BoundaryContract] = (),
   649	    boundary_evidence: Sequence[BoundaryReceipt | SemanticFinding] = (),
   650	) -> CheckWorkflowSourceResult:
   651	    """Validate workflow source and optionally check boundary contracts/evidence.
   652	
   653	    Parameters
   654	    ----------
   655	    source:
   656	        Workflow source text (Python-shaped AST).
   657	    source_path:
   658	        Optional path for diagnostic source spans.  When omitted diagnostics
   659	        reference ``<workflow-source>``.
   660	    resolver:
   661	        Optional component resolver.
   662	    evidence:
   663	        Optional row-level ``SemanticEvidence`` records.  The source-checking API
   664	        is strict by default and emits AWF245 for implemented front-half rows
   665	        missing matching evidence.  ``check_workflow_file`` passes ``None`` by
   666	        default to preserve legacy source-only validation for file callers.
   667	    boundary_contracts:
   668	        ``BoundaryContract`` records describing expected durable side effects
   669	        for each front-half row.  Missing contracts produce AWF246.
   670	    boundary_evidence:
   671	        ``BoundaryReceipt`` or ``SemanticFinding`` records carrying durable
   672	        side-effect observations.  Missing evidence produces AWF247; orphan
   673	        evidence (no matching source row) produces AWF248; stale/incoherent
   674	        evidence produces AWF249.
   675	
   676	    Notes
   677	    -----
   678	    Boundary contracts and evidence are **observability-only**: they report
   679	    whether durable effects exist but never own, alter, or substitute for
   680	    product route topology.  Route selection is the exclusive province of
   681	    source-level route declarations and runtime handlers.
   682	    """
   683	    parsed_source = parse_workflow_source(source, source_path=source_path, resolver=resolver)
   684	    evidence_records = tuple(evidence or ())
   685	    boundary_contract_records = tuple(boundary_contracts)
   686	    boundary_evidence_records = tuple(boundary_evidence)
   687	    row_evidence_diagnostics = (
   688	        _row_evidence_diagnostics(parsed_source, evidence_records)
   689	        if evidence is not None
   690	        else ()
   691	    )
   692	    boundary_diagnostics = _boundary_evidence_diagnostics(
   693	        parsed_source,
   694	        boundary_contract_records,
   695	        boundary_evidence_records,
   696	    )
   697	    tiebreaker_shape_diagnostics = _tiebreaker_shape_diagnostics(parsed_source)
   698	    megaplan_topology_diagnostics = _megaplan_review_finalize_diagnostics(parsed_source)
   699	    if (
   700	        row_evidence_diagnostics
   701	        or boundary_diagnostics
   702	        or tiebreaker_shape_diagnostics
   703	        or megaplan_topology_diagnostics
   704	    ):
   705	        parsed_source = replace(
   706	            parsed_source,
   707	            diagnostics=(
   708	                *parsed_source.diagnostics,
   709	                *row_evidence_diagnostics,
   710	                *boundary_diagnostics,
   711	                *tiebreaker_shape_diagnostics,
   712	                *megaplan_topology_diagnostics,
   713	            ),
   714	        )
   715	    return CheckWorkflowSourceResult(
   716	        parsed_source=parsed_source,
   717	        evidence=evidence_records,
   718	        boundary_evidence=boundary_evidence_records,
   719	    )

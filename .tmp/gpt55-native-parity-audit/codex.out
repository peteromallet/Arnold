   866	        c for c in _ALL_CONTRACTS
   867	        if c.row_id and c.row_id.startswith("s3.")
   868	    )
   869	
   870	    # Combine receipts and findings.
   871	    combined_evidence = (*_S3_BOUNDARY_RECEIPTS, *_S3_SEMANTIC_FINDINGS)
   872	
   873	    result = check_workflow_source(
   874	        _OLD_WRAPPER_SOURCE,
   875	        source_path="test_old_wrapper.pypeline",
   876	        boundary_contracts=s3_contracts,
   877	        boundary_evidence=combined_evidence,
   878	    )
   879	
   880	    assert not result.ok, (
   881	        "expected failure for old single-call wrapper even with full boundary "
   882	        "receipts + semantic findings, but result.ok is True"
   883	    )
   884	
   885	    awf252_diags = [
   886	        d for d in result.diagnostics
   887	        if d.code is DiagnosticCode.TIEBREAKER_SHAPE_VIOLATION
   888	    ]
   889	    assert len(awf252_diags) >= 1, (
   890	        "expected at least 1 AWF252 diagnostic for old single-call wrapper "
   891	        "with full boundary receipts + semantic findings, got 0"
   892	    )
   893	    assert "SOURCE_TIEBREAKER_WORKFLOW" in (awf252_diags[0].component_ref or "")
   894	
   895	    # Confirm the boundary evidence is still preserved in the result carrier.
   896	    assert result.boundary_evidence == combined_evidence, (
   897	        "boundary evidence must be preserved in result"
   898	    )
   899	
   900	


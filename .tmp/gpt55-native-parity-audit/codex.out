   327	            source_span=SourceSpan("checker_test.pypeline", 7, 1, 7, 15),
   328	            construct_type=ConstructType.REVISE,
   329	            row_id=S2_REVISE_ROW_ID,
   330	        ),
   331	    )
   332	    result = check_workflow_source(
   333	        "from arnold.workflow.authoring import workflow\n"
   334	        "@workflow(id='x', version='1')\n"
   335	        "def f(): pass\n",
   336	        source_path="checker_test.pypeline",
   337	        evidence=evidence,
   338	    )

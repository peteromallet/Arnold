   247	def _route_id_for_lowered_route(
   248	    route: Route,
   249	    *,
   250	    source: str,
   251	    target: str,
   252	    label: str | None = None,
   253	) -> str:
   254	    route_label = route.label if label is None else label
   255	    component = PIPELINE_STEP_COMPONENTS_BY_ID.get(source)
   256	    if component is not None:
   257	        bindings = declared_step_route_bindings(source) or component.metadata.get("route_bindings", ())
   258	        for binding in bindings:
   259	            if (
   260	                str(binding.get("label", "default")) == route_label
   261	                and _canonical_step_id(str(binding.get("target_ref", ""))) == target
   262	            ):
   263	                return str(binding["id"])
   264	        for binding in bindings:
   265	            if str(binding.get("label", "default")) == route_label:
   266	                return str(binding["id"])
   267	    suffix = target if route_label == "default" else route_label
   268	    return f"{source}:{suffix}"
   269	

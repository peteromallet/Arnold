   220	def _lowered_step_aliases(
   221	    lowered_steps: Sequence[Step],
   222	    *,
   223	    step_id_fn: Callable[[str], str] = _canonical_step_id,
   224	) -> dict[str, tuple[str, ...]]:
   225	    aliases: dict[str, set[str]] = {}
   226	    for lowered in lowered_steps:
   227	        canonical_step_id = step_id_fn(lowered.id)
   228	        if canonical_step_id == lowered.id:
   229	            continue
   230	        aliases.setdefault(canonical_step_id, set()).add(lowered.id)
   231	    return {
   232	        canonical_step_id: tuple(sorted(alias_ids))
   233	        for canonical_step_id, alias_ids in sorted(aliases.items())
   234	    }
   235	
   236	
   237	def _canonical_lowered_steps(lowered_steps: Sequence[Step]) -> dict[str, Step]:
   238	    canonical_steps: dict[str, Step] = {}
   239	    for lowered in lowered_steps:
   240	        step_id = _canonical_step_id(lowered.id)
   241	        if step_id not in PIPELINE_STEP_COMPONENTS_BY_ID or step_id in canonical_steps:
   242	            continue
   243	        canonical_steps[step_id] = lowered
   244	    return canonical_steps

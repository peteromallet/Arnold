   963	        and _component_ref_matches_exports(call.mapper_ref, _MEGAPLAN_EXECUTE_BATCH_EXPORTS)
   964	        and _component_ref_matches_exports(call.reducer_ref, _MEGAPLAN_EXECUTE_REDUCER_EXPORTS)
   965	    ]
   966	    review_calls = [

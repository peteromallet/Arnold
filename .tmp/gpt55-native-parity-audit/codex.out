   659	        _SOURCE_TEMPLATE, source_path="test.pypeline", evidence=evidence,
   660	    )
   661	    assert result.ok
   662	    assert len(result.evidence) == 3
   663	    row_ids = {e.row_id for e in result.evidence}
   664	    assert S4_EXECUTE_ROW_ID in row_ids
   665	    assert S2_PREP_ROW_ID in row_ids
   666	    assert S2_PLAN_ROW_ID in row_ids

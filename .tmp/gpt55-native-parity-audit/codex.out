   611	def source_span_for_node(source_path: str | Path | None, node: ast.AST) -> SourceSpan:
   612	    """Convert an AST node span to the 1-based ``SourceSpan`` contract."""
   613	
   614	    return SourceSpan(
   615	        path=_coerce_source_path(source_path),
   616	        start_line=getattr(node, "lineno", 1),
   617	        start_column=getattr(node, "col_offset", 0) + 1,
   618	        end_line=getattr(node, "end_lineno", getattr(node, "lineno", 1)),
   619	        end_column=getattr(node, "end_col_offset", getattr(node, "col_offset", 0)) + 1,
   620	    )


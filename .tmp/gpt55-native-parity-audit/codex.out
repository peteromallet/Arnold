    65	
    66	def _normalize_for_fingerprint(value: Any, *, path_aliases: dict[str, str]) -> Any:
    67	    if is_dataclass(value):
    68	        return {
    69	            field.name: _normalize_for_fingerprint(
    70	                getattr(value, field.name),
    71	                path_aliases=path_aliases,
    72	            )
    73	            for field in fields(value)
    74	        }
    75	    if isinstance(value, Enum):
    76	        return value.value
    77	    if isinstance(value, Mapping):
    78	        return {
    79	            str(key): _normalize_for_fingerprint(item, path_aliases=path_aliases)
    80	            for key, item in sorted(value.items(), key=lambda entry: str(entry[0]))
    81	        }
    82	    if isinstance(value, (tuple, list)):
    83	        return [_normalize_for_fingerprint(item, path_aliases=path_aliases) for item in value]
    84	    if isinstance(value, Path):
    85	        raw = value.as_posix()
    86	        return path_aliases.get(raw, raw)
    87	    if isinstance(value, str):
    88	        raw = value.replace("\\", "/")
    89	        return path_aliases.get(raw, raw)
    90	    return value

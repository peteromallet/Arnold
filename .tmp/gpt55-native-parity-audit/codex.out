   867	def _normalized_component_export_name(value: str) -> str:
   868	    export_name = value.rsplit(":", 1)[-1]
   869	    if export_name.startswith("SOURCE_"):
   870	        export_name = export_name.removeprefix("SOURCE_")
   871	    if export_name.startswith("AUTHORING_"):
   872	        export_name = export_name.removeprefix("AUTHORING_")
   873	    return export_name
   874	
   875	
   876	def _normalized_topology_id(value: str) -> str:
   877	    return value.replace("_", "-")
   878	
   879	
   880	def _component_ref_matches_exports(component_ref: str, exports: set[str] | frozenset[str]) -> bool:
   881	    return _normalized_component_export_name(component_ref) in {
   882	        _normalized_component_export_name(export_name) for export_name in exports
   883	    }

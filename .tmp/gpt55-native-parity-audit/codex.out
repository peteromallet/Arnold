   104	@dataclass(frozen=True)
   105	class CompatibilityQuarantineEntry:
   106	    """A single compatibility quarantine entry recording a permitted
   107	    enum-to-string serialization boundary.
   108	
   109	    North Star compatibility quarantine: raw strings may only remain at
   110	    explicit enum-to-string serialization adapters for manifests, CLI
   111	    compatibility, persisted payloads, and external schema boundaries —
   112	    never in workflow routing authority.
   113	    """
   114	
   115	    category: CompatibilityQuarantineCategory

   885	
   886	def _collect_parallel_map_calls(block: ParsedSourceBlock) -> tuple[ParsedParallelMapCall, ...]:
   887	    calls: list[ParsedParallelMapCall] = []
   888	    for statement in block.statements:
   889	        if isinstance(statement, ParsedParallelMapCall):
   890	            calls.append(statement)
   891	        elif isinstance(statement, ParsedBranchBlock):
   892	            for arm in statement.arms:
   893	                calls.extend(_collect_parallel_map_calls(arm.body))
   894	        elif isinstance(statement, ParsedLoopBlock):
   895	            calls.extend(_collect_parallel_map_calls(statement.body))
   896	    return tuple(calls)
   897	
   898	
   899	def _component_calls_for_exports(
   900	    block: ParsedSourceBlock,
   901	    exports: set[str] | frozenset[str],
   902	) -> tuple[ParsedStepCall | ParsedSubflowCall | ParsedNestedWorkflowCall, ...]:
   903	    calls: list[ParsedStepCall | ParsedSubflowCall | ParsedNestedWorkflowCall] = []
   904	    for statement in block.statements:
   905	        if isinstance(statement, (ParsedStepCall, ParsedSubflowCall, ParsedNestedWorkflowCall)):
   906	            if _component_ref_matches_exports(statement.component_ref, exports):
   907	                calls.append(statement)
   908	        elif isinstance(statement, ParsedBranchBlock):
   909	            for arm in statement.arms:
   910	                calls.extend(_component_calls_for_exports(arm.body, exports))
   911	        elif isinstance(statement, ParsedLoopBlock):
   912	            calls.extend(_component_calls_for_exports(statement.body, exports))
   913	    return tuple(calls)
   914	
   915	
   916	def _step_calls_for_exports(
   917	    block: ParsedSourceBlock,
   918	    exports: set[str] | frozenset[str],
   919	) -> tuple[ParsedStepCall, ...]:
   920	    calls: list[ParsedStepCall] = []
   921	    for statement in block.statements:
   922	        if isinstance(statement, ParsedStepCall) and _component_ref_matches_exports(
   923	            statement.component_ref,
   924	            exports,
   925	        ):
   926	            calls.append(statement)
   927	        elif isinstance(statement, ParsedBranchBlock):
   928	            for arm in statement.arms:
   929	                calls.extend(_step_calls_for_exports(arm.body, exports))
   930	        elif isinstance(statement, ParsedLoopBlock):
   931	            calls.extend(_step_calls_for_exports(statement.body, exports))
   932	    return tuple(calls)
   933	

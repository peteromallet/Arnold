    52	def _build_path_aliases(workflow_source_path: Path, workflow_module_path: Path) -> dict[str, str]:
    53	    aliases: dict[str, str] = {}
    54	    for actual_path, canonical_path in (
    55	        (workflow_source_path, CANONICAL_SOURCE_RESOURCE_PATH),
    56	        (workflow_module_path, WORKFLOW_MODULE_RESOURCE_PATH),
    57	    ):
    58	        aliases[actual_path.as_posix()] = canonical_path
    59	        try:

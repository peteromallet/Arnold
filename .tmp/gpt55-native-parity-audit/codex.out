   392	@phase(model=model_route("gate"), timeout=timeout(minutes=20))
   393	async def gate_worker(ctx: MegaplanContext, signals: GateSignals) -> GatePayload:
   394	    """Ask the gate model for proceed/iterate/tiebreaker/escalate."""
   395	
   396	
   397	@phase
   398	async def normalize_gate_payload(raw: GatePayload, signals: GateSignals) -> GatePayload:
   399	    """Recover invalid/empty gate recommendations from deterministic signals."""
   400	
   401	
   402	@phase
   403	async def validate_flag_resolution(payload: GatePayload, signals: GateSignals) -> FlagValidation:
   404	    """Return unresolved blocking flag ids and resolution quality notes."""
   405	
   406	
   407	@phase(model=model_route("gate"), timeout=timeout(minutes=20))
   408	async def reprompt_gate_worker(
   409	    ctx: MegaplanContext,
   410	    signals: GateSignals,
   411	    missing_flag_ids: list[str],
   412	) -> GatePayload:
   413	    """Second gate attempt focused on unresolved blocking flags."""
   414	
   415	
   416	@phase
   417	async def persist_gate_debt(payload: GatePayload, signals: GateSignals) -> None:
   418	    """Record accepted tradeoffs as debt on the proceed edge."""
   419	
   420	
   421	@decision(vocabulary={"proceed", "iterate", "tiebreaker", "escalate", "abort", "blocked"})
   422	def gate_decision(payload: GatePayload, signals: GateSignals, loop: LoopState) -> GateDecision:
   423	    if signals.has_agent_availability_preflight_block and payload.recommendation == "proceed":
   424	        return "blocked_preflight"
   425	    if signals.has_high_complexity_unverifiable_checks and payload.recommendation == "proceed":
   426	        return "iterate"
   427	    if loop.exceeded_max or loop.no_progress_streak_exceeded:
   428	        return "blocked" if signals.has_correctness_or_security_blockers else "force_proceed"
   429	    return payload.recommendation
   430	
   431	
   432	@subworkflow
   433	async def gate(
   434	    ctx: MegaplanContext,
   435	    plan_payload: PlanPayload,
   436	    critique_payload: CritiquePayload,
   437	    loop: LoopState,
   438	) -> tuple[GateDecision, GatePayload]:
   439	    signals = await build_gate_signals(ctx, plan_payload, critique_payload)
   440	    payload = await normalize_gate_payload(await gate_worker(ctx, signals), signals)
   441	
   442	    validation = await validate_flag_resolution(payload, signals)
   443	    if validation.blocking_unresolved_ids:
   444	        retry_payload = await reprompt_gate_worker(ctx, signals, validation.blocking_unresolved_ids)
   445	        payload = await normalize_gate_payload(payload.merge_retry(retry_payload), signals)
   446	        validation = await validate_flag_resolution(payload, signals)
   447	        if validation.blocking_unresolved_ids:
   448	            payload = payload.downgrade_to_iterate(
   449	                reason="blocking unresolved flags after gate reprompt",
   450	            )
   451	
   452	    decision = gate_decision(payload, signals, loop)
   453	    if decision in {"proceed", "force_proceed"}:
   454	        await persist_gate_debt(payload, signals)
   455	    return decision, payload

   668	
   669	# ── S3 negative tests: old single-call wrapper ───────────────────────────────
   670	# Prove that boundary receipts and semantic-health findings cannot compensate
   671	# for missing source-visible tiebreaker topology.
   672	
   673	
   674	# Old-wrapper source: uses SOURCE_TIEBREAKER_WORKFLOW as a single subworkflow
   675	# call instead of four individually authored step calls.
   676	_OLD_WRAPPER_SOURCE = """\
   677	from __future__ import annotations
   678	
   679	from arnold.workflow.authoring import workflow
   680	from arnold_pipelines.megaplan.workflows.components import (
   681	    SOURCE_TIEBREAKER_WORKFLOW,
   682	)
   683	
   684	@workflow(id="test", version="s3")
   685	def test_flow(brief: str) -> None:
   686	    decision = SOURCE_TIEBREAKER_WORKFLOW(
   687	        id="tiebreaker_child",
   688	        gate_payload=brief,
   689	    )
   690	"""
   691	
   692	
   693	def _make_boundary_receipt(boundary_id: str, row_id: str) -> "BoundaryReceipt":
   694	    """Construct a minimal valid boundary receipt for a single S3 tiebreaker phase."""
   695	    from arnold.workflow.boundary_evidence import (
   696	        BoundaryOutcome,
   697	        BoundaryReceipt,
   698	    )
   699	    return BoundaryReceipt(
   700	        boundary_id=boundary_id,
   701	        workflow_id="megaplan-review",
   702	        row_id=row_id,
   703	        invocation_id=f"inv-{boundary_id}",
   704	        artifact_refs=(f"{boundary_id}_artifact.json",),
   705	        phase_result_ref=f"phase_result_{boundary_id}",
   706	        outcome=BoundaryOutcome.COMPLETE,
   707	    )
   708	
   709	
   710	def _make_semantic_finding(
   711	    finding_id: str,
   712	    boundary_id: str,
   713	    description: str,
   714	) -> "SemanticFinding":
   715	    """Construct a minimal semantic-health finding."""
   716	    from arnold.workflow.boundary_evidence import (
   717	        FindingSeverity,
   718	        SemanticFinding,
   719	    )
   720	    return SemanticFinding(
   721	        finding_id=finding_id,
   722	        boundary_id=boundary_id,
   723	        description=description,
   724	        severity=FindingSeverity.INFO,
   725	    )
   726	
   727	
   728	# Boundary receipts for all four S3 tiebreaker phases.
   729	_S3_BOUNDARY_RECEIPTS = (
   730	    _make_boundary_receipt(
   731	        "tiebreaker_researcher_to_challenger",
   732	        S3_TIEBREAKER_RESEARCHER_ROW_ID,
   733	    ),
   734	    _make_boundary_receipt(
   735	        "tiebreaker_challenger_to_synthesis",
   736	        S3_TIEBREAKER_CHALLENGER_ROW_ID,
   737	    ),
   738	    _make_boundary_receipt(
   739	        "tiebreaker_synthesis_to_decision",
   740	        S3_TIEBREAKER_SYNTHESIS_ROW_ID,
   741	    ),
   742	    _make_boundary_receipt(
   743	        "tiebreaker_decision_to_parent",
   744	        S3_TIEBREAKER_DECISION_ROW_ID,
   745	    ),
   746	)
   747	
   748	# Semantic-health findings for all four S3 tiebreaker phases.
   749	_S3_SEMANTIC_FINDINGS = (
   750	    _make_semantic_finding(
   751	        "find-researcher",
   752	        "tiebreaker_researcher_to_challenger",
   753	        "Researcher boundary healthy: research_findings.json present and coherent",
   754	    ),
   755	    _make_semantic_finding(
   756	        "find-challenger",
   757	        "tiebreaker_challenger_to_synthesis",
   758	        "Challenger boundary healthy: challenge_findings.json present and coherent",
   759	    ),
   760	    _make_semantic_finding(
   761	        "find-synthesis",
   762	        "tiebreaker_synthesis_to_decision",
   763	        "Synthesis boundary healthy: tiebreaker_payload.json present and coherent",
   764	    ),
   765	    _make_semantic_finding(
   766	        "find-decision",
   767	        "tiebreaker_decision_to_parent",
   768	        "Decision boundary healthy: tiebreaker_decisions.json present and coherent",
   769	    ),
   770	)
   771	
   772	
   773	def test_old_wrapper_fails_even_with_boundary_receipts() -> None:
   774	    """A source using SOURCE_TIEBREAKER_WORKFLOW as a single-call wrapper must
   775	    emit AWF252 even when boundary receipts exist for all four S3 tiebreaker
   776	    phases.  Boundary evidence cannot create or substitute for source-visible
   777	    step topology."""
   778	    from arnold_pipelines.megaplan.workflows.boundary_contracts import (
   779	        BOUNDARY_CONTRACTS as _ALL_CONTRACTS,
   780	    )
   781	    # Only S3 contracts so we don't trigger unrelated boundary diagnostics.
   782	    s3_contracts = tuple(
   783	        c for c in _ALL_CONTRACTS
   784	        if c.row_id and c.row_id.startswith("s3.")
   785	    )
   786	
   787	    result = check_workflow_source(
   788	        _OLD_WRAPPER_SOURCE,
   789	        source_path="test_old_wrapper.pypeline",
   790	        boundary_contracts=s3_contracts,
   791	        boundary_evidence=_S3_BOUNDARY_RECEIPTS,
   792	    )
   793	
   794	    # Must not be OK — the old wrapper is a shape violation.
   795	    assert not result.ok, (
   796	        "expected failure for old single-call wrapper, but result.ok is True"
   797	    )
   798	
   799	    awf252_diags = [
   800	        d for d in result.diagnostics
   801	        if d.code is DiagnosticCode.TIEBREAKER_SHAPE_VIOLATION
   802	    ]
   803	    assert len(awf252_diags) >= 1, (
   804	        "expected at least 1 AWF252 diagnostic for old single-call wrapper, "
   805	        f"got {len(awf252_diags)}"
   806	    )
   807	
   808	    # The diagnostic must reference the old wrapper component.
   809	    wrapper_diag = awf252_diags[0]
   810	    assert "SOURCE_TIEBREAKER_WORKFLOW" in (wrapper_diag.component_ref or ""), (
   811	        f"expected AWF252 to reference SOURCE_TIEBREAKER_WORKFLOW, "
   812	        f"got {wrapper_diag.component_ref!r}"
   813	    )
   814	    assert "missing_phases" in wrapper_diag.details, (
   815	        "expected 'missing_phases' in AWF252 details"
   816	    )
   817	    assert len(wrapper_diag.details["missing_phases"]) == 4, (
   818	        "expected all 4 S3 phases listed as missing"
   819	    )
   820	
   821	
   822	def test_old_wrapper_fails_even_with_semantic_findings() -> None:
   823	    """A source using SOURCE_TIEBREAKER_WORKFLOW as a single-call wrapper must
   824	    emit AWF252 even when semantic-health findings claim all four S3 boundaries
   825	    are healthy.  Semantic findings cannot create or substitute for source-visible
   826	    step topology."""
   827	    from arnold_pipelines.megaplan.workflows.boundary_contracts import (
   828	        BOUNDARY_CONTRACTS as _ALL_CONTRACTS,
   829	    )
   830	    s3_contracts = tuple(
   831	        c for c in _ALL_CONTRACTS
   832	        if c.row_id and c.row_id.startswith("s3.")
   833	    )
   834	
   835	    result = check_workflow_source(
   836	        _OLD_WRAPPER_SOURCE,
   837	        source_path="test_old_wrapper.pypeline",
   838	        boundary_contracts=s3_contracts,
   839	        boundary_evidence=_S3_SEMANTIC_FINDINGS,
   840	    )
   841	
   842	    assert not result.ok, (
   843	        "expected failure for old single-call wrapper, but result.ok is True"
   844	    )
   845	
   846	    awf252_diags = [
   847	        d for d in result.diagnostics
   848	        if d.code is DiagnosticCode.TIEBREAKER_SHAPE_VIOLATION
   849	    ]

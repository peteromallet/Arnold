   721	
   722	def _row_evidence_diagnostics(
   723	    parsed_source: ParsedWorkflowSource,
   724	    evidence: Sequence[SemanticEvidence],
   725	) -> tuple[AuthoringDiagnostic, ...]:
   726	    implemented_rows = _implemented_front_half_rows(parsed_source.workflow)
   727	    if not implemented_rows:
   728	        return ()
   729	    evidenced_row_ids = {record.row_id for record in evidence if record.row_id}
   730	    diagnostics: list[AuthoringDiagnostic] = []
   731	    for row in implemented_rows:
   732	        if row.row_id in evidenced_row_ids:
   733	            continue
   734	        diagnostics.append(
   735	            _diagnostic(
   736	                DiagnosticCode.ROW_EVIDENCE_INSUFFICIENCY,
   737	                (
   738	                    f"implemented front-half row {row.row_id!r} lacks matching SemanticEvidence "
   739	                    f"for phase {row.phase!r}"
   740	                ),
   741	                source_span=row.source_span,
   742	                component_ref=row.component_ref,
   743	                details={
   744	                    "row_id": row.row_id,
   745	                    "phase": row.phase,
   746	                },
   747	            )
   748	        )
   749	    return tuple(diagnostics)
   750	
   751	
   752	# ── S3 tiebreaker row IDs ──────────────────────────────────────────────────
   753	# These are the four tiebreaker phases that must all be source-visible
   754	# when any tiebreaker is present in the workflow source.
   755	
   756	_S3_TIEBREAKER_REQUIRED_ROW_IDS: tuple[str, ...] = (
   757	    "s3.tiebreaker_researcher.1",
   758	    "s3.tiebreaker_challenger.1",
   759	    "s3.tiebreaker_synthesis.1",
   760	    "s3.tiebreaker_decision.1",
   761	)
   762	
   763	_S3_TIEBREAKER_REQUIRED_ROW_SET: frozenset[str] = frozenset(_S3_TIEBREAKER_REQUIRED_ROW_IDS)
   764	
   765	# Component ref suffix for the legacy single-call TIEBREAKER_WORKFLOW wrapper.
   766	_TIEBREAKER_WORKFLOW_COMPONENT_REF = (
   767	    "arnold_pipelines.megaplan.workflows.components:SOURCE_TIEBREAKER_WORKFLOW"
   768	)
   769	
   770	
   771	def _collect_tiebreaker_workflow_calls(
   772	    block: "ParsedSourceBlock",
   773	) -> list[str]:
   774	    """Collect component_refs where SOURCE_TIEBREAKER_WORKFLOW is called."""
   775	    calls: list[str] = []
   776	    for statement in block.statements:
   777	        if isinstance(statement, ParsedSubflowCall):
   778	            if statement.component_ref == _TIEBREAKER_WORKFLOW_COMPONENT_REF:
   779	                calls.append(statement.component_ref)
   780	        elif isinstance(statement, ParsedNestedWorkflowCall):
   781	            if statement.component_ref == _TIEBREAKER_WORKFLOW_COMPONENT_REF:
   782	                calls.append(statement.component_ref)
   783	        elif isinstance(statement, ParsedStepCall):
   784	            if statement.component_ref == _TIEBREAKER_WORKFLOW_COMPONENT_REF:
   785	                calls.append(statement.component_ref)
   786	        elif isinstance(statement, ParsedBranchBlock):
   787	            for arm in statement.arms:
   788	                calls.extend(_collect_tiebreaker_workflow_calls(arm.body))
   789	        elif isinstance(statement, ParsedLoopBlock):
   790	            calls.extend(_collect_tiebreaker_workflow_calls(statement.body))
   791	    return calls
   792	
   793	
   794	def _tiebreaker_shape_diagnostics(
   795	    parsed_source: "ParsedWorkflowSource",
   796	) -> tuple["AuthoringDiagnostic", ...]:
   797	    """Emit AWF252 when a tiebreaker is present but not all four phases are source-visible.
   798	
   799	    A valid tiebreaker must have four individually authored step calls
   800	    (researcher, challenger, synthesis, decision), each backed by structured
   801	    semantic evidence.  A single TIEBREAKER_WORKFLOW subworkflow call or
   802	    handler wrapper is not sufficient.
   803	    """
   804	    workflow = parsed_source.workflow
   805	    if workflow is None:
   806	        return ()
   807	
   808	    implemented_rows = _implemented_front_half_rows(workflow)
   809	    implemented_s3_row_ids = {
   810	        row.row_id
   811	        for row in implemented_rows
   812	        if row.row_id in _S3_TIEBREAKER_REQUIRED_ROW_SET
   813	    }
   814	
   815	    # If no S3 tiebreaker rows are present at all, check for the old
   816	    # single-call wrapper pattern.
   817	    if not implemented_s3_row_ids:
   818	        tiebreaker_wf_calls = _collect_tiebreaker_workflow_calls(workflow.source_block)
   819	        if tiebreaker_wf_calls:
   820	            return (
   821	                _diagnostic(
   822	                    DiagnosticCode.TIEBREAKER_SHAPE_VIOLATION,
   823	                    (
   824	                        "SOURCE_TIEBREAKER_WORKFLOW single-call wrapper detected "
   825	                        "without source-visible researcher/challenger/synthesis/decision "
   826	                        "phases; replace the wrapper with four individually authored "
   827	                        "step calls"
   828	                    ),
   829	                    source_span=workflow.source_span,
   830	                    component_ref=_TIEBREAKER_WORKFLOW_COMPONENT_REF,
   831	                    details={
   832	                        "missing_phases": list(_S3_TIEBREAKER_REQUIRED_ROW_IDS),
   833	                        "detected_component": _TIEBREAKER_WORKFLOW_COMPONENT_REF,
   834	                    },
   835	                ),
   836	            )
   837	        return ()
   838	
   839	    # If we have some S3 rows, all four must be present.
   840	    missing_row_ids = sorted(_S3_TIEBREAKER_REQUIRED_ROW_SET - implemented_s3_row_ids)
   841	    if not missing_row_ids:
   842	        # All four phases are present — no shape violation.
   843	        return ()
   844	
   845	    diagnostics: list[AuthoringDiagnostic] = []
   846	    for row_id in missing_row_ids:
   847	        phase = row_id.replace("s3.", "").replace(".1", "")
   848	        diagnostics.append(
   849	            _diagnostic(
   850	                DiagnosticCode.TIEBREAKER_SHAPE_VIOLATION,
   851	                (
   852	                    f"tiebreaker phase {phase!r} (row {row_id!r}) is missing from "
   853	                    f"source; all four phases (researcher, challenger, synthesis, "
   854	                    f"decision) must be source-visible with row-level evidence"
   855	                ),
   856	                source_span=workflow.source_span,
   857	                details={
   858	                    "missing_row_id": row_id,
   859	                    "missing_phase": phase,
   860	                    "implemented_s3_rows": sorted(implemented_s3_row_ids),
   861	                },
   862	            )
   863	        )
   864	    return tuple(diagnostics)

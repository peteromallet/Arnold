   388	@workflow(id="megaplan", version="m4-phase3", policy=DEFAULT_POLICY)
   389	def planning_workflow(brief: str) -> None:
   390	    prep_signal = AUTHORING_PREP(id="prep", brief=brief)
   391	    plan_payload = AUTHORING_PLAN(id="plan", prep_payload=prep_signal)
   392	
   393	    loop(policy=REVISE_LOOP_POLICY, reentry_id="critique")
   394	    while True:
   395	        critique_payload = parallel_map(
   396	            id="critique-fanout",
   397	            items="megaplan.policy.critique_lenses",
   398	            step=CRITIQUE_PANEL_WORKFLOW,
   399	            reducer=AUTHORING_CRITIQUE,
   400	            path_template="critique/{item_id}",
   401	        )
   402	        gate_route_signal = AUTHORING_GATE(id="gate", critique_payload=critique_payload)
   403	
   404	        if gate_route_signal == GateOutcome.PROCEED:
   405	            finalize_payload = AUTHORING_FINALIZE(id="finalize", gate_payload=gate_route_signal)
   406	            execute_payload = parallel_map(
   407	                id="execute-batches",
   408	                items="megaplan.execute.batches",
   409	                step=EXECUTE_BATCH_WORKFLOW,
   410	                reducer=AUTHORING_EXECUTE,
   411	                path_template="execute/{index}",
   412	            )
   413	            review_route_signal = parallel_map(
   414	                id="review-fan-in",
   415	                items=execute_payload,
   416	                step=REVIEW_PANEL_WORKFLOW,
   417	                reducer=AUTHORING_REVIEW,
   418	                path_template="review/{item_id}",
   419	            )
   420	            if review_route_signal == ReviewOutcome.PASS:
   421	                AUTHORING_HALT(id="halt", review_payload=review_route_signal)
   422	                return None
   423	            elif review_route_signal == ReviewOutcome.REWORK:
   424	                rework_execute_payload = parallel_map(
   425	                    id="review-rework-execute-batches",
   426	                    items="megaplan.execute.batches",
   427	                    step=EXECUTE_BATCH_WORKFLOW,
   428	                    reducer=AUTHORING_EXECUTE,
   429	                    path_template="execute/{index}",
   430	                )
   431	                rework_review_route_signal = parallel_map(
   432	                    id="review-rework-fan-in",
   433	                    items=rework_execute_payload,
   434	                    step=REVIEW_PANEL_WORKFLOW,
   435	                    reducer=AUTHORING_REVIEW,
   436	                    path_template="review/{item_id}",
   437	                )
   438	                if rework_review_route_signal == ReviewOutcome.PASS:
   439	                    AUTHORING_HALT(id="review_rework_halt", review_payload=rework_review_route_signal)
   440	                    return None
   441	                elif rework_review_route_signal == ReviewOutcome.REWORK:
   442	                    AUTHORING_REVISE(id="review_revise", gate_payload=rework_review_route_signal)
   443	                    return None

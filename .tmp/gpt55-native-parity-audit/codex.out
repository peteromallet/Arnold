   580	        SemanticEvidence(
   581	            diagnostic_code=DiagnosticCode.ROW_EVIDENCE_INSUFFICIENCY,
   582	            source_span=SourceSpan("test.pypeline", 5, 1, 5, 15),
   583	            construct_type=ConstructType.EXECUTE,

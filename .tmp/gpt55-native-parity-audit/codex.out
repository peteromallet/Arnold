   502	def test_awf252_diagnostic_carries_missing_phase_details() -> None:
   503	    """AWF252 diagnostics must carry missing_row_id, missing_phase, and
   504	    implemented_s3_rows in details."""
   505	    source = """\
   506	from __future__ import annotations
   507	
   508	from arnold.workflow.authoring import workflow

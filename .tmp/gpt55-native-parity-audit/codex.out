   292	def test_evidence_is_preserved_in_result() -> None:
   293	    """Evidence records passed to check_workflow_source must be preserved
   294	    in the result carrier without modification."""
   295	    evidence = (
   296	        SemanticEvidence(
   297	            diagnostic_code=DiagnosticCode.ROW_EVIDENCE_INSUFFICIENCY,
   298	            source_span=SourceSpan("src.pypeline", 10, 1, 10, 20),
   299	            construct_type=ConstructType.GATE,
   300	            row_id=S2_GATE_ROW_ID,
   301	        ),
   302	    )
   303	    result = check_workflow_source(
   304	        "from arnold.workflow.authoring import workflow\n"
   305	        "@workflow(id='x', version='1')\n"
   306	        "def f(): pass\n",
   307	        source_path="src.pypeline",
   308	        evidence=evidence,
   309	    )
   310	    assert result.evidence == evidence
   311	    assert len(result.evidence) == 1
   312	    assert result.evidence[0].row_id == S2_GATE_ROW_ID
   313	
   314	
   315	def test_evidence_to_dict_round_trip_for_checker_output() -> None:
   316	    """Evidence records attached to a checker result must round-trip
   317	    through to_dict() without losing row identity or construct type."""
   318	    evidence = (
   319	        SemanticEvidence(

   723	
   724	def lowered_workflow_topology() -> dict[str, Any]:
   725	    """Return a source-derived topology view for front-half boundary checks.
   726	
   727	    The returned topology captures step IDs and route declarations from
   728	    the lowered workflow source.  Boundary contracts consume this topology
   729	    to correlate durable effects (receipts, findings) with implemented
   730	    source rows, but they do **not** own, alter, or substitute for product
   731	    route topology.  Route selection remains the exclusive province of
   732	    source-level ``Route`` declarations and runtime signal handlers.
   733	    """
   734	
   735	    lowered = _lowered_workflow()
   736	    canonical_routes = _topology_lowered_routes(lowered.routes)
   737	    return {
   738	        "workflow_id": lowered.id,
   739	        "workflow_version": lowered.version,
   740	        "source_path": str(AUTHORING_SOURCE_PATH),
   741	        "steps": tuple(step.id for step in _canonical_steps(timeout_seconds=None, lowered_steps=lowered.steps)),
   742	        "step_aliases": _lowered_step_aliases(lowered.steps, step_id_fn=_topology_step_id),
   743	        "routes": tuple(
   744	            {
   745	                "id": route.id,
   746	                "source": route.source,
   747	                "target": route.target,
   748	                "label": route.label,
   749	                "condition_ref": route.condition_ref,
   750	            }
   751	            for route in canonical_routes
   752	        ),
   753	    }
   754	
   755	
   756	def lowered_route_bindings_by_step(
   757	    *, step_ids: set[str] | frozenset[str] | None = None
   758	) -> dict[str, tuple[dict[str, str | None], ...]]:
   759	    """Group source-derived route bindings by source step id."""
   760	
   761	    grouped: dict[str, list[dict[str, str | None]]] = {}
   762	    wanted_step_ids = None if step_ids is None else set(step_ids)
   763	    for route in _topology_lowered_routes(_lowered_workflow().routes):
   764	        if wanted_step_ids is not None and route.source not in wanted_step_ids:
   765	            continue
   766	        grouped.setdefault(route.source, []).append(
   767	            {
   768	                "id": route.id,
   769	                "label": route.label,
   770	                "target_ref": route.target,
   771	                "condition_ref": route.condition_ref,
   772	            }
   773	        )
   774	    return {source: tuple(routes) for source, routes in grouped.items()}
   775	
   776	
   777	def resolve_lowered_route_target_for_signal(source: str, signal: str) -> str | None:
   778	    """Resolve a source-derived route target for a route signal."""
   779	
   780	    for route in _topology_lowered_routes(_lowered_workflow().routes):
   781	        if route.source == source and route.label == signal:
   782	            return route.target
   783	    return None
   784	

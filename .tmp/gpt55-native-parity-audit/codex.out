e = megaplan.review_checks.get_check_by_id(\"coverage\")\n    assert coverage is not None\n\n    pre_check_flags = [\n        {\n            \"id\": \"PRECHECK-SOURCE_TOUCH\",\n            \"check\": \"source_touch\",\n            \"detail\": \"The diff touches a non-test source file.\",\n            \"severity\": \"minor\",\n        }\n    ]\n    criteria_payload = _build_mock_payload(\"review\", state, fixture.plan_dir, review_verdict=\"approved\")\n    parallel_result = WorkerResult(\n        payload={\n            \"criteria_payload\": criteria_payload,\n            \"checks\": [\n                {\n                    \"id\": coverage.id,\n                    \"question\": coverage.question,\n                    \"findings\": [\n                        {\n                            \"detail\": \"Coverage review found an issue example from the original bug report that the diff still does not address.\",\n                            \"flagged\": True,\n                            \"status\": \"blocking\",\n                            \"evidence_file\": \"pkg/module.py\",\n                        }\n                    ],\n                }\n            ],\n            \"verified_flag_ids\": [\"REVIEW-OLD-001\"],\n            \"disputed_flag_ids\": [\"REVIEW-OLD-002\"],\n        },\n        raw_output=\"parallel\",\n        duration_ms=12,\n        cost_usd=0.75,\n        session_id=None,\n        prompt_tokens=10,\n        completion_tokens=20,\n        total_tokens=30,\n    )\n\n    monkeypatch.delenv(megaplan.MOCK_ENV_VAR, raising=False)\n    monkeypatch.setattr(\n        megaplan.handlers,\n        \"resolve_agent_mode\",\n        lambda *args, **kwargs: (\"hermes\", \"persistent\", True, \"mock-model\"),\n    )\n    monkeypatch.setattr(megaplan.handlers, \"run_pre_checks\", lambda *args, **kwargs: pre_check_flags)\n    monkeypatch.setattr(megaplan.handlers, \"run_parallel_review\", lambda *args, **kwargs: parallel_result)\n    monkeypatch.setattr(\n        megaplan.handlers.worker_module,\n        \"run_step_with_worker\",\n        lambda *args, **kwargs: (_ for _ in ()).throw(AssertionError(\"heavy Hermes review should not use the legacy worker\")),\n    )\n\n    response = megaplan.handle_review(fixture.root, fixture.make_args(plan=fixture.plan_name))\n    stored_review = read_json(fixture.plan_dir / \"review.json\")\n    faults = read_json(fixture.plan_dir / \"faults.json\")\n\n    assert response[\"success\"] is False\n    assert response[\"state\"] == megaplan.STATE_FINALIZED\n    assert response[\"next_step\"] == \"execute\"\n    assert stored_review[\"review_verdict\"] == \"needs_rework\"\n    assert stored_review[\"checks\"][0][\"id\"] == \"coverage\"\n    assert stored_review[\"pre_check_flags\"] == pre_check_flags\n    assert stored_review[\"verified_flag_ids\"] == [\"REVIEW-OLD-001\"]\n    assert stored_review[\"disputed_flag_ids\"] == [\"REVIEW-OLD-002\"]\n    assert any(item[\"task_id\"] == \"REVIEW\" and item[\"source\"] == \"review_coverage\" for item in stored_review[\"rework_items\"])\n    assert any(flag[\"id\"] == \"REVIEW-COVERAGE-001\" for flag in faults[\"flags\"])\n\n\ndef test_handle_review_heavy_iteration_two_marks_verified_review_flags(\n    tmp_path: Path,\n    monkeypatch: pytest.MonkeyPatch,\n) -> None:\n    fixture = _make_plan_fixture(tmp_path, monkeypatch, robustness=\"heavy\")\n    _advance_to_executed(fixture)\n    _plan_dir, state = load_plan(fixture.root, fixture.plan_name)\n    state[\"iteration\"] = 2\n    state[\"current_state\"] = megaplan.STATE_EXECUTED\n    save_state(fixture.plan_dir, state)\n    save_flag_registry(\n        fixture.plan_dir,\n        {\n            \"flags\": [\n                {\n                    \"id\": \"REVIEW-COVERAGE-001\",\n                    \"concern\": \"Coverage gap is still open\",\n                    \"category\": \"completeness\",\n                    \"severity_hint\": \"likely-significant\",\n                    \"evidence\": \"prior issue\",\n                    \"status\": \"open\",\n                    \"severity\": \"significant\",\n                    \"verified\": False,\n                    \"raised_in\": \"review_v1.json\",\n                }\n            ]\n        },\n    )\n    coverage = megaplan.review_checks.get_check_by_id(\"coverage\")\n    assert coverage is not None\n    criteria_payload = _build_mock_payload(\"review\", state, fixture.plan_dir, review_verdict=\"approved\")\n    parallel_result = WorkerResult(\n        payload={\n            \"criteria_payload\": criteria_payload,\n            \"checks\": [\n                {\n                    \"id\": coverage.id,\n                    \"question\": coverage.question,\n                    \"findings\": [\n                        {\n                            \"detail\": \"Confirmed the previous coverage concern is now resolved for the original issue example.\",\n                            \"flagged\": False,\n                            \"status\": \"n/a\",\n                        }\n                    ],\n                }\n            ],\n            \"verified_flag_ids\": [\"REVIEW-COVERAGE-001\"],\n            \"disputed_flag_ids\": [],\n        },\n        raw_output=\"parallel\",\n        duration_ms=8,\n        cost_usd=0.2,\n        session_id=None,\n        prompt_tokens=5,\n        completion_tokens=6,\n        total_tokens=11,\n    )\n\n    monkeypatch.delenv(megaplan.MOCK_ENV_VAR, raising=False)\n    monkeypatch.setattr(\n        megaplan.handlers,\n        \"resolve_agent_mode\",\n        lambda *args, **kwargs: (\"hermes\", \"persistent\", True, \"mock-model\"),\n    )\n    monkeypatch.setattr(megaplan.handlers, \"run_pre_checks\", lambda *args, **kwargs: [])\n    monkeypatch.setattr(megaplan.handlers, \"run_parallel_review\", lambda *args, **kwargs: parallel_result)\n    monkeypatch.setattr(\n        megaplan.handlers.worker_module,\n        \"run_step_with_worker\",\n        lambda *args, **kwargs: (_ for _ in ()).throw(AssertionError(\"heavy Hermes review should not use the legacy worker\")),\n    )\n\n    response = megaplan.handle_review(fixture.root, fixture.make_args(plan=fixture.plan_name))\n    faults = read_json(fixture.plan_dir / \"faults.json\")\n","exit_code":0,"status":"completed"}}
.megaplan/plans/handoff-artifacts-human-gate-20260620-0426/research.json:68:        "writing_panel_strict.py: build_pipeline() \u2013 current graph-executor pipeline definition"
.megaplan/plans/handoff-artifacts-human-gate-20260620-0426/step_receipt_prep_v0.json:104:      "writing_panel_strict.py: build_pipeline() \u2013 current graph-executor pipeline definition"
.megaplan/plans/handoff-artifacts-human-gate-20260620-0426/prep_metrics.json:62:    "writing_panel_strict.py: build_pipeline() \u2013 current graph-executor pipeline definition"
.megaplan/plans/handoff-artifacts-human-gate-20260620-0426/prep_metrics.json:109:        "writing_panel_strict.py: build_pipeline() \u2013 current graph-executor pipeline definition"
.megaplan/plans/handoff-artifacts-human-gate-20260620-0426/prep.json:93:        "build_pipeline",
.megaplan/plans/handoff-artifacts-human-gate-20260620-0426/prep.json:101:        "build_pipeline"
.megaplan/plans/pipeline-week1-cleanup/critique_v3.json:58:          "detail": "Existing creative pipeline tests are a concrete location the plan needs to update: `tests/pipelines/test_creative_pipeline.py` currently asserts that `build_pipeline(form='poem')` produces `prep:poem`, `execute_creative:poem`, `critique_creative:poem`, and `revise_creative:poem`. The revised plan says non-joke forms should use generic prompt keys, but it does not name this stale test as an update target, so an implementer following only the listed test additions could leave contradictory assertions in place until validation fails.",
.megaplan/plans/pipeline-week1-cleanup/critique_v3.json:68:          "detail": "The plan correctly handles the direct `_build_pipeline_for_run(args)` caller: `cli_run()` is the only production caller in the current tree, and the revised plan requires testing the actual `cli_run()` surface rather than only the helper.",
.megaplan/plans/pipeline-week1-cleanup/critique_v1.json:8:          "detail": "Creative run path: the plan says to preserve form validation, form-specific prompt keys like `execute_creative:joke`, and primary criterion propagation, but `megaplan/_pipeline/run_cli.py` has no `--form` or `--primary-criterion` options and calls `get_pipeline(pipeline_name)`, whose registry builder invokes `build_pipeline()` with no keyword arguments. That means `megaplan run creative --form poem` cannot work through the first-class pipeline path without additional CLI and registry-builder plumbing, despite tests and docs describing that surface.",
.megaplan/plans/pipeline-week1-cleanup/critique_v1.json:40:          "detail": "First-class creative pipeline scope is broader than `megaplan/pipelines/creative/__init__.py`: prompt-key dispatch for direct `build_pipeline(form='poem')` works, but the user-facing `megaplan run` path cannot pass the form or primary criterion into the builder. If the cleanup is meant to finish the first-class `megaplan run creative` path, the plan needs to include `run_cli` parser/state handling or a registry builder mechanism for parameterized pipelines.",
.megaplan/plans/pipeline-week1-cleanup/critique_v1.json:44:          "detail": "The doc and creative module split is well scoped: `megaplan/pipelines/doc/__init__.py` imports mechanics from `megaplan.pipelines.doc.steps`, and `megaplan/pipelines/creative/__init__.py` keeps only validation, stage specification, and `build_pipeline()` while `CreativeStep` lives in `steps.py`. That matches the stated topology-vs-step-shell boundary.",
.megaplan/plans/pipeline-week1-cleanup/critique_v1.json:68:          "detail": "The registry caller contract is nullary: `PipelineBuilder = Callable[[], Pipeline]`, `PipelineRegistry.get()` calls `self.builders[name]()`, and discovered pipeline builders are stored directly. This handles `build_pipeline()` defaults but cannot pass `form='poem'` or `primary_criterion='...'` to `megaplan.pipelines.creative.build_pipeline`, so only the default joke form is reachable through `get_pipeline('creative')` today.",
.megaplan/plans/pipeline-week1-cleanup/execution_batch_6.json:6:      "executor_notes": "Made the creative pipeline table-driven and runnable through real step shells. megaplan/pipelines/creative/__init__.py now keeps creative metadata, form validation, STAGE_SPECS, and build_pipeline() assembly, with stage mechanics delegated to megaplan.pipelines.creative.steps.CreativeStep. CreativeStep.run() now enriches StepContext state/inputs with creative config, _pipeline, primary_criterion, and prior _creative_artifacts; resolves registered prompt keys through resolve_prompt(); writes prompt_vN.md plus non-empty vN.md stage artifacts; and returns state patches that pass prior stage artifacts forward. CLI creative construction already threads --form and --primary-criterion into build_pipeline(), and tests now verify the parameters reach stage configuration and rendered artifacts. Verification: build_pipeline smoke confirmed all stages are CreativeStep instances with form-baked prompt keys and primary_criterion. Targeted tests passed: pytest tests/pipelines/test_creative_pipeline.py (12 passed) and pytest tests/test_pipeline_run_cli.py tests/pipelines/test_creative_pipeline.py (25 passed, 4 skipped). Full suite pytest was run as required: 2672 passed, 25 skipped, 3 failed. The failures are the same sandbox-only failures from prior batches: tests/test_epic_cli.py::test_migrate_local_plans_dry_run_does_not_write_and_import_preserves_nested_binary, tests/test_epic_cli.py::test_migrate_local_plans_all_projects_legacy_epic_and_db_promotion_preserve_binary, and tests/test_ops_recovery_docs.py::test_ops_missing_blob_export_and_partial_legacy_conflict; all fail with PermissionError creating /Users/peteromalley/.megaplan/project-* outside writable roots.",
.megaplan/plans/pipeline-week1-cleanup/execution_batch_6.json:16:        "python build_pipeline creative stage smoke",
.megaplan/plans/pipeline-week1-cleanup/critique_v2.json:16:          "detail": "Creative CLI parameter coverage is still incomplete for the actual prompt path: `build_pipeline(form='poem')` creates stage prompt keys like `execute_creative:poem`, but the prompt registry only has generic `creative/execute_creative` and joke-specialized `creative/execute_creative:joke` registrations, so a valid non-joke form does not resolve through `resolve_prompt()` if the step uses its prompt key.",
.megaplan/plans/pipeline-week1-cleanup/critique_v2.json:34:          "detail": "Invalid creative form handling needs a stricter CLI-order requirement: in the current `run_cli` flow, profile preflight runs before `_build_pipeline_for_run(args)`, so `megaplan run creative --form not-a-real-form` can fail with missing credentials instead of surfacing the intended `CliError('invalid_args')`; when preflight is patched out, the `CliError` is raised outside the CLI's error-handling block.",
.megaplan/plans/pipeline-week1-cleanup/critique_v2.json:44:          "detail": "The narrow `run_cli` construction hook is appropriate for the plan's stated scope: `PipelineRegistry.get()` and `run_pipeline_by_name()` intentionally remain nullary, and the plan preserves default `get_pipeline('creative')` behavior while routing only the user-facing `megaplan run creative` options through `build_pipeline(form=..., primary_criterion=...)`.",
.megaplan/plans/pipeline-week1-cleanup/critique_v2.json:52:          "detail": "The doc and creative module split is correctly scoped: `megaplan/pipelines/doc/__init__.py` imports mechanics from `megaplan.pipelines.doc.steps`, and `megaplan/pipelines/creative/__init__.py` keeps validation, a stage-spec table, and `build_pipeline()` while `CreativeStep` lives in `steps.py`.",
.megaplan/plans/pipeline-week1-cleanup/critique_v2.json:80:          "detail": "The revised plan handles the registry caller contract correctly: `PipelineBuilder = Callable[[], Pipeline]` and `PipelineRegistry.get()` still call builders with no arguments, while the proposed `run_cli` helper can call `megaplan.pipelines.creative.build_pipeline()` with keyword arguments only for the creative CLI path.",
.megaplan/plans/pipeline-week1-cleanup/critique_v2.json:88:          "detail": "The creative CLI tests exercise that `_build_pipeline_for_run()` passes `form` and `primary_criterion` into the builder, but they do not currently prove that invalid forms fail through `cli_run()` before credential preflight or that non-joke prompt keys resolve through `PromptRegistry`; those are the callers most likely to regress this surface.",
.megaplan/plans/pipeline-week1-cleanup/critique_v2.json:107:      "evidence": "`_run_pipeline()` calls `preflight_or_raise()` before `_build_pipeline_for_run(args)`. A direct `cli_run` with invalid creative form returned credential preflight code 7 in this environment; with preflight patched, `CliError invalid_args` propagated from `_build_pipeline_for_run()`."
.megaplan/plans/pipeline-week1-cleanup/critique_v2.json:111:      "concern": "Creative option scope: set creative-only options are silently accepted for non-creative pipelines because the parser adds them globally and `_build_pipeline_for_run()` ignores them unless `pipeline_name == 'creative'`.",
.megaplan/plans/pipeline-week1-cleanup/gate_signals_v4.json:5:    "idea": "# Pipeline Week 1 Cleanup\n\n## Outcome\n\nMake pipeline modules describe topology, not compatibility shims or inline\nworkflow mechanics.\n\n## Scope\n\nIn scope:\n\n- Remove planning compatibility shims entirely.\n- Keep `compile_planning_pipeline()` as the only planning compiler.\n- Split doc and creative pipeline step shells into dedicated modules.\n- Make the creative pipeline table-driven.\n- Remove duplicate judges artifact path plumbing.\n- Update focused tests and docs that referenced removed shim APIs.\n\nOut of scope:\n\n- Unrelated execution, review, worker, profile, and ticket changes already\n  present in the worktree.\n- Broad desloppify queue work.\n- Public backward-compat wrappers for the removed planning APIs.\n\n## Locked Decisions\n\n- No shims.\n- No compatibility wrappers.\n- No legacy overlay path.\n- First-class `doc` and `creative` pipelines are the mode path.\n- Pipeline `__init__.py` files should primarily expose metadata and\n  `build_pipeline()`.\n\n## Done Criteria\n\n- Targeted pipeline tests pass.\n- `rg` finds no in-tree imports of `compile_pipeline_for`, `mode_overlay`,\n  `robustness_overlay`, `with_prep_overlay`, `with_feedback_overlay`,\n  `_step_for`, or `_RuntimeStep`, except historical docs that are explicitly\n  updated or clearly archived.\n- Unrelated dirty files are left untouched.",
.megaplan/plans/pipeline-week1-cleanup/gate_signals_v4.json:76:        "concern": "Did the work fully address the issue hints, user notes, and approved plan requirements?: Creative run path: the plan says to preserve form validation, form-specific prompt keys like `execute_creative:joke`, and primary criterion propagation, but `megaplan/_pipeline/run_cli.py` has no `--form` or `--primary-criterion` options and calls `get_pipeline(pipeline_name)`, whose registry builder invokes `build_pipeline()` with no keyword arguments. That means `megaplan run creative --form poem` cannot work through the first-class pipeline path without additional CLI and registry-builder plumbing, despite tests and docs describing that surface.",
.megaplan/plans/pipeline-week1-cleanup/gate_signals_v4.json:86:        "concern": "Does the change touch all locations AND supporting infrastructure?: Existing creative pipeline tests are a concrete location the plan needs to update: `tests/pipelines/test_creative_pipeline.py` currently asserts that `build_pipeline(form='poem')` produces `prep:poem`, `execute_creative:poem`, `critique_creative:poem`, and `revise_creative:poem`. The revised plan says non-joke forms should use generic prompt keys, but it does not name this stale test as an update target, so an implementer following only the listed test additions could leave contradictory assertions in place until validation fails.",
.megaplan/plans/pipeline-week1-cleanup/gate_signals_v4.json:91:        "concern": "Find the callers of the changed function. What arguments do they actually pass? Does the fix handle all of them?: The registry caller contract is nullary: `PipelineBuilder = Callable[[], Pipeline]`, `PipelineRegistry.get()` calls `self.builders[name]()`, and discovered pipeline builders are stored directly. This handles `build_pipeline()` defaults but cannot pass `form='poem'` or `primary_criterion='...'` to `megaplan.pipelines.creative.build_pipeline`, so only the default joke form is reachable through `get_pipeline('creative')` today.",
.megaplan/plans/pipeline-week1-cleanup/gate_signals_v4.json:107:        "resolution": "`_run_pipeline()` calls `preflight_or_raise()` before `_build_pipeline_for_run(args)`. A direct `cli_run` with invalid creative form returned credential preflight code 7 in this environment; with preflight patched, `CliError invalid_args` propagated from `_build_pipeline_for_run()`."
.megaplan/plans/pipeline-week1-cleanup/gate_signals_v4.json:111:        "concern": "Creative option scope: set creative-only options are silently accepted for non-creative pipelines because the parser adds them globally and `_build_pipeline_for_run()` ignores them unless `pipeline_name == 'creative'`.",
.megaplan/plans/pipeline-week1-cleanup/gate_signals_v4.json:242:        "criterion": "Doc and creative pipeline `__init__.py` files primarily expose metadata and `build_pipeline()`, with step shell mechanics in dedicated `steps.py` modules.",
.megaplan/plans/pipeline-week1-cleanup/plan_v4.meta.json:150:      "criterion": "Doc and creative pipeline `__init__.py` files primarily expose metadata and `build_pipeline()`, with step shell mechanics in dedicated `steps.py` modules.",
.megaplan/plans/pipeline-week1-cleanup/execution_batch_5.json:6:      "executor_notes": "Cleaned the first-class doc pipeline module boundary. megaplan/pipelines/doc/__init__.py now stays focused on pipeline metadata, prompt-registration side effects, and build_pipeline(); doc stage mechanics live in the public step shell module megaplan/pipelines/doc/steps.py. build_pipeline() instantiates OutlineStep, OutlineArtifactReader, SectionDraftStep, CritiqueStep, ReviseStep, AssemblyStep, and concat_sections_join from megaplan.pipelines.doc.steps. tests/pipelines/test_doc_pipeline.py imports and patches SectionDraftStep from megaplan.pipelines.doc.steps instead of stale private package-root names, and stale private-step narration was removed from doc pipeline comments. Verification: stale private doc step symbol search over megaplan/pipelines/doc and tests/pipelines/test_doc_pipeline.py returned no hits; search for tests importing Step/private names from megaplan.pipelines.doc package root returned no stale step callers; import smoke confirmed build_pipeline() uses step classes from megaplan.pipelines.doc.steps. Targeted test passed: pytest tests/pipelines/test_doc_pipeline.py (5 passed). Full suite pytest was run as required: 2672 passed, 25 skipped, 3 failed. The failures are the same sandbox-only failures from prior batches: tests/test_epic_cli.py::test_migrate_local_plans_dry_run_does_not_write_and_import_preserves_nested_binary, tests/test_epic_cli.py::test_migrate_local_plans_all_projects_legacy_epic_and_db_promotion_preserve_binary, and tests/test_ops_recovery_docs.py::test_ops_missing_blob_export_and_partial_legacy_conflict; all fail with PermissionError creating /Users/peteromalley/.megaplan/project-* outside writable roots.",
.megaplan/plans/pipeline-week1-cleanup/execution_batch_5.json:17:        "python build_pipeline doc step module smoke",
.megaplan/plans/pipeline-week1-cleanup/execution.json:114:      "executor_notes": "Fixed the reviewer blocker. `_run_pipeline()` now validates creative-only options, then builds the creative pipeline before profile resolution/preflight so unknown forms are raised by `build_pipeline()` as `CliError('invalid_args')`; CLI handling emits the structured invalid-argument payload and returns exit code 2. The repro script confirmed profile/preflight were not reached for an invalid form.",
.megaplan/plans/pipeline-week1-cleanup/state.json:3:  "idea": "# Pipeline Week 1 Cleanup\n\n## Outcome\n\nMake pipeline modules describe topology, not compatibility shims or inline\nworkflow mechanics.\n\n## Scope\n\nIn scope:\n\n- Remove planning compatibility shims entirely.\n- Keep `compile_planning_pipeline()` as the only planning compiler.\n- Split doc and creative pipeline step shells into dedicated modules.\n- Make the creative pipeline table-driven.\n- Remove duplicate judges artifact path plumbing.\n- Update focused tests and docs that referenced removed shim APIs.\n\nOut of scope:\n\n- Unrelated execution, review, worker, profile, and ticket changes already\n  present in the worktree.\n- Broad desloppify queue work.\n- Public backward-compat wrappers for the removed planning APIs.\n\n## Locked Decisions\n\n- No shims.\n- No compatibility wrappers.\n- No legacy overlay path.\n- First-class `doc` and `creative` pipelines are the mode path.\n- Pipeline `__init__.py` files should primarily expose metadata and\n  `build_pipeline()`.\n\n## Done Criteria\n\n- Targeted pipeline tests pass.\n- `rg` finds no in-tree imports of `compile_pipeline_for`, `mode_overlay`,\n  `robustness_overlay`, `with_prep_overlay`, `with_feedback_overlay`,\n  `_step_for`, or `_RuntimeStep`, except historical docs that are explicitly\n  updated or clearly archived.\n- Unrelated dirty files are left untouched.",
.megaplan/plans/pipeline-week1-cleanup/state.json:368:          "reason": "Added tests at the actual `cli_run()` and `PromptRegistry` caller surfaces, not only `_build_pipeline_for_run()`."
.megaplan/plans/pipeline-week1-cleanup/plan_v2.meta.json:96:      "criterion": "Doc and creative pipeline `__init__.py` files primarily expose metadata and `build_pipeline()`, with step shell mechanics in dedicated `steps.py` modules.",
.megaplan/plans/pipeline-week1-cleanup/plan_v1_shannon_prompt.txt:44:  `build_pipeline()`.
.megaplan/plans/pipeline-week1-cleanup/review.json:55:      "evidence": "Registry contract remains nullary; `doc` and `creative` package pipelines expose `build_pipeline()`. Planning compiler has no overlay construction; docs/tests reference first-class pipeline names."

   645	def test_execute_and_front_half_evidence_coexist() -> None:
   646	    """When both S2 front-half and S4 execute evidence are passed, the
   647	    checker must preserve all evidence and only flag uncovered front-half rows."""
   648	    evidence = (
   649	        _evidence_for(S2_PREP_ROW_ID, code=DiagnosticCode.ROW_EVIDENCE_INSUFFICIENCY),
   650	        _evidence_for(S2_PLAN_ROW_ID, code=DiagnosticCode.ROW_EVIDENCE_INSUFFICIENCY),
   651	        SemanticEvidence(
   652	            diagnostic_code=DiagnosticCode.ROW_EVIDENCE_INSUFFICIENCY,
   653	            source_span=SourceSpan("test.pypeline", 3, 1, 3, 15),
   654	            construct_type=ConstructType.EXECUTE,
   655	            row_id=S4_EXECUTE_ROW_ID,
   656	        ),
   657	    )

   392	def _override_action_target(action: str) -> str:
   393	    entry = get_entry(action)
   394	    if entry.target_ref is not None:
   395	        return entry.target_ref
   396	    return "current-phase"
   397	
   398	
   399	def _override_action_overlays() -> tuple[Mapping[str, Any], ...]:
   400	    overlays: list[Mapping[str, Any]] = []
   401	    for entry in sorted(OVERRIDE_ACTION_MATRIX, key=lambda item: item.action):
   402	        overlays.append(
   403	            {
   404	                "overlay_id": f"override:{entry.action}",
   405	                "overlay_type": entry.family,
   406	                "source_ref": "override.action",
   407	                "target_refs": (_override_action_target(entry.action),),
   408	                "condition_ref": f"override.action.eq.{entry.action}",
   409	            }
   410	        )
   411	    return tuple(overlays)
   412	
   413	
   414	def _override_action_effects() -> tuple[Mapping[str, Any], ...]:
   415	    return tuple(
   416	        {
   417	            "effect_id": get_entry(action).effect_id,
   418	            "payload_ref": "override.override_result",
   419	            "idempotency": {"key_ref": f"override.{action.replace('-', '_')}"},
   420	        }


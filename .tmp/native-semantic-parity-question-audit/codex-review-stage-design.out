    81	def _parse_milestone(raw: str) -> tuple[str, str]:
    82	    label, sep, title = raw.partition("=")
    83	    if not sep:
    84	        label, sep, title = raw.partition(":")
    85	    label = slugify(label)
    86	    title = title.strip() if sep else ""
    87	    if not label:
    88	        raise ValueError(f"invalid milestone spec: {raw!r}")
    89	    return label, title or label.replace("-", " ").title()

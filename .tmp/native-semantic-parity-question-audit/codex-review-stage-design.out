    53	
    54	def _gate_prompt(
    55	    state: PlanState,
    56	    plan_dir: Path,
    57	    root: Path | None = None,
    58	    contract_context: Mapping[str, Any] | None = None,
    59	) -> str:
    60	    from ._shared import _render_contracts_block, _resolve_contract_context
    61	
    62	    contracts_block = _render_contracts_block(
    63	        _resolve_contract_context(state, contract_context),
    64	        audience="gate",
    65	    )
    66	    project_dir = Path(state["config"]["project_dir"])
    67	    latest_plan = latest_plan_path(plan_dir, state).read_text(encoding="utf-8")
    68	    latest_meta = read_json(latest_plan_meta_path(plan_dir, state))
    69	    gate_signals = read_json(
    70	        current_iteration_artifact(plan_dir, "gate_signals", state["iteration"])
    71	    )
    72	    flag_registry = load_flag_registry(plan_dir)
    73	    unresolved = unresolved_significant_flags(flag_registry)
    74	    open_flags = [
    75	        {
    76	            "id": flag["id"],
    77	            "concern": flag["concern"],
    78	            "evidence": flag.get("evidence", ""),
    79	            "revise_summary": flag_resolution_summary(flag),
    80	            "category": flag["category"],
    81	            "severity": flag.get("severity", "unknown"),
    82	            "status": flag["status"],
    83	            "weight": flag.get("weight"),
    84	        }
    85	        for flag in unresolved
    86	    ]
    87	    robustness = configured_robustness(state)
    88	    # Critique check summary — flagged counts only (unflagged findings are in the
    89	    # artifact JSON for audit but not injected into the gate prompt).
    90	    critique_checks_block = ""
    91	    critique_path = current_iteration_artifact(plan_dir, "critique", state["iteration"])
    92	    if Path(critique_path).exists():
    93	        critique_data = read_json(critique_path)
    94	        checks = critique_data.get("checks", [])
    95	        if checks:
    96	            check_lines = []
    97	            for check in checks:
    98	                findings = check.get("findings", [])
    99	                flagged_count = sum(1 for f in findings if f.get("flagged"))
   100	                status = f"{flagged_count} flagged" if flagged_count else "clear"
   101	                check_lines.append(f"- {check.get('id', '?')}: {status}")
   102	            critique_checks_block = (
   103	                "Critique check summary:\n        "
   104	                + "\n        ".join(check_lines)
   105	            )
   106	    output_path = _write_gate_template(plan_dir, state)
   107	
   108	    return textwrap.dedent(
   109	        f"""
   110	        You are the gatekeeper for the megaplan workflow. Make the continuation decision directly.
   111	
   112	        {contracts_block}
   113	        Project directory:
   114	        {project_dir}
   115	
   116	        {intent_brief_reference(state)}
   117	
   118	        Plan:
   119	        {latest_plan}
   120	
   121	        Plan metadata:
   122	        {json_dump(latest_meta).strip()}
   123	
   124	        Gate signals:
   125	        {json_dump(_gate_signals_for_prompt(gate_signals)).strip()}
   126	
   127	        {critique_checks_block}
   128	
   129	        Unresolved significant flags:
   130	        {json_dump(open_flags).strip()}
   131	
   132	        Addressed but unverified flags:
   133	        {json_dump(gate_signals.get("signals", {}).get("addressed_flags", [])).strip()}
   134	
   135	        {_iteration_pressure_block(state, plan_dir)}
   136	
   137	        Robustness level:
   138	        {robustness}
   139	
   140	        Your output template is at: {output_path}
   141	        Read this file first by calling `read_file` with `path` exactly `{output_path}` — it contains the expected JSON structure.
   142	        If you cannot supply that exact non-empty path, do not call `read_file`.
   143	        Fill the JSON structure with your results and write the file back.
   144	        Valid flag IDs are: {json_dump([flag["id"] for flag in open_flags]).strip()}
   145	        If you cannot use file tools, return the populated JSON structure inline as your response instead.
   146	
   147	        Requirements:
   148	        - Decide exactly one of: PROCEED, ITERATE, ESCALATE, TIEBREAKER.
   149	        - Use the weighted score, flag details (including `evidence`), plan delta, recurring critiques, and preflight results as judgment context.
   150	        - PROCEED when execution should move forward now.
   151	        - ITERATE when revising the plan is the best next move.
   152	        - ESCALATE when the loop is stuck, churn is recurring, or user intervention is needed.
   153	        - TIEBREAKER when a flag group reflects an *unresolvable constraint tension* (architectural or philosophical — requires a human call) rather than a plan-quality issue. Use TIEBREAKER only when the Iteration Pressure Analysis shows `addressed_then_reopened_count >= 2` for a fuzzy group OR the group has >=2 member flags across >=2 iterations. If the concern is simply that the plan writer hasn't tried hard enough, use ITERATE instead. When recommending TIEBREAKER you MUST provide `tiebreaker_question` (the decision question for human resolution), `tiebreaker_flag_ids` (which flags this resolves), and `tiebreaker_fuzzy_group_id` (which group this resolves). Cite specific flag IDs and iterations in your rationale.
   154	        - `signals_assessment`: one paragraph summarizing score trajectory, flag status, and preflight posture.
   155	
   156	        Flags come in three gate states:
   157	        - **Blocking** (severity = significant/likely-significant): These are serious concerns. If you recommend PROCEED, you MUST provide a `flag_resolutions` entry for every blocking flag. There is no implicit acceptance.
   158	        - **Addressed but unverified**: The revision claims these were fixed. Treat significant/likely-significant addressed flags as verification obligations. If you recommend PROCEED, provide a `flag_resolutions` entry with `action: "verify_fixed"` and concrete evidence for every addressed blocking flag. If the evidence is insufficient, choose ITERATE.
   159	        - **Noted** (everything else): Acknowledge in your rationale but they don't block PROCEED.
   160	
   161	        If there are blocking or addressed-blocking flags and you want to PROCEED, provide `flag_resolutions` with one entry per flag. If you cannot resolve every required flag, choose ITERATE (send back for revision) or ESCALATE (human intervention needed).
   162	        Structurally unresolvable flags (for example, infrastructure outside the repo or product decisions that require a human) are ESCALATE, not PROCEED with a non-answer.
   163	
   164	        For each required flag:
   165	        - **verify_fixed**: The concern was real and the revised plan now fixes it. Evidence must cite the concrete changed plan section, file path, command, or contract that proves the fix.
   166	        - **dispute**: The critique is factually wrong. Evidence must cite something specific (file path, line, API doc, etc.). Generic statements like "handled correctly" are invalid.
   167	        - **accept_tradeoff**: The concern is real but intentionally accepted as a known limitation. Rationale must be specific to this flag. Boilerplate like "acceptable within scope" is invalid.
   168	        - Schema requirement: every `flag_resolutions` entry must include both `evidence` and `rationale`. Use `""` for the field that does not apply to that action.
   169	
   170	        If there are no blocking flags, return `flag_resolutions: []`.
   171	        Always return `accepted_tradeoffs`; use `[]` when none apply. Each `accepted_tradeoffs` entry must be an object with exactly `flag_id`, `concern`, `subsystem`, and `rationale`.
   172	        Do not add fields outside the template. In particular, do not add `known_flag_ids`, `_scratch_note`, `_scratch_timestamp`, or nested `tradeoff` fields.
   173	
   174	        Populate `settled_decisions` with design choices that should carry into review without re-litigation. Return typed objects, never bare strings: `[{{"id": "SD1", "decision": "...", "rationale": "..."}}]`. Return `[]` when there are none.
   175	
   176	        Example:
   177	        ```json
   178	        {{
   179	          "recommendation": "PROCEED",
   180	          "rationale": "Core fix is correct. Convention concern accepted.",
   181	          "signals_assessment": "Score stable at 2.5, preflight passed, no recurring critiques.",
   182	          "warnings": ["Verify edge case with composite moduli during execution."],
   183	          "flag_resolutions": [
   184	            {{"flag_id": "addressed-1", "action": "verify_fixed", "evidence": "plan_v3.md Phase 1 Step 2 requires an exact __all__ assertion and tests/characterization/test_import_surface.py coverage.", "rationale": ""}},
   185	            {{"flag_id": "correctness-1", "action": "dispute", "evidence": "allow_migrate and allow_migrate_model produce identical behavior for this use case (verified at django/db/utils.py:286).", "rationale": ""}},
   186	            {{"flag_id": "performance-1", "action": "accept_tradeoff", "evidence": "", "rationale": "Cold-start latency remains 40ms above target because the cache warmup job is owned by platform and outside this repo; rollout is still approved for the limited internal beta."}},
   187	            {{"flag_id": "conventions-1", "action": "accept_tradeoff", "evidence": "", "rationale": "Minor naming inconsistency is confined to this helper and would create churn across generated fixtures; track it as follow-up cleanup instead of blocking this fix."}}
   188	          ],
   189	          "accepted_tradeoffs": [],
   190	          "settled_decisions": [
   191	            {{"id": "SD1", "decision": "Keep the migration as a data-only migration", "rationale": "The schema change belongs to the already-approved follow-up and should not be re-litigated during review."}}
   192	          ]
   193	        }}
   194	        ```
   195	        """
   196	    ).strip()
   197	

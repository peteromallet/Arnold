   157	def _prep_context_sections(state: PlanState, plan_dir: Path) -> tuple[Path, Path, str, str]:
   158	    project_dir = Path(state["config"]["project_dir"])
   159	    prep_path = plan_dir / "prep.json"
   160	
   161	    direction_raw = state.get("config", {}).get("prep_direction")
   162	    direction = direction_raw.strip() if isinstance(direction_raw, str) else ""
   163	    if direction:
   164	        direction_block = textwrap.dedent(
   165	            f"""
   166	            User direction for prep (treat as steering for what to explore — not a substitute for the task):
   167	            {direction}
   168	            """
   169	        ).strip()
   170	    else:
   171	        direction_block = ""
   172	
   173	    extra_sections: list[str] = []
   174	    clarification = state.get("clarification", {}) or {}
   175	    intent_summary = clarification.get("intent_summary")
   176	    if isinstance(intent_summary, str) and intent_summary.strip():
   177	        extra_sections.append(f"User intent summary:\n{intent_summary.strip()}")
   178	    notes = state.get("meta", {}).get("notes", []) or []
   179	    note_lines = [
   180	        f"- {n['note']}"
   181	        for n in notes
   182	        if isinstance(n, dict) and isinstance(n.get("note"), str) and n["note"].strip()
   183	    ]
   184	    if note_lines:
   185	        extra_sections.append("User notes and answers:\n" + "\n".join(note_lines))
   186	    notes_block = "\n\n".join(extra_sections)
   187	    return project_dir, prep_path, direction_block, notes_block
   188	
   189	
   190	def _plan_prompt(
   191	    state: PlanState,
   192	    plan_dir: Path,
   193	    contract_context: Mapping[str, Any] | None = None,
   194	) -> str:
   195	    project_dir = Path(state["config"]["project_dir"])
   196	    prep_block, prep_instruction = _render_prep_block(plan_dir)
   197	    contracts_block = _render_contracts_block(

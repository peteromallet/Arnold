   544	def _execution_batch_sort_key(path: Path) -> tuple[int, str]:
   545	    match = re.fullmatch(r"execution_batch_(\d+)\.json", path.name)
   546	    if match:
   547	        return (int(match.group(1)), path.name)
   548	    return (-1, path.name)
   549	
   550	
   551	def _latest_execute_result(plan_dir: Path) -> str | None:
   552	    try:
   553	        state = json.loads((plan_dir / "state.json").read_text(encoding="utf-8"))
   554	    except FileNotFoundError:
   555	        return None
   556	    except json.JSONDecodeError:
   557	        chain_spec._warn_chain_fallback(
   558	            "M3A_WARN_EXECUTE_RESULT_READ",
   559	            reason="corrupt_json",
   560	            path=plan_dir / "state.json",
   561	        )
   562	        return None
   563	    except (OSError, UnicodeDecodeError):
   564	        chain_spec._warn_chain_fallback(
   565	            "M3A_WARN_EXECUTE_RESULT_READ",
   566	            reason="unreadable",
   567	            path=plan_dir / "state.json",
   568	        )
   569	        return None
   570	    history = state.get("history")
   571	    if not isinstance(history, list):
   572	        return None
   573	    for entry in reversed(history):
   574	        if isinstance(entry, dict) and entry.get("step") == "execute":
   575	            result = entry.get("result")
   576	            return result if isinstance(result, str) else None
   577	    return None
   578	
   579	
   580	def _completed_records_by_label(chain_state: ChainState) -> dict[str, dict[str, Any]]:
   581	    records: dict[str, dict[str, Any]] = {}
   582	    for record in chain_state.completed:
   583	        if not isinstance(record, dict):
   584	            continue
   585	        label = record.get("label")
   586	        if isinstance(label, str):
   587	            records[label] = record
   588	    return records
   589	
   590	
   591	def _plan_dir_for_completed_record(root: Path, record: dict[str, Any]) -> Path | None:
   592	    plan_name = record.get("plan")
   593	    if not isinstance(plan_name, str) or not plan_name.strip():
   594	        return None
   595	    try:
   596	        return resolve_plan_dir(root, plan_name)
   597	    except CliError:
   598	        fallback = root / ".megaplan" / "plans" / plan_name
   599	        return fallback if fallback.exists() else None
   600	
   601	
   602	def _read_plan_state_payload_from_dir(plan_dir: Path | None) -> dict[str, Any]:
   603	    if plan_dir is None:
   604	        return {}
   605	    try:
   606	        raw = json.loads((plan_dir / "state.json").read_text(encoding="utf-8"))
   607	    except (OSError, json.JSONDecodeError):
   608	        return {}
   609	    return raw if isinstance(raw, dict) else {}
   610	
   611	
   612	def _project_dir_from_plan_state(root: Path, state: dict[str, Any]) -> Path:
   613	    config = state.get("config") if isinstance(state.get("config"), dict) else {}
   614	    project_dir_str = config.get("project_dir") if isinstance(config, dict) else None
   615	    if isinstance(project_dir_str, str) and project_dir_str.strip():
   616	        return Path(project_dir_str)
   617	    return root
   618	
   619	
   620	def _verify_completed_chain(
   621	    root: Path,
   622	    spec_path: Path,
   623	    spec: ChainSpec,
   624	    chain_state: ChainState,
   625	) -> dict[str, Any]:
   626	    from arnold_pipelines.megaplan.orchestration.completion_contract import (
   627	        CompletionSubject,
   628	        LandedDiffProvider,
   629	        compute_verdict,
   630	        normalize_contract_mode,
   631	    )
   632	
   633	    verify_mode = normalize_contract_mode(chain_state.completion_contract_mode)
   634	    completed_records = _completed_records_by_label(chain_state)
   635	    milestones_payload: list[dict[str, Any]] = []
   636	    divergence_count = 0
   637	
   638	    for milestone in spec.milestones:
   639	        record = completed_records.get(milestone.label)
   640	        if not isinstance(record, dict):
   641	            continue
   642	        status = record.get("status")
   643	        if status not in {"done", "finalized"}:
   644	            continue
   645	        plan_name = record.get("plan")
   646	        if not isinstance(plan_name, str) or not plan_name.strip():
   647	            continue
   648	        plan_dir = _plan_dir_for_completed_record(root, record)
   649	        state = _read_plan_state_payload_from_dir(plan_dir)
   650	        project_dir = _project_dir_from_plan_state(root, state)


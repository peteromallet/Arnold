    30	def _with_anchor_block(prompt: str, state: PlanState, plan_dir: Path, *, audience: str) -> str:
    31	    anchor_block = render_anchor_context(state, plan_dir, audience=audience)
    32	    if not anchor_block:
    33	        return prompt
    34	    return f"{anchor_block}\n\n{prompt}"

    26	def flag_weight(flag: FlagRecord) -> float:
    27	    """Weight a flag for gate context. Higher = more blocking."""
    28	    category = flag.get("category", "other")
    29	    concern = flag.get("concern", "").lower()
    30	
    31	    if category == "security":
    32	        return 3.0
    33	
    34	    implementation_detail_signals = [
    35	        "column",
    36	        "schema",
    37	        "field",
    38	        "as written",
    39	        "pseudocode",
    40	        "seed sql",
    41	        "placeholder",
    42	    ]
    43	    if any(signal in concern for signal in implementation_detail_signals):
    44	        return 0.5
    45	
    46	    weights = {
    47	        "correctness": 2.0,
    48	        "completeness": 1.5,
    49	        "performance": 1.0,
    50	        "maintainability": 0.75,
    51	        "other": 1.0,
    52	    }
    53	    return weights.get(category, 1.0)
    54	
    55	
    56	def compute_plan_delta_percent(previous_text: str | None, current_text: str) -> float | None:
    57	    if previous_text is None:
    58	        return None
    59	    ratio = SequenceMatcher(None, previous_text, current_text).ratio()
    60	    return round((1.0 - ratio) * 100.0, 2)
    61	
    62	
    63	def compute_recurring_critiques(plan_dir: Path, iteration: int) -> list[str]:
    64	    if iteration < 2:
    65	        return []
    66	    previous_path = current_iteration_artifact(plan_dir, "critique", iteration - 1)
    67	    current_path = current_iteration_artifact(plan_dir, "critique", iteration)
    68	    if not previous_path.exists() or not current_path.exists():
    69	        return []
    70	    previous = read_json(previous_path)
    71	    current = read_json(current_path)
    72	    previous_concerns = {normalize_text(flag.get("concern", "")) for flag in previous.get("flags", []) if isinstance(flag, dict)}
    73	    current_concerns = {normalize_text(flag.get("concern", "")) for flag in current.get("flags", []) if isinstance(flag, dict)}
    74	    return sorted(previous_concerns.intersection(current_concerns))
    75	
    76	
    77	def _previous_iteration_plan_path(plan_dir: Path, state: PlanState) -> Path | None:
    78	    current_version = state["iteration"]
    79	    previous_version = current_version - 1
    80	    if previous_version < 1:
    81	        return None
    82	    matching = [
    83	        record
    84	        for record in state["plan_versions"]
    85	        if record.get("version") == previous_version
    86	    ]
    87	    if not matching:
    88	        return None
    89	    return plan_dir / matching[-1]["file"]
    90	

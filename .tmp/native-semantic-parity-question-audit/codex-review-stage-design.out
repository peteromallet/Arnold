   218	def _flag_summary(registry: FlagRegistry) -> list[dict[str, object]]:
   219	    """Compact flag list for the finalize prompt."""
   220	    return [
   221	        {
   222	            "id": f["id"],
   223	            "concern": f["concern"],
   224	            "evidence": f.get("evidence", ""),
   225	            "revise_summary": flag_resolution_summary(f),
   226	            "status": f["status"],
   227	            "severity": f.get("severity", "unknown"),
   228	        }
   229	        for f in registry["flags"]
   230	    ]

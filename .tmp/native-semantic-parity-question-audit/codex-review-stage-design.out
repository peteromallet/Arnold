   199	def _collect_critique_summaries(
   200	    plan_dir: Path, iteration: int
   201	) -> list[dict[str, object]]:
   202	    """Gather a compact list of all critique rounds for the finalize prompt."""
   203	    summaries: list[dict[str, object]] = []
   204	    for i in range(1, iteration + 1):
   205	        path = plan_dir / f"critique_v{i}.json"
   206	        if path.exists():
   207	            data = read_json(path)
   208	            summaries.append(
   209	                {
   210	                    "iteration": i,
   211	                    "flag_count": len(data.get("flags", [])),
   212	                    "verified": data.get("verified_flag_ids", []),
   213	                }
   214	            )
   215	    return summaries
   216	

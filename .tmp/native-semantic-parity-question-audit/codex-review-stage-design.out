   388	        return render_anchor_block(
   389	            state,
   390	            plan_dir,
   391	            audience=audience,
   392	            max_chars_per_document=max_chars_per_document,
   393	            max_total_chars=max_total_chars,
   394	        )
   395	    if resolved_mode == ANCHOR_RENDER_CHECK:
   396	        return _render_anchor_check_block(state, plan_dir)
   397	    raise CliError("invalid_anchor_mode", f"unsupported anchor render mode: {resolved_mode}")

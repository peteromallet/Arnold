    22	def _finalize_prompt(state: PlanState, plan_dir: Path, root: Path | None = None) -> str:
    23	    project_dir = Path(state["config"]["project_dir"])
    24	    latest_plan = latest_plan_path(plan_dir, state).read_text(encoding="utf-8")
    25	    latest_meta = read_json(latest_plan_meta_path(plan_dir, state))

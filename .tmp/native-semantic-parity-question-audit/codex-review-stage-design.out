   176	def _write_chain_policy_into_plan_meta(
   177	    root: Path,
   178	    plan_name: str,
   179	    spec: ChainSpec,
   180	    spec_path: Path,
   181	    milestone_label: str,
   182	) -> None:
   183	    """Record effective chain policy in the plan's ``state.json`` metadata.
   184	
   185	    Reads the plan's state.json, merges ``meta.chain_policy``, and writes
   186	    back atomically.  Does nothing if the plan directory cannot be resolved
   187	    (best-effort, non-critical).
   188	    """
   189	    from arnold_pipelines.megaplan._core import read_json
   190	    from arnold_pipelines.megaplan._core.state import write_plan_state
   191	
   192	    try:
   193	        plan_dir = resolve_plan_dir(root, plan_name)
   194	    except CliError:
   195	        _warn_chain_fallback(
   196	            "M3A_WARN_CHAIN_POLICY_WRITE",
   197	            reason="plan_dir_unavailable",
   198	            context={"plan": plan_name},
   199	        )
   200	        return
   201	    state_path = plan_dir / "state.json"
   202	    if not state_path.exists():
   203	        return
   204	    try:
   205	        state = read_json(state_path)
   206	    except FileNotFoundError:
   207	        return
   208	    except json.JSONDecodeError:
   209	        _warn_chain_fallback(
   210	            "M3A_WARN_CHAIN_META_WRITE",
   211	            reason="corrupt_json",
   212	            path=state_path,
   213	        )
   214	        return
   215	    except (OSError, UnicodeDecodeError):
   216	        _warn_chain_fallback(
   217	            "M3A_WARN_CHAIN_META_WRITE",
   218	            reason="unreadable",
   219	            path=state_path,
   220	        )
   520	        return auto_drive(
   521	            plan,
   522	            cwd=root,
   523	            stall_threshold=spec.stall_threshold,
   524	            max_iterations=spec.max_iterations,
   525	            on_escalate=spec.escalate_action,
   526	            poll_sleep=spec.poll_sleep,
   527	            phase_timeout=spec.phase_timeout,
   528	            status_timeout=spec.status_timeout,
   529	            on_phase_complete=on_phase_complete,
   530	            writer=writer,
   531	        )
   532	    finally:
   533	        try:
   534	            os.chdir(original_cwd)
   535	        except FileNotFoundError:
   536	            pass
   537	        if self_hosted:
   538	            if previous_provider is None:
   539	                os.environ.pop("MEGAPLAN_ENGINE_ISOLATION_PROVIDER", None)
   540	            else:
   541	                os.environ["MEGAPLAN_ENGINE_ISOLATION_PROVIDER"] = previous_provider
   542	

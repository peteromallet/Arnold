    96	def validate_anchor_source(path: Path, *, label: str) -> Path:
    97	    resolved = Path(path).expanduser().resolve()
    98	    if not resolved.is_file():
    99	        raise CliError("missing_anchor_file", f"{label} anchor file not found: {resolved}")
   100	    try:
   101	        resolved.read_text(encoding="utf-8")
   102	    except UnicodeDecodeError as exc:
   103	        raise CliError("invalid_anchor_file", f"{label} anchor file is not valid UTF-8: {resolved}") from exc
   104	    except OSError as exc:
   105	        raise CliError("invalid_anchor_file", f"{label} anchor file is not readable: {resolved}: {exc}") from exc
   106	    return resolved
   107	
   108	
   109	def source_path_for_metadata(source_path: Path, project_root: Path | None = None) -> str:
   110	    resolved = source_path.expanduser().resolve()
   111	    if project_root is not None:
   112	        try:
   113	            return str(resolved.relative_to(project_root.expanduser().resolve()))
   114	        except ValueError:
   115	            pass
   116	    return str(resolved)
   117	
   118	
   119	def extract_anchor_title(text: str, fallback: str) -> str:
   120	    for line in text.splitlines():
   121	        stripped = line.strip()
   122	        if stripped.startswith("# ") and stripped[2:].strip():
   123	            return stripped[2:].strip()
   124	    return fallback
   125	
   126	
   127	def _emit_anchor_event(plan_dir: Path, payload: Mapping[str, Any]) -> None:
   128	    try:
   129	        from arnold_pipelines.megaplan.observability.events import emit
   130	
   131	        emit("anchor_captured", plan_dir=plan_dir, payload=dict(payload))
   132	    except Exception:
   133	        # Observability is best-effort; anchor capture itself is load-bearing.
   134	        return
   135	
   136	
   137	def capture_anchor_document(
   138	    *,
   139	    plan_dir: Path,
   140	    anchor_type: str,
   141	    scope: str,
   142	    source_path: Path,
   143	    source_kind: str,
   144	    label: str | None = None,
   145	    source_spec_path: Path | None = None,
   146	    project_root: Path | None = None,
   147	) -> dict[str, Any]:
   148	    if anchor_type not in SUPPORTED_ANCHOR_TYPES:
   149	        raise CliError("invalid_anchor", f"unsupported anchor type: {anchor_type}")
   150	    if scope not in _SCOPE_FILENAME:
   151	        raise CliError("invalid_anchor", f"unsupported anchor scope: {scope}")
   152	    if source_kind not in {"chain", "milestone", "cli"}:
   153	        raise CliError("invalid_anchor", f"unsupported anchor source_kind: {source_kind}")
   154	    source = validate_anchor_source(source_path, label=f"{scope} {anchor_type}")
   155	    content = source.read_text(encoding="utf-8")
   156	    artifact_rel = Path("anchors") / anchor_type / _SCOPE_FILENAME[scope]
   157	    artifact_path = plan_dir / artifact_rel
   158	    artifact_path.parent.mkdir(parents=True, exist_ok=True)
   159	    if artifact_path.exists():
   160	        raise CliError("duplicate_anchor", f"{anchor_type} already has a captured {scope} anchor")
   161	    artifact_path.write_text(content, encoding="utf-8")
   162	    payload = artifact_path.read_bytes()
   163	    meta: dict[str, Any] = {
   164	        "scope": scope,
   165	        "source_kind": source_kind,
   166	        "source_path": source_path_for_metadata(source, project_root),
   167	        "artifact_path": artifact_rel.as_posix(),
   168	        "title": extract_anchor_title(content, _SCOPE_TITLE[scope]),
   169	        "sha256": hashlib.sha256(payload).hexdigest(),
   170	        "size_bytes": len(payload),
   171	        "captured_at": datetime.now(timezone.utc).isoformat(),
   172	    }
   173	    if label:
   174	        meta["label"] = label
   175	    if source_spec_path is not None:
   176	        meta["source_spec_path"] = source_path_for_metadata(source_spec_path, project_root)
   177	    _emit_anchor_event(
   178	        plan_dir,
   179	        {
   180	            "anchor_type": anchor_type,
   181	            "scope": scope,
   182	            "source_kind": source_kind,
   183	            "source_path": meta["source_path"],
   184	            "artifact_path": meta["artifact_path"],
   185	            "sha256": meta["sha256"],
   186	            "size_bytes": meta["size_bytes"],
   187	        },
   188	    )
   189	    return meta
   190	
   191	
   192	def attach_anchor_documents(
   193	    *,
   194	    plan_dir: Path,
   195	    state: MutableMapping[str, Any],
   196	    documents: Sequence[AnchorCaptureRequest],
   197	    project_root: Path | None = None,
   198	) -> MutableMapping[str, Any]:
   199	    if not documents:
   200	        return state
   201	    meta = state.setdefault("meta", {})
   202	    if not isinstance(meta, MutableMapping):
   203	        state["meta"] = meta = {}
   204	    anchors_meta = meta.setdefault("anchors", {"schema_version": ANCHORS_SCHEMA_VERSION, "by_type": {}})
   205	    if not isinstance(anchors_meta, MutableMapping):
   206	        anchors_meta = {"schema_version": ANCHORS_SCHEMA_VERSION, "by_type": {}}
   207	        meta["anchors"] = anchors_meta
   208	    by_type = anchors_meta.setdefault("by_type", {})
   209	    if not isinstance(by_type, MutableMapping):
   210	        by_type = {}
   211	        anchors_meta["by_type"] = by_type
   212	    existing: dict[str, set[str]] = {}
   213	    for anchor_type, type_meta in list(by_type.items()):
   214	        docs = type_meta.get("documents") if isinstance(type_meta, Mapping) else None
   215	        if isinstance(docs, list):
   216	            existing[str(anchor_type)] = {
   217	                str(doc.get("scope"))
   218	                for doc in docs
   219	                if isinstance(doc, Mapping) and isinstance(doc.get("scope"), str)
   220	            }


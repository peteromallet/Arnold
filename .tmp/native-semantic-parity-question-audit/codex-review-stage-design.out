    36	        projected_signals.pop("debt_overlaps", None)
    37	        projected_signals.pop("escalated_debt_subsystems", None)
    38	        projected_signals.pop("unverifiable_checks", None)
    39	        projected_signals.pop("execution_acceptance_contract", None)
    40	        projected["signals"] = projected_signals
    41	    warnings = gate_signals.get("warnings")
    42	    if isinstance(warnings, list):
    43	        projected["warnings"] = [
    44	            warning
    45	            for warning in warnings
    46	            if not (
    47	                isinstance(warning, str)
    48	                and warning.startswith("Recurring debt detected in subsystem ")
    49	            )
    50	        ]
    51	    return projected

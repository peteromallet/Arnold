     1	"""Gate preflight checks and guidance helpers."""
     2	
     3	from __future__ import annotations
     4	
     5	import os
     6	from pathlib import Path
     7	from typing import Any, Callable
     8	
     9	from arnold_pipelines.megaplan.schemas import GateArtifact, GatePayload
    10	from arnold_pipelines.megaplan.types import GateCheckResult, PlanState
    11	from arnold_pipelines.megaplan._core import latest_plan_meta_path, load_flag_registry, read_json, unresolved_significant_flags
    12	
    13	
    14	AGENT_AVAILABILITY_PREFLIGHT_CHECKS = frozenset({"claude_available", "codex_available"})
    15	OPERATIONAL_UNVERIFIABLE_REASON_MARKERS = (
    16	    "rate limit",
    17	    "rate_limit",
    18	    "quota",
    19	    "capacity",
    20	    "bwrap",
    21	    "bubblewrap",
    22	    "sandbox namespace",
    23	    "no permissions to create new namespace",
    24	    "shell/file access is blocked in this environment",
    25	)
    26	OPERATIONAL_UNVERIFIABLE_CAUSES = frozenset(
    27	    {
    28	        "provider_rate_limit",
    29	        "provider_capacity",
    30	        "sandbox_namespace",
    31	    }
    32	)
    33	OPERATIONAL_UNVERIFIABLE_ERROR_KINDS = frozenset(
    34	    {
    35	        "rate_limit",
    36	        "sandbox_namespace",
    37	    }
    38	)
    39	
    40	
    41	def is_operational_unverifiable_check(check: dict[str, Any]) -> bool:
    42	    """Return true when missing critique evidence is due to transient infrastructure."""
    43	    cause = str(check.get("cause", "")).lower()
    44	    if cause in OPERATIONAL_UNVERIFIABLE_CAUSES:
    45	        return True
    46	    error_kind = str(check.get("error_kind", "")).lower()
    47	    if error_kind in OPERATIONAL_UNVERIFIABLE_ERROR_KINDS:
    48	        return True
    49	    reason = str(check.get("reason", "")).lower()
    50	    return any(marker in reason for marker in OPERATIONAL_UNVERIFIABLE_REASON_MARKERS)
    51	
    52	
    53	def has_high_complexity_unverifiable_checks(signals: dict[str, Any]) -> list[dict[str, Any]]:
    54	    """Return high-complexity unverifiable checks that should block gate PROCEED."""
    55	    unverifiable = signals.get("unverifiable_checks")
    56	    if not isinstance(unverifiable, list):
    57	        return []
    58	    return [
    59	        check
    60	        for check in unverifiable
    61	        if isinstance(check, dict) and check.get("attention") == "high_complexity_unverifiable"
    62	        and not is_operational_unverifiable_check(check)
    63	    ]
    64	
    65	
    66	def run_gate_checks(
    67	    plan_dir: Path,
    68	    state: PlanState,
    69	    *,
    70	    command_lookup: Callable[[str], str | None] | None = None,
    71	) -> GateCheckResult:
    72	    project_dir = Path(state["config"]["project_dir"])
    73	    meta = read_json(latest_plan_meta_path(plan_dir, state))
    74	    flag_registry = load_flag_registry(plan_dir)
    75	    unresolved = unresolved_significant_flags(flag_registry)
    76	    lookup = command_lookup or (lambda name: None)
    77	    configured_agent = state.get("config", {}).get("agent", "")
    78	    checks: dict[str, bool] = {
    79	        "project_dir_exists": project_dir.exists(),
    80	        "project_dir_writable": os.access(project_dir, os.W_OK),
    81	        "success_criteria_present": bool(meta.get("success_criteria")),
    82	    }
    83	    if configured_agent != "hermes":
    84	        checks["claude_available"] = bool(lookup("claude"))
    85	        checks["codex_available"] = bool(lookup("codex"))
    86	    return {
    87	        "passed": all(checks.values()),
    88	        "criteria_check": {
    89	            "count": len(meta.get("success_criteria", [])),
    90	            "items": meta.get("success_criteria", []),
    91	        },
    92	        "preflight_results": checks,
    93	        "unresolved_flags": unresolved,
    94	    }
    95	
    96	
    97	def failed_preflight_checks(preflight_results: dict[str, bool]) -> list[str]:
    98	    return [name for name, passed in preflight_results.items() if not passed]
    99	
   100	
   101	def only_agent_availability_preflight_failed(preflight_results: dict[str, bool]) -> bool:
   102	    failed = set(failed_preflight_checks(preflight_results))
   103	    return bool(failed) and failed <= AGENT_AVAILABILITY_PREFLIGHT_CHECKS
   104	
   105	
   106	def build_gate_artifact(
   107	    signals: dict[str, Any],
   108	    gate_payload: GatePayload,
   109	    *,
   110	    override_forced: bool,
   111	    orchestrator_guidance: str = "",
   112	) -> GateArtifact:
   113	    preflight = signals["preflight_results"]
   114	    recommendation = gate_payload["recommendation"]
   115	    warnings = list(signals.get("warnings", [])) + list(gate_payload.get("warnings", []))
   116	    return {
   117	        "passed": recommendation == "PROCEED" and all(preflight.values()),
   118	        "criteria_check": signals["criteria_check"],
   119	        "preflight_results": preflight,
   120	        "unresolved_flags": signals["unresolved_flags"],
   121	        "addressed_flags": list(signals["signals"].get("addressed_flags", [])),
   122	        "recommendation": recommendation,
   123	        "rationale": gate_payload["rationale"],
   124	        "signals_assessment": gate_payload["signals_assessment"],
   125	        "warnings": warnings,
   126	        "settled_decisions": list(gate_payload.get("settled_decisions", [])),
   127	        "override_forced": override_forced,
   128	        "orchestrator_guidance": orchestrator_guidance,
   129	        "robustness": signals.get("robustness"),
   130	        "signals": signals["signals"],
   131	        "flag_resolutions": list(gate_payload.get("flag_resolutions", [])),
   132	        "resolved_flag_ids": list(gate_payload.get("resolved_flag_ids", [])),
   133	        "resolution_summary": gate_payload.get("resolution_summary", ""),
   134	    }
   135	
   136	
   137	def build_orchestrator_guidance(
   138	    gate_payload: GatePayload,
   139	    signals: dict[str, Any],
   140	    preflight_passed: bool,
   141	    preflight_results: dict[str, bool],
   142	    robustness: str,
   143	    plan_name: str,
   144	    strict_notes: bool = False,
   145	) -> str:
   146	    """Return plain-language next-step guidance for the orchestrator."""
   147	    recommendation = gate_payload["recommendation"]
   148	    iteration = int(signals.get("iteration", 0))
   149	    weighted_score = float(signals.get("weighted_score", 0.0))
   150	    weighted_history = list(signals.get("weighted_history", []))
   151	    recurring_critiques = list(signals.get("recurring_critiques", []))
   152	    unresolved_flags = list(signals.get("unresolved_flags", []))
   153	    scope_creep = list(signals.get("scope_creep_flags", []))
   154	    previous_score = float(weighted_history[-1]) if weighted_history else None
   155	    plateaued = previous_score is not None and weighted_score >= previous_score
   156	    worsening = previous_score is not None and weighted_score > previous_score
   157	    improving = previous_score is not None and weighted_score < previous_score
   158	
   159	    if iteration == 1:
   160	        guidance = f"First iteration; follow gate recommendation: {recommendation}."
   161	    elif recommendation == "PROCEED" and preflight_passed:
   162	        guidance = "Plan passed gate and preflight. Proceed to finalize."
   163	    elif recommendation == "PROCEED":
   164	        failing_checks = ", ".join(
   165	            name for name, passed in preflight_results.items() if not passed
   166	        )
   167	        guidance = f"Gate says PROCEED but preflight blocked. Fix: {failing_checks}."
   168	    elif recommendation == "ESCALATE":
   169	        if strict_notes:
   170	            guidance = (
   171	                "STRICT: gate escalated. Stop and ask the user. "
   172	                "Force-proceed requires --user-approved."
   173	            )
   174	        else:
   175	            guidance = "Gate escalated. Ask the user: force-proceed, add-note, or abort."
   176	    elif recommendation == "ITERATE" and plateaued and recurring_critiques:
   177	        guidance = (
   178	            "Score plateaued with recurring critiques the loop can't fix. Consider "
   179	            f"force-proceeding: `megaplan override force-proceed --plan {plan_name}`"
   180	        )
   181	    elif recommendation == "ITERATE" and improving:
   182	        guidance = f"Score improving ({previous_score} -> {weighted_score}). Continue to revise."
   183	    elif recommendation == "ITERATE" and worsening:
   184	        guidance = (
   185	            f"Score worsening ({previous_score} -> {weighted_score}). "
   186	            "Investigate; the loop may be diverging."
   187	        )
   188	    else:
   189	        guidance = "Gate recommends another iteration. Revise the plan."
   190	
   191	    hints: list[str] = []
   192	    if unresolved_flags:
   193	        hints.append("Verify unresolved flags against the plan and project code before accepting.")
   194	    if recurring_critiques:
   195	        critiques = ", ".join(recurring_critiques)
   196	        hints.append(
   197	            f"Recurring critiques ({critiques}); the loop likely can't fix these, so judge if they are real blockers."
   198	        )
   199	    if scope_creep:
   200	        hints.append("Scope creep detected; compare the current plan against the original idea.")
   201	    if robustness:
   202	        del robustness
   203	
   204	    return " ".join([guidance, *hints]).strip()


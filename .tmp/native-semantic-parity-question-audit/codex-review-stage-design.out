    23	
    24	def _render_open_tickets(state: PlanState, plan_dir: Path) -> str:
    25	    """Return a prompt block listing open tickets for the current repo.
    26	
    27	    Tickets are ranked by **tag overlap** with the idea / goal description
    28	    (not the title), then by ``created_at`` descending.  At most 20 tickets
    29	    are shown.  The planner may **propose** links with
    30	    ``resolves_on_complete=true``, but actual linking happens via the
    31	    explicit ``megaplan ticket link`` CLI — the planner never directly links.
    32	    """
    33	    try:
    34	        from arnold_pipelines.megaplan.tickets import list_tickets as _tickets_list
    35	        from arnold_pipelines.megaplan.tickets.core import _resolve_store, is_cloud_store
    36	
    37	        store = _resolve_store()
    38	        tickets_raw = _tickets_list(
    39	            store=store,
    40	            status="open",
    41	        )
    42	    except Exception:
    43	        return ""
    44	
    45	    if not tickets_raw:
    46	        return ""
    47	
    48	    goal_desc = (state.get("idea") or "").lower()
    49	    goal_words: set[str] = set()
    50	    if goal_desc:
    51	        goal_words = set(goal_desc.split())
    52	
    53	    def _tag_overlap(t: dict) -> int:
    54	        ttags = [tag.lower() for tag in (t.get("tags") or [])]
    55	        if not ttags or not goal_words:
    56	            return 0
    57	        scored = 0
    58	        for tag in ttags:
    59	            tag_parts = set(tag.replace("-", " ").replace("_", " ").split())
    60	            scored += len(tag_parts & goal_words)
    61	        return scored
    62	
    63	    def _created_sort_key(t: dict) -> str:
    64	        return t.get("created_at") or ""
    65	
    66	    ranked = sorted(
    67	        tickets_raw,
    68	        key=lambda t: (-_tag_overlap(t), _created_sort_key(t)),
    69	    )
    70	    ranked = ranked[:20]
    71	
    72	    lines: list[str] = [
    73	        "Open tickets for this repo:",
    74	        "",
    75	    ]
    76	    for t in ranked:
    77	        tid = t.get("id", "?")
    78	        title = t.get("title", "(untitled)")
    79	        tags = ", ".join(t.get("tags") or [])
    80	        lines.append(f"- {tid} — {title}  [{tags}]")
    81	
    82	    lines.append("")
    83	    lines.append(
    84	        "The planner may PROPOSE linking tickets to this plan with "
    85	        "`resolves_on_complete=true` in the plan output, but the actual "
    86	        "linking is performed via the explicit `megaplan ticket link` CLI "
    87	        "after planning — the planner never directly links tickets."
    88	    )
    89	    return "\n".join(lines)
    90	
    91	PLAN_TEMPLATE = textwrap.dedent(
    92	    """
    93	    Plan template — simple format (adapt to the actual repo and scope):
    94	    ````md
    95	    # Implementation Plan: [Title]
    96	
    97	    ## Overview
    98	    Summarize the goal, current repository shape, and the constraints that matter.
    99	
   100	    ## Main Phase
   101	
   102	    ### Step 1: Audit the current behavior (`src/prompts.py`)
   103	    **Scope:** Small
   104	    1. **Inspect** the current implementation and call out the exact insertion points (`src/prompts.py:29`).
   105	
   106	    ### Step 2: Add the first change (`src/evaluation.py`)
   107	    **Scope:** Medium
   108	    1. **Implement** the smallest viable change with exact file references (`src/evaluation.py:1`).
   109	    2. **Capture** any tricky behavior with a short example.
   110	       ```python
   111	       issues = validate_plan_structure(plan_text)
   112	       ```
   113	
   114	    ### Step 3: Wire downstream behavior (`src/handlers.py`, `src/workers.py`)
   115	    **Scope:** Medium
   116	    1. **Update** the runtime flow in the touched files (`src/handlers.py:400`, `src/workers.py:199`).
   117	
   118	    ### Step 4: Prove the change (`tests/test_validator.py`, `tests/test_integration.py`)
   119	    **Scope:** Small
   120	    1. **Run** the cheapest targeted checks first (`tests/test_validator.py:1`).
   121	    2. **Finish** with broader verification once the wiring is in place (`tests/test_integration.py:1`).
   122	
   123	    ## Execution Order
   124	    1. Update prompts and mocks before enforcing stricter validation.
   125	    2. Land higher-risk wiring after the validator and tests are ready.
   126	
   127	    ## Validation Order
   128	    1. Start with focused unit tests.
   129	    2. Run the broader suite after the flow changes are in place.
   130	    ````
   131	
   132	    For complex plans, use multiple phases:
   133	    ````md
   134	    ## Phase 1: Foundation — Dependencies, DB, Types
   135	
   136	    ### Step 1: Install dependencies (`package.json`)
   137	    ...
   138	
   139	    ### Step 2: Create database migration (`supabase/migrations/`)
   140	    ...
   141	
   142	    ## Phase 2: Core Integration
   143	
   144	    ### Step 3: Port the main component (`src/components/`)
   145	    ...
   146	    ````
   147	
   148	    Template guidance:
   149	    - Simple plans: use `## Main Phase` with `### Step N:` sections underneath.
   150	    - Complex plans: use multiple `## Phase N:` sections, each containing `### Step N:` steps. Step numbers are global (not per-phase).
   151	    - The flat `## Step N:` format (without phases) also works for backwards compatibility.
   152	    - Key invariants: one H1 title, one `## Overview`, numbered step sections (`### Step N:` or `## Step N:`), and at least one ordering section.
   153	    """
   154	).strip()

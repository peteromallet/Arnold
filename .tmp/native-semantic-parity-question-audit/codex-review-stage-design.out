    37	def _settled_decisions_block(decisions: list[dict[str, Any]]) -> str:
    38	    if not decisions:
    39	        return ""
    40	    lines = ["Settled tiebreaker decisions (DO NOT re-raise these concerns under a new surface):"]
    41	    for d in decisions:
    42	        gid = d.get("fuzzy_group_id", "?")
    43	        question = d.get("question", "")
    44	        pick = d.get("human_pick", d.get("action", ""))
    45	        rationale = d.get("rationale", "")
    46	        lines.append(f"- {gid}: {question} -> Decision: {pick}. Rationale: {rationale}")
    47	    lines.append(
    48	        "\nOnly raise a new concern about these topics if new evidence *materially* "
    49	        "changes the settled premise — and if so, explicitly cite which settled "
    50	        "decision you are challenging and why."
    51	    )
    52	    return "\n".join(lines)
    53	
    54	
    55	def _plan_version_unified_diff(plan_dir: Path, iteration: int) -> str:
    56	    """Return a unified diff between plan_v{N-1}.md and plan_v{N}.md.
    57	
    58	    Returns an empty string when iteration < 2 or either file is missing.
    59	    """
    60	    if iteration < 2:
    61	        return ""
    62	    prev_path = plan_dir / f"plan_v{iteration - 1}.md"
    63	    curr_path = plan_dir / f"plan_v{iteration}.md"
    64	    if not prev_path.exists() or not curr_path.exists():
    65	        return ""
    66	    prev_lines = prev_path.read_text(encoding="utf-8").splitlines(keepends=True)
    67	    curr_lines = curr_path.read_text(encoding="utf-8").splitlines(keepends=True)
    68	    diff = difflib.unified_diff(
    69	        prev_lines,
    70	        curr_lines,
    71	        fromfile=f"plan_v{iteration - 1}.md",
    72	        tofile=f"plan_v{iteration}.md",
    73	    )
    74	    return "".join(diff)
    75	
    76	
    77	def _build_verification_delta_block(
    78	    delta: dict[str, Any] | None,
    79	    raw_log_path: str | None,
    80	) -> str:
    81	    """Build a bounded ~5000-char mechanical verification block for the revise prompt.
    82	
    83	    *newly_failing* tests get error-type + message (and a traceback snippet when
    84	    the raw log is parseable).  *still_red* is rendered name-only (comma-separated
    85	    nodeids).  The raw log path is NEVER exposed to the LLM.  When *delta* is
    86	    absent or non-computable, returns an empty string.
    87	    """
    88	    if not isinstance(delta, dict):
    89	        return ""
    90	    if not delta.get("computable", True):
    91	        return ""
    92	
    93	    newly_failing: list[str] = delta.get("newly_failing") or []
    94	    still_red: list[str] = delta.get("still_red") or []
    95	
    96	    if not newly_failing and not still_red:
    97	        return ""
    98	
    99	    # Extract failure details for newly_failing tests from the raw log
   100	    failure_details: dict[str, dict[str, str]] = {}
   101	    if newly_failing and raw_log_path:
   102	        try:
   103	            from arnold_pipelines.megaplan.orchestration.suite_runner import extract_failure_details
   104	            details = extract_failure_details(Path(raw_log_path), newly_failing)
   105	            failure_details = {d["nodeid"]: d for d in details}
   106	        except Exception:
   107	            pass
   108	
   109	    lines: list[str] = []
   110	    lines.append(
   111	        "Mechanical post-execute verification \u2014 fix these new regressions; "
   112	        "do NOT scope-creep into still_red."
   113	    )
   114	    lines.append("")
   115	
   116	    CHAR_BUDGET = 5000
   117	
   118	    def _current_len() -> int:
   119	        return len("\n".join(lines))
   120	
   121	    # --- newly_failing section -------------------------------------------
   122	    if newly_failing:
   123	        header = f"Newly failing tests ({len(newly_failing)}):"
   124	        if _current_len() + len(header) + 2 <= CHAR_BUDGET:
   125	            lines.append(header)
   126	        else:
   127	            return "\n".join(lines)
   128	
   129	        for i, nid in enumerate(newly_failing):
   130	            fd = failure_details.get(nid, {})
   131	            err_type = fd.get("error_type", "<unknown>")
   132	            msg = fd.get("message", "<unparsed>")
   133	            tb_head = fd.get("traceback_head", "")
   134	
   135	            entry_lines = [f"  {nid} \u2014 {err_type}: {msg}"]
   136	            if tb_head and tb_head != "<could not extract>":
   137	                tb_first = tb_head.split("\n")[0][:200]
   138	                entry_lines.append(f"    Traceback: {tb_first}")
   139	
   140	            candidate = "\n".join(lines + entry_lines)
   141	            if len(candidate) > CHAR_BUDGET - 50:
   142	                remaining = len(newly_failing) - i
   143	                lines.append(f"  \u2026[{remaining} more]")
   144	                break
   145	            lines.extend(entry_lines)
   146	
   147	    # --- still_red section (name-only) -----------------------------------
   148	    if still_red:
   149	        max_names = 20
   150	        names = ", ".join(still_red[:max_names])
   151	        if len(still_red) > max_names:
   152	            names += f" \u2026[{len(still_red) - max_names} more]"
   153	        sr_line = (
   154	            f"\nPre-existing failures (still red \u2014 do NOT fix): {names}"
   155	        )
   156	        if _current_len() + len(sr_line) <= CHAR_BUDGET:
   157	            lines.append(sr_line.strip())
   158	
   159	    return "\n".join(lines)
   160	
   161	
   162	def _revise_prompt(state: PlanState, plan_dir: Path) -> str:
   163	    project_dir = Path(state["config"]["project_dir"])
   164	    latest_plan = latest_plan_path(plan_dir, state).read_text(encoding="utf-8")
   165	    latest_meta = read_json(latest_plan_meta_path(plan_dir, state))
   166	    gate = read_json(plan_dir / "gate.json")
   167	    unresolved = unresolved_significant_flags(load_flag_registry(plan_dir))
   168	    open_flags = [
   169	        {
   170	            "id": flag["id"],
   171	            "severity": flag.get("severity"),
   172	            "status": flag["status"],
   173	            "concern": flag["concern"],
   174	            "evidence": flag.get("evidence"),
   175	        }
   176	        for flag in unresolved
   177	    ]
   178	    settled_decisions: list[dict[str, Any]] = []
   179	    decisions_path = plan_dir / "tiebreaker_decisions.json"
   180	    if decisions_path.exists():
   181	        decisions_data = read_json(decisions_path)
   182	        if isinstance(decisions_data, list):
   183	            settled_decisions = decisions_data
   184	        elif isinstance(decisions_data, dict):
   185	            settled_decisions = decisions_data.get("decisions", [])
   186	    settled_block = _settled_decisions_block(settled_decisions)
   187	
   188	    # Build the mechanical verification delta block from the completion
   189	    # verdict (if present).  The raw log path is used internally for
   190	    # failure-detail parsing but NEVER surfaced to the LLM.
   191	    ctx = _critique_context(state, plan_dir)
   192	    delta_block = _build_verification_delta_block(
   193	        ctx.get("verification_delta"),
   194	        ctx.get("verification_raw_log_path"),
   195	    )
   196	
   197	    return textwrap.dedent(
   198	        f"""
   199	        You are revising an implementation plan after critique and gate feedback.
   200	
   201	        Project directory:
   202	        {project_dir}
   203	
   204	        {intent_brief_reference(state)}
   205	
   206	        Current plan (markdown):
   207	        {latest_plan}
   208	
   209	        Current plan metadata:
   210	        {json_dump(latest_meta).strip()}
   211	
   212	        Gate summary:
   213	        {json_dump(gate).strip()}
   214	
   215	        Open significant flags:
   216	        {json_dump(open_flags).strip()}
   217	
   218	        {settled_block}
   219	
   220	        {delta_block}


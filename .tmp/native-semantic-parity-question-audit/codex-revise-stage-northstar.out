   413	
   414	def _critique_no_progress_streak(
   415	    state: PlanState,
   416	    gate_summary: dict[str, Any],
   417	    plan_dir: Path,
   418	) -> int:
   419	    """Update and return the consecutive no-net-progress round streak.
   420	
   421	    A round counts as "no progress" when ``resolved_delta == 0`` (no prior
   422	    blocking flag closed this round) AND ``new_blocking >= 1`` (at least one
   423	    fresh blocking flag appeared) — the loop is treading water. The streak is
   424	    persisted on ``state['meta']`` so two consecutive stalled rounds can trip
   425	    the same severity-gated branch as the hard cap (mirrors the advisory
   426	    plateau hint in build_orchestrator_guidance, now enforced).
   427	
   428	    P4 — replay/resume consistency. ``_prior_iterate_rounds`` is history-based
   429	    (one entry per completed gate→revise round) while this streak is computed
   430	    from the per-iteration ``gate_signals`` files. To keep the two counters
   431	    from diverging when ``_build_gate_route_signal`` runs more than once for the same
   432	    ``state['iteration']`` (the reprompt path calls it twice; a resumed gate
   433	    re-runs the whole handler), the streak is updated AT MOST ONCE per
   434	    iteration. We stamp ``critique_no_progress_iteration`` with the iteration we
   435	    last counted; a repeat call at the same iteration returns the already-stored
   436	    streak without re-incrementing. Each real round bumps ``state['iteration']``
   437	    (a new revise/critique pass), so genuine rounds still advance the streak.
   438	    """
   439	    iteration = int(state.get("iteration", 0) or 0)
   440	    meta = state.setdefault("meta", {})
   441	    streak = int(meta.get("critique_no_progress_streak", 0) or 0)
   442	    # Idempotent per iteration: do not re-count a round we have already scored.
   443	    if int(meta.get("critique_no_progress_iteration", -1) or -1) == iteration:
   444	        return streak
   445	    # "Blocking" for the progress metric is the full open-flag set the gate
   446	    # tracks (gate_summary["unresolved_flags"], i.e. open significant flags),
   447	    # symmetric with the prior round read from gate_signals_v{n-1}.json. The
   448	    # narrower correctness/security predicate is only the termination *switch*.
   449	    new_blocking_ids = {
   450	        f.get("id")
   451	        for f in gate_summary.get("unresolved_flags", [])
   452	        if isinstance(f, dict) and f.get("id") and f.get("status") in FLAG_BLOCKING_STATUSES
   453	    }
   454	    prior_ids = _prior_unresolved_flag_ids(plan_dir, iteration)
   455	    resolved_delta = len(prior_ids - new_blocking_ids)
   456	    new_blocking = len(new_blocking_ids - prior_ids)
   457	    if resolved_delta == 0 and new_blocking >= 1:
   458	        streak += 1
   459	    else:
   460	        streak = 0
   461	    meta["critique_no_progress_streak"] = streak
   462	    meta["critique_no_progress_iteration"] = iteration
   463	    return streak
   464	
   465	
   466	def _critique_terminate_branch(
   467	    state: PlanState,
   468	    gate_summary: dict[str, Any],
   469	    reason: str,
   470	) -> dict[str, Any]:
   471	    """Severity-gated termination shared by the hard cap and the stall stop.
   472	
   473	    The auto/chain loop is STATUS-DRIVEN: ``auto.drive`` re-derives the next
   474	    step from STATE via ``workflow_next``, IGNORING this handler's returned
   475	    ``next_step``. So termination MUST be expressed in state, not just the
   476	    return tuple, or the loop re-derives ``revise`` and spins forever (P0).
   477	
   478	    - Open correctness/security flag → set ``current_state = STATE_BLOCKED``.
   479	      STATE_BLOCKED has no WORKFLOW transitions, so ``workflow_next`` yields []
   480	      (no "revise"), it is a TERMINAL/AUTOMATION_TERMINAL state, and the chain
   481	      treats a "blocked" outcome under ``on_failure`` (default stop_chain) — NOT
   482	      ``on_escalate``'s force-proceed default — so a blocked plan halts for the
   483	      human (P1). This also sidesteps the soft-escalate-then-force-proceed gap.
   484	    - Cosmetic-only open flags → set ``current_state = STATE_GATED`` so
   485	      ``workflow_next`` yields "finalize" (mirrors the review-loop force-proceed
   486	      at review.py:248-252). VERIFIED via workflow_data.py STATE_GATED→finalize.
   487	    """
   488	    open_critical = _open_blocking_flags(gate_summary)
   489	    if open_critical:
   490	        state["current_state"] = STATE_BLOCKED
   491	        summary = (
   492	            f"{reason} with {len(open_critical)} unresolved correctness/security "
   493	            "flag(s). Plan BLOCKED for human review — the critique loop will not "
   494	            "ship an unresolved correctness/security concern."
   495	        )
   496	        return {
   497	            "result": "blocked",
   498	            "route_signal": "escalate",
   499	            "summary": summary,
   500	            "blocking_unresolved_ids": [],
   501	            "fallback_payload": {
   502	                "kind": "critique_cap",
   503	                "reason": "correctness_or_security_flags",
   504	            },
   505	        }
   506	    state["current_state"] = STATE_GATED
   507	    summary = (
   508	        f"{reason}. Force-proceeding to finalize despite remaining cosmetic flags "
   509	        "(deferred and recorded for audit)."
   510	    )
   511	    return {
   512	        "result": "blocked",
   513	        "route_signal": "force_proceed",
   514	        "summary": summary,
   515	        "blocking_unresolved_ids": [],
   516	        "fallback_payload": {
   517	            "kind": "critique_cap",
   518	            "reason": "cosmetic_flags_only",
   519	        },
   520	    }

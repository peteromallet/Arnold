   163	    project_dir = Path(state["config"]["project_dir"])
   164	    latest_plan = latest_plan_path(plan_dir, state).read_text(encoding="utf-8")
   165	    latest_meta = read_json(latest_plan_meta_path(plan_dir, state))
   166	    gate = read_json(plan_dir / "gate.json")
   167	    unresolved = unresolved_significant_flags(load_flag_registry(plan_dir))
   168	    open_flags = [
   169	        {
   170	            "id": flag["id"],
   171	            "severity": flag.get("severity"),
   172	            "status": flag["status"],
   173	            "concern": flag["concern"],
   174	            "evidence": flag.get("evidence"),
   175	        }
   176	        for flag in unresolved
   177	    ]
   178	    settled_decisions: list[dict[str, Any]] = []
   179	    decisions_path = plan_dir / "tiebreaker_decisions.json"
   180	    if decisions_path.exists():
   181	        decisions_data = read_json(decisions_path)
   182	        if isinstance(decisions_data, list):
   183	            settled_decisions = decisions_data
   184	        elif isinstance(decisions_data, dict):
   185	            settled_decisions = decisions_data.get("decisions", [])
   186	    settled_block = _settled_decisions_block(settled_decisions)
   187	
   188	    # Build the mechanical verification delta block from the completion
   189	    # verdict (if present).  The raw log path is used internally for
   190	    # failure-detail parsing but NEVER surfaced to the LLM.
   191	    ctx = _critique_context(state, plan_dir)
   192	    delta_block = _build_verification_delta_block(
   193	        ctx.get("verification_delta"),
   194	        ctx.get("verification_raw_log_path"),
   195	    )
   196	
   197	    return textwrap.dedent(
   198	        f"""
   199	        You are revising an implementation plan after critique and gate feedback.
   200	
   201	        Project directory:
   202	        {project_dir}
   203	
   204	        {intent_brief_reference(state)}
   205	
   206	        Current plan (markdown):
   207	        {latest_plan}
   208	
   209	        Current plan metadata:
   210	        {json_dump(latest_meta).strip()}
   211	
   212	        Gate summary:
   213	        {json_dump(gate).strip()}
   214	
   215	        Open significant flags:
   216	        {json_dump(open_flags).strip()}
   217	
   218	        {settled_block}
   219	
   220	        {delta_block}
   221	
   222	        Requirements:
   223	        - Before addressing individual flags, check: does any flag suggest the plan is targeting the wrong code or the wrong root cause? If so, consider whether the plan needs a new approach rather than adjustments. Explain your reasoning.
   224	        - Update the plan to address the significant issues.
   225	        - Keep the plan readable and executable.
   226	        - Return flags_addressed with the exact flag IDs you addressed or rejected. For each flag, include:
   227	          - `id`: the flag ID
   228	          - `resolution`: `"addressed"` (you incorporated the fix) or `"rejected"` (the flag is invalid or out of scope)
   229	          - `reason`: a concise explanation of what was changed or why the flag was rejected
   230	          - `where`: a pointer to the plan section / files the change or claim points at (e.g., "Phase 2 — Step 3", "README.md §API")
   231	        - Include `changes_summary` as a short plain-English summary of what changed in the revision. If there were no concrete flags, say that explicitly (for example: `No critique flags were raised; refined wording and kept the plan aligned for execution.`).
   232	        - Preserve or improve success criteria quality. Each criterion must have a `priority` of `must`, `should`, or `info`. Promote or demote priorities if critique feedback reveals a criterion was over- or under-weighted.
   233	        - Each success criterion should include a `requires` field listing the capabilities needed for verification. Valid capability strings: `run_shell`, `read_files`, `run_tests`, `parse_diff`, `read_build_output`, `run_linter` (container), `drive_browser`, `inspect_runtime_ui`, `observe_runtime_logs`, `subjective_judgment`, `verify_physical_device` (human). `must` criteria MUST have non-empty `requires`. Example: `{{"criterion": "All tests pass", "priority": "must", "requires": ["run_tests"]}}`.
   234	        - For code-mode plans with any `run_tests` success criterion, include or preserve a machine-readable `test_blast_radius` object in the structured output. Use this shape: `{{"strategy":"scoped","confidence":"high","selectors":[{{"kind":"path","value":"tests/test_relevant.py","reason":"covers the changed surface"}}],"changed_surfaces":["src/relevant.py"],"always_run":[],"full_suite_fallback":true,"rationale":"Why these tests cover the planned changes."}}`. If finalize feedback says scoped baseline metadata was missing, the revision must add this object rather than only adding prose validation commands.
   235	        - Verify that the plan remains aligned with the user's original intent, not just internal plan quality.
   236	        - Remove unjustified scope growth. If critique raised scope creep, narrow the plan back to the original idea unless the broader work is strictly required.
   237	        - Maintain the structural template: H1 title, ## Overview, phase sections with numbered step sections, ## Execution Order or ## Validation Order.
   238	        - CRITICAL: Your entire revised plan markdown (all sections) must be output as the `plan` field in the structured output. The prose response must not contain the plan text.
   239	        - CRITICAL: Return only the structured JSON object for the schema fields `plan`, `changes_summary`, `flags_addressed`, `assumptions`, `success_criteria`, `questions`, and optional `changed_surfaces` / `test_blast_radius`. Do not add commentary before or after the JSON object.
   240	        - Populate `changed_surfaces` with every concrete file path your revised plan will change or create. Include both source files and test files. Use repo-relative paths. This list drives the deterministic test-selection blast radius; be complete. If your revised plan touches a file, list it.
   241	        - (Optional) Populate `test_blast_radius` with your own scoped test-selection proposal. This complements the deterministic floor the system computes from `changed_surfaces`. Provide `strategy` ("scoped", "full", or "none"), `selectors` (array of `{{"kind": "path", "value": "<path>", "reason": "<why>"}}` objects), and a `rationale` string. The system merges your proposal with the deterministic floor and the prior plan's blast radius; you cannot narrow below the floor, but you can widen with additional selectors or escalate to full. If you intend a scoped finalize baseline while keeping the full suite as a hard gate, set `strategy` to "scoped", include concrete `selectors`, and set `full_suite_fallback` to true; the floor's full-suite requirement will be honored by the fallback without forcing the baseline strategy to "full".
   242	
   243	        """
   244	    ).strip()
   245	
   246	
   247	def _critique_context(state: PlanState, plan_dir: Path, root: Path | None = None) -> dict[str, Any]:
   248	    project_dir = Path(state["config"]["project_dir"])
   249	    latest_plan = latest_plan_path(plan_dir, state).read_text(encoding="utf-8")
   250	    latest_meta = read_json(latest_plan_meta_path(plan_dir, state))
   251	    structure_warnings = latest_meta.get("structure_warnings", [])
   252	    flag_registry = load_flag_registry(plan_dir)
   253	    unresolved = [
   254	        {
   255	            "id": flag["id"],
   256	            "concern": flag["concern"],
   257	            "status": flag["status"],
   258	            "severity": flag.get("severity"),
   259	        }
   260	        for flag in flag_registry["flags"]


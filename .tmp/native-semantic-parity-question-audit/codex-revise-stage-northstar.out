   324	
   325	def _critique_cap_key(robustness: str) -> str:
   326	    """Select the robustness-scoped critique-iteration cap key.
   327	
   328	    Mirrors the review-loop cap selection (review.py): thorough/extreme pick
   329	    up the higher robust cap, everything else the default cap.
   330	    """
   331	    return (
   332	        "max_robust_critique_iterations"
   333	        if robustness in {"thorough", "extreme"}
   334	        else "max_critique_iterations"
   335	    )
   336	
   337	
   338	# light revises straight to GATED (workflow_data.py:103-105); keep its critique
   339	# loop cheap by capping at 2 regardless of the configured max_critique_iterations,
   340	# which is sized for the full/default path. bare has no revise edge so its ITERATE
   341	# branch is unreachable and needs no cap (workflow_data.py:108-112).
   342	_LIGHT_CRITIQUE_CAP = 2
   343	
   344	
   345	def _effective_critique_cap(robustness: str) -> int:
   346	    """Resolve the effective ITERATE-round cap for ``robustness``.
   347	
   348	    Reads the robustness-scoped DEFAULTS/config key, then applies the light
   349	    override (light caps at 2, below the full default of 4). bare never reaches
   350	    the cap because it has no revise edge.
   351	    """
   352	    cap = int(get_effective("execution", _critique_cap_key(robustness)))
   353	    if robustness == "light":
   354	        return min(cap, _LIGHT_CRITIQUE_CAP)
   355	    return cap
   356	
   357	
   358	def _prior_iterate_rounds(state: PlanState) -> int:
   359	    """Count completed critique→gate→revise ITERATE rounds in history.
   360	
   361	    The current gate pass is not yet recorded in history when
   362	    ``_build_gate_route_signal`` runs, so this counts only *prior* rounds — the
   363	    same convention as ``prior_rework_count`` in the review handler.
   364	    """
   365	    return sum(
   366	        1
   367	        for entry in state.get("history", [])
   368	        if entry.get("step") == "gate" and entry.get("recommendation") == "ITERATE"
   369	    )
   370	
   371	
   372	# Severities that are unambiguously cosmetic — safe to defer at the cap.
   373	_COSMETIC_SEVERITIES = frozenset({"minor", "likely-minor", "trivial", "cosmetic", "low", "nit"})
   374	# Categories that carry correctness/security risk — a blocking flag in one of
   375	# these escalates at the cap even at moderate severity (P2).
   376	_CRITICAL_CATEGORIES = frozenset({"correctness", "security"})
   377	
   378	
   379	def _is_cap_blocking_flag(flag: dict[str, Any]) -> bool:
   380	    """Whether ``flag`` must force ESCALATE (not force-proceed) at the cap.
   381	
   382	    Broader than the PROCEED-path predicate ON PURPOSE and scoped to the
   383	    cap-termination decision only (P2): a blocking flag escalates if it is
   384	    severity-significant OR it is a correctness/security-category flag at any
   385	    severity that is not explicitly cosmetic. So a blocking *moderate*
   386	    correctness flag escalates rather than being shipped as "cosmetic".
   387	    """
   388	    if flag.get("status") not in FLAG_BLOCKING_STATUSES:
   389	        return False
   390	    severity = flag.get("severity")
   391	    if severity in ("significant", "likely-significant"):
   392	        return True
   393	    if severity in _COSMETIC_SEVERITIES:
   394	        return False
   395	    # Non-cosmetic, non-significant (e.g. "moderate"/"uncertain"/unset):
   396	    # escalate when the flag is correctness/security in nature.
   397	    return flag.get("category") in _CRITICAL_CATEGORIES
   398	
   399	
   400	def _open_blocking_flags(gate_summary: dict[str, Any]) -> list[dict[str, Any]]:
   401	    """Open flags that must force ESCALATE at the critique cap/stall.
   402	
   403	    See ``_is_cap_blocking_flag``: significant-or-worse, or any blocking
   404	    correctness/security flag at a non-cosmetic severity. Scoped to the
   405	    cap-termination switch only; the PROCEED-path predicate is unchanged.
   406	    """
   407	    return [
   408	        f
   409	        for f in gate_summary.get("unresolved_flags", [])
   410	        if isinstance(f, dict) and _is_cap_blocking_flag(f)
   411	    ]

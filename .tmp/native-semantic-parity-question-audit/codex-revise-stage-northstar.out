   135	def _build_critique_evaluator_schema() -> dict[str, Any]:
   136	    """Single source of truth for stored critique-evaluator artifacts.
   137	
   138	    This schema must remain compatible with:
   139	    - legacy stored selections routed by `critic_model`
   140	    - current catalog selections routed by `complexity`
   141	    - current additive `"other"` custom-area selections
   142	    """
   143	    check_ids = CRITIQUE_EVALUATOR_CHECK_IDS
   144	    selectable_check_ids = [*check_ids, "other"]
   145	
   146	    legacy_selection_schema = {
   147	        "x-preserve-explicit-required": True,
   148	        "type": "object",
   149	        "properties": {
   150	            "check_id": {"type": "string", "enum": selectable_check_ids},
   151	            "critic_model": {"type": "string"},
   152	            "why": {"type": "string"},
   153	            "area": {"type": "string"},
   154	        },
   155	        "required": ["check_id", "critic_model", "why"],
   156	        "additionalProperties": False,
   157	    }
   158	    catalog_selection_schema = {
   159	        "x-preserve-explicit-required": True,
   160	        "type": "object",
   161	        "properties": {
   162	            "check_id": {"type": "string", "enum": check_ids},
   163	            "complexity": {"type": "integer"},
   164	            "complexity_justification": {"type": "string"},
   165	            "area": {"type": "string"},
   166	        },
   167	        "required": ["check_id", "complexity", "complexity_justification"],
   168	        "additionalProperties": False,
   169	    }
   170	    other_selection_schema = {
   171	        "x-preserve-explicit-required": True,
   172	        "type": "object",
   173	        "properties": {
   174	            "check_id": {"type": "string", "const": "other"},
   175	            "area": {"type": "string"},
   176	            "why": {"type": "string"},
   177	            "complexity": {"type": "integer"},
   178	            "complexity_justification": {"type": "string"},
   179	        },
   180	        "required": [
   181	            "check_id",
   182	            "area",
   183	            "why",
   184	            "complexity",
   185	            "complexity_justification",
   186	        ],
   187	        "additionalProperties": False,
   188	    }
   189	    return {
   190	        "x-preserve-explicit-required": True,
   191	        "type": "object",
   192	        "properties": {
   193	            "selections": {
   194	                "type": "array",
   195	                "items": {
   196	                    "oneOf": [
   197	                        legacy_selection_schema,
   198	                        catalog_selection_schema,
   199	                        other_selection_schema,
   200	                    ]
   201	                },
   202	            },
   203	            "skipped": {
   204	                "type": "array",
   205	                "items": {
   206	                    "type": "object",
   207	                    "properties": {
   208	                        "check_id": {"type": "string", "enum": check_ids},
   209	                        "why": {"type": "string"},
   210	                    },
   211	                    "required": ["check_id", "why"],
   212	                    "additionalProperties": False,
   213	                },
   214	            },
   215	            "evaluator_model": {"type": "string"},
   216	            "flag_verifications": {
   217	                "type": "array",
   218	                "items": {
   219	                    "type": "object",
   220	                    "properties": {
   221	                        "flag_id": {"type": "string"},
   222	                        "lens": {"type": "string"},
   223	                        "outcome": {
   224	                            "type": "string",
   225	                            "enum": ["verified", "open", "accepted_tradeoff"],
   226	                        },
   227	                        "rationale": {"type": "string"},
   228	                    },
   229	                    "required": ["flag_id", "lens", "outcome", "rationale"],
   230	                    "additionalProperties": False,
   231	                },
   232	            },
   233	        },
   234	        "required": ["selections", "skipped", "evaluator_model"],
   235	        "additionalProperties": False,

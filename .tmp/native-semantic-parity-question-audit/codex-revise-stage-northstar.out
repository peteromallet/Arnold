   154	def _resolve_revise_transition(state: PlanState, plan_dir: Path) -> tuple[bool, Any]:
   155	    has_gate = workflow_includes_step(configured_robustness(state), "gate")
   156	    gate_summary = _gate_summary_for_transition(plan_dir, state)
   157	    recommendation = gate_summary.get("recommendation") or gate_summary.get("verdict")
   158	    if has_gate and recommendation != "ITERATE":
   159	        raise CliError("invalid_transition", "Revise requires a gate recommendation of ITERATE", valid_next=infer_next_steps(state))
   160	    revise_transition = workflow_transition(state, "revise")
   161	    if revise_transition is None:
   162	        raise CliError("invalid_transition", "Revise is not available from the current workflow state", valid_next=infer_next_steps(state))
   163	    return has_gate, revise_transition

   813	def _normalize_gate_payload(
   814	    gate_payload: dict[str, Any],
   815	    signals_artifact: dict[str, Any],
   816	) -> dict[str, Any]:
   817	    """Recover from an empty or structurally invalid gate worker payload.
   818	
   819	    Some worker/model combinations (notably DeepSeek via Hermes for the gate
   820	    phase) occasionally emit empty recommendation/rationale fields even when
   821	    the surrounding signals make the correct verdict obvious. Rather than
   822	    failing the whole gate, infer a conservative recommendation from the
   823	    computed signals and log a warning so the audit trail remains honest.
   824	    """
   825	    recommendation = str(gate_payload.get("recommendation", "")).strip().upper()
   826	    if recommendation not in _GATE_RECOMMENDATIONS:
   827	        original = gate_payload.get("recommendation")
   828	        preflight = signals_artifact.get("preflight_results", {})
   829	        preflight_passed = isinstance(preflight, dict) and all(preflight.values())
   830	        unresolved = signals_artifact.get("unresolved_flags", [])
   831	        has_significant = bool(
   832	            isinstance(unresolved, list)
   833	            and any(
   834	                isinstance(f, dict)
   835	                and f.get("severity") in ("significant", "likely-significant")
   836	                for f in unresolved
   837	            )
   838	        )
   839	        if has_significant:
   840	            recommendation = "ITERATE"
   841	            reason = "significant unresolved flags remain"
   842	        elif not preflight_passed:
   843	            recommendation = "ESCALATE"
   844	            reason = "preflight checks are still failing"
   845	        else:
   846	            recommendation = "PROCEED"
   847	            reason = "no significant unresolved flags and preflight passed"
   848	        log.warning(
   849	            "Gate worker emitted invalid/empty recommendation %r; falling back to %s (%s)",
   850	            original,
   851	            recommendation,
   852	            reason,
   853	        )
   854	        gate_payload["recommendation"] = recommendation
   855	        if not str(gate_payload.get("rationale", "")).strip():
   856	            gate_payload["rationale"] = (
   857	                f"Auto-inferred {recommendation} because the gate worker returned an "
   858	                f"invalid/empty recommendation and {reason}."
   859	            )
   860	        if not str(gate_payload.get("signals_assessment", "")).strip():
   861	            gate_payload["signals_assessment"] = (
   862	                "No significant flags were raised by critique; proceeding to execution."
   863	                if recommendation == "PROCEED"
   864	                else "Critique signals require further attention before proceeding."
   865	            )
   866	
   867	    # Ensure required array fields exist so later schema validation passes.
   868	    gate_payload.setdefault("warnings", [])
   869	    gate_payload.setdefault("settled_decisions", [])
   870	    gate_payload.setdefault("flag_resolutions", [])
   871	    gate_payload.setdefault("accepted_tradeoffs", [])
   872	    # Strip placeholder/empty tradeoff objects emitted by some workers.
   873	    gate_payload["accepted_tradeoffs"] = [
   874	        item
   875	        for item in gate_payload["accepted_tradeoffs"]
   876	        if isinstance(item, dict)
   877	        and any(
   878	            str(value).strip()
   879	            for key, value in item.items()
   880	            if key in {"flag_id", "concern", "subsystem", "rationale"}
   881	        )
   882	    ]
   883	    return gate_payload

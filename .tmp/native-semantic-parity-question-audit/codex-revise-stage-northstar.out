   270	def _build_gate_carry(gate_summary: dict[str, Any], *, iteration: int) -> dict[str, Any]:
   271	    unresolved_by_id = {
   272	        item.get("id"): item
   273	        for item in gate_summary.get("unresolved_flags", [])
   274	        if isinstance(item, dict) and isinstance(item.get("id"), str)
   275	    }
   276	    carried_flags: list[dict[str, str]] = []
   277	    for resolution in gate_summary.get("flag_resolutions", []):
   278	        if not isinstance(resolution, dict) or resolution.get("action") != "accept_tradeoff":
   279	            continue
   280	        flag_id = resolution.get("flag_id")
   281	        if not isinstance(flag_id, str) or not flag_id:
   282	            continue
   283	        flag = unresolved_by_id.get(flag_id, {})
   284	        concern = flag.get("concern", "") if isinstance(flag, dict) else ""
   285	        carried_flags.append(
   286	            {
   287	                "flag_id": flag_id,
   288	                "concern_brief": _brief_text(concern, sentences=1, max_chars=240),
   289	                "rationale_brief": _brief_text(resolution.get("rationale", ""), sentences=2, max_chars=360),
   290	            }
   291	        )
   292	    recommendation = str(gate_summary.get("recommendation", "PROCEED"))
   293	    return {
   294	        "version": 1,
   295	        "recommendation": recommendation,
   296	        "passed": bool(gate_summary.get("passed", False)),
   297	        "rationale_brief": _brief_text(gate_summary.get("rationale", ""), sentences=3),
   298	        "settled_decisions": _normalize_settled_decisions(gate_summary),
   299	        "warnings": list(gate_summary.get("warnings", [])) if isinstance(gate_summary.get("warnings"), list) else [],
   300	        "orchestrator_guidance": str(gate_summary.get("orchestrator_guidance", "")),
   301	        "carried_flags": carried_flags,
   302	        "iteration": iteration,
   303	        "produced_at": now_utc(),
   304	    }
   305	

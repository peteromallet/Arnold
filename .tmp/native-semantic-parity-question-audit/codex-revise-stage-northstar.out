   220	def _brief_text(value: object, *, sentences: int = 3, max_chars: int = 600) -> str:
   221	    text = str(value or "").strip()
   222	    if not text:
   223	        return ""
   224	    parts = re.split(r"(?<=[.!?])\s+", text)
   225	    brief = " ".join(part for part in parts[:sentences] if part).strip()
   226	    if len(brief) <= max_chars:
   227	        return brief
   228	    return brief[: max_chars - 1].rstrip() + "..."

   714	def _merge_gate_worker_attempt(base: WorkerResult, retry: WorkerResult) -> WorkerResult:
   715	    base.payload = retry.payload
   716	    base.raw_output = "\n\n".join(part for part in [base.raw_output, retry.raw_output] if part)
   717	    if base.trace_output or retry.trace_output:
   718	        base.trace_output = "\n\n".join(part for part in [base.trace_output, retry.trace_output] if part)
   719	    base.duration_ms += retry.duration_ms
   720	    base.cost_usd += retry.cost_usd
   721	    base.session_id = retry.session_id or base.session_id
   722	    base.prompt_tokens += retry.prompt_tokens
   723	    base.completion_tokens += retry.completion_tokens
   724	    base.total_tokens += retry.total_tokens
   725	    base.rate_limit = prefer_retry_rate_limit(base.rate_limit, retry.rate_limit)
   726	    return base

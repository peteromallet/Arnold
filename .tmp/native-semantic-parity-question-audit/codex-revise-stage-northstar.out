   728	def _merge_resolution_tradeoffs_into_payload(gate_summary: dict[str, Any], worker_payload: dict[str, Any]) -> None:
   729	    raw_tradeoffs = worker_payload.get("accepted_tradeoffs", [])
   730	    merged_tradeoffs = list(raw_tradeoffs) if isinstance(raw_tradeoffs, list) else []
   731	    existing_ids = {
   732	        item.get("flag_id")
   733	        for item in merged_tradeoffs
   734	        if isinstance(item, dict) and isinstance(item.get("flag_id"), str)
   735	    }
   736	    unresolved_by_id = {
   737	        flag.get("id"): flag
   738	        for flag in gate_summary.get("unresolved_flags", [])
   739	        if isinstance(flag, dict) and isinstance(flag.get("id"), str)
   740	    }
   741	    for resolution in gate_summary.get("flag_resolutions", []):
   742	        if not isinstance(resolution, dict) or resolution.get("action") != "accept_tradeoff":
   743	            continue
   744	        flag_id = resolution.get("flag_id")
   745	        if not isinstance(flag_id, str) or flag_id in existing_ids:
   746	            continue
   747	        flag = unresolved_by_id.get(flag_id)
   748	        if not isinstance(flag, dict):
   749	            continue
   750	        concern = flag.get("concern")
   751	        if not isinstance(concern, str):
   752	            continue
   753	        tradeoff = {"flag_id": flag_id, "concern": concern}
   754	        subsystem = flag.get("subsystem")
   755	        if isinstance(subsystem, str) and subsystem.strip():
   756	            tradeoff["subsystem"] = subsystem
   757	        merged_tradeoffs.append(tradeoff)
   758	        existing_ids.add(flag_id)
   759	    worker_payload["accepted_tradeoffs"] = merged_tradeoffs

   128	def _project_review_evidence_for_prompt(review_evidence: dict[str, Any]) -> dict[str, Any]:
   129	    projected: dict[str, Any] = {
   130	        "projection": "bounded_prompt_summary",
   131	        "full_artifact": REVIEW_EVIDENCE_FILENAME,
   132	    }
   133	    for key in (
   134	        "schema",
   135	        "schema_version",
   136	        "evidence_contract_version",
   137	        "mode",
   138	        "subject",
   139	        "accepted",
   140	        "would_block",
   141	        "failures",
   142	        "providers_used",
   143	        "legacy_evidence_count",
   144	        "unknown_evidence_count",
   145	        "would_block_reasons",
   146	        "artifact",
   147	        "generated_at",
   148	        "phase",
   149	        "iteration",
   150	        "base_sha",
   151	        "head_sha",
   152	        "invocation_id",
   153	        "provider_diagnostics",
   154	        "diagnostics",
   155	    ):
   156	        if key in review_evidence:
   157	            projected[key] = _bounded_json_value(review_evidence[key])
   158	
   159	    evidence = review_evidence.get("evidence")
   160	    if isinstance(evidence, list):
   161	        projected["evidence"] = [
   162	            _project_evidence_ref_for_prompt(ref)
   163	            for ref in evidence[:REVIEW_EVIDENCE_MAX_REFS]
   164	            if isinstance(ref, dict)
   165	        ]
   166	        projected["evidence_count"] = len(evidence)
   167	        omitted = len(evidence) - len(projected["evidence"])
   168	        if omitted > 0:
   169	            projected["evidence_refs_omitted"] = omitted
   170	
   171	    green_suite = review_evidence.get("green_suite")
   172	    if isinstance(green_suite, dict):
   173	        projected["green_suite"] = _project_green_suite_for_prompt(green_suite)
   174	    return projected
   175	
   176	
   177	def _project_evidence_ref_for_prompt(ref: dict[str, Any]) -> dict[str, Any]:
   178	    projected: dict[str, Any] = {}
   179	    for key in (
   180	        "kind",
   181	        "status",
   182	        "summary",
   183	        "trust_class",
   184	        "provider",
   185	        "provider_version",
   186	        "source",
   187	        "subject",
   188	        "observed_at",
   189	        "code_hash",
   190	    ):
   191	        if key in ref:
   192	            projected[key] = _bounded_json_value(ref[key])
   193	    artifact = ref.get("artifact")
   194	    if isinstance(artifact, dict):
   195	        projected["artifact"] = _project_artifact_ref_for_prompt(artifact)
   196	    artifacts = ref.get("artifacts")
   197	    if isinstance(artifacts, list):
   198	        projected["artifacts"] = [
   199	            _project_artifact_ref_for_prompt(item)
   200	            for item in artifacts[:REVIEW_EVIDENCE_ARTIFACT_MAX_REFS]
   201	            if isinstance(item, dict)
   202	        ]
   203	        omitted = len(artifacts) - len(projected["artifacts"])
   204	        if omitted > 0:
   205	            projected["artifacts_omitted"] = omitted
   206	    if "details" in ref:
   207	        projected["details_preview"] = _bounded_json_value(
   208	            ref["details"], max_chars=REVIEW_EVIDENCE_DETAIL_MAX_CHARS
   209	        )
   210	        projected["details_full_location"] = REVIEW_EVIDENCE_FILENAME
   211	    return projected
   212	
   213	
   214	def _project_artifact_ref_for_prompt(artifact: dict[str, Any]) -> dict[str, Any]:
   215	    projected: dict[str, Any] = {}
   216	    for key in ("path", "sha256", "artifact_type", "description"):
   217	        if key in artifact:
   218	            projected[key] = _bounded_json_value(artifact[key])
   219	    return projected

#!/usr/bin/env bash
# A deliberately small entrypoint for the three-hour Megaplan fixer.
#
# All policy and state live in simple_fixer.py.  This file only crosses the
# host/container boundary and selects the deployed source tree.
set -euo pipefail

CONTAINER="${MEGAPLAN_CLOUD_CONTAINER:-megaplan-cloud-agent}"

if [[ ! -d /workspace/arnold ]]; then
  if ! docker inspect "$CONTAINER" >/dev/null 2>&1; then
    echo "arnold-progress-auditor: container_missing container=$CONTAINER" >&2
    exit 1
  fi
  exec docker exec \
    -e MEGAPLAN_SIMPLE_FIXER_SOURCE_ROOT="${MEGAPLAN_SIMPLE_FIXER_SOURCE_ROOT:-/workspace/arnold}" \
    -e MEGAPLAN_AUDIT_MARKER_DIR="${MEGAPLAN_AUDIT_MARKER_DIR:-}" \
    -e MEGAPLAN_AUDIT_REPORT_DIR="${MEGAPLAN_AUDIT_REPORT_DIR:-}" \
    -e MEGAPLAN_SIMPLE_FIXER_STATE="${MEGAPLAN_SIMPLE_FIXER_STATE:-}" \
    -e MEGAPLAN_SIMPLE_FIXER_LOCK="${MEGAPLAN_SIMPLE_FIXER_LOCK:-}" \
    -e MEGAPLAN_SIMPLE_FIXER_MODEL="${MEGAPLAN_SIMPLE_FIXER_MODEL:-}" \
    -e MEGAPLAN_SIMPLE_FIXER_TIMEOUT_SECS="${MEGAPLAN_SIMPLE_FIXER_TIMEOUT_SECS:-}" \
    "$CONTAINER" bash -lc '/usr/local/bin/arnold-progress-auditor "$@"' _ "$@"
fi

AUDITOR_SOURCE_ROOT="${MEGAPLAN_SIMPLE_FIXER_SOURCE_ROOT:-/workspace/arnold}"
export PYTHONPATH="$AUDITOR_SOURCE_ROOT"
exec python3 -P -m arnold_pipelines.megaplan.cloud.simple_fixer \
  --source-root "$AUDITOR_SOURCE_ROOT" "$@"

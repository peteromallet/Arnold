#!/usr/bin/env bash
#
# arnold-runtime-create — per-epic runtime lifecycle: CREATE
#
# Provenance: fixer-unification design 2026-08-07, Phase 4
#   design: docs/runtime-and-fixer-unification-design-20260807.md
#     - §4 Phase 4 (per-epic runtimes light form) + §6 file-changes row 12
#     - §2 design rule 2 (worktree, not clone — shared objects)
#     - §2 design rule 3 (runtime-manifest.json is the ONLY post-bootstrap
#       resolver: one stable bootstrap path, one authoritative writer)
#     - §2 design rule 4 (push the epic branch to origin at creation; fail loudly)
#   briefing: docs/megaplan-fixer-briefing-20260807.md — "Push before live."
#
# Usage: arnold-runtime-create <slug> <base-ref>
#
#   1. git worktree add <base>/runtime-candidates/<slug> -b fixer/<slug>-<YYYYMMDD>
#      off <base-ref> HEAD (shared objects — same pattern the orchestrator used)
#   2. git push origin fixer/<slug>-<YYYYMMDD> at creation — FAILS LOUDLY on
#      push failure (design rule 4: a box-only branch is a failure)
#   2b. build/verify the content-addressed dependency generation (T-0301): ONE
#      immutable venv per frozen-spec digest (pyproject.toml + uv.lock) under
#      a single-writer flock, stored at <base>/runtime-venvs/<digest> and
#      SHARED across every runtime resolving the same spec.  No per-worktree
#      .venv, no pip install -e.  A missing spec or unverifiable generation
#      fails loudly — a runtime without a generation proof is never created.
#   3. write the epic runtime manifest (state=active, full field set: venv =
#      the shared generation, repair bin, deps lockfile, content attestation,
#      policy SHAs, dependency_generation proof) atomically via the
#      runtime_manifest CLI, falling back to direct JSON when the CLI is absent
#   4. write the ACTIVE POINTER <manifest-dir>/runtime-manifest.json via
#      write_active_pointer — COMPATIBILITY-ONLY since the P1 admission
#      kernel: the per-epic manifest is authoritative and admission/dispatch/
#      watchdog NEVER resolve through the pointer (G1 no-global-pointer
#      fallback). The pointer is written ONCE, atomically, with
#      'compatibility_only': true IN THE SAME PAYLOAD (G2 second re-run: the
#      marker is a preserved manifest field, so no two-step write and no
#      promote/close transition can strip it); it is never verified to
#      bootstrap the epic (G2 correction 1 — bootstrap_manifest refuses it
#      by design).
#   5. print the manifest path + runtime_id
#
# Environment overrides (all optional; tests redirect the sandbox with these):
#   ARNOLD_BASE_DIR             dir that contains runtime-candidates/ (default: /workspace)
#   ARNOLD_BASE_REPO            git repo the worktree is created from (default: $ARNOLD_BASE_DIR/arnold)
#   ARNOLD_ORIGIN_URL           push target — URL or remote name      (default: origin)
#   ARNOLD_WORKSPACE_MARKERS    marker/lock state root                (default: $ARNOLD_BASE_DIR/markers)
#   ARNOLD_RUNTIME_MANIFEST_DIR dir of per-epic runtime manifests     (default: $ARNOLD_BASE_DIR/.megaplan)
#   ARNOLD_RUNTIME_VENVS_DIR    shared content-addressed dependency-generation
#                               store root (T-0301)                   (default: $ARNOLD_BASE_DIR/runtime-venvs)
#   ARNOLD_RUNTIME_MANIFEST     active-pointer path (bootstrap root)  (default: $ARNOLD_RUNTIME_MANIFEST_DIR/runtime-manifest.json)
#   ARNOLD_RUNTIME_POLICY       per-chain runtime policy sidecar (.runtime_policy.json)
#                               holding an optional allow_manifestless permit;
#                               when present and valid it is stamped into
#                               manifest deviations[0] (invalid/expired permit
#                               = fail loud, deny-by-default; empty by default)
#
set -euo pipefail

# The chain bootstrap supplies the reviewed source-bound interpreter.  Keep a
# standalone invocation compatible with the historical default, but never
# silently choose a different interpreter when the launcher pinned one.
PYTHON_BIN="${ARNOLD_RUNTIME_PYTHON:-python3}"
if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
  echo "arnold-runtime-create: reviewed source interpreter is unavailable" >&2
  exit 78
fi

if [[ $# -ne 2 ]]; then
  echo "usage: arnold-runtime-create <slug> <base-ref>" >&2
  exit 64
fi

SLUG="$1"
BASE_REF="$2"

BASE_DIR="${ARNOLD_BASE_DIR:-/workspace}"
BASE_REPO="${ARNOLD_BASE_REPO:-$BASE_DIR/arnold}"
MARKERS="${ARNOLD_WORKSPACE_MARKERS:-$BASE_DIR/markers}"
MANIFEST_DIR="${ARNOLD_RUNTIME_MANIFEST_DIR:-$BASE_DIR/.megaplan}"
REMOTE="${ARNOLD_ORIGIN_URL:-origin}"
# A chain launch supplies the canonical configured repository URL separately
# from the source checkout.  Never inherit a custody/base checkout's local
# ``origin`` when this authority is present.
CANONICAL_ORIGIN="${ARNOLD_CANONICAL_ORIGIN_URL:-}"
if [[ -n "$CANONICAL_ORIGIN" ]]; then
  case "$CANONICAL_ORIGIN" in
    https://github.com/*) ;;
    *)
      echo "arnold-runtime-create: canonical origin must be an https://github.com URL" >&2
      exit 64
      ;;
  esac
  REMOTE="$CANONICAL_ORIGIN"
fi
# The custody-control-plane blocks `origin` pushes via a
# no-push-authorized:// pushurl on runtime candidates. runtime-create's whole
# job is to push a NEW runtime branch (design rule 4: a box-only branch is a
# failure), so the push must go to the REAL remote URL — never the blocked
# pushurl. Resolve the fetch URL when the configured pushurl is the block;
# explicit ARNOLD_ORIGIN_URL still wins.
if [[ "$REMOTE" == "origin" ]]; then
  _PUSHURL="$(git -C "$BASE_REPO" config --get remote.origin.pushurl 2>/dev/null || true)"
  if [[ "$_PUSHURL" == no-push-authorized:* ]]; then
    REMOTE="$(git -C "$BASE_REPO" config --get remote.origin.url 2>/dev/null || true)"
  fi
fi
# The active pointer: the manifest file AT this stable path IS the active
# generation (launchers bootstrap from it). Export it so the runtime_manifest
# module's active_manifest_path() agrees with the wrapper.
export ARNOLD_RUNTIME_MANIFEST="${ARNOLD_RUNTIME_MANIFEST:-$MANIFEST_DIR/runtime-manifest.json}"
POINTER="$ARNOLD_RUNTIME_MANIFEST"

CANDIDATES_DIR="$BASE_DIR/runtime-candidates"
RUNTIME_DIR="$CANDIDATES_DIR/$SLUG"
STAMP="$(date +%Y%m%d)"
BRANCH="fixer/$SLUG-$STAMP"
MANIFEST_PATH="$MANIFEST_DIR/$SLUG.json"

_json_get() {
  "$PYTHON_BIN" -c '
import json, sys
d = json.load(open(sys.argv[1]))
for key in sys.argv[2].split("."):
    if not isinstance(d, dict) or key not in d:
        print("")
        sys.exit(0)
    d = d[key]
if d is None:
    print("")
elif isinstance(d, (dict, list)):
    print(json.dumps(d))
else:
    print(str(d))
' "$1" "$2"
}

# Serialize create/resume decisions before inspecting or changing either the
# runtime or manifest.  This is intentionally the same lock used for the
# active-pointer transaction below.
mkdir -p "$MANIFEST_DIR"
CREATE_LOCK="$MANIFEST_DIR/.runtime-create.lock"
if command -v flock >/dev/null 2>&1; then
  exec 9>"$CREATE_LOCK"
  if ! flock -n 9; then
    echo "arnold-runtime-create: another runtime creation holds the lock ($CREATE_LOCK); refusing concurrent create" >&2
    exit 1
  fi
else
  if ! mkdir "$CREATE_LOCK.d" 2>/dev/null; then
    echo "arnold-runtime-create: another runtime creation holds the creation lock ($CREATE_LOCK); refusing concurrent create" >&2
    exit 1
  fi
  trap 'rmdir "$CREATE_LOCK.d" 2>/dev/null || true' EXIT
fi

# A failed launch can leave a complete, clean runtime and per-epic manifest
# before chain state/marker/owner creation.  Resume that exact state; never
# recreate, delete, or silently select a fresh runtime.
if [[ -e "$RUNTIME_DIR" || -e "$MANIFEST_PATH" ]]; then
  if [[ ! -d "$RUNTIME_DIR" || ! -f "$MANIFEST_PATH" ]]; then
    echo "arnold-runtime-create: partial runtime/manifest pair is incomplete; refusing recovery" >&2
    exit 1
  fi
  if ! BASE_HEAD="$(git -C "$BASE_REPO" rev-parse --verify "$BASE_REF^{commit}" 2>/dev/null)"; then
    echo "arnold-runtime-create: base-ref '$BASE_REF' is not resolvable in '$BASE_REPO'" >&2
    exit 1
  fi
  "$PYTHON_BIN" - "$MANIFEST_PATH" "$SLUG" "$RUNTIME_DIR" "$BASE_HEAD" "$BASE_REF" "$CANONICAL_ORIGIN" <<'PY'
import json, subprocess, sys
from pathlib import Path
from arnold_pipelines.megaplan.cloud.runtime_manifest import load_manifest

manifest_path, slug, runtime_root, base_head, base_ref, canonical_origin = sys.argv[1:]
try:
    manifest = load_manifest(Path(manifest_path))
except Exception as exc:
    raise SystemExit(f"arnold-runtime-create: existing manifest is invalid; refusing recovery: {exc}")
epic = manifest.epic
if manifest.epic_id != slug:
    raise SystemExit("arnold-runtime-create: existing manifest epic_id does not match requested slug; refusing recovery")
if manifest.state != "active":
    raise SystemExit("arnold-runtime-create: existing runtime is not active; refusing recovery")
if str(epic.get("runtime_root") or "") != runtime_root or str(epic.get("worktree_path") or "") != runtime_root:
    raise SystemExit("arnold-runtime-create: existing manifest runtime path diverges; refusing recovery")
if str(manifest.base.get("ref") or "") != base_ref:
    raise SystemExit("arnold-runtime-create: existing manifest base ref diverges from requested base; refusing recovery")
if str(epic.get("expected_head") or "") != base_head or str(manifest.base.get("commit") or "") != base_head:
    raise SystemExit("arnold-runtime-create: existing runtime head diverges from requested base; refusing recovery")
branch = str(epic.get("branch") or "")
def git(*args):
    proc = subprocess.run(["git", "-C", runtime_root, *args], text=True, capture_output=True)
    if proc.returncode:
        raise SystemExit(f"arnold-runtime-create: existing runtime git verification failed ({args[0]}): {proc.stderr.strip()}")
    return proc.stdout.strip()
if git("rev-parse", "--show-toplevel") != str(Path(runtime_root).resolve()):
    raise SystemExit("arnold-runtime-create: existing runtime checkout root diverges; refusing recovery")
if git("symbolic-ref", "--short", "HEAD") != branch:
    raise SystemExit("arnold-runtime-create: existing runtime branch diverges; refusing recovery")
if git("rev-parse", "HEAD") != base_head:
    raise SystemExit("arnold-runtime-create: existing runtime HEAD diverges; refusing recovery")
if git("status", "--porcelain"):
    raise SystemExit("arnold-runtime-create: existing runtime is dirty; refusing recovery")
if canonical_origin:
    if git("config", "--get", "remote.origin.url") != canonical_origin:
        raise SystemExit("arnold-runtime-create: existing runtime origin diverges from canonical configured URL; refusing recovery")
    for section in (epic, manifest.base):
        declared = section.get("origin_url")
        if declared is not None and str(declared) != canonical_origin:
            raise SystemExit("arnold-runtime-create: existing manifest origin diverges from canonical configured URL; refusing recovery")
print("arnold-runtime-create: existing per-epic runtime verified; resuming without recreation", file=sys.stderr)
PY
  RUNTIME_ID="$(_json_get "$MANIFEST_PATH" runtime_id)"
  echo "arnold-runtime-create: runtime '$SLUG' resumed (runtime_id=$RUNTIME_ID)" >&2
  echo "  branch:   $(_json_get "$MANIFEST_PATH" epic.branch) (already pushed)" >&2
  echo "  runtime:  $RUNTIME_DIR" >&2
  echo "  manifest: $MANIFEST_PATH (authoritative)" >&2
  exit 0
fi

# Resolve the base ref off which the worktree is created.
if ! BASE_HEAD="$(git -C "$BASE_REPO" rev-parse --verify "$BASE_REF^{commit}" 2>/dev/null)"; then
  echo "arnold-runtime-create: base-ref '$BASE_REF' is not resolvable in '$BASE_REPO'" >&2
  exit 1
fi

# (a) Worktree, not clone — shared objects off the base source repo.
if git -C "$BASE_REPO" rev-parse --verify "refs/heads/$BRANCH" >/dev/null 2>&1; then
  echo "arnold-runtime-create: refusing: branch '$BRANCH' already exists in '$BASE_REPO'" >&2
  exit 2
fi
mkdir -p "$CANDIDATES_DIR"
git -C "$BASE_REPO" worktree add -b "$BRANCH" "$RUNTIME_DIR" "$BASE_HEAD" >&2

# Worktrees inherit remotes from the source checkout.  Pin the runtime's
# origin before the first push and verify the exact URL, so a local custody
# path can never become the runtime's published origin.
if [[ -n "$CANONICAL_ORIGIN" ]]; then
  git -C "$RUNTIME_DIR" remote set-url origin "$REMOTE"
  ACTUAL_ORIGIN="$(git -C "$RUNTIME_DIR" config --get remote.origin.url 2>/dev/null || true)"
  if [[ "$ACTUAL_ORIGIN" != "$REMOTE" ]]; then
    echo "arnold-runtime-create: runtime origin verification failed before push" >&2
    exit 1
  fi
fi

# (b) Push at creation — FAIL LOUDLY (design rule 4). A box-only branch is a failure.
if ! git -C "$RUNTIME_DIR" push "$REMOTE" "HEAD:refs/heads/$BRANCH" >&2; then
  echo "arnold-runtime-create: FAILED to push '$BRANCH' to '$REMOTE' — refusing to leave a box-only runtime. The worktree is left in place for diagnosis; it is NOT authoritative and must not be treated as live." >&2
  exit 1
fi

# (b2) Build the content-addressed dependency generation (T-0301): ONE
# immutable venv per frozen dependency spec digest (pyproject.toml + uv.lock),
# shared across ALL runtimes that resolve to the same spec.  The build/verify
# runs under a single-writer flock inside the generation module; a missing
# frozen spec, a failed build, or an unverifiable existing generation FAILS
# LOUDLY — a runtime without a verifiable immutable generation is never
# created (no manifest without proof, no per-worktree .venv, no editable
# install).
GEN_ROOT="${ARNOLD_RUNTIME_VENVS_DIR:-$BASE_DIR/runtime-venvs}"
DEPS_LOCKFILE="$RUNTIME_DIR/uv.lock"
GEN_PROOF_JSON="$("$PYTHON_BIN" - "$RUNTIME_DIR" "$GEN_ROOT" <<'PY'
import json, os, sys
from pathlib import Path
from arnold_pipelines.megaplan.cloud.install_sync import (
    ensure_dependency_generation,
)
proof = ensure_dependency_generation(
    Path(sys.argv[1]),
    Path(sys.argv[2]),
    python_executable=os.environ.get(
        "ARNOLD_GENERATION_PYTHON"
    )
    or "/root/.pyenv/versions/3.13.6/bin/python",
)
print(json.dumps(proof, sort_keys=True))
PY
)" || {
  echo "arnold-runtime-create: dependency generation build/verify FAILED for '$RUNTIME_DIR' (frozen spec: '$DEPS_LOCKFILE') — refusing to create a runtime without a verifiable generation" >&2
  exit 1
}
GEN_DIR="$("$PYTHON_BIN" -c '
import json, sys
proof = json.loads(sys.argv[1])
print(str(proof["interpreter_path"]).rsplit("/bin/python", 1)[0])
' "$GEN_PROOF_JSON")" || {
  echo "arnold-runtime-create: dependency generation proof is unreadable (interpreter path missing)" >&2
  exit 1
}
GEN_ID="$("$PYTHON_BIN" -c 'import json,sys; print(json.loads(sys.argv[1])["id"])' "$GEN_PROOF_JSON")"
echo "arnold-runtime-create: dependency generation ready at '$GEN_DIR' (id=$GEN_ID)" >&2

# (c) Write the epic manifest atomically. Build the full payload first (the
# complete mandatory field set per the runtime_manifest contract — schema "1",
# with the venv/repair-bin/lockfile/attestation/policy/dependency-generation
# fields FILLED, not empty), hand it to the authoritative writer
# (runtime_manifest CLI: `write <path> --from <file>`) when available, else
# fall back to a direct atomic write.
manifest_valid() {
  [[ -s "$1" ]] && [[ "$(_json_get "$1" epic_id)" == "$2" ]] && [[ -n "$(_json_get "$1" runtime_id)" ]]
}

mkdir -p "$MANIFEST_DIR"
MANIFEST_TMP="$(mktemp "${MANIFEST_DIR}/.runtime-manifest-XXXXXX")"
"$PYTHON_BIN" - "$MANIFEST_TMP" "$SLUG" "$BRANCH" "$RUNTIME_DIR" "$BASE_HEAD" "$BASE_REF" "$STAMP" "$GEN_DIR" "$GEN_PROOF_JSON" "$DEPS_LOCKFILE" "$REMOTE" <<'PY'
import json, os, sys
from datetime import datetime, timedelta, timezone

path, slug, branch, runtime_root, head, base_ref, stamp, gen_dir, gen_proof_json, deps_lockfile, origin_url = sys.argv[1:12]
gen_dir = str(gen_dir)
generation = json.loads(gen_proof_json)
owner = os.environ.get("USER") or os.environ.get("LOGNAME") or "unknown"
now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

# ── P1 admission kernel: allow_manifestless permit → manifest deviations[0] ──
# The permit record contract (settled): {kind, id, issued_at, expires_at,
# actor, reason, evidence[], chain_digest}, UTC ISO timestamps, duration
# 0 < expires_at - issued_at <= 24h, current-unexpired. The sidecar
# (ARNOLD_RUNTIME_POLICY) may hold the permit as a direct
# {"allow_manifestless": {...}} object, inside a "permits"/"deviations" list,
# or as the sidecar root. Absent env/file → deviations stay empty (default).
# Present-but-invalid/expired permit → fail loud, deny-by-default: creation
# must never proceed without recording the declared deviation.

def _utc_parse(value, label):
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except (TypeError, ValueError) as exc:
        raise SystemExit(
            f"arnold-runtime-create: permit {label} {value!r} is not a valid UTC ISO timestamp"
        ) from exc


def _allow_manifestless_candidates(raw):
    if not isinstance(raw, dict):
        raise SystemExit("arnold-runtime-create: runtime policy sidecar must be a JSON object")
    candidates = []
    direct = raw.get("allow_manifestless")
    if isinstance(direct, dict):
        candidates.append(direct)
    for key in ("permits", "deviations"):
        items = raw.get(key)
        if isinstance(items, list):
            candidates.extend(
                item for item in items
                if isinstance(item, dict) and item.get("kind") == "allow_manifestless"
            )
    if isinstance(raw.get("kind"), str) and raw.get("kind") == "allow_manifestless":
        candidates.append(raw)
    return candidates


def _validate_permit(permit):
    if not isinstance(permit, dict):
        raise SystemExit("arnold-runtime-create: allow_manifestless permit must be an object")
    if permit.get("kind") != "allow_manifestless":
        raise SystemExit(
            f"arnold-runtime-create: permit kind {permit.get('kind')!r} is not 'allow_manifestless'"
        )
    for field in ("id", "issued_at", "expires_at", "actor", "reason", "chain_digest"):
        value = permit.get(field)
        if not isinstance(value, str) or not value:
            raise SystemExit(
                f"arnold-runtime-create: allow_manifestless permit missing required field {field!r}"
            )
    evidence = permit.get("evidence")
    if evidence is not None and not isinstance(evidence, list):
        raise SystemExit("arnold-runtime-create: allow_manifestless permit 'evidence' must be a list")
    issued = _utc_parse(permit["issued_at"], "issued_at")
    expires = _utc_parse(permit["expires_at"], "expires_at")
    duration = expires - issued
    if duration <= timedelta(0) or duration > timedelta(hours=24):
        raise SystemExit(
            f"arnold-runtime-create: allow_manifestless permit duration {duration} is outside (0, 24h]"
        )
    now_utc = datetime.now(timezone.utc)
    if now_utc < issued or now_utc >= expires:
        raise SystemExit(
            f"arnold-runtime-create: allow_manifestless permit {permit['id']!r} is expired or not yet valid "
            f"(issued_at={permit['issued_at']}, expires_at={permit['expires_at']})"
        )


def _load_allow_manifestless_permit(policy_path):
    try:
        with open(policy_path, encoding="utf-8") as fh:
            raw = json.load(fh)
    except (OSError, json.JSONDecodeError) as exc:
        raise SystemExit(
            f"arnold-runtime-create: runtime policy sidecar unreadable at {policy_path}: {exc}"
        ) from exc
    candidates = _allow_manifestless_candidates(raw)
    if not candidates:
        return None
    # Deny-by-default: ANY present allow_manifestless permit that fails
    # validation fails the creation — a broken override must surface loudly.
    for permit in candidates:
        _validate_permit(permit)
    return candidates[0]


deviations = []
policy_path = os.environ.get("ARNOLD_RUNTIME_POLICY", "").strip()
if policy_path:
    permit = _load_allow_manifestless_permit(policy_path)
    if permit is not None:
        deviations.append(permit)
        print(
            f"arnold-runtime-create: stamped allow_manifestless permit {permit['id']!r} "
            f"into manifest deviations[0]",
            file=sys.stderr,
        )

# Policy SHAs from the canonical policy modules — import-guarded, best-effort:
# if a module cannot be imported the SHA stays "" and a note is printed (the
# manifest is still schema-valid; a consumer that requires the SHA will refuse).
policy_sha = ""
model_policy_sha = ""
missing_notes = []
try:
    from arnold_pipelines.megaplan.cloud.fixer_prompt_policy import policy_sha as _prompt_sha
    policy_sha = _prompt_sha()
except Exception as exc:  # noqa: BLE001 - guarded best-effort import
    missing_notes.append(f"fixer_prompt_policy import failed ({exc}); policy_sha left empty")
try:
    from arnold_pipelines.megaplan.cloud.fixer_model_policy import model_policy_sha as _model_sha
    model_policy_sha = _model_sha()
except Exception as exc:  # noqa: BLE001 - guarded best-effort import
    missing_notes.append(f"fixer_model_policy import failed ({exc}); model_policy_sha left empty")

manifest = {
    "runtime_id": f"{slug}-{stamp}",
    "schema": "1",
    "generation": 1,
    "epic_id": slug,
    "state": "active",
    "owner": owner,
    "base": {
        "ref": base_ref,
        "commit": head,
        "editable_install_path": "",
        "venv_path": gen_dir,
        "origin_url": origin_url,
    },
    "epic": {
        "branch": branch,
        "worktree_path": runtime_root,
        "venv_path": gen_dir,
        "runtime_root": runtime_root,
        "expected_head": head,
        "repair_bin": f"{runtime_root}/arnold_pipelines/megaplan/cloud/wrappers/arnold-babysitter",
        "deps_lockfile": deps_lockfile,
        "origin_url": origin_url,
        # T-0301: the content-addressed dependency generation proof.  The
        # venv at gen_dir is SHARED across every runtime that resolves to
        # the same frozen spec (id = spec digest); the runtime code comes
        # from this worktree via worktree-first PYTHONPATH at launch.
        "dependency_generation": generation,
    },
    "indirection": {
        "host_path": runtime_root,
        "container_path": "",
        "mount_table": [],
        "execution_namespace": "",
        "verified_head": head,
        "last_verified_at": now,
        "attestation": {"module_file": "", "module_digest": "", "mount_id": ""},
    },
    "policy": {"policy_sha": policy_sha, "model_policy_sha": model_policy_sha, "sync_policy": {}},
    "deviations": deviations,
    "promotions": [],
    "timestamps": {"created": now, "updated": now, "closed": None},
    "gc_policy": {"closed_only": True, "restore_proven_required": True},
    "commands": [],
}

# Content attestation of the runtime tree (best-effort; attest_runtime NEVER
# raises — probe failures land in the returned errors list).
try:
    from arnold_pipelines.megaplan.cloud.runtime_manifest import RuntimeManifest, attest_runtime
    manifest["indirection"]["attestation"] = attest_runtime(RuntimeManifest.from_dict(manifest))
except Exception as exc:  # noqa: BLE001 - guarded best-effort import
    missing_notes.append(f"runtime_manifest attest_runtime unavailable ({exc}); attestation left empty")

for note in missing_notes:
    print(f"arnold-runtime-create: note — {note}", file=sys.stderr)

with open(path, "w", encoding="utf-8") as fh:
    json.dump(manifest, fh, indent=2, sort_keys=True)
    fh.write("\n")
PY
if "$PYTHON_BIN" -m arnold_pipelines.megaplan.cloud.runtime_manifest write \
    "$MANIFEST_PATH" --from "$MANIFEST_TMP" >/dev/null 2>&1 \
   && manifest_valid "$MANIFEST_PATH" "$SLUG"; then
  : # authoritative writer validated and wrote the manifest
else
  echo "arnold-runtime-create: runtime_manifest CLI unavailable/failed; writing '$MANIFEST_PATH' directly (fallback)" >&2
  "$PYTHON_BIN" - "$MANIFEST_PATH" "$MANIFEST_TMP" <<'PY'
import json, os, sys, tempfile

path, src = sys.argv[1:3]
with open(src, encoding="utf-8") as fh:
    payload = json.load(fh)
os.makedirs(os.path.dirname(path), exist_ok=True)
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".runtime-manifest-", suffix=".tmp")
try:
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(payload, fh, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, path)
finally:
    if os.path.exists(tmp):
        os.unlink(tmp)
PY
fi
# P1 admission kernel: the runtime_manifest CLI round-trips the payload
# through the RuntimeManifest dataclass, which may not carry the optional
# top-level `deviations` key yet. When the written file lost it, re-write the
# full payload directly (schema-valid; from_dict ignores unknown keys) so the
# deviation record ALWAYS persists — an allow_manifestless permit that
# silently disappears from the manifest would be a silent fallback.
"$PYTHON_BIN" - "$MANIFEST_PATH" "$MANIFEST_TMP" <<'PY'
import json, os, sys, tempfile

path, src = sys.argv[1:3]
with open(path, encoding="utf-8") as fh:
    written = json.load(fh)
if "deviations" in written:
    raise SystemExit(0)
with open(src, encoding="utf-8") as fh:
    payload = json.load(fh)
os.makedirs(os.path.dirname(path), exist_ok=True)
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".runtime-manifest-", suffix=".tmp")
try:
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(payload, fh, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, path)
finally:
    if os.path.exists(tmp):
        os.unlink(tmp)
PY
rm -f "$MANIFEST_TMP"
manifest_valid "$MANIFEST_PATH" "$SLUG" || {
  echo "arnold-runtime-create: manifest write FAILED for '$MANIFEST_PATH'" >&2
  exit 1
}

# (d) Write the ACTIVE POINTER — COMPATIBILITY-ONLY since the P1 admission
# kernel (G1 no-global-pointer fallback). The per-epic manifest at
# $MANIFEST_PATH is authoritative: admission, dispatch, and watchdog resolve
# through the per-session manifest path a launch bound, NEVER through this
# file. The pointer is written ONCE with 'compatibility_only': true IN THE
# SAME payload (atomic — G2 second re-run; the marker is a preserved manifest
# field, so promote/close cannot strip it), as compatibility telemetry ONLY;
# it is never verified to bootstrap the epic (G2 correction 1).
# Warn when the pointer currently names a DIFFERENT epic (informational only —
# the pointer is not the identity; the per-slug manifest is).
if [[ -f "$POINTER" ]]; then
  POINTER_EPIC="$(_json_get "$POINTER" epic_id)"
  if [[ -n "$POINTER_EPIC" && "$POINTER_EPIC" != "$SLUG" ]]; then
    echo "arnold-runtime-create: note — active pointer '$POINTER' currently held by epic '$POINTER_EPIC' (compatibility-only; per-epic manifests are authoritative)" >&2
  fi
fi
COMPATIBILITY_RECEIPT="${ARNOLD_RUNTIME_COMPATIBILITY_RECEIPT:-$MANIFEST_PATH.compatibility-pointer-conflict.json}"
export ARNOLD_RUNTIME_COMPATIBILITY_RECEIPT="$COMPATIBILITY_RECEIPT"
if ! "$PYTHON_BIN" -c '
import hashlib
import json
import os
import sys
import tempfile
from arnold_pipelines.megaplan.cloud.runtime_manifest import (
    ForeignAuthoritativePointerConflict,
    RuntimeManifest,
    load_manifest,
    write_active_pointer,
)
# G2 second re-run: write the pointer ONCE with the marker in the SAME
# payload (atomic) — never an authoritative manifest re-marked in a separate
# operation (crash/race window). The per-slug manifest stays authoritative.
per_slug = load_manifest(sys.argv[1])
pointer_manifest = RuntimeManifest.from_dict(
    dict(per_slug.to_dict(), compatibility_only=True)
)
try:
    write_active_pointer(pointer_manifest)
except ForeignAuthoritativePointerConflict as exc:
    pointer_path = os.environ.get("ARNOLD_RUNTIME_MANIFEST", "")
    try:
        with open(pointer_path, "rb") as fh:
            pointer_sha = hashlib.sha256(fh.read()).hexdigest()
    except OSError:
        pointer_sha = ""
    receipt = {
        "schema": "arnold.runtime.compatibility_pointer_conflict.v1",
        "type": "compatibility_pointer_conflict",
        "code": exc.code,
        "epic_id": per_slug.epic_id,
        "pointer": pointer_path,
        "pointer_sha256": pointer_sha,
        "preserved": True,
        "authoritative_manifest": sys.argv[1],
    }
    receipt_path = os.environ.get("ARNOLD_RUNTIME_COMPATIBILITY_RECEIPT", "")
    if not receipt_path:
        receipt_path = sys.argv[1] + ".compatibility-pointer-conflict.json"
    parent = os.path.dirname(receipt_path) or "."
    os.makedirs(parent, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".compatibility-pointer-conflict-", dir=parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(receipt, fh, sort_keys=True)
            fh.write("\n")
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, receipt_path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
    print(json.dumps(receipt, sort_keys=True), file=sys.stderr)
' "$MANIFEST_PATH"; then
  echo "arnold-runtime-create: FAILED to write the active pointer '$POINTER'. The per-slug manifest exists and is authoritative; the compatibility-only pointer is degraded." >&2
  exit 1
fi
echo "arnold-runtime-create: WARNING — active pointer '$POINTER' is COMPATIBILITY-ONLY (marked 'compatibility_only': true). Per-epic manifests are authoritative; admission/dispatch/watchdog must NOT resolve through this pointer (G1 no-global-pointer fallback)." >&2
# G2 correction 1 + second re-run: the pointer is compatibility telemetry ONLY,
# written atomically with the marker as part of the manifest payload (and the
# runtime_manifest lib keeps the demotion durable across promote/close). We do
# NOT verify it bootstraps this epic (bootstrap_manifest refuses
# compatibility_only pointers by design), and no resolver may select a runtime
# through it.

# (e) Report the manifest path + runtime_id.
RUNTIME_ID="$(_json_get "$MANIFEST_PATH" runtime_id)"
[[ -n "$RUNTIME_ID" ]] || RUNTIME_ID="$SLUG-$STAMP"
echo "arnold-runtime-create: runtime '$SLUG' created (runtime_id=$RUNTIME_ID)" >&2
echo "  branch:   $BRANCH (pushed to $REMOTE)" >&2
echo "  runtime:  $RUNTIME_DIR" >&2
echo "  manifest: $MANIFEST_PATH (authoritative)" >&2
echo "  pointer:  $POINTER (COMPATIBILITY-ONLY; per-epic manifests are authoritative — G1 no-global-pointer fallback)" >&2

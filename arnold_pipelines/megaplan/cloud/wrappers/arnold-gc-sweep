#!/usr/bin/env bash
#
# arnold-gc-sweep — per-epic runtime lifecycle: CLOSED-ONLY, RESTORE-PROVEN GC
#
# Provenance: fixer-unification design 2026-08-07, Phase 5
#   design: docs/runtime-and-fixer-unification-design-20260807.md
#     - §4 Phase 5 (safe GC + close protocol — the ONLY deletion phase) + §6 row 15
#     - §2 design rule 6: GC on close; closed-only, schedule-store-reconciled,
#       restore-proven. "origin==local" is NOT a deletion predicate — it does not
#       cover untracked files, stashes, reflog-only objects, extra refs,
#       container writable layers, or operational state. A delete only happens
#       after a clean-room restore of the tree's *runtime* has been proven.
#   briefing: docs/megaplan-fixer-briefing-20260807.md — "Push before live."
#
# Usage: arnold-gc-sweep [--dry-run] [--restore-proven] [--fixer-branch <branch>] <manifest-dir>
#
#   Scans <manifest-dir>/*.json. For every CLOSED manifest whose runtime_root
#   still exists it verifies:
#     (a) origin-resolvable — local HEAD == origin/<epic branch> HEAD
#     (b) schedule-store    — the tree's slug/sha must NOT be referenced by
#                             any schedule store (probe-4 trees are
#                             load-bearing for scheduled work and must never
#                             be swept; see ARNOLD_SCHEDULE_STORE below)
#     (c) restore-proven    — a CONTENT-ADDDRESSED restore receipt
#                             (<manifest-dir>/restore-receipts/<slug>.json)
#                             that binds the manifest's content-addressed
#                             identities (runtime_id, dependency_generation.id)
#                             to the live closed HEAD and self-verifies its
#                             content_sha256.  A CLI flag (--restore-proven)
#                             or restore-proven.txt marker is NOT evidence —
#                             either alone is a SKIP (T-0027 discipline:
#                             the restore must have a content-addressed
#                             receipt, never a flag)
#   and only then runs `git worktree remove --force` + archives the manifest to
#   <manifest-dir>/archived/.
#
#   Before EVERY deletion (worktree, fixer branch, or epic venv) the sweep
#   additionally consults the reference census (runtime_references module,
#   T-0012): exact runtime-root paths normalized from runtime manifests, chain
#   metadata.execution_environment.engine_root, cloud-session/chain-health
#   markers, resident/ops schedules, repair-queue requests/decisions/
#   claims/attempts/leases, per-plan custody lease stores, managed-subagent
#   run manifests + fixer-session stores, the status snapshot, and ops
#   schedule-inputs.  REFERENCED hard-skips; DANGLING is NEEDS-RECONCILE; an
#   unreadable/corrupt store is UNKNOWN and BLOCKS with exit 5 —
#   delete-on-unknown never happens.  slug/SHA substring matching is never
#   the only deletion predicate (the schedule-store grep gate above is
#   preserved on top of the exact-path census).
#
#   Per-manifest outcome protocol (G6 round-3 finding 1): every processed
#   manifest yields exactly one decision line on stdout —
#   'gc-sweep: <TOKEN> '<slug>' ...'.  TOKEN is SWEPT=YES (runtime actually
#   removed, manifest archived), SKIP / NEEDS-RECONCILE (runtime left in
#   place — never a deletion), or UNKNOWN / REFUSE (fail-closed aborts on
#   stderr; exit 5 / 3).  Skips that leave a surviving runtime alive carry
#   an explicit per-slug swept:false marker inside the line:
#   'SWEPT=NO:REFERENCED' (census says the root is still load-bearing) or
#   'SWEPT=NO:DANGLING' (census incoherent).  Callers MUST key 'swept' on
#   this line, never on the exit status alone: a skip still exits 0 (a
#   multi-manifest sweep may reclaim OTHER trees), so an exit-0 sweep never
#   implies deletion — 'swept' is true ONLY for the SWEPT=YES token.
#
#   Anything else is SKIPped with the reason printed.
#
#   This sweep NEVER infers "stale": a runner death mid-epic leaves a tree
#   neither-live-neither-closed. Such trees (and manifests in an unknown
#   state) are listed as NEEDS-RECONCILE and are never deleted.  A present
#   manifest that fails canonical validation (corrupt OR schema-invalid —
#   valid JSON missing required fields) is the same NEEDS-RECONCILE class:
#   its fields are only ever read through runtime_manifest.load_manifest
#   (G5 round-2 finding 4), so a field-bearing but schema-invalid manifest
#   can never reach the deletion gates.
#
#   --dry-run previews what would be swept (closed + origin-resolvable) without
#   deleting anything and still reports the restore-proven requirement.
#
#   --fixer-branch <branch> (P6 terminal finalizer): the manifest-declared
#   fixer branch to delete (local + remote) after a restore-proven sweep of the
#   manifest that declares it.  The sweep REFUSES to delete the branch while a
#   pull ref on the remote still points at the branch head (an open PR is
#   load-bearing; P6 terminal-state rules never sweep with a PR open).
#
# Environment overrides (all optional):
#   ARNOLD_BASE_DIR             dir that contains runtime-candidates/ (default: /workspace)
#   ARNOLD_BASE_REPO            repo that owns the worktrees          (default: $ARNOLD_BASE_DIR/arnold)
#   ARNOLD_ORIGIN_URL           origin URL/remote used to resolve     (default: origin)
#   ARNOLD_SCHEDULE_STORE       schedule store dir to reconcile        (default: /workspace/arnold/.megaplan/resident/scheduled_jobs + /workspace/arnold/.megaplan/resident/schedules/heads + /workspace/.megaplan/ops/schedules)
#
set -euo pipefail

DRY=0
RESTORE_PROVEN=0
FIXER_BRANCH=""
POSITIONAL=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY=1; shift ;;
    --restore-proven) RESTORE_PROVEN=1; shift ;;
    --fixer-branch)
      FIXER_BRANCH="${2:-}"
      if [[ -z "$FIXER_BRANCH" ]]; then
        echo "arnold-gc-sweep: --fixer-branch requires a branch name" >&2
        exit 64
      fi
      shift 2
      ;;
    --fixer-branch=*) FIXER_BRANCH="${1#--fixer-branch=}"; shift ;;
    *) POSITIONAL+=("$1"); shift ;;
  esac
done

if [[ ${#POSITIONAL[@]} -ne 1 ]]; then
  echo "usage: arnold-gc-sweep [--dry-run] [--restore-proven] [--fixer-branch <branch>] <manifest-dir>" >&2
  exit 64
fi

MANIFEST_DIR="${POSITIONAL[0]}"
if [[ ! -d "$MANIFEST_DIR" ]]; then
  # A missing manifest dir is itself a needs-reconcile signal (runner death
  # mid-epic can leave trees with no manifest at all) — proceed, do not abort.
  echo "gc-sweep: manifest dir '$MANIFEST_DIR' does not exist; created empty (trees without manifests are listed as NEEDS-RECONCILE, never deleted)" >&2
  mkdir -p "$MANIFEST_DIR"
fi

BASE_DIR="${ARNOLD_BASE_DIR:-/workspace}"
BASE_REPO="${ARNOLD_BASE_REPO:-$BASE_DIR/arnold}"
REMOTE="${ARNOLD_ORIGIN_URL:-origin}"
ARCHIVE_DIR="$MANIFEST_DIR/archived"
mkdir -p "$ARCHIVE_DIR"
# T-0301: the shared content-addressed dependency-generation store.  The
# sweep feeds it to the reference census (--generation-root) so a corrupt
# generation blocks deletion (UNKNOWN) and a referenced generation is never
# rm -rf'd; the generation itself is deleted only when the census proves
# zero references to it.
GEN_ROOT="${ARNOLD_RUNTIME_VENVS_DIR:-$BASE_DIR/runtime-venvs}"

# Schedule store reconciliation (design rule 6 / Phase 5): probe-4 trees are
# referenced by the schedule store and must NEVER be swept. Default stores are
# the resident scheduled-jobs dir and the ops schedules dir; ARNOLD_SCHEDULE_STORE
# overrides with a single dir (tests redirect the sandbox with it).
if [[ -n "${ARNOLD_SCHEDULE_STORE:-}" ]]; then
  SCHEDULE_STORES=("$ARNOLD_SCHEDULE_STORE")
else
  SCHEDULE_STORES=("/workspace/arnold/.megaplan/resident/scheduled_jobs" "/workspace/arnold/.megaplan/resident/schedules/heads" "/workspace/.megaplan/ops/schedules")
fi

_schedule_store_references() {
  # $1 = slug, $2 = sha. Returns 0 (and sets SCHEDULE_STORE_HIT) when any
  # configured store references either; 1 otherwise. A missing store dir is
  # not a reference.
  local slug="$1" sha="$2" store
  for store in "${SCHEDULE_STORES[@]}"; do
    [[ -d "$store" ]] || continue
    if grep -rIq -- "$slug" "$store" 2>/dev/null || grep -rIq -- "$sha" "$store" 2>/dev/null; then
      SCHEDULE_STORE_HIT="$store"
      return 0
    fi
  done
  return 1
}

_manifest_fields() {
  # Canonical manifest read (G5 round-2 finding 4): sweep-decision fields
  # come from runtime_manifest.load_manifest — the SAME fail-closed
  # validation bootstrap_manifest uses — never raw json.load + dotted-field
  # reads.  Corrupt JSON, valid JSON with the wrong structure (schema-
  # invalid, missing required fields while still carrying state/
  # epic.runtime_root/epic.branch), and unreadable files all raise
  # ManifestError and exit 1 here, so such a manifest is NEEDS-RECONCILE and
  # can never reach the deletion gates.  Prints the eight sweep fields
  # (epic_id, state, epic.runtime_root, epic.branch, epic.venv_path,
  # dependency-generation-proof-complete, runtime_id,
  # dependency_generation.id) tab-separated on stdout; a schema-valid
  # manifest is guaranteed to carry every one of them.
  python3 - "$1" <<'PY'
import sys
from pathlib import Path

try:
    from arnold_pipelines.megaplan.cloud.runtime_manifest import (
        ManifestError,
        dependency_generation_proof,
        load_manifest,
    )
except Exception as exc:  # noqa: BLE001 - the canonical validator is unavailable
    sys.stderr.write(
        "gc-sweep: canonical manifest validation unavailable for %s: %s\n"
        % (sys.argv[1], exc)
    )
    sys.exit(1)
try:
    manifest = load_manifest(Path(sys.argv[1]))
except ManifestError as exc:
    sys.stderr.write(
        "gc-sweep: invalid manifest %s (corrupt or schema-mismatched): %s\n"
        % (sys.argv[1], exc)
    )
    sys.exit(1)
epic = manifest.epic
# T-0301 GC gate: a manifest whose dependency-generation proof is missing or
# incomplete cannot attest its dependency state — the sweep must not delete
# the runtime (or its shared generation) under unknown dependency state.
depgen = "1" if dependency_generation_proof(manifest) is not None else "0"
depgen_id = str((epic.get("dependency_generation") or {}).get("id") or "")
print(
    "\t".join(
        (
            manifest.epic_id,
            manifest.state,
            epic["runtime_root"],
            epic["branch"],
            epic["venv_path"],
            depgen,
            manifest.runtime_id,
            depgen_id,
        )
    )
)
PY
}

# ── Reference census (T-0012): fail-closed before EVERY deletion ─────────────
# One canonical, injectable reference census (runtime_references module),
# consulted before every worktree/branch/dependency deletion.  It normalizes
# EXACT runtime-root paths from: runtime manifests; active/paused/blocked
# chain metadata.execution_environment.engine_root (fixed store AND the
# workspace-relative <workspace>/.megaplan/plans/.chains chain-state layout,
# spec.py); cloud-session and chain-health markers; resident/ops schedules
# and jobs; occurrence requests, decisions, active claims (including the
# nested <token>.lock/owner.json claim metadata), attempts, and leases;
# per-plan custody lease stores (<workspace>/.megaplan/plans/<plan>/
# custody/leases — worker_dispatch_wbc.py / phase_wbc.py); managed-subagent
# run manifests and fixer-session stores (resident/subagent.py
# DEFAULT_MANAGED_RUN_ROOT); the status snapshot
# (/workspace/.megaplan/status — status_snapshot.py); and ops schedule-inputs
# (/workspace/.megaplan/ops/schedules + schedule-inputs — probe_records.py).
# All new stores follow the module env defaults (ARNOLD_REFERENCE_*), so the
# sweep's census inherits sandbox/test redirection like the existing stores.
# Verdicts are fail-closed:
#   REFERENCED  -> a store references the exact root: HARD-SKIP deletion
#   DANGLING    -> a store references a runtime root that no longer exists:
#                  the census is incoherent -> NEEDS-RECONCILE, never deleted
#   UNKNOWN     -> a store is unreadable/corrupt: deletion BLOCKED (exit 5)
#   CLEAR       -> no reference; the other gates still apply
# slug/SHA substring matching is never the only predicate here: the legacy
# schedule-store grep gate above still applies on top of the exact-path census.
# The schedule stores fed to the census are exactly the SCHEDULE_STORES above
# so the two gates share ONE configuration.
CENSUS_SCHEDULE_STORES="$(IFS=:; echo "${SCHEDULE_STORES[*]}")"

_reference_census() {
  # $1 = runtime root being considered for deletion; $2 = manifest being swept.
  # Prints the census report (STATUS line + REASON lines) and sets
  # CENSUS_VERDICT to CLEAR|REFERENCED|DANGLING|UNKNOWN.  A failing census
  # is UNKNOWN (fail-closed).
  local out rc=0
  out="$(python3 -m arnold_pipelines.megaplan.cloud.runtime_references census \
    --root "$1" \
    --workspace "$BASE_DIR" \
    --manifest-store "$MANIFEST_DIR" \
    --current-manifest "$2" \
    --schedule-store "$CENSUS_SCHEDULE_STORES" \
    --generation-root "$GEN_ROOT" 2>&1)" || rc=$?
  CENSUS_REPORT="$out"
  CENSUS_VERDICT="$(printf '%s\n' "$out" | awk '/^STATUS /{print $2; exit}')"
  if [[ -z "$CENSUS_VERDICT" ]]; then
    CENSUS_VERDICT="UNKNOWN"
    CENSUS_REPORT="reference census unavailable (rc=$rc): $out"
  fi
}

_restore_receipt_python() {
  # Validate a restore receipt ($1 = receipt path, $2 = slug, $3 = canonical
  # manifest path, $4 = live worktree HEAD, $5 = runtime root).  Prints a
  # single line: "OK" or "FAIL <reason>".
  python3 - "$@" <<'PY'
import hashlib
import json
import sys
from datetime import datetime
from pathlib import Path

receipt_path, slug, mf_path, live_head, runtime_root = sys.argv[1:6]


def fail(reason: str) -> None:
    print("FAIL " + reason)


try:
    from arnold_pipelines.megaplan.cloud.runtime_manifest import load_manifest

    manifest = load_manifest(Path(mf_path))
except Exception as exc:  # noqa: BLE001 - fail closed on unreadable manifest
    fail("manifest unreadable: %s" % exc)
    sys.exit(1)
try:
    raw = json.loads(Path(receipt_path).read_text(encoding="utf-8"))
except Exception as exc:  # noqa: BLE001 - unreadable/torn JSON is not evidence
    fail("receipt is not valid JSON: %s" % exc)
    sys.exit(1)
if not isinstance(raw, dict):
    fail("receipt is not an object")
    sys.exit(1)
if raw.get("schema") != "restore-receipt/v1":
    fail("receipt schema is not restore-receipt/v1")
    sys.exit(1)
if str(raw.get("epic_id") or "") != slug:
    fail("receipt epic_id %r does not match slug %r" % (raw.get("epic_id"), slug))
    sys.exit(1)
digest = str(raw.get("content_sha256") or "")
if not digest or len(digest) != 64 or any(c not in "0123456789abcdef" for c in digest):
    fail("receipt content_sha256 is not a 64-char hex SHA-256")
    sys.exit(1)
body = {key: value for key, value in raw.items() if key != "content_sha256"}
if (
    hashlib.sha256(
        json.dumps(body, sort_keys=True, separators=(",", ":")).encode("utf-8")
    ).hexdigest()
    != digest
):
    fail("receipt content_sha256 does not self-verify (torn or forged receipt)")
    sys.exit(1)
if str(raw.get("runtime_id") or "") != str(manifest.runtime_id or ""):
    fail("receipt runtime_id does not match the manifest's runtime_id")
    sys.exit(1)
depgen_id = str((manifest.epic.get("dependency_generation") or {}).get("id") or "")
if str(raw.get("dependency_generation_id") or "") != depgen_id:
    fail("receipt dependency_generation_id does not match the manifest's dependency_generation.id")
    sys.exit(1)
receipt_root = str(raw.get("runtime_root") or "")
try:
    if str(Path(receipt_root).expanduser().resolve(strict=False)) != str(
        Path(runtime_root).expanduser().resolve(strict=False)
    ):
        fail("receipt runtime_root does not match the manifest's runtime_root")
        sys.exit(1)
except Exception as exc:  # noqa: BLE001 - unresolvable root is not evidence
    fail("receipt runtime_root unresolvable: %s" % exc)
    sys.exit(1)
if str(raw.get("closed_head") or "") != str(live_head or ""):
    fail("receipt closed_head does not match the live worktree HEAD")
    sys.exit(1)
if not isinstance(raw.get("restore_drill"), str) or not raw["restore_drill"].strip():
    fail("receipt restore_drill is missing")
    sys.exit(1)
try:
    datetime.fromisoformat(str(raw.get("restored_at") or ""))
except Exception:  # noqa: BLE001 - non-ISO timestamp is not evidence
    fail("receipt restored_at is not an ISO timestamp")
    sys.exit(1)
print("OK")
PY
}

_restore_receipt_check() {
  # $1 = slug; $2 = canonical manifest path; $3 = live worktree HEAD.
  # Content-addressed restore-evidence gate (T-0027 discipline): deletion
  # requires a valid per-slug receipt at
  # <manifest-dir>/restore-receipts/<slug>.json.  A CLI flag
  # (--restore-proven) or a restore-proven.txt marker is NOT evidence —
  # either alone is a SKIP.  The receipt validates only when:
  #   - schema == "restore-receipt/v1", epic_id == slug
  #   - content_sha256 self-verifies over the canonical JSON body
  #   - runtime_id and dependency_generation_id match the manifest's
  #     canonical read (the receipt binds the manifest's content-addressed
  #     identities)
  #   - runtime_root resolves to the manifest's runtime_root and
  #     closed_head equals the live worktree HEAD (the receipt is bound to
  #     THIS runtime's current closed content)
  #   - restored_at is ISO and restore_drill is non-empty
  # Any failure -> the receipt is not restore evidence: SKIP (never delete).
  # Sets RESTORE_RECEIPT_REASON; returns 0 only on a fully valid receipt.
  local slug="$1" mf="$2" live_head="$3"
  local receipt="$MANIFEST_DIR/restore-receipts/$slug.json"
  if [[ ! -f "$receipt" ]]; then
    RESTORE_RECEIPT_REASON="no content-addressed restore receipt at '$receipt' (a CLI flag or restore-proven.txt is NOT restore evidence)"
    return 1
  fi
  local verdict
  verdict="$(_restore_receipt_python "$receipt" "$slug" "$mf" "$live_head" "$ROOT" 2>&1 || true)"
  if [[ "$verdict" == "OK" ]]; then
    RESTORE_RECEIPT_REASON=""
    return 0
  fi
  RESTORE_RECEIPT_REASON="${verdict#FAIL }"
  if [[ -z "$RESTORE_RECEIPT_REASON" ]]; then
    RESTORE_RECEIPT_REASON="restore receipt validation failed (unreadable validator?)"
  fi
  return 1
}

for mf in "$MANIFEST_DIR"/*.json; do
  # G5 round-5 finding 3(b): only a GENUINELY absent manifest (ENOENT — never
  # created, or archived/removed by a previous sweep) may be skipped.  A
  # PRESENT-but-unreadable entry — a DANGLING symlink (`[[ -f ]]`/`[[ -e ]]`
  # follow the link to its missing target and report false, hiding the entry)
  # or a stat-inaccessible path (EACCES on the file or a parent dir) — is
  # never silently skipped: it reaches the canonical validator below and
  # fails closed with NEEDS-RECONCILE.  `stat` without `-L` reports on the
  # ENTRY itself (lstat semantics), so the link entry stays visible even
  # when its target is gone; the error message is the only reliable
  # absent-vs-inaccessible signal (an EACCES parent fails the -e/-L probes
  # too, exactly like ENOENT).
  if ! stat "$mf" >/dev/null 2>&1; then
    # stat failed on the entry: only ENOENT (genuinely absent) may be
    # skipped.  EACCES and friends (unreadable file or parent dir) fail the
    # -e/-L probes exactly like ENOENT, so the error text is the only
    # reliable absent-vs-inaccessible signal.  Captured in a variable and
    # matched with [[ ]] — a bare `stat ... | grep` pipeline would be
    # defeated by `set -o pipefail` (stat's exit code wins over grep's).
    if ! STAT_ERR="$(stat "$mf" 2>&1)"; then
      if [[ "$STAT_ERR" == *"No such file"* ]]; then
        continue  # genuinely absent (ENOENT)
      fi
    fi
    echo "gc-sweep: NEEDS-RECONCILE manifest '$mf' — present but stat-inaccessible; never deleted automatically"
    continue
  fi
  # G5 round-2 finding 4: the manifest is read ONCE through the canonical
  # fail-closed validator (runtime_manifest.load_manifest, same as
  # bootstrap_manifest) — NOT raw json.load + dotted-field reads.  A
  # schema-invalid manifest (valid JSON, wrong structure — e.g. missing
  # required fields while still carrying state/epic.runtime_root/epic.branch)
  # is treated EXACTLY like a corrupt one: NEEDS-RECONCILE for that tree,
  # never deletable, and never a whole-sweep abort.  Only a fully
  # schema-valid manifest yields sweep-decision fields.
  if ! FIELDS="$(_manifest_fields "$mf")"; then
    echo "gc-sweep: NEEDS-RECONCILE manifest '$mf' — present but unreadable, corrupt, or schema-invalid (a dangling symlink fails the canonical read the same way); never deleted automatically"
    continue
  fi
  IFS=$'\t' read -r SLUG STATE ROOT BRANCH VENV DEPGEN RUNTIME_ID DEPGEN_ID <<<"$FIELDS"

  if [[ "$STATE" != "active" && "$STATE" != "closed" ]]; then
    echo "gc-sweep: NEEDS-RECONCILE manifest '$mf' (state='${STATE:-<missing>}') — neither live nor closed; never deleted automatically"
    continue
  fi
  # T-0301 GC gate: a manifest whose dependency-generation proof is missing
  # or incomplete cannot attest its dependency state.  Unknown dependency
  # state blocks GC: the runtime (and its shared generation) is never
  # deleted while the proof is unverifiable (fail-closed, G10).
  if [[ "$DEPGEN" != "1" ]]; then
    echo "gc-sweep: NEEDS-RECONCILE manifest '$mf' — dependency generation proof missing or incomplete; GC cannot attest the runtime's dependency state (T-0301); never deleted automatically"
    continue
  fi
  if [[ -z "$ROOT" || ! -d "$ROOT" ]]; then
    echo "gc-sweep: SKIP '$SLUG' — runtime_root '$ROOT' already gone (nothing to sweep)"
    continue
  fi
  if [[ "$STATE" == "active" ]]; then
    echo "gc-sweep: SKIP '$SLUG' — manifest state=active; an executing/editable runtime is never deleted (design rule 0/6)"
    continue
  fi

  # Closed only: (a) origin-resolvable — a hard gate, enforced even in dry-run.
  if ! LOCAL_HEAD="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null)"; then
    echo "gc-sweep: SKIP '$SLUG' — '$ROOT' is not a git tree; needs-reconcile"
    continue
  fi
  ORIGIN_HEAD="$(git -C "$ROOT" ls-remote "$REMOTE" "refs/heads/$BRANCH" 2>/dev/null | awk '{print $1}')"
  if [[ -z "$ORIGIN_HEAD" ]]; then
    echo "gc-sweep: SKIP '$SLUG' — origin-resolvable check FAILED: refs/heads/$BRANCH missing on '$REMOTE' (origin==local is NOT a deletion predicate; resolve origin first)"
    continue
  fi
  if [[ "$LOCAL_HEAD" != "$ORIGIN_HEAD" ]]; then
    echo "gc-sweep: SKIP '$SLUG' — origin-resolvable check FAILED: local $LOCAL_HEAD != origin $ORIGIN_HEAD for refs/heads/$BRANCH"
    continue
  fi

  # (b) schedule-store reconciliation: a CLOSED + origin-resolvable tree may
  #     STILL be load-bearing for scheduled work — probe-4 trees must never be
  #     swept. A reference to the tree's slug or sha in any schedule store is
  #     a hard SKIP (checked for real and in dry-run alike).
  SCHEDULE_STORE_HIT=""
  SCHEDULE_REFERENCED=0
  if _schedule_store_references "$SLUG" "$LOCAL_HEAD"; then
    SCHEDULE_REFERENCED=1
  fi

  # (c) restore-proven: deletion is gated on a CONTENT-ADDRESSED restore
  #     receipt, NOT on a CLI flag (T-0027 discipline: --restore-proven is
  #     never evidence — the restore must have a verifiable receipt) and NOT
  #     on origin==local (design rule 6 / Phase 5).  The per-slug receipt at
  #     <manifest-dir>/restore-receipts/<slug>.json must exist and validate
  #     (schema, epic_id, runtime_id + dependency_generation.id bound to the
  #     manifest's canonical read, runtime_root/closed_head bound to the live
  #     tree, content_sha256 self-verifies).  A CLI flag alone or a
  #     restore-proven.txt marker alone is a SKIP — never a deletion.
  RESTORE_OK=0
  RESTORE_RECEIPT_REASON=""
  if _restore_receipt_check "$SLUG" "$mf" "$LOCAL_HEAD"; then
    RESTORE_OK=1
  fi

  # (d) fixer-branch open-PR gate (P6 terminal-state rules): when the caller
  #     asks to delete the manifest-declared fixer branch, the sweep refuses
  #     while a pull ref on the remote still points at the branch head — an
  #     open PR is load-bearing and the branch must never be deleted under it.
  #     The gate is checked BEFORE the worktree removal (and before dry-run so
  #     the preview reports it too).  REFUSE is a FAIL-CLOSED terminal-state
  #     violation: it exits 3 (like promote's CAS rejection) so the P6
  #     terminal finalizer can detect the refusal and block instead of
  #     believing the sweep succeeded.
  PR_REFERENCED=0
  if [[ -n "$FIXER_BRANCH" && "$BRANCH" == "$FIXER_BRANCH" ]]; then
    PULL_HEADS="$(git -C "$ROOT" ls-remote "$REMOTE" "refs/pull/*/head" 2>/dev/null | awk '{print $1}')"
    if [[ -n "$PULL_HEADS" ]] && grep -qxF "$ORIGIN_HEAD" <<<"$PULL_HEADS"; then
      PR_REFERENCED=1
    fi
  fi

  # (e) reference census (T-0012): consulted before EVERY deletion (worktree,
  #     branch, and venv/dependency).  REFERENCED hard-skips; DANGLING is
  #     NEEDS-RECONCILE (never deleted); UNKNOWN (unreadable/corrupt store)
  #     BLOCKS the sweep with exit 5 — delete-on-unknown never happens.  The
  #     gate runs in dry-run too so the preview reports it.
  _reference_census "$ROOT" "$mf"
  if [[ "$CENSUS_VERDICT" == "REFERENCED" ]]; then
    if [[ "$DRY" == "1" ]]; then
      echo "gc-sweep: WOULD-SKIP '$SLUG' — REFERENCED: runtime root '$ROOT' is still referenced by the reference census; sweep would be skipped (referenced runtime roots are never deleted, design rule 6):"
    else
      echo "gc-sweep: SKIP '$SLUG' — SWEPT=NO:REFERENCED: runtime root '$ROOT' is still referenced by the reference census; never deleted (design rule 6):"
    fi
    printf '%s\n' "$CENSUS_REPORT" | awk '!/^STATUS /' | sed 's/^/gc-sweep:   /'
    continue
  fi
  if [[ "$CENSUS_VERDICT" == "DANGLING" ]]; then
    echo "gc-sweep: NEEDS-RECONCILE '$SLUG' — SWEPT=NO:DANGLING: reference census found a dangling runtime-root reference; never deleted automatically:"
    printf '%s\n' "$CENSUS_REPORT" | awk '!/^STATUS /' | sed 's/^/gc-sweep:   /'
    continue
  fi
  if [[ "$CENSUS_VERDICT" == "UNKNOWN" ]]; then
    if [[ "$DRY" == "1" ]]; then
      echo "gc-sweep: WOULD-BLOCK '$SLUG' — UNKNOWN: reference census unreadable/corrupt; the sweep would be blocked:"
      printf '%s\n' "$CENSUS_REPORT" | awk '!/^STATUS /' | sed 's/^/gc-sweep:   /'
      continue
    fi
    echo "gc-sweep: UNKNOWN '$SLUG' — reference census unreadable/corrupt; deletion BLOCKED (fail-closed: delete-on-unknown never happens, exit 5):" >&2
    printf '%s\n' "$CENSUS_REPORT" | awk '!/^STATUS /' | sed 's/^/gc-sweep:   /' >&2
    exit 5
  fi

  if [[ "$DRY" == "1" ]]; then
    if [[ "$PR_REFERENCED" == "1" ]]; then
      echo "gc-sweep: WOULD-REFUSE '$SLUG' — fixer branch '$FIXER_BRANCH' head is still referenced by an open pull ref on '$REMOTE'; sweep would be refused (P6 terminal-state rules never sweep with a PR open)"
      continue
    fi
    if [[ "$SCHEDULE_REFERENCED" == "1" ]]; then
      echo "gc-sweep: WOULD-SKIP '$SLUG' — schedule-store-referenced (store '$SCHEDULE_STORE_HIT' references slug/sha); probe-4 trees must never be swept"
    elif [[ "$RESTORE_OK" == "1" ]]; then
      note=""
      if [[ -n "$FIXER_BRANCH" && "$BRANCH" == "$FIXER_BRANCH" ]]; then
        note="; fixer branch '$FIXER_BRANCH' would be deleted local + remote"
      fi
      echo "gc-sweep: WOULD-SWEEP '$SLUG' — worktree '$ROOT' (closed, origin-resolvable, restore-proven, schedule-store-clear); manifest would archive to '$ARCHIVE_DIR'$note"
    else
      echo "gc-sweep: WOULD-SWEEP '$SLUG' — worktree '$ROOT' (closed, origin-resolvable; content-addressed restore receipt STILL REQUIRED before actual deletion: $RESTORE_RECEIPT_REASON)"
    fi
    continue
  fi
  if [[ "$PR_REFERENCED" == "1" ]]; then
    echo "gc-sweep: REFUSE '$SLUG' — fixer branch '$FIXER_BRANCH' head is still referenced by an open pull ref on '$REMOTE'; refusing to sweep (P6 terminal-state rules never sweep with a PR open)" >&2
    exit 3
  fi
  if [[ "$RESTORE_OK" != "1" ]]; then
    echo "gc-sweep: SKIP '$SLUG' — not restore-proven: $RESTORE_RECEIPT_REASON (a content-addressed restore receipt must validate before deletion)"
    continue
  fi
  if [[ "$SCHEDULE_REFERENCED" == "1" ]]; then
    echo "gc-sweep: SKIP '$SLUG' — schedule-store-referenced (store '$SCHEDULE_STORE_HIT' references slug/sha); probe-4 trees must never be swept"
    continue
  fi

  # Sweep: registered-worktree removal only — never rm -rf a tree blindly.
  if git -C "$BASE_REPO" worktree remove --force "$ROOT" 2>/dev/null; then
    : # worktree removed
  else
    echo "gc-sweep: SKIP '$SLUG' — 'git worktree remove --force' failed for '$ROOT' (not a registered worktree of '$BASE_REPO'?); needs-reconcile, not deleted"
    continue
  fi

  # Epic venv that lives OUTSIDE the removed tree (per-epic venvs inside the
  # tree die with it).  The venv path goes through the SAME reference census
  # (T-0012) as the worktree, BEFORE any deletion: a lease/schedule/queue
  # referencing the exact venv path is load-bearing and the venv must never
  # be rm -rf'd without a CLEAR verdict (G2 hardening — venv deletion was
  # previously uncensused; only the worktree root was checked).  VENV came
  # from the canonical manifest read above (epic.venv_path is a required
  # schema field, present for every validated manifest).
  VENV_OK=1
  if [[ -n "$VENV" && -e "$VENV" && "$VENV" != "$ROOT" && "$VENV" != "$ROOT/"* ]]; then
    _reference_census "$VENV" "$mf"
    if [[ "$CENSUS_VERDICT" == "REFERENCED" ]]; then
      VENV_OK=0
      echo "gc-sweep: SKIP venv '$VENV' — REFERENCED: exact venv path still referenced by the reference census; never deleted (design rule 6):"
      printf '%s\n' "$CENSUS_REPORT" | awk '!/^STATUS /' | sed 's/^/gc-sweep:   /'
    elif [[ "$CENSUS_VERDICT" == "DANGLING" ]]; then
      VENV_OK=0
      echo "gc-sweep: NEEDS-RECONCILE venv '$VENV' — DANGLING: reference census found a dangling runtime-root reference; venv never deleted automatically:"
      printf '%s\n' "$CENSUS_REPORT" | awk '!/^STATUS /' | sed 's/^/gc-sweep:   /'
    elif [[ "$CENSUS_VERDICT" == "UNKNOWN" ]]; then
      echo "gc-sweep: UNKNOWN venv '$VENV' — reference census unreadable/corrupt; venv deletion BLOCKED (fail-closed: delete-on-unknown never happens, exit 5):" >&2
      printf '%s\n' "$CENSUS_REPORT" | awk '!/^STATUS /' | sed 's/^/gc-sweep:   /' >&2
      exit 5
    fi
  fi

  # Epic venv that lives OUTSIDE the removed tree: deleted only when the
  # census above returned CLEAR (a REFERENCED/DANGLING venv was already
  # reported and is never rm -rf'd; UNKNOWN blocked the sweep pre-deletion).
  if [[ "$VENV_OK" == "1" && -n "$VENV" && -e "$VENV" && "$VENV" != "$ROOT" && "$VENV" != "$ROOT/"* ]]; then
    rm -rf "$VENV"
    echo "gc-sweep: removed epic venv '$VENV'"
  fi

  # P6 terminal finalizer: delete the manifest-declared fixer branch (local +
  # remote) after a restore-proven sweep.  The open-PR gate above already
  # refused the sweep while the branch head was load-bearing; here the branch
  # is only deleted for the manifest that declares it (fail-closed: never
  # delete a branch this manifest did not declare).
  if [[ -n "$FIXER_BRANCH" && "$BRANCH" == "$FIXER_BRANCH" ]]; then
    if git -C "$BASE_REPO" branch -D "$FIXER_BRANCH" >/dev/null 2>&1; then
      echo "gc-sweep: deleted local fixer branch '$FIXER_BRANCH'"
    else
      echo "gc-sweep: note — local fixer branch '$FIXER_BRANCH' already gone"
    fi
    if git -C "$BASE_REPO" push "$REMOTE" --delete "$FIXER_BRANCH" >/dev/null 2>&1; then
      echo "gc-sweep: deleted remote fixer branch '$FIXER_BRANCH' on '$REMOTE'"
    else
      echo "gc-sweep: note — remote fixer branch '$FIXER_BRANCH' already gone on '$REMOTE'"
    fi
  fi

  mv "$mf" "$ARCHIVE_DIR/"
  echo "gc-sweep: SWEPT=YES '$SLUG' — worktree '$ROOT' removed; manifest archived to '$ARCHIVE_DIR/$(basename "$mf")'"
done

# Runner death mid-epic leaves a tree without a manifest: never delete, list it.
if [[ -d "$BASE_DIR/runtime-candidates" ]]; then
  for d in "$BASE_DIR"/runtime-candidates/*/; do
    [[ -d "$d" ]] || continue
    slug="$(basename "$d")"
    if [[ ! -f "$MANIFEST_DIR/$slug.json" ]]; then
      echo "gc-sweep: NEEDS-RECONCILE tree '$d' — no manifest for slug '$slug' (runner death mid-epic?); never deleted automatically"
    fi
  done
fi

echo "gc-sweep: done (--dry-run=$DRY --restore-proven=$RESTORE_PROVEN${FIXER_BRANCH:+ --fixer-branch=$FIXER_BRANCH})"

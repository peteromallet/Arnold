    [[ "$root_pid" =~ ^[0-9]+$ && "$victim_pid" =~ ^[0-9]+$ && -n "$expected_start" ]] || return 78
    arnold_supervisor_python - "$root_pid" "$victim_pid" "$expected_start" <<'PY'

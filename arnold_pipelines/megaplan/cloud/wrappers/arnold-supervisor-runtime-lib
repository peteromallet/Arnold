        continue
    observed = {value.get(key) for key in ("victim_pid", "pid", "supervisor_pid", "worker_pid", "root_pid")}
    root_candidates = {value.get(key) for key in ("root_pid", "supervisor_pid", "pid", "victim_pid", "worker_pid")}
    if pid in observed or int(sys.argv[3]) in root_candidates:
        matches.append(path)
if len(matches) != 1:
    raise SystemExit(78)
print(matches[0])
PY
    )" || return 78
    arnold_supervisor_bind_signal_context "$marker_path" "$target_kind" || return 78
    export MEGAPLAN_NBF_TARGET_PID="$victim_pid"
    export MEGAPLAN_NBF_TARGET_PROCESS_START="$expected_start"
    # Revalidate after reading the marker as well: marker lookup must not open
    # a PID-reuse or detached-child window between admission and delivery.
    arnold_supervisor_validate_descendant "$root_pid" "$victim_pid" "$expected_start" || return 78
  }
  export -f arnold_supervisor_bind_signal_context_for_pid
  arnold_supervisor_tmux_session_socket() {
    local session="${1:-}" socket marker_path
    [[ -n "$session" ]] || return 78
    marker_path="${MEGAPLAN_NBF_MARKER_DIR:-${MARKER_DIR:-/workspace/.megaplan/cloud-sessions}}/$session.json"
    socket="$(arnold_supervisor_python - "$marker_path" <<'PY'

  export -f arnold_supervisor_tmux_session_socket
  arnold_supervisor_tmux_session_exists() {
    local session="${1:-}" socket marker_path expected current_pid current_start expected_pid expected_start
    socket="$(arnold_supervisor_tmux_session_socket "$session")" || return 1
    marker_path="${MEGAPLAN_NBF_MARKER_DIR:-${MARKER_DIR:-/workspace/.megaplan/cloud-sessions}}/$session.json"
    expected="$(arnold_supervisor_python - "$marker_path" <<'PY'

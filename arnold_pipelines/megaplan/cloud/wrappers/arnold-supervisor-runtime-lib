#!/usr/bin/env bash
# Shared fail-closed interpreter selection for cloud recovery supervisors.

arnold_supervisor_failure_artifact() {
  local component="${1:-unknown}"
  local reason="${2:-runtime_not_ready}"
  local status_dir="${MEGAPLAN_SUPERVISOR_STATUS_DIR:-${CLOUD_WATCHDOG_STATUS_DIR:-/workspace/.megaplan/status}}"
  local target="$status_dir/${component}.supervisor-runtime-failure.json"
  local tmp stamp
  mkdir -p "$status_dir" 2>/dev/null || return 1
  tmp="$(mktemp "$status_dir/.${component}.runtime-failure.XXXXXX")" || return 1
  stamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  # Values are controlled tokens, not untrusted stderr. Keep this writer
  # dependency-independent so it still works when Python imports do not.
  printf '{"at":"%s","component":"%s","reason":"%s","schema_version":"arnold-supervisor-runtime-failure-v1","status":"failed"}\n' \
    "$stamp" "$component" "$reason" > "$tmp"
  mv -f "$tmp" "$target"
}

arnold_supervisor_stdlib_init() {
  local component="${1:-unknown}"
  local preferred="${MEGAPLAN_SUPERVISOR_PYTHON:-/workspace/.megaplan/supervisor-python/current/bin/python3}"
  local resolved=""

  if [[ -x "$preferred" ]]; then
    resolved="$(readlink -f "$preferred" 2>/dev/null || printf '%s' "$preferred")"
  else
    resolved="$(command -v python3 2>/dev/null || true)"
    resolved="$(readlink -f "$resolved" 2>/dev/null || printf '%s' "$resolved")"
  fi
  if [[ -z "$resolved" || ! -x "$resolved" ]]; then
    arnold_supervisor_failure_artifact "$component" "stdlib_interpreter_unavailable"
    printf '%s\n' "$component: stdlib interpreter unavailable" >&2
    return 78
  fi
  export MEGAPLAN_SUPERVISOR_STDLIB_PYTHON="$resolved"
}

arnold_supervisor_runtime_init() {
  local component="${1:-unknown}"
  local source_root="${2:-/workspace/arnold}"
  local preferred="${MEGAPLAN_SUPERVISOR_PYTHON:-/workspace/.megaplan/supervisor-python/current/bin/python3}"
  local runtime_root="${MEGAPLAN_SUPERVISOR_RUNTIME_ROOT:-/workspace/.megaplan/supervisor-python}"
  local runtime_receipt="${MEGAPLAN_SUPERVISOR_RUNTIME_RECEIPT:-$runtime_root/last-prepare.json}"
  local required="${MEGAPLAN_SUPERVISOR_RUNTIME_REQUIRED:-0}"
  local resolved=""

  if [[ -x "$preferred" ]]; then
    resolved="$(readlink -f "$preferred" 2>/dev/null || printf '%s' "$preferred")"
  elif [[ "$required" == "1" ]]; then
    arnold_supervisor_failure_artifact "$component" "dedicated_interpreter_missing"
    printf '%s\n' "$component: dedicated supervisor interpreter missing: $preferred" >&2
    return 78
  else
    resolved="$(command -v python3 2>/dev/null || true)"
    resolved="$(readlink -f "$resolved" 2>/dev/null || printf '%s' "$resolved")"
  fi

  if [[ -z "$resolved" || ! -x "$resolved" ]]; then
    arnold_supervisor_failure_artifact "$component" "interpreter_unavailable"
    printf '%s\n' "$component: supervisor interpreter unavailable" >&2
    return 78
  fi

  local isolated=0
  # A system/control interpreter may also contain a noneditable Arnold wheel.
  # It is the dedicated supervisor only when the durable prepare receipt binds
  # this exact prefix, source, and import vector.
  if env -u PYTHONPATH PYTHONSAFEPATH=1 "$resolved" -P - \
    "$runtime_receipt" "$source_root" <<'PY' \
    >/dev/null 2>&1; then
import importlib.metadata
import json
import pathlib
import sys
import urllib.parse

receipt_path, source = map(pathlib.Path, sys.argv[1:])
receipt = json.loads(receipt_path.read_text())
direct_url = json.loads(
    importlib.metadata.distribution("arnold").read_text("direct_url.json") or "{}"
)
runtime = pathlib.Path(receipt.get("runtime", "")).resolve()
if bool((direct_url.get("dir_info") or {}).get("editable")):
    raise SystemExit(1)
parsed_source = urllib.parse.urlparse(str(direct_url.get("url") or ""))
if parsed_source.scheme != "file":
    raise SystemExit(1)
installed_source = pathlib.Path(
    urllib.parse.unquote(parsed_source.path)
).resolve()
if installed_source != source.resolve():
    raise SystemExit(1)
if runtime != pathlib.Path(sys.prefix).resolve():
    raise SystemExit(1)
if pathlib.Path(receipt.get("source", "")).resolve() != source.resolve():
    raise SystemExit(1)
import arnold
import arnold_pipelines
import arnold_pipelines.megaplan
imports = {
    "arnold": str(pathlib.Path(arnold.__file__).resolve()),
    "arnold_pipelines": str(pathlib.Path(arnold_pipelines.__file__).resolve()),
    "megaplan": str(pathlib.Path(arnold_pipelines.megaplan.__file__).resolve()),
}
if imports != receipt.get("imports"):
    raise SystemExit(1)
if any(not pathlib.Path(value).is_relative_to(runtime) for value in imports.values()):
    raise SystemExit(1)
PY
    isolated=1
  fi
  if [[ "$isolated" == "1" ]]; then
    # Gap 3: bind the supervisor import path to the canonical Arnold source root
    # even in isolated mode. The venv supplies dependencies + interpreter; the
    # Arnold CODE must come from the same canonical tree the fixers patch, not
    # a static site-packages copy, so watchdog/repair fixes actually take.
    if ! PYTHONSAFEPATH=1 PYTHONPATH="$source_root" \
      "$resolved" -P -c 'import yaml; import arnold_pipelines.megaplan.cloud.cli; import arnold_pipelines.megaplan.cloud.repair_contract' \
      >/dev/null 2>&1; then
      arnold_supervisor_failure_artifact "$component" "readiness_import_failed"
      printf '%s\n' "$component: supervisor interpreter readiness import failed: $resolved" >&2
      return 78
    fi
  elif ! PYTHONSAFEPATH=1 PYTHONPATH="$source_root" \
    "$resolved" -P -c 'import yaml; import arnold_pipelines.megaplan.cloud.cli; import arnold_pipelines.megaplan.cloud.repair_contract' \
    >/dev/null 2>&1; then
    arnold_supervisor_failure_artifact "$component" "readiness_import_failed"
    printf '%s\n' "$component: supervisor interpreter readiness import failed: $resolved" >&2
    return 78
  fi

  export MEGAPLAN_SUPERVISOR_PYTHON="$resolved"
  # MEGAPLAN_SUPERVISOR_SOURCE_ROOT is a NON-SELECTING internal binding: it is
  # exported by THIS lib from the fixed/manifest source_root parameter and read
  # back only by this lib's own helpers (arnold_supervisor_python,
  # arnold_supervisor_select_exact_fallback). It is never read from the ambient
  # environment to select a runtime — the manifest epic.runtime_root is the
  # only runtime selector (G4); do not re-introduce an env-selector read.
  export MEGAPLAN_SUPERVISOR_SOURCE_ROOT="$source_root"
  export MEGAPLAN_SUPERVISOR_ISOLATED="$isolated"
  arnold_supervisor_python() {
    local need_safe_path=1
    local arg
    for arg in "$@"; do
      case "$arg" in
        -P)
          need_safe_path=0
          break
          ;;
        --|-c|-m|-)
          break
          ;;
        -*)
          ;;
        *)
          break
          ;;
      esac
    done
    if [[ "$MEGAPLAN_SUPERVISOR_ISOLATED" == "1" && "$need_safe_path" == "1" ]]; then
      PYTHONSAFEPATH=1 \
        PYTHONPATH="$MEGAPLAN_SUPERVISOR_SOURCE_ROOT" \
        "$MEGAPLAN_SUPERVISOR_PYTHON" -P "$@"
    elif [[ "$MEGAPLAN_SUPERVISOR_ISOLATED" == "1" ]]; then
      PYTHONSAFEPATH=1 \
        PYTHONPATH="$MEGAPLAN_SUPERVISOR_SOURCE_ROOT" \
        "$MEGAPLAN_SUPERVISOR_PYTHON" "$@"
    elif [[ "$need_safe_path" == "1" ]]; then
      PYTHONSAFEPATH=1 \
        PYTHONPATH="$MEGAPLAN_SUPERVISOR_SOURCE_ROOT" \
        "$MEGAPLAN_SUPERVISOR_PYTHON" -P "$@"
    else
      PYTHONSAFEPATH=1 \
        PYTHONPATH="$MEGAPLAN_SUPERVISOR_SOURCE_ROOT" \
        "$MEGAPLAN_SUPERVISOR_PYTHON" "$@"
    fi
  }
  export -f arnold_supervisor_python
  # Canonical shell-to-ledger signal door.  Shell supervisors must provide a
  # durable ledger and all identity dimensions; this helper deliberately
  # returns non-zero (without signalling) when any authority input is absent.
  arnold_supervisor_bind_signal_context() {
    local authority_path="${1:-}" requested_kind="${2:-non_worker}"
    [[ -n "$authority_path" && "$authority_path" = /* && -f "$authority_path" && ! -L "$authority_path" ]] || return 78
    local marker_dir session context_fields
    marker_dir="$(cd "$(dirname "$authority_path")" 2>/dev/null && pwd -P)" || return 78
    context_fields="$(arnold_supervisor_python - "$authority_path" "$requested_kind" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
target_kind = sys.argv[2]
try:
    data = json.loads(path.read_text(encoding="utf-8"))
except Exception:
    raise SystemExit(78)
if not isinstance(data, dict) or not isinstance(data.get("session"), str) or not data["session"]:
    raise SystemExit(78)
if target_kind not in {"worker", "non_worker"}:
    raise SystemExit(78)
required = {
    "workspace": data.get("workspace"),
    "run_id": data.get("run_id"),
    "bootstrap_manifest_path": data.get("bootstrap_manifest_path", data.get("manifest_path")),
    "supervisor_process_start_identity": data.get("supervisor_process_start_identity"),
    "boot_identity": data.get("boot_identity"),
    "container_identity": data.get("container_identity"),
}
if any(not isinstance(value, str) or not value.strip() for key, value in required.items() if key != "tmux_server_pid"):
    raise SystemExit(78)
tmux_keys = ("tmux_socket", "tmux_socket_fingerprint", "tmux_server_pid",
             "tmux_server_process_start_identity", "tmux_session_id",
             "tmux_owned_pane_id", "tmux_owned_pane_pid",
             "tmux_owned_pane_process_start_identity", "tmux_owned_pane_command",
             "tmux_all_panes_digest")
tmux_present = [key for key in tmux_keys if data.get(key) not in (None, "")]
if tmux_present:
    if len(tmux_present) != len(tmux_keys):
        raise SystemExit(78)
    tmux_socket = data["tmux_socket"]
    server_pid = data["tmux_server_pid"]
    if isinstance(server_pid, str) and server_pid.isdigit():
        server_pid = int(server_pid)
    if not isinstance(tmux_socket, str) or not tmux_socket.startswith("/") or not isinstance(server_pid, int) or server_pid <= 0:
        raise SystemExit(78)
else:
    tmux_socket = ""
    server_pid = ""
    data["tmux_server_process_start_identity"] = ""
print("\t".join((data["session"], str(path.resolve()), str(path.parent.resolve()), target_kind,
                  *(str(required[key]) for key in ("workspace", "run_id", "bootstrap_manifest_path",
                                                    "supervisor_process_start_identity", "boot_identity",
                                                    "container_identity")),
                  str(tmux_socket), str(server_pid),
                  str(data.get("tmux_server_process_start_identity", "")))))
PY
)" || return 78
    local session marker_path bound_marker_dir target_kind workspace run_id manifest_path supervisor_start boot_identity container_identity tmux_socket tmux_server_pid tmux_server_start
    IFS=$'\t' read -r session marker_path bound_marker_dir target_kind workspace run_id manifest_path supervisor_start boot_identity container_identity tmux_socket tmux_server_pid tmux_server_start <<< "$context_fields"
    [[ "$(basename "$authority_path")" == "$session.json" && "$marker_path" == "$(cd "$(dirname "$authority_path")" && pwd -P)/$(basename "$authority_path")" ]] || return 78
    [[ "$bound_marker_dir" == "$marker_dir" && "$target_kind" == "$requested_kind" ]] || return 78
    # The marker-bound workspace is the canonical IncidentLedger root. Bind it
    # here, after the marker identity has been validated, so callers do not
    # depend on an ambient ledger-root variable. Reject malformed workspaces
    # and any pre-existing ambient root that disagrees with this authority.
    [[ "$workspace" = /* && -d "$workspace" && ! -L "$workspace" ]] || return 78
    workspace="$(cd "$workspace" 2>/dev/null && pwd -P)" || return 78
    [[ -d "$workspace/.megaplan/incident-ledger" ]] || return 78
    local ambient_ledger_root="${MEGAPLAN_NBF_LEDGER_ROOT:-}" ambient_ledger_canonical=""
    if [[ -n "$ambient_ledger_root" ]]; then
      [[ "$ambient_ledger_root" = /* && -d "$ambient_ledger_root" && ! -L "$ambient_ledger_root" ]] || return 78
      ambient_ledger_canonical="$(cd "$ambient_ledger_root" 2>/dev/null && pwd -P)" || return 78
      [[ "$ambient_ledger_canonical" == "$workspace" ]] || return 78
    fi
    export MEGAPLAN_NBF_MARKER_DIR="$bound_marker_dir"
    export MEGAPLAN_NBF_SESSION="$session"
    export MEGAPLAN_NBF_MARKER_PATH="$marker_path"
    export MEGAPLAN_NBF_TARGET_KIND="$target_kind"
    export MEGAPLAN_NBF_WORKSPACE="$workspace"
    export MEGAPLAN_NBF_RUN_ID="$run_id"
    export MEGAPLAN_NBF_BOOTSTRAP_MANIFEST_PATH="$manifest_path"
    export MEGAPLAN_NBF_SUPERVISOR_PROCESS_START_IDENTITY="$supervisor_start"
    export MEGAPLAN_NBF_BOOT_IDENTITY="$boot_identity"
    export MEGAPLAN_NBF_CONTAINER_IDENTITY="$container_identity"
    export MEGAPLAN_NBF_TMUX_SOCKET="$tmux_socket"
    export MEGAPLAN_NBF_TMUX_SERVER_PID="$tmux_server_pid"
    export MEGAPLAN_NBF_TMUX_SERVER_START="$tmux_server_start"
    export MEGAPLAN_NBF_AUTHORITY_PATH="$marker_path"
    export MEGAPLAN_NBF_LEDGER_ROOT="$workspace"
    export MEGAPLAN_NBF_CONTEXT_BOUND=1
  }
  export -f arnold_supervisor_bind_signal_context
  arnold_supervisor_bind_signal_context_for_session() {
    local session="${1:-}" marker_dir="${2:-${MEGAPLAN_NBF_MARKER_DIR:-/workspace/.megaplan/cloud-sessions}}" target_kind="${3:-non_worker}"
    [[ "$session" =~ ^[A-Za-z0-9_.-]+$ && "$marker_dir" = /* ]] || return 78
    local marker_path="$marker_dir/$session.json"
    [[ -f "$marker_path" && ! -L "$marker_path" ]] || return 78
    arnold_supervisor_bind_signal_context "$marker_path" "$target_kind" || return 78
  }
  export -f arnold_supervisor_bind_signal_context_for_session
  arnold_supervisor_bind_signal_context_for_pid() {
    local victim_pid="${1:-}" marker_dir="${2:-/workspace/.megaplan/cloud-sessions}" target_kind="${3:-non_worker}"
    local root_pid="${4:-$victim_pid}" expected_start="${5:-}" marker_path
    [[ "$victim_pid" =~ ^[0-9]+$ && "$root_pid" =~ ^[0-9]+$ && "$marker_dir" = /* ]] || return 78
    if [[ -z "$expected_start" ]]; then
      expected_start="$(arnold_supervisor_process_start "$victim_pid" 2>/dev/null || true)"
    fi
    [[ -n "$expected_start" ]] || return 78
    # This is deliberately before marker admission and immediately before the
    # signal door: a child is admissible only while its pinned incarnation is
    # still descended from the marker's root. Never inherit the root PID as
    # the physical target.
    arnold_supervisor_validate_descendant "$root_pid" "$victim_pid" "$expected_start" || return 78
    marker_path="$(arnold_supervisor_python - "$marker_dir" "$victim_pid" "$root_pid" <<'PY'
import json
import pathlib
import sys
root = pathlib.Path(sys.argv[1])
pid = int(sys.argv[2])
matches = []
for path in sorted(root.glob("*.json")):
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        continue

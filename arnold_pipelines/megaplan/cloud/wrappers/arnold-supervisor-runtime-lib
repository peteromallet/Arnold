    [[ -n "$session" && -f "$marker_path" && "$socket" = /* ]] || return 78
    expected="$(arnold_supervisor_python - "$marker_path" <<'PY'
import json
import pathlib
import sys
marker = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
if not isinstance(marker, dict):
    raise SystemExit(78)
pid = marker.get("pid", marker.get("pane_pid", marker.get("victim_pid")))
start = marker.get("process_start_identity", marker.get("pane_process_start_identity", marker.get("victim_process_start_identity")))
pane_id = marker.get("pane_id", marker.get("tmux_pane_id", ""))

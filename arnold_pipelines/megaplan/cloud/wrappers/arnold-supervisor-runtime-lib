    raise SystemExit(78)
if pane_id and not isinstance(pane_id, str):
    raise SystemExit(78)
print("\t".join((str(pane_id), str(pid), start)))
PY
    )" || return 78
    local expected_id expected_pid expected_start rows pane_id pane_pid pane_command pane_start matches=0 match=""
    IFS=$'\t' read -r expected_id expected_pid expected_start <<< "$expected"
    rows="$(tmux -S "$socket" list-panes -t "=$session" -F '#{pane_id}	#{pane_pid}	#{pane_current_command}' 2>/dev/null)" || return 78
    while IFS=$'\t' read -r pane_id pane_pid pane_command; do

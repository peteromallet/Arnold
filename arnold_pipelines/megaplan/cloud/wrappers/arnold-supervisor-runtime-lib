#!/usr/bin/env bash
# Shared fail-closed interpreter selection for cloud recovery supervisors.

arnold_supervisor_failure_artifact() {
  local component="${1:-unknown}"
  local reason="${2:-runtime_not_ready}"
  local status_dir="${MEGAPLAN_SUPERVISOR_STATUS_DIR:-${CLOUD_WATCHDOG_STATUS_DIR:-/workspace/.megaplan/status}}"
  local target="$status_dir/${component}.supervisor-runtime-failure.json"
  local tmp stamp
  mkdir -p "$status_dir" 2>/dev/null || return 1
  tmp="$(mktemp "$status_dir/.${component}.runtime-failure.XXXXXX")" || return 1
  stamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  # Values are controlled tokens, not untrusted stderr. Keep this writer
  # dependency-independent so it still works when Python imports do not.
  printf '{"at":"%s","component":"%s","reason":"%s","schema_version":"arnold-supervisor-runtime-failure-v1","status":"failed"}\n' \
    "$stamp" "$component" "$reason" > "$tmp"
  mv -f "$tmp" "$target"
}

arnold_supervisor_stdlib_init() {
  local component="${1:-unknown}"
  local preferred="${MEGAPLAN_SUPERVISOR_PYTHON:-/workspace/.megaplan/supervisor-python/current/bin/python3}"
  local resolved=""

  if [[ -x "$preferred" ]]; then
    resolved="$(readlink -f "$preferred" 2>/dev/null || printf '%s' "$preferred")"
  else
    resolved="$(command -v python3 2>/dev/null || true)"
    resolved="$(readlink -f "$resolved" 2>/dev/null || printf '%s' "$resolved")"
  fi
  if [[ -z "$resolved" || ! -x "$resolved" ]]; then
    arnold_supervisor_failure_artifact "$component" "stdlib_interpreter_unavailable"
    printf '%s\n' "$component: stdlib interpreter unavailable" >&2
    return 78
  fi
  export MEGAPLAN_SUPERVISOR_STDLIB_PYTHON="$resolved"
}

arnold_supervisor_runtime_init() {
  local component="${1:-unknown}"
  local source_root="${2:-/workspace/arnold}"
  local preferred="${MEGAPLAN_SUPERVISOR_PYTHON:-/workspace/.megaplan/supervisor-python/current/bin/python3}"
  local runtime_root="${MEGAPLAN_SUPERVISOR_RUNTIME_ROOT:-/workspace/.megaplan/supervisor-python}"
  local runtime_receipt="${MEGAPLAN_SUPERVISOR_RUNTIME_RECEIPT:-$runtime_root/last-prepare.json}"
  local required="${MEGAPLAN_SUPERVISOR_RUNTIME_REQUIRED:-0}"
  local resolved=""

  if [[ -x "$preferred" ]]; then
    resolved="$(readlink -f "$preferred" 2>/dev/null || printf '%s' "$preferred")"
  elif [[ "$required" == "1" ]]; then
    arnold_supervisor_failure_artifact "$component" "dedicated_interpreter_missing"
    printf '%s\n' "$component: dedicated supervisor interpreter missing: $preferred" >&2
    return 78
  else
    resolved="$(command -v python3 2>/dev/null || true)"
    resolved="$(readlink -f "$resolved" 2>/dev/null || printf '%s' "$resolved")"
  fi

  if [[ -z "$resolved" || ! -x "$resolved" ]]; then
    arnold_supervisor_failure_artifact "$component" "interpreter_unavailable"
    printf '%s\n' "$component: supervisor interpreter unavailable" >&2
    return 78
  fi

  local isolated=0
  # A system/control interpreter may also contain a noneditable Arnold wheel.
  # It is the dedicated supervisor only when the durable prepare receipt binds
  # this exact prefix, source, and import vector.
  if env -u PYTHONPATH PYTHONSAFEPATH=1 "$resolved" -P - \
    "$runtime_receipt" "$source_root" <<'PY' \
    >/dev/null 2>&1; then
import importlib.metadata
import json
import pathlib
import sys
import urllib.parse

receipt_path, source = map(pathlib.Path, sys.argv[1:])
receipt = json.loads(receipt_path.read_text())
direct_url = json.loads(
    importlib.metadata.distribution("arnold").read_text("direct_url.json") or "{}"
)
runtime = pathlib.Path(receipt.get("runtime", "")).resolve()
if bool((direct_url.get("dir_info") or {}).get("editable")):
    raise SystemExit(1)
parsed_source = urllib.parse.urlparse(str(direct_url.get("url") or ""))
if parsed_source.scheme != "file":
    raise SystemExit(1)
installed_source = pathlib.Path(
    urllib.parse.unquote(parsed_source.path)
).resolve()
if installed_source != source.resolve():
    raise SystemExit(1)
if runtime != pathlib.Path(sys.prefix).resolve():
    raise SystemExit(1)
if pathlib.Path(receipt.get("source", "")).resolve() != source.resolve():
    raise SystemExit(1)
import arnold
import arnold_pipelines
import arnold_pipelines.megaplan
imports = {
    "arnold": str(pathlib.Path(arnold.__file__).resolve()),
    "arnold_pipelines": str(pathlib.Path(arnold_pipelines.__file__).resolve()),
    "megaplan": str(pathlib.Path(arnold_pipelines.megaplan.__file__).resolve()),
}
if imports != receipt.get("imports"):
    raise SystemExit(1)
if any(not pathlib.Path(value).is_relative_to(runtime) for value in imports.values()):
    raise SystemExit(1)
PY
    isolated=1
  fi
  if [[ "$isolated" == "1" ]]; then
    # Gap 3: bind the supervisor import path to the canonical Arnold source root
    # even in isolated mode. The venv supplies dependencies + interpreter; the
    # Arnold CODE must come from the same canonical tree the fixers patch, not
    # a static site-packages copy, so watchdog/repair fixes actually take.
    if ! PYTHONSAFEPATH=1 PYTHONPATH="$source_root" \
      "$resolved" -P -c 'import yaml; import arnold_pipelines.megaplan.cloud.cli; import arnold_pipelines.megaplan.cloud.repair_contract' \
      >/dev/null 2>&1; then
      arnold_supervisor_failure_artifact "$component" "readiness_import_failed"
      printf '%s\n' "$component: supervisor interpreter readiness import failed: $resolved" >&2
      return 78
    fi
  elif ! PYTHONSAFEPATH=1 PYTHONPATH="$source_root" \
    "$resolved" -P -c 'import yaml; import arnold_pipelines.megaplan.cloud.cli; import arnold_pipelines.megaplan.cloud.repair_contract' \
    >/dev/null 2>&1; then
    arnold_supervisor_failure_artifact "$component" "readiness_import_failed"
    printf '%s\n' "$component: supervisor interpreter readiness import failed: $resolved" >&2
    return 78
  fi

  export MEGAPLAN_SUPERVISOR_PYTHON="$resolved"
  export MEGAPLAN_SUPERVISOR_SOURCE_ROOT="$source_root"
  export MEGAPLAN_SUPERVISOR_ISOLATED="$isolated"
  arnold_supervisor_python() {
    local need_safe_path=1
    local arg
    for arg in "$@"; do
      case "$arg" in
        -P)
          need_safe_path=0
          break
          ;;
        --|-c|-m|-)
          break
          ;;
        -*)
          ;;
        *)
          break
          ;;
      esac
    done
    if [[ "$MEGAPLAN_SUPERVISOR_ISOLATED" == "1" && "$need_safe_path" == "1" ]]; then
      PYTHONSAFEPATH=1 \
        PYTHONPATH="$MEGAPLAN_SUPERVISOR_SOURCE_ROOT" \
        "$MEGAPLAN_SUPERVISOR_PYTHON" -P "$@"
    elif [[ "$MEGAPLAN_SUPERVISOR_ISOLATED" == "1" ]]; then
      PYTHONSAFEPATH=1 \
        PYTHONPATH="$MEGAPLAN_SUPERVISOR_SOURCE_ROOT" \
        "$MEGAPLAN_SUPERVISOR_PYTHON" "$@"
    elif [[ "$need_safe_path" == "1" ]]; then
      PYTHONSAFEPATH=1 \
        PYTHONPATH="$MEGAPLAN_SUPERVISOR_SOURCE_ROOT" \
        "$MEGAPLAN_SUPERVISOR_PYTHON" -P "$@"
    else
      PYTHONSAFEPATH=1 \
        PYTHONPATH="$MEGAPLAN_SUPERVISOR_SOURCE_ROOT" \
        "$MEGAPLAN_SUPERVISOR_PYTHON" "$@"
    fi
  }
  export -f arnold_supervisor_python
  # Existing wrapper bodies deliberately keep the familiar python3 spelling;
  # this function pins every call to the already-validated absolute path and
  # forces safe-path semantics even for stdin / -c launches.
  python3() {
    arnold_supervisor_python "$@"
  }
  export -f python3
  arnold_runtime_attestation_start() {
    local attestation_component="${1:-$component}"
    if [[ -z "${MEGAPLAN_RUNTIME_LAUNCH_SEED:-}" \
      && "${MEGAPLAN_RUNTIME_ATTESTATION_REQUIRED:-0}" != "1" ]]; then
      return 0
    fi
    ARNOLD_RUNTIME_PROCESS_ATTESTATION_PATH="${MEGAPLAN_RUNTIME_PROCESS_ATTESTATION:-${MEGAPLAN_SUPERVISOR_STATUS_DIR:-${CLOUD_WATCHDOG_STATUS_DIR:-/workspace/.megaplan/status}}/${attestation_component}.runtime-process-attestation.json}"
    MEGAPLAN_RUNTIME_PROCESS_ATTESTATION="$ARNOLD_RUNTIME_PROCESS_ATTESTATION_PATH" \
      arnold_supervisor_python -m arnold_pipelines.megaplan.cloud.runtime_attestation \
      startup --component "$attestation_component" --target-pid "$$"
  }
  arnold_runtime_attestation_check() {
    local attestation_component="${1:-$component}"
    if [[ -z "${MEGAPLAN_RUNTIME_LAUNCH_SEED:-}" \
      && "${MEGAPLAN_RUNTIME_ATTESTATION_REQUIRED:-0}" != "1" ]]; then
      return 0
    fi
    MEGAPLAN_RUNTIME_PROCESS_ATTESTATION="$ARNOLD_RUNTIME_PROCESS_ATTESTATION_PATH" \
      arnold_supervisor_python -m arnold_pipelines.megaplan.cloud.runtime_attestation \
      verify-process --component "$attestation_component" --target-pid "$$"
  }
  export -f arnold_runtime_attestation_start arnold_runtime_attestation_check
  if ! arnold_runtime_attestation_start "$component"; then
    arnold_supervisor_failure_artifact "$component" "runtime_attestation_failed"
    printf '%s\n' "$component: runtime launch attestation failed" >&2
    return 78
  fi
  return 0
}

arnold_supervisor_select_exact_fallback() {
  local component="${1:-unknown}"
  local source_path="${2:-}"
  local fallback_path="${3:-}"
  local expected_source_root="${4:-}"
  local runtime_root source_root source_sha fallback_sha

  runtime_root="$(readlink -f "${MEGAPLAN_SUPERVISOR_SOURCE_ROOT:-}" 2>/dev/null || true)"
  source_root="$(readlink -f "$expected_source_root" 2>/dev/null || true)"
  if [[ -z "$runtime_root" || -z "$source_root" || "$runtime_root" != "$source_root" ]]; then
    arnold_supervisor_failure_artifact "$component" "fallback_runtime_source_identity_mismatch"
    return 78
  fi
  if [[ ! -f "$source_path" || ! -x "$fallback_path" ]]; then
    arnold_supervisor_failure_artifact "$component" "fallback_source_or_runtime_missing"
    return 78
  fi
  source_sha="$(sha256sum "$source_path" 2>/dev/null | awk '{print $1}')"
  fallback_sha="$(sha256sum "$fallback_path" 2>/dev/null | awk '{print $1}')"
  if [[ ! "$source_sha" =~ ^[0-9a-f]{64}$ || "$source_sha" != "$fallback_sha" ]]; then
    arnold_supervisor_failure_artifact "$component" "fallback_wrapper_digest_mismatch"
    return 78
  fi
  printf '%s\n' "$fallback_path"
}

# ── Per-epic runtime manifest resolution (fixer-unification design) ─────────
# One runtime-manifest.json per runtime is the post-bootstrap runtime
# resolver.  These helpers read a single dotted epic field and print it (or
# nothing when absent), so wrappers prefer the manifest and keep their legacy
# env/default fallback chain only for manifest-less runtimes.

arnold_runtime_manifest_path() {
  printf '%s' "${ARNOLD_RUNTIME_MANIFEST:-/workspace/.megaplan/runtime-manifest.json}"
}

arnold_runtime_manifest_is_compatibility_only() {
  # G2 correction 1: a manifest file carrying ``"compatibility_only": true``
  # is a NON-AUTHORITATIVE pointer — compatibility telemetry ONLY.  Every
  # resolver treats such a pointer as ABSENT for admission (falls through to
  # the permit check → block when no valid permit); it can never select a
  # runtime.  Returns 0 for such a pointer, 1 for absent files, corrupt JSON,
  # and authoritative manifests.  Dependency-independent (stdlib JSON only).
  local manifest_path="${1:-}"
  [[ -n "$manifest_path" && -f "$manifest_path" ]] || return 1
  "${MEGAPLAN_SUPERVISOR_STDLIB_PYTHON:-python3}" - "$manifest_path" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
try:
    payload = json.loads(path.read_text(encoding="utf-8"))
except Exception:
    raise SystemExit(1)
if isinstance(payload, dict) and payload.get("compatibility_only") is True:
    raise SystemExit(0)
raise SystemExit(1)
PY
}

arnold_runtime_manifest_epic_field() {
  local field="${1:-}"
  local manifest_path
  field="${field#epic.}"
  [[ -n "$field" ]] || return 0
  manifest_path="$(arnold_runtime_manifest_path)"
  [[ -f "$manifest_path" ]] || return 0
  # A compatibility_only pointer is NON-AUTHORITATIVE telemetry (G2
  # correction 1): field reads must never let the global pointer select a
  # runtime — permit-admitted manifestless runs keep the legacy fallback.
  arnold_runtime_manifest_is_compatibility_only "$manifest_path" && return 0
  python3 - "$manifest_path" "$field" <<'PY'
import json
import pathlib
import sys

path, field = sys.argv[1], sys.argv[2]
value = None
try:
    from arnold_pipelines.megaplan.cloud.runtime_manifest import bootstrap_manifest

    manifest = bootstrap_manifest(pathlib.Path(path))
    epic = getattr(manifest, "epic", None)
    value = epic.get(field) if isinstance(epic, dict) else None
except Exception:
    try:
        payload = json.loads(pathlib.Path(path).read_text(encoding="utf-8"))
        epic = payload.get("epic") if isinstance(payload, dict) else None
        value = epic.get(field) if isinstance(epic, dict) else None
    except Exception:
        sys.exit(0)
if isinstance(value, str) and value:
    print(value)
PY
}

# ── P1 admission authority (per-epic admission kernel) ──────────────────────
# The per-runtime manifest is THE admission resolver for wrapper entry.  A
# PRESENT manifest must load and declare epic.branch (missing/corrupt exits
# 78 — fail closed, never a silent fallback).  A genuinely ABSENT manifest is
# admitted only by a valid, unexpired ``allow_manifestless`` permit in the
# ``.runtime_policy.json`` sidecar (same directory as the manifest; an
# ``ARNOLD_RUNTIME_POLICY`` env override supports per-session binding).  The
# sidecar is an append-only ``permits`` list; the LAST unrevoked, structurally
# valid, unexpired ``allow_manifestless`` record is the active one.  Expired
# permits stay loadable — expiry rejects admission, it never invalidates a
# previously admitted runtime.

arnold_runtime_manifest_policy_path() {
  local manifest_path
  manifest_path="$(arnold_runtime_manifest_path)"
  printf '%s' "${ARNOLD_RUNTIME_POLICY:-$(dirname "$manifest_path")/.runtime_policy.json}"
}

arnold_manifest_allow_manifestless() {
  # Returns 0 iff a valid, unexpired allow_manifestless permit exists in the
  # .runtime_policy.json sidecar; returns 1 (fail closed) otherwise.  The
  # embedded check is dependency-independent (stdlib JSON only) and mirrors
  # the Python-side admission contract: 0 < expires_at - issued_at <= 24h and
  # current-unexpired, with revocation as an auditable revoked_at tombstone.
  local policy_path
  policy_path="$(arnold_runtime_manifest_policy_path)"
  [[ -f "$policy_path" ]] || return 1
  "${MEGAPLAN_SUPERVISOR_STDLIB_PYTHON:-python3}" - "$policy_path" <<'PY'
import datetime as dt
import json
import pathlib
import sys

policy = pathlib.Path(sys.argv[1])
try:
    payload = json.loads(policy.read_text(encoding="utf-8"))
except Exception:
    raise SystemExit(1)
permits = payload.get("permits") if isinstance(payload, dict) else None
if not isinstance(permits, list):
    raise SystemExit(1)
now = dt.datetime.now(dt.timezone.utc)


def parse_utc(value):
    if not isinstance(value, str):
        return None
    try:
        parsed = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=dt.timezone.utc)
    return parsed


for record in reversed(permits):
    if not isinstance(record, dict):
        continue
    if record.get("kind") != "allow_manifestless":
        continue
    if record.get("revoked_at"):
        continue
    if not isinstance(record.get("id"), str) or not record["id"]:
        continue
    issued = parse_utc(record.get("issued_at"))
    expires = parse_utc(record.get("expires_at"))
    if issued is None or expires is None:
        continue
    lifetime = expires - issued
    if not (dt.timedelta(0) < lifetime <= dt.timedelta(hours=24)):
        continue
    if now >= expires:
        continue
    raise SystemExit(0)
raise SystemExit(1)
PY
}

arnold_runtime_manifest_authority() {
  # P1 admission gate — sole manifest authority resolver for wrapper entry.
  #   present + valid (epic.branch, NOT compatibility_only) => pass
  #   present + invalid (corrupt / no epic.branch)          => exit 78
  #   compatibility_only pointer / absent / unbound          => permit check
  #   absent  + valid unexpired permit                       => pass
  #   absent  + no permit                                    => exit 78
  # A ``compatibility_only`` pointer is NON-AUTHORITATIVE (G2 correction 1):
  # the bootstrap-path global pointer is compatibility telemetry ONLY and
  # can never select a runtime — admission treats it as ABSENT and falls
  # through to the permit check (G1 no-global-pointer fallback).
  local component="${1:-unknown}"
  local manifest_path branch
  manifest_path="$(arnold_runtime_manifest_path)"
  if [[ -f "$manifest_path" ]]; then
    if ! arnold_runtime_manifest_is_compatibility_only "$manifest_path"; then
      branch="$(arnold_runtime_manifest_epic_field branch)"
      if [[ -n "$branch" ]]; then
        return 0
      fi
      printf '%s\n' "runtime manifest present without epic.branch; failing closed" >&2
      exit 78
    fi
  fi
  if ! arnold_manifest_allow_manifestless; then
    printf '%s\n' "runtime manifest absent without a valid allow_manifestless permit; failing closed" >&2
    exit 78
  fi
  return 0
}

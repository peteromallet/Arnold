import pathlib
import sys
try:
    marker = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
except Exception:
    marker = {}
if isinstance(marker, dict):
    value = marker.get("tmux_socket", marker.get("socket_path", ""))

#!/usr/bin/env bash
# Status-trigger epic babysitter: ONE detached hermes:deepseek:deepseek-v4-flash
# managed agent whose goal prompt drives the whole recovery flow itself —
# swarm -> codex -> implement -> relaunch -> prove.
#
# Launched detached by the arnold-watchdog status trigger (MEGAPLAN_SUPERFIXER_ONLY=1)
# as the deterministic replacement for the broken schedule-add hop.  The launch
# logic lives in arnold_pipelines.megaplan.cloud.babysitter.launch: the goal
# file (rendered by skills/babysitter/scripts/render_babysitter_goal.py) is the
# agent's ENTIRE prompt — there is no coded multi-stage orchestrator anymore.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/../../../.." && pwd)"
# Completion-driven fixer agents (user directive 2026-08-17 "NO turn limit";
# mirrors the megaplan worker max_iterations=None fix 6a61613962). Without
# this, the hermes agent hits the default 90-tool-call cap mid-investigation
# and hands back a truncated final status (observed 2026-08-17: mega m3b
# fixer investigator hit the cap before finishing its rebind verification).
export ARNOLD_RESIDENT_UNBOUNDED_REQUEST=1
PYTHONPATH="$ROOT:${PYTHONPATH:-}" python3 -P -m \
  arnold_pipelines.megaplan.cloud.babysitter.launch "$@"

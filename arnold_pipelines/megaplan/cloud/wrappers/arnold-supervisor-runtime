#!/usr/bin/env bash
# Atomically prepare the immutable Python environment used by cloud supervisors.
set -euo pipefail

ROOT="${MEGAPLAN_SUPERVISOR_RUNTIME_ROOT:-/workspace/.megaplan/supervisor-python}"
# The supervisor venv is prepared from the fixed /workspace/arnold checkout
# (per-epic manifest worktrees share its frozen venv).  The entrypoint's
# fixed-literal export carries the same value; no env-selector read remains
# (G4).
SOURCE="/workspace/arnold"
BASE_PYTHON="${MEGAPLAN_SUPERVISOR_BASE_PYTHON:-$(command -v python3)}"
ACTION="${1:---prepare}"

BASE_PYTHON="$(readlink -f "$BASE_PYTHON")"
CURRENT="$ROOT/current"
RECEIPT="$ROOT/last-prepare.json"
mkdir -p "$ROOT/runtimes"

runtime_ready() {
  local python="$1"
  [[ -x "$python" ]] || return 1
  # Isolation must be total: PYTHONSAFEPATH does NOT ignore PYTHONPATH, so a
  # hollow venv can look ready while arnold resolves from an ambient tree.
  # Strip PYTHONPATH so readiness proves the venv itself is self-contained.
  env -u PYTHONPATH PYTHONSAFEPATH=1 "$python" -P -c \
    'import yaml; import arnold_pipelines.megaplan.cloud.cli; import arnold_pipelines.megaplan.cloud.repair_contract' \
    >/dev/null 2>&1
}

receipt_ready() {
  local python="$1"
  [[ -f "$RECEIPT" ]] || return 1
  env -u PYTHONPATH PYTHONSAFEPATH=1 "$python" -P - "$RECEIPT" "$SOURCE" <<'PY'
import json
import pathlib
import subprocess
import sys

receipt_path, source = map(pathlib.Path, sys.argv[1:])
receipt = json.loads(receipt_path.read_text())
if pathlib.Path(receipt.get("source", "")).resolve() != source.resolve():
    raise SystemExit("supervisor receipt source mismatch")
revision = subprocess.run(
    ["git", "-C", str(source), "rev-parse", "HEAD"],
    check=False, capture_output=True, text=True,
).stdout.strip()
if revision != receipt.get("source_revision"):
    raise SystemExit("supervisor source revision changed")
runtime = pathlib.Path(receipt["runtime"]).resolve()
if pathlib.Path(sys.prefix).resolve() != runtime:
    raise SystemExit("supervisor receipt runtime mismatch")
import arnold
import arnold_pipelines
import arnold_pipelines.megaplan
imports = {
    "arnold": str(pathlib.Path(arnold.__file__).resolve()),
    "arnold_pipelines": str(pathlib.Path(arnold_pipelines.__file__).resolve()),
    "megaplan": str(pathlib.Path(arnold_pipelines.megaplan.__file__).resolve()),
}
if imports != receipt.get("imports"):
    raise SystemExit("supervisor import receipt mismatch")
if any(not pathlib.Path(value).is_relative_to(runtime) for value in imports.values()):
    raise SystemExit("supervisor import escaped runtime")
PY
}

# ── Reference census (T-0027): fail-closed before EVERY deletion ─────────────
# The venv rebuild rm -rf's any stale runtime under the exact fingerprint
# root, so the rebuild is behind the canonical reference census (the same
# runtime_references module arnold-gc-sweep consults).  It normalizes EXACT
# runtime-root paths from runtime manifests, chain metadata
# execution_environment.engine_root, cloud-session/chain-health markers,
# resident/ops schedules, repair-queue requests/decisions/attempts/claims,
# and custody leases.  Verdicts are fail-closed:
#   REFERENCED  -> a store references the exact root: refuse the rebuild
#   DANGLING    -> a store references a runtime root that no longer exists:
#                  the census is incoherent -> NEEDS-RECONCILE, refuse
#   UNKNOWN     -> unreadable/corrupt store: refuse (delete-on-unknown
#                  never happens)
#   CLEAR       -> no reference; the rebuild may proceed
# --force-style flags and env overrides are NOT evidence of safety.  The
# census CLI reads the same ARNOLD_REFERENCE_* / ARNOLD_BASE_DIR /
# ARNOLD_RUNTIME_MANIFEST_DIR env overrides as arnold-gc-sweep; a failing
# census is UNKNOWN (fail-closed).
_reference_census() {
  # $1 = exact runtime root under consideration for rm -rf.
  local out rc=0
  out="$(python3 -m arnold_pipelines.megaplan.cloud.runtime_references census \
    --root "$1" 2>&1)" || rc=$?
  CENSUS_REPORT="$out"
  CENSUS_VERDICT="$(printf '%s\n' "$out" | awk '/^STATUS /{print $2; exit}')"
  if [[ -z "$CENSUS_VERDICT" ]]; then
    CENSUS_VERDICT="UNKNOWN"
    CENSUS_REPORT="reference census unavailable (rc=$rc): $out"
  fi
}

case "$ACTION" in
  --check)
    runtime_ready "$CURRENT/bin/python3"
    receipt_ready "$CURRENT/bin/python3"
    printf '%s\n' "$(readlink -f "$CURRENT/bin/python3")"
    exit 0
    ;;
  --python)
    runtime_ready "$CURRENT/bin/python3"
    receipt_ready "$CURRENT/bin/python3"
    readlink -f "$CURRENT/bin/python3"
    exit 0
    ;;
  --prepare) ;;
  *) printf 'usage: arnold-supervisor-runtime [--prepare|--check|--python]\n' >&2; exit 64 ;;
esac

[[ -x "$BASE_PYTHON" ]] || { printf 'base Python unavailable: %s\n' "$BASE_PYTHON" >&2; exit 78; }
[[ -f "$SOURCE/pyproject.toml" ]] || { printf 'Arnold source unavailable: %s\n' "$SOURCE" >&2; exit 78; }

exec 9>"$ROOT/prepare.lock"
flock 9

fingerprint="$({
  sha256sum "$SOURCE/pyproject.toml"
  [[ ! -f "$SOURCE/uv.lock" ]] || sha256sum "$SOURCE/uv.lock"
  git -C "$SOURCE" rev-parse HEAD 2>/dev/null || true
  git -C "$SOURCE" diff --no-ext-diff --binary HEAD 2>/dev/null | sha256sum
} | sha256sum | cut -d' ' -f1)"
source_revision="$(git -C "$SOURCE" rev-parse HEAD)"
runtime="$ROOT/runtimes/$fingerprint"
if ! runtime_ready "$runtime/bin/python3"; then
  # T-0027: the rebuild rm -rf's any stale runtime under this exact root,
  # so it is gated on a fresh readable zero-reference census verdict.
  # Run the gate BEFORE the venv build so a refused rebuild never wastes
  # a build, and never touch the stale runtime unless the census is CLEAR.
  if [[ -e "$runtime" ]]; then
    _reference_census "$runtime"
    if [[ "$CENSUS_VERDICT" != "CLEAR" ]]; then
      printf 'arnold-supervisor-runtime: refusing venv rebuild for %s — reference census %s (only CLEAR may rm -rf; delete-on-unknown never happens)\n' "$runtime" "$CENSUS_VERDICT" >&2
      printf '%s\n' "$CENSUS_REPORT" | awk '!/^STATUS /' | sed 's/^/arnold-supervisor-runtime:   /' >&2
      exit 5
    fi
  fi
  stage="$(mktemp -d "$ROOT/.staging.XXXXXX")"
  cleanup() { rm -rf "$stage"; }
  trap cleanup EXIT
  "$BASE_PYTHON" -m venv --copies "$stage"
  "$stage/bin/python3" -m pip install --no-cache-dir "$SOURCE" >/dev/null
  runtime_ready "$stage/bin/python3"
  if [[ -e "$runtime" ]]; then
    # The census gate above already returned CLEAR for this exact root.
    rm -rf "$runtime"
  fi
  mv "$stage" "$runtime"
  trap - EXIT
fi

link_tmp="$ROOT/.current.$$.tmp"
ln -s "$runtime" "$link_tmp"
mv -Tf "$link_tmp" "$CURRENT"

env -u PYTHONPATH PYTHONSAFEPATH=1 "$CURRENT/bin/python3" -P - "$RECEIPT" "$runtime" "$SOURCE" "$BASE_PYTHON" "$fingerprint" "$source_revision" <<'PY'
import datetime as dt
import json
import os
import pathlib
import sys
import tempfile

path, runtime, source, base_python, fingerprint, source_revision = sys.argv[1:]
target = pathlib.Path(path)
runtime_path = pathlib.Path(runtime).resolve()
import arnold
import arnold_pipelines
import arnold_pipelines.megaplan
imports = {
    "arnold": str(pathlib.Path(arnold.__file__).resolve()),
    "arnold_pipelines": str(pathlib.Path(arnold_pipelines.__file__).resolve()),
    "megaplan": str(pathlib.Path(arnold_pipelines.megaplan.__file__).resolve()),
}
if any(not pathlib.Path(value).is_relative_to(runtime_path) for value in imports.values()):
    raise SystemExit("prepared supervisor runtime imported outside its immutable venv")
payload = {
    "base_python": base_python,
    "fingerprint": fingerprint,
    "prepared_at": dt.datetime.now(dt.timezone.utc).isoformat(),
    "runtime": runtime,
    "schema_version": "arnold-supervisor-runtime-receipt-v1",
    "source": source,
    "source_revision": source_revision,
    "imports": imports,
    "status": "ready",
}
fd, tmp = tempfile.mkstemp(prefix=target.name + ".", dir=str(target.parent))
with os.fdopen(fd, "w", encoding="utf-8") as handle:
    json.dump(payload, handle, sort_keys=True)
    handle.write("\n")
os.replace(tmp, target)
print(json.dumps(payload, sort_keys=True))
PY
receipt_ready "$CURRENT/bin/python3"

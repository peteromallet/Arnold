[Unit]
Description=Ensure Megaplan cloud watchdog tmux session is running
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Execute the ensure script from the workspace checkout so watchdog-ensure
# surfaces cannot materialize unguarded legacy repair authority.  The script
# itself delegates to the canonical watchdog wrapper through the checkout.
ExecStart=/workspace/arnold/arnold_pipelines/megaplan/cloud/systemd/ensure-megaplan-watchdog

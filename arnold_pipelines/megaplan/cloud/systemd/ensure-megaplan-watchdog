#!/usr/bin/env bash
# Ensure the megaplan watchdog is alive in the resident-only container.
# Rewritten 2026-08-17 (I38, grok/user consult): the watchdog moved into
# megaplan-cloud-agent-resident-only and tmux does not survive there; the
# working launch is `docker exec -d ... nohup bash /tmp/launch-watchdog.sh &
# disown`. The old unit targeted the stopped megaplan-cloud-agent container
# and was masked - leaving the watchdog unsupervised. Health is process
# liveness + a fresh sweep-completed receipt, NOT tmux.
set -u

CONTAINER="${MEGAPLAN_CLOUD_CONTAINER:-megaplan-cloud-agent-resident-only}"
LOG="${MEGAPLAN_WATCHDOG_ENSURE_LOG:-/var/log/megaplan-watchdog-ensure.log}"

now() { date -u +"%Y-%m-%dT%H:%M:%SZ"; }
log() { printf "[%s] %s\n" "$(now)" "$*" >> "$LOG"; }

if ! docker inspect "$CONTAINER" >/dev/null 2>&1; then
  log "container_missing container=$CONTAINER"
  exit 1
fi

running="$(docker inspect -f "{{.State.Running}}" "$CONTAINER" 2>/dev/null || echo false)"
if [[ "$running" != "true" ]]; then
  log "container_not_running starting container=$CONTAINER"
  if ! docker start "$CONTAINER" >> "$LOG" 2>&1; then
    log "container_start_failed container=$CONTAINER"
    exit 1
  fi
fi

STALE_HEARTBEAT_MIN="${MEGAPLAN_WATCHDOG_STALE_HEARTBEAT_MIN:-130}"
SWEEP_COMPLETED="/workspace/.megaplan/status/watchdog-sweep.completed.json"

# Health 1: a watchdog process must be alive in the container.
watchdog_procs="$(docker exec "$CONTAINER" bash -lc 'pgrep -f arnold-watchdog | wc -l' 2>/dev/null | tr -d ' ')"
if [[ "${watchdog_procs:-0}" -gt 0 ]]; then
  # Health 2: the sweep-completed receipt must be fresh (process alive but
  # wedged is unhealthy). Missing receipt is tolerated on a just-started
  # watchdog (first sweep may not have completed yet); stale means wedged.
  stale="$(docker exec "$CONTAINER" bash -lc "if [[ -s '$SWEEP_COMPLETED' ]] && find '$SWEEP_COMPLETED' -mmin +${STALE_HEARTBEAT_MIN} 2>/dev/null | grep -q .; then echo stale; else echo fresh; fi" 2>/dev/null | tr -d ' ')"
  if [[ "$stale" != "stale" ]]; then
    log "watchdog_alive container=$CONTAINER procs=${watchdog_procs}"
    exit 0
  fi
  log "watchdog_heartbeat_stale container=$CONTAINER (older than ${STALE_HEARTBEAT_MIN}m); killing to restart"
  docker exec "$CONTAINER" bash -lc 'pkill -f arnold-watchdog 2>/dev/null || true; sleep 2; true' 2>/dev/null || true
fi

log "watchdog_missing restarting container=$CONTAINER"
# The launch scripts live in the container /tmp (re-copied after container
# recreation). Launch via docker exec -d with nohup+disown - the pattern that
# survives (tmux does not persist in this container).
docker exec -d "$CONTAINER" bash -lc "cd / && nohup bash /tmp/launch-watchdog.sh >> /tmp/watchdog-ensure.log 2>&1 & disown; nohup bash /tmp/launch-watchdog-astrid.sh >> /tmp/watchdog-ensure-astrid.log 2>&1 & disown; echo launched" >> "$LOG" 2>&1

sleep 3
watchdog_procs="$(docker exec "$CONTAINER" bash -lc 'pgrep -f arnold-watchdog | wc -l' 2>/dev/null | tr -d ' ')"
if [[ "${watchdog_procs:-0}" -gt 0 ]]; then
  log "watchdog_restarted container=$CONTAINER procs=${watchdog_procs}"
  exit 0
fi

log "watchdog_restart_failed_not_alive container=$CONTAINER"
exit 1

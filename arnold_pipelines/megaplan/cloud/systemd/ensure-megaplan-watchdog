#!/usr/bin/env bash
# Ensure the megaplan watchdog is alive in the resident-only container.
#
# Identity-scoped observer, not an env-scoped epic pin. The supervisor
# process MUST NOT inherit ARNOLD_RUNTIME_MANIFEST / ARNOLD_REPAIR_SESSION
# for one epic: those leak into every babysitter dispatch and make the
# watchdog supervise the wrong session with the wrong engine (observed
# 2026-08-26: /tmp pin to megaplan-maintenance on arnold-4a830c6ac9a0, so
# native-build-forward's parked stall was never driven by its own runtime).
# One watchdog scans MARKER_DIR; per-tick identity is the marker session
# -> {manifest_dir}/{session}.json -> epic.runtime_root (T-0022).
#
# This script is the PRODUCER of the in-container launch. There is no
# /tmp consumer. Health is process liveness + a fresh sweep-completed
# receipt, NOT tmux.
set -u

CONTAINER="${MEGAPLAN_CLOUD_CONTAINER:-megaplan-cloud-agent-resident-only}"
LOG="${MEGAPLAN_WATCHDOG_ENSURE_LOG:-/var/log/megaplan-watchdog-ensure.log}"
WATCHDOG_WRAPPER="${MEGAPLAN_WATCHDOG_WRAPPER:-/workspace/arnold/arnold_pipelines/megaplan/cloud/wrappers/arnold-watchdog}"
WATCHDOG_LOG="${MEGAPLAN_WATCHDOG_LOG:-/tmp/watchdog-ensure.log}"
# Snapshot argv is `bash /tmp/arnold-watchdog.XXXX`. Character-class the
# dot so this is not a literal backslash inside single quotes. Never match
# a bare `arnold-watchdog` substring (this health-check's own pgrep argv).
WATCHDOG_PGREP="pgrep -f 'bash /tmp/arnold-watchdog[.]'"

now() { date -u +"%Y-%m-%dT%H:%M:%SZ"; }
log() { printf "[%s] %s\n" "$(now)" "$*" >> "$LOG"; }

if ! docker inspect "$CONTAINER" >/dev/null 2>&1; then
  log "container_missing container=$CONTAINER"
  exit 1
fi

running="$(docker inspect -f "{{.State.Running}}" "$CONTAINER" 2>/dev/null || echo false)"
if [[ "$running" != "true" ]]; then
  log "container_not_running starting container=$CONTAINER"
  if ! docker start "$CONTAINER" >> "$LOG" 2>&1; then
    log "container_start_failed container=$CONTAINER"
    exit 1
  fi
fi

STALE_HEARTBEAT_MIN="${MEGAPLAN_WATCHDOG_STALE_HEARTBEAT_MIN:-130}"
SWEEP_COMPLETED="/workspace/.megaplan/status/watchdog-sweep.completed.json"

watchdog_procs="$(docker exec "$CONTAINER" bash -lc "$WATCHDOG_PGREP | wc -l" 2>/dev/null | tr -d ' ')"
if [[ "${watchdog_procs:-0}" -gt 0 ]]; then
  # A sweep that started recently is in-flight, not dead. Restacking every
  # minute kills the babysitter launch (observed 2026-08-26).
  started="$(docker exec "$CONTAINER" bash -lc "if [[ -s /workspace/.megaplan/status/watchdog-sweep.started.json ]] && find /workspace/.megaplan/status/watchdog-sweep.started.json -mmin -10 2>/dev/null | grep -q .; then echo recent; else echo old; fi" 2>/dev/null | tr -d ' ')"
  stale="$(docker exec "$CONTAINER" bash -lc "if [[ -s '$SWEEP_COMPLETED' ]] && find '$SWEEP_COMPLETED' -mmin +${STALE_HEARTBEAT_MIN} 2>/dev/null | grep -q .; then echo stale; else echo fresh; fi" 2>/dev/null | tr -d ' ')"
  if [[ "$started" == "recent" || "$stale" != "stale" ]]; then
    log "watchdog_alive container=$CONTAINER procs=${watchdog_procs} started=${started:-?} completed=${stale:-?}"
    exit 0
  fi
  log "watchdog_heartbeat_stale container=$CONTAINER; requesting canonical restart"
  docker exec "$CONTAINER" bash -lc '
    set -u
    lib=/usr/local/bin/arnold-supervisor-runtime-lib
    [[ -f "$lib" ]] || lib=/workspace/arnold/arnold_pipelines/megaplan/cloud/wrappers/arnold-supervisor-runtime-lib
    [[ -f "$lib" ]] || { echo watchdog_signal_runtime_missing >&2; exit 78; }
    . "$lib"
    arnold_supervisor_runtime_init ensure-megaplan-watchdog /workspace/arnold || exit $?
    marker_dir="${MEGAPLAN_WATCHDOG_MARKER_DIR:-/workspace/.megaplan/cloud-sessions}"
    pids="$(pgrep -f "bash /tmp/arnold-watchdog[.]" || true)"
    [[ -n "$pids" ]] || exit 0
    for pid in $pids; do
      arnold_supervisor_bind_signal_context_for_pid "$pid" "$marker_dir" non_worker || continue
      arnold_supervisor_signal_bound_pid ensure-megaplan-watchdog "$pid" SIGTERM term watchdog-heartbeat-stale
      rc=$?
      [[ "$rc" -eq 0 ]] || exit "$rc"
    done
    sleep 2
    for pid in $pids; do
      arnold_supervisor_bind_signal_context_for_pid "$pid" "$marker_dir" non_worker || continue
      arnold_supervisor_signal_bound_pid ensure-megaplan-watchdog "$pid" SIGKILL kill watchdog-heartbeat-stale
      rc=$?
      [[ "$rc" -eq 0 ]] || exit "$rc"
    done
  ' 2>>"$LOG"
  signal_rc=$?
  if [[ "$signal_rc" -eq 75 ]]; then
    log "watchdog_signal_confirmation_pending container=$CONTAINER"
    exit 0
  fi
  if [[ "$signal_rc" -ne 0 ]]; then
    log "watchdog_signal_blocked container=$CONTAINER rc=$signal_rc"
    exit 1
  fi
fi

log "watchdog_missing restarting container=$CONTAINER"
# Observer launch: no per-epic ARNOLD_RUNTIME_MANIFEST / ARNOLD_REPAIR_SESSION.
docker exec -d "$CONTAINER" bash -lc "cd / && unset ARNOLD_RUNTIME_MANIFEST ARNOLD_REPAIR_SESSION ARNOLD_BABYSITTER_SESSION MEGAPLAN_SUPERVISOR_PYTHON PYTHONPATH && export ARNOLD_WATCHDOG_OBSERVER=1 CLOUD_WATCHDOG_INTERVAL_SECS=300 && nohup \"$WATCHDOG_WRAPPER\" >> \"$WATCHDOG_LOG\" 2>&1 & disown; echo launched" >> "$LOG" 2>&1

sleep 3
watchdog_procs="$(docker exec "$CONTAINER" bash -lc "$WATCHDOG_PGREP | wc -l" 2>/dev/null | tr -d ' ')"
if [[ "${watchdog_procs:-0}" -gt 0 ]]; then
  log "watchdog_restarted container=$CONTAINER procs=${watchdog_procs}"
  exit 0
fi

log "watchdog_restart_failed_not_alive container=$CONTAINER"
exit 1

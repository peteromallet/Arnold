from pathlib import Path

from agentbox.resident_profile import AgentBoxOperatorProfile


_PROJECT_ROOT = Path(__file__).resolve().parents[1]
_PROJECT_AGENT_PATH = _PROJECT_ROOT / ".omp" / "agents" / "{{NAME}}.md"


def _project_system_prompt() -> str:
    text = _PROJECT_AGENT_PATH.read_text(encoding="utf-8")
    marker = "\n---"
    if marker not in text:
        raise ValueError(f"resident agent file has no closing frontmatter delimiter: {_PROJECT_AGENT_PATH}")
    return text.split(marker, 1)[1].strip()


class {{PASCAL_NAME}}ResidentProfile(AgentBoxOperatorProfile):
    # DOMAIN TOOLS SLOT — two proven patterns:
    #   1. Gateway tool (recommended): ONE tool that shells out to your
    #      project's CLI/SDK gateway with an allowlist of families/verbs;
    #      never daemonize from a tool call.
    #   2. Catalog replacement: override _register_default_tools entirely and
    #      register your own ToolRegistration set (lazy-import
    #      arnold_pipelines.megaplan.resident.tool_registry/tool_schemas).
    # CONSTRAINTS (this file loads by path, not as a package):
    #   - no package-relative imports (from .x import y FAILS);
    #   - import resident-framework symbols lazily via a helper;
    #   - pydantic input models subclass the lazily imported ToolInput.: add project-specific domain tools to this profile when needed.

    def __init__(self, *, store, authorizer, config, confirmation_manager):
        super().__init__(
            store=store,
            authorizer=authorizer,
            config=config,
            confirmation_manager=confirmation_manager,
        )
        self._project_system_prompt = _project_system_prompt()

    def system_prompt(self) -> str:
        return self._project_system_prompt

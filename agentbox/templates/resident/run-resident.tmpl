#!/usr/bin/env bash
# Generated by `agentbox new-resident {{NAME}}` — hand-editable.
#
# Startup sequence (fail-closed custody; every step must pass before the next):
#   1. cd to this repository's exact root
#   2. source the real env file .agentbox/{{NAME}}.env and refuse placeholder
#      credentials (a still-empty DISCORD_BOT_TOKEN never reaches Discord)
#   3. select the external resident profile shipped in this repo
#   4. pin the repo-local resident store root
#   5. resolve the imported Arnold runtime root with this interpreter and pin
#      its exact checkout HEAD (the runtime is a separate custody identity
#      from this project repository; an editable install or PYTHONPATH
#      checkout both satisfy the contract as long as imports resolve there)
#   6. attest BOTH roots via `resident attest` (--repo-root/--expected-head
#      for this project, --runtime-root/--expected-runtime-head for the
#      imported Arnold runtime) and export the returned launch seed as
#      MEGAPLAN_RUNTIME_LAUNCH_SEED
#   7. exec `resident discord`, which validates that seed against the
#      published dispatch pointer and constructs the process attestation
#
# Attestation is never disabled or waived here. If any custody step fails,
# the launcher exits non-zero with the adapter's diagnostic and the resident
# never starts. Extra arguments are forwarded to `resident discord`
# (e.g. `./run-resident --dry-run` validates configuration without network).
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd -P)"
cd -- "$REPO_ROOT"

ENV_FILE="$REPO_ROOT/.agentbox/{{NAME}}.env"
if [ ! -f "$ENV_FILE" ]; then
    echo "run-resident: missing $ENV_FILE" >&2
    echo "run-resident: copy .agentbox/resident.env.example to .agentbox/{{NAME}}.env and fill it in" >&2
    exit 1
fi
set -a
# shellcheck disable=SC1090
. "$ENV_FILE"
set +a
if [ -z "${DISCORD_BOT_TOKEN:-}" ]; then
    echo "run-resident: DISCORD_BOT_TOKEN is empty in $ENV_FILE; refusing to start" >&2
    exit 1
fi

# One interpreter for both custody steps so the attest-time and startup-time
# interpreter vectors describe the same runtime.
if command -v python >/dev/null 2>&1; then
    PYTHON_BIN=python
else
    PYTHON_BIN=python3
fi

PROFILE_SPEC=".agentbox/resident_profile.py:{{PASCAL_NAME}}ResidentProfile"
STORE_ROOT="$REPO_ROOT/.megaplan/resident"

HEAD="$(git rev-parse HEAD)"

# Resolve the imported Arnold runtime with the SAME interpreter that will
# run the resident, so the attest-time and startup-time runtime vectors
# describe one runtime. Fail closed when imports do not resolve to a real
# Git checkout.
RUNTIME_OUTPUT=""
RUNTIME_STATUS=0
RUNTIME_OUTPUT="$(
    "$PYTHON_BIN" -c 'import os, arnold_pipelines; print(os.path.dirname(os.path.dirname(os.path.abspath(arnold_pipelines.__file__))))'
)" || RUNTIME_STATUS=$?
if [ "$RUNTIME_STATUS" -ne 0 ] || [ -z "$RUNTIME_OUTPUT" ] || [ ! -d "$RUNTIME_OUTPUT" ]; then
    echo "run-resident: could not resolve the imported Arnold runtime root via $PYTHON_BIN (exit $RUNTIME_STATUS); refusing to start" >&2
    echo "run-resident: install Arnold (python -m pip install -e /path/to/arnold) or export PYTHONPATH=/path/to/arnold" >&2
    exit 1
fi
RUNTIME_ROOT="$RUNTIME_OUTPUT"
if ! RUNTIME_HEAD="$(git -C "$RUNTIME_ROOT" rev-parse HEAD)"; then
    echo "run-resident: $RUNTIME_ROOT is not a usable Git checkout; refusing to start" >&2
    exit 1
fi

# `resident attest` prints exactly the seed path on success. On failure it
# prints the adapter's structured diagnostic on stdout and exits non-zero;
# capture both, republish the diagnostic, and exit with the same code so a
# custody mismatch is loud and never reaches Discord startup.
ATTEST_OUTPUT=""
ATTEST_STATUS=0
ATTEST_OUTPUT="$(
    "$PYTHON_BIN" -m arnold_pipelines.megaplan resident attest \
        --repo-root "$REPO_ROOT" \
        --expected-head "$HEAD" \
        --runtime-root "$RUNTIME_ROOT" \
        --expected-runtime-head "$RUNTIME_HEAD"
)" || ATTEST_STATUS=$?
if [ "$ATTEST_STATUS" -ne 0 ]; then
    printf '%s\n' "$ATTEST_OUTPUT" >&2
    echo "run-resident: resident attest failed (exit $ATTEST_STATUS); refusing to start" >&2
    exit "$ATTEST_STATUS"
fi
if [ -z "$ATTEST_OUTPUT" ]; then
    echo "run-resident: resident attest returned no launch seed path; refusing to start" >&2
    exit 1
fi
export MEGAPLAN_RUNTIME_LAUNCH_SEED="$ATTEST_OUTPUT"
exec "$PYTHON_BIN" -m arnold_pipelines.megaplan resident discord \
    --store-root "$STORE_ROOT" \
    --profile "$PROFILE_SPEC" \
    "$@"

[Unit]
Description={{NAME}} Discord resident
After=network.target

[Service]
Type=simple
WorkingDirectory={{REPO}}
# Required before startup: create {{REPO}}/.agentbox/{{NAME}}.env from
# resident.env.example and keep it mode 0600. run-resident loads this file.
ExecStart={{REPO}}/.agentbox/run-resident
Restart=on-failure
RestartSec=10
KillMode=process

[Install]
WantedBy=multi-user.target

   115	def ensure_hermes_home():
   116	    """Ensure ~/.hermes directory structure exists with secure permissions."""
   117	    home = get_hermes_home()
   118	    home.mkdir(parents=True, exist_ok=True)
   119	    _secure_dir(home)
   120	    for subdir in ("cron", "sessions", "logs", "memories"):
   121	        d = home / subdir
   122	        d.mkdir(parents=True, exist_ok=True)
   123	        _secure_dir(d)
   124	    _ensure_default_soul_md(home)

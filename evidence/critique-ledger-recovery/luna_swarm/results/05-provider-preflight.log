   180	def _raise_codex_via_openrouter_blocked(reason: str) -> None:
   181	    """Refuse to silently route codex/gpt-5.x through OpenRouter.
   182	
   183	    The harness would otherwise default bare ``gpt-5.5`` (etc.) to OpenRouter,
   184	    silently consuming OPENROUTER_API_KEY quotas.  The user intends these models
   185	    to run through the proper codex path, not OpenRouter.
   186	
   187	    Explicit ``openrouter:`` prefixed models still work — only the silent
   188	    *default* is removed.
   189	    """
   190	    from arnold_pipelines.megaplan.types import CliError
   191	
   192	    raise CliError(

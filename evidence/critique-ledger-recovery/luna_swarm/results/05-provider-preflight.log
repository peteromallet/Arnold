   127	def _argv_for_request(request: CloudToolRequest) -> list[str]:
   128	    args = request.arguments
   129	    cloud_yaml = args.get("cloud_yaml")
   130	    argv: list[str] = []
   131	    if request.operation == "cloud_status":
   132	        argv = ["status"]
   133	        if plan := args.get("plan"):
   134	            argv.extend(["--plan", plan])
   135	    elif request.operation == "cloud_status_chain":
   136	        argv = ["status", "--chain"]
   137	        if remote_spec := args.get("remote_spec"):
   138	            argv.extend(["--remote-spec", remote_spec])
   139	    elif request.operation == "cloud_start_chain":
   140	        spec = args.get("spec")
   141	        if not spec:
   142	            raise ValueError("cloud_start_chain requires spec")
   143	        argv = ["chain", spec]
   144	        if idea_dir := args.get("idea_dir"):
   145	            argv.extend(["--idea-dir", idea_dir])
   146	        _append_repo_args(argv, args)
   147	    elif request.operation == "cloud_bootstrap":
   148	        idea_file = args.get("idea_file")
   149	        if not idea_file:
   150	            raise ValueError("cloud_bootstrap requires idea_file")
   151	        argv = ["bootstrap", idea_file]
   152	        if plan_name := args.get("plan_name"):
   153	            argv.extend(["--plan-name", plan_name])
   154	        if robustness := args.get("robustness"):
   155	            argv.extend(["--robustness", robustness])
   156	        _append_repo_args(argv, args)
   157	    elif request.operation == "cloud_resume":
   158	        argv = ["resume"]
   159	        if plan := args.get("plan"):
   160	            argv.extend(["--plan", plan])
   161	    elif request.operation == "cloud_logs":
   162	        argv = ["logs"]
   163	        if args.get("no_follow") == "true":
   164	            argv.append("--no-follow")
   165	    else:
   166	        raise ValueError(f"unsupported cloud operation: {request.operation}")
   167	    if cloud_yaml:
   168	        argv.extend(["--cloud-yaml", cloud_yaml])
   169	    return argv
   170	
   171	
   172	def _append_repo_args(argv: list[str], args: dict[str, str]) -> None:
   173	    if repo_url := args.get("repo_url"):
   174	        argv.extend(["--repo-url", repo_url])
   175	    if repo_branch := args.get("repo_branch"):
   176	        argv.extend(["--repo-branch", repo_branch])
   177	    if repo_workspace := args.get("repo_workspace"):
   178	        argv.extend(["--repo-workspace", repo_workspace])

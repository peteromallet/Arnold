   216	    async def _handle_batch(self, batch: BurstBatch[str, PersistedInboundEvent]) -> None:
   217	        items = _dedupe_persisted_events(batch.items)
   218	        if not items:
   219	            return
   220	        conversation = self.store.load_resident_conversation(batch.key) or items[-1].conversation
   221	        active_epic_id = conversation.active_epic_id
   222	        system_prompt = self.profile.system_prompt()
   223	        hot_context = await self.profile.load_hot_context(conversation.id)
   224	        message_ids = [item.message.id for item in items]
   225	        turn = self.store.create_turn(
   226	            epic_id=active_epic_id,
   227	            triggered_by_message_ids=message_ids,
   228	            prompt_snapshot={
   229	                "system_prompt": system_prompt,
   230	                "message_count": len(items),
   231	                "tool_catalog": self.profile.tools().as_schema_catalog(),
   232	            },
   233	            prompt_version=hot_context.get("prompt_version") if isinstance(hot_context, dict) else None,
   234	            state_at_turn=hot_context,
   235	            model_version=self.config.model_name,
   236	            idempotency_key=deterministic_idempotency_key("resident-turn", conversation.id, *message_ids),
   237	        )
   238	        for item in items:
   239	            self.store.update_message(
   240	                item.message.id,
   241	                bot_turn_id=turn.id,
   242	                in_burst_with=[msg_id for msg_id in message_ids if msg_id != item.message.id] or None,
   243	                idempotency_key=deterministic_idempotency_key("resident-message-turn", item.message.id, turn.id),
   244	            )
   245	        burst = tuple({"role": "user", "content": item.event.content} for item in items)
   246	        history = self._build_history(conversation.id, exclude_ids=message_ids)
   247	        request_messages = (*history, *burst)
   248	        model_seam_metadata = self._model_seam_metadata(
   249	            conversation_id=conversation.id,
   250	            messages=request_messages,
   251	            system_prompt=system_prompt,
   252	            hot_context=hot_context,
   253	        )
   254	        request = AgentRequest(
   255	            conversation_id=conversation.id,
   256	            messages=request_messages,
   257	            system_prompt=system_prompt,
   258	            hot_context=hot_context,
   259	            model_seam_metadata=model_seam_metadata,
   260	            subject=items[-1].event.subject,
   261	            escalation_id=items[-1].event.escalation_id,
   262	            resume_handler=items[-1].event.resume_handler,
   263	            target_id=items[-1].event.target_id,
   264	        )
   265	        try:
   266	            response = await self.runner.run(request, self.profile.tools())
   267	        except Exception as exc:
   268	            self.store.update_turn(
   269	                turn.id,
   270	                status="failed",
   271	                warnings_issued=[f"{exc.__class__.__name__}: {exc}"],
   272	                idempotency_key=deterministic_idempotency_key("resident-turn-failed", turn.id),
   273	            )
   274	            raise
   275	        self._record_tool_calls(turn.id, response)
   276	        final_message_id = None
   277	        if response.final_text:
   278	            safe_text = redact_text(response.final_text)
   279	            outbound = self.store.create_message(
   280	                epic_id=active_epic_id,
   281	                conversation_id=conversation.id,
   282	                direction="outbound",
   283	                content=safe_text,
   284	                bot_turn_id=turn.id,
   285	                idempotency_key=deterministic_idempotency_key("resident-outbound", turn.id, "final"),
   286	            )
   287	            final_message_id = outbound.id
   288	            await self.outbound.send(
   289	                OutboundMessage(
   290	                    conversation_key=conversation.conversation_key,
   291	                    content=safe_text,
   292	                    idempotency_key=outbound.idempotency_key,
   293	                    metadata={"conversation_id": conversation.id, "message_id": outbound.id, "turn_id": turn.id},
   294	                )
   295	            )
   296	            self.store.update_resident_conversation(
   297	                conversation.id,
   298	                last_outbound_message_id=outbound.id,
   299	                delivery_cursor=outbound.id,
   300	                last_active_at=utc_now(),
   301	                idempotency_key=deterministic_idempotency_key("resident-conversation-outbound", conversation.id, outbound.id),
   302	            )
   303	        self.store.update_turn(
   304	            turn.id,
   305	            status="completed",
   306	            final_output_message_id=final_message_id,
   307	            message_sent=bool(final_message_id),
   308	            idempotency_key=deterministic_idempotency_key("resident-turn-completed", turn.id),
   309	        )

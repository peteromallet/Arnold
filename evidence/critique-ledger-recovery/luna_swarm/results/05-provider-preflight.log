   460	def _openai_client(config: ResidentConfig) -> Any:
   461	    try:
   462	        from openai import AsyncOpenAI
   463	    except ImportError as exc:
   464	        raise AgentLoopError("The openai package is required for live resident model turns") from exc
   465	    kwargs: dict[str, Any] = {"api_key": _api_key(config)}
   466	    base_url = _base_url(config)
   467	    if base_url:
   468	        kwargs["base_url"] = base_url
   469	    return AsyncOpenAI(**kwargs)

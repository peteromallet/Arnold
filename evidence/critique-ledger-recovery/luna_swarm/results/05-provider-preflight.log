   274	            value = (os.environ.get(candidate) or source.get(candidate) or "").strip().strip("'\"")
   275	            if value:
   276	                return value
   277	        return ""
   278	
   279	    def load_hermes_env(self) -> dict[str, str]:
   280	        with self._lock:
   281	            self._load_keys_unlocked(time.monotonic())
   282	            if broker_production_mode_requested():
   283	                return {}
   284	            return dict(self._hermes_env)
   285	
   286	    def get_api_credential(self, env_var: str, hermes_env: dict[str, str] | None = None) -> str:
   287	        with self._lock:
   288	            self._load_keys_unlocked(time.monotonic())
   289	            if broker_production_mode_requested():
   290	                return ""
   291	            return self._get_api_credential_unlocked(env_var, hermes_env)
   292	

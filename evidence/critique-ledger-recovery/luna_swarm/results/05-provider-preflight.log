    23	def _register_resident_subcommands(parser: argparse.ArgumentParser) -> None:
    24	    sub = parser.add_subparsers(dest="resident_action", required=True)
    25	    shared = argparse.ArgumentParser(add_help=False)
    26	    shared.add_argument("--store-root", help="Use a local FileStore root for resident state")
    27	    shared.add_argument("--mode", choices=["dev", "production"], help="Override MEGAPLAN_RESIDENT_MODE")
    28	
    29	    discord_parser = sub.add_parser("discord", parents=[shared], help="Start the resident Discord service")
    30	    discord_parser.add_argument("--dry-run", action="store_true", help="Validate configuration without connecting to Discord")
    31	    discord_parser.add_argument(
    32	        "--profile",
    33	        choices=["megaplan", "agentbox_operator"],
    34	        help="Resident profile to run for Discord.",
    35	    )
    36	
    37	    scheduler_parser = sub.add_parser("scheduler-once", parents=[shared], help="Claim and process due resident jobs once")
    38	    scheduler_parser.add_argument("--worker-id", default="resident-cli-scheduler")
    39	
    40	    health_parser = sub.add_parser("health", parents=[shared], help="Report resident orchestration health")
    41	    health_parser.add_argument("--limit", type=int, default=10)
    42	
    43	
    44	def run_resident_cli(root: Path, args: argparse.Namespace) -> dict[str, Any]:
    45	    config = _resident_config(args)
    46	    store = _resident_store(root, args)
    47	    try:
    48	        action = args.resident_action
    49	        if action == "health":
    50	            return _resident_health(store, config, limit=args.limit)
    51	        if action == "scheduler-once":
    52	            return asyncio.run(_resident_scheduler_once(store, config, worker_id=args.worker_id))
    53	        if action == "discord":
    54	            return _resident_discord(root, store, config, dry_run=args.dry_run)
    55	    finally:
    56	        close = getattr(store, "close", None)
    57	        if callable(close):
    58	            close()
    59	    raise CliError("invalid_args", f"Unknown resident action: {getattr(args, 'resident_action', None)!r}")
    60	
    61	
    62	def _resident_config(args: argparse.Namespace) -> ResidentConfig:
    63	    config = ResidentConfig.from_env()
    64	    mode = getattr(args, "mode", None)
    65	    profile = getattr(args, "profile", None)
    66	    updates = {}
    67	    if mode:
    68	        updates["mode"] = mode
    69	    if profile:
    70	        updates["profile"] = profile
    71	    return config.model_copy(update=updates) if updates else config
    72	
    73	
    74	def _resident_store(root: Path, args: argparse.Namespace) -> Store:
    75	    if getattr(args, "store_root", None):
    76	        return FileStore(Path(args.store_root).expanduser().resolve())
    77	    config = _resident_config(args)
    78	    if config.is_production:
    79	        return DBStore(actor_id="resident")
    80	    return FileStore(root / ".megaplan" / "resident")
    81	

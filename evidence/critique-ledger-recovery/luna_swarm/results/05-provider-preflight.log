    39	        root_dest="/root/.hermes/auth.json",
    40	    ),
    41	)
    42	
    43	
    44	def _remote_seed_command(*, payload_b64: str, persistent_dest: str, root_dest: str) -> str:
    45	    persistent = PurePosixPath(persistent_dest)
    46	    root = PurePosixPath(root_dest)
    47	    persistent_tmp = persistent.with_name(f".{persistent.name}.tmp.$$")
    48	    root_tmp = root.with_name(f".{root.name}.tmp.$$")
    49	    return " ".join(
    50	        [
    51	            "umask 077;",
    52	            f"mkdir -p {shlex.quote(str(persistent.parent))} {shlex.quote(str(root.parent))};",
    53	            f"AUTH_B64={shlex.quote(payload_b64)};",
    54	            f"tmp={shlex.quote(str(persistent_tmp))};",
    55	            'printf %s "$AUTH_B64" | base64 -d > "$tmp" &&',
    56	            f"mv \"$tmp\" {shlex.quote(str(persistent))} &&",
    57	            f"chmod 600 {shlex.quote(str(persistent))} &&",
    58	            f"tmp={shlex.quote(str(root_tmp))};",
    59	            'printf %s "$AUTH_B64" | base64 -d > "$tmp" &&',
    60	            f"mv \"$tmp\" {shlex.quote(str(root))} &&",
    61	            f"chmod 600 {shlex.quote(str(root))};",
    62	            "unset AUTH_B64",
    63	        ]
    64	    )
    65	
    66	
    67	def seed_codex_oauth(
    68	    spec: CloudSpec,
    69	    provider: Any,
    70	    *,
    71	    home: Path | None = None,
    72	    writer: Callable[[str], object] | None = None,
    73	) -> dict[str, list[dict[str, str]]]:
    74	    """Best-effort seed of local ChatGPT Codex OAuth into the cloud box.
    75	
    76	    The seed is written both to the persistent volume under ``/workspace/.creds``
    77	    and to the current root home so an already-running box can use it
    78	    immediately. Entrypoint boot copies the persistent files back into ``/root``
    79	    after restarts.
    80	    """
    81	    write = writer or sys.stderr.write
    82	    events: list[dict[str, str]] = []
    83	    if spec.megaplan.codex_auth == "apikey":
    84	        message = "cloud codex OAuth seed: skipped because megaplan.codex_auth=apikey\n"
    85	        write(message)
    86	        return {"events": [{"label": "all", "status": "skipped", "reason": "codex_auth=apikey"}]}
    87	
    88	    root = home or Path.home()
    89	    for seed in OAUTH_SEEDS:
    90	        local_path = root / seed.local_relative
    91	        if not local_path.exists():
    92	            message = f"cloud codex OAuth seed: local {local_path} absent; skipping {seed.label}\n"
    93	            write(message)
    94	            events.append({"label": seed.label, "status": "skipped", "reason": "absent"})
    95	            continue
    96	        payload_b64 = base64.b64encode(local_path.read_bytes()).decode("ascii")
    97	        command = _remote_seed_command(
    98	            payload_b64=payload_b64,
    99	            persistent_dest=seed.persistent_dest,
   100	            root_dest=seed.root_dest,
   101	        )
   102	        try:
   103	            result: subprocess.CompletedProcess[str] = provider.ssh_exec(command)
   104	        except Exception as exc:  # pragma: no cover - defensive best-effort path
   105	            write(f"cloud codex OAuth seed: {seed.label} seed failed: {exc}\n")
   106	            events.append({"label": seed.label, "status": "failed", "reason": str(exc)})
   107	            continue
   108	        if result.returncode == 0:
   109	            write(
   110	                f"cloud codex OAuth seed: seeded {seed.label} auth to {seed.persistent_dest} "
   111	                f"and {seed.root_dest}\n"
   112	            )
   113	            events.append({"label": seed.label, "status": "seeded"})
   114	            continue
   115	        reason = (result.stderr or result.stdout or f"exit {result.returncode}").strip()
   116	        write(f"cloud codex OAuth seed: {seed.label} seed failed: {reason}\n")
   117	        events.append({"label": seed.label, "status": "failed", "reason": reason})
   118	    return {"events": events}

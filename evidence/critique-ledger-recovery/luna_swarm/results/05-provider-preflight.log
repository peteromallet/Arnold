   262	def _audit_denial(
   263	    audit_sink: EscalationAuditSink | None,
   264	    subject: AuthorizationSubject,
   265	    action: str,
   266	    escalation_id: str,
   267	    reason: str,
   268	    idempotency_key: str,
   269	    extra: dict[str, Any] | None = None,
   270	) -> None:
   271	    if audit_sink is None:
   272	        return
   273	    details = {
   274	        "reason": reason,
   275	        "action": action,
   276	        "escalation_id": escalation_id,
   277	        "user_id": subject.user_id,
   278	        "guild_id": subject.guild_id,
   279	        "channel_id": subject.channel_id,
   280	    }
   281	    if extra:
   282	        details.update(extra)
   283	    audit_sink.log_system_event(
   284	        level="warn",
   285	        category="system",
   286	        event_type="escalation_answer_unauthorized",
   287	        message="Escalation answer denied before resident mutation",
   288	        details=details,
   289	        idempotency_key=deterministic_idempotency_key(
   290	            "resident-escalation-denial",
   291	            idempotency_key or escalation_id,
   292	            reason,
   293	        ),
   294	    )
   295	

    45	@dataclass(frozen=True)
    46	class EscalationAnswerDecision:
    47	    allowed: bool
    48	    reason: str | None = None
    49	    target: EscalationTarget | None = None
    50	
    51	
    52	@dataclass(frozen=True)
    53	class EscalationConfirmationDecision:
    54	    allowed: bool
    55	    confirmation_required: bool = False
    56	    reason: str | None = None
    57	    request_id: str | None = None
    58	    exact_phrase: str | None = None

   260	        agent_kwargs["api_key"] = acquire_key("zhipu")
   261	    elif resolved_model.startswith("kimi:"):
   262	        resolved_model = resolved_model[len("kimi:"):]
   263	        kimi_key = acquire_key("kimi")
   264	        agent_kwargs["api_key"] = kimi_key
   265	        agent_kwargs["base_url"] = resolve_kimi_base_url(
   266	            kimi_key,
   267	            _DEFAULT_BASE_URLS["kimi"],
   268	            _get_api_credential(_PROVIDER_BASE_URL_VARS["kimi"]),
   269	        )
   270	    elif resolved_model.startswith("google:"):
   271	        resolved_model = resolved_model[len("google:"):]
   272	        agent_kwargs["base_url"] = _DEFAULT_BASE_URLS["google"]
   273	        agent_kwargs["api_key"] = acquire_key("google")
   274	    elif resolved_model.startswith("deepseek:"):
   275	        resolved_model = resolved_model[len("deepseek:"):]
   276	        agent_kwargs["base_url"] = _get_api_credential(_PROVIDER_BASE_URL_VARS["deepseek"]) or _DEFAULT_BASE_URLS["deepseek"]
   277	        agent_kwargs["api_key"] = acquire_key("deepseek")
   278	    elif resolved_model.startswith("fireworks:"):
   279	        resolved_model = resolved_model[len("fireworks:"):]
   280	        direct_deepseek_model = _fireworks_deepseek_model_name(resolved_model)
   281	        if direct_deepseek_model is not None:

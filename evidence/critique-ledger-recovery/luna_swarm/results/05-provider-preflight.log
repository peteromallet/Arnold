ion_taken\", False),\n   479|            action_description=data.get(\"action_description\"),\n   480|            accountable_scope=data.get(\"accountable_scope\", \"\"),\n   481|            is_reopen=data.get(\"is_reopen\", False),\n   482|            reopen_predicate=data.get(\"reopen_predicate\"),\n   483|            evidence_refs=tuple(data.get(\"evidence_refs\", ())),\n   484|            authority=data.g...ty\", Authority.EVALUATOR.value),\n   485|            timestamp_utc=data.get(\"timestamp_utc\", \"\"),\n   486|            metadata=dict(data.get(\"metadata\", {})),\n   487|            _extra=extra,\n   488|        )\n   489|\n   490|\n   491|# ══════════════════════════════════════════════════════════════════════\n   492|# Provisional CL1 briefing budgets\n   493|# ══════════════════════════════════════════════════════════════════════\n   494|\n   495|BRIEFING_BUDGETS = {\n   496|    \"standard\": {\"max_domains\": 2, \"max_findings\": 10},\n   497|    \"high\": {\"max_domains\": 4, \"max_findings\": 25},\n   498|    \"exhaustive\": {\"max_domains\": None, \"max_findings\": None},  # all / unbounded\n   499|}\n   500|\n   501|\n   502|@dataclass(frozen=True)\n   503|class DomainBriefingEnvelope:\n   504|    \"\"\"A domain-scoped briefing built from an accepted LedgerRevisionManifest.\n   505|\n   506|    Provisional CL1 budgets:\n   507|      - standard: 2 domains / 10 findings\n   508|      - high: 4 domains / 25 findings\n   509|      - exhaustive: all catalog domains / unbounded\n   510|\n   511|    All budgets enforce mandatory domain floors. Overflow findings are\n   512|    linked via spillover references — never silently truncated.\n   513|    Silent truncation must raise an error.\n   514|    \"\"\"\n   515|\n   516|    schema_version: str = SCHEMA_VERSION\n   517|    briefing_id: str = \"\"\n   518|    revision_manifest_hash: str = \"\"\n   519|    budget_level: str = \"standard\"\n   520|    domains: tuple[str, ...] = ()\n   521|    findings: tuple[str, ...] = ()\n   522|    open_findings: tuple[str, ...] = ()\n   523|    blocked_findings: tuple[str, ...] = ()\n   524|    accepted_risk_findings: tuple[str, ...] = ()\n   525|    unknown_findings: tuple[str, ...] = ()\n   526|    cross_domain_refs: tuple[str, ...] = ()\n   527|    spillover_findings: tuple[str, ...] = ()\n   528|    no_additional_findings: bool = False\n   529|    no_open_blocking_findings: bool = False\n   530|    no_known_findings: bool = False\n   531|    no_adjacent_text_match: bool = False\n   532|    is_truncated: bool = False\n   533|    truncation_warning: Optional[str] = None\n   534|    timestamp_utc: str = \"\"\n   535|    metadata: dict[str, Any] = field(default_factory=dict)\n   536|    _extra: dict[str, Any] = field(default_factory=dict)\n   537|\n   538|    @classmethod\n   539|    def validate_budget(\n   540|        cls, budget_level: str, domain_count: int, finding_count: int\n   541|    ) -> None:\n   542|        \"\"\"Validate that domain/finding counts fit within the budget.\n   543|\n   544|        Raises:\n   545|            ValueError: if budget_level is unknown or counts exceed budget\n   546|                        without explicit spillover handling.\n   547|        \"\"\"\n   548|        if budget_level not in BRIEFING_BUDGETS:\n   549|            raise ValueError(\n   550|                f\"Unknown budget_level: {budget_level!r}. \"\n   551|                f\"Valid: {list(BRIEFING_BUDGETS)}\"\n   552|            )\n   553|        budget = BRIEFING_BUDGETS[budget_level]\n   554|        max_d = budget[\"max_domains\"]\n   555|        max_f = budget[\"max_findings\"]\n   556|        if max_d is not None and domain_count > max_d:\n   557|            raise ValueError(\n   558|                f\"Domain count {domain_count} exceeds {budget_level} \"\n   559|                f\"budget max {max_d}. Use spillover, not silent truncation.\"\n   560|            )\n   561|        if max_f is not None and finding_count > max_f:\n   562|            raise ValueError(\n   563|                f\"Finding count {finding_count} exceeds {budget_level} \"\n   564|                f\"budget max {max_f}. Use spillover, not silent truncation.\"\n   565|            )\n   566|\n   567|    def to_dict(self, mode: str = \"strict\") -> dict[str, Any]:\n   568|        result: dict[str, Any] = {\n   569|            \"schema_version\": self.schema_version,\n   570|            \"briefing_id\": self.briefing_id,\n   571|            \"revision_manifest_hash\": self.revision_manifest_hash,\n   572|            \"budget_level\": self.budget_level,\n   573|            \"domains\": list(self.domains),\n   574|            \"findings\": list(self.findings),\n   575|            \"open_findings\": list(self.open_findings),\n   576|            \"blocked_findings\": list(self.blocked_findings),\n   577|            \"accepted_risk_findings\": list(self.accepted_risk_findings),\n   578|            \"unknown_findings\": list(self.unknown_findings),\n   579|            \"cross_domain_refs\": list(self.cross_domain_refs),\n   580|            \"spillover_findings\": list(self.spillover_findings),\n   581|            \"no_additional_findings\": self.no_additional_findings,\n   582|            \"no_open_blocking_findings\": self.no_open_blocking_findings,\n   583|            \"no_known_findings\": self.no_known_findings,\n   584|            \"no_adjacent_text_match\": self.no_adjacent_text_match,\n   585|            \"is_truncated\": self.is_truncated,\n   586|            \"truncation_warning\": self.truncation_warning,\n   587|            \"timestamp_utc\": self.timestamp_utc,\n   588|            \"metadata\": dict(self.metadata),\n   589|        }\n   590|        if mode == \"preserve\" and self._extra:\n   591|            result.update(self._extra)\n   592|        return result\n   593|\n   594|    @classmethod\n   595|    def from_dict(\n   596|        cls, data: dict[str, Any], mode: str = \"strict\"\n   597|    ) -> \"DomainBriefingEnvelope\":\n   598|        version = data.get(\"schema_version\", SCHEMA_VERSION)\n   599|        if version not in SUPPORTED_VERSIONS:\n   600|            raise ValueError(f\"Unsupported schema_version: {version!r}\")\n   601|\n   602|        known_fields = {\n   603|            \"schema_version\", \"briefing_id\", \"revision_manifest_hash\",\n   604|            \"budget_level\", \"domains\", \"findings\", \"open_findings\",\n   605|            \"blocked_findings\", \"accepted_risk_findings\", \"unknown_findings\",\n   606|            \"cross_domain_refs\", \"spillover_findings\",\n   607|            \"no_additional_findings\", \"no_open_blocking_findings\",\n   608|            \"no_known_findings\", \"no_adjacent_text_match\",\n   609|            \"is_truncated\", \"truncation_warning\", \"timestamp_utc\", \"metadata\",\n   610|        }\n   611|        extra = {}\n   612|        for key in data:\n   613|            if key not in known_fields and key != \"_extra\":\n   614|                if mode == \"strict\":\n   615|                    raise ValueError(f\"Unknown field {key!r} in strict mode.\")\n   616|                extra[key] = data[key]\n   617|\n   618|        return cls(\n   619|            schema_version=version,\n   620|            briefing_id=data.get(\"briefing_id\", \"\"),\n   621|            revision_manifest_hash=data.get(\"revision_manifest_hash\", \"\"),\n   622|            budget_level=data.get(\"budget_level\", \"standard\"),\n   623|            domains=tuple(data.get(\"domains\", ())),\n   624|            findings=tuple(data.get(\"findings\", ())),\n   625|            open_findings=tuple(data.get(\"open_findings\", ())),\n   626|            blocked_findings=tuple(data.get(\"blocked_findings\", ())),\n   627|            accepted_risk_findings=tuple(data.get(\"accepted_risk_findings\", ())),\n   628|            unknown_findings=tuple(data.get(\"unknown_findings\", ())),\n   629|            cross_domain_refs=tuple(data.get(\"cross_domain_refs\", ())),\n   630|            spillover_findings=tuple(data.get(\"spillover_findings\", ())),\n   631|            no_additional_findings=data.get(\"no_additional_findings\", False),\n   632|            no_open_blocking_findings=data.get(\"no_open_blocking_findings\", False),\n   633|            no_known_findings=data.get(\"no_known_findings\", False),\n   634|            no_adjacent_text_match=data.get(\"no_adjacent_text_match\", False),\n   635|            is_truncated=data.get(\"is_truncated\", False),\n   636|            truncation_warning=data.get(\"truncation_warning\"),\n   637|            timestamp_utc=data.get(\"timestamp_utc\", \"\"),\n   638|            metadata=dict(data.get(\"metadata\", {})),\n   639|            _extra=extra,\n   640|        )\n   641|\n   642|\n   643|@dataclass(frozen=True)\n   644|class LedgerRevisionManifest:\n   645|    \"\"\"Exact freshness vectors and completeness maps for a critique\n   646|    ledger revision.\n   647|\n   648|    Ties together:\n   649|      - input-set hashes (all sources consumed)\n   650|      - prior-revision hash chain\n   651|      - completeness maps per domain/schema\n   652|      - WBC receipt references\n   653|      - deterministic event ordering\n   654|    \"\"\"\n   655|\n   656|    schema_version: str = SCHEMA_VERSION\n   657|    manifest_id: str = \"\"\n   658|    revision_number: int = 1\n   659|    prior_revision_hash: Optional[str] = None\n   660|    input_set_hash: str = \"\"\n   661|    source_revisions: tuple[str, ...] = ()\n   662|    domain_completeness: dict[str, bool] = field(default_factory=dict)\n   663|    wbc_receipt_refs: tuple[str, ...] = ()\n   664|    event_ids: tuple[str, ...] = ()\n   665|    included_reasons: dict[str, str] = field(default_factory=dict)\n   666|    excluded_reasons: dict[str, str] = field(default_factory=dict)\n   667|    cross_domain_refs: tuple[str, ...] = ()\n   668|    timestamp_utc: str = \"\"\n   669|    metadata: dict[str, Any] = field(default_factory=dict)\n   670|    _extra: dict[str, Any] = field(default_factory=dict)\n   671|\n   672|    def to_dict(self, mode: str = \"strict\") -> dict[str, Any]:\n   673|        result: dict[str, Any] = {\n   674|            \"schema_version\": self.schema_version,\n   675|            \"manifest_id\": self.manifest_id,\n   676|            \"revision_number\": self.revision_number,\n   677|            \"prior_revision_hash\": self.prior_revision_hash,\n   678|            \"input_set_hash\": self.input_set_hash,\n   679|            \"source_revisions\": list(self.source_revisions),\n   680|            \"domain_completeness\": dict(self.domain_completeness),\n   681|            \"wbc_receipt_refs\": list(self.wbc_receipt_refs),\n   682|            \"event_ids\": list(self.event_ids),\n   683|            \"included_reasons\": dict(self.included_reasons),\n   684|            \"excluded_reasons\": dict(self.excluded_reasons),\n   685|            \"cross_domain_refs\": list(self.cross_domain_refs),\n   686|            \"timestamp_utc\": self.timestamp_utc,\n   687|            \"metadata\": dict(self.metadata),\n   688|        }\n   689|        if mode == \"preserve\" and self._extra:\n   690|            result.update(self._extra)\n   691|        return result\n   692|\n   693|    @classmethod\n   694|    def from_dict(\n   695|        cls, data: dict[str, Any], mode: str = \"strict\"\n   696|    ) -> \"LedgerRevisionManifest\":\n   697|        version = data.get(\"schema_version\", SCHEMA_VERSION)\n   698|        if version not in SUPPORTED_VERSIONS:\n   699|            raise ValueError(f\"Unsupported schema_version: {version!r}\")\n   700|\n   701|        known_fields = {\n   702|            \"schema_version\", \"manifest_id\", \"revision_number\",\n   703|            \"prior_revision_hash\", \"input_set_hash\", \"source_revisions\",\n   704|            \"domain_completeness\", \"wbc_receipt_refs\", \"event_ids\",\n   705|            \"included_reasons\", \"excluded_reasons\", \"cross_domain_refs\",\n   706|            \"timestamp_utc\", \"metadata\",\n   707|        }\n   708|        extra = {}\n   709|        for key in data:\n   710|            if key not in known_fields and key != \"_extra\":\n   711|                if mode == \"strict\":\n   712|                    raise ValueError(f\"Unknown field {key!r} in strict mode.\")\n   713|                extra[key] = data[key]\n   714|\n   715|        return cls(\n   716|            schema_version=version,\n   717|            manifest_id=data.get(\"manifest_id\", \"\"),\n   718|            revision_number=data.get(\"revision_number\", 1),\n   719|            prior_revision_hash=data.get(\"prior_revision_hash\"),\n   720|            input_set_hash=data.get(\"input_set_hash\", \"\"),\n   721|            source_revisions=tuple(data.get(\"source_revisions\", ())),\n   722|            domain_completeness=dict(data.get(\"domain_completeness\", {})),\n   723|            wbc_receipt_refs=tuple(data.get(\"wbc_receipt_refs\", ())),\n   724|            event_ids=tuple(data.get(\"event_ids\", ())),\n   725|            included_reasons=dict(data.get(\"included_reasons\", {})),\n   726|            excluded_reasons=dict(data.get(\"excluded_reasons\", {})),\n   727|            cross_domain_refs=tuple(data.get(\"cross_domain_refs\", ())),\n   728|            timestamp_utc=data.get(\"timestamp_utc\", \"\"),\n   729|            metadata=dict(data.get(\"metadata\", {})),\n   730|            _extra=extra,\n   731|        )\n   732|", "total_lines": 731, "file_size": 30687, "truncated": false, "is_binary": false, "is_image": false}
./critique-ledger-m9-planner-prompt.txt:1779:{"content": "   960|# Phase 7: Complete replay\n   961|# ══════════════════════════════════════════════════════════════════════\n   962|\n   963|\n   964|def replay_full(\n   965|    occurrences: list[CritiqueOccurrenceEnvelope],\n   966|    reconciliations: list[FindingReconciliationEvent],\n   967|    dispositions: list[FindingDispositionEvent],\n   968|    wbc_receipt_chain: dict[str, Any] | None = None,\n   969|    budget_level: str = \"standard\",\n   970|    domain_assignments: dict[str, str] | None = None,\n   971|    domain_completeness: dict[str, bool] | None = None,\n   972|    allow_reopen: bool = True,\n   973|    prior_manifest: LedgerRevisionManifest | None = None,\n   974|    expected_prior_revision_hash: str | None = None,\n   975|) -> dict[str, Any]:\n   976|    \"\"\"Execute a complete semantic loop replay.\n   977|\n   978|    Runs all phases in order: custody → reconciliation → disposition →\n   979|    manifest → briefing → projections. Fails before projections if any\n   980|    phase produces a typed validation failure.\n   981|\n   982|    Args:\n   983|        occurrences: All critique occurrence envelopes.\n   984|        reconciliations: Ordered reconciliation events.\n   985|        dispositions: Ordered disposition events.\n   986|        wbc_receipt_chain: WBC receipt chain for custody validation.\n   987|        budget_level: Briefing budget level.\n   988|        domain_assignments: Semantic finding → domain assignments.\n   989|        domain_completeness: Domain → is_complete map.\n   990|        allow_reopen: Whether REOPEN events are permitted.\n   991|\n   992|    Returns:\n   993|        Dict with keys: custody, reconciliation, disposition, manifest,\n   994|        briefing, reviser_projection, gate_projection.\n   995|\n   996|    Raises:\n   997|        SemanticLoopError: If any phase fails validation, before any\n   998|            projection is produced.\n   999|    \"\"\"\n  1000|    if wbc_receipt_chain is None:\n  1001|        wbc_receipt_chain = {}\n  1002|\n  1003|    # Phase 0: Pre-validate occurrences and attempt lifecycle.  Metadata\n  1004|    # fields are optional for imported legacy rows; when present they are\n  1005|    # enforced rather than guessed.\n  1006|    occurrence_ids: set[str] = set()\n  1007|    for occ in occurrences:\n  1008|        if occ.schema_version != SCHEMA_VERSION:\n  1009|            raise SemanticLoopError(\n  1010|                mode=FailureMode.SCHEMA_INCOMPATIBLE,\n  1011|                detail=f\"Occurrence {occ.occurrence_id} uses {occ.schema_version}\",\n  1012|            )\n  1013|        if occ.parse_status == ParseStatus.FAILED.value:\n  1014|            raise SemanticLoopError(\n  1015|                mode=FailureMode.OCCURRENCE_PARSE_FAILED,\n  1016|                detail=f\"Occurrence {occ.occurrence_id} has parse_status=FAILED\",\n  1017|            )\n  1018|        if occ.parse_status == ParseStatus.DROPPED.value:\n  1019|            raise SemanticLoopError(\n  1020|                mode=FailureMode.ATTEMPT_DROPPED,\n  1021|                detail=f\"Occurrence {occ.occurrence_id} was dropped\",\n  1022|            )\n  1023|        if not occ.occurrence_id:\n  1024|            raise SemanticLoopError(\n  1025|                mode=FailureMode.OCCURRENCE_MISSING_ID,\n  1026|                detail=\"Occurrence has empty occurrence_id\",\n  1027|            )\n  1028|        if occ.occurrence_id in occurrence_ids:\n  1029|            raise SemanticLoopError(\n  1030|                mode=FailureMode.OCCURRENCE_DUPLICATE_ID,\n  1031|                detail=f\"Duplicate occurrence_id {occ.occurrence_id}\",\n  1032|            )\n  1033|        occurrence_ids.add(occ.occurrence_id)\n  1034|        if occ.metadata.get(\"start_persisted\") is False:\n  1035|            raise SemanticLoopError(\n  1036|                mode=FailureMode.START_PERSISTENCE_FAILED,\n  1037|                detail=f\"Attempt {occ.attempt_id} lacks durable start evidence\",\n  1038|            )\n  1039|        if occ.metadata.get(\"terminal_persisted\") is False:\n  1040|            raise SemanticLoopError(\n  1041|                mode=FailureMode.TERMINAL_PERSISTENCE_FAILED,\n  1042|                detail=f\"Attempt {occ.attempt_id} lacks durable terminal evidence\",\n  1043|            )\n  1044|        terminal_count = occ.metadata.get(\"terminal_outcome_count\", 1)\n  1045|        if terminal_count != 1:\n  1046|            raise SemanticLoopError(\n  1047|                mode=FailureMode.TERMINAL_OUTCOME_INVALID,\n  1048|                detail=(\n  1049|                    f\"Attempt {occ.attempt_id} has {terminal_count} terminal \"\n  1050|                    \"outcomes; exactly one is required\"\n  1051|                ),\n  1052|            )\n  1053|        if \"owner\" in occ.metadata and not occ.metadata.get(\"owner\"):\n  1054|            raise SemanticLoopError(\n  1055|                mode=FailureMode.OWNERSHIP_MISSING,\n  1056|                detail=f\"Occurrence {occ.occurrence_id} has no owner\",\n  1057|            )\n  1058|        if occ.metadata.get(\"evidence_fresh\") is False:\n  1059|            raise SemanticLoopError(\n  1060|                mode=FailureMode.EVIDENCE_STALE,\n  1061|                detail=f\"Occurrence {occ.occurrence_id} evidence is stale\",\n  1062|            )\n  1063|        if (\n  1064|            occ.metadata.get(\"required_for_briefing\") is True\n  1065|            and occ.evidence_availability == EvidenceAvailability.UNAVAILABLE.value\n  1066|        ):\n  1067|            raise SemanticLoopError(\n  1068|                mode=FailureMode.BRIEFING_INPUT_UNAVAILABLE,\n  1069|                detail=f\"Required briefing input {occ.occurrence_id} is unavailable\",\n  1070|            )\n  1071|        if (\n  1072|            occ.parse_status == ParseStatus.TOMBSTONED.value\n  1073|            and not occ.metadata.get(\"tombstone_reason\")\n  1074|        ):\n  1075|            raise SemanticLoopError(\n  1076|                mode=FailureMode.TOMBSTONE_INVALID,\n  1077|                detail=f\"Tombstone {occ.occurrence_id} lacks tombstone_reason\",\n  1078|            )\n  1079|\n  1080|    valid_authorities=*** for item in Authority}\n  1081|    for event in [*reconciliations, *dispositions]:\n  1082|        if event.schema_version != SCHEMA_VERSION:\n  1083|            raise SemanticLoopError(\n  1084|                mode=FailureMode.SCHEMA_INCOMPATIBLE,\n  1085|                detail=f\"Event uses incompatible schema {event.schema_version}\",\n  1086|            )\n  1087|        if event.authority not in valid_authorities:\n  1088|            raise SemanticLoopError(\n  1089|                mode=FailureMode.OWNERSHIP_MISSING,\n  1090|                detail=\"Semantic event lacks accepted evaluator/curator authority\",\n  1091|            )\n  1092|\n  1093|    # Phase 1: Custody\n  1094|    custody_result = validate_occurrence_custody(occurrences, wbc_receipt_chain)\n  1095|    if not custody_result[\"valid\"]:\n  1096|        raise SemanticLoopError(\n  1097|            mode=custody_result[\"failures\"][0][\"mode\"],\n  1098|            detail=custody_result[\"failures\"][0].get(\"detail\", \"Custody validation failed\"),\n  1099|            failures=custody_result[\"failures\"],\n  1100|        )\n  1101|\n  1102|    # Phase 2: Reconciliation\n  1103|    rec_result = apply_reconciliation_events(occurrences, reconciliations, allow_reopen=allow_reopen)\n  1104|    hard_failures = [\n  1105|        f for f in rec_result[\"failures\"]\n  1106|        if f[\"mode\"] != FailureMode.RECONCILIATION_INFERRED_SAMENESS.value\n  1107|    ]\n  1108|    if hard_failures:\n  1109|        raise SemanticLoopError(\n  1110|            mode=hard_failures[0][\"mode\"],\n  1111|            detail=hard_failures[0].get(\"detail\", \"Reconciliation failed\"),\n  1112|            failures=rec_result[\"failures\"],\n  1113|        )\n  1114|\n  1115|    mapped_counts: dict[str, int] = {}\n  1116|    for mapped_ids in rec_result[\"finding_map\"].values():\n  1117|        for occurrence_id in mapped_ids:\n  1118|            mapped_counts[occurrence_id] = mapped_counts.get(occurrence_id, 0) + 1\n  1119|    parseable_ids = {\n  1120|", "total_lines": 1206, "file_size": 48088, "truncated": true, "hint": "Use offset=1120 to continue reading (showing 960-1119 of 1206 lines)", "is_binary": false, "is_image": false}
./critique-ledger-m9-planner-prompt.txt:1782:{"content": "   180|    \"\"\"\n   181|\n   182|    def __init__(self, reason: str) -> None:\n   183|        self.reason = reason\n   184|        super().__init__(reason)\n   185|\n   186|\n   187|# ── Enums ─────────────────────────────────────────────────────────────────\n   188|\n   189|\n   190|class LegacyClassification(Enum):\n   191|    \"\"\"Classification of a legacy or unreconstructable record.\n   192|\n   193|    The key rule (SD2 / criterion 9): records that cannot be confidently\n   194|    reconstructed are ``UNKNOWN`` / ``UNRECONSTRUCTABLE``. The migration system\n   195|    never synthesizes success (``BACKFILLED``) from incomplete evidence.\n   196|\n   197|    * ``BACKFILLED`` — the record was durably reconstructed from authoritative\n   198|      source evidence.\n   199|    * ``UNKNOWN`` — the record cannot be reconstructed and its true state is\n   200|      indeterminate. No terminal/success outcome is synthesized.\n   201|    * ``CORRUPT`` — the record or its source evidence is structurally damaged.\n   202|    * ``UNRECONSTRUCTABLE`` — no source exists from which to reconstruct the\n   203|      record (e.g. the producing system never persisted it).\n   204|    \"\"\"\n   205|\n   206|    BACKFILLED = \"backfilled\"\n   207|    UNKNOWN = \"unknown\"\n   208|    CORRUPT = \"corrupt\"\n   209|    UNRECONSTRUCTABLE = \"unreconstructable\"\n   210|\n   211|\n   212|@dataclass(frozen=True)\n   213|class ClassificationEvidence:\n   214|    \"\"\"Evidence profile for a legacy record being classified.\n   215|\n   216|    This dataclass makes the evidence sources *explicit* so that the\n   217|    classification decision function can reject BACKFILLED when the authority\n   218|    derives from impermissible sources (logs, markers, receipts, mutable state).\n   219|\n   220|    Attributes:\n   221|        has_authoritative_source: The record can be reconstructed from\n   222|            authoritative, durable source data (e.g. a separate durable store\n   223|            with matching checksums). This is the ONLY path to BACKFILLED.\n   224|        has_logs: Operational logs mention the record. NOT authoritative.\n   225|        has_markers: Checkpoint/status markers reference the record. NOT\n   226|            authoritative.\n   227|        has_receipts: Delivery receipts or acknowledgments exist. NOT\n   228|            authoritative.\n   229|        has_mutable_state: A mutable system (e.g. in-memory cache, runtime\n   230|            state) holds data about the record. NOT authoritative.\n   231|        is_structurally_damaged: The record or its source is structurally\n   232|            damaged (e.g. corrupt encoding, missing required fields).\n   233|        source_exists: ``False`` when no source system ever persisted the\n   234|            record (UNRECONSTRUCTABLE).\n   235|        notes: Free-form notes about the evidence assessment.\n   236|    \"\"\"\n   237|\n   238|    has_authoritative_source: bool = False\n   239|    has_logs: bool = False\n   240|    has_markers: bool = False\n   241|    has_receipts: bool = False\n   242|    has_mutable_state: bool = False\n   243|    is_structurally_damaged: bool = False\n   244|    source_exists: bool = True\n   245|    notes: str = \"\"\n   246|\n   247|    @property\n   248|    def only_circumstantial(self) -> bool:\n   249|        \"\"\"True when evidence consists ONLY of impermissible sources\n   250|        (logs, markers, receipts, mutable state) with no authoritative source.\"\"\"\n   251|        return (\n   252|            not self.has_authoritative_source\n   253|            and (\n   254|                self.has_logs\n   255|                or self.has_markers\n   256|                or self.has_receipts\n   257|                or self.has_mutable_state\n   258|            )\n   259|        )\n   260|\n   261|    @property\n   262|    def no_evidence(self) -> bool:\n   263|        \"\"\"True when no evidence of any kind is available.\"\"\"\n   264|        return (\n   265|            not self.has_authoritative_source\n   266|            and not self.has_logs\n   267|            and not self.has_markers\n   268|            and not self.has_receipts\n   269|            and not self.has_mutable_state\n   270|        )\n   271|\n   272|\n   273|# ── Checksum ──────────────────────────────────────────────────────────────\n   274|\n   275|\n   276|def compute_migration_checksum(\n   277|    version: int, name: str, statements: Sequence[str]\n   278|) -> str:\n   279|    \"\"\"Return the deterministic SHA-256 checksum for a migration.\n   280|\n   281|    The checksum covers the domain tag, version, name, and every statement in\n   282|    order. It is stable across runs (no timestamps, no randomness) so that an\n   283|    applied migration's stored checksum can be compared to the live registry's\n   284|    checksum to detect content drift (forward-fix enforcement).\n   285|    \"\"\"\n   286|    h = hashlib.sha256()\n   287|    h.update(f\"domain={_CHECKSUM_DOMAIN}\\n\".encode(\"utf-8\"))\n   288|    h.update(f\"version={version}\\n\".encode(\"utf-8\"))\n   289|    h.update(f\"name={name}\\n\".encode(\"utf-8\"))\n   290|    for i, stmt in enumerate(statements):\n   291|        h.update(f\"stmt[{i}]={stmt}\\n\".encode(\"utf-8\"))\n   292|    return \"sha256:\" + h.hexdigest()\n   293|\n   294|\n   295|# ── Frozen dataclasses ────────────────────────────────────────────────────\n   296|\n   297|\n   298|@dataclass(frozen=True)\n   299|class Migration:\n   300|", "total_lines": 1212, "file_size": 49490, "truncated": true, "hint": "Use offset=300 to continue reading (showing 180-299 of 1212 lines)", "is_binary": false, "is_image": false}
./critique-ledger-m9-planner-prompt.txt:1866:{"content": "   724|class LedgerEvent:\n   725|    \"\"\"A single event in an execution attempt's ordered ledger stream.\n   726|\n   727|    Every event carries an idempotency key, immutable identity, provenance,\n   728|    version anchoring, grant reference, monotonic position, and dual\n   729|    timestamps. An event without an idempotency key cannot be safely\n   730|    retried.\n   731|\n   732|    The payload may be:\n   733|    - ``None`` for events that carry no additional data.\n   734|    - A ``dict`` for inline small payloads (subject to size policy).\n   735|    - A ``DurableRef`` for large or sensitive payloads.\n   736|\n   737|    Clocks alone never establish ordering — the sequence and causal\n   738|    predecessor are authoritative.\n   739|    \"\"\"\n   740|\n   741|    idempotency_key: str\n   742|    event_type: AttemptEventType\n   743|    identity: AttemptIdentity\n   744|    provenance: AttemptProvenance\n   745|    adapter: RuntimeAdapter\n   746|    versions: VersionSet\n   747|    grant_ref: GrantRef\n   748|    sequence: int\n   749|    causal_predecessor_sequence: int\n   750|    append_position: int\n   751|    occurred_at: str\n   752|    observed_at: str\n   753|    persistence_status: PersistenceStatus = PersistenceStatus.DURABLE\n   754|    outcome: AttemptOutcome | None = None\n   755|    payload: dict[str, Any] | DurableRef | None = None\n   756|    payload_policy_ref: str | None = None\n   757|    event_schema_version: str = LEDGER_SCHEMA_VERSION\n   758|\n   759|    def __post_init__(self) -> None:\n   760|        # Idempotency key must be non-empty.\n   761|        if not self.idempotency_key.strip():\n   762|            raise ValueError(\"LedgerEvent.idempotency_key must be non-empty\")\n   763|\n   764|        # Validate enums.\n   765|        object.__setattr__(\n   766|            self, \"event_type\", AttemptEventType(self.event_type)\n   767|        )\n   768|        object.__setattr__(\n   769|            self, \"adapter\", RuntimeAdapter(\n   770|                AdapterKind(self.adapter.adapter_kind),\n   771|                self.adapter.adapter_version,\n   772|            )\n   773|            if not isinstance(self.adapter, RuntimeAdapter)\n   774|            else self.adapter\n   775|        )\n   776|        object.__setattr__(\n   777|            self, \"persistence_status\",\n   778|            PersistenceStatus(self.persistence_status),\n   779|        )\n   780|        if self.outcome is not None:\n   781|            object.__setattr__(self, \"outcome\", AttemptOutcome(self.outcome))\n   782|\n   783|        # Validate sequence ordering.\n   784|        if self.sequence < 1:\n   785|            raise ValueError(\n   786|                f\"LedgerEvent.sequence must be >= 1, got {self.sequence}\"\n   787|            )\n   788|        if self.causal_predecessor_sequence < 0:\n   789|            raise ValueError(\n   790|                f\"LedgerEvent.causal_predecessor_sequence must be >= 0, \"\n   791|                f\"got {self.causal_predecessor_sequence}\"\n   792|            )\n   793|        if self.causal_predecessor_sequence >= self.sequence:\n   794|            raise ValueError(\n   795|                f\"LedgerEvent.causal_predecessor_sequence \"\n   796|                f\"({self.causal_predecessor_sequence}) must be < sequence \"\n   797|                f\"({self.sequence})\"\n   798|            )\n   799|        if self.append_position < 0:\n   800|            raise ValueError(\n   801|                f\"LedgerEvent.append_position must be >= 0, \"\n   802|                f\"got {self.append_position}\"\n   803|            )\n   804|\n   805|        # Validate timestamps are non-empty.\n   806|        if not self.occurred_at.strip():\n   807|            raise ValueError(\"LedgerEvent.occurred_at must be non-empty\")\n   808|        if not self.observed_at.strip():\n   809|            raise ValueError(\"LedgerEvent.observed_at must be non-empty\")\n   810|\n   811|        # Outcome constraint: terminal event types should have an outcome.\n   812|        if (\n   813|            self.event_type in _TERMINAL_EVENT_TYPES\n   814|            and self.persistence_status == PersistenceStatus.DURABLE\n   815|            and self.outcome is None\n   816|        ):\n   817|            raise ValueError(\n   818|                f\"LedgerEvent with terminal event_type \"\n   819|                f\"{self.event_type.value} must have an outcome when \"\n   820|                f\"persistence_status is durable\"\n   821|            )\n   822|\n   823|        # Persistence-failed events must have persistence_failed or\n   824|        # indeterminate status.\n   825|        if self.event_type == AttemptEventType.PERSISTENCE_FAILED:\n   826|            if self.persistence_status not in (\n   827|                PersistenceStatus.PERSISTENCE_FAILED,\n   828|                PersistenceStatus.INDETERMINATE,\n   829|            ):\n   830|                raise ValueError(\n   831|                    f\"LedgerEvent with event_type persistence_failed must \"\n   832|                    f\"have persistence_status of persistence_failed or \"\n   833|                    f\"indeterminate, got {self.persistence_status.value}\"\n   834|", "total_lines": 1460, "file_size": 54228, "truncated": true, "hint": "Use offset=834 to continue reading (showing 724-833 of 1460 lines)", "is_binary": false, "is_image": false}
./critique-ledger-m9-planner-prompt.txt:1956:{"content": "     1|\"\"\"Durable object reference schema for workflow boundary contracts.\n     2|\n     3|This module freezes a public schema contract under ``arnold.workflow``.\n     4|Every ``DurableRef`` requires retrievable durable object metadata and\n     5|rejects digest-only result preservation and secret payloads.\n     6|\n     7|This is schema-only — no I/O, mutation, or runtime effects.\n     8|\"\"\"\n     9|\n    10|from __future__ import annotations\n    11|\n    12|import re\n    13|from dataclasses import dataclass, field\n    14|from enum import StrEnum\n    15|from types import MappingProxyType\n    16|from typing import Any, Mapping\n    17|\n    18|\n    19|# ── Enums ─────────────────────────────────────────────────────────────────\n    20|\n    21|\n    22|class PrivacyClass(StrEnum):\n    23|    \"\"\"Privacy classification for durable object references.\"\"\"\n    24|\n    25|    PUBLIC = \"public\"\n    26|    INTERNAL = \"internal\"\n    27|    CONFIDENTIAL = \"confidential\"\n    28|    RESTRICTED = \"restricted\"\n    29|\n    30|\n    31|class AvailabilityClass(StrEnum):\n    32|    \"\"\"Availability tier for durable object references.\"\"\"\n    33|\n    34|    IMMEDIATE = \"immediate\"\n    35|    STANDARD = \"standard\"\n    36|    ARCHIVE = \"archive\"\n    37|    COLD = \"cold\"\n    38|\n    39|\n    40|class EncryptionScope(StrEnum):\n    41|    \"\"\"Encryption scope for durable object references.\"\"\"\n    42|\n    43|    NONE = \"none\"\n    44|    TENANT_KEY = \"tenant_key\"\n    45|    WORKFLOW_KEY = \"workflow_key\"\n    46|    FIELD_LEVEL = \"field_level\"\n    47|\n    48|\n    49|class RetentionClass(StrEnum):\n    50|    \"\"\"Retention class for durable object references.\"\"\"\n    51|\n    52|    EPHEMERAL = \"ephemeral\"\n    53|    RUN = \"run\"\n    54|    AUDIT = \"audit\"\n    55|    LEGAL_HOLD = \"legal_hold\"\n    56|\n    57|\n    58|class AccessScope(StrEnum):\n    59|    \"\"\"Access scope for durable object references.\"\"\"\n    60|\n    61|    TENANT = \"tenant\"\n    62|    WORKFLOW = \"workflow\"\n    63|    INVOCATION = \"invocation\"\n    64|    RESTRICTED = \"restricted\"\n    65|\n    66|\n    67|# ── Digest validation ─────────────────────────────────────────────────────\n    68|\n    69|_DIGEST_RE = re.compile(r\"^sha256:[0-9a-f]{64}$\")\n    70|\n    71|# Forbidden secret-like field keys that must never appear in a DurableRef.\n    72|_FORBIDDEN_SECRET_KEYS: frozenset[str] = frozenset(\n    73|    {\n    74|        \"api_key\",\n    75|        \"password\",\n    76|        \"secret\",\n    77|        \"token\",\n    78|        \"private_key\",\n    79|        \"credential\",\n    80|        \"bearer\",\n    81|        \"authorization\",\n    82|    }\n    83|)\n    84|\n    85|\n    86|def _require_digest(value: str) -> str:\n    87|    \"\"\"Validate a canonical digest string.\"\"\"\n    88|    if not isinstance(value, str) or not _DIGEST_RE.fullmatch(value):\n    89|        raise ValueError(\n    90|            f\"digest must be 'sha256:' followed by 64 lowercase hex chars, \"\n    91|", "total_lines": 379, "file_size": 12797, "truncated": true, "hint": "Use offset=91 to continue reading (showing 1-90 of 379 lines)", "is_binary": false, "is_image": false}
./critique-ledger-m9-planner-prompt.txt:1998:{"content": "     1|{\n     2|  \"schema\": \"cl.handoff.v1\",\n     3|  \"handoff_id\": \"cl1-contract-oracle\",\n     4|  \"generated_at\": \"2026-07-24T01:10:00Z\",\n     5|  \"generated_by\": \"hermes-executor: T12\",\n     6|  \"target_milestone\": \"CL2\",\n     7|  \"description\": \"CL1 contract, ownership, and M6 oracle freeze handoff. Provides schema/version hashes, owner/cutover mappings, WBC merge references, custody receipt versions, manifest/oracle/gate hashes, retention/atomicity decisions, domain budgets, authority decisions, limitations, touchpoints, open gates, and a machine-checkable accepted_for_cl2 derivation.\",\n     8|\n     9|  \"schema_and_version_hashes\": {\n    10|    \"occurrence_envelope_schema\": {\n    11|      \"schema_version\": \"cl.schema.v1\",\n    12|      \"class_name\": \"CritiqueOccurrenceEnvelope\",\n    13|      \"source_file\": \"arnold/critique_ledger/schemas.py\",\n    14|      \"sha256\": \"0fd36a75e0e723e6f889ecf7126812c3c59ca9c6a638d2ca20ce685dc6c4c7bb\"\n    15|    },\n    16|    \"reconciliation_event_schema\": {\n    17|      \"schema_version\": \"cl.schema.v1\",\n    18|      \"class_name\": \"FindingReconciliationEvent\",\n    19|      \"source_file\": \"arnold/critique_ledger/schemas.py\",\n    20|      \"sha256\": \"0fd36a75e0e723e6f889ecf7126812c3c59ca9c6a638d2ca20ce685dc6c4c7bb\"\n    21|    },\n    22|    \"disposition_event_schema\": {\n    23|      \"schema_version\": \"cl.schema.v1\",\n    24|      \"class_name\": \"FindingDispositionEvent\",\n    25|      \"source_file\": \"arnold/critique_ledger/schemas.py\",\n    26|      \"sha256\": \"0fd36a75e0e723e6f889ecf7126812c3c59ca9c6a638d2ca20ce685dc6c4c7bb\"\n    27|    },\n    28|    \"domain_briefing_schema\": {\n    29|      \"schema_version\": \"cl.schema.v1\",\n    30|      \"class_name\": \"DomainBriefingEnvelope\",\n    31|      \"source_file\": \"arnold/critique_ledger/schemas.py\",\n    32|      \"sha256\": \"0fd36a75e0e723e6f889ecf7126812c3c59ca9c6a638d2ca20ce685dc6c4c7bb\"\n    33|    },\n    34|    \"ledger_manifest_schema\": {\n    35|      \"schema_version\": \"cl.schema.v1\",\n    36|      \"class_name\": \"LedgerRevisionManifest\",\n    37|      \"source_file\": \"arnold/critique_ledger/schemas.py\",\n    38|      \"sha256\": \"0fd36a75e0e723e6f889ecf7126812c3c59ca9c6a638d2ca20ce685dc6c4c7bb\"\n    39|    },\n    40|    \"semantic_loop\": {\n    41|      \"source_file\": \"arnold/critique_ledger/semantic_loop.py\",\n    42|      \"sha256\": \"4b3bd7337fccbe6501add9b7eebced2c11d8d4367f762b224647952342abd3fd\"\n    43|    },\n    44|    \"module_init\": {\n    45|      \"source_file\": \"arnold/critique_ledger/__init__.py\",\n    46|      \"sha256\": \"99f40335e32b9ed106760c6da0daf8ece362f196d235199b8a72aca3cc7b4877\"\n    47|    },\n    48|    \"owner_matrix_schema\": {\n    49|      \"schema_version\": \"wbc.matrix.v2\",\n    50|      \"source_file\": \"arnold_pipelines/megaplan/workflows/source_to_owner_matrix.json\",\n    51|      \"sha256\": \"76669b2ee62d785993828e6f297aa6a21f58d820446cfd88d6c90289a30d1a9a\"\n    52|    },\n    53|    \"producer_matrix_schema\": {\n    54|      \"schema_version\": \"wbc.contract_to_producer.v2\",\n    55|      \"source_file\": \"arnold_pipelines/megaplan/workflows/contract_to_producer_matrix.json\",\n    56|      \"sha256\": \"699d710fb279f00a5dd557811f9ac1fc729a6d6bd5227f3a8801361bba2c94ab\"\n    57|    }\n    58|  },\n    59|\n    60|  \"owner_and_cutover_mappings\": {\n    61|    \"owner_domains\": {\n    62|      \"run_authority\": {\n    63|        \"description\": \"Run Authority owns authority facts, views, routing decisions, and execution verdicts.\",\n    64|        \"mutating_scope\": \"authority_facts_views\",\n    65|        \"source\": \"arnold_pipelines/megaplan/workflows/source_to_owner_matrix.json\"\n    66|      },\n    67|      \"maintenance\": {\n    68|        \"description\": \"Maintenance owns lifecycle/status/repair mutation: repair queues, incident ledger, watchdog, cloud status.\",\n    69|        \"mutating_scope\": \"lifecycle_status_repair\",\n    70|        \"source\": \"arnold_pipelines/megaplan/workflows/source_to_owner_matrix.json\"\n    71|", "total_lines": 441, "file_size": 21583, "truncated": true, "hint": "Use offset=71 to continue reading (showing 1-70 of 441 lines)", "is_binary": false, "is_image": false}
./critique-ledger-m9-planner-prompt.txt:2040:{"content": "   370|  \"open_gates\": {\n   371|    \"reviewer_sign_off\": {\n   372|      \"status\": \"pending\",\n   373|      \"reviewed\": false,\n   374|      \"reviewer\": \"\",\n   375|      \"reviewed_at\": \"\",\n   376|      \"note\": \"Reviewer sign-off is pending. The semantic loop gate verdict is accepted but unreviewed.\",\n   377|      \"source\": \"docs/critique-ledger/evidence/cl1-semantic-loop-gate.json\"\n   378|    },\n   379|    \"m6_prerequisite_verification\": {\n   380|      \"status\": \"INCOHERENT\",\n   381|      \"detail\": \"M5 final attestation has 3 missing bound artifacts (sprint completion_verdict.json files). The M5 bound-head/current-HEAD relationship is EXPLAINED_BENIGN and accepted, but the INCOHERENT attestation means prerequisites are not fully satisfied.\",\n   382|      \"source\": \"evidence/m6-prerequisite-verification.json\"\n   383|    },\n   384|    \"proof_index_validation\": {\n   385|      \"status\": \"FAILED\",\n   386|      \"validation_passed\": false,\n   387|      \"errors\": [\n   388|        \"Prerequisite verification status is INCOHERENT — M6 evidence bundle cannot be considered complete\",\n   389|        \"M6 prerequisites are INCOHERENT or BLOCKED — handoff must not be marked complete\"\n   390|      ],\n   391|      \"source\": \"evidence/m6-proof-index.json\"\n   392|    },\n   393|    \"ownership_blockers\": {\n   394|      \"count\": 4,\n   395|      \"detail\": \"Ownership decision record shows 4 blockers. Run Authority M1-M3 completion receipts all have accepted: false.\",\n   396|      \"source\": \"evidence/m6-proof-index.json\"\n   397|    },\n   398|    \"portfolio_gate\": {\n   399|      \"status\": \"BLOCKED\",\n   400|      \"blocker\": \"PC-SCOPE-BLOCKER-001\",\n   401|      \"detail\": \"Portfolio gate PC scope decision is machine-generated with blocker PC-SCOPE-BLOCKER-001. Human approval is required but not recorded.\",\n   402|      \"source\
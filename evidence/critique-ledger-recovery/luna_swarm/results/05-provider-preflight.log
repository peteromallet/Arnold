   178	    def _persist_inbound_event(self, event: InboundEvent) -> PersistedInboundEvent:
   179	        raw = dict(event.raw)
   180	        conversation = self.store.upsert_resident_conversation(
   181	            ResidentConversationInput(
   182	                transport="discord",
   183	                conversation_key=event.conversation_key,
   184	                active_epic_id=_optional_string(raw.get("active_epic_id")),
   185	                guild_id=event.subject.guild_id,
   186	                channel_id=event.subject.channel_id,
   187	                thread_id=_optional_string(raw.get("thread_id")),
   188	                dm_user_id=_optional_string(raw.get("dm_user_id")),
   189	                metadata={"last_subject_user_id": event.subject.user_id, **dict(raw.get("conversation_metadata") or {})},
   190	            ),
   191	            idempotency_key=deterministic_idempotency_key("resident-conversation", event.conversation_key),
   192	        )
   193	        message = self.store.create_message(
   194	            epic_id=conversation.active_epic_id,
   195	            conversation_id=conversation.id,
   196	            direction="inbound",
   197	            content=event.content,
   198	            discord_message_id=_optional_string(raw.get("discord_message_id")),
   199	            idempotency_key=event.idempotency_key,
   200	            has_code_attachment=bool(raw.get("has_code_attachment", False)),
   201	            has_image_attachment=bool(raw.get("has_image_attachment", False)),
   202	            was_voice_message=bool(raw.get("was_voice_message", False)),
   203	            audio_storage_url=_optional_string(raw.get("audio_storage_url")),
   204	            transcription_metadata=_optional_dict(raw.get("transcription_metadata")),
   205	        )
   206	        self.store.update_resident_conversation(
   207	            conversation.id,
   208	            last_inbound_message_id=message.id,
   209	            delivery_cursor=message.id,
   210	            last_active_at=utc_now(),
   211	            idempotency_key=deterministic_idempotency_key("resident-conversation-inbound", conversation.id, message.id),
   212	        )
   213	        conversation = self.store.load_resident_conversation(conversation.id) or conversation
   214	        return PersistedInboundEvent(event=event, conversation=conversation, message=message)

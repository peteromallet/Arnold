   516	def _openai_tool_schema(registration: Any) -> dict[str, Any]:
   517	    return {
   518	        "type": "function",
   519	        "function": {
   520	            "name": registration.name,
   521	            "description": registration.description,
   522	            "parameters": registration.input_model.model_json_schema(),
   523	        },
   524	    }

    26	# KeyPathSource that resolves the megaplan api_keys.json path.
    27	import os
    28	from pathlib import Path
    29	from arnold.agent.providers.pool import KeyPathSource as _KeyPathSource
    30	
    31	
    32	class _MegaplanKeyPathSource:
    33	    """Supplies the api_keys.json path for the megaplan-local key pool."""
    34	
    35	    def keys_path(self) -> Path:
    36	        override = os.environ.get("MEGAPLAN_API_KEYS_PATH")
    37	        if override:
    38	            return Path(override).expanduser()
    39	        repo_root = Path(__file__).resolve().parents[1]
    40	        candidates = (
    41	            repo_root / "auto_improve" / "api_keys.json",
    42	        )
    43	        for path in candidates:
    44	            if path.exists():
    45	                return path
    46	        return candidates[0]
    47	
    48	
    49	class KeyPool(_BaseKeyPool):
    50	    """Megaplan-aware key pool that charges the active Governor on acquire."""
    51	
    52	    current_envelope = staticmethod(lambda: _current_envelope())
    53	
    54	    def acquire(self, provider: str) -> str:
    55	        key = super().acquire(provider)
    56	        if key:
    57	            _charge_governor_for_current_envelope(self)
    58	        return key
    59	
    60	
    61	_pool = KeyPool(keys_path_source=_MegaplanKeyPathSource())
    62	
    63	
    64	def _current_envelope(*_args):  # type: ignore[no-untyped-def]
    65	    """Return the envelope visible to this task via ContextVar, or ``None``.
    66	
    67	    Wired onto _pool so governor/envelope integration works without subclassing.
    68	    """
    69	    from arnold.runtime.envelope import _envelope_ctx
    70	
    71	    return _envelope_ctx.get()
    72	
    73	
    74	def _load_hermes_env() -> dict[str, str]:
    75	    return _pool.load_hermes_env()
    76	def _get_api_credential(env_var: str, hermes_env: dict[str, str] | None = None) -> str:
    77	    return _pool.get_api_credential(env_var, hermes_env)
    78	def _charge_governor_for_current_envelope(pool: KeyPool | None = None) -> None:
    79	    """Charge the governor for the current task envelope if one is active.
    80	
    81	    Invoked outside the KeyPool lock so a BudgetExceeded raised here
    82	    does not strand the pool lock.  charge() is a no-op when no governor
    83	    is attached to this execution tree.
    84	    """
    85	    active_pool = pool or _pool
    86	    envelope = active_pool.current_envelope()
    87	    if envelope is not None:
    88	        from arnold_pipelines.megaplan.runtime.governor import current_governor
    89	
    90	        gov = current_governor()
    91	        if gov is not None:
    92	            gov.charge(envelope)
    93	
    94	
    95	def acquire_key(provider: str) -> str:
    96	    return _pool.acquire(provider)
    97	def report_429(provider: str, key: str, cooldown_secs: float = 60) -> None:
    98	    _pool.report_429(provider, key, cooldown_secs)
    99	def report_failure(provider: str, key: str) -> None:
   100	    _pool.report_failure(provider, key)
   101	def has_keys(provider: str) -> bool:
   102	    return _pool.has_keys(provider)
   103	def _raise_claude_via_openrouter_blocked(reason: str) -> None:
   104	    """Refuse to silently route Claude through OpenRouter.
   105	
   106	    The harness historically defaulted bare hermes calls (model=None, or a
   107	    non-prefixed ``anthropic/claude-*`` slash form) to OpenRouter's
   108	    ``anthropic/claude-opus-4.6`` endpoint. That route consumes OPENROUTER_API_KEY
   109	    quotas instead of the operator's Claude Code (shannon) subscription, and the
   110	    fallback was completely silent. The user pays for Claude Code; they do not
   111	    want Claude calls billed against OpenRouter without explicit opt-in.
   112	
   113	    We block the silent path here and tell the caller exactly how to recover.
   114	    Explicit ``openrouter:`` prefixed models still work — only the silent
   115	    *default* is removed.
   116	    """
   117	    # Import lazily to keep this module import-cycle-safe (megaplan.types is
   118	    # otherwise independent of megaplan.runtime, but the lazy import is
   119	    # the cheapest insurance).
   120	    from arnold_pipelines.megaplan.types import CliError
   121	
   122	    raise CliError(
   123	        code="claude_via_openrouter_blocked",
   124	        message=(
   125	            "Refusing to route Claude through OpenRouter. " + reason + " "
   126	            "The megaplan harness silently defaulted Claude calls to "
   127	            "anthropic/claude-opus-4.6 via OpenRouter, but the operator has a "
   128	            "Claude Code subscription that should be used instead. Pick an "
   129	            "explicit path:\n"
   130	            "  --agent shannon   (use Claude Code, recommended)\n"
   131	            "  --agent claude    (same as shannon)\n"
   132	            "  --phase-model <phase>=claude:claude-opus-4-7:medium\n"
   133	            "If you actually want OpenRouter for some reason, set the model "
   134	            "explicitly with a provider prefix, e.g. "
   135	            "--hermes openrouter:anthropic/claude-opus-4.6"
   136	        ),
   137	        valid_next=[
   138	            "rerun with --agent shannon",
   139	            "rerun with --phase-model <phase>=claude:claude-opus-4-7:medium",
   140	            "rerun with --hermes openrouter:anthropic/claude-opus-4.6 (explicit)",
   141	        ],
   142	    )
   143	
   144	
   145	def _is_claude_model_name(name: str) -> bool:
   146	    lowered = name.lower()
   147	    return (
   148	        lowered.startswith("anthropic/claude")
   149	        or lowered.startswith("claude-")
   150	        or lowered.startswith("claude/")
   151	    )
   152	
   153	
   154	def _is_codex_model_name(name: str) -> bool:
   155	    """Match codex gpt-5.x family (case-insensitive)."""
   156	    lowered = name.lower()
   157	    return lowered.startswith("gpt-5")
   158	
   159	
   160	def _is_deepseek_model_name(name: str) -> bool:
   161	    """Match bare deepseek model names (case-insensitive)."""
   162	    lowered = name.lower()
   163	    return lowered.startswith("deepseek-") or lowered.startswith("deepseek/")
   164	
   165	
   166	def _fireworks_deepseek_model_name(name: str) -> str | None:
   167	    """Return the bare DeepSeek model from a Fireworks model id, if present."""
   168	
   169	    lowered = name.lower()
   170	    marker = "/models/"
   171	    candidate = name
   172	    if marker in lowered:
   173	        candidate = name[lowered.rfind(marker) + len(marker):]
   174	    candidate = candidate.strip("/")
   175	    if _is_deepseek_model_name(candidate):
   176	        return candidate
   177	    return None
   178	

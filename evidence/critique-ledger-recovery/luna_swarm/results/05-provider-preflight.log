   180	def _raise_codex_via_openrouter_blocked(reason: str) -> None:
   181	    """Refuse to silently route codex/gpt-5.x through OpenRouter.
   182	
   183	    The harness would otherwise default bare ``gpt-5.5`` (etc.) to OpenRouter,
   184	    silently consuming OPENROUTER_API_KEY quotas.  The user intends these models
   185	    to run through the proper codex path, not OpenRouter.
   186	
   187	    Explicit ``openrouter:`` prefixed models still work — only the silent
   188	    *default* is removed.
   189	    """
   190	    from arnold_pipelines.megaplan.types import CliError
   191	
   192	    raise CliError(
   193	        code="codex_via_openrouter_blocked",
   194	        message=(
   195	            "Refusing to route codex/gpt-5.x through OpenRouter. " + reason + " "
   196	            "Codex models (gpt-5.5, gpt-5.4, etc.) will not be silently billed "
   197	            "to your OpenRouter key. Pick an explicit path:\n"
   198	            "  --agent codex                    (use the codex vendor path)\n"
   199	            "  --hermes openrouter:gpt-5.5      (explicit OpenRouter opt-in)\n"
   200	            "If you actually want OpenRouter, set the model explicitly with "
   201	            "an ``openrouter:`` prefix."
   202	        ),
   203	        valid_next=[
   204	            "rerun with --agent codex",
   205	            "rerun with --hermes openrouter:gpt-5.5 (explicit)",
   206	        ],
   207	    )
   208	
   209	
   210	def _raise_generic_openrouter_blocked(reason: str) -> None:
   211	    """Refuse to silently route an unrecognised model through OpenRouter.
   212	
   213	    Any model not matching a known provider prefix or bare model guard
   214	    MUST NOT silently fall through to OpenRouter.  The caller must use
   215	    an explicit ``openrouter:`` prefix if they genuinely want OpenRouter.
   216	    """
   217	    from arnold_pipelines.megaplan.types import CliError
   218	
   219	    raise CliError(
   220	        code="openrouter_blocked",
   221	        message=(
   222	            "Refusing to silently route an unrecognised model through OpenRouter. "
   223	            + reason
   224	            + " "
   225	            "To use OpenRouter, prefix the model with ``openrouter:``. "
   226	            "To use a native provider, use the appropriate prefix "
   227	            "(``deepseek:``, ``fireworks:``, ``google:``, ``kimi:``, "
   228	            "``zhipu:``, ``minimax:``, ``mimo:``, ``xai:``) or the ``hermes:`` agent."
   229	        ),
   230	        valid_next=[
   231	            "rerun with --hermes openrouter:<model>",
   232	            "rerun with --hermes deepseek:<model>",
   233	            "rerun with --hermes kimi:<model>",
   234	            "rerun with --hermes mimo:<model>",
   235	            "rerun with --hermes xai:grok-4.5",
   236	            "rerun with --agent claude / --agent codex / --agent shannon",
   237	        ],
   238	    )

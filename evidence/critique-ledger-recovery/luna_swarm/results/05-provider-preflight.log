   109	class ResidentAuthorizer:
   110	    """Allowlist-based authorization with admin checks for side effects."""
   111	
   112	    def __init__(self, config: ResidentConfig) -> None:
   113	        self.config = config
   114	        self.denials: list[AuthorizationDenialRecord] = []
   115	
   116	    def authorize_inbound(self, subject: AuthorizationSubject) -> AuthorizationDecision:
   117	        if self.config.allowed_user_ids and subject.user_id not in self.config.allowed_user_ids:
   118	            return self._deny(subject, "inbound", "user_not_allowed")
   119	        if (
   120	            self.config.allowed_guild_ids
   121	            and subject.guild_id is not None
   122	            and subject.guild_id not in self.config.allowed_guild_ids
   123	        ):
   124	            return self._deny(subject, "inbound", "guild_not_allowed")
   125	        if self.config.allowed_channel_ids and subject.channel_id not in self.config.allowed_channel_ids:
   126	            return self._deny(subject, "inbound", "channel_not_allowed")
   127	        return AuthorizationDecision(True)
   128	
   129	    def authorize_action(self, subject: AuthorizationSubject, action: ActionKind) -> AuthorizationDecision:
   130	        inbound = self.authorize_inbound(subject)
   131	        if not inbound.allowed:
   132	            return inbound
   133	        if action in HIGH_IMPACT_ACTIONS and subject.user_id not in self.config.admin_user_ids:
   134	            return self._deny(subject, action, "admin_required")
   135	        return AuthorizationDecision(True)
   136	
   137	    def _deny(self, subject: AuthorizationSubject, action: str, reason: str) -> AuthorizationDecision:
   138	        denial = AuthorizationDenialRecord(
   139	            user_id=subject.user_id,
   140	            guild_id=subject.guild_id,
   141	            channel_id=subject.channel_id,
   142	            action=action,
   143	            reason=reason,
   144	            occurred_at=datetime.now(UTC),
   145	        )
   146	        self.denials.append(denial)
   147	        return AuthorizationDecision(False, reason, audit=denial.redacted())

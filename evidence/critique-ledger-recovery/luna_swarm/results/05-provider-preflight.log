   121	async def _resident_scheduler_once(store: Store, config: ResidentConfig, *, worker_id: str) -> dict[str, Any]:
   122	    worker = make_store_scheduler(
   123	        store=store,
   124	        config=config,
   125	        cloud_backend=CloudCliBackend(),
   126	        outbound=None,
   127	        confirmation_manager=StoreBackedConfirmationManager(config, store),
   128	        worker_id=worker_id,
   129	    )
   130	    result = await worker.run_due_once()
   131	    return {
   132	        "success": True,
   133	        "step": "resident",
   134	        "action": "scheduler-once",
   135	        "result": result.__dict__,
   136	    }

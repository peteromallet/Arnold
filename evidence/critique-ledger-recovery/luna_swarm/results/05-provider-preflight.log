   217	def test_confirmed_escalation_resolution_locks_clears_pointer_and_records_resume(tmp_path: Path) -> None:
   218	    repair_data_dir = tmp_path / "repair-data"
   219	    lock_dir = tmp_path / "demo.repair-loop.lock"
   220	    _write_escalation(
   221	        repair_data_dir,
   222	        {
   223	            "session": "demo",
   224	            "event": "opened",
   225	            "escalation_id": "esc-1",
   226	            "target_id": "target-1",
   227	            "current_plan": "plan-1",
   228	            "dm_user_id": "user-1",
   229	            "resume_handler": "cloud_resume",
   230	        },
   231	        {
   232	            "session": "demo",
   233	            "event": "delivered",
   234	            "escalation_id": "esc-1",
   235	            "channel_id": "channel-1",
   236	            "message_ids": ["msg-1"],
   237	            "dm_user_id": "user-1",
   238	        },
   239	    )
   240	    _write_marker(repair_data_dir, "demo", "target-1")
   241	    backend = RecordingCloudBackend()
   242	    outbound = RecordingOutbound()
   243	    runtime = _runtime(
   244	        tmp_path,
   245	        repair_data_dir=repair_data_dir,
   246	        repair_lock_dir=lock_dir,
   247	        cloud_backend=backend,
   248	        outbound=outbound,
   249	    )
   250	    subject = AuthorizationSubject(user_id="user-1", channel_id="channel-1")
   251	
   252	    asyncio.run(
   253	        runtime.receive(
   254	            InboundEvent(
   255	                idempotency_key="discord:message:answer-1",
   256	                conversation_key="discord:dm:user-1",
   257	                subject=subject,
   258	                content="resume it",
   259	                escalation_id="esc-1",
   260	                resume_handler="cloud_resume",
   261	                raw={"discord_message_id": "answer-1"},
   262	            )
   263	        )
   264	    )
   265	    phrase = outbound.sent[-1].content.removeprefix("Confirmation required: ")
   266	
   267	    asyncio.run(
   268	        runtime.receive(
   269	            InboundEvent(
   270	                idempotency_key="discord:message:answer-2",
   271	                conversation_key="discord:dm:user-1",
   272	                subject=subject,
   273	                content=phrase,
   274	                escalation_id="esc-1",
   275	                resume_handler="cloud_resume",
   276	                raw={"discord_message_id": "answer-2"},
   277	            )
   278	        )
   279	    )
   280	
   281	    assert len(backend.calls) == 1
   282	    assert backend.calls[0].operation == "cloud_resume"
   283	    assert backend.calls[0].arguments["plan"] == "plan-1"
   284	    assert backend.calls[0].confirmed is True
   285	    assert not (repair_data_dir / "demo.needs-human.json").exists()
   286	    assert not lock_dir.exists()
   287	    events = _read_escalations(repair_data_dir)
   288	    assert [record["event"] for record in events[-2:]] == ["answered", "resume_attempted"]
   289	    assert events[-2]["responder_user_id"] == "user-1"
   290	    assert events[-2]["message_id"] == "answer-2"
   291	    assert events[-1]["action"] == "cloud_resume"
   292	    assert events[-1]["resume_status"] == "running"
   293	
   294	
   295	def _write_escalation(tmp_path: Path, *records: dict[str, Any]) -> None:
   296	    ledger_dir = tmp_path / "escalations"
   297	    ledger_dir.mkdir(parents=True)
   298	    (ledger_dir / "escalations.jsonl").write_text(
   299	        "".join(json.dumps(record, sort_keys=True) + "\n" for record in records),
   300	        encoding="utf-8",
   301	    )
   302	
   303	
   304	def _write_marker(tmp_path: Path, session: str, target_id: str) -> None:
   305	    (tmp_path / f"{session}.needs-human.json").write_text(
   306	        json.dumps({"session": session, "target_id": target_id}),
   307	        encoding="utf-8",
   308	    )

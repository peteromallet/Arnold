   492	def _client_for_model(model_name: str) -> tuple[Any, str]:
   493	    """Build an OpenAI-compatible client for an arbitrary provider-prefixed model.
   494	
   495	    Uses the shared key pool resolver so a subagent can run on a different
   496	    provider than the resident without env-var coupling. Returns the client and
   497	    the normalized model id to send in requests.
   498	    """
   499	    from arnold_pipelines.megaplan.runtime.key_pool import resolve_model
   500	
   501	    try:
   502	        normalized_model, agent_kwargs = resolve_model(model_name)
   503	    except Exception as exc:  # pragma: no cover - surfaced to the tool caller
   504	        raise AgentLoopError(f"could not resolve subagent model {model_name!r}: {exc}") from exc
   505	    try:
   506	        from openai import AsyncOpenAI
   507	    except ImportError as exc:
   508	        raise AgentLoopError("The openai package is required for live resident model turns") from exc
   509	    client_kwargs: dict[str, Any] = {"api_key": agent_kwargs.get("api_key") or os.getenv("OPENAI_API_KEY")}
   510	    base_url = agent_kwargs.get("base_url")
   511	    if base_url:
   512	        client_kwargs["base_url"] = base_url
   513	    return AsyncOpenAI(**client_kwargs), normalized_model
   514	

   678	    Used when the user switches to a non-OAuth provider (OpenRouter, custom)
   679	    so auto-resolution doesn't keep picking the OAuth provider.
   680	    """
   681	    with _auth_store_lock():
   682	        auth_store = _load_auth_store()
   683	        auth_store["active_provider"] = None
   684	        _save_auth_store(auth_store)

   103	def _raise_claude_via_openrouter_blocked(reason: str) -> None:
   104	    """Refuse to silently route Claude through OpenRouter.
   105	
   106	    The harness historically defaulted bare hermes calls (model=None, or a
   107	    non-prefixed ``anthropic/claude-*`` slash form) to OpenRouter's
   108	    ``anthropic/claude-opus-4.6`` endpoint. That route consumes OPENROUTER_API_KEY
   109	    quotas instead of the operator's Claude Code (shannon) subscription, and the
   110	    fallback was completely silent. The user pays for Claude Code; they do not
   111	    want Claude calls billed against OpenRouter without explicit opt-in.
   112	
   113	    We block the silent path here and tell the caller exactly how to recover.
   114	    Explicit ``openrouter:`` prefixed models still work — only the silent
   115	    *default* is removed.
   116	    """
   117	    # Import lazily to keep this module import-cycle-safe (megaplan.types is
   118	    # otherwise independent of megaplan.runtime, but the lazy import is
   119	    # the cheapest insurance).
   120	    from arnold_pipelines.megaplan.types import CliError
   121	
   122	    raise CliError(
   123	        code="claude_via_openrouter_blocked",
   124	        message=(
   125	            "Refusing to route Claude through OpenRouter. " + reason + " "
   126	            "The megaplan harness silently defaulted Claude calls to "
   127	            "anthropic/claude-opus-4.6 via OpenRouter, but the operator has a "
   128	            "Claude Code subscription that should be used instead. Pick an "
   129	            "explicit path:\n"
   130	            "  --agent shannon   (use Claude Code, recommended)\n"
   131	            "  --agent claude    (same as shannon)\n"
   132	            "  --phase-model <phase>=claude:claude-opus-4-7:medium\n"
   133	            "If you actually want OpenRouter for some reason, set the model "
   134	            "explicitly with a provider prefix, e.g. "
   135	            "--hermes openrouter:anthropic/claude-opus-4.6"
   136	        ),
   137	        valid_next=[
   138	            "rerun with --agent shannon",
   139	            "rerun with --phase-model <phase>=claude:claude-opus-4-7:medium",
   140	            "rerun with --hermes openrouter:anthropic/claude-opus-4.6 (explicit)",
   141	        ],
   142	    )
   143	
   144	
   145	def _is_claude_model_name(name: str) -> bool:
   146	    lowered = name.lower()
   147	    return (
   148	        lowered.startswith("anthropic/claude")
   149	        or lowered.startswith("claude-")
   150	        or lowered.startswith("claude/")
   151	    )
   152	
   153	
   154	def _is_codex_model_name(name: str) -> bool:
   155	    """Match codex gpt-5.x family (case-insensitive)."""
   156	    lowered = name.lower()
   157	    return lowered.startswith("gpt-5")
   158	
   159	
   160	def _is_deepseek_model_name(name: str) -> bool:
   161	    """Match bare deepseek model names (case-insensitive)."""
   162	    lowered = name.lower()
   163	    return lowered.startswith("deepseek-") or lowered.startswith("deepseek/")
   164	
   165	
   166	def _fireworks_deepseek_model_name(name: str) -> str | None:
   167	    """Return the bare DeepSeek model from a Fireworks model id, if present."""
   168	
   169	    lowered = name.lower()
   170	    marker = "/models/"
   171	    candidate = name
   172	    if marker in lowered:
   173	        candidate = name[lowered.rfind(marker) + len(marker):]
   174	    candidate = candidate.strip("/")
   175	    if _is_deepseek_model_name(candidate):
   176	        return candidate
   177	    return None
   178	

    78	def _charge_governor_for_current_envelope(pool: KeyPool | None = None) -> None:
    79	    """Charge the governor for the current task envelope if one is active.
    80	
    81	    Invoked outside the KeyPool lock so a BudgetExceeded raised here
    82	    does not strand the pool lock.  charge() is a no-op when no governor
    83	    is attached to this execution tree.
    84	    """
    85	    active_pool = pool or _pool
    86	    envelope = active_pool.current_envelope()
    87	    if envelope is not None:
    88	        from arnold_pipelines.megaplan.runtime.governor import current_governor
    89	
    90	        gov = current_governor()
    91	        if gov is not None:
    92	            gov.charge(envelope)
    93	

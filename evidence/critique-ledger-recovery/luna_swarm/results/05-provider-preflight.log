   432	    def _build_history(self, conversation_id: str, *, exclude_ids: Sequence[str]) -> tuple[dict[str, Any], ...]:
   433	        """Reconstruct the last N prior messages as user/assistant turns for context.
   434	
   435	        ``exclude_ids`` drops the current burst, which is already persisted before
   436	        the turn runs, so it is not double-counted as history.

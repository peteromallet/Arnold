   283	            agent_kwargs["base_url"] = (
   284	                _get_api_credential(_PROVIDER_BASE_URL_VARS["deepseek"])
   285	                or _DEFAULT_BASE_URLS["deepseek"]
   286	            )
   287	            agent_kwargs["api_key"] = acquire_key("deepseek")
   288	            return resolved_model, agent_kwargs
   289	        agent_kwargs["base_url"] = _get_api_credential(_PROVIDER_BASE_URL_VARS["fireworks"]) or _DEFAULT_BASE_URLS["fireworks"]
   290	        agent_kwargs["api_key"] = acquire_key("fireworks")
   291	    elif resolved_model.startswith("mimo:"):
   292	        resolved_model = resolved_model[len("mimo:"):]
   293	        agent_kwargs["base_url"] = _get_api_credential(_PROVIDER_BASE_URL_VARS["mimo"]) or _DEFAULT_BASE_URLS["mimo"]
   294	        agent_kwargs["api_key"] = acquire_key("mimo")
   295	    elif resolved_model.startswith("xai:"):
   296	        resolved_model = resolved_model[len("xai:"):]
   297	        agent_kwargs["base_url"] = _get_api_credential(_PROVIDER_BASE_URL_VARS.get("xai", "")) or _DEFAULT_BASE_URLS.get("xai", "https://api.x.ai/v1")

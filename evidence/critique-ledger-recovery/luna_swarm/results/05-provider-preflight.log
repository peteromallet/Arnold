   263	
   264	def _gh_cli_candidates() -> list[str]:
   265	    """Return candidate ``gh`` binary paths, including common Homebrew installs."""
   266	    candidates: list[str] = []
   267	
   268	    resolved = shutil.which("gh")
   269	    if resolved:
   270	        candidates.append(resolved)
   271	
   272	    for candidate in (
   273	        "/opt/homebrew/bin/gh",
   274	        "/usr/local/bin/gh",
   275	        str(Path.home() / ".local" / "bin" / "gh"),
   276	    ):
   277	        if candidate in candidates:
   278	            continue
   279	        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
   280	            candidates.append(candidate)

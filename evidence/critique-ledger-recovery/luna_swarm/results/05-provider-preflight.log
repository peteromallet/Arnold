    31	@dataclass(frozen=True)
    32	class EscalationTarget:
    33	    escalation_id: str
    34	    session: str
    35	    target_id: str
    36	    current_plan: str
    37	    channel_id: str
    38	    responder_user_id: str
    39	    message_ids: tuple[str, ...]

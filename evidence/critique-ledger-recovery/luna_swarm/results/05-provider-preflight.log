    49	class KeyPool(_BaseKeyPool):
    50	    """Megaplan-aware key pool that charges the active Governor on acquire."""
    51	
    52	    current_envelope = staticmethod(lambda: _current_envelope())
    53	
    54	    def acquire(self, provider: str) -> str:
    55	        key = super().acquire(provider)
    56	        if key:
    57	            _charge_governor_for_current_envelope(self)
    58	        return key
    59	
    60	
    61	_pool = KeyPool(keys_path_source=_MegaplanKeyPathSource())

   166	    async def recover_abandoned_turns(self) -> int:
   167	        recovered = 0
   168	        for turn in self.store.find_abandoned_turns(int(self.config.stale_turn_timeout_s)):
   169	            self.store.update_turn(
   170	                turn.id,
   171	                status="abandoned",
   172	                warnings_issued=list(turn.warnings_issued or []) + ["recovered as abandoned on resident startup"],
   173	                idempotency_key=deterministic_idempotency_key("resident-turn-abandoned", turn.id),
   174	            )
   175	            recovered += 1
   176	        return recovered

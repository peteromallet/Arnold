    78	def classify_cloud_payload(payload: object) -> CloudClassification:
    79	    """Classify status/chain payloads without depending on provider-specific text."""
    80	    flat = " ".join(str(value).lower() for value in _walk_values(payload))
    81	    if not flat.strip():
    82	        return "unknown"
    83	    if any(token in flat for token in ("gate-needed", "gate_needed", "gate pending", "gate_pending", "state_gated")):
    84	        return "gate-needed"
    85	    if any(token in flat for token in ("failed", "failure", "error", "state_failed", "traceback")):
    86	        return "failed"
    87	    if any(token in flat for token in ("blocked", "execution_blocked", "state_blocked")):
    88	        return "blocked"
    89	    if any(token in flat for token in ("completed", "complete", "done", "success", "state_done", "plan_done")):
    90	        return "completed"
    91	    if any(token in flat for token in ("running", "starting", "queued", "in_progress", "state_executing", "state_planning")):
    92	        return "running"
    93	    if isinstance(payload, dict) and payload.get("next_step"):
    94	        return "running"
    95	    return "unknown"

    40	# ── Credential checking ───────────────────────────────────────────────
    41	
    42	
    43	def _parse_agent_spec(spec: str) -> tuple[str, str | None]:
    44	    """Parse an agent spec string into (agent, model)."""
    45	    from arnold_pipelines.megaplan.types import parse_agent_spec
    46	
    47	    return parse_agent_spec(spec)
    48	
    49	
    50	def _check_credential(env_var: str) -> bool:
    51	    """Check if an environment variable is set (non-empty)."""
    52	    return bool(os.environ.get(env_var, "").strip())
    53	
    54	
    55	def _resolve_concrete_slot_spec(spec: str, *, vendor: str | None = None) -> str:
    56	    """Resolve symbolic premium placeholders to concrete specs for preflight."""
    57	    from arnold_pipelines.megaplan.profiles import (
    58	        DIRECT_DEEPSEEK_V4_PRO_SPEC,
    59	        FIREWORKS_DEEPSEEK_V4_PRO_SPEC,
    60	        effective_premium_vendor,
    61	    )
    62	    from arnold_pipelines.megaplan.types import (
    63	        format_agent_spec,
    64	        is_premium_placeholder_spec,
    65	        parse_agent_spec,
    66	        resolve_premium_placeholder_spec,
    67	    )
    68	
    69	    if not is_premium_placeholder_spec(spec):
    70	        return spec
    71	    resolved_vendor = effective_premium_vendor(argparse.Namespace(vendor=vendor))
    72	    concrete_spec = format_agent_spec(resolve_premium_placeholder_spec(spec, resolved_vendor))
    73	    if vendor is not None:
    74	        return concrete_spec
    75	    parsed = parse_agent_spec(concrete_spec)
    76	    if parsed.agent not in {"claude", "codex"}:
    77	        return concrete_spec
    78	
    79	    current_env = "ANTHROPIC_API_KEY" if parsed.agent == "claude" else "OPENAI_API_KEY"
    80	    if _check_credential(current_env):
    81	        return concrete_spec
    82	
    83	    other_vendor = "codex" if parsed.agent == "claude" else "claude"
    84	    other_env = "OPENAI_API_KEY" if other_vendor == "codex" else "ANTHROPIC_API_KEY"
    85	    if _check_credential(other_env):
    86	        return format_agent_spec(resolve_premium_placeholder_spec(spec, other_vendor))
    87	
    88	    if _check_credential("DEEPSEEK_API_KEY"):
    89	        return DIRECT_DEEPSEEK_V4_PRO_SPEC
    90	    if _check_credential("FIREWORKS_API_KEY"):
    91	        return FIREWORKS_DEEPSEEK_V4_PRO_SPEC
    92	    return concrete_spec
    93	
    94	
    95	# Slots that are opt-in / non-blocking and so must NOT hard-fail preflight.
    96	# ``feedback`` only runs when explicitly requested, so its credential remains
    97	# soft. If feedback IS used without the key, it fails at runtime on a
    98	# throwaway template rather than blocking the whole run up front.
    99	_SOFT_SLOTS: frozenset[str] = frozenset({"feedback"})
   100	
   101	
   102	# Which single-vendor profile to recommend when a given premium credential is
   103	# present but the chosen profile demands one the user lacks.
   104	_VENDOR_FALLBACK_PROFILES: tuple[tuple[str, str, str], ...] = (
   105	    # (env var present → recommend this profile → one-line why)
   106	    ("ANTHROPIC_API_KEY", "all-claude", "Claude-only, every phase on Anthropic"),
   107	    ("OPENAI_API_KEY", "all-codex", "Codex-only, every phase on OpenAI"),
   108	)
   109	
   110	
   111	def _credential_guidance(profile_name: str) -> list[str]:
   112	    """Return guidance lines tailored to the credentials actually present.
   113	
   114	    Three distinct situations, kept honestly separate:
   115	
   116	    * **You already have a usable vendor key** (but not the one this profile
   117	      wants): point at the matching single-vendor profile you can run *right
   118	      now* — e.g. you have Anthropic, so `--profile all-claude` works.
   119	    * **You have no model credentials at all**: a getting-started list of every
   120	      supported key and what it unlocks — not a misleading "run with what you
   121	      have" header when you have nothing.
   122	    * **You lack a DeepSeek/Fireworks key**: a note that adding one unlocks the
   123	      cheaper cost-tiered profiles (only shown when it adds information).
   124	    """
   125	    have_deepseek = _check_credential("DEEPSEEK_API_KEY") or _check_credential(
   126	        "FIREWORKS_API_KEY"
   127	    )
   128	    have_any = (
   129	        have_deepseek
   130	        or _check_credential("ANTHROPIC_API_KEY")
   131	        or _check_credential("OPENAI_API_KEY")
   132	    )
   133	
   134	    # Single-vendor profiles you can run immediately with a key you already
   135	    # have (skip the profile you just tried — re-running it won't help).
   136	    runnable: list[str] = []
   137	    for env_var, rec_profile, why in _VENDOR_FALLBACK_PROFILES:
   138	        if rec_profile != profile_name and _check_credential(env_var):
   139	            runnable.append(
   140	                f"  • re-run with `--profile {rec_profile}` ({why}) — "
   141	                f"works with your {env_var}."
   142	            )
   143	
   144	    lines: list[str] = []
   145	    if runnable:
   146	        lines.append("You can run right now with credentials you already have:")
   147	        lines.extend(runnable)
   148	
   149	    if not have_any:
   150	        # Brand-new user: nothing usable is configured. Note: uses "profile X"
   151	        # (no `--` token) so it reads as a key-setup guide, not a "switch
   152	        # profiles to fix this" loop.
   153	        lines.append("No model credentials found. Set at least one of:")
   154	        lines.append("  • ANTHROPIC_API_KEY — Claude (profile all-claude)")
   155	        lines.append("  • OPENAI_API_KEY — Codex (profile all-codex)")
   156	        lines.append(
   157	            "  • DEEPSEEK_API_KEY (https://platform.deepseek.com) or "
   158	            "FIREWORKS_API_KEY — DeepSeek; the cheapest option and what the "
   159	            "cost-tiered profiles (solo, directed, partnered, …) are built on."
   160	        )
   161	    elif not have_deepseek:
   162	        if lines:  # separate the hint from the runnable list above
   163	            lines.append("")
   164	        lines.append(
   165	            "Recommend to the user that they add a DeepSeek key — it's the "
   166	            "cheapest model and unlocks the cost-tiered profiles (solo, "
   167	            "directed, partnered, …), which route mechanical work to DeepSeek "
   168	            "instead of paying premium rates for it. They can set "
   169	            "DEEPSEEK_API_KEY (https://platform.deepseek.com) or "
   170	            "FIREWORKS_API_KEY."
   171	        )
   172	    return lines
   173	
   174	
   175	def _required_env_vars_for_slot(agent_spec: str, slot_name: str) -> list[tuple[str, str]]:
   176	    """Return list of (env_var, display_name) required for a slot.
   177	
   178	    For hermes specs, extracts the provider from the model string
   179	    (e.g. ``hermes:fireworks:model`` → FIREWORKS_API_KEY).
   180	    """
   181	    agent, model = _parse_agent_spec(agent_spec)
   182	    required: list[tuple[str, str]] = []
   183	
   184	    if agent == "hermes" and model:
   185	        # Extract provider: hermes:provider:actual-model
   186	        parts = model.split(":", 1)
   187	        provider = parts[0] if parts else None
   188	        if provider and provider in _PROVIDER_ENV_HINTS:
   189	            for env_var in _PROVIDER_ENV_HINTS[provider]:
   190	                required.append((env_var, f"{agent}/{provider}"))
   191	        else:
   192	            # Unknown provider — assume it needs whatever the agent normally needs
   193	            pass
   194	    elif agent in _AGENT_ENV_HINTS:
   195	        for env_var in _AGENT_ENV_HINTS[agent]:
   196	            required.append((env_var, agent))
   197	
   198	    return required
   199	
   200	
   201	def preflight_check_profile(
   202	    profile: dict[str, str],
   203	    *,
   204	    pipeline_name: str = "",
   205	    profile_name: str = "",
   206	    vendor: str | None = None,
   207	) -> list[dict[str, Any]]:
   208	    """Check that all slots in a resolved profile have their credentials available.
   209	
   210	    Parameters
   211	    ----------
   212	    profile:
   213	        The resolved profile (slot → agent spec).
   214	    pipeline_name:
   215	        The pipeline name for error messages.
   216	    profile_name:
   217	        The profile name for error messages.
   218	
   219	    Returns
   220	    -------
   221	    list[dict]
   222	        List of missing credentials, each with: slot, agent, env_var, display_name.
   223	        Empty list means all credentials are available.
   224	    """
   225	    missing: list[dict[str, Any]] = []
   226	
   227	    for slot, spec in profile.items():
   228	        if not isinstance(spec, str) or not spec.strip():
   229	            continue
   230	        if slot in _SOFT_SLOTS:
   231	            # Opt-in / non-blocking slot — don't gate the whole run on it.
   232	            continue
   233	        concrete_spec = _resolve_concrete_slot_spec(spec, vendor=vendor)
   234	        required = _required_env_vars_for_slot(concrete_spec, slot)
   235	        for env_var, display_name in required:
   236	            if not _check_credential(env_var):
   237	                missing.append(
   238	                    {
   239	                        "slot": slot,
   240	                        "spec": concrete_spec,
   241	                        "agent": display_name,
   242	                        "env_var": env_var,
   243	                    }
   244	                )
   245	
   246	    return missing
   247	
   248	
   249	def render_credential_failure(
   250	    missing: list[dict[str, Any]],
   251	    *,
   252	    pipeline_name: str = "",
   253	    profile_name: str = "",
   254	    is_tty: bool | None = None,
   255	) -> str:
   256	    """Render a structured credential-failure message.
   257	
   258	    Parameters
   259	    ----------
   260	    missing:
   261	        List of missing credentials from :func:`preflight_check_profile`.
   262	    pipeline_name:
   263	        The pipeline name.
   264	    profile_name:
   265	        The profile name.
   266	    is_tty:
   267	        Whether stdout is a TTY. Auto-detected if None.
   268	
   269	    Returns
   270	    -------
   271	    str
   272	        The rendered message.
   273	    """
   274	    if is_tty is None:
   275	        is_tty = sys.stdout.isatty()
   276	
   277	    lines: list[str] = []
   278	
   279	    if pipeline_name and profile_name:
   280	        lines.append(
   281	            f"Pipeline '{pipeline_name}' (profile '{profile_name}') "
   282	            f"needs credentials for:"
   283	        )
   284	    else:
   285	        lines.append("Missing credentials for:")
   286	
   287	    # Group by env_var for cleaner display
   288	    by_env: dict[str, list[str]] = {}
   289	    for m in missing:
   290	        key = m["env_var"]
   291	        by_env.setdefault(key, []).append(f"{m['agent']} (slot: {m['slot']})")
   292	
   293	    for env_var, slots in by_env.items():
   294	        lines.append(f"  • {', '.join(slots)} — no {env_var} found")
   295	
   296	    # Vendor-aware guidance: point the user at a profile that works with the
   297	    # credentials they DO have (or list what to set), instead of leaving them
   298	    # to guess.
   299	    guidance = _credential_guidance(profile_name)
   300	    if guidance:
   301	        lines.append("")
   302	        lines.extend(guidance)
   303	
   304	    if is_tty:
   305	        lines.append("")
   306	        lines.append("Options:")
   307	        lines.append("  [1] Abort")
   308	        lines.append(
   309	            f"  [2] Pick a different profile "
   310	            f"(run `megaplan list profiles --pipeline {pipeline_name}`)"
   311	        )
   312	        lines.append("  [3] Provide a key now (paste, will not be persisted)")
   313	        lines.append("  [4] Sign in (opens auth flow)")
   314	    elif not guidance:
   315	        # Non-TTY with no tailored guidance — fall back to the generic hint.
   316	        lines.append("")
   317	        lines.append(
   318	            "Set the required environment variables and re-run, "
   319	            "or pick a different profile."
   320	        )
   321	
   322	    return "\n".join(lines)
   323	
   324	
   325	def preflight_or_raise(
   326	    profile: dict[str, str],
   327	    *,
   328	    pipeline_name: str = "",
   329	    profile_name: str = "",
   330	    vendor: str | None = None,
   331	) -> None:
   332	    """Run credential preflight and exit with code 7 if credentials are missing.
   333	
   334	    In TTY mode, renders the interactive prompt. In non-TTY mode, prints
   335	    to stderr and exits 7.
   336	
   337	    Raises SystemExit(7) on credential failure.
   338	    """
   339	    missing = preflight_check_profile(
   340	        profile,
     1	"""Dynamic API key pooling for Hermes-backed providers.
     2	
     3	KeyPool is re-exported from the canonical SSoT at arnold.agent.providers.pool.
     4	This module retains the megaplan-specific wrappers, blocking guards, and the
     5	_pool singleton that wires envelope/governor context.
     6	"""
     7	
     8	from __future__ import annotations

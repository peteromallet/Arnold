   188	class OpenAICompatibleAgentRunner(DispatchProtocol):
   189	    """OpenAI-compatible chat/tool-call runner for live resident operation."""
   190	
   191	    def __init__(
   192	        self,
   193	        config: ResidentConfig,
   194	        *,
   195	        max_tool_calls: int | None = None,
   196	        tool_timeout_s: float | None = None,
   197	        client_override: Any | None = None,
   198	        model_override: str | None = None,
   199	    ) -> None:
   200	        self.config = config
   201	        self.max_tool_calls = max_tool_calls or config.max_tool_calls_per_turn
   202	        self.tool_timeout_s = tool_timeout_s or config.model_timeout_s
   203	        self._client_override = client_override
   204	        self._model_override = model_override
   205	        if self.max_tool_calls <= 0:
   206	            raise ValueError("max_tool_calls must be positive")
   207	        if self.tool_timeout_s <= 0:
   208	            raise ValueError("tool_timeout_s must be positive")
   209	
   210	    async def run(self, request: AgentRequest, tools: ToolRegistry) -> AgentResponse:
   211	        client = self._client_override or _openai_client(self.config)
   212	        messages = self._messages(request)
   213	        openai_tools = [_openai_tool_schema(tool) for tool in tools.list()]
   214	        audit_records: list[ToolCallAuditRecord] = []
   215	
   216	        for step_index in range(1, self.max_tool_calls + 2):
   217	            model_name = self._model_override or _request_model_name(request, self.config.model_name)
   218	            # _pre_dispatch_budget_check sentinel: budget guard for dispatch
   219	            try:
   220	                render_step_message(StepInvocation(kind="model", metadata={
   221	                    **request.model_seam_metadata,
   222	                    "model": model_name,
   223	                    "normalized_model": model_name,
   224	                    "history": messages,
   225	                    "tier": ModelTier.NON_ENFORCED.value,
   226	                    "worker": "resident",
   227	                }))
   228	            except ModelBudgetError:
   229	                raise
   230	            response = await asyncio.wait_for(
   231	                client.chat.completions.create(
   232	                    model=model_name,
   233	                    messages=messages,
   234	                    tools=openai_tools or None,
   235	                    tool_choice="auto" if openai_tools else None,
   236	                    timeout=self.config.model_timeout_s,
   237	                ),
   238	                timeout=self.config.model_timeout_s,
   239	            )
   240	            message = response.choices[0].message
   241	            tool_calls = tuple(message.tool_calls or ())
   242	            if not tool_calls:
   243	                final_text = _message_content_text(message.content)
   244	                return AgentResponse(
   245	                    final_text=final_text,
   246	                    tool_calls=tuple(audit_records),
   247	                    metadata={"steps_executed": step_index, "tool_calls_executed": len(audit_records), "model": model_name},
   248	                )
   249	            if len(audit_records) + len(tool_calls) > self.max_tool_calls:
   250	                raise AgentLoopError(f"resident tool-call limit exceeded: {self.max_tool_calls}")
   251	            messages.append(_assistant_tool_call_message(message))
   252	            for tool_call in tool_calls:
   253	                arguments = _tool_call_arguments(tool_call)
   254	                audit = await _execute_registered_tool(
   255	                    tools=tools,
   256	                    tool_name=tool_call.function.name,
   257	                    arguments=arguments,
   258	                    audit_id=tool_call.id,
   259	                    timeout_s=self.tool_timeout_s,
   260	                    runtime_context=ToolRuntimeContext(
   261	                        conversation_id=request.conversation_id,
   262	                        subject=request.subject,
   263	                    ),
   264	                )
   265	                audit_records.append(audit)
   266	                messages.append(
   267	                    {
   268	                        "role": "tool",
   269	                        "tool_call_id": tool_call.id,
   270	                        "content": json.dumps(audit.result, sort_keys=True),
   271	                    }

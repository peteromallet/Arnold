   691	def resolve_provider(
   692	    requested: Optional[str] = None,
   693	    *,
   694	    explicit_api_key: Optional[str] = None,
   695	    explicit_base_url: Optional[str] = None,
   696	) -> str:
   697	    """
   698	    Determine which inference provider to use.
   699	
   700	    Priority (when requested="auto" or None):
   701	    1. active_provider in auth.json with valid credentials
   702	    2. Explicit CLI api_key/base_url -> "openrouter"
   703	    3. OPENAI_API_KEY or OPENROUTER_API_KEY env vars -> "openrouter"
   704	    4. Provider-specific API keys (GLM, Kimi, MiniMax) -> that provider
   705	    5. Fallback: "openrouter"
   706	    """
   707	    normalized = (requested or "auto").strip().lower()
   708	
   709	    # Normalize provider aliases
   710	    _PROVIDER_ALIASES = {
   711	        "glm": "zai", "z-ai": "zai", "z.ai": "zai", "zhipu": "zai",
   712	        "kimi": "kimi-coding", "moonshot": "kimi-coding",
   713	        "minimax-china": "minimax-cn", "minimax_cn": "minimax-cn",
   714	        "claude": "anthropic", "claude-code": "anthropic",
   715	        "github": "copilot", "github-copilot": "copilot",
   716	        "github-models": "copilot", "github-model": "copilot",
   717	        "github-copilot-acp": "copilot-acp", "copilot-acp-agent": "copilot-acp",
   718	        "aigateway": "ai-gateway", "vercel": "ai-gateway", "vercel-ai-gateway": "ai-gateway",
   719	        "opencode": "opencode-zen", "zen": "opencode-zen",
   720	        "go": "opencode-go", "opencode-go-sub": "opencode-go",
   721	        "kilo": "kilocode", "kilo-code": "kilocode", "kilo-gateway": "kilocode",
   722	        "fireworks-ai": "fireworks", "fireworks_ai": "fireworks",
   723	    }
   724	    normalized = _PROVIDER_ALIASES.get(normalized, normalized)
   725	
   726	    if normalized == "openrouter":
   727	        return "openrouter"
   728	    if normalized == "custom":
   729	        return "custom"
   730	    if normalized in PROVIDER_REGISTRY:
   731	        return normalized
   732	    if normalized != "auto":
   733	        raise AuthError(
   734	            f"Unknown provider '{normalized}'.",
   735	            code="invalid_provider",
   736	        )
   737	
   738	    # Explicit one-off CLI creds always mean openrouter/custom
   739	    if explicit_api_key or explicit_base_url:
   740	        return "openrouter"
   741	
   742	    # Check auth store for an active OAuth provider
   743	    try:
   744	        auth_store = _load_auth_store()
   745	        active = auth_store.get("active_provider")
   746	        if active and active in PROVIDER_REGISTRY:
   747	            status = get_auth_status(active)
   748	            if status.get("logged_in"):
   749	                return active
   750	    except Exception as e:
   751	        logger.debug("Could not detect active auth provider: %s", e)
   752	
   753	    if has_usable_secret(os.getenv("OPENAI_API_KEY")) or has_usable_secret(os.getenv("OPENROUTER_API_KEY")):
   754	        return "openrouter"

   557	def _resolve_copilot_catalog_api_key() -> str:
   558	    """Best-effort GitHub token for fetching the Copilot model catalog."""
   559	    try:
   560	        from arnold.agent.hermes_cli.auth import resolve_api_key_provider_credentials
   561	
   562	        creds = resolve_api_key_provider_credentials("copilot")
   563	        return str(creds.get("api_key") or "").strip()
   564	    except Exception:
   565	        return ""


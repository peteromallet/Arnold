   114	def load_escalation_target(repair_data_dir: str | Path, escalation_id: str) -> EscalationTarget | None:
   115	    records = _read_escalation_records(repair_data_dir, escalation_id)
   116	    if not records:
   117	        return None
   118	
   119	    session = ""
   120	    target_id = ""
   121	    current_plan = ""
   122	    channel_id = ""
   123	    responder_user_id = ""
   124	    message_ids: tuple[str, ...] = ()
   125	    resume_handler = ""
   126	    superseded = False
   127	    unavailable = False
   128	
   129	    for record in records:
   130	        event = _string(record.get("event"))
   131	        session = _string(record.get("session")) or session
   132	        if event == "opened":
   133	            target_id = _string(record.get("target_id")) or target_id
   134	            current_plan = _string(record.get("current_plan")) or current_plan
   135	            responder_user_id = _string(record.get("dm_user_id")) or responder_user_id
   136	            resume_handler = _string(record.get("resume_handler")) or resume_handler
   137	        elif event == "delivered":
   138	            channel_id = _string(record.get("channel_id")) or channel_id
   139	            responder_user_id = _string(record.get("dm_user_id")) or responder_user_id
   140	            resume_handler = _string(record.get("resume_handler")) or resume_handler
   141	            raw_ids = record.get("message_ids")
   142	            if isinstance(raw_ids, list):
   143	                message_ids = tuple(str(item).strip() for item in raw_ids if str(item).strip())
   144	        elif event == "superseded":
   145	            superseded = True
   146	        elif event == "unavailable":
   147	            unavailable = True
   148	
   149	    return EscalationTarget(
   150	        escalation_id=escalation_id,
   151	        session=session,
   152	        target_id=target_id,
   153	        current_plan=current_plan,
   154	        channel_id=channel_id,
   155	        responder_user_id=responder_user_id,
   156	        message_ids=message_ids,
   157	        resume_handler=resume_handler,
   158	        superseded=superseded,
   159	        unavailable=unavailable,
   160	    )
   161	
   162	
   163	def confirm_escalation_resolution(
   164	    *,
   165	    confirmation_manager: ConfirmationManager | None,
   166	    subject: AuthorizationSubject,
   167	    escalation_id: str,
   168	    target: EscalationTarget,
   169	    answer_text: str,
   170	    resume_handler: str,
   171	) -> EscalationConfirmationDecision:
   172	    """Require exact confirmation before an escalation answer mutates repair state."""
   173	
   174	    if confirmation_manager is None or not confirmation_manager.required_for("escalation_resolve"):
   175	        return EscalationConfirmationDecision(True)
   176	
   177	    pending = _pending_confirmation_for_escalation(
   178	        confirmation_manager,
   179	        subject=subject,
   180	        escalation_id=escalation_id,
   181	    )
   182	    if pending is not None:
   183	        decision = confirmation_manager.confirm(
   184	            request_id=pending.id,
   185	            subject=subject,
   186	            phrase=answer_text,
   187	        )
   188	        if decision.allowed:
   189	            return EscalationConfirmationDecision(True, request_id=pending.id)
   190	        return EscalationConfirmationDecision(
   191	            False,
   192	            confirmation_required=True,
   193	            reason=decision.reason,
   194	            request_id=pending.id,
   195	            exact_phrase=pending.exact_phrase,
   196	        )
   197	
   198	    request = confirmation_manager.request_confirmation(
   199	        subject=subject,
   200	        action="escalation_resolve",
   201	        target_summary=target.current_plan or target.target_id or escalation_id,
   202	        metadata={
   203	            "tool": "escalation_resolve",
   204	            "escalation_id": escalation_id,
   205	            "resume_handler": resume_handler,
   206	        },
   207	    )
   208	    return EscalationConfirmationDecision(
   209	        False,
   210	        confirmation_required=True,
   211	        reason="confirmation_required",
   212	        request_id=request.id,
   213	        exact_phrase=request.exact_phrase,
   214	    )
   215	
   216	
   217	def _pending_confirmation_for_escalation(
   218	    confirmation_manager: ConfirmationManager,
   219	    *,
   220	    subject: AuthorizationSubject,
   221	    escalation_id: str,
   222	) -> Any | None:
   223	    for request in confirmation_manager.pending():
   224	        if request.action != "escalation_resolve":
   225	            continue
   226	        if request.subject.user_id != subject.user_id:
   227	            continue
   228	        if _string(request.metadata.get("escalation_id")) == escalation_id:
   229	            return request
   230	    return None
   231	
   232	
   233	def _read_escalation_records(repair_data_dir: str | Path, escalation_id: str) -> list[dict[str, Any]]:
   234	    ledger_path = Path(repair_data_dir) / "escalations" / "escalations.jsonl"
   235	    if not ledger_path.exists():
   236	        return []
   237	    records: list[dict[str, Any]] = []
   238	    try:
   239	        lines = ledger_path.read_text(encoding="utf-8").splitlines()
   240	    except OSError:
   241	        return records
   242	    for raw_line in lines:
   243	        try:
   244	            record = json.loads(raw_line)
   245	        except json.JSONDecodeError:
   246	            continue
   247	        if isinstance(record, dict) and _string(record.get("escalation_id")) == escalation_id:
   248	            records.append(record)
   249	    return records
   250	
   251	
   252	def _current_marker_target_id(repair_data_dir: str | Path, session: str) -> str:
   253	    if not session:
   254	        return ""
   255	    try:
   256	        payload = json.loads((Path(repair_data_dir) / f"{session}.needs-human.json").read_text(encoding="utf-8"))
   257	    except Exception:
   258	        return ""
   259	    return _string(payload.get("target_id")) if isinstance(payload, dict) else ""

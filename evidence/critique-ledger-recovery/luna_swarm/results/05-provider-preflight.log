   292	class CodexCliAgentRunner(DispatchProtocol):
   293	    """Resident runner backed by the local ``codex exec`` CLI and OAuth auth."""
   294	
   295	    def __init__(
   296	        self,
   297	        config: ResidentConfig,
   298	        *,
   299	        cwd: str | Path,
   300	        sandbox: str | None = None,
   301	    ) -> None:
   302	        self.config = config
   303	        self.cwd = Path(cwd)
   304	        self.sandbox = sandbox or config.codex_sandbox
   305	
   306	    async def run(self, request: AgentRequest, tools: ToolRegistry) -> AgentResponse:
   307	        model_name = _request_model_name(request, self.config.model_name)
   308	        prompt = self._prompt(request, tools)
   309	        with tempfile.NamedTemporaryFile(prefix="resident-codex-", suffix=".txt") as output:
   310	            cmd = [
   311	                "codex",
   312	                "exec",
   313	                "--model",
   314	                model_name,
   315	                "-c",
   316	                f'model_reasoning_effort="{self.config.codex_reasoning_effort}"',
   317	                "-c",
   318	                'approval_policy="never"',
   319	                "--sandbox",
   320	                self.sandbox,
   321	                "--skip-git-repo-check",
   322	                "--output-last-message",
   323	                output.name,
   324	                "-C",
   325	                str(self.cwd),
   326	                "-",
   327	            ]
   328	            try:
   329	                proc = await asyncio.create_subprocess_exec(
   330	                    *cmd,
   331	                    stdin=asyncio.subprocess.PIPE,
   332	                    stdout=asyncio.subprocess.PIPE,
   333	                    stderr=asyncio.subprocess.PIPE,
   334	                )
   335	            except FileNotFoundError as exc:
   336	                raise AgentLoopError("codex CLI is required for resident model_provider=codex") from exc
   337	            try:
   338	                stdout, stderr = await asyncio.wait_for(
   339	                    proc.communicate(prompt.encode("utf-8")),
   340	                    timeout=self.config.model_timeout_s,
   341	                )
   342	            except asyncio.TimeoutError as exc:
   343	                proc.kill()
   344	                await proc.wait()
   345	                raise AgentLoopError(f"codex exec timed out after {self.config.model_timeout_s:g}s") from exc
   346	            stdout_text = stdout.decode("utf-8", errors="replace")
   347	            stderr_text = stderr.decode("utf-8", errors="replace")
   348	            output.seek(0)
   349	            final_text = output.read().decode("utf-8", errors="replace").strip()
   350	        if proc.returncode != 0:
   351	            detail = (stderr_text or stdout_text).strip()
   352	            raise AgentLoopError(f"codex exec failed with exit {proc.returncode}: {detail[-2000:]}")
   353	        if not final_text:
   354	            final_text = _last_nonempty_line(stdout_text)
   355	        return AgentResponse(
   356	            final_text=final_text,
   357	            tool_calls=(),
   358	            metadata={
   359	                "runner": "codex_cli",
   360	                "model": model_name,
   361	                "reasoning_effort": self.config.codex_reasoning_effort,
   362	                "sandbox": self.sandbox,
   363	            },
   364	        )

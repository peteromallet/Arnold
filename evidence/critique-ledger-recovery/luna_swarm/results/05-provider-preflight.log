   438	        if self.config.history_window <= 0:
   439	            return ()
   440	        rows = self.store.list_conversation_messages(
   441	            conversation_id,
   442	            limit=self.config.history_window,
   443	            exclude_ids=exclude_ids,
   444	        )
   445	        history: list[dict[str, Any]] = []
   446	        for message in rows:
   447	            content = message.content
   448	            if not (content and content.strip()):
   449	                continue
   450	            role = "user" if message.direction == "inbound" else "assistant"

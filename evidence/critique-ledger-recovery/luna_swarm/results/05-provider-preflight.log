    15	class EscalationAuditSink(Protocol):
    16	    def log_system_event(
    17	        self,
    18	        *,
    19	        level: str,
    20	        category: str,
    21	        event_type: str,
    22	        message: str,
    23	        details: dict[str, Any] | None = None,
    24	        turn_id: str | None = None,
    25	        epic_id: str | None = None,
    26	        idempotency_key: str | None = None,
    27	    ) -> Any:
    28	        ...

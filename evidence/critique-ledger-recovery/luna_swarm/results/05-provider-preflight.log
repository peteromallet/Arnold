    64	def _current_envelope(*_args):  # type: ignore[no-untyped-def]
    65	    """Return the envelope visible to this task via ContextVar, or ``None``.
    66	
    67	    Wired onto _pool so governor/envelope integration works without subclassing.
    68	    """
    69	    from arnold.runtime.envelope import _envelope_ctx
    70	
    71	    return _envelope_ctx.get()

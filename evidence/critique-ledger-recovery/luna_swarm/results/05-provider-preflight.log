   139	def _resident_discord(root: Path, store: Store, config: ResidentConfig, *, dry_run: bool) -> dict[str, Any]:
   140	    token = discord_token_from_env(config.discord_bot_token_env)
   141	    if dry_run:
   142	        return {
   143	            "success": True,
   144	            "step": "resident",
   145	            "action": "discord",
   146	            "dry_run": True,
   147	            "token_configured": bool(token),
   148	            "profile": config.profile,
   149	            "conversation_count": len(store.list_resident_conversations(transport="discord", limit=100)),
   150	        }

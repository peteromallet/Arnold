   275	    def _messages(self, request: AgentRequest) -> list[dict[str, Any]]:
   276	        messages: list[dict[str, Any]] = [{"role": "system", "content": request.system_prompt}]
   277	        if request.hot_context:
   278	            messages.append(
   279	                {
   280	                    "role": "system",
   281	                    "content": "Hot context JSON:\n" + json.dumps(request.hot_context, sort_keys=True, default=str),
   282	                }
   283	            )
   284	        for message in request.messages:
   285	            role = message.get("role")
   286	            content = message.get("content")
   287	            if role in {"user", "assistant", "system"} and isinstance(content, str):
   288	                messages.append({"role": role, "content": content})
   289	        return messages

   240	# =============================================================================
   241	# Kimi Code Endpoint Detection
   242	# =============================================================================
   243	
   244	# Kimi Code (platform.kimi.ai) issues keys prefixed "sk-kimi-" that only work
   245	# on api.kimi.com/coding/v1.  Legacy keys from platform.moonshot.ai work on
   246	# api.moonshot.ai/v1 (the default).  Auto-detect when user hasn't set
   247	# KIMI_BASE_URL explicitly.
   248	KIMI_CODE_BASE_URL = "https://api.kimi.com/coding/v1"
   249	
   250	
   251	def _resolve_kimi_base_url(api_key: str, default_url: str, env_override: str) -> str:
   252	    """Return the correct Kimi base URL based on the API key prefix.
   253	
   254	    If the user has explicitly set KIMI_BASE_URL, that always wins.
   255	    Otherwise, sk-kimi- prefixed keys route to api.kimi.com/coding/v1.
   256	    """
   257	    if env_override:
   258	        return env_override
   259	    if api_key.startswith("sk-kimi-"):
   260	        return KIMI_CODE_BASE_URL
   261	    return default_url

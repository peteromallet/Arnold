    25	    "claude": ("ANTHROPIC_API_KEY",),
    26	    "shannon": ("ANTHROPIC_API_KEY",),
    27	    "codex": ("OPENAI_API_KEY",),
    28	}
    29	
    30	_PROVIDER_ENV_HINTS: dict[str, tuple[str, ...]] = {
    31	    "deepseek": ("DEEPSEEK_API_KEY",),
    32	    "fireworks": ("FIREWORKS_API_KEY",),
    33	    "kimi": ("KIMI_API_KEY",),
    34	    "mimo": ("MIMO_API_KEY",),
    35	    "openai": ("OPENAI_API_KEY",),
    36	    "anthropic": ("ANTHROPIC_API_KEY",),
    37	    "xai": ("XAI_API_KEY",),
    38	}

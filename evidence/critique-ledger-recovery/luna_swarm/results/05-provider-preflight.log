   354	def parse_model_input(raw: str, current_provider: str) -> tuple[str, str]:
   355	    """Parse ``/model`` input into ``(provider, model)``.
   356	
   357	    Supports ``provider:model`` syntax to switch providers at runtime::
   358	
   359	        openrouter:anthropic/claude-sonnet-4.5  →  ("openrouter", "anthropic/claude-sonnet-4.5")
   360	        nous:hermes-3                           →  ("nous", "hermes-3")
   361	        anthropic/claude-sonnet-4.5             →  (current_provider, "anthropic/claude-sonnet-4.5")
   362	        gpt-5.4                                 →  (current_provider, "gpt-5.4")
   363	
   364	    The colon is only treated as a provider delimiter if the left side is a
   365	    recognized provider name or alias.  This avoids misinterpreting model names
   366	    that happen to contain colons (e.g. ``anthropic/claude-3.5-sonnet:beta``).
   367	
   368	    Returns ``(provider, model)`` where *provider* is either the explicit
   369	    provider from the input or *current_provider* if none was specified.
   370	    """
   371	    stripped = raw.strip()
   372	    colon = stripped.find(":")
   373	    if colon > 0:
   374	        provider_part = stripped[:colon].strip().lower()
   375	        model_part = stripped[colon + 1:].strip()
   376	        if provider_part and model_part and provider_part in _KNOWN_PROVIDER_NAMES:
   377	            return (normalize_provider(provider_part), model_part)
   378	    return (current_provider, stripped)
   379	
   380	
   420	
   421	    Returns ``(provider_id, model_name)`` — the model name may be remapped
   422	    (e.g. bare ``deepseek-chat`` → ``deepseek/deepseek-chat`` for OpenRouter).
   423	    Returns ``None`` when no confident match is found.
   424	
   425	    Priority:
   426	    0. Bare provider name → switch to that provider's default model
   427	    1. Direct provider with credentials (highest)
   428	    2. Direct provider without credentials → remap to OpenRouter slug
   429	    3. OpenRouter catalog match
   430	    """
   431	    name = (model_name or "").strip()
   432	    if not name:
   433	        return None
   434	
   435	    name_lower = name.lower()
   436	
   437	    # --- Step 0: bare provider name typed as model ---
   438	    # If someone types `/model nous` or `/model anthropic`, treat it as a
   439	    # provider switch and pick the first model from that provider's catalog.
   440	    # Skip "custom" and "openrouter" — custom has no model catalog, and
   441	    # openrouter requires an explicit model name to be useful.
   442	    resolved_provider = _PROVIDER_ALIASES.get(name_lower, name_lower)
   443	    if resolved_provider not in {"custom", "openrouter"}:
   444	        default_models = _PROVIDER_MODELS.get(resolved_provider, [])
   445	        if (
   446	            resolved_provider in _PROVIDER_LABELS
   447	            and default_models
   448	            and resolved_provider != normalize_provider(current_provider)
   449	        ):
   450	            return (resolved_provider, default_models[0])
   451	
   452	    # Aggregators list other providers' models — never auto-switch TO them
   453	    _AGGREGATORS = {"nous", "openrouter"}
   454	
   455	    # If the model belongs to the current provider's catalog, don't suggest switching
   456	    current_models = _PROVIDER_MODELS.get(current_provider, [])
   457	    if any(name_lower == m.lower() for m in current_models):
   458	        return None
   459	
   460	    # --- Step 1: check static provider catalogs for a direct match ---
   461	    direct_match: Optional[str] = None
   462	    for pid, models in _PROVIDER_MODELS.items():
   463	        if pid == current_provider or pid in _AGGREGATORS:
   464	            continue
   465	        if any(name_lower == m.lower() for m in models):
   466	            direct_match = pid
   467	            break
   468	
   469	    if direct_match:
   470	        # Check if we have credentials for this provider
   471	        has_creds = False
   472	        try:
   473	            from arnold.agent.hermes_cli.auth import PROVIDER_REGISTRY
   474	            pconfig = PROVIDER_REGISTRY.get(direct_match)
   475	            if pconfig:
   476	                import os
   477	                for env_var in pconfig.api_key_env_vars:
   478	                    if os.getenv(env_var, "").strip():
   479	                        has_creds = True
   480	                        break
   481	        except Exception:
   482	            pass
   483	
   484	        if has_creds:
   485	            return (direct_match, name)
   486	
   487	        # No direct creds — try to find this model on OpenRouter instead
   488	        or_slug = _find_openrouter_slug(name)
   489	        if or_slug:
   490	            return ("openrouter", or_slug)
   491	        # Still return the direct provider — credential resolution will
   492	        # give a clear error rather than silently using the wrong provider
   493	        return (direct_match, name)
   494	
   495	    # --- Step 2: check OpenRouter catalog ---
   496	    # First try exact match (handles provider/model format)
   497	    or_slug = _find_openrouter_slug(name)
   498	    if or_slug:
   499	        if current_provider != "openrouter":
   500	            return ("openrouter", or_slug)
   501	        # Already on openrouter, just return the resolved slug
   502	        if or_slug != name:
   503	            return ("openrouter", or_slug)
   504	        return None  # already on openrouter with matching name
   505	
   506	    return None
   507	
   508	
   509	def _find_openrouter_slug(model_name: str) -> Optional[str]:
   510	    """Find the full OpenRouter model slug for a bare or partial model name.
   511	
   512	    Handles:
   513	    - Exact match: ``anthropic/claude-opus-4.6`` → as-is
   514	    - Bare name: ``deepseek-chat`` → ``deepseek/deepseek-chat``
   515	    - Bare name: ``claude-opus-4.6`` → ``anthropic/claude-opus-4.6``
   516	    """
   517	    name_lower = model_name.strip().lower()
   518	    if not name_lower:
   519	        return None
   520	
   521	    # Exact match (already has provider/ prefix)
   522	    for mid, _ in OPENROUTER_MODELS:
   523	        if name_lower == mid.lower():
   524	            return mid
   525	
   526	    # Try matching just the model part (after the /)
   527	    for mid, _ in OPENROUTER_MODELS:
   528	        if "/" in mid:
   529	            _, model_part = mid.split("/", 1)
   530	            if name_lower == model_part.lower():
   531	                return mid
   532	
   533	    return None
   534	
   535	
   536	def normalize_provider(provider: Optional[str]) -> str:
   537	    """Normalize provider aliases to Hermes' canonical provider ids.
   538	
   539	    Note: ``"auto"`` passes through unchanged — use
   540	    ``hermes_cli.auth.resolve_provider()`` to resolve it to a concrete
   541	    provider based on credentials and environment.
   542	    """
   543	    normalized = (provider or "openrouter").strip().lower()
   544	    return _PROVIDER_ALIASES.get(normalized, normalized)
   545	
   546	
   547	def provider_label(provider: Optional[str]) -> str:
   548	    """Return a human-friendly label for a provider id or alias."""
   549	    original = (provider or "openrouter").strip()
   550	    normalized = original.lower()
   551	    if normalized == "auto":
   552	        return "Auto"
   553	    normalized = normalize_provider(normalized)
   554	    return _PROVIDER_LABELS.get(normalized, original or "OpenRouter")

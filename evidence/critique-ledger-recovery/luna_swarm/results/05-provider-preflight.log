    46	class CloudCliBackend:
    47	    """Default resident backend that dispatches through existing cloud CLI code."""
    48	
    49	    async def run(self, request: CloudToolRequest) -> CloudToolResult:
    50	        argv = _argv_for_request(request)
    51	        root = Path(request.arguments.get("project_root") or ".").expanduser().resolve()
    52	        parser = argparse.ArgumentParser()
    53	        build_cloud_parser(parser.add_subparsers(dest="command", required=True))
    54	        args = parser.parse_args(["cloud", *argv])
    55	        stdout = StringIO()
    56	        stderr = StringIO()
    57	        with contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr):
    58	            code = run_cloud_cli(root, args)
    59	        output = stdout.getvalue().strip()
    60	        error_output = stderr.getvalue().strip()
    61	        payload = _json_payload(output)
    62	        classification = classify_cloud_payload(payload or {"returncode": code, "stderr": error_output})
    63	        ok = code == 0
    64	        summary = _summary_for_payload(request.operation, classification, payload, ok=ok)
    65	        return CloudToolResult(
    66	            classification=classification if ok else "failed",
    67	            summary=summary,
    68	            details={
    69	                "returncode": code,
    70	                "stdout": output,
    71	                "stderr": error_output,
    72	                "payload": payload,
    73	                "argv": argv,
    74	            },
    75	        )

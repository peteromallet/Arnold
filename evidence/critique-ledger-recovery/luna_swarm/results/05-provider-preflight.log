   299	    elif resolved_model.startswith("minimax:"):
   300	        resolved_model = resolved_model[len("minimax:"):]
   301	        minimax_key = acquire_key("minimax")
   302	        if minimax_key:
   303	            agent_kwargs["base_url"] = _get_api_credential(_PROVIDER_BASE_URL_VARS["minimax"]) or _DEFAULT_BASE_URLS["minimax"]
   304	            agent_kwargs["api_key"] = minimax_key
   305	        else:
   306	            resolved_model = "minimax/" + resolved_model
   307	            agent_kwargs["base_url"] = _DEFAULT_BASE_URLS["openrouter"]
   308	            agent_kwargs["api_key"] = acquire_key("openrouter")
   309	    else:
   310	        # Non-prefixed models (e.g. "qwen/qwen3.5-27b") — historically
   311	        # routed through OpenRouter, but we now refuse all silent
   312	        # OpenRouter fallbacks.  Recognised bare model families are
   313	        # routed to their native provider APIs; everything else errors.
   314	        if _is_claude_model_name(resolved_model):
   315	            _raise_claude_via_openrouter_blocked(
   316	                f"Model {resolved_model!r} would silently route to OpenRouter."
   317	            )
   318	        if _is_codex_model_name(resolved_model):
   319	            _raise_codex_via_openrouter_blocked(
   320	                f"Model {resolved_model!r} would silently route to OpenRouter."
   321	            )
   322	        if _is_deepseek_model_name(resolved_model):
   323	            # Bare deepseek-v4-pro / deepseek/... → direct DeepSeek API.
   324	            agent_kwargs["base_url"] = (
   325	                _get_api_credential(_PROVIDER_BASE_URL_VARS["deepseek"])
   326	                or _DEFAULT_BASE_URLS["deepseek"]
   327	            )
   328	            agent_kwargs["api_key"] = acquire_key("deepseek")
   329	        else:
   330	            _raise_generic_openrouter_blocked(
   331	                f"Model {resolved_model!r} has no provider prefix and is not "
   332	                f"a recognised bare model (claude-*, gpt-5.*, deepseek-*)."
   333	            )

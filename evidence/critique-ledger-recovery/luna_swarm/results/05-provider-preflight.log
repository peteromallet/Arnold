    89	    def __init__(
    90	        self,
    91	        *,
    92	        config: ResidentConfig,
    93	        authorizer: ResidentAuthorizer,
    94	        store: Store,
    95	        profile: MegaplanResidentProfile,
    96	        runner: AgentRunner,
    97	        outbound: OutboundSink,
    98	    ) -> None:
    99	        self.config = config
   100	        self.authorizer = authorizer
   101	        self.store = store
   102	        self.emitter: EmitProtocol = store
   103	        self.profile = profile
   104	        self.runner = runner
   105	        self.outbound = outbound
   106	        self.coalescer: AsyncBurstCoalescer[str, PersistedInboundEvent] = AsyncBurstCoalescer(
   107	            self._handle_batch,
   108	            idle_delay_s=config.burst_idle_delay_s,
   109	            max_delay_s=config.burst_max_delay_s,
   110	        )
   111	
   112	    async def receive(self, event: InboundEvent) -> None:
   113	        decision = self.authorizer.authorize_inbound(event.subject)
   114	        if not decision.allowed:
   115	            if decision.audit is not None:
   116	                self.emitter.log_system_event(
   117	                    level="warn",
   118	                    category="system",
   119	                    event_type="resident_inbound_denied",
   120	                    message="Resident inbound event denied before execution",
   121	                    details={"reason": decision.reason, "audit": decision.audit},
   122	                    idempotency_key=deterministic_idempotency_key("resident-denial", event.idempotency_key),
   123	                )
   124	            return
   125	        if event.escalation_id:
   126	            repair_data_dir = _repair_data_dir_from_config(self.config)
   127	            if repair_data_dir is None:
   128	                self.emitter.log_system_event(
   129	                    level="warn",
   130	                    category="system",
   131	                    event_type="escalation_answer_unauthorized",
   132	                    message="Escalation answer denied before resident mutation",
   133	                    details={
   134	                        "reason": "repair_data_dir_unavailable",
   135	                        "escalation_id": event.escalation_id,
   136	                        "user_id": event.subject.user_id,
   137	                        "channel_id": event.subject.channel_id,
   138	                    },
   139	                    idempotency_key=deterministic_idempotency_key(
   140	                        "resident-escalation-denial",
   141	                        event.idempotency_key,
   142	                        "repair_data_dir_unavailable",
   143	                    ),
   144	                )
   145	                return
   146	            escalation_decision = authorize_escalation_answer(
   147	                authorizer=self.authorizer,
   148	                subject=event.subject,
   149	                action="escalation_reply",
   150	                escalation_id=event.escalation_id,
   151	                repair_data_dir=repair_data_dir,
   152	                audit_sink=self.emitter,
   153	                idempotency_key=event.idempotency_key,
   154	            )
   155	            if not escalation_decision.allowed:
   156	                return
   157	            if event.resume_handler or (escalation_decision.target and escalation_decision.target.resume_handler):
   158	                handled = await self._handle_escalation_resolution(event, escalation_decision, repair_data_dir)
   159	                if handled:
   160	                    return
   161	        persisted = self._persist_inbound_event(event)
   162	        if persisted.message.bot_turn_id is not None:
   163	            return
   164	        await self.coalescer.submit(persisted.conversation.id, persisted)

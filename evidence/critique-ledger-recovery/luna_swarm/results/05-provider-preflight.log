   160	def _env_int(env: dict[str, str], key: str, default: int) -> int:
   161	    value = env.get(key)
   162	    return default if value is None or value == "" else int(value)
   163	
   164	
   165	def _env_float(env: dict[str, str], key: str, default: float) -> float:
   166	    value = env.get(key)
   167	    return default if value is None or value == "" else float(value)
   168	
   169	
   170	def _env_bool(env: dict[str, str], key: str, default: bool) -> bool:
   171	    value = env.get(key)
   172	    if value is None or value == "":
   173	        return default
   174	    normalized = value.strip().lower()
   175	    if normalized in {"1", "true", "yes", "on"}:
   176	        return True
   177	    if normalized in {"0", "false", "no", "off"}:
   178	        return False
   179	    raise ValueError(f"{key} must be a boolean token")

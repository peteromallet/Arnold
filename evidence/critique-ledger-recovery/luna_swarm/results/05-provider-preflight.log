./critique-ledger-m9-planner-prompt.txt:2133:{"content": "     1|{\n     2|  \"schema\": \"cl.failure-atomicity-table.v1\",\n     3|  \"generated_at\": \"2026-07-24T00:00:00Z\",\n     4|  \"description\": \"Encodes every critique ledger failure mode with detection boundary, fail-closed action, allowed WBC PersistenceStatus values, forbidden writes, recovery evidence, and admission consequence.\",\n     5|  \"failure_modes\": [\n     6|    {\n     7|      \"failure_mode\": \"start_persistence_failed\",\n     8|      \"description\": \"Critique producer start event fails to persist to the attempt ledger.\",\n     9|      \"detection_boundary\": \"execution_attempt_ledger.write_start() returns PersistenceStatus.PERSISTENCE_FAILED\",\n    10|      \"allowed_persistence_status\": [\"persistence_failed\"],\n    11|      \"fail_closed_action\": \"Abort the critique attempt — no occurrence is created. Record failure in attempt ledger as FAILED.\",\n    12|      \"forbidden_writes\": [\"CritiqueOccurrenceEnvelope\", \"FindingReconciliationEvent\", \"FindingDispositionEvent\"],\n    13|      \"recovery_evidence\": \"Attempt ledger start-failure receipt with PersistenceStatus.PERSISTENCE_FAILED\",\n    14|      \"admission_consequence\": \"BLOCKED — no critique occurrence admissible. Attempt must be retried.\"\n    15|    },\n    16|    {\n    17|      \"failure_mode\": \"start_persistence_indeterminate\",\n    18|      \"description\": \"Critique producer start event persistence status is INDETERMINATE — cannot confirm whether the attempt was recorded.\",\n    19|      \"detection_boundary\": \"execution_attempt_ledger.write_start() returns PersistenceStatus.INDETERMINATE\",\n    20|      \"allowed_persistence_status\": [\"indeterminate\"],\n    21|      \"fail_closed_action\": \"Treat as failure: no occurrence is created. Record INDETERMINATE status with reopen condition for manual resolution.\",\n    22|      \"forbidden_writes\": [\"CritiqueOccurrenceEnvelope\", \"FindingReconciliationEvent\", \"FindingDispositionEvent\"],\n    23|      \"recovery_evidence\": \"Attempt ledger INDETERMINATE receipt + manual authority review\",\n    24|      \"admission_consequence\": \"BLOCKED — INDETERMINATE persistence fails the test rather than being treated as clean success.\"\n    25|    },\n    26|    {\n    27|      \"failure_mode\": \"producer_parse_failed\",\n    28|      \"description\": \"Critique producer output cannot be parsed as a valid finding.\",\n    29|      \"detection_boundary\": \"ParseStatus.FAILED in critique producer output parsing\",\n    30|      \"allowed_persistence_status\": [\"durable\"],\n    31|      \"fail_closed_action\": \"Record failed attempt with ParseStatus.FAILED, no findings emitted. Attempt completes with empty finding set.\",\n    32|      \"forbidden_writes\": [\"FindingReconciliationEvent\", \"FindingDispositionEvent\"],\n    33|      \"recovery_evidence\": \"Attempt ledger completion receipt with ParseStatus.FAILED\",\n    34|      \"admission_consequence\": \"FAILED attempt — no findings admitted. Does not block other attempts.\"\n    35|    },\n    36|    {\n    37|      \"failure_mode\": \"producer_dropped\",\n    38|      \"description\": \"Critique producer custody fails — attempt is dropped before output.\",\n    39|      \"detection_boundary\": \"Critique custody receipt indicates ParseStatus.DROPPED\",\n    40|      \"allowed_persistence_status\": [\"durable\", \"persistence_failed\"],\n    41|      \"fail_closed_action\": \"Record dropped attempt with ParseStatus.DROPPED. Attempt is a custody failure, not a finding failure.\",\n    42|      \"forbidden_writes\": [\"FindingReconciliationEvent\", \"FindingDispositionEvent\"],\n    43|      \"recovery_evidence\": \"Custody failure receipt with ParseStatus.DROPPED\",\n    44|      \"admission_consequence\": \"DROPPED — custody failure. Does not produce findings.\"\n    45|    },\n    46|    {\n    47|      \"failure_mode\": \"producer_malformed\",\n    48|      \"description\": \"Critique producer output is parseable but structurally malformed — preserved as unavailable/unknown evidence.\",\n    49|      \"detection_boundary\": \"ParseStatus.MALFORMED in critique producer output parsing\",\n    50|      \"allowed_persistence_status\": [\"durable\"],\n    51|      \"fail_closed_action\": \"Record malformed output with ParseStatus.MALFORMED. Preserve as unavailable evidence with explicit limitation.\",\n    52|      \"forbidden_writes\": [\"FindingReconciliationEvent\", \"FindingDispositionEvent\"],\n    53|      \"recovery_evidence\": \"Malformed output preserved with EvidenceAvailability.UNAVAILABLE and reopen condition\",\n    54|      \"admission_consequence\": \"MALFORMED — evidence preserved but findings not admitted pending manual review.\"\n    55|    },\n    56|    {\n    57|      \"failure_mode\": \"reconciliation_coverage_incomplete\",\n    58|      \"description\": \"Not all parseable occurrences have a matching FindingReconciliationEvent.\",\n    59|      \"detection_boundary\": \"Semantic loop reconciliation pass — occurrence_count != reconciliation_count\",\n    60|      \"allowed_persistence_status\": [\"durable\"],\n    61|", "total_lines": 145, "file_size": 10550, "truncated": true, "hint": "Use offset=61 to continue reading (showing 1-60 of 145 lines)", "is_binary": false, "is_image": false}

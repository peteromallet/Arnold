uestion\": \"Are the success criteria well-prioritized and verifiable?\",\n  5934|                  \"status\": \"complete\"\n  5935|                },\n  5936|                {\n  5937|                  \"findings\": [\n  5938|                    {\n  5939|                      \"detail\": \"`plan_v2.md` line 8 includes ownership-prerequisite evidence in the hard-gate stop rule, but Step 2 lines 20-29 validates M5/M5A/WBC/schema/North Star inputs only. Step 24 lines 170-175 validates the ownership decision after generators in Steps 3-23, while the current decision frontmatter is `status: proposed-human-gate` and `approval_record: pending`.\",\n  5940|                      \"flagged\": true\n  5941|                    }\n  5942|                  ],\n  5943|                  \"id\": \"prerequisite_ordering\",\n  5944|                  \"question\": \"Do tasks that depend on a precondition gracefully handle that precondition only partially holding?\",\n  5945|                  \"status\": \"complete\"\n  5946|                }\n  5947|              ],\n  5948|              \"disputed_flag_ids\": [],\n  5949|              \"flags\": [\n  5950|                {\n  5951|                  \"category\": \"correctness\",\n  5952|                  \"concern\": \"The revised plan uses a different historical-adapter artifact path than the repository's WBC boundary adoption matrix requires, so downstream completion checks can miss the intended adapter registry.\",\n  5953|                  \"evidence\": \"WBC boundary adoption matrix requires `evidence/wbc-historical-adapters.json`; revised plan Step 19 produces `evidence/historical-adapter-allowlist.json`.\",\n  5954|                  \"id\": \"CF-66665110243DE5BB2A8D\",\n  5955|                  \"producer_category\": \"correctness\",\n  5956|                  \"producer_flag_id\": \"CORRECTNESS-003\",\n  5957|                  \"producer_severity\": \"likely-significant\",\n  5958|                  \"severity_hint\": \"likely-significant\",\n  5959|                  \"source_check_id\": \"correctness\"\n  5960|                },\n  5961|                {\n  5962|                  \"category\": \"completeness\",\n  5963|                  \"concern\": \"Step 7 remains oversized: it combines producer/writer static scanning across Python/native call sites, handlers, workflows, execution paths, kernel journal/effect ledgers, shell wrappers, and provider adapters into one worker turn.\",\n  5964|                  \"evidence\": \".megaplan/plans/m6-exact-contract-and-20260716-1303/plan_v2.md:56\",\n  5965|                  \"id\": \"CF-E9A5E2810CBFA0CCD552\",\n  5966|                  \"producer_category\": \"scope\",\n  5967|                  \"producer_flag_id\": \"CF-M6-SCOPE-STATIC-PRODUCER-SCAN\",\n  5968|                  \"producer_severity\": \"likely-significant\",\n  5969|                  \"severity_hint\": \"likely-significant\",\n  5970|                  \"source_check_id\": \"scope\"\n  5971|                },\n  5972|                {\n  5973|                  \"category\": \"completeness\",\n  5974|                  \"concern\": \"Step 18 remains oversized: after seeding 29 existing authority routes, it still asks one worker to implement broad static scans for many read classes across configured roots plus class fixtures and blocking tests.\",\n  5975|                  \"evidence\": \".megaplan/plans/m6-exact-contract-and-20260716-1303/plan_v2.md:130\",\n  5976|                  \"id\": \"CF-C48A66FBFC6B1418DB97\",\n  5977|                  \"producer_category\": \"scope\",\n  5978|                  \"producer_flag_id\": \"CF-M6-SCOPE-AUTHORITY-STATIC-SCAN\",\n  5979|                  \"producer_severity\": \"likely-significant\",\n  5980|                  \"severity_hint\": \"likely-significant\",\n  5981|                  \"source_check_id\": \"scope\"\n  5982|                },\n  5983|                {\n  5984|                  \"category\": \"completeness\",\n  5985|                  \"concern\": \"Step 12 is still too broad for one worker turn because it asks for the full migration-matrix residual inventory, all row fields, ambiguity rejection, and tests across many surface families.\",\n  5986|                  \"evidence\": \".megaplan/plans/m6-exact-contract-and-20260716-1303/plan_v2.md:89\",\n  5987|                  \"id\": \"CF-3C36769AED36191E5AC3\",\n  5988|                  \"producer_category\": \"scope\",\n  5989|                  \"producer_flag_id\": \"CF-M6-SCOPE-RESIDUAL-INVENTORY\",\n  5990|                  \"producer_severity\": \"likely-significant\",\n  5991|                  \"severity_hint\": \"likely-significant\",\n  5992|                  \"source_check_id\": \"scope\"\n  5993|                },\n  5994|                {\n  5995|                  \"category\": \"completeness\",\n  5996|", "total_lines": 12447, "file_size": 892899, "truncated": true, "hint": "Use offset=5996 to continue reading (showing 5866-5995 of 12447 lines)", "is_binary": false, "is_image": false}
./critique-ledger-m9-planner-prompt.txt:896:{"content": "     1|{\n     2|  \"schema\": \"cl.failure-atomicity-table.v1\",\n     3|  \"generated_at\": \"2026-07-24T00:00:00Z\",\n     4|  \"description\": \"Encodes every critique ledger failure mode with detection boundary, fail-closed action, allowed WBC PersistenceStatus values, forbidden writes, recovery evidence, and admission consequence.\",\n     5|  \"failure_modes\": [\n     6|    {\n     7|      \"failure_mode\": \"start_persistence_failed\",\n     8|      \"description\": \"Critique producer start event fails to persist to the attempt ledger.\",\n     9|      \"detection_boundary\": \"execution_attempt_ledger.write_start() returns PersistenceStatus.PERSISTENCE_FAILED\",\n    10|      \"allowed_persistence_status\": [\"persistence_failed\"],\n    11|      \"fail_closed_action\": \"Abort the critique attempt — no occurrence is created. Record failure in attempt ledger as FAILED.\",\n    12|      \"forbidden_writes\": [\"CritiqueOccurrenceEnvelope\", \"FindingReconciliationEvent\", \"FindingDispositionEvent\"],\n    13|      \"recovery_evidence\": \"Attempt ledger start-failure receipt with PersistenceStatus.PERSISTENCE_FAILED\",\n    14|      \"admission_consequence\": \"BLOCKED — no critique occurrence admissible. Attempt must be retried.\"\n    15|    },\n    16|    {\n    17|      \"failure_mode\": \"start_persistence_indeterminate\",\n    18|      \"description\": \"Critique producer start event persistence status is INDETERMINATE — cannot confirm whether the attempt was recorded.\",\n    19|      \"detection_boundary\": \"execution_attempt_ledger.write_start() returns PersistenceStatus.INDETERMINATE\",\n    20|      \"allowed_persistence_status\": [\"indeterminate\"],\n    21|      \"fail_closed_action\": \"Treat as failure: no occurrence is created. Record INDETERMINATE status with reopen condition for manual resolution.\",\n    22|      \"forbidden_writes\": [\"CritiqueOccurrenceEnvelope\", \"FindingReconciliationEvent\", \"FindingDispositionEvent\"],\n    23|      \"recovery_evidence\": \"Attempt ledger INDETERMINATE receipt + manual authority review\",\n    24|      \"admission_consequence\": \"BLOCKED — INDETERMINATE persistence fails the test rather than being treated as clean success.\"\n    25|    },\n    26|    {\n    27|      \"failure_mode\": \"producer_parse_failed\",\n    28|      \"description\": \"Critique producer output cannot be parsed as a valid finding.\",\n    29|      \"detection_boundary\": \"ParseStatus.FAILED in critique producer output parsing\",\n    30|      \"allowed_persistence_status\": [\"durable\"],\n    31|      \"fail_closed_action\": \"Record failed attempt with ParseStatus.FAILED, no findings emitted. Attempt completes with empty finding set.\",\n    32|      \"forbidden_writes\": [\"FindingReconciliationEvent\", \"FindingDispositionEvent\"],\n    33|      \"recovery_evidence\": \"Attempt ledger completion receipt with ParseStatus.FAILED\",\n    34|      \"admission_consequence\": \"FAILED attempt — no findings admitted. Does not block other attempts.\"\n    35|    },\n    36|    {\n    37|      \"failure_mode\": \"producer_dropped\",\n    38|      \"description\": \"Critique producer custody fails — attempt is dropped before output.\",\n    39|      \"detection_boundary\": \"Critique custody receipt indicates ParseStatus.DROPPED\",\n    40|      \"allowed_persistence_status\": [\"durable\", \"persistence_failed\"],\n    41|      \"fail_closed_action\": \"Record dropped attempt with ParseStatus.DROPPED. Attempt is a custody failure, not a finding failure.\",\n    42|      \"forbidden_writes\": [\"FindingReconciliationEvent\", \"FindingDispositionEvent\"],\n    43|      \"recovery_evidence\": \"Custody failure receipt with ParseStatus.DROPPED\",\n    44|      \"admission_consequence\": \"DROPPED — custody failure. Does not produce findings.\"\n    45|    },\n    46|    {\n    47|      \"failure_mode\": \"producer_malformed\",\n    48|      \"description\": \"Critique producer output is parseable but structurally malformed — preserved as unavailable/unknown evidence.\",\n    49|      \"detection_boundary\": \"ParseStatus.MALFORMED in critique producer output parsing\",\n    50|      \"allowed_persistence_status\": [\"durable\"],\n    51|      \"fail_closed_action\": \"Record malformed output with ParseStatus.MALFORMED. Preserve as unavailable evidence with explicit limitation.\",\n    52|      \"forbidden_writes\": [\"FindingReconciliationEvent\", \"FindingDispositionEvent\"],\n    53|      \"recovery_evidence\": \"Malformed output preserved with EvidenceAvailability.UNAVAILABLE and reopen condition\",\n    54|      \"admission_consequence\": \"MALFORMED — evidence preserved but findings not admitted pending manual review.\"\n    55|    },\n    56|    {\n    57|      \"failure_mode\": \"reconciliation_coverage_incomplete\",\n    58|      \"description\": \"Not all parseable occurrences have a matching FindingReconciliationEvent.\",\n    59|      \"detection_boundary\": \"Semantic loop reconciliation pass — occurrence_count != reconciliation_count\",\n    60|      \"allowed_persistence_status\": [\"durable\"],\n    61|      \"fail_closed_action\": \"Reject the revision manifest. Do not produce briefings or projections. Raise typed validation failure.\",\n    62|      \"forbidden_writes\": [\"DomainBriefingEnvelope\", \"LedgerRevisionManifest\"],\n    63|      \"recovery_evidence\": \"Unreconciled occurrence list with occurrence_ids missing reconciliation\",\n    64|      \"admission_consequence\": \"BLOCKED — incomplete reconciliation coverage prevents manifest construction.\"\n    65|    },\n    66|    {\n    67|      \"failure_mode\": \"disposition_coverage_incomplete\",\n    68|      \"description\": \"Not all reconciled findings have a matching FindingDispositionEvent.\",\n    69|      \"detection_boundary\": \"Semantic loop disposition pass — finding_count != disposition_count\",\n    70|      \"allowed_persistence_status\": [\"durable\"],\n    71|      \"fail_closed_action\": \"Reject the revision manifest. Do not produce briefings. Raise typed validation failure.\",\n    72|      \"forbidden_writes\": [\"DomainBriefingEnvelope\", \"LedgerRevisionManifest\"],\n    73|      \"recovery_evidence\": \"Undisposed finding list with canonical_finding_ids missing disposition\",\n    74|      \"admission_consequence\": \"BLOCKED — incomplete disposition coverage prevents manifest construction.\"\n    75|    },\n    76|    {\n    77|      \"failure_mode\": \"budget_truncation_without_spillover\",\n    78|      \"description\": \"Briefing budget exceeded but no spillover envelope linked — findings silently truncated.\",\n    79|      \"detection_boundary\": \"DomainBriefingEnvelope.validate_budget() detects silent truncation\",\n    80|      \"allowed_persistence_status\": [\"durable\"],\n    81|      \"fail_closed_action\": \"Reject the briefing. Raise DomainBriefingBudgetError with overflow findings linked.\",\n    82|      \"forbidden_writes\": [\"DomainBriefingEnvelope (invalid)\"],\n    83|      \"recovery_evidence\": \"Overflow finding list with linked spillover DomainBriefingEnvelope reference\",\n    84|      \"admission_consequence\": \"BLOCKED — silent truncation is forbidden. Must produce linked spillover envelope.\"\n    85|    },\n    86|    {\n    87|      \"failure_mode\": \"stale_evidence_reference\",\n    88|      \"description\": \"Briefing or projection references evidence whose content hash no longer matches the current manifest.\",\n    89|      \"detection_boundary\": \"Content hash recomputation — stored hash != fresh hash\",\n    90|      \"allowed_persistence_status\": [\"durable\"],\n    91|", "total_lines": 145, "file_size": 10550, "truncated": true, "hint": "Use offset=91 to continue reading (showing 1-90 of 145 lines)", "is_binary": false, "is_image": false}
./critique-ledger-m9-planner-prompt.txt:931:{"content": "     1|\"\"\"Critique Ledger — read-only observe domain for critique occurrence,\n     2|reconciliation, disposition, briefing, and manifest schemas.\n     3|\n     4|This module is pure and side-effect-free: it defines frozen dataclasses,\n     5|enums, hashing helpers, and deterministic validation logic. It never\n     6|mutates lifecycle state, queues, Git, providers, or external effects.\n     7|\"\"\"\n     8|\n     9|from arnold.critique_ledger.schemas import (  # noqa: F401\n    10|    # Enums\n    11|    Authority,\n    12|    CompatibilityProfile,\n    13|    ContextMode,\n    14|    DispositionFamily,\n    15|    EvidenceAvailability,\n    16|    FindingDispositionEvent,\n    17|    ParseStatus,\n    18|    Relationship,\n    19|    # Dataclasses\n    20|    CritiqueOccurrenceEnvelope,\n    21|    DomainBriefingEnvelope,\n    22|    FindingReconciliationEvent,\n    23|    LedgerRevisionManifest,\n    24|    # Helpers\n    25|    canonical_hash,\n    26|    freeze_for_hashing,\n    27|)\n    28|\n    29|from arnold.critique_ledger.semantic_loop import (  # noqa: F401\n    30|    # Failure modes\n    31|    FailureMode,\n    32|    SemanticLoopError,\n    33|    # Pure functions\n    34|    apply_disposition_events,\n    35|    apply_reconciliation_events,\n    36|    build_briefing,\n    37|    construct_manifest,\n    38|    project_gate_input,\n    39|    project_reviser_input,\n    40|    replay_full,\n    41|    validate_occurrence_custody,\n    42|)\n    43|\n    44|__all__ = [\n    45|    # Enums\n    46|    \"Authority\",\n    47|    \"CompatibilityProfile\",\n    48|    \"ContextMode\",\n    49|    \"DispositionFamily\",\n    50|    \"EvidenceAvailability\",\n    51|    \"FindingDispositionEvent\",\n    52|    \"ParseStatus\",\n    53|    \"Relationship\",\n    54|    # Dataclasses\n    55|    \"CritiqueOccurrenceEnvelope\",\n    56|    \"DomainBriefingEnvelope\",\n    57|    \"FindingReconciliationEvent\",\n    58|    \"LedgerRevisionManifest\",\n    59|    # Helpers\n    60|    \"canonical_hash\",\n    61|", "total_lines": 73, "file_size": 1859, "truncated": true, "hint": "Use offset=61 to continue reading (showing 1-60 of 73 lines)", "is_binary": false, "is_image": false}
./critique-ledger-m9-planner-prompt.txt:960:{"content": "     1|\"\"\"Versioned, checksum-validated, crash-resumable schema migrations for the\n     2|M6A WBC transactional ledger substrate.\n     3|\n     4|This module provides the M6A migration boundary. It governs how the SQLite\n     5|schema that backs :class:`~arnold.workflow.attempt_ledger_store.SqliteAttemptLedgerStore`\n     6|and its sibling stores (outbox, payload) evolves over time, and how legacy or\n     7|unreconstructable records are classified.\n     8|\n     9|Design pillars (M6A success criterion 9):\n    10|* **Versioned** — every migration carries a strictly-increasing integer\n    11|  ``version`` and a stable ``name``. Migrations apply in ascending order and a\n    12|  gap in the applied sequence is never bridged silently.\n    13|* **Checksum-validated** — every migration's content (version + name +\n    14|  statements) is reduced to a deterministic SHA-256 checksum that is persisted\n    15|  alongside its applied-state record. On re-open the stored checksum is\n    16|  compared to the live registry's checksum; a mismatch is a forward-fix\n    17|  violation and is surfaced, never silently re-applied.\n    18|* **Crash-resumable** — each migration applies inside its *own* ``BEGIN\n    19|  IMMEDIATE`` transaction that atomically stages the schema change *and* the\n    20|  ``schema_migrations`` row. A crash mid-migration leaves either a fully\n    21|  applied+recorded migration or nothing — never a half-applied migration that a\n    22|  mixed-version reader could mistake for authoritative state. Resuming re-runs\n    23|  the unrecorded migration from scratch; DDL is idempotent (``IF NOT EXISTS``)\n    24|  so a partially-staged-but-uncommitted change is safely re-staged.\n    25|* **Forward-fix only** — there is no downgrade path. A migration, once applied,\n    26|  is immutable. To repair a defect you add a *new* migration; you never edit an\n    27|  applied one (the checksum guard enforces this). Unreconstructable legacy\n    28|  records are classified ``UNKNOWN`` / ``UNRECONSTRUCTABLE`` — success is never\n    29|  synthesized from logs, markers, or mutable state (SD2).\n    30|* **Idempotent on duplicate backfill** — ``migrate()`` is safe to call any\n    31|  number of times; already-applied migrations are skipped, not re-executed.\n    32|* **Mixed reader/writer safe** — migration state is a normal table read under\n    33|  WAL snapshot semantics, so a reader connection observes a consistent\n    34|  ``schema_migrations`` view (some prefix ``1..k`` applied) even while a writer\n    35|  is mid-migration.\n    36|\n    37|This module owns only migration-tracking and legacy-classification tables. It\n    38|does not duplicate the store/outbox/payload DDL; forward migrations are\n    39|additive and idempotent.\n    40|\"\"\"\n    41|\n    42|from __future__ import annotations\n    43|\n    44|import hashlib\n    45|import sqlite3\n    46|import time\n    47|import uuid\n    48|from abc import ABC, abstractmethod\n    49|from dataclasses import dataclass, field\n    50|from enum import Enum\n    51|from typing import Any, Callable, Optional, Sequence\n    52|\n    53|from arnold.workflow.attempt_ledger_store import SqliteAttemptLedgerStore\n    54|\n    55|# ── Constants ─────────────────────────────────────────────────────────────\n    56|\n    57|#: Logical tag embedded in every migration checksum so that checksums from a\n    58|#: different (hypothetical) migration scheme never collide with ours.\n    59|_CHECKSUM_DOMAIN: str = \"arnold.workflow.ledger_migrations.v1\"\n    60|\n    61|#: Number of times to retry ``BEGIN IMMEDIATE`` under ``SQLITE_BUSY`` before\n    62|#: giving up. Mirrors the store/outbox contention handling so a migration run\n    63|#: is safe under separate-process writer contention.\n    64|_BEGIN_RETRY_ATTEMPTS: int = 30\n    65|_BEGIN_RETRY_BASE_DELAY: float = 0.05  # 50 ms\n    66|\n    67|# ── Migration-tracking table DDL ──────────────────────────────────────────\n    68|#\n    69|# The migration-tracking tables are *bootstrap* state: they are created with\n    70|# ``IF NOT EXISTS`` before any versioned query so that ``get_state()`` works on\n    71|# a brand-new store. They are NOT themselves a versioned migration — versioned\n    72|# migrations are additive schema evolution layered on top.\n    73|\n    74|_SCHEMA_MIGRATIONS_TABLE_DDL: str = \"\"\"\\\n    75|CREATE TABLE IF NOT EXISTS schema_migrations (\n    76|    version       INTEGER PRIMARY KEY,\n    77|    name          TEXT    NOT NULL,\n    78|    checksum      TEXT    NOT NULL,\n    79|    applied_at_ns INTEGER NOT NULL,\n    80|    status        TEXT    NOT NULL DEFAULT 'applied'\n    81|);\n    82|\"\"\"\n    83|\n    84|_LEGACY_CLASSIFICATIONS_TABLE_DDL: str = \"\"\"\\\n    85|CREATE TABLE IF NOT EXISTS legacy_record_classifications (\n    86|    classification_id  TEXT    NOT NULL PRIMARY KEY,\n    87|    source_table       TEXT    NOT NULL,\n    88|    record_id          TEXT    NOT NULL,\n    89|    classification     TEXT    NOT NULL,\n    90|    reason             TEXT    NOT NULL,\n    91|    migration_version  INTEGER,\n    92|    classified_at_ns   INTEGER NOT NULL,\n    93|    rolled_back_at_ns  INTEGER\n    94|);\n    95|\"\"\"\n    96|\n    97|_LEGACY_SOURCE_INDEX_DDL: str = \"\"\"\\\n    98|CREATE INDEX IF NOT EXISTS idx_legacy_cls_source\n    99|    ON legacy_record_classifications(source_table, record_id);\n   100|\"\"\"\n   101|", "total_lines": 1212, "file_size": 49490, "truncated": true, "hint": "Use offset=101 to continue reading (showing 1-100 of 1212 lines)", "is_binary": false, "is_image": false}
./critique-ledger-m9-planner-prompt.txt:963:{"content": "     1|\"\"\"Failure, retry, and no-side-effect contract tests for the semantic loop.\"\"\"\n     2|\n     3|from __future__ import annotations\n     4|\n     5|from dataclasses import asdict\n     6|\n     7|import pytest\n     8|\n     9|import arnold.critique_ledger.semantic_loop as semantic_loop\n    10|from arnold.critique_ledger.schemas import (\n    11|    Authority,\n    12|    ContextMode,\n    13|    CritiqueOccurrenceEnvelope,\n    14|    DispositionFamily,\n    15|    EvidenceAvailability,\n    16|    FindingDispositionEvent,\n    17|    FindingReconciliationEvent,\n    18|    ParseStatus,\n    19|    Relationship,\n    20|    canonical_hash,\n    21|)\n    22|from arnold.critique_ledger.semantic_loop import (\n    23|    FailureMode,\n    24|    SemanticLoopError,\n    25|    replay_full,\n    26|    validate_occurrence_custody,\n    27|)\n    28|\n    29|\n    30|def _occ(\n    31|    occurrence_id: str = \"occ-1\",\n    32|    *,\n    33|    parse_status: str = ParseStatus.SELECTED.value,\n    34|    evidence_availability: str = EvidenceAvailability.RETAINED.value,\n    35|    producer_id: str = \"critic\",\n    36|    metadata: dict | None = None,\n    37|    unavailable_reason: str | None = None,\n    38|    reopen_condition: str | None = None,\n    39|    schema_version: str = \"cl.schema.v1\",\n    40|    receipts: tuple[str, ...] = (\"wbc-1\",),\n    41|) -> CritiqueOccurrenceEnvelope:\n    42|    return CritiqueOccurrenceEnvelope(\n    43|        schema_version=schema_version,\n    44|        occurrence_id=occurrence_id,\n    45|        attempt_id=\"attempt-1\",\n    46|        round_label=\"v1\",\n    47|        finding_id=f\"finding-{occurrence_id}\",\n    48|        producer_id=producer_id,\n    49|        model_id=\"model\",\n    50|        context_mode=ContextMode.HISTORY_AWARE.value,\n    51|        parse_status=parse_status,\n    52|        evidence_availability=evidence_availability,\n    53|        unavailable_reason=unavailable_reason,\n    54|        reopen_condition=reopen_condition,\n    55|        custody_receipt_refs=receipts,\n    56|        metadata=metadata or {},\n    57|    )\n    58|\n    59|\n    60|def _rec(\n    61|", "total_lines": 300, "file_size": 9912, "truncated": true, "hint": "Use offset=61 to continue reading (showing 1-60 of 300 lines)", "is_binary": false, "is_image": false}
./critique-ledger-m9-planner-prompt.txt:1027:{"content": "   190|class LegacyClassification(Enum):\n   191|    \"\"\"Classification of a legacy or unreconstructable record.\n   192|\n   193|    The key rule (SD2 / criterion 9): records that cannot be confidently\n   194|    reconstructed are ``UNKNOWN`` / ``UNRECONSTRUCTABLE``. The migration system\n   195|    never synthesizes success (``BACKFILLED``) from incomplete evidence.\n   196|\n   197|    * ``BACKFILLED`` — the record was durably reconstructed from authoritative\n   198|      source evidence.\n   199|    * ``UNKNOWN`` — the record cannot be reconstructed and its true state is\n   200|      indeterminate. No terminal/success outcome is synthesized.\n   201|    * ``CORRUPT`` — the record or its source evidence is structurally damaged.\n   202|    * ``UNRECONSTRUCTABLE`` — no source exists from which to reconstruct the\n   203|      record (e.g. the producing system never persisted it).\n   204|    \"\"\"\n   205|\n   206|    BACKFILLED = \"backfilled\"\n   207|    UNKNOWN = \"unknown\"\n   208|    CORRUPT = \"corrupt\"\n   209|    UNRECONSTRUCTABLE = \"unreconstructable\"\n   210|\n   211|\n   212|@dataclass(frozen=True)\n   213|class ClassificationEvidence:\n   214|    \"\"\"Evidence profile for a legacy record being classified.\n   215|\n   216|    This dataclass makes the evidence sources *explicit* so that the\n   217|    classification decision function can reject BACKFILLED when the authority\n   218|    derives from impermissible sources (logs, markers, receipts, mutable state).\n   219|\n   220|    Attributes:\n   221|        has_authoritative_source: The record can be reconstructed from\n   222|            authoritative, durable source data (e.g. a separate durable store\n   223|            with matching checksums). This is the ONLY path to BACKFILLED.\n   224|        has_logs: Operational logs mention the record. NOT authoritative.\n   225|        has_markers: Checkpoint/status markers reference the record. NOT\n   226|            authoritative.\n   227|        has_receipts: Delivery receipts or acknowledgments exist. NOT\n   228|            authoritative.\n   229|        has_mutable_state: A mutable system (e.g. in-memory cache, runtime\n   230|            state) holds data about the record. NOT authoritative.\n   231|        is_structurally_damaged: The record or its source is structurally\n   232|            damaged (e.g. corrupt encoding, missing required fields).\n   233|        source_exists: ``False`` when no source system ever persisted the\n   234|            record (UNRECONSTRUCTABLE).\n   235|        notes: Free-form notes about the evidence assessment.\n   236|    \"\"\"\n   237|\n   238|    has_authoritative_source: bool = False\n   239|    has_logs: bool = False\n   240|    has_markers: bool = False\n   241|    has_receipts: bool = False\n   242|    has_mutable_state: bool = False\n   243|    is_structurally_damaged: bool = False\n   244|    source_exists: bool = True\n   245|    notes: str = \"\"\n   246|\n   247|    @property\n   248|    def only_circumstantial(self) -> bool:\n   249|        \"\"\"True when evidence consists ONLY of impermissible sources\n   250|        (logs, markers, receipts, mutable state) with no authoritative source.\"\"\"\n   251|        return (\n   252|            not self.has_authoritative_source\n   253|            and (\n   254|                self.has_logs\n   255|                or self.has_markers\n   256|                or self.has_receipts\n   257|                or self.has_mutable_state\n   258|            )\n   259|        )\n   260|\n   261|    @property\n   262|    def no_evidence(self) -> bool:\n   263|        \"\"\"True when no evidence of any kind is available.\"\"\"\n   264|        return (\n   265|            not self.has_authoritative_source\n   266|            and not self.has_logs\n   267|            and not self.has_markers\n   268|            and not self.has_receipts\n   269|            and not self.has_mutable_state\n   270|        )\n   271|\n   272|\n   273|# ── Checksum ──────────────────────────────────────────────────────────────\n   274|\n   275|\n   276|def compute_migration_checksum(\n   277|    version: int, name: str, statements: Sequence[str]\n   278|) -> str:\n   279|    \"\"\"Return the deterministic SHA-256 checksum for a migration.\n   280|", "total_lines": 1212, "file_size": 49490, "truncated": true, "hint": "Use offset=280 to continue reading (showing 190-279 of 1212 lines)", "is_binary": false, "is_image": false}
./critique-ledger-m9-planner-prompt.txt:1059:{"content": "    91|      \"fail_closed_action\": \"Flag as stale. Do not admit stale evidence. Require regeneration from source.\",\n    92|      \"forbidden_writes\": [\"LedgerRevisionManifest (with stale reference)\"],\n    93|      \"recovery_evidence\": \"Stale hash report with stored vs recomputed hash pairs\",\n    94|      \"admission_consequence\": \"BLOCKED — stale evidence references are rejected.\"\n    95|    },\n    96|    {\n    97|      \"failure_mode\": \"unsupported_schema_version\",\n    98|      \"description\": \"Evidence artifact declares an unsupported or future schema version.\",\n    99|      \"detection_boundary\": \"Schema version check against SUPPORTED_VERSIONS\",\n   100|      \"allowed_persistence_status\": [\"durable\"],\n   101|      \"fail_closed_action\": \"Reject with typed SchemaVersionError. Do not attempt compatibility-preserve mode for unknown versions.\",\n   102|      \"forbidden_writes\": [\"Any event with unsupported schema\"],\n   103|      \"recovery_evidence\": \"Schema version mismatch report with expected vs actual version\",\n   104|      \"admission_consequence\": \"BLOCKED — unsupported schema versions are rejected. Corrupt or future-version inputs fail validation.\"\n   105|    },\n   106|    {\n   107|      \"failure_mode\": \"duplicate_event_identity\",\n   108|      \"description\": \"Two events share the same identity (occurrence_id, reconciliation_id, or disposition_id).\",\n   109|      \"detection_boundary\": \"Identity uniqueness check during append-only event construction\",\n   110|      \"allowed_persistence_status\": [\"durable\"],\n   111|      \"fail_closed_action\": \"Reject the duplicate. Preserve the first-occurring event. Log duplicate detection.\",\n   112|      \"forbidden_writes\": [\"Duplicate event with same identity\"],\n   113|      \"recovery_evidence\": \"Duplicate detection log with event identity and first-occurrence timestamp\",\n   114|      \"admission_consequence\": \"BLOCKED — duplicate events are not idempotent append; second event is rejected.\"\n   115|    },\n   116|    {\n   117|      \"failure_mode\": \"missing_ownership_authority\",\n   118|      \"description\": \"Event producer is not in the source_to_owner_matrix for the claimed domain.\",\n   119|      \"detection_boundary\": \"Ownership validation against source_to_owner_matrix.json\",\n   120|      \"allowed_persistence_status\": [\"durable\"],\n   121|      \"fail_closed_action\": \"Reject the event. Log unauthorized producer attempt.\",\n   122|      \"forbidden_writes\": [\"Any event from unauthorized producer\"],\n   123|      \"recovery_evidence\": \"Ownership validation failure report with producer identity and claimed domain\",\n   124|      \"admission_consequence\": \"BLOCKED — events from unauthorized producers are rejected.\"\n   125|    },\n   126|    {\n   127|      \"failure_mode\": \"terminal_persistence_failure\",\n   128|      \"description\": \"Final manifest persistence fails — all event processing was successful but the durable write fails.\",\n   129|      \"detection_boundary\": \"LedgerRevisionManifest persistence returns PersistenceStatus.PERSISTENCE_FAILED or INDETERMINATE\",\n   130|      \"allowed_persistence_status\": [\"persistence_failed\", \"indeterminate\"],\n   131|      \"fail_closed_action\": \"FAIL the entire revision. Do not admit as clean success. Record terminal persistence failure with retry predicate.\",\n   132|      \"forbidden_writes\": [\"LedgerRevisionManifest (unpersisted)\"],\n   133|      \"recovery_evidence\": \"Terminal persistence failure receipt with retry predicate\",\n   134|      \"admission_consequence\": \"BLOCKED — terminal persistence failure is not clean success. INDETERMINATE fails the test.\"\n   135|    }\n   136|  ],\n   137|  \"cross_reference\": {\n   138|    \"wbc_enums_used\": {\n   139|      \"PersistenceStatus\": [\"durable\", \"persistence_failed\", \"indeterminate\"],\n   140|      \"ParseStatus\": [\"FAILED\", \"DROPPED\", \"MALFORMED\", \"TOMBSTONED\", \"NO_ADDITIONAL_FINDINGS\"],\n   141|      \"EvidenceAvailability\": [\"RETAINED\", \"GOVERNED_REFERENCE\", \"UNAVAILABLE\"]\n   142|    },\n   143|    \"fail_closed_principle\": \"Every failure mode has a detection boundary, a fail-closed action, and forbidden writes. No failure mode is silently accepted — INDETERMINATE persistence always fails the test rather than being treated as clean success.\"\n   144|  }\n   145|}\n   146|", "total_lines": 145, "file_size": 10550, "truncated": false, "is_binary": false, "is_image": false}
./critique-ledger-m9-planner-prompt.txt:1072:      "arguments": "{\"path\":\"/workspace/critique-ledger-m9-glm-20260723/Arnold/.megaplan/plans/cl2-wbc-backed-ledger-20260724-0351/plan.md\",\"content\":\"# Implementation Plan: CL2 — WBC-backed Ledger Persistence, Import, and Replay\\n\\n## Overview\\n\\n### Goal\\n\\nImplement the frozen CL1 critique record contract through existing WBC/SQLite\\npersistence seams (`SqliteAttemptLedgerStore`, `SqliteLedgerOutbox`,\\n`SqliteLedgerPayloadStore`), with atomic append, idempotent retry, rebuildable\\nprojections, read-only store-backed replay, and a one-time import of the\\nretained M6 corpus into the CL1 schema. Leave CL3 one stable target API,\\nfixtures, and a reviewed handoff.\\n\\n### Current Repository Shape\\n\\nThe codebase has two cleanly separated layers:\\n\\n- **`arnold.critique_ledger`** (pure, side-effect-free): Frozen CL1 dataclasses\\n  — `CritiqueOccurrenceEnvelope`, `FindingReconciliationEvent`,\\n  `FindingDispositionEvent`, `DomainBriefingEnvelope`, `LedgerRevisionManifest`\\n  (`schemas.py:182-731`). All declare `SCHEMA_VERSION = \\\"cl.schema.v1\\\"` and\\n  validate via `SUPPORTED_VERSIONS`. `semantic_loop.py` provides the deterministic\\n  in-memory `replay_full()` (pure, no I/O) that CL2 must reproduce from the\\n  store.\\n\\n- **`arnold.workflow`** (WBC persistence substrate): `SqliteAttemptLedgerStore`\\n  (`attempt_ledger_store.py`) owns the `attempt_events` table\\n  (`PRIMARY KEY (attempt_id, sequence)`) and enforces the four Step 4\\n  invariants in one `BEGIN IMMEDIATE` via `_append_tx`\\n  (`attempt_ledger_store.py:1028-1143`). `SqliteLedgerOutbox`\\n  (`ledger_outbox.py:336-499`) proves atomic event+outbox writes on the same\\n  `store.conn`. `SqliteLedgerPayloadStore` (`ledger_payload_store.py:674-854`)\\n  shares `store.conn` and enforces the six WBC payload boundaries. The\\n  `AttemptEventType` enum (`execution_attempt_ledger.py:146-164`) has 11 generic\\n  lifecycle values; `LedgerEvent.payload` (`execution_attempt_ledger.py:755`)\\n  accepts `dict | DurableRef | None`.\\n\\nThe M6 corpus (`tests/fixtures/critique_ledger/m6-corpus.json`, 892KB) has 5\\nrounds (v1–v5), each carrying `critique_custody`, `evaluator_verdict`,\\n`gate_signals`, and per-producer check data — the sole input for the one-time\\nimporter.\\n\\n### Constraints That Matter\\n\\n1. **No enum widening**: CL1 forbids adding critique-specific `AttemptEventType`\\n   values. Critique records must ride through `LedgerEvent.payload` using existing\\n   generic types (`EXTERNAL_EFFECT_INTENT`, `RECONCILIATION`,\\n   `EXTERNAL_EFFECT_OUTCOME`). `EXTERNAL_EFFECT_INTENT` requires a non-null\\n   `payload` or `payload_policy_ref` (`execution_attempt_ledger.py:837-842`).\\n2. **Attempt-scoped table**: `attempt_events` has no domain/round columns.\\n   Cross-attempt `LedgerRevisionManifest` aggregation and domain/round replay\\n   need separate tables in the same SQLite DB — not schema widening.\\n3. **Start precedes dispatch**: Terminal persistence failure is visible\\n   `persistence_failed|indeterminate`, never clean success\\n   (failure-atomicity-table modes 1–2, 13).\\n4. **Replay purity**: Store-backed replay issues no model call or external effect\\n   — it must match the in-memory `replay_full` zero-write assertion.\\n5. **faults.json stays writable**: CL2 does not change the flag write path;\\n   dual-write is a parallel ledger event, not a replacement.\\n6. **Idempotency**: Each critique record gets a stable idempotency key so\\n   duplicate replay is a no-op via the existing dedup check.\\n\\n### Anchor Tension (Flagged, Not Silently Resolved)\\n\\nThe CL1 handoff has `accepted_for_cl2: false` with 5 procedural blockers\\n(`cl1-contract-oracle.json:411-441`). The idea constraint says \\\"Consume only an\\naccepted CL1 handoff.\\\" However, all CL1 must-gates pass (custody, freshness,\\nreplay equality, authority, schema, prerequisite), all five schemas are frozen\\nwith verifiable SHA-256 hashes, and the 5 blockers are\\nprocedural/infrastructural (not material invalidations). The Epic North Star\\nmandates that \\\"custody failure stops admission rather than falling back\\nsilently\\\" and that cutover is \\\"one coordinated\\\" event.\\n\\n**Decision**: CL2 proceeds **conditionally**, treating the 5 blockers as tracked\\nopen gates validated by a dedicated test (Step 1). This is a **bridge**, not a\\nsilent override: schema hashes must not change, and any blocker resolution that\\nalters schemas would require CL2 scope recalibration. This tension is surfaced\\nexplicitly here and in the written handoff.\\n\\n## Main Phases\\n\\n---\\n\\n## Phase 1: Precondition Gate + Serialization Foundation\\n\\n### Step 1: CL2 conditional-acceptance gate (`tests/arnold/critique_ledger/test_cl2_handoff.py`)\\n\\n**Scope:** Small — **Complexity: 2**\\n\\n**Rationale:** Cheapest validation first. Confirms the frozen CL1 contract is\\nintact before building on it, and materializes the conditional-acceptance\\ndecision as a tracked gate.\\n\\n1. **Create** `tests/arnold/critique_ledger/test_cl2_handoff.py` that loads\\n   `docs/critique-ledger/handoffs/cl1-contract-oracle.json` and asserts:\\n   - All CL1 must-gates pass (`accepted_for_cl2.checks.cl1_must_gates_pass.passed == true`).\\n   - All recorded file hashes are fresh (recompute from disk, compare to handoff\\n     `schema_and_version_hashes` and `manifest_oracle_gate_hashes` — reuse the\\n     `_sha256_file` / `HASHED_PATHS` pattern from `test_cl1_handoff.py:25-57`).\\n   - The 5 blocking reasons are inventoried and non-empty (they are open gates,\\n     not silent gaps).\\n   - `accepted_for_cl2.value == false` is the correct AND of the four checks\\n     (confirming the derivation, not asserting acceptance).\\n   - `SUPPORTED_VERSIONS == {\\\"cl.schema.v1\\\"}` is unchanged (no schema drift).\\n2. **Add** a constant `CL2_OPEN_GATES` listing the 5 blocker keys so CL3 can\\n   validate CL2 tracked them.\\n3. **Run** `pytest tests/arnold/critique_ledger/test_cl1_handoff.py\\n   tests/arnold/critique_ledger/test_cl2_handoff.py` to confirm both pass (the\\n   existing test validates derivation correctness; the new test validates CL2's\\n   conditional-acceptance posture).\\n\\n---\\n\\n### Step 2: CritiqueLedgerSerializer — pure CL1 ↔ LedgerEvent bridge (`arnold/critique_ledger/ledger_serializer.py`)\\n\\n**Scope:** Medium — **Complexity: 3**\\n\\n**Rationale:** The serializer is the single bridge point between frozen CL1\\ndomain records and the generic WBC event stream. It is pure (no I/O) so it fits\\nthe `arnold.critique_ledger` purity invariant and can be unit-tested in\\nisolation before any persistence wiring.\\n\\n1. **Create** `arnold/critique_ledger/ledger_serializer.py` with:\\n   - A `CRITIQUE_RECORD_TYPES` mapping: `\\\"occurrence\\\"` → `EXTERNAL_EFFECT_INTENT`,\\n     `\\\"reconciliation\\\"` → `RECONCILIATION`, `\\\"disposition\\\"` →\\n     `EXTERNAL_EFFECT_OUTCOME`, `\\\"manifest\\\"` → `EXTERNAL_EFFECT_INTENT`.\\n   - `CritiqueLedgerSerializer` with:\\n     - `envelope_to_event(occurrence, *, identity, provenance, adapter, versions, grant_ref, sequence, ...) -> LedgerEvent`: serializes the envelope dict\\n       into `payload` with an explicit discriminator wrapper:\\n       ```python\\n       payload = {\\n           \\\"critique_record_type\\\": \\\"occurrence\\\",\\n           \\\"schema_version\\\": \\\"cl.schema.v1\\\",\\n           \\\"record\\\": occurrence.to_dict(),\\n       }\\n       ```\\n       This satisfies the `EXTERNAL_EFFECT_INTENT` payload requirement\\n       (`execution_attempt_ledger.py:837`) and makes deserialization\\n       unambiguous without overloading `event_type` semantics.\\n     - Same pattern for `reconciliation_to_event` and `disposition_to_event`.\\n     - `manifest_to_event(manifest, ...)` for `LedgerRevisionManifest`.\\n   - `CritiqueLedgerDeserializer` with:\\n     - `event_to_record(event: LedgerEvent) -> CritiqueOccurrenceEnvelope | FindingReconciliationEvent | FindingDispositionEvent | LedgerRevisionManifest`:\\n       inspect `event.payload[\\\"critique_record_type\\\"]` and dispatch to the\\n       correct `from_dict`. Validate `schema_version` via `SUPPORTED_VERSIONS`\\n       before reconstruction (reject unsupported/future versions).\\n     - `extract_record_type(event) -> str | None`: returns the discriminator or\\n       `None` if the event is not a critique record (non-critique\\n       `EXTERNAL_EFFECT_INTENT` events pass through untouched).\\n2. **Reject** any payload whose `schema_version` is not in `SUPPORTED_VERSIONS`\\n   — raise `ValueError` (forward-fix only; never preserve unknown versions).\\n3. **Create** `tests/arnold/critique_ledger/test_ledger_serializer.py` with:\\n   - Round-trip tests: serialize each CL1 record type → `LedgerEvent` →\\n     deserialize → equals original (all four record types).\\n   - Discriminator tests: `extract_record_type` returns correct type; non-critique\\n     events return `None`.\\n   - Schema-version rejection: a payload with `\\\"cl.schema.v999\\\"` raises\\n     `ValueError`.\\n   - Idempotency-key stability: the same record always yields the same\\n     `idempotency_key` (derive from the record's identity field:\\n     `occurrence_id` / `reconciliation_id` / `disposition_id` / `manifest_id`).\\n4. **Export** `CritiqueLedgerSerializer`, `CritiqueLedgerDeserializer` from\\n   `arnold/critique_ledger/__init__.py`.\\n\\n---\\n\\n## Phase 2: WBC-backed Persistence\\n\\n### Step 3: CritiqueLedgerStore — schema + occurrence append + start gate (`arnold/workflow/critique_ledger_store.py`)\\n\\n**Scope:** Large — **Complexity: 4**\\n\\n**Rationale:** The store is the WBC-backed persistence boundary for critique\\nrecords. It lives in `arnold.workflow` (I/O layer) and depends on both the WBC\\nstores and the pure `arnold.critique_ledger` schemas. This step adds the schema\\nand the core occurrence write path with the start-persistence gate.\\n\\n1. **Create** `arnold/workflow/critique_ledger_store.py` with:\\n   - **Schema DDL** (created on `store.conn`, same DB, idempotent `IF NOT EXISTS`):\\n     - `_CRITIQUE_REVISION_MANIFESTS_DDL`: `revision_manifests` table —\\n       `revision_hash TEXT PRIMARY KEY, prior_revision_hash TEXT,\\n       input_set_hash TEXT, domain_completeness TEXT (JSON),\\n       wbc_receipt_refs TEXT (JSON), event_ids TEXT (JSON), manifest_json TEXT,\\n       created_at_ns INTEGER`.\\n     - `_ROUND_ATTEMPTS_DDL`: `round_attempts` mapping table —\\n       `round_label TEXT, attempt_id TEXT, PRIMARY KEY (round_label, attempt_id)`.\\n     - `_EVENTS_SEQUENCE_INDEX_DDL`:\\n       `CREATE INDEX IF NOT EXISTS idx_attempt_events_sequence ON attempt_events(sequence)`\\n       for efficient cumulative cross-attempt ordered scans.\\n   - **`CritiqueLedgerStore`** class wrapping `SqliteAttemptLedgerStore` +\\n     `SqliteLedgerOutbox` + `SqliteLedgerPayloadStore` (all sharing `store.conn`):\\n     - `__init__(store, outbox, payload_store)`: store references, init schema.\\n     - `append_started(attempt_id, identity, ...) -> AppendResult`: append a\\n       `STARTED` `LedgerEvent` via `store._append_tx`. **This is the\\n       start-persistence gate** — must succeed before any occurrence is appended.\\n     - `append_occurrence(attempt_id, occurrence, *, identity, ...) -> AppendResult`:\\n       use `CritiqueLedgerSerializer.envelope_to_event` to build the\\n       `EXTERNAL_EFFECT_INTENT` event, then call\\n       `outbox.append_event_with_outbox(attempt_id, event, outbox_payloads=[])`.\\n       If the occurrence evidence payload exceeds the inline threshold, route\\n       through `payload_store.store_payload` first and embed the resulting\\n       `DurableRef` in the event payload instead of the inline dict.\\n     - **Populate `round_attempts`**: in the same `BEGIN IMMEDIATE` transaction\\n       as the occurrence append, `INSERT OR IGNORE INTO round_attempts` the\\n       `(occurrence.round_label, attempt_id)` pair. This requires a small\\n       extension to the append path — execute the round_attempts INSERT on the\\n       shared `store.conn` immediately after the event INSERT and before COMMIT.\\n       (The outbox method's transaction is open; we add the round_attempts write\\n       by providing a callback hook or a thin wrapper that runs the extra INSERT\\n       inside the same transaction.)\\n2. **Handle the transaction boundary**: Since `append_event_with_outbox` manages\\n   its own `BEGIN IMMEDIATE`/`COMMIT`, the round_attempts population needs to\\n   participate. Implement `append_occurrence` as a custom transaction method on\\n   `CritiqueLedgerStore` that mirrors the outbox's dedup → post-terminal →\\n   monotonic → INSERT event → INSERT round_attempts → COMMIT sequence, all on\\n   `store.conn`. Reuse `_begin_immediate_retry`.\\n3. **Create** `tests/arnold/critique_ledger/test_critique_ledger_store.py` with:\\n   - Schema initialization test: tables and indexes exist after construction.\\n   - Start-gate test: `append_started` succeeds; a subsequent occurrence append\\n     works.\\n   - Start-gate failure: if the store is closed/corrupted, `append_started`\\n     raises and no occurrence is written.\\n   - Occurrence append: event lands in `attempt_events` with correct\\n     `event_type` and deserializable payload; `round_attempts` row inserted.\\n   - Idempotency: appending the same occurrence twice returns `is_duplicate=True`\\n     and does not create a second event.\\n   - Inline vs reference routing: small payload inline, large payload via\\n     `payload_store` with `DurableRef` in event.\\n\\n---\\n\\n### Step 4: CritiqueLedgerStore — reconciliation/disposition append + manifest publication (`arnold/workflow/critique_ledger_store.py`)\\n\\n**Scope:** Medium — **Complexity: 3**\\n\\n1. **Add** to `CritiqueLedgerStore`:\\n   - `append_reconciliation(attempt_id, reconciliation, ...) -> AppendResult`:\\n     serialize via `reconciliation_to_event` (`RECONCILIATION` type), append via\\n     the same transactional path.\\n   - `append_disposition(attempt_id, disposition, ...) -> AppendResult`:\\n     serialize via `disposition_to_event` (`EXTERNAL_EFFECT_OUTCOME` type),\\n     append via the same transactional path.\\n2. **Add** `publish_manifest(manifest: LedgerRevisionManifest) -> ManifestPublishResult`:\\n   - **Complete-occurrence validation**: Before INSERT, query `attempt_events`\\n     to confirm every `manifest.event_ids` occurrence is durably persisted and\\n     has a valid (parseable, non-FAILED) record. If any referenced occurrence is\\n     missing or invalid, raise `ManifestIncompleteError` (typed) and do NOT\\n     INSERT — this enforces \\\"partial publication cannot expose an accepted\\n     incomplete ledger revision.\\\"\\n   - **Atomic INSERT**: `INSERT INTO revision_manifests` with the manifest's\\n     `input_set_hash` as `revision_hash` (PK), the full manifest JSON, and all\\n     vector fields. Run in one `BEGIN IMMEDIATE`.\\n   - **Idempotency**: If the `revision_hash` already exists, return the existing\\n     manifest (no-op) — duplicate replay is safe.\\n   - **Terminal persistence failure**: If the INSERT fails, the revision is not\\n     admitted as clean success. Surface the failure (failure-atomicity-table\\n     mode 13: `terminal_persistence_failure`).\\n3. **Add** `read_manifest(revision_hash: str) -> LedgerRevisionManifest | None`\\n   and `latest_manifest() -> LedgerRevisionManifest | None`.\\n4. **Extend** `tests/arnold/critique_ledger/test_critique_ledger_store.py`:\\n   - Reconciliation/disposition append + round-trip via deserializer.\\n   - Manifest publication: succeeds when all occurrences present; fails when an\\n     occurrence is missing (assert `ManifestIncompleteError` and that no manifest\\n     row exists).\\n   - Manifest idempotency: publishing the same manifest twice is a no-op.\\n   - Sequence: start → occurrences → reconciliations → dispositions → manifest;\\n     manifest fails if any prior step is skipped.\\n\\n---\\n\\n## Phase 3: Store-backed Read-only Replay\\n\\n### Step 5: CritiqueLedgerReplay — deterministic store-backed replay (`arnold/workflow/critique_ledger_replay.py`)\\n\\n**Scope:** Large — **Complexity: 4**\\n\\n**Rationale:** The in-memory `replay_full` (`semantic_loop.py:964-1206`) is the\\ncontract CL2 must reproduce from the store. Store-backed replay reads persisted\\nevents, reconstructs typed records, and feeds them to the existing pure\\n`replay_full` — guaranteeing byte-equivalent projections without reimplementing\\nthe semantic loop.\\n\\n1. **Create** `arnold/workflow/critique_ledger_replay.py` with\\n   `CritiqueLedgerReplay`:\\n   - `replay_attempt(attempt_id) -> list[CritiqueOccurrenceEnvelope | ...]`:\\n     read events via `store.read_events(attempt_id)`, filter to critique records\\n     via `Deserializer.extract_record_type`, reconstruct typed records.\\n   - `replay_round(round_label) -> dict[str, list]`:\\n     `SELECT attempt_id FROM round_attempts WHERE round_label = ?` → for each\\n     attempt, `replay_attempt` → collect occurrences/reconciliations/dispositions.\\n   - `replay_domain(domain, occurrence_ids) -> dict`:\\n     domain cardinality is bounded (2–4 per briefing budget); filter\\n     in-memory after loading round/all events (domain lives in the occurrence\\n     envelope, not a column).\\n   - `replay_cumulative() -> dict[str, list]`:\\n     `SELECT event_json FROM attempt_events ORDER BY sequence ASC` (uses\\n     `idx_attempt_events_sequence`) → reconstruct all critique records in global\\n     append order.\\n   - `replay_revision(revision_hash) -> dict`:\\n     load the `LedgerRevisionManifest`, load its `event_ids`, reconstruct those\\n     occurrences, then call `replay_full` to produce the full projection set\\n     (custody, reconciliation, disposition, manifest, briefing,\\n     reviser_projection, gate_projection).\\n2. **Purity guarantee**: `CritiqueLedgerReplay` performs only `SELECT` reads\\n   (no INSERT/UPDATE/DELETE). It delegates to the pure `replay_full` for\\n   projection computation. No model calls, no subprocess, no filesystem writes.\\n   The existing `test_zero_write_mutation_gate` pattern must hold — add an\\n   equivalent assertion.\\n3. **Byte-equivalence**: `replay_revision` must produce projections identical to\\n   calling `replay_full` directly with the same in-memory lists. Assert by\\n   comparing `canonical_hash` of both projection dicts.\\n4. **Create** `tests/arnold/critique_ledger/test_critique_ledger_replay.py`:\\n   - Round-trip: write occurrences/reconciliations/dispositions/manifest via\\n     `CritiqueLedgerStore`, then replay and assert byte-equivalence with\\n     direct `replay_full`.\\n   - Replay twice → identical hashes (determinism).\\n   - Per-attempt, round-scoped, cumulative replay all return consistent subsets.\\n   - Zero-write assertion: replay does not modify the store (row counts\\n     unchanged, no new files).\\n   - Replay with a missing manifest returns None / empty (no partial projection).\\n\\n---\\n\\n## Phase 4: One-time M6 Import\\n\\n### Step 6: M6 one-time importer (`arnold/workflow/critique_ledger_importer.py`)\\n\\n**Scope:** Large — **Complexity: 4**\\n\\n1. **Create** `arnold/workflow/critique_ledger_importer.py` with\\n   `M6CorpusImporter`:\\n   - `import_corpus(corpus_path, store) -> ImportReport`:\\n     - Load `m6-corpus.json`, validate `meta.raw_hash` and `meta.redacted_hash`\\n       against the file on disk.\\n     - **Schema gate**: before any write, assert\\n       `corpus[\\\"meta\\\"][\\\"schema_version\\\"] == \\\"cl.m6-corpus.v1\\\"` and the target\\n       `SUPPORTED_VERSIONS == {\\\"cl.schema.v1\\\"}`. Reject unsupported target\\n       versions with a typed error (failure-atomicity-table mode:\\n       `unsupported_schema_version`).\\n     - **Traverse rounds v1–v5**: for each round, map:\\n       - `round.critique_custody.findings[]` → `CritiqueOccurrenceEnvelope`\\n         instances (occurrence_id, finding_id, producer_id, parse_status,\\n         evidence hashes from the corpus's dual-hashed fields).\\n       - `round.evaluator_verdict.flag_verifications[]` →\\n         `FindingReconciliationEvent` and `FindingDispositionEvent` instances\\n         (map verified/disputed/resolved to reconciliation relationships and\\n         disposition families).\\n       - Plan-level `faults`/`contract` → manifest `input_set_hash` inputs.\\n     - **Classify every legacy record** via `LegacyClassification`\\n       (`ledger_migrations.py:190-270`):\\n       - The M6 corpus is an authoritative source (frozen, hash-verified) →\\n         `ClassificationEvidence(has_authoritative_source=True)` →\\n         `BACKFILLED` for records that map cleanly.\\n       - Records that cannot map (missing field, ambiguous) → `UNKNOWN` (never\\n         `BACKFILLED` from circumstantial evidence —\\n         `ClassificationSafetyError` if attempted).\\n     - **Apply the partial-parse contract** even though the corpus has zero\\n       failures: validate each occurrence's `parse_status`; FAILED → record\\n       attempt, no findings; MALFORMED → `UNAVAILABLE` with reopen condition;\\n       TOMBSTONED → mark removed.\\n     - **Atomic import**: use `CritiqueLedgerStore.append_*` for each record —\\n       each imported occurrence is an immutable event. Mark all imported records\\n       with `metadata.source = \\\"m6-corpus-one-time-import\\\"`.\\n     - Return an `ImportReport` with counts (rounds, occurrences,\\n       reconciliations, dispositions, manifests, classifications, any gaps\\n       marked UNKNOWN).\\n2. **Create** `tests/arnold/critique_ledger/test_m6_importer.py`:\\n   - Import the full 5-round corpus → assert all occurrences preserved, zero\\n     dropped, zero FAILED/DROPPED/MALFORMED (oracle fact 6).\\n   - Idempotency: importing twice is a no-op (idempotency-key dedup).\\n   - Future-version rejection: a corpus with `schema_version = \\\"cl.m6-corpus.v999\\\"`\\n     is rejected before any write (assert zero events written).\\n   - Classification: every record classified `BACKFILLED` with\\n     `has_authoritative_source=True`; no `UNKNOWN` for the clean corpus.\\n   - Replay: after import, `CritiqueLedgerReplay.replay_cumulative()` returns\\n     all 5 rounds' records in order.\\n\\n---\\n\\n## Phase 5: Compatibility Bridge + Fixtures\\n\\n### Step 7: faults.json dual-write bridge (`arnold_pipelines/megaplan/flags.py`)\\n\\n**Scope:** Medium — **Complexity: 3**\\n\\n**Rationale:** CL2 keeps `faults.json` writable for active readers during the\\ntransition window (CL5 cutover retires it). The dual-write emits a parallel WBC\\nflag-sync event so the ledger has a complete record without disrupting the\\nexisting write path.\\n\\n1. **Add** a `FlagSyncEnvelope` helper (in `arnold/critique_ledger/schemas.py`\\n   or a lightweight dict structure) that wraps the flag registry snapshot with\\n   `schema_version`, `plan_id`, `iteration`, and `flags` list.\\n2. **Add** an optional `ledger_writer` parameter to `update_flags_after_critique`\\n   (`flags.py:279-293`): when provided, after `save_flag_registry` writes\\n   `faults.json`, emit a flag-sync event via\\n   `CritiqueLedgerStore.append_flag_sync(plan_id, flags, iteration)`. This is a\\n   new method on `CritiqueLedgerStore` that serializes the flag snapshot as an\\n   `EXTERNAL_EFFECT_INTENT` event with `critique_record_type = \\\"flag_sync\\\"`.\\n3. **Keep the existing path unchanged**: when `ledger_writer` is `None` (the\\n   default), behavior is identical to today. The dual-write is opt-in so existing\\n   tests and callers are unaffected.\\n4. **Create** `tests/arnold/critique_ledger/test_flag_dual_write.py`:\\n   - With `ledger_writer=None`: `faults.json` written, no ledger event (existing\\n     behavior preserved).\\n   - With `ledger_writer`: `faults.json` written AND a flag-sync event lands in\\n     the store. Assert both paths produce consistent flag state.\\n   - `faults.json` remains writable (no read-only enforcement in CL2).\\n\\n---\\n\\n### Step 8: CL2 fixtures (`tests/fixtures/critique_ledger/`)\\n\\n**Scope:** Medium — **Complexity: 3**\\n\\n1. **Create** the following fixtures (small, focused JSON files for each\\n   negative-test scenario):\\n   - `cl2_current_source.json` — a valid current-source occurrence set for\\n     positive round-trip tests.\\n   - `cl2_target_only.json` — target-schema record with no legacy source (tests\\n     forward-only import).\\n   - `cl2_future_version.json` — record declaring `\\\"cl.schema.v999\\\"` (must be\\n     rejected by the schema gate).\\n   - `cl2_corrupt.json` — structurally damaged record (missing required fields,\\n     invalid JSON structure).\\n   - `cl2_redacted.json` — record with `EvidenceAvailability.GOVERNED_REFERENCE`\\n     and redacted hashes (tests redaction handling).\\n   - `cl2_unavailable.json` — record with `EvidenceAvailability.UNAVAILABLE`\\n     and `unavailable_reason` + `reopen_condition` (tests governed tombstone).\\n   - `cl2_duplicate.json` — two records with the same `occurrence_id` (tests\\n     idempotency-key dedup → no-op).\\n2. Each fixture carries `schema_version: \\\"cl.schema.v1\\\"` unless the fixture's\\n   purpose is to test version rejection.\\n\\n---\\n\\n## Phase 6: Hardening + Handoff\\n\\n### Step 9: Negative + property tests (`tests/arnold/critique_ledger/test_cl2_negative.py`)\\n\\n**Scope:** Medium — **Complexity: 3**\\n\\n1. **Create** `tests/arnold/critique_ledger/test_cl2_negative.py` proving:\\n   - **No-mutation**: replay/read operations do not modify the store (row counts,\\n     `event_count`, `last_sequence` unchanged after replay). Use the\\n     `test_zero_write_mutation_gate` pattern — assert no filesystem writes, no\\n     subprocess calls during replay.\\n   - **No-partial-publication**: if a manifest references an occurrence that was\\n     never appended, `publish_manifest` raises and no manifest is visible to\\n     readers.\\n   - **Duplicate no-op**: appending the same occurrence twice returns\\n     `is_duplicate=True`; the store has exactly one event for that idempotency\\n     key.\\n   - **Post-terminal rejection**: after a `COMPLETED`/`FAILED` terminal event,\\n     appending another critique event raises `PostTerminalAppendError`.\\n   - **Monotonic sequence**: appending an event with a regressed sequence raises\\n     `MonotonicSequenceError`.\\n   - **Out-of-order**: appending reconciliation before its referenced occurrence\\n     is admitted (events are independent), but manifest publication fails if the\\n     occurrence is missing.\\n   - **Concurrent**: two writer threads/processes appending to the same\\n     `attempt_id` — one succeeds, the other either deduplicates or raises\\n     `SQLITE_BUSY` (retry handles it). No split-brain.\\n   - **Crash**: simulate a crash mid-transaction (close conn before COMMIT) — on\\n     reopen, the store is consistent (either fully committed or nothing).\\n2. **Load fixtures** from Step 8 to drive corrupt/future-version/unavailable\\n   scenarios.\\n\\n---\\n\\n### Step 10: CL2 handoff document (`docs/critique-ledger/handoffs/cl2-ledger-replay.json`)\\n\\n**Scope:** Small — **Complexity: 2**\\n\\n1. **Create** `docs/critique-ledger/handoffs/cl2-ledger-replay.json` with:\\n   - `schema`: `\\\"cl.handoff.v2\\\"`.\\n   - `api_and_schema_hashes`: SHA-256 of `ledger_serializer.py`,\\n     `critique_ledger_store.py`, `critique_ledger_replay.py`,\\n     `critique_ledger_importer.py`, and the unchanged CL1 schemas.\\n   - `backend_atomicity_decision`: document SQLite WAL + `BEGIN IMMEDIATE` +\\n     shared `store.conn` as the one-transaction substrate; note the\\n     `revision_manifests` and `round_attempts` tables as cross-attempt\\n     projections (no authority).\\n   - `one_time_import_map`: M6 corpus round → occurrence/disposition counts,\\n     classification breakdown, import report hash.\\n   - `replay_hashes`: per-revision and cumulative replay projection hashes\\n     (proves byte-equivalence).\\n   - `fixture_index`: list of all CL2 fixtures with their SHA-256.\\n   - `freshness_rules`: input-set hash, prior-revision hash chain, domain\\n     completeness, WBC receipt refs.\\n   - `open_gates`: the 5 CL1 blockers carried forward (tracked, not resolved).\\n   - `backup_restore_prerequisites`: SQLite WAL checkpoint, `-wal`/`-shm` files,\\n     payload store DB.\\n   - `unresolved_limits`: dual-write is active (CL5 retires it), domain replay\\n     filters in-memory.\\n2. **Create** `tests/arnold/critique_ledger/test_cl2_handoff.py` assertions\\n   (extend Step 1's file or add a `TestCL2HandoffDocument` class) that validate\\n   the CL2 handoff structure and hash freshness.\\n\\n---\\n\\n## Execution Order\\n\\n1. **Step 1** (gate) — confirm the frozen CL1 contract before building on it.\\n2. **Step 2** (serializer) — the pure foundation everything else depends on.\\n3. **Step 3** (schema + occurrence write) — the core persistence path.\\n4. **Step 4** (recon/disposition + manifest) — completes the write path.\\n5. **Step 5** (replay) — proves the write path is correct via byte-equivalence.\\n6. **Step 6** (M6 import) — exercises the full pipeline against real data.\\n7. **Step 7** (dual-write) — compatibility bridge (lower risk, can parallelize).\\n8. **Step 8** (fixtures) — input for negative tests.\\n9. **Step 9** (negative tests) — proves invariants hold under fault.\\n10. **Step 10** (handoff) — documents the result for CL3.\\n\\nSteps 7–8 may be done in parallel with Steps 5–6 since they have no\\ndependencies on the replay/importer implementation.\\n\\n## Validation Order\\n\\n1. **Step 1**: `pytest tests/arnold/critique_ledger/test_cl1_handoff.py tests/arnold/critique_ledger/test_cl2_handoff.py` — precondition gate.\\n2. **Step 2**: `pytest tests/arnold/critique_ledger/test_ledger_serializer.py` — pure unit tests.\\n3. **Steps 3–4**: `pytest tests/arnold/critique_ledger/test_critique_ledger_store.py` — persistence.\\n4. **Step 5**: `pytest tests/arnold/critique_ledger/test_critique_ledger_replay.py tests/arnold/critique_ledger/test_zero_write_mutation_gate.py` — replay + purity.\\n5. **Step 6**: `pytest tests/arnold/critique_ledger/test_m6_importer.py tests/arnold/critique_ledger/test_m6_corpus.py` — import + corpus integrity.\\n6. **Step 7**: `pytest tests/arnold/critique_ledger/test_flag_dual_write.py` — compatibility.\\n7. **Step 9**: `pytest tests/arnold/critique_ledger/test_cl2_negative.py` — hardening.\\n8. **Final**: full `tests/arnold/critique_ledger/` suite — confirm no regressions in existing tests (`test_semantic_loop`, `test_semantic_loop_failures`, `test_policy_tables`, `test_schemas`).\\n\\n## Success Criteria\\n\\n```yaml\\n- criterion: \\\"All existing critique_ledger tests pass (test_cl1_handoff, test_m6_corpus, test_semantic_loop, test_semantic_loop_failures, test_policy_tables, test_schemas, test_zero_write_mutation_gate) with no regressions\\\"\\n  priority: must\\n  requires: [run_tests]\\n- criterion: \\\"CL2 conditional-acceptance gate validates CL1 must-gates pass, schema hashes are fresh, and the 5 open blockers are tracked\\\"\\n  priority: must\\n  requires: [run_tests, read_files]\\n- criterion: \\\"CritiqueLedgerSerializer round-trips all four CL1 record types (occurrence, reconciliation, disposition, manifest) through LedgerEvent.payload and back, with stable idempotency keys\\\"\\n  priority: must\\n  requires: [run_tests]\\n- criterion: \\\"CritiqueLedgerStore appends occurrences/reconciliations/dispositions atomically in one BEGIN IMMEDIATE transaction via the shared store.conn; the start-persistence gate (STARTED event) precedes occurrence append\\\"\\n  priority: must\\n  requires: [run_tests]\\n- criterion: \\\"Terminal persistence failure is surfaced as persistence_failed|indeterminate, never clean success (failure-atomicity-table modes 1-2, 13)\\\"\\n  priority: must\\n  requires: [run_tests]\\n- criterion: \\\"LedgerRevisionManifest is published only after complete occurrence accounting validates; partial publication cannot expose an accepted incomplete revision\\\"\\n  priority: must\\n  requires: [run_tests]\\n- criterion: \\\"Every accepted producer occurrence appears once; duplicate append is a no-op (is_duplicate=True, no second event)\\\"\\n  priority: must\\n  requires: [run_tests]\\n- criterion: \\\"Store-backed replay produces byte-equivalent projections to in-memory replay_full (identical canonical_hash)\\\"\\n  priority: must\\n  requires: [run_tests]\\n- criterion: \\\"Replay issues no model call, subprocess call, or filesystem write (zero-write assertion holds for store-backed replay)\\\"\\n  priority: must\\n  requires: [run_tests]\\n- criterion: \\\"M6 importer preserves all 5 rounds of legacy evidence with zero dropped/failed occurrences, marks unmappable records UNKNOWN (never BACKFILLED from circumstantial evidence), and rejects unsupported schema versions before any write\\\"\\n  priority: must\\n  requires: [run_tests]\\n- criterion: \\\"Negative tests prove ledger/replay cannot mutate plan, gate, lifecycle, queue, Git/provider, delivery, or external-effect state\\\"\\n  priority: must\\n  requires: [run_tests]\\n- criterion: \\\"faults.json remains writable during CL2; dual-write (when enabled) emits a parallel WBC flag-sync event without changing the existing faults.json write path\\\"\\n  priority: must\\n  requires: [run_tests]\\n- criterion: \\\"Per-attempt, round-scoped, domain-bounded, and cumulative replay all return consistent, correctly-scoped subsets\\\"\\n  priority: must\\n  requires: [run_tests]\\n- criterion: \\\"No AttemptEventType enum values are added; all critique records route through existing generic event types via LedgerEvent.payload\\\"\\n  priority: must\\n  requires: [run_tests, read_files]\\n- criterion: \\\"Each new source file is under ~400 lines with single-responsibility functions\\\"\\n  priority: should\\n  requires: [read_files]\\n- criterion: \\\"Fixtures cover all 10 required scenarios (current-source, target-only, future-version, corrupt, redacted, unavailable, duplicate, out-of-order, concurrent, crash)\\\"\\n  priority: should\\n  requires: [read_files, run_tests]\\n- criterion: \\\"CL2 handoff document (cl2-ledger-replay.json) records API/schema hashes, atomicity decision, import map, replay hashes, fixture index, freshness rules, and the 5 carried-forward open gates\\\"\\n  priority: should\\n  requires: [read_files]\\n- criterion: \\\"Concurrent append and crash-reopen consistency tests pass (no split-brain, no half-applied transactions)\\\"\\n  priority: must\\n  requires: [run_tests]\\n```\\n\\n## Questions\\n\\n```yaml\\n- question: \\\"The CL1 handoff is formally not accepted (accepted_for_cl2: false, 5 blockers) but all must-gates pass. Should CL2 treat this as a conditional bridge (proceed, track blockers as open gates) or block until formal acceptance? The plan assumes conditional bridge — is that acceptable?\\\"\\n  impact: \\\"Determines whether Steps 3-10 proceed at all or are deferred indefinitely.\\\"\\n- question: \\\"Should the faults.json dual-write (Step 7) be wired into the existing update_flags_after_critique call site during CL2, or only available as an opt-in hook for explicit CL2 callers? The plan defaults to opt-in (ledger_writer=None preserves existing behavior) to avoid disrupting non-CL2 callers.\\\"\\n  impact: \\\"Determines whether existing megaplan callers need modification or the bridge is purely additive.\\\"\\n- question: \\\"For round_attempts population inside the occurrence append transaction: the outbox's append_event_with_outbox manages its own BEGIN IMMEDIATE/COMMIT. Should CritiqueLedgerStore reimplement the append transaction to include the round_attempts INSERT, or add a transaction-callback hook to the outbox? The plan assumes reimplementation in CritiqueLedgerStore to avoid modifying the frozen outbox API.\\\"\\n  impact: \\\"Determines whether ledger_outbox.py is modified (risky) or critique_ledger_store.py owns its own transaction (safer, more code).\\\"\\n```\\n\\n## Assumptions\\n\\n```yaml\\n- assumption: \\\"CL2 proceeds conditionally against the frozen CL1 schemas and evidence. The 5 CL1 blockers are procedural/infrastructural and do not invalidate the frozen schemas, corpus, oracle, or semantic loop. CL2 tracks them as open gates. If any blocker resolution alters schemas, CL2 scope recalibrates.\\\"\\n- assumption: \\\"Critique domain records serialize through LedgerEvent.payload using existing generic event types (EXTERNAL_EFFECT_INTENT for occurrences, RECONCILIATION for reconciliations, EXTERNAL_EFFECT_OUTCOME for dispositions, EXTERNAL_EFFECT_INTENT for manifests). A discriminator field (critique_record_type) in the payload wrapper makes deserialization unambiguous without overloading event_type semantics or widening the enum.\\\"\\n- assumption: \\\"The revision_manifests and round_attempts tables are separate projections in the same SQLite DB, populated atomically on store.conn. They carry no positive authority — they are rebuildable indexes that enable cross-attempt aggregation without widening attempt_events.\\\"\\n- assumption: \\\"The CritiqueLedgerStore reimplements the append transaction (mirroring outbox's dedup → post-terminal → monotonic → INSERT → COMMIT sequence) to include round_attempts population, rather than modifying the frozen SqliteLedgerOutbox API.\\\"\\n- assumption: \\\"Domain-bounded replay filters in-memory after loading round/cumulative events, because domain cardinality is bounded (2-4 per briefing budget) and domain lives in the occurrence envelope, not a column.\\\"\\n- assumption: \\\"M6 corpus records classify as BACKFILLED (has_authoritative_source=True) because the corpus is frozen and hash-verified. Unmappable records classify as UNKNOWN — never BACKFILLED from circumstantial evidence.\\\"\\n- assumption: \\\"faults.json dual-write is opt-in (ledger_writer=None default). Existing callers and tests are unaffected. The bridge is active only when CL2 explicitly provides a ledger_writer.\\\"\\n```\\n\\n## Changed Surfaces\\n\\n```yaml\\nsource_files_new:\\n  - arnold/critique_ledger/ledger_serializer.py\\n  - arnold/workflow/critique_ledger_store.py\\n  - arnold/workflow/critique_ledger_replay.py\\n  - arnold/workflow/critique_ledger_importer.py\\n\\nsource_files_modified:\\n  - arnold/critique_ledger/__init__.py\\n  - arnold/critique_ledger/schemas.py\\n  - arnold_pipelines/megaplan/flags.py\\n\\ntest_files_new:\\n  - tests/arnold/critique_ledger/test_cl2_handoff.py\\n  - tests/arnold/critique_ledger/test_ledger_serializer.py\\n  - tests/arnold/critique_ledger/test_critique_ledger_store.py\\n  - tests/arnold/critique_ledger/test_critique_ledger_replay.py\\n  - tests/arnold/critique_ledger/test_m6_importer.py\\n  - tests/arnold/critique_ledger/test_flag_dual_write.py\\n  - tests/arnold/critique_ledger/test_cl2_negative.py\\n\\ntest_files_modified:\\n  - tests/arnold/critique_ledger/test_cl1_handoff.py\\n\\nfixtures_new:\\n  - tests/fixtures/critique_ledger/cl2_current_source.json\\n  - tests/fixtures/critique_ledger/cl2_target_only.json\\n  - tests/fixtures/critique_ledger/cl2_future_version.json\\n  - tests/fixtures/critique_ledger/cl2_corrupt.json\\n  - tests/fixtures/critique_ledger/cl2_redacted.json\\n  - tests/fixtures/critique_ledger/cl2_unavailable.json\\n  - tests/fixtures/critique_ledger/cl2_duplicate.json\\n\\ndocs_new:\\n  - docs/critique-ledger/handoffs/cl2-ledger-replay.json\\n```\\n\\n## Test Blast Radius\\n\\n```json\\n{\\n  \\\"strategy\\\": \\\"scoped\\\",\\n  \\\"confidence\\\": \\\"high\\\",\\n  \\\"selectors\\\": [\\n    {\\n      \\\"kind\\\": \\\"path\\\",\\n      \\\"value\\\": \\\"tests/arnold/critique_ledger/\\\",\\n      \\\"reason\\\": \\\"All CL2 tests (new and existing) live here; covers serializer, store, replay, importer, negative, handoff, and the existing semantic_loop/policy/schemas/corpus suites that must not regress\\\"\\n    },\\n    {\\n      \\\"kind\\\": \\\"path\\\",\\n      \\\"value\\\": \\\"tests/arnold/workflow/test_attempt_ledger_store.py\\\",\\n      \\\"reason\\\": \\\"CritiqueLedgerStore depends on SqliteAttemptLedgerStore; verify the shared-conn and _append_tx invariants are not disrupted\\\"\\n    },\\n    {\\n      \\\"kind\\\": \\\"path\\\",\\n      \\\"value\\\": \\\"tests/arnold/workflow/test_ledger_outbox.py\\\",\\n      \\\"reason\\\": \\\"CritiqueLedgerStore mirrors the outbox transaction pattern; verify outbox behavior is unchanged\\\"\\n    },\\n    {\\n      \\\"kind\\\": \\\"path\\\",\\n      \\\"value\\\": \\\"tests/arnold/workflow/test_ledger_payload_store.py\\\",\\n      \\\"reason\\\": \\\"Occurrence evidence routes through SqliteLedgerPayloadStore; verify boundary enforcement is unchanged\\\"\\n    },\\n    {\\n      \\\"kind\\\": \\\"path\\\",\\n      \\\"value\\\": \\\"tests/arnold/workflow/test_ledger_migrations.py\\\",\\n      \\\"reason\\\": \\\"M6 importer uses LegacyClassification; verify classification safety is not disrupted\\\"\\n    }\\n  ],\\n  \\\"changed_surfaces\\\": [\\n    \\\"arnold/critique_ledger/ledger_serializer.py\\\",\\n    \\\"arnold/critique_ledger/__init__.py\\\",\\n    \\\"arnold/critique_ledger/schemas.py\\\",\\n    \\\"arnold/workflow/critique_ledger_store.py\\\",\\n    \\\"arnold/workflow/critique_ledger_replay.py\\\",\\n    \\\"arnold/workflow/critique_ledger_importer.py\\\",\\n    \\\"arnold_pipelines/megaplan/flags.py\\\",\\n    \\\"tests/arnold/critique_ledger/test_cl1_handoff.py\\\",\\n    \\\"tests/arnold/critique_ledger/test_cl2_handoff.py\\\",\\n    \\\"tests/arnold/critique_ledger/test_ledger_serializer.py\\\",\\n    \\\"tests/arnold/critique_ledger/test_critique_ledger_store.py\\\",\\n    \\\"tests/arnold/critique_ledger/test_critique_ledger_replay.py\\\",\\n    \\\"tests/arnold/critique_ledger/test_m6_importer.py\\\",\\n    \\\"tests/arnold/critique_ledger/test_flag_dual_write.py\\\",\\n    \\\"tests/arnold/critique_ledger/test_cl2_negative.py\\\"\\n  ],\\n  \\\"always_run\\\": [\\n    \\\"tests/arnold/critique_ledger/test_semantic_loop.py\\\",\\n    \\\"tests/arnold/critique_ledger/test_semantic_loop_failures.py\\\",\\n    \\\"tests/arnold/critique_ledger/test_policy_tables.py\\\",\\n    \\\"tests/arnold/critique_ledger/test_schemas.py\\\",\\n    \\\"tests/arnold/critique_ledger/test_m6_corpus.py\\\"\\n  ],\\n  \\\"full_suite_fallback\\\": true,\\n  \\\"rationale\\\": \\\"CL2 adds new persistence/replay/import modules that depend on the WBC store layer and the frozen CL1 schemas. The scoped baseline covers all critique_ledger tests (the primary blast radius) plus the workflow store tests that the new code depends on. The existing semantic_loop/policy/schemas/corpus suites are always-run because they are the frozen contract CL2 must not break. Full suite fallback catches any cross-cutting regression.\\\",\\n  \\\"import_graph\\\": {\\n    \\\"degraded\\\": false,\\n    \\\"dependent_tests\\\": 0,\\n    \\\"unresolved\\\": []\\n  }\\n}\\n```\\n\"}"

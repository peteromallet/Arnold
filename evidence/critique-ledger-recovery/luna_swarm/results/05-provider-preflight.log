   150	class ConfirmationManager:
   151	    """Exact-phrase confirmation guard for high-impact resident actions."""
   152	
   153	    def __init__(self, config: ResidentConfig) -> None:
   154	        self.config = config
   155	        self._pending: dict[str, ConfirmationRequest] = {}
   156	
   157	    def required_for(self, action: ActionKind) -> bool:
   158	        if action == "cloud_start":
   159	            return self.config.require_cloud_start_confirmation
   160	        return action in CONFIRMED_HIGH_IMPACT_ACTIONS
   161	
   162	    def request_confirmation(
   163	        self,
   164	        *,
   165	        subject: AuthorizationSubject,
   166	        action: ActionKind,
   167	        target_summary: str,
   168	        metadata: JSONDict | None = None,
   169	        now: datetime | None = None,
   170	    ) -> ConfirmationRequest:
   171	        created_at = _aware_now(now)
   172	        seed = f"{subject.user_id}:{action}:{target_summary}:{created_at.isoformat()}:{secrets.token_hex(4)}"
   173	        request_id = hashlib.sha256(seed.encode("utf-8")).hexdigest()[:16]
   174	        exact_phrase = f"confirm {action} {request_id}"
   175	        if action == "cloud_start":
   176	            exact_phrase = f"{exact_phrase} {target_summary}"
   177	        request = ConfirmationRequest(
   178	            id=request_id,
   179	            subject=subject,
   180	            action=action,
   181	            target_summary=target_summary,
   182	            exact_phrase=exact_phrase,
   183	            expires_at=created_at + timedelta(seconds=self.config.confirmation_expiry_s),
   184	            metadata=dict(metadata or {}),
   185	            created_at=created_at,
   186	        )
   187	        self._pending[request.id] = request
   188	        return request
   189	
   190	    def confirm(
   191	        self,
   192	        *,
   193	        request_id: str,
   194	        subject: AuthorizationSubject,
   195	        phrase: str,
   196	        now: datetime | None = None,
   197	    ) -> ConfirmationDecision:
   198	        request = self._pending.get(request_id)
   199	        if request is None:
   200	            return ConfirmationDecision("denied", False, request_id=request_id, reason="confirmation_not_found")
   201	        current = _aware_now(now)
   202	        if request.expires_at <= current:
   203	            self._pending.pop(request_id, None)
   204	            return ConfirmationDecision("expired", False, request_id=request_id, reason="confirmation_expired")
   205	        if request.subject.user_id != subject.user_id:
   206	            return ConfirmationDecision("denied", False, request_id=request_id, reason="confirmation_user_mismatch")
   207	        if phrase.strip() != request.exact_phrase:
   208	            return ConfirmationDecision("denied", False, request_id=request_id, reason="confirmation_phrase_mismatch")
   209	        self._pending.pop(request_id, None)
   210	        return ConfirmationDecision("approved", True, request_id=request_id)
   211	
   212	    def expire_due(self, *, now: datetime | None = None) -> list[ConfirmationRequest]:
   213	        current = _aware_now(now)
   214	        expired = [request for request in self._pending.values() if request.expires_at <= current]
   215	        for request in expired:
   216	            self._pending.pop(request.id, None)
   217	        return sorted(expired, key=lambda request: (request.expires_at, request.id))
   218	
   219	    def pending(self) -> tuple[ConfirmationRequest, ...]:
   220	        return tuple(sorted(self._pending.values(), key=lambda request: (request.expires_at, request.id)))
   221	

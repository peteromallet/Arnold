    97	
    98	def progress_kind_for_classification(classification: CloudClassification) -> str:
    99	    if classification == "completed":
   100	        return "plan_done"
   101	    if classification == "failed":
   102	        return "plan_failed"
   103	    if classification == "gate-needed":
   104	        return "gate_pending"
   105	    if classification == "blocked":
   106	        return "execution_blocked"
   107	    if classification == "running":
   108	        return "phase_start"
   109	    return "phase_end"

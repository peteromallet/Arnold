   265	            key=credential.broker_auth,
   266	            base_url=credential.base_url,
   267	            expires_at=credential.expires_at,
   268	        )
   269	        return credential.broker_auth
   270	
   271	    def _get_api_credential_unlocked(self, env_var: str, hermes_env: dict[str, str] | None = None) -> str:
   272	        source = hermes_env if hermes_env is not None else self._hermes_env

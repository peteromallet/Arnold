  3323	def _watchdog_tracking_verification_command(ctx: ChainLaunchContext) -> str:
  3324	    script = f"""
  3325	import json, pathlib, sys
  3326	marker_path = pathlib.Path({ctx.marker_path!r})
  3327	workspace = pathlib.Path({ctx.workspace!r})
  3328	remote_spec = pathlib.Path({ctx.remote_spec_path!r})
  3329	session = {ctx.session_name!r}
  3330	identity_digest = {ctx.digest!r}
  3331	checks = {{
  3332	    "marker_path": str(marker_path),
  3333	    "workspace": str(workspace),
  3334	    "remote_spec": str(remote_spec),
  3335	    "session": session,
  3336	    "marker_present": marker_path.is_file(),
  3337	    "workspace_present": workspace.is_dir(),
  3338	    "spec_present": remote_spec.is_file(),
  3339	    "tracked": False,
  3340	    "errors": [],
  3341	}}
  3342	payload = {{}}
  3343	if not checks["marker_present"]:
  3344	    checks["errors"].append("marker missing")
  3345	else:
  3346	    try:
  3347	        payload = json.loads(marker_path.read_text())
  3348	    except Exception as exc:
  3349	        checks["errors"].append(f"marker unreadable: {{exc}}")
  3350	if payload:
  3351	    for key, expected in {{
  3352	        "session": session,
  3353	        "workspace": str(workspace),
  3354	        "remote_spec": str(remote_spec),
  3355	        "identity_digest": identity_digest,
  3356	    }}.items():
  3357	        if payload.get(key) != expected:
  3358	            checks["errors"].append(f"marker {{key}}={{payload.get(key)!r}} expected {{expected!r}}")
  3359	if not checks["workspace_present"]:
  3360	    checks["errors"].append("workspace missing")
  3361	if not checks["spec_present"]:
  3362	    checks["errors"].append("remote_spec missing")
  3363	checks["tracked"] = not checks["errors"]
  3364	print(json.dumps(checks, sort_keys=True))
  3365	sys.exit(0 if checks["tracked"] else 1)
  3366	"""
  3367	    return f"python3 - <<'MEGAPLAN_WATCHDOG_TRACKING'\n{script.strip()}\nMEGAPLAN_WATCHDOG_TRACKING"
  3368	
  3369	
  3370	def _run_watchdog_tracking_verification(provider, ctx: ChainLaunchContext) -> dict[str, Any]:
  3371	    result = provider.ssh_exec(_watchdog_tracking_verification_command(ctx))
  3372	    raw = (result.stdout or "").strip().splitlines()
  3373	    try:
  3374	        payload = json.loads(raw[-1] if raw else "{}")
  3375	    except json.JSONDecodeError as exc:
  3376	        payload = {
  3377	            "tracked": False,
  3378	            "errors": [f"tracking verification output was not JSON: {exc}"],
  3379	            "raw": result.stdout,
  3380	        }
  3381	    if result.returncode != 0:
  3382	        payload.setdefault("tracked", False)
  3383	        if result.stderr:
  3384	            payload.setdefault("errors", []).append(result.stderr.strip())
  3385	    payload["status"] = "tracked" if payload.get("tracked") else "not_tracked"

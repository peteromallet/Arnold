   309	def list_available_providers() -> list[dict[str, str]]:
   310	    """Return info about all providers the user could use with ``provider:model``.
   311	
   312	    Each dict has ``id``, ``label``, and ``aliases``.
   313	    Checks which providers have valid credentials configured.
   314	    """
   315	    # Canonical providers in display order
   316	    _PROVIDER_ORDER = [
   317	        "openrouter", "nous", "openai-codex", "copilot", "copilot-acp",
   318	        "zai", "kimi-coding", "minimax", "minimax-cn", "kilocode", "anthropic", "alibaba",
   319	        "opencode-zen", "opencode-go",
   320	        "ai-gateway", "deepseek", "fireworks", "custom",
   321	    ]
   322	    # Build reverse alias map
   323	    aliases_for: dict[str, list[str]] = {}
   324	    for alias, canonical in _PROVIDER_ALIASES.items():
   325	        aliases_for.setdefault(canonical, []).append(alias)
   326	
   327	    result = []
   328	    for pid in _PROVIDER_ORDER:
   329	        label = _PROVIDER_LABELS.get(pid, pid)
   330	        alias_list = aliases_for.get(pid, [])
   331	        # Check if this provider has credentials available
   332	        has_creds = False
   333	        try:
   334	            from arnold.agent.hermes_cli.auth import get_auth_status, has_usable_secret
   335	            if pid == "custom":
   336	                custom_base_url = _get_custom_base_url() or os.getenv("OPENAI_BASE_URL", "")
   337	                has_creds = bool(custom_base_url.strip())
   338	            elif pid == "openrouter":
   339	                has_creds = has_usable_secret(os.getenv("OPENROUTER_API_KEY", ""))
   340	            else:
   341	                status = get_auth_status(pid)
   342	                has_creds = bool(status.get("logged_in") or status.get("configured"))
   343	        except Exception:
   344	            pass
   345	        result.append({
   346	            "id": pid,
   347	            "label": label,
   348	            "aliases": alias_list,
   349	            "authenticated": has_creds,
   350	        })
   351	    return result

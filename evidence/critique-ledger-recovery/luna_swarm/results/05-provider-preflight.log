dger-m9-glm-20260723/Arnold/tests/arnold/conformance/test_deleted_surfaces.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/conformance/test_conformance_gates.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/conformance/test_platform_e2e.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/conformance/test_checks.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/conformance/test_legacy_reference_allowlist.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/conformance/__init__.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/runtime/test_errors_outcome.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/runtime/test_event_journal.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/runtime/test_resume.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/runtime/test_run_envelope.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/runtime/test_semantic_replay.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/runtime/durable_ops/test_operation_runs.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/runtime/durable_ops/test_broker_approval.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/fixtures/workflow_authoring/invalid_multiple_workflows.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/conformance/workflow_manifest_runtime/test_identity_trust_map_contract.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/conformance/workflow_manifest_runtime/test_conformance_boundaries.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/conformance/workflow_manifest_runtime/test_existing_behavioral_goldens.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/agent/test_run_agent_query_file.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/agent/test_deepseek_adapter.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/agent/test_context_compressor.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/agent/test_codex_adapter.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/agent/test_shannon_adapter.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/agent/test_contracts.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/kernel/test_artifacts.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/kernel/test_governor.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/agent/test_providers.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/agent/test_import_boundaries.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/agent/__init__.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/kernel/test_artifact_store.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/kernel/test_events_replay.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/conformance/workflow_manifest_runtime/test_golden_regression_rule.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/conformance/workflow_manifest_runtime/test_neutral_import_boundaries.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/conformance/workflow_manifest_runtime/test_manifest_shape_contract.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/agent/test_auxiliary_client.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/fixtures/workflow_authoring/invalid_wrong_component_kind.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/kernel/test_replay.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/kernel/test_suspension.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/arnold/kernel/test_journal.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/boundary/test_import_leak.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/fixtures/workflow_authoring/invalid_malformed_call.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/fixtures/workflow_authoring/invalid_intrinsic_unknown_keyword.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/boundary/test_deliberation_import_leak.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/fixtures/workflow_authoring/invalid_intrinsic_wrong_keyword_set.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/boundary/__init__.py", "/workspace/critique-ledger-m9-glm-20260723/Arnold/tests/fixtures/workflow_authoring/invalid_runtime_truthiness.py"], "truncated": true}
./critique-ledger-m9-planner-prompt.txt:480:{"content": "     1|\"\"\"Frozen side-effect-free v1 dataclasses for the Critique Ledger domain.\n     2|\n     3|Defines the complete type system for critique occurrence, reconciliation,\n     4|disposition, briefing, and manifest records. All dataclasses are frozen\n     5|and provide canonical to_dict/from_dict with strict/preserve modes.\n     6|\"\"\"\n     7|\n     8|from __future__ import annotations\n     9|\n    10|import hashlib\n    11|import json\n    12|from dataclasses import dataclass, field\n    13|from enum import Enum\n    14|from typing import Any, Optional\n    15|\n    16|# ══════════════════════════════════════════════════════════════════════\n    17|# Enums\n    18|# ══════════════════════════════════════════════════════════════════════\n    19|\n    20|\n    21|class ContextMode(str, Enum):\n    22|    \"\"\"Whether a critique was produced blind or with history awareness.\"\"\"\n    23|\n    24|    BLIND = \"BLIND\"\n    25|    HISTORY_AWARE = \"HISTORY_AWARE\"\n    26|\n    27|\n    28|class ParseStatus(str, Enum):\n    29|    \"\"\"Outcome of parsing a critique producer output.\"\"\"\n    30|\n    31|    SELECTED = \"SELECTED\"\n    32|    COMPLETED = \"COMPLETED\"\n    33|    FAILED = \"FAILED\"\n    34|    DROPPED = \"DROPPED\"\n    35|    MALFORMED = \"MALFORMED\"\n    36|    TOMBSTONED = \"TOMBSTONED\"\n    37|    NO_ADDITIONAL_FINDINGS = \"NO_ADDITIONAL_FINDINGS\"\n    38|\n    39|\n    40|class EvidenceAvailability(str, Enum):\n    41|    \"\"\"Availability classification for critique evidence artifacts.\"\"\"\n    42|\n    43|    RETAINED = \"RETAINED\"\n    44|    GOVERNED_REFERENCE = \"GOVERNED_REFERENCE\"\n    45|    UNAVAILABLE = \"UNAVAILABLE\"\n    46|\n    47|\n    48|class Relationship(str, Enum):\n    49|    \"\"\"Semantic relationship between two findings, supplied by evaluator\n    50|    reconciliation events. Never inferred by deterministic code.\"\"\"\n    51|\n    52|    DUPLICATE = \"DUPLICATE\"\n    53|    SUPERSEDED = \"SUPERSEDED\"\n    54|    REGRESSION = \"REGRESSION\"\n    55|    REFINEMENT = \"REFINEMENT\"\n    56|    SPLIT = \"SPLIT\"\n    57|    REOPEN = \"REOPEN\"\n    58|    BLOCKS = \"BLOCKS\"\n    59|    BLOCKED_BY = \"BLOCKED_BY\"\n    60|\n    61|\n    62|class Authority(str, Enum):\n    63|    \"\"\"Authority class for a disposition or reconciliation decision.\"\"\"\n    64|\n    65|    EVALUATOR = \"EVALUATOR\"\n    66|    CURATOR_PROPOSAL = \"CURATOR_PROPOSAL\"\n    67|    MANUAL = \"MANUAL\"\n    68|\n    69|\n    70|class CompatibilityProfile(str, Enum):\n    71|    \"\"\"Schema compatibility profile for version-aware validation.\"\"\"\n    72|\n    73|    V1_STRICT = \"v1_strict\"\n    74|    V1_PRESERVE = \"v1_preserve\"\n    75|\n    76|\n    77|class DispositionFamily(str, Enum):\n    78|    \"\"\"Eight canonical disposition families with orthogonal severity,\n    79|    reason subcodes, action/non-action, accountable scope, and reopen\n    80|    predicates.\"\"\"\n    81|\n    82|    ACTED_ON = \"acted-on\"\n    83|    IGNORED = \"ignored\"\n    84|    DEFERRED = \"deferred\"\n    85|    REJECTED = \"rejected\"\n    86|    DUPLICATE = \"duplicate\"\n    87|    ACCEPTED_RISK = \"accepted-risk\"\n    88|    UNKNOWN = \"unknown\"\n    89|    RESOLVED = \"resolved\"\n    90|\n    91|\n    92|# ══════════════════════════════════════════════════════════════════════\n    93|# Schema version constants\n    94|# ══════════════════════════════════════════════════════════════════════\n    95|\n    96|SCHEMA_VERSION = \"cl.schema.v1\"\n    97|SUPPORTED_VERSIONS = {SCHEMA_VERSION}\n    98|\n    99|# ══════════════════════════════════════════════════════════════════════\n   100|# Hashing helpers\n   101|# ══════════════════════════════════════════════════════════════════════\n   102|\n   103|\n   104|def _freeze_value(value: Any) -> Any:\n   105|    \"\"\"Recursively freeze a value for deterministic hashing.\n   106|\n   107|    Lists/tuples become tuples of frozen elements.\n   108|    Dicts become sorted tuples of (key, frozen_value) pairs.\n   109|    Enums become their string values.\n   110|    \"\"\"\n   111|    if isinstance(value, Enum):\n   112|        return value.value\n   113|    if isinstance(value, dict):\n   114|        return tuple(\n   115|            sorted((str(k), _freeze_value(v)) for k, v in value.items())\n   116|        )\n   117|    if isinstance(value, (list, tuple)):\n   118|        return tuple(_freeze_value(v) for v in value)\n   119|    if isinstance(value, set):\n   120|        return tuple(sorted(_freeze_value(v) for v in value))\n   121|", "total_lines": 731, "file_size": 30687, "truncated": true, "hint": "Use offset=121 to continue reading (showing 1-120 of 731 lines)", "is_binary": false, "is_image": false}
./critique-ledger-m9-planner-prompt.txt:483:{"content": "     1|\"\"\"Execution attempt ledger schema for workflow boundary contracts.\n     2|\n     3|This module freezes the ``ExecutionAttemptLedger`` schema contract under\n     4|``arnold.workflow``. It defines the identity, ordering, provenance, and\n     5|append-position core of ordered attempt history for every supported runtime.\n     6|\n     7|Each attempt records:\n     8|\n     9|* Immutable workflow/run/graph-revision, step/boundary, invocation,\n    10|  attempt ordinal/id.\n    11|* Parent/causal lineage and actor/tool provenance.\n    12|* Runtime adapter identity and code/config/template version anchoring.\n    13|* Grant/decision references from Run Authority.\n    14|* Monotonic per-attempt sequence, causal predecessor, and durable append\n    15|  position.\n    16|* Idempotency key for each event.\n    17|* Occurred and observed timestamps (clocks alone never establish ordering).\n    18|\n    19|Required event types: started, completed, failed, retry_scheduled, suspended,\n    20|resumed, cancelled, external_effect_intent, external_effect_outcome,\n    21|persistence_failed, reconciliation.\n    22|\n    23|Ledger events carry typed payload references for the following semantic\n    24|categories (each with inline data, durable ref, content digest, and\n    25|schema version):\n    26|\n    27|* ``InputPayload`` — declared inputs to a step/boundary.\n    28|* ``OutputPayload`` — declared outputs from a step/boundary.\n    29|* ``ResultPayload`` — phase/scalar result payloads.\n    30|* ``VerdictPayload`` — semantic-health verdicts and audit judgments.\n    31|* ``StateDeltaPayload`` — expected/observed state deltas for a boundary.\n    32|* ``ArtifactPayload`` — artifact handoff and promotion payloads.\n    33|* ``CheckpointPayload`` — resume anchors and in-progress witnesses.\n    34|* ``AuthorityPayload`` — authority decisions, grants, and transition intents.\n    35|* ``ExternalEffectPayload`` — pre-effect intent and outcome evidence for\n    36|  external side effects.\n    37|\n    38|Persistence-failure and reconciliation diagnostics are captured via:\n    39|\n    40|* ``PersistenceFailureDiagnostic`` — failure mode, recovery evidence spool\n    41|  reference, quarantined authority advance indicator, and observed error.\n    42|* ``ReconciliationDiagnostic`` — reconciliation target (the failed event),\n    43|  outcome, recovered evidence refs, and explicit authority disposition.\n    44|\n    45|This is schema-only — no I/O, mutation, or runtime effects.\n    46|\n    47|.. _ledger-primitive-gaps:\n    48|\n    49|Current Primitive Gaps\n    50|----------------------\n    51|\n    52|The following gaps exist in the current ledger primitives and must be\n    53|addressed by future C2-C6 migration work. They are documented here so\n    54|consumers and reviewers do not mistake their absence for design intent.\n    55|\n    56|NDJSON Sequence Gaps\n    57|~~~~~~~~~~~~~~~~~~~~\n    58|\n    59|The current ``LedgerPosition`` uses integer ``sequence`` and\n    60|``append_position`` fields. These are not backed by a real persistent\n    61|sequence generator. When the ledger is materialized to NDJSON storage\n    62|(one JSON object per line, appended), sequence gaps can arise from:\n    63|\n    64|1. **Append-without-flush**: A runtime writes an event to NDJSON but\n    65|   crashes before the fsync/close. The file may contain a truncated\n    66|   line or a partial write at EOF. The next restart sees the gap but\n    67|   has no durable record of whether the event was fully committed.\n    68|\n    69|2. **Concurrent append races**: If two runtime instances share the same\n    70|   NDJSON file without a file-level lock or append-index coordination,\n    71|   interleaved writes can produce unparseable lines and apparent\n    72|   sequence gaps.\n    73|\n    74|3. **Rotated/missing segment files**: If the NDJSON log is rotated\n    75|   (e.g., by logrotate or a retention job) without updating the\n    76|   ledger's segment manifest, events in the rotated segment appear\n    77|   missing, producing a sequence gap.\n    78|\n    79|**Mitigation path (C4-C5)**: Replace bare NDJSON appends with a\n    80|write-ahead log (WAL) or append-blob store that provides atomic\n    81|append-with-checksum, segment manifests, and gap-detection on open.\n    82|Until then, consumers MUST treat sequence gaps as ``indeterminate``\n    83|and MUST NOT silently skip them.\n    84|\n    85|Missing Transaction / Outbox Migration\n    86|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n    87|\n    88|The North Star mandates that internal state/result publication uses\n    89|one transaction where the store permits, or a durable outbox /\n    90|prepare-commit protocol with deterministic reconciliation. The current\n    91|ledger schema has no representation for:\n    92|\n    93|1. **Transaction boundaries**: There is no ``transaction_begin`` /\n    94|   ``transaction_commit`` / ``transaction_abort`` event type. The\n    95|   ledger cannot express that a group of events were written atomically.\n    96|\n    97|2. **Outbox records**: There is no ``OutboxRecord`` type linking a\n    98|   ledger event to an outbox message that must be delivered to a\n    99|   downstream consumer. The outbox pattern (write event + outbox message\n   100|   in one transaction, then deliver from outbox) is not modeled.\n   101|\n   102|3. **Prepare-commit protocol**: There is no ``prepare`` / ``commit`` /\n   103|   ``rollback`` event vocabulary for two-phase commit across the ledger\n   104|   and an external store.\n   105|\n   106|**Mitigation path (C4-C6)**: Add ``transaction_begin``,\n   107|``transaction_commit``, and ``transaction_abort`` event types. Add an\n   108|``OutboxRecord`` dataclass with message identity, delivery target,\n   109|idempotency key, and delivery status. Add ``prepare`` and ``commit``\n   110|event types for two-phase scenarios. Until then, consumers MUST treat\n   111|every ledger event as independently durable and MUST NOT assume\n   112|atomicity across events.\n   113|\"\"\"\n   114|\n   115|from __future__ import annotations\n   116|\n   117|import hashlib\n   118|import re\n   119|import uuid\n   120|from dataclasses import dataclass, field\n   121|from enum import StrEnum\n   122|from types import MappingProxyType\n   123|from typing import Any, Mapping, Sequence\n   124|\n   125|from arnold.workflow.durable_refs import DurableRef\n   126|\n   127|\n   128|# ── Digest helpers (shared with durable_refs) ──────────────────────────────\n   129|\n   130|_DIGEST_RE = re.compile(r\"^sha256:[0-9a-f]{64}$\")\n   131|\n   132|\n   133|def _require_digest(value: str) -> str:\n   134|    \"\"\"Validate a canonical digest string.\"\"\"\n   135|    if not isinstance(value, str) or not _DIGEST_RE.fullmatch(value):\n   136|        raise ValueError(\n   137|            f\"digest must be 'sha256:' followed by 64 lowercase hex chars, \"\n   138|            f\"got {value!r}\"\n   139|        )\n   140|    return value\n   141|\n   142|\n   143|# ── Enums ─────────────────────────────────────────────────────────────────\n   144|\n   145|\n   146|class AttemptEventType(StrEnum):\n   147|    \"\"\"Stable event types for the execution attempt ledger.\n   148|\n   149|    These cover the full lifecycle of a supported attempt from dispatch\n   150|    through terminal outcome, including external effects and persistence\n   151|    failure states.\n   152|    \"\"\"\n   153|\n   154|    STARTED = \"started\"\n   155|    COMPLETED = \"completed\"\n   156|    FAILED = \"failed\"\n   157|    RETRY_SCHEDULED = \"retry_scheduled\"\n   158|    SUSPENDED = \"suspended\"\n   159|    RESUMED = \"resumed\"\n   160|    CANCELLED = \"cancelled\"\n   161|    EXTERNAL_EFFECT_INTENT = \"external_effect_intent\"\n   162|    EXTERNAL_EFFECT_OUTCOME = \"external_effect_outcome\"\n   163|    PERSISTENCE_FAILED = \"persistence_failed\"\n   164|    RECONCILIATION = \"reconciliation\"\n   165|\n   166|\n   167|class AttemptOutcome(StrEnum):\n   168|    \"\"\"Terminal outcome of an execution attempt.\"\"\"\n   169|\n   170|    SUCCEEDED = \"succeeded\"\n   171|    FAILED = \"failed\"\n   172|    INDETERMINATE = \"indeterminate\"\n   173|    CANCELLED = \"cancelled\"\n   174|\n   175|\n   176|class AdapterKind(StrEnum):\n   177|    \"\"\"Runtime adapter kind for execution attempts.\"\"\"\n   178|\n   179|    NATIVE = \"arnold.pipeline.native\"\n   180|    MEGAPLAN_PHASE = \"megaplan.phase\"\n   181|    MEGAPLAN_REDUCER = \"megaplan.reducer\"\n   182|    MEGAPLAN_CHAIN = \"megaplan.chain\"\n   183|    MEGAPLAN_AUDITOR = \"megaplan.auditor\"\n   184|    MEGAPLAN_CLOUD_REPAIR = \"megaplan.cloud_repair\"\n   185|    MEGAPLAN_VERIFICATION = \"megaplan.verification\"\n   186|\n   187|\n   188|class PersistenceStatus(StrEnum):\n   189|    \"\"\"Persistence status for a ledger event or attempt.\"\"\"\n   190|\n   191|    DURABLE = \"durable\"\n   192|    PERSISTENCE_FAILED = \"persistence_failed\"\n   193|    INDETERMINATE = \"indeterminate\"\n   194|\n   195|\n   196|# ── Schema version constants ──────────────────────────────────────────────\n   197|\n   198|LEDGER_SCHEMA_VERSION: str = \"arnold.workflow.execution_attempt_ledger.v1\"\n   199|\n   200|# The set of event types that represent terminal attempt states.\n   201|_TERMINAL_EVENT_TYPES: frozenset[AttemptEventType] = frozenset(\n   202|    {\n   203|        AttemptEventType.COMPLETED,\n   204|        AttemptEventType.FAILED,\n   205|        AttemptEventType.CANCELLED,\n   206|    }\n   207|)\n   208|\n   209|# Lifecycle ordering: which event types must precede others.\n   210|# Each entry maps an event type to the set of event types that MUST have\n   211|# occurred before it in the same attempt stream.\n   212|_LIFECYCLE_PRECEDENCE: Mapping[AttemptEventType, frozenset[AttemptEventType]] = (\n   213|    MappingProxyType(\n   214|        {\n   215|            AttemptEventType.STARTED: frozenset(),\n   216|            AttemptEventType.COMPLETED: frozenset({AttemptEventType.STARTED}),\n   217|            AttemptEventType.FAILED: frozenset({AttemptEventType.STARTED}),\n   218|            AttemptEventType.RETRY_SCHEDULED: frozenset({AttemptEventType.STARTED}),\n   219|            AttemptEventType.SUSPENDED: frozenset({AttemptEventType.STARTED}),\n   220|            AttemptEventType.RESUMED: frozenset({AttemptEventType.SUSPENDED}),\n   221|", "total_lines": 1460, "file_size": 54228, "truncated": true, "hint": "Use offset=221 to continue reading (showing 1-220 of 1460 lines)", "is_binary": false, "is_image": false}
./critique-ledger-m9-planner-prompt.txt:512:{"content": "   400|@dataclass(frozen=True)\n   401|class AuthorityPayload(_TypedPayloadBase):\n   402|    \"\"\"Typed payload for authority decisions, grants, and transition intents.\n   403|\n   404|    Schema: ``arnold.workflow.ledger.authority_payload.v1``\n   405|    \"\"\"\n   406|\n   407|    schema_version: str = PayloadSchemaVersion.AUTHORITY_V1.value\n   408|\n   409|\n   410|@dataclass(frozen=True)\n   411|class ExternalEffectPayload(_TypedPayloadBase):\n   412|    \"\"\"Typed payload for pre-effect intent and outcome evidence.\n   413|\n   414|    Schema: ``arnold.workflow.ledger.external_effect_payload.v1``\n   415|    \"\"\"\n   416|\n   417|    schema_version: str = PayloadSchemaVersion.EXTERNAL_EFFECT_V1.value\n   418|\n   419|\n   420|# ── Identity ──────────────────────────────────────────────────────────────\n   421|\n   422|\n   423|@dataclass(frozen=True)\n   424|class AttemptIdentity:\n   425|    \"\"\"Immutable identity for a single execution attempt.\n   426|\n   427|    This is the composite key that uniquely identifies one attempt within\n   428|    a workflow run. The graph_revision pins the exact topology/manifest\n   429|    revision under which this attempt was dispatched.\n   430|    \"\"\"\n   431|\n   432|    workflow_id: str\n   433|    run_id: str\n   434|    graph_revision: str\n   435|    step_id: str | None = None\n   436|    boundary_id: str | None = None\n   437|    invocation_id: str | None = None\n   438|    attempt_ordinal: int = 1\n   439|    attempt_id: str = field(default_factory=lambda: str(uuid.uuid4()))\n   440|\n   441|    def __post_init__(self) -> None:\n   442|        if not self.workflow_id.strip():\n   443|            raise ValueError(\"AttemptIdentity.workflow_id must be non-empty\")\n   444|        if not self.run_id.strip():\n   445|            raise ValueError(\"AttemptIdentity.run_id must be non-empty\")\n   446|        if not self.graph_revision.strip():\n   447|            raise ValueError(\"AttemptIdentity.graph_revision must be non-empty\")\n   448|        if self.attempt_ordinal < 1:\n   449|            raise ValueError(\n   450|                f\"AttemptIdentity.attempt_ordinal must be >= 1, \"\n   451|                f\"got {self.attempt_ordinal}\"\n   452|            )\n   453|        if not self.attempt_id.strip():\n   454|            raise ValueError(\"AttemptIdentity.attempt_id must be non-empty\")\n   455|        # Validate attempt_id is a valid UUID.\n   456|        try:\n   457|            uuid.UUID(self.attempt_id)\n   458|        except (ValueError, AttributeError):\n   459|            raise ValueError(\n   460|                f\"AttemptIdentity.attempt_id must be a valid UUID, \"\n   461|                f\"got {self.attempt_id!r}\"\n   462|            )\n   463|\n   464|    @property\n   465|    def is_boundary_scoped(self) -> bool:\n   466|        \"\"\"True when this attempt is scoped to a specific boundary.\"\"\"\n   467|        return self.boundary_id is not None and self.boundary_id.strip() != \"\"\n   468|\n   469|    @property\n   470|    def is_step_scoped(self) -> bool:\n   471|        \"\"\"True when this attempt is scoped to a specific step.\"\"\"\n   472|        return self.step_id is not None and self.step_id.strip() != \"\"\n   473|\n   474|    @property\n   475|    def composite_key(self) -> str:\n   476|        \"\"\"Return a stable composite key for this attempt identity.\"\"\"\n   477|        parts = [\n   478|            self.workflow_id,\n   479|            self.run_id,\n   480|            self.graph_revision,\n   481|            str(self.attempt_ordinal),\n   482|            self.attempt_id,\n   483|        ]\n   484|        raw = \"|\".join(parts)\n   485|        return \"sha256:\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n   486|\n   487|    def to_dict(self) -> dict[str, Any]:\n   488|        \"\"\"Return a sidecar-safe payload with primitive values.\"\"\"\n   489|        payload: dict[str, Any] = {\n   490|            \"workflow_id\": self.workflow_id,\n   491|            \"run_id\": self.run_id,\n   492|            \"graph_revision\": self.graph_revision,\n   493|            \"attempt_ordinal\": self.attempt_ordinal,\n   494|            \"attempt_id\": self.attempt_id,\n   495|        }\n   496|        if self.step_id is not None:\n   497|            payload[\"step_id\"] = self.step_id\n   498|        if self.boundary_id is not None:\n   499|            payload[\"boundary_id\"] = self.boundary_id\n   500|        if self.invocation_id is not None:\n   501|            payload[\"invocation_id\"] = self.invocation_id\n   502|        return payload\n   503|\n   504|\n   505|# ── Provenance ────────────────────────────────────────────────────────────\n   506|\n   507|\n   508|@dataclass(frozen=True)\n   509|class AttemptProvenance:\n   510|    \"\"\"Parent/causal lineage and actor/tool provenance for an attempt.\n   511|\n   512|    The causal_lineage is an ordered list of ancestor attempt IDs (oldest\n   513|    first, direct parent last). The parent_attempt_id is the immediate\n   514|    predecessor in the attempt chain (None for the initial attempt).\n   515|    \"\"\"\n   516|\n   517|    parent_attempt_id: str | None = None\n   518|    causal_lineage: tuple[str, ...] = ()\n   519|    actor_id: str | None = None\n   520|    tool_id: str | None = None\n   521|    provenance_version: str = \"arnold.workflow.attempt_provenance.v1\"\n   522|\n   523|    def __post_init__(self) -> None:\n   524|        # Validate parent/causal lineage consistency.\n   525|        if self.causal_lineage:\n   526|            if self.parent_attempt_id is None:\n   527|                raise ValueError(\n   528|                    \"AttemptProvenance.causal_lineage is non-empty but \"\n   529|                    \"parent_attempt_id is None\"\n   530|                )\n   531|            if self.parent_attempt_id != self.causal_lineage[-1]:\n   532|                raise ValueError(\n   533|                    f\"AttemptProvenance.parent_attempt_id \"\n   534|                    f\"{self.parent_attempt_id!r} does not match last entry \"\n   535|                    f\"in causal_lineage {self.causal_lineage[-1]!r}\"\n   536|                )\n   537|        elif self.parent_attempt_id is not None:\n   538|            raise ValueError(\n   539|                \"AttemptProvenance.parent_attempt_id is set but \"\n   540|                \"causal_lineage is empty\"\n   541|            )\n   542|\n   543|        # Validate all lineage entries.\n   544|        for i, ancestor_id in enumerate(self.causal_lineage):\n   545|            try:\n   546|                uuid.UUID(ancestor_id)\n   547|            except (ValueError, AttributeError):\n   548|                raise ValueError(\n   549|                    f\"AttemptProvenance.causal_lineage[{i}] must be a valid \"\n   550|                    f\"UUID, got {ancestor_id!r}\"\n   551|                )\n   552|\n   553|    @property\n   554|    def is_initial_attempt(self) -> bool:\n   555|        \"\"\"True when this is the initial attempt (no parent).\"\"\"\n   556|        return self.parent_attempt_id is None\n   557|\n   558|    @property\n   559|    def lineage_depth(self) -> int:\n   560|        \"\"\"Number of ancestors in the causal lineage.\"\"\"\n   561|        return len(self.causal_lineage)\n   562|\n   563|    def to_dict(self) -> dict[str, Any]:\n   564|        \"\"\"Return a sidecar-safe payload with primitive values.\"\"\"\n   565|        payload: dict[str, Any] = {\n   566|            \"provenance_version\": self.provenance_version,\n   567|            \"lineage_depth\": len(self.causal_lineage),\n   568|        }\n   569|        if self.parent_attempt_id is not None:\n   570|            payload[\"parent_attempt_id\"] = self.parent_attempt_id\n   571|        if self.causal_lineage:\n   572|            payload[\"causal_lineage\"] = list(self.causal_lineage)\n   573|        if self.actor_id is not None:\n   574|            payload[\"actor_id\"] = self.actor_id\n   575|        if self.tool_id is not None:\n   576|            payload[\"tool_id\"] = self.tool_id\n   577|        return payload\n   578|\n   579|\n   580|# ── Runtime adapter ───────────────────────────────────────────────────────\n   581|\n   582|\n   583|@dataclass(frozen=True)\n   584|class RuntimeAdapter:\n   585|    \"\"\"Runtime adapter identity for an execution attempt.\n   586|\n   587|    Pins the adapter kind and version that dispatched this attempt.\n   588|    \"\"\"\n   589|\n   590|    adapter_kind: AdapterKind\n   591|    adapter_version: str\n   592|\n   593|    def __post_init__(self) -> None:\n   594|        if not self.adapter_version.strip():\n   595|            raise ValueError(\"RuntimeAdapter.adapter_version must be non-empty\")\n   596|\n   597|    def to_dict(self) -> dict[str, Any]:\n   598|        return {\n   599|            \"adapter_kind\": self.adapter_kind.value,\n   600|            \"adapter_version\": self.adapter_version,\n   601|        }\n   602|\n   603|\n   604|# ── Version anchoring ────────────────────────────────────────────────────\n   605|\n   606|\n   607|@dataclass(frozen=True)\n   608|class VersionSet:\n   609|    \"\"\"Code, config, and template version anchoring for an attempt.\n   610|\n   611|    These pin the exact versions of the code, configuration, and template\n   612|    used when the attempt was dispatched. At least one version must be\n   613|    provided.\n   614|    \"\"\"\n   615|\n   616|    code_version: str | None = None\n   617|    config_version: str | None = None\n   618|    template_version: str | None = None\n   619|\n   620|    def __post_init__(self) -> None:\n   621|        if not any(\n   622|            [\n   623|                self.code_version is not None and self.code_version.strip(),\n   624|                self.config_version is not None and self.config_version.strip(),\n   625|                self.template_version is not None and self.template_version.strip(),\n   626|            ]\n   627|        ):\n   628|            raise ValueError(\n   629|                \"VersionSet must have at least one of code_version, \"\n   630|                \"config_version, or template_version\"\n   631|            )\n   632|\n   633|    def to_dict(self) -> dict[str, Any]:\n   634|        payload: dict[str, Any] = {}\n   635|        if self.code_version is not None:\n   636|            payload[\"code_version\"] = self.code_version\n   637|        if self.config_version is not None:\n   638|            payload[\"config_version\"] = self.config_version\n   639|        if self.template_version is not None:\n   640|            payload[\"template_version\"] = self.template_version\n   641|        return payload\n   642|\n   643|\n   644|# ── Grant / decision references ──────────────────────────────────────────\n   645|\n   646|\n   647|@dataclass(frozen=True)\n   648|class GrantRef:\n   649|    \"\"\"Reference to a Run Authority grant and optional decision.\n   650|\n   651|    Every attempt must reference the capability grant under which it was\n   652|    dispatched. A decision may be recorded when authority is exercised.\n   653|    \"\"\"\n   654|\n   655|    grant_id: str\n   656|    decision_id: str | None = None\n   657|\n   658|    def __post_init__(self) -> None:\n   659|        if not self.grant_id.strip():\n   660|            raise ValueError(\"GrantRef.grant_id must be non-empty\")\n   661|\n   662|    def to_dict(self) -> dict[str, Any]:\n   663|        payload: dict[str, Any] = {\"grant_id\": self.grant_id}\n   664|        if self.decision_id is not None:\n   665|            payload[\"decision_id\"] = self.decision_id\n   666|        return payload\n   667|\n   668|\n   669|# ── Ledger position ──────────────────────────────────────────────────────\n   670|\n   671|\n   672|@dataclass(frozen=True, order=True)\n   673|class LedgerPosition:\n   674|    \"\"\"Durable append position in the attempt's ordered event stream.\n   675|\n   676|    Each event in an attempt stream has a monotonic sequence number and a\n   677|    durable append position. The causal_predecessor_sequence links to the\n   678|    immediately preceding event in the same attempt (0 for the first event).\n   679|    \"\"\"\n   680|\n   681|    sequence: int\n   682|    append_position: int\n   683|    causal_predecessor_sequence: int = 0\n   684|\n   685|    def __post_init__(self) -> None:\n   686|        if self.sequence < 1:\n   687|            raise ValueError(\n   688|                f\"LedgerPosition.sequence must be >= 1, got {self.sequence}\"\n   689|            )\n   690|        if self.append_position < 0:\n   691|            raise ValueError(\n   692|                f\"LedgerPosition.append_position must be >= 0, \"\n   693|                f\"got {self.append_position}\"\n   694|            )\n   695|        if self.causal_predecessor_sequence < 0:\n   696|            raise ValueError(\n   697|                f\"LedgerPosition.causal_predecessor_sequence must be >= 0, \"\n   698|                f\"got {self.causal_predecessor_sequence}\"\n   699|            )\n   700|", "total_lines": 1460, "file_size": 54228, "truncated": true, "hint": "Use offset=700 to continue reading (showing 400-699 of 1460 lines)", "is_binary": false, "is_image": false}
./critique-ledger-m9-planner-prompt.txt:515:{"content": "     1|\"\"\"Durable SQLite-backed store for ``ExecutionAttemptLedger`` event streams.\n     2|\n     3|This module provides the M6A transactional store boundary for WBC ledger\n     4|events. It does NOT modify the ``ExecutionAttemptLedger`` schema — it reads\n     5|and writes the same frozen dataclasses via their existing ``to_dict()``\n     6|serialization contract.\n     7|\n     8|Key invariants:\n     9|* SQLite WAL mode for concurrent readers and atomic writes.\n    10|* Contract-version binding to ``LEDGER_SCHEMA_VERSION`` in metadata.\n    11|* Durable serialization uses ``LedgerEvent.to_dict()`` and json.\n    12|* Readback reconstructs ``LedgerEvent`` and ``ExecutionAttemptLedger``\n    13|  without mutating schema fields.\n    14|\n    15|Step 4 transactional append invariants (enforced inside ONE SQLite\n    16|``BEGIN IMMEDIATE`` transaction per append):\n    17|\n    18|* **Monotonic sequence** — an appended event's ``sequence`` must be\n    19|  strictly greater than the largest persisted sequence for the same\n    20|  ``attempt_id``. A regression raises :class:`MonotonicSequenceError`.\n    21|* **Idempotency-key uniqueness with dedup** — appending an event whose\n    22|  ``(attempt_id, idempotency_key)`` already exists does not raise; the\n    23|  store returns the existing persisted event with ``is_duplicate=True``.\n    24|  Two different events with the same idempotency key can never coexist.\n    25|* **Exactly one terminal event** — once a terminal event\n    26|  (``completed``/``failed``/``cancelled``) is persisted for an attempt,\n    27|  any further append with a new idempotency key raises\n    28|  :class:`PostTerminalAppendError`. A second terminal therefore cannot\n    29|  land, and neither can any post-terminal non-terminal event.\n    30|* **Dedup wins over rejection** — when a duplicate idempotency key is\n    31|  presented, the existing event is returned even if the attempt has\n    32|  since reached a terminal state. Retries of the same logical append\n    33|  are therefore safe and observable.\n    34|\"\"\"\n    35|\n    36|from __future__ import annotations\n    37|\n    38|import json\n    39|import sqlite3\n    40|import time\n    41|import uuid\n    42|from abc import ABC, abstractmethod\n    43|from dataclasses import dataclass\n    44|from enum import Enum\n    45|from pathlib import Path\n    46|from typing import Any, Optional\n    47|\n    48|from arnold.workflow.execution_attempt_ledger import (\n    49|    LEDGER_SCHEMA_VERSION,\n    50|    AdapterKind,\n    51|    AttemptEventType,\n    52|    AttemptIdentity,\n    53|    AttemptOutcome,\n    54|    AttemptProvenance,\n    55|    ExecutionAttemptLedger,\n    56|    GrantRef,\n    57|    LedgerEvent,\n    58|    PersistenceStatus,\n    59|    RuntimeAdapter,\n    60|    VersionSet,\n    61|)\n    62|\n    63|# ── Store metadata constants ──────────────────────────────────────────────\n    64|\n    65|_STORE_VERSION: str = \"arnold.workflow.attempt_ledger_store.v1\"\n    66|_METADATA_TABLE_DDL: str = \"\"\"\\\n    67|CREATE TABLE IF NOT EXISTS _store_metadata (\n    68|    key   TEXT PRIMARY KEY,\n    69|    value TEXT NOT NULL\n    70|);\n    71|\"\"\"\n    72|\n    73|_EVENTS_TABLE_DDL: str = \"\"\"\\\n    74|CREATE TABLE IF NOT EXISTS attempt_events (\n    75|    attempt_id         TEXT    NOT NULL,\n    76|    sequence           INTEGER NOT NULL,\n    77|    idempotency_key    TEXT    NOT NULL,\n    78|    event_type         TEXT    NOT NULL,\n    79|    event_json         TEXT    NOT NULL,\n    80|    appended_at_ns     INTEGER NOT NULL,\n    81|    PRIMARY KEY (attempt_id, sequence)\n    82|);\n    83|\"\"\"\n    84|\n    85|_EVENTS_IDEMPOTENCY_INDEX_DDL: str = \"\"\"\\\n    86|CREATE UNIQUE INDEX IF NOT EXISTS idx_attempt_events_idempotency\n    87|    ON attempt_events(attempt_id, idempotency_key);\n    88|\"\"\"\n    89|\n    90|# Reservations are coordination state, not authority. They record that a\n    91|# caller has declared intent to start (or has already started) an attempt\n    92|# stream. They never mint completion, dispatch, or authority decisions.\n    93|_RESERVATIONS_TABLE_DDL: str = \"\"\"\\\n    94|CREATE TABLE IF NOT EXISTS attempt_reservations (\n    95|    attempt_id         TEXT    PRIMARY KEY,\n    96|    first_reserved_ns  INTEGER NOT NULL,\n    97|    last_reserved_ns   INTEGER NOT NULL,\n    98|    reservation_count  INTEGER NOT NULL DEFAULT 1\n    99|);\n   100|\"\"\"\n   101|\n   102|# ── Diagnostic tables (Step 8) ────────────────────────────────────────────\n   103|#\n   104|# These tables persist ``PersistenceFailureDiagnostic`` and\n   105|# ``ReconciliationDiagnostic`` payloads as evidence, not authority.\n   106|# They are joinable to the event stream via ``attempt_id`` but never\n   107|# grant append or completion power — they are observable projections\n   108|# that the store records when persistence operations fail or are\n   109|# reconciled.\n   110|#\n   111|# Source-cursor tracking records where the source system has observed\n   112|# the attempt stream up to, enabling gap detection and reconciliation\n   113|# resumption without requiring re-scan of the full event history.\n   114|\n   115|_PERSISTENCE_FAILURE_DIAGNOSTICS_TABLE_DDL: str = \"\"\"\\\n   116|CREATE TABLE IF NOT EXISTS persistence_failure_diagnostics (\n   117|    attempt_id              TEXT    NOT NULL,\n   118|    diagnostic_id           TEXT    NOT NULL PRIMARY KEY,\n   119|    target_event_sequence   INTEGER NOT NULL,\n   120|    failure_mode            TEXT    NOT NULL,\n   121|    observed_error          TEXT    NOT NULL,\n   122|    diagnostic_json         TEXT    NOT NULL,\n   123|    recorded_at_ns          INTEGER NOT NULL\n   124|);\n   125|\"\"\"\n   126|\n   127|_RECONCILIATION_DIAGNOSTICS_TABLE_DDL: str = \"\"\"\\\n   128|CREATE TABLE IF NOT EXISTS reconciliation_diagnostics (\n   129|    attempt_id                   TEXT    NOT NULL,\n   130|    diagnostic_id                TEXT    NOT NULL PRIMARY KEY,\n   131|    reconciled_event_sequence    INTEGER NOT NULL,\n   132|    outcome                      TEXT    NOT NULL,\n   133|    outcome_detail               TEXT    NOT NULL,\n   134|    diagnostic_json              TEXT    NOT NULL,\n   135|    recorded_at_ns               INTEGER NOT NULL\n   136|);\n   137|\"\"\"\n   138|\n   139|_SOURCE_CURSORS_TABLE_DDL: str = \"\"\"\\\n   140|CREATE TABLE IF NOT EXISTS source_cursors (\n   141|    attempt_id    TEXT    NOT NULL,\n   142|    cursor_key    TEXT    NOT NULL DEFAULT 'default',\n   143|    last_sequence INTEGER NOT NULL DEFAULT 0,\n   144|    last_position TEXT,\n   145|    updated_at_ns INTEGER NOT NULL,\n   146|    PRIMARY KEY (attempt_id, cursor_key)\n   147|);\n   148|\"\"\"\n   149|\n   150|# String literal set of terminal event types. Mirrors the schema-private\n   151|# ``_TERMINAL_EVENT_TYPES`` frozenset (COMPLETED/FAILED/CANCELLED) but is\n   152|# kept as SQL string literals so it is fully self-contained in DML.\n   153|_TERMINAL_EVENT_TYPE_VALUES: tuple[str, ...] = (\n   154|    AttemptEventType.COMPLETED.value,\n   155|    AttemptEventType.FAILED.value,\n   156|    AttemptEventType.CANCELLED.value,\n   157|)\n   158|\n   159|\n   160|# ── Typed errors ──────────────────────────────────────────────────────────\n   161|\n   162|\n   163|class AttemptLedgerError(Exception):\n   164|    \"\"\"Base class for typed attempt-ledger store errors.\n   165|\n   166|    All store-generated invariant violations derive from this class so\n   167|    callers can distinguish store policy enforcement from generic\n   168|    ``sqlite3`` errors or schema ``ValueError`` raises.\n   169|    \"\"\"\n   170|\n   171|\n   172|class MonotonicSequenceError(AttemptLedgerError):\n   173|    \"\"\"Raised when an appended event violates strict sequence monotonicity.\n   174|\n   175|    The appended event's ``sequence`` must be greater than the highest\n   176|    sequence already persisted for the same ``attempt_id``.\n   177|    \"\"\"\n   178|\n   179|\n   180|class PostTerminalAppendError(AttemptLedgerError):\n   181|    \"\"\"Raised when any append is attempted after a terminal event.\n   182|\n   183|    Covers both second-terminal attempts and post-terminal non-terminal\n   184|    events. The single terminal event is final.\n   185|    \"\"\"\n   186|\n   187|\n   188|# ── Gate types (Step 5: durable start and terminal verification) ───────────\n   189|\n   190|\n   191|class GateStatus(Enum):\n   192|    \"\"\"Outcome of a durable gate verification.\n   193|\n   194|    Gates never return optimistic defaults — they require durable evidence\n   195|    and fail closed when evidence is missing, ambiguous, or contradictory.\n   196|    \"\"\"\n   197|\n   198|    VERIFIED = \"verified\"\n   199|    \"\"\"Durable evidence confirms the gate condition — a matching event exists\n   200|    and its persisted fields are coherent.\"\"\"\n   201|", "total_lines": 1984, "file_size": 74183, "truncated": true, "hint": "Use offset=201 to continue reading (showing 1-200 of 1984 lines)", "is_binary": false, "is_image": false}
./critique-ledger-m9-planner-prompt.txt:544:{"content": "   900|\n   901|# ── Persistence-failure diagnostic ───────────────────────────────────────\n   902|\n   903|\n   904|class PersistenceFailureMode(StrEnum):\n   905|    \"\"\"Failure modes for persistence operations in the ledger.\"\"\"\n   906|\n   907|    WRITE_FAILED = \"write_failed\"\n   908|    STORE_UNAVAILABLE = \"store_unavailable\"\n   909|    QUOTA_EXCEEDED = \"quota_exceeded\"\n   910|    CHECKSUM_MISMATCH = \"checksum_mismatch\"\n   911|    PARTIAL_WRITE = \"partial_write\"\n   912|    UNKNOWN = \"unknown\"\n   913|\n   914|\n   915|class ReconciliationOutcome(StrEnum):\n   916|    \"\"\"Outcomes of reconciliation attempts after persistence failure.\"\"\"\n   917|\n   918|    RECOVERED = \"recovered\"\n   919|    PARTIALLY_RECOVERED = \"partially_recovered\"\n   920|    UNRECOVERABLE = \"unrecoverable\"\n   921|    REQUIRES_MANUAL_INTERVENTION = \"requires_manual_intervention\"\n   922|    QUARANTINED = \"quarantined\"\n   923|\n   924|\n   925|@dataclass(frozen=True)\n   926|class PersistenceFailureDiagnostic:\n   927|    \"\"\"Diagnostic captured when a ledger persistence operation fails.\n   928|\n   929|    This is recorded alongside (or within) a ``persistence_failed`` event.\n   930|    It captures the failure mode, recovery evidence, quarantined authority\n   931|    advance status, and the observed error.\n   932|\n   933|    The ``recovery_evidence_ref`` is a durable reference to spool/outbox\n   934|    evidence that MAY allow the runtime to recover. If ``None``, no\n   935|    recovery evidence was preserved.\n   936|    \"\"\"\n   937|\n   938|    failure_mode: PersistenceFailureMode\n   939|    target_event_sequence: int\n   940|    observed_error: str\n   941|    recovery_evidence_ref: DurableRef | None = None\n   942|    quarantined_authority_advance: bool = False\n   943|    quarantine_reason: str | None = None\n   944|    diagnostic_schema_version: str = (\n   945|        \"arnold.workflow.ledger.persistence_failure_diagnostic.v1\"\n   946|    )\n   947|\n   948|    def __post_init__(self) -> None:\n   949|        if self.target_event_sequence < 1:\n   950|            raise ValueError(\n   951|                \"PersistenceFailureDiagnostic.target_event_sequence \"\n   952|                f\"must be >= 1, got {self.target_event_sequence}\"\n   953|            )\n   954|        if not self.observed_error.strip():\n   955|            raise ValueError(\n   956|                \"PersistenceFailureDiagnostic.observed_error must be non-empty\"\n   957|            )\n   958|        if self.quarantined_authority_advance and (\n   959|            self.quarantine_reason is None\n   960|            or not self.quarantine_reason.strip()\n   961|        ):\n   962|            raise ValueError(\n   963|                \"PersistenceFailureDiagnostic.quarantine_reason must be set \"\n   964|                \"when quarantined_authority_advance is True\"\n   965|            )\n   966|\n   967|    @property\n   968|    def has_recovery_evidence(self) -> bool:\n   969|        \"\"\"True when recovery evidence (spool/outbox) is available.\"\"\"\n   970|        return self.recovery_evidence_ref is not None\n   971|\n   972|    @property\n   973|    def is_recoverable(self) -> bool:\n   974|        \"\"\"True when the failure mode suggests recovery is possible.\"\"\"\n   975|        return self.failure_mode in (\n   976|            PersistenceFailureMode.WRITE_FAILED,\n   977|            PersistenceFailureMode.STORE_UNAVAILABLE,\n   978|            PersistenceFailureMode.PARTIAL_WRITE,\n   979|        )\n   980|\n   981|    def to_dict(self) -> dict[str, Any]:\n   982|        \"\"\"Return a sidecar-safe payload with primitive values.\"\"\"\n   983|        payload: dict[str, Any] = {\n   984|            \"failure_mode\": self.failure_mode.value,\n   985|            \"target_event_sequence\": self.target_event_sequence,\n   986|            \"observed_error\": self.observed_error,\n   987|            \"quarantined_authority_advance\": self.quarantined_authority_advance,\n   988|            \"diagnostic_schema_version\": self.diagnostic_schema_version,\n   989|        }\n   990|        if self.recovery_evidence_ref is not None:\n   991|            payload[\"recovery_evidence_ref\"] = (\n   992|                self.recovery_evidence_ref.to_dict()\n   993|            )\n   994|        if self.quarantine_reason is not None:\n   995|            payload[\"quarantine_reason\"] = self.quarantine_reason\n   996|        return payload\n   997|\n   998|\n   999|# ── Reconciliation diagnostic ───────────────────────────────────────────\n  1000|\n  1001|\n  1002|@dataclass(frozen=True)\n  1003|class ReconciliationDiagnostic:\n  1004|    \"\"\"Diagnostic captured when a persistence failure is reconciled.\n  1005|\n  1006|    This is recorded alongside (or within) a ``reconciliation`` event.\n  1007|    It references the failed event, describes the reconciliation outcome,\n  1008|    and captures recovered evidence references and explicit authority\n  1009|    disposition.\n  1010|\n  1011|    The ``reconciled_event_sequence`` identifies the persistence_failed\n  1012|    event that this reconciliation addresses. ``recovered_evidence_refs``\n  1013|    lists durable references to evidence recovered during reconciliation.\n  1014|    \"\"\"\n  1015|\n  1016|    reconciled_event_sequence: int\n  1017|    outcome: ReconciliationOutcome\n  1018|    outcome_detail: str\n  1019|    recovered_evidence_refs: tuple[DurableRef, ...] = ()\n  1020|    authority_disposition: str | None = None\n  1021|    diagnostic_schema_version: str = (\n  1022|        \"arnold.workflow.ledger.reconciliation_diagnostic.v1\"\n  1023|    )\n  1024|\n  1025|    def __post_init__(self) -> None:\n  1026|        if self.reconciled_event_sequence < 1:\n  1027|            raise ValueError(\n  1028|                \"ReconciliationDiagnostic.reconciled_event_sequence \"\n  1029|                f\"must be >= 1, got {self.reconciled_event_sequence}\"\n  1030|            )\n  1031|        if not self.outcome_detail.strip():\n  1032|            raise ValueError(\n  1033|                \"ReconciliationDiagnostic.outcome_detail must be non-empty\"\n  1034|            )\n  1035|\n  1036|    @property\n  1037|    def is_fully_recovered(self) -> bool:\n  1038|        \"\"\"True when reconciliation fully recovered the failed event.\"\"\"\n  1039|        return self.outcome == ReconciliationOutcome.RECOVERED\n  1040|\n  1041|    @property\n  1042|    def has_recovered_evidence(self) -> bool:\n  1043|        \"\"\"True when one or more evidence refs were recovered.\"\"\"\n  1044|        return len(self.recovered_evidence_refs) > 0\n  1045|\n  1046|    @property\n  1047|    def requires_intervention(self) -> bool:\n  1048|        \"\"\"True when manual intervention is required.\"\"\"\n  1049|        return self.outcome in (\n  1050|            ReconciliationOutcome.REQUIRES_MANUAL_INTERVENTION,\n  1051|            ReconciliationOutcome.UNRECOVERABLE,\n  1052|        )\n  1053|\n  1054|    def to_dict(self) -> dict[str, Any]:\n  1055|        \"\"\"Return a sidecar-safe payload with primitive values.\"\"\"\n  1056|        payload: dict[str, Any] = {\n  1057|            \"reconciled_event_sequence\": self.reconciled_event_sequence,\n  1058|            \"outcome\": self.outcome.value,\n  1059|            \"outcome_detail\": self.outcome_detail,\n  1060|            \"diagnostic_schema_version\": self.diagnostic_schema_version,\n  1061|        }\n  1062|        if self.recovered_evidence_refs:\n  1063|            payload[\"recovered_evidence_refs\"] = [\n  1064|                ref.to_dict() for ref in self.recovered_evidence_refs\n  1065|            ]\n  1066|        if self.authority_disposition is not None:\n  1067|            payload[\"authority_disposition\"] = self.authority_disposition\n  1068|        return payload\n  1069|\n  1070|\n  1071|# ── ExecutionAttemptLedger ────────────────────────────────────────────────\n  1072|\n  1073|\n  1074|@dataclass(frozen=True)\n  1075|class ExecutionAttemptLedger:\n  1076|    \"\"\"Ordered, append-only record of what a supported runtime attempted.\n  1077|\n  1078|    This is the container for one attempt's complete event stream. Events\n  1079|    are stored in append order and must form a valid causal chain.\n  1080|\n  1081|    The ledger is schema-only: it validates event identity, ordering,\n  1082|    provenance, and append-position invariants without performing any I/O\n  1083|    or mutation.\n  1084|    \"\"\"\n  1085|\n  1086|    attempt_id: str\n  1087|    events: tuple[LedgerEvent, ...] = ()\n  1088|    ledger_schema_version: str = LEDGER_SCHEMA_VERSION\n  1089|\n  1090|    def __post_init__(self) -> None:\n  1091|        if not self.attempt_id.strip():\n  1092|            raise ValueError(\n  1093|                \"ExecutionAttemptLedger.attempt_id must be non-empty\"\n  1094|            )\n  1095|        # Validate that all events reference this attempt_id.\n  1096|        for i, event in enumerate(self.events):\n  1097|            if event.identity.attempt_id != self.attempt_id:\n  1098|                raise ValueError(\n  1099|                    f\"ExecutionAttemptLedger.events[{i}] has attempt_id \"\n  1100|                    f\"{event.identity.attempt_id!r} but ledger has \"\n  1101|                    f\"{self.attempt_id!r}\"\n  1102|                )\n  1103|\n  1104|    @property\n  1105|    def event_count(self) -> int:\n  1106|        \"\"\"Total number of events in the ledger.\"\"\"\n  1107|        return len(self.events)\n  1108|\n  1109|    @property\n  1110|    def first_event(self) -> LedgerEvent | None:\n  1111|        \"\"\"The first event in the attempt stream, or None if empty.\"\"\"\n  1112|        return self.events[0] if self.events else None\n  1113|\n  1114|    @property\n  1115|    def last_event(self) -> LedgerEvent | None:\n  1116|        \"\"\"The last event in the attempt stream, or None if empty.\"\"\"\n  1117|        return self.events[-1] if self.events else None\n  1118|\n  1119|    @property\n  1120|    def is_empty(self) -> bool:\n  1121|        \"\"\"True when the ledger has no events.\"\"\"\n  1122|        return len(self.events) == 0\n  1123|\n  1124|    @property\n  1125|    def terminal_event(self) -> LedgerEvent | None:\n  1126|        \"\"\"The terminal event if one exists, or None.\"\"\"\n  1127|        for event in reversed(self.events):\n  1128|            if event.is_terminal:\n  1129|                return event\n  1130|        return None\n  1131|\n  1132|    def event_by_sequence(self, sequence: int) -> LedgerEvent | None:\n  1133|        \"\"\"Return the event at the given sequence number, or None.\"\"\"\n  1134|        for event in self.events:\n  1135|            if event.sequence == sequence:\n  1136|                return event\n  1137|        return None\n  1138|\n  1139|    def to_dict(self) -> dict[str, Any]:\n  1140|        \"\"\"Return a sidecar-safe payload with primitive values.\"\"\"\n  1141|        return {\n  1142|            \"attempt_id\": self.attempt_id,\n  1143|            \"ledger_schema_version\": self.ledger_schema_version,\n  1144|            \"event_count\": len(self.events),\n  1145|            \"events\": [event.to_dict() for event in self.events],\n  1146|        }\n  1147|\n  1148|\n  1149|# ── Validators ────────────────────────────────────────────────────────────\n  1150|\n  1151|\n  1152|def validate_ledger_event_identity(event: LedgerEvent) -> list[str]:\n  1153|    \"\"\"Validate the identity fields of a ledger event.\n  1154|\n  1155|    Checks that workflow_id, run_id, graph_revision, attempt_ordinal,\n  1156|    and attempt_id are populated and well-formed.\n  1157|    \"\"\"\n  1158|    issues: list[str] = []\n  1159|\n  1160|    identity = event.identity\n  1161|    if not identity.workflow_id.strip():\n  1162|        issues.append(\"LedgerEvent.identity.workflow_id is empty\")\n  1163|    if not identity.run_id.strip():\n  1164|        issues.append(\"LedgerEvent.identity.run_id is empty\")\n  1165|    if not identity.graph_revision.strip():\n  1166|        issues.append(\"LedgerEvent.identity.graph_revision is empty\")\n  1167|    if identity.attempt_ordinal < 1:\n  1168|        issues.append(\n  1169|            f\"LedgerEvent.identity.attempt_ordinal must be >= 1, \"\n  1170|            f\"got {identity.attempt_ordinal}\"\n  1171|        )\n  1172|    if not identity.attempt_id.strip():\n  1173|        issues.append(\"LedgerEvent.identity.attempt_id is empty\")\n  1174|\n  1175|    # Validate attempt_id is a valid UUID.\n  1176|    try:\n  1177|        uuid.UUID(identity.attempt_id)\n  1178|    except (ValueError, AttributeError):\n  1179|        issues.append(\n  1180|            f\"LedgerEvent.identity.attempt_id {identity.attempt_id!r} \"\n  1181|            f\"is not a valid UUID\"\n  1182|        )\n  1183|\n  1184|    return issues\n  1185|\n  1186|\n  1187|def validate_ledger_event_ordering(\n  1188|    events: Sequence[LedgerEvent],\n  1189|) -> list[str]:\n  1190|    \"\"\"Validate the monotonic ordering and causal chain of ledger events.\n  1191|\n  1192|    Checks:\n  1193|    - Sequence numbers are strictly monotonic.\n  1194|    - Append positions are strictly monotonic.\n  1195|    - Causal predecessor links form a valid chain.\n  1196|    - No duplicate sequence numbers.\n  1197|    - The first event has causal_predecessor_sequence == 0.\n  1198|    - Lifecycle precedence constraints are satisfied.\n  1199|    \"\"\"\n  1200|    issues: list[str] = []\n  1201|\n  1202|    if not events:\n  1203|        return issues\n  1204|\n  1205|    seen_sequences: set[int] = set()\n  1206|    prev_sequence: int = 0\n  1207|    prev_append: int = -1\n  1208|    seen_event_types: set[AttemptEventType] = set()\n  1209|\n  1210|    for i, event in enumerate(events):\n  1211|        # Duplicate sequence check.\n  1212|        if event.sequence in seen_sequences:\n  1213|            issues.append(\n  1214|                f\"Duplicate sequence number {event.sequence} at event {i}\"\n  1215|            )\n  1216|        seen_sequences.add(event.sequence)\n  1217|\n  1218|        # Monotonic sequence.\n  1219|        if event.sequence <= prev_sequence:\n  1220|            issues.append(\n  1221|                f\"Sequence not strictly monotonic: event {i} has sequence \"\n  1222|                f\"{event.sequence} after {prev_sequence}\"\n  1223|            )\n  1224|        prev_sequence = event.sequence\n  1225|\n  1226|        # Monotonic append position.\n  1227|        if event.append_position <= prev_append:\n  1228|            issues.append(\n  1229|                f\"Append position not strictly monotonic: event {i} has \"\n  1230|                f\"append_position {event.append_position} after \"\n  1231|                f\"{prev_append}\"\n  1232|            )\n  1233|        prev_append = event.append_position\n  1234|\n  1235|        # First event must have causal_predecessor_sequence == 0.\n  1236|        if i == 0 and event.causal_predecessor_sequence != 0:\n  1237|            issues.append(\n  1238|                f\"First event must have causal_predecessor_sequence == 0, \"\n  1239|                f\"got {event.causal_predecessor_sequence}\"\n  1240|            )\n  1241|\n  1242|        # Causal predecessor must reference a real earlier event.\n  1243|        if event.causal_predecessor_sequence > 0:\n  1244|            found = any(\n  1245|                e.sequence == event.causal_predecessor_sequence\n  1246|                for e in events[:i]\n  1247|            )\n  1248|            if not found:\n  1249|                issues.append(\n  1250|                    f\"Event {i} references causal_predecessor_sequence \"\n  1251|                    f\"{event.causal_predecessor_sequence} which does not \"\n  1252|                    f\"exist in earlier events\"\n  1253|                )\n  1254|\n  1255|        # Lifecycle precedence.\n  1256|        required_predecessors = _LIFECYCLE_PRECEDENCE.get(event.event_type)\n  1257|        if required_predecessors:\n  1258|            missing = required_predecessors - seen_event_types\n  1259|            if missing:\n  1260|                missing_str = \", \".join(sorted(m.value for m in missing))\n  1261|                issues.append(\n  1262|                    f\"Event {i} ({event.event_type.value}) requires \"\n  1263|                    f\"preceding event types: {missing_str}\"\n  1264|                )\n  1265|\n  1266|        seen_event_types.add(event.event_type)\n  1267|\n  1268|    return issues\n  1269|\n  1270|\n  1271|def validate_ledger_event_provenance(event: LedgerEvent) -> list[str]:\n  1272|    \"\"\"Validate the provenance fields of a ledger event.\n  1273|\n  1274|    Checks:\n  1275|    - Parent/causal lineage consistency.\n  1276|    - Lineage entries are valid UUIDs when present.\n  1277|    - Actor/tool provenance is documented for non-initial attempts.\n  1278|    \"\"\"\n  1279|    issues: list[str] = []\n  1280|\n  1281|    provenance = event.provenance\n  1282|\n  1283|    # Parent/lineage consistency.\n  1284|    if provenance.causal_lineage:\n  1285|        if provenance.parent_attempt_id is None:\n  1286|            issues.append(\n  1287|                \"Provenance has causal_lineage but parent_attempt_id is None\"\n  1288|            )\n  1289|        elif provenance.parent_attempt_id != provenance.causal_lineage[-1]:\n  1290|            issues.append(\n  1291|                f\"Provenance parent_attempt_id \"\n  1292|                f\"{provenance.parent_attempt_id!r} does not match last \"\n  1293|                f\"lineage entry {provenance.causal_lineage[-1]!r}\"\n  1294|            )\n  1295|    elif provenance.parent_attempt_id is not None:\n  1296|        issues.append(\n  1297|            \"Provenance has parent_attempt_id but causal_lineage is empty\"\n  1298|        )\n  1299|\n  1300|", "total_lines": 1460, "file_size": 54228, "truncated": true, "hint": "Use offset=1300 to continue reading (showing 900-1299 of 1460 lines)", "is_binary": false, "is_image": false}
./critique-ledger-m9-planner-prompt.txt:579:{"content": "   300|    Construction takes an already-opened store and creates the outbox\n   301|    table on the store's connection. All writes go through the store's\n   302|    connection so that the outbox table and the attempt_events table can\n   303|    participate in the same ``BEGIN IMMEDIATE`` / ``COMMIT`` transaction.\n   304|\n   305|    Atomicity guarantee:\n   306|        ``append_event_with_outbox`` executes inside ONE ``BEGIN IMMEDIATE``\n   307|        transaction. The ledger event INSERT and all outbox record INSERTs\n   308|        are committed together or rolled back together. A split-brain where\n   309|        the event lands but the outbox records do not (or vice versa) is\n   310|        impossible by construction.\n   311|    \"\"\"\n   312|\n   313|    def __init__(self, store: SqliteAttemptLedgerStore) -> None:\n   314|        self._store = store\n   315|        self._conn: sqlite3.Connection = store.conn\n   316|        self._init_outbox_schema()\n   317|\n   318|    # ── schema initialization ──────────────────────────────────────────\n   319|\n   320|    def _init_outbox_schema(self) -> None:\n   321|        \"\"\"Create the outbox table and indexes if they do not exist.\n   322|\n   323|        Since the store's connection may already be in use, we execute\n   324|        the DDL outside a transaction — ``CREATE TABLE IF NOT EXISTS``\n   325|        is idempotent and safe to call multiple times.\n   326|        \"\"\"\n   327|        cur = self._conn.cursor()\n   328|        for ddl in (_OUTBOX_TABLE_DDL, _OUTBOX_ATTEMPT_INDEX_DDL, _OUTBOX_STATUS_INDEX_DDL):\n   329|            for stmt in ddl.split(\";\"):\n   330|                s = stmt.strip()\n   331|                if s:\n   332|                    cur.execute(s)\n   333|\n   334|    # ── public interface ───────────────────────────────────────────────\n   335|\n   336|    def append_event_with_outbox(\n   337|        self,\n   338|        attempt_id: str,\n   339|        event: LedgerEvent,\n   340|        outbox_payloads: list[dict[str, str]],\n   341|    ) -> AppendWithOutboxResult:\n   342|        \"\"\"Append *event* and create outbox records in one transaction.\n   343|\n   344|        See :meth:`LedgerOutbox.append_event_with_outbox` for the full contract.\n   345|\n   346|        Atomicity:\n   347|            1. ``BEGIN IMMEDIATE``\n   348|            2. Idempotency-key dedup check (dedup wins over rejection)\n   349|            3. Post-terminal rejection check\n   350|            4. Monotonic sequence check\n   351|            5. INSERT into ``attempt_events``\n   352|            6. For each outbox payload: INSERT into ``outbox_records``\n   353|            7. ``COMMIT`` (or ``ROLLBACK`` on any failure)\n   354|\n   355|        If *event* is a duplicate, only steps 1-2 execute and the\n   356|        transaction is rolled back before returning the existing event\n   357|        with ``is_duplicate=True`` and empty outbox records.\n   358|        \"\"\"\n   359|        if event.identity.attempt_id != attempt_id:\n   360|            raise ValueError(\n   361|                f\"Event attempt_id {event.identity.attempt_id!r} \"\n   362|                f\"does not match store attempt_id {attempt_id!r}\"\n   363|            )\n   364|\n   365|        event_json = json.dumps(event.to_dict(), sort_keys=True, ensure_ascii=False)\n   366|        conn = self._conn\n   367|        now_ns = time.time_ns()\n   368|\n   369|        self._begin_immediate_retry(conn)\n   370|        try:\n   371|            cur = conn.cursor()\n   372|\n   373|            # (2) Idempotency-key dedup.\n   374|            cur.execute(\n   375|                \"SELECT event_json FROM attempt_events\"\n   376|                \" WHERE attempt_id = ? AND idempotency_key = ?\",\n   377|                (attempt_id, event.idempotency_key),\n   378|            )\n   379|            dup_row = cur.fetchone()\n   380|            if dup_row is not None:\n   381|                conn.execute(\"ROLLBACK\")\n   382|                from arnold.workflow.attempt_ledger_store import (\n   383|                    _deserialize_ledger_event,\n   384|                )\n   385|\n   386|                existing = _deserialize_ledger_event(json.loads(dup_row[0]))\n   387|                return AppendWithOutboxResult(\n   388|                    attempt_id=attempt_id,\n   389|                    event=existing,\n   390|                    sequence=existing.sequence,\n   391|                    is_duplicate=True,\n   392|                    outbox_records=(),\n   393|                )\n   394|\n   395|            # (3) Post-terminal rejection.\n   396|            cur.execute(\n   397|                f\"SELECT 1 FROM attempt_events WHERE attempt_id = ?\"\n   398|                f\" AND event_type IN ({','.join('?' * len(_TERMINAL_EVENT_TYPE_VALUES))})\"\n   399|                f\" LIMIT 1\",\n   400|                (attempt_id, *_TERMINAL_EVENT_TYPE_VALUES),\n   401|            )\n   402|            if cur.fetchone() is not None:\n   403|                conn.execute(\"ROLLBACK\")\n   404|                raise PostTerminalAppendError(\n   405|                    f\"Attempt {attempt_id!r} already has a terminal event; \"\n   406|                    f\"further appends are rejected\"\n   407|                    f\" (idempotency_key={event.idempotency_key!r}).\"\n   408|                )\n   409|\n   410|            # (4) Monotonic sequence.\n   411|            cur.execute(\n   412|                \"SELECT COALESCE(MAX(sequence), 0) FROM attempt_events\"\n   413|                \" WHERE attempt_id = ?\",\n   414|                (attempt_id,),\n   415|            )\n   416|            last_seq_row = cur.fetchone()\n   417|            last_seq = int(last_seq_row[0]) if last_seq_row is not None else 0\n   418|            if event.sequence <= last_seq:\n   419|                conn.execute(\"ROLLBACK\")\n   420|                raise MonotonicSequenceError(\n   421|                    f\"Event sequence {event.sequence} for attempt\"\n   422|                    f\" {attempt_id!r} is not strictly greater than the\"\n   423|                    f\" current max {last_seq}.\"\n   424|                )\n   425|\n   426|            # (5) INSERT event.\n   427|            cur.execute(\n   428|                \"\"\"\\\n   429|INSERT INTO attempt_events\n   430|    (attempt_id, sequence, idempotency_key, event_type, event_json, appended_at_ns)\n   431|VALUES (?, ?, ?, ?, ?, ?)\n   432|\"\"\",\n   433|                (\n   434|                    attempt_id,\n   435|                    event.sequence,\n   436|                    event.idempotency_key,\n   437|                    event.event_type.value,\n   438|                    event_json,\n   439|                    now_ns,\n   440|                ),\n   441|            )\n   442|\n   443|            # (6) INSERT outbox records.\n   444|            records: list[OutboxRecord] = []\n   445|            for payload_spec in outbox_payloads:\n   446|                destination = payload_spec[\"destination\"]\n   447|                payload = payload_spec[\"payload\"]\n   448|                payload_json = json.dumps(payload, sort_keys=True, ensure_ascii=False)\n   449|                outbox_id = str(uuid.uuid4())\n   450|                cur.execute(\n   451|                    \"\"\"\\\n   452|INSERT INTO outbox_records\n   453|    (outbox_id, attempt_id, event_sequence, event_idempotency_key,\n   454|     destination, payload_json, status, created_at_ns)\n   455|VALUES (?, ?, ?, ?, ?, ?, ?, ?)\n   456|\"\"\",\n   457|                    (\n   458|                        outbox_id,\n   459|                        attempt_id,\n   460|                        event.sequence,\n   461|                        event.idempotency_key,\n   462|                        destination,\n   463|                        payload_json,\n   464|                        OutboxStatus.PENDING.value,\n   465|                        now_ns,\n   466|                    ),\n   467|                )\n   468|                records.append(\n   469|                    OutboxRecord(\n   470|                        outbox_id=outbox_id,\n   471|                        attempt_id=attempt_id,\n   472|                        event_sequence=event.sequence,\n   473|                        event_idempotency_key=event.idempotency_key,\n   474|                        destination=destination,\n   475|                        payload_json=payload_json,\n   476|                        status=OutboxStatus.PENDING.value,\n   477|                        created_at_ns=now_ns,\n   478|                    )\n   479|                )\n   480|\n   481|            # (7) COMMIT — event + outbox records land together.\n   482|            conn.execute(\"COMMIT\")\n   483|        except (PostTerminalAppendError, MonotonicSequenceError):\n   484|            # Transaction already rolled back inside the handler.\n   485|            raise\n   486|        except Exception:\n   487|            try:\n   488|                conn.execute(\"ROLLBACK\")\n   489|            except Exception:\n   490|                pass\n   491|            raise\n   492|\n   493|        return AppendWithOutboxResult(\n   494|            attempt_id=attempt_id,\n   495|            event=event,\n   496|            sequence=event.sequence,\n   497|            is_duplicate=False,\n   498|            outbox_records=tuple(records),\n   499|        )\n   500|\n   501|    def mark_dispatched(self, outbox_id: str) -> None:\n   502|        \"\"\"Mark *outbox_id* as dispatched.\n   503|\n   504|        Sets ``status='dispatched'`` and records ``dispatched_at_ns``.\n   505|        Idempotent — calling on an already-dispatched record is a no-op\n   506|        that updates the timestamp.\n   507|        \"\"\"\n   508|        now_ns = time.time_ns()\n   509|        cur = self._conn.cursor()\n   510|        cur.execute(\n   511|            \"\"\"\\\n   512|UPDATE outbox_records\n   513|SET status = ?, dispatched_at_ns = ?\n   514|WHERE outbox_id = ?\n   515|\"\"\",\n   516|            (OutboxStatus.DISPATCHED.value, now_ns, outbox_id),\n   517|        )\n   518|\n   519|    def mark_failed(self, outbox_id: str, reason: str) -> None:\n   520|        \"\"\"Mark *outbox_id* as failed.\n   521|\n   522|        Increments ``failure_count`` and records the failure timestamp\n   523|        and reason. The record remains ``status='failed'`` for retry or\n   524|        operator intervention.\n   525|        \"\"\"\n   526|        now_ns = time.time_ns()\n   527|        cur = self._conn.cursor()\n   528|        cur.execute(\n   529|            \"\"\"\\\n   530|UPDATE outbox_records\n   531|SET status = ?,\n   532|    failure_count = failure_count + 1,\n   533|    last_failure_at_ns = ?,\n   534|    last_failure_reason = ?\n   535|WHERE outbox_id = ?\n   536|\"\"\",\n   537|            (OutboxStatus.FAILED.value, now_ns, reason, outbox_id),\n   538|        )\n   539|\n   540|    def retry_failed(\n   541|        self,\n   542|        outbox_id: str,\n   543|        max_retries: int = MAX_RETRY_COUNT,\n   544|    ) -> OutboxRecord:\n   545|        \"\"\"Transition a FAILED outbox record back to PENDING for re-delivery.\n   546|\n   547|        Only records with ``status='failed'`` can be retried. The\n   548|        *max_retries* parameter bounds how many total failures are\n   549|        allowed. If ``failure_count >= max_retries``, raises\n   550|        :class:`RetryLimitExceededError`.\n   551|\n   552|        The record must exist and be in FAILED state. This method does\n   553|        NOT reset ``failure_count`` — the count continues to accumulate\n   554|        so the max-retry guard remains effective across retry cycles.\n   555|        \"\"\"\n   556|        conn = self._conn\n   557|        self._begin_immediate_retry(conn)\n   558|        try:\n   559|            cur = conn.cursor()\n   560|            # Read current state under transaction.\n   561|            cur.execute(\n   562|                \"\"\"\\\n   563|SELECT outbox_id, attempt_id, event_sequence, event_idempotency_key,\n   564|       destination, payload_json, status, created_at_ns,\n   565|       dispatched_at_ns, failure_count, last_failure_at_ns,\n   566|       last_failure_reason\n   567|FROM outbox_records\n   568|WHERE outbox_id = ?\n   569|\"\"\",\n   570|                (outbox_id,),\n   571|            )\n   572|            row = cur.fetchone()\n   573|            if row is None:\n   574|                conn.execute(\"ROLLBACK\")\n   575|                raise ValueError(\n   576|                    f\"Outbox record {outbox_id!r} not found\"\n   577|                )\n   578|\n   579|            record = _row_to_outbox_record(row)\n   580|", "total_lines": 802, "file_size": 28564, "truncated": true, "hint": "Use offset=580 to continue reading (showing 300-579 of 802 lines)", "is_binary": false, "is_image": false}
./critique-ledger-m9-planner-prompt.txt:608:{"content": "   720|# ── Ledger event ─────────────────────────────────────────────────────────\n   721|\n   722|\n   723|@dataclass(frozen=True)\n   724|class LedgerEvent:\n   725|    \"\"\"A single event in an execution attempt's ordered ledger stream.\n   726|\n   727|    Every event carries an idempotency key, immutable identity, provenance,\n   728|    version anchoring, grant reference, monotonic position, and dual\n   729|    timestamps. An event without an idempotency key cannot be safely\n   730|    retried.\n   731|\n   732|    The payload may be:\n   733|    - ``None`` for events that carry no additional data.\n   734|    - A ``dict`` for inline small payloads (subject to size policy).\n   735|    - A ``DurableRef`` for large or sensitive payloads.\n   736|\n   737|    Clocks alone never establish ordering — the sequence and causal\n   738|    predecessor are authoritative.\n   739|    \"\"\"\n   740|\n   741|    idempotency_key: str\n   742|    event_type: AttemptEventType\n   743|    identity: AttemptIdentity\n   744|    provenance: AttemptProvenance\n   745|    adapter: RuntimeAdapter\n   746|    versions: VersionSet\n   747|    grant_ref: GrantRef\n   748|    sequence: int\n   749|    causal_predecessor_sequence: int\n   750|    append_position: int\n   751|    occurred_at: str\n   752|    observed_at: str\n   753|    persistence_status: PersistenceStatus = PersistenceStatus.DURABLE\n   754|    outcome: AttemptOutcome | None = None\n   755|    payload: dict[str, Any] | DurableRef | None = None\n   756|    payload_policy_ref: str | None = None\n   757|    event_schema_version: str = LEDGER_SCHEMA_VERSION\n   758|\n   759|    def __post_init__(self) -> None:\n   760|        # Idempotency key must be non-empty.\n   761|        if not self.idempotency_key.strip():\n   762|            raise ValueError(\"LedgerEvent.idempotency_key must be non-empty\")\n   763|\n   764|        # Validate enums.\n   765|        object.__setattr__(\n   766|            self, \"event_type\", AttemptEventType(self.event_type)\n   767|        )\n   768|        object.__setattr__(\n   769|            self, \"adapter\", RuntimeAdapter(\n   770|                AdapterKind(self.adapter.adapter_kind),\n   771|                self.adapter.adapter_version,\n   772|            )\n   773|            if not isinstance(self.adapter, RuntimeAdapter)\n   774|            else self.adapter\n   775|        )\n   776|        object.__setattr__(\n   777|            self, \"persistence_status\",\n   778|            PersistenceStatus(self.persistence_status),\n   779|        )\n   780|        if self.outcome is not None:\n   781|            object.__setattr__(self, \"outcome\", AttemptOutcome(self.outcome))\n   782|\n   783|        # Validate sequence ordering.\n   784|        if self.sequence < 1:\n   785|            raise ValueError(\n   786|                f\"LedgerEvent.sequence must be >= 1, got {self.sequence}\"\n   787|            )\n   788|        if self.causal_predecessor_sequence < 0:\n   789|            raise ValueError(\n   790|                f\"LedgerEvent.causal_predecessor_sequence must be >= 0, \"\n   791|                f\"got {self.causal_predecessor_sequence}\"\n   792|            )\n   793|        if self.causal_predecessor_sequence >= self.sequence:\n   794|            raise ValueError(\n   795|                f\"LedgerEvent.causal_predecessor_sequence \"\n   796|                f\"({self.causal_predecessor_sequence}) must be < sequence \"\n   797|                f\"({self.sequence})\"\n   798|            )\n   799|        if self.append_position < 0:\n   800|            raise ValueError(\n   801|                f\"LedgerEvent.append_position must be >= 0, \"\n   802|                f\"got {self.append_position}\"\n   803|            )\n   804|\n   805|        # Validate timestamps are non-empty.\n   806|        if not self.occurred_at.strip():\n   807|            raise ValueError(\"LedgerEvent.occurred_at must be non-empty\")\n   808|        if not self.observed_at.strip():\n   809|            raise ValueError(\"LedgerEvent.observed_at must be non-empty\")\n   810|\n   811|        # Outcome constraint: terminal event types should have an outcome.\n   812|        if (\n   813|            self.event_type in _TERMINAL_EVENT_TYPES\n   814|            and self.persistence_status == PersistenceStatus.DURABLE\n   815|            and self.outcome is None\n   816|        ):\n   817|            raise ValueError(\n   818|                f\"LedgerEvent with terminal event_type \"\n   819|                f\"{self.event_type.value} must have an outcome when \"\n   820|                f\"persistence_status is durable\"\n   821|            )\n   822|\n   823|        # Persistence-failed events must have persistence_failed or\n   824|        # indeterminate status.\n   825|        if self.event_type == AttemptEventType.PERSISTENCE_FAILED:\n   826|            if self.persistence_status not in (\n   827|                PersistenceStatus.PERSISTENCE_FAILED,\n   828|                PersistenceStatus.INDETERMINATE,\n   829|            ):\n   830|                raise ValueError(\n   831|                    f\"LedgerEvent with event_type persistence_failed must \"\n   832|                    f\"have persistence_status of persistence_failed or \"\n   833|                    f\"indeterminate, got {self.persistence_status.value}\"\n   834|                )\n   835|\n   836|        # External effect intent must have a payload with the effect ref.\n   837|        if self.event_type == AttemptEventType.EXTERNAL_EFFECT_INTENT:\n   838|            if self.payload is None and self.payload_policy_ref is None:\n   839|                raise ValueError(\n   840|                    \"LedgerEvent with event_type external_effect_intent \"\n   841|                    \"must have a payload or payload_policy_ref\"\n   842|                )\n   843|\n   844|    @property\n   845|    def position(self) -> LedgerPosition:\n   846|        \"\"\"Return the ledger position for this event.\"\"\"\n   847|        return LedgerPosition(\n   848|            sequence=self.sequence,\n   849|            append_position=self.append_position,\n   850|            causal_predecessor_sequence=self.causal_predecessor_sequence,\n   851|        )\n   852|\n   853|    @property\n   854|    def is_first_event(self) -> bool:\n   855|        \"\"\"True when this is the first event in the attempt stream.\"\"\"\n   856|        return self.causal_predecessor_sequence == 0\n   857|\n   858|    @property\n   859|    def is_terminal(self) -> bool:\n   860|        \"\"\"True when this event represents a terminal attempt state.\"\"\"\n   861|        return self.event_type in _TERMINAL_EVENT_TYPES\n   862|\n   863|    @property\n   864|    def is_persistence_compromised(self) -> bool:\n   865|        \"\"\"True when persistence has failed or is indeterminate.\"\"\"\n   866|        return self.persistence_status in (\n   867|            PersistenceStatus.PERSISTENCE_FAILED,\n   868|            PersistenceStatus.INDETERMINATE,\n   869|        )\n   870|\n   871|    def to_dict(self) -> dict[str, Any]:\n   872|        \"\"\"Return a sidecar-safe payload with primitive values.\"\"\"\n   873|        payload: dict[str, Any] = {\n   874|            \"idempotency_key\": self.idempotency_key,\n   875|            \"event_type\": self.event_type.value,\n   876|            \"event_schema_version\": self.event_schema_version,\n   877|            \"identity\": self.identity.to_dict(),\n   878|            \"provenance\": self.provenance.to_dict(),\n   879|            \"adapter\": self.adapter.to_dict(),\n   880|            \"versions\": self.versions.to_dict(),\n   881|            \"grant_ref\": self.grant_ref.to_dict(),\n   882|            \"sequence\": self.sequence,\n   883|            \"causal_predecessor_sequence\": self.causal_predecessor_sequence,\n   884|            \"append_position\": self.append_position,\n   885|            \"occurred_at\": self.occurred_at,\n   886|            \"observed_at\": self.observed_at,\n   887|            \"persistence_status\": self.persistence_status.value,\n   888|        }\n   889|        if self.outcome is not None:\n   890|            payload[\"outcome\"] = self.outcome.value\n   891|        if self.payload is not None:\n   892|            if isinstance(self.payload, DurableRef):\n   893|                payload[\"payload\"] = self.payload.to_dict()\n   894|            else:\n   895|                payload[\"payload\"] = self.payload\n   896|        if self.payload_policy_ref is not None:\n   897|            payload[\"payload_policy_ref\"] = self.payload_policy_ref\n   898|        return payload\n   899|\n   900|", "total_lines": 1460, "file_size": 54228, "truncated": true, "hint": "Use offset=900 to continue reading (showing 720-899 of 1460 lines)", "is_binary": false, "is_image": false}
./critique-ledger-m9-planner-prompt.txt:611:{"content": "   180|\n   181|\n   182|@dataclass(frozen=True)\n   183|class CritiqueOccurrenceEnvelope:\n   184|    \"\"\"A single critique occurrence produced by a model/producer during\n   185|    one critique round.\n   186|\n   187|    Identity fields:\n   188|      - occurrence_id: producer-local identity within the execution attempt\n   189|      - finding_id: producer-local canonical finding identity\n   190|      - semantic_finding_id: evaluator-assigned semantic finding identity\n   191|        (may differ from finding_id when evaluator reconciliation maps\n   192|        multiple occurrences to one finding)\n   193|\n   194|    All three identity fields are separately named and never conflated.\n   195|    \"\"\"\n   196|\n   197|    schema_version: str = SCHEMA_VERSION\n   198|    occurrence_id: str = \"\"\n   199|    attempt_id: str = \"\"\n   200|    round_label: str = \"\"\n   201|    finding_id: str = \"\"\n   202|    semantic_finding_id: str = \"\"\n   203|    producer_id: str = \"\"\n   204|    model_id: str = \"\"\n   205|    context_mode: str = ContextMode.BLIND.value\n   206|    parse_status: str = ParseStatus.SELECTED.value\n   207|    evidence_availability: str = EvidenceAvailability.RETAINED.value\n   208|    evidence_ref: Optional[str] = None\n   209|    redacted_prompt_hash: Optional[str] = None\n   210|    raw_prompt_hash: Optional[str] = None\n   211|    raw_completion_hash: Optional[str] = None\n   212|    unavailable_reason: Optional[str] = None\n   213|    reopen_condition: Optional[str] = None\n   214|    custody_receipt_refs: tuple[str, ...] = ()\n   215|    metadata: dict[str, Any] = field(default_factory=dict)\n   216|    _extra: dict[str, Any] = field(default_factory=dict)\n   217|\n   218|    def to_dict(self, mode: str = \"strict\") -> dict[str, Any]:\n   219|        \"\"\"Serialize to a plain dict.\n   220|\n   221|        Args:\n   222|            mode: 'strict' rejects unknown extra fields.\n   223|                  'preserve' includes _extra fields.\n   224|        \"\"\"\n   225|        result: dict[str, Any] = {\n   226|            \"schema_version\": self.schema_version,\n   227|            \"occurrence_id\": self.occurrence_id,\n   228|            \"attempt_id\": self.attempt_id,\n   229|            \"round_label\": self.round_label,\n   230|            \"finding_id\": self.finding_id,\n   231|            \"semantic_finding_id\": self.semantic_finding_id,\n   232|            \"producer_id\": self.producer_id,\n   233|            \"model_id\": self.model_id,\n   234|            \"context_mode\": self.context_mode,\n   235|            \"parse_status\": self.parse_status,\n   236|            \"evidence_availability\": self.evidence_availability,\n   237|            \"evidence_ref\": self.evidence_ref,\n   238|            \"redacted_prompt_hash\": self.redacted_prompt_hash,\n   239|            \"raw_prompt_hash\": self.raw_prompt_hash,\n   240|            \"raw_completion_hash\": self.raw_completion_hash,\n   241|            \"unavailable_reason\": self.unavailable_reason,\n   242|            \"reopen_condition\": self.reopen_condition,\n   243|            \"custody_receipt_refs\": list(self.custody_receipt_refs),\n   244|            \"metadata\": dict(self.metadata),\n   245|        }\n   246|        if mode == \"preserve\" and self._extra:\n   247|            result.update(self._extra)\n   248|        return result\n   249|\n   250|    @classmethod\n   251|    def from_dict(cls, data: dict[str, Any], mode: str = \"strict\") -> \"CritiqueOccurrenceEnvelope\":\n   252|        \"\"\"Deserialize from a plain dict.\n   253|\n   254|        Args:\n   255|            data: The dict to deserialize.\n   256|            mode: 'strict' rejects unknown fields.\n   257|                  'preserve' stores unknown fields in _extra.\n   258|\n   259|        Raises:\n   260|            ValueError: if mode is 'strict' and unknown fields are present,\n   261|                        or if schema_version is unsupported.\n   262|        \"\"\"\n   263|        version = data.get(\"schema_version\", SCHEMA_VERSION)\n   264|        if version not in SUPPORTED_VERSIONS:\n   265|            raise ValueError(\n   266|                f\"Unsupported schema_version: {version!r}. \"\n   267|                f\"Supported: {SUPPORTED_VERSIONS}\"\n   268|            )\n   269|\n   270|        known_fields = {\n   271|            \"schema_version\", \"occurrence_id\", \"attempt_id\", \"round_label\",\n   272|            \"finding_id\", \"semantic_finding_id\", \"producer_id\", \"model_id\",\n   273|            \"context_mode\", \"parse_status\", \"evidence_availability\",\n   274|            \"evidence_ref\", \"redacted_prompt_hash\", \"raw_prompt_hash\",\n   275|            \"raw_completion_hash\", \"unavailable_reason\", \"reopen_condition\",\n   276|            \"custody_receipt_refs\", \"metadata\",\n   277|        }\n   278|        extra = {}\n   279|        for key in data:\n   280|            if key not in known_fields and key != \"_extra\":\n   281|                if mode == \"strict\":\n   282|                    raise ValueError(\n   283|                        f\"Unknown field {key!r} in strict mode. \"\n   284|                        f\"Use mode='preserve' to retain unknown fields.\"\n   285|                    )\n   286|                extra[key] = data[key]\n   287|\n   288|        custody = tuple(data.get(\"custody_receipt_refs\", ()))\n   289|        return cls(\n   290|            schema_version=version,\n   291|            occurrence_id=data.get(\"occurrence_id\", \"\"),\n   292|            attempt_id=data.get(\"attempt_id\", \"\"),\n   293|            round_label=data.get(\"round_label\", \"\"),\n   294|            finding_id=data.get(\"finding_id\", \"\"),\n   295|            semantic_finding_id=data.get(\"semantic_finding_id\", \"\"),\n   296|            producer_id=data.get(\"producer_id\", \"\"),\n   297|            model_id=data.get(\"model_id\", \"\"),\n   298|            context_mode=data.get(\"context_mode\", ContextMode.BLIND.value),\n   299|            parse_status=data.get(\"parse_status\", ParseStatus.SELECTED.value),\n   300|            evidence_availability=data.get(\n   301|                \"evidence_availability\", EvidenceAvailability.RETAINED.value\n   302|            ),\n   303|            evidence_ref=data.get(\"evidence_ref\"),\n   304|            redacted_prompt_hash=data.get(\"redacted_prompt_hash\"),\n   305|            raw_prompt_hash=data.get(\"raw_prompt_hash\"),\n   306|            raw_completion_hash=data.get(\"raw_completion_hash\"),\n   307|            unavailable_reason=data.get(\"unavailable_reason\"),\n   308|            reopen_condition=data.get(\"reopen_condition\"),\n   309|            custody_receipt_refs=custody,\n   310|            metadata=dict(data.get(\"metadata\", {})),\n   311|            _extra=extra,\n   312|        )\n   313|\n   314|\n   315|@dataclass(frozen=True)\n   316|class FindingReconciliationEvent:\n   317|    \"\"\"An evaluator-supplied reconciliation event that maps one or more\n   318|    occurrences to a single semantic finding.\n   319|\n   320|    The reconciliation identity (reconciliation_id) is separate from the\n   321|    canonical finding identity (canonical_finding_id) and the semantic\n   322|    finding identity (semantic_finding_id). All three are distinct.\n   323|    \"\"\"\n   324|\n   325|    schema_version: str = SCHEMA_VERSION\n   326|    reconciliation_id: str = \"\"\n   327|    canonical_finding_id: str = \"\"\n   328|    semantic_finding_id: str = \"\"\n   329|    occurrence_ids: tuple[str, ...] = ()\n   330|    relationship: str = Relationship.DUPLICATE.value\n   331|    authority: str = Authority.EVALUATOR.value\n   332|    reason: str = \"\"\n   333|    evidence_refs: tuple[str, ...] = ()\n   334|    is_reopen: bool = False\n   335|    reopen_condition: Optional[str] = None\n   336|    timestamp_utc: str = \"\"\n   337|    metadata: dict[str, Any] = field(default_factory=dict)\n   338|    _extra: dict[str, Any] = field(default_factory=dict)\n   339|\n   340|    def to_dict(self, mode: str = \"strict\") -> dict[str, Any]:\n   341|        result: dict[str, Any] = {\n   342|            \"schema_version\": self.schema_version,\n   343|            \"reconciliation_id\": self.reconciliation_id,\n   344|            \"canonical_finding_id\": self.canonical_finding_id,\n   345|            \"semantic_finding_id\": self.semantic_finding_id,\n   346|            \"occurrence_ids\": list(self.occurrence_ids),\n   347|            \"relationship\": self.relationship,\n   348|            \"authority\": self.authority,\n   349|            \"reason\": self.reason,\n   350|            \"evidence_refs\": list(self.evidence_refs),\n   351|            \"is_reopen\": self.is_reopen,\n   352|            \"reopen_condition\": self.reopen_condition,\n   353|            \"timestamp_utc\": self.timestamp_utc,\n   354|            \"metadata\": dict(self.metadata),\n   355|        }\n   356|        if mode == \"preserve\" and self._extra:\n   357|            result.update(self._extra)\n   358|        return result\n   359|\n   360|    @classmethod\n   361|    def from_dict(\n   362|        cls, data: dict[str, Any], mode: str = \"strict\"\n   363|    ) -> \"FindingReconciliationEvent\":\n   364|        version = data.get(\"schema_version\", SCHEMA_VERSION)\n   365|        if version not in SUPPORTED_VERSIONS:\n   366|            raise ValueError(\n   367|                f\"Unsupported schema_version: {version!r}\"\n   368|            )\n   369|\n   370|        known_fields = {\n   371|            \"schema_version\", \"reconciliation_id\", \"canonical_finding_id\",\n   372|            \"semantic_finding_id\", \"occurrence_ids\", \"relationship\",\n   373|            \"authority\", \"reason\", \"evidence_refs\", \"is_reopen\",\n   374|            \"reopen_condition\", \"timestamp_utc\", \"metadata\",\n   375|        }\n   376|        extra = {}\n   377|        for key in data:\n   378|            if key not in known_fields and key != \"_extra\":\n   379|                if mode == \"strict\":\n   380|                    raise ValueError(f\"Unknown field {key!r} in strict mode.\")\n   381|                extra[key] = data[key]\n   382|\n   383|        return cls(\n   384|            schema_version=version,\n   385|            reconciliation_id=data.get(\"reconciliation_id\", \"\"),\n   386|            canonical_finding_id=data.get(\"canonical_finding_id\", \"\"),\n   387|            semantic_finding_id=data.get(\"semantic_finding_id\", \"\"),\n   388|            occurrence_ids=tuple(data.get(\"occurrence_ids\", ())),\n   389|            relationship=data.get(\"relationship\", Relationship.DUPLICATE.value),\n   390|            authority=data.g...ty\", Authority.EVALUATOR.value),\n   391|            reason=data.get(\"reason\", \"\"),\n   392|            evidence_refs=tuple(data.get(\"evidence_refs\", ())),\n   393|            is_reopen=data.get(\"is_reopen\", False),\n   394|            reopen_condition=data.get(\"reopen_condition\"),\n   395|            timestamp_utc=data.get(\"timestamp_utc\", \"\"),\n   396|            metadata=dict(data.get(\"metadata\", {})),\n   397|            _extra=extra,\n   398|        )\n   399|\n   400|\n   401|@dataclass(frozen=True)\n   402|class FindingDispositionEvent:\n   403|    \"\"\"An evaluator-assigned disposition for a semantic finding.\n   404|\n   405|    Eight canonical families with reason subcodes, orthogonal severity,\n   406|    evidence limits, action/non-action, accountable scope, and reopen\n   407|    predicates.\n   408|    \"\"\"\n   409|\n   410|    schema_version: str = SCHEMA_VERSION\n   411|    disposition_id: str = \"\"\n   412|    semantic_finding_id: str = \"\"\n   413|    family: str = DispositionFamily.UNKNOWN.value\n   414|    reason_subcode: str = \"\"\n   415|    severity: str = \"\"\n   416|    action_taken: bool = False\n   417|    action_description: Optional[str] = None\n   418|    accountable_scope: str = \"\"\n   419|    is_reopen: bool = False\n   420|    reopen_predicate: Optional[str] = None\n   421|    evidence_refs: tuple[str, ...] = ()\n   422|    authority: str = Authority.EVALUATOR.value\n   423|    timestamp_utc: str = \"\"\n   424|    metadata: dict[str, Any] = field(default_factory=dict)\n   425|    _extra: dict[str, Any] = field(default_factory=dict)\n   426|\n   427|    def to_dict(self, mode: str = \"strict\") -> dict[str, Any]:\n   428|        result: dict[str, Any] = {\n   429|            \"schema_version\": self.schema_version,\n   430|            \"disposition_id\": self.disposition_id,\n   431|            \"semantic_finding_id\": self.semantic_finding_id,\n   432|            \"family\": self.family,\n   433|            \"reason_subcode\": self.reason_subcode,\n   434|            \"severity\": self.severity,\n   435|            \"action_taken\": self.action_taken,\n   436|            \"action_description\": self.action_description,\n   437|            \"accountable_scope\": self.accountable_scope,\n   438|            \"is_reopen\": self.is_reopen,\n   439|            \"reopen_predicate\": self.reopen_predicate,\n   440|            \"evidence_refs\": list(self.evidence_refs),\n   441|            \"authority\": self.authority,\n   442|            \"timestamp_utc\": self.timestamp_utc,\n   443|            \"metadata\": dict(self.metadata),\n   444|        }\n   445|        if mode == \"preserve\" and self._extra:\n   446|            result.update(self._extra)\n   447|        return result\n   448|\n   449|    @classmethod\n   450|    def from_dict(\n   451|        cls, data: dict[str, Any], mode: str = \"strict\"\n   452|    ) -> \"FindingDispositionEvent\":\n   453|        version = data.get(\"schema_version\", SCHEMA_VERSION)\n   454|        if version not in SUPPORTED_VERSIONS:\n   455|            raise ValueError(f\"Unsupported schema_version: {version!r}\")\n   456|\n   457|        known_fields = {\n   458|            \"schema_version\", \"disposition_id\", \"semantic_finding_id\",\n   459|            \"family\", \"reason_subcode\", \"severity\", \"action_taken\",\n   460|            \"action_description\", \"accountable_scope\", \"is_reopen\",\n   461|            \"reopen_predicate\", \"evidence_refs\", \"authority\",\n   462|            \"timestamp_utc\", \"metadata\",\n   463|        }\n   464|        extra = {}\n   465|        for key in data:\n   466|            if key not in known_fields and key != \"_extra\":\n   467|                if mode == \"strict\":\n   468|                    raise ValueError(f\"Unknown field {key!r} in strict mode.\")\n   469|                extra[key] = data[key]\n   470|\n   471|        return cls(\n   472|            schema_version=version,\n   473|            disposition_id=data.get(\"disposition_id\", \"\"),\n   474|            semantic_finding_id=data.get(\"semantic_finding_id\", \"\"),\n   475|            family=data.get(\"family\", DispositionFamily.UNKNOWN.value),\n   476|            reason_subcode=data.get(\"reason_subcode\", \"\"),\n   477|            severity=data.get(\"severity\", \"\"),\n   478|            action_taken=data.get(\"action_taken\", False),\n   479|            action_description=data.get(\"action_description\"),\n   480|            accountable_scope=data.get(\"accountable_scope\", \"\"),\n   481|            is_reopen=data.get(\"is_reopen\", False),\n   482|            reopen_predicate=data.get(\"reopen_predicate\"),\n   483|            evidence_refs=tuple(data.get(\"evidence_refs\", ())),\n   484|            authority=data.g...ty\", Authority.EVALUATOR.value),\n   485|            timestamp_utc=data.get(\"timestamp_utc\", \"\"),\n   486|            metadata=dict(data.get(\"metadata\", {})),\n   487|            _extra=extra,\n   488|        )\n   489|\n   490|\n   491|# ══════════════════════════════════════════════════════════════════════\n   492|# Provisional CL1 briefing budgets\n   493|# ══════════════════════════════════════════════════════════════════════\n   494|\n   495|BRIEFING_BUDGETS = {\n   496|    \"standard\": {\"max_domains\": 2, \"max_findings\": 10},\n   497|    \"high\": {\"max_domains\": 4, \"max_findings\": 25},\n   498|    \"exhaustive\": {\"max_domains\": None, \"max_findings\": None},  # all / unbounded\n   499|}\n   500|\n   501|\n   502|@dataclass(frozen=True)\n   503|class DomainBriefingEnvelope:\n   504|    \"\"\"A domain-scoped briefing built from an accepted LedgerRevisionManifest.\n   505|\n   506|    Provisional CL1 budgets:\n   507|      - standard: 2 domains / 10 findings\n   508|      - high: 4 domains / 25 findings\n   509|      - exhaustive: all catalog domains / unbounded\n   510|\n   511|    All budgets enforce mandatory domain floors. Overflow findings are\n   512|    linked via spillover references — never silently truncated.\n   513|    Silent truncation must raise an error.\n   514|    \"\"\"\n   515|\n   516|    schema_version: str = SCHEMA_VERSION\n   517|    briefing_id: str = \"\"\n   518|    revision_manifest_hash: str = \"\"\n   519|    budget_level: str = \"standard\"\n   520|    domains: tuple[str, ...] = ()\n   521|    findings: tuple[str, ...] = ()\n   522|    open_findings: tuple[str, ...] = ()\n   523|    blocked_findings: tuple[str, ...] = ()\n   524|    accepted_risk_findings: tuple[str, ...] = ()\n   525|    unknown_findings: tuple[str, ...] = ()\n   526|    cross_domain_refs: tuple[str, ...] = ()\n   527|    spillover_findings: tuple[str, ...] = ()\n   528|    no_additional_findings: bool = False\n   529|    no_open_blocking_findings: bool = False\n   530|", "total_lines": 731, "file_size": 30687, "truncated": true, "hint": "Use offset=530 to continue reading (showing 180-529 of 731 lines)", "is_binary": false, "is_image": false}
./critique-ledger-m9-planner-prompt.txt:643:{"content": "   940|        # Occurrence stats\n   941|        \"total_occurrences\": len(occurrences),\n   942|        \"occurrence_failed_dropped_malformed\": failed_count,\n   943|        # Reopen\n   944|        \"reopen_event_count\": reopen_count,\n   945|        # Unavailable evidence\n   946|        \"unavailable_evidence\": unavailable_evidence,\n   947|        # Budget\n   948|        \"budget_level\": briefing.budget_level,\n   949|        \"is_truncated\": briefing.is_truncated,\n   950|        # Four no-X fields\n   951|        \"no_open_blocking_findings\": briefing.no_open_blocking_findings,\n   952|        \"no_additional_findings\": briefing.no_additional_findings,\n   953|        \"no_known_findings\": briefing.no_known_findings,\n   954|        \"no_adjacent_text_match\": briefing.no_adjacent_text_match,\n   955|        # No verdict fields\n   956|    }\n   957|\n   958|\n   959|# ══════════════════════════════════════════════════════════════════════\n   960|# Phase 7: Complete replay\n   961|# ══════════════════════════════════════════════════════════════════════\n   962|\n   963|\n   964|def replay_full(\n   965|    occurrences: list[CritiqueOccurrenceEnvelope],\n   966|    reconciliations: list[FindingReconciliationEvent],\n   967|    dispositions: list[FindingDispositionEvent],\n   968|    wbc_receipt_chain: dict[str, Any] | None = None,\n   969|    budget_level: str = \"standard\",\n   970|    domain_assignments: dict[str, str] | None = None,\n   971|    domain_completeness: dict[str, bool] | None = None,\n   972|    allow_reopen: bool = True,\n   973|    prior_manifest: LedgerRevisionManifest | None = None,\n   974|    expected_prior_revision_hash: str | None = None,\n   975|) -> dict[str, Any]:\n   976|    \"\"\"Execute a complete semantic loop replay.\n   977|\n   978|    Runs all phases in order: custody → reconciliation → disposition →\n   979|    manifest → briefing → projections. Fails before projections if any\n   980|    phase produces a typed validation failure.\n   981|\n   982|    Args:\n   983|        occurrences: All critique occurrence envelopes.\n   984|        reconciliations: Ordered reconciliation events.\n   985|        dispositions: Ordered disposition events.\n   986|        wbc_receipt_chain: WBC receipt chain for custody validation.\n   987|        budget_level: Briefing budget level.\n   988|        domain_assignments: Semantic finding → domain assignments.\n   989|        domain_completeness: Domain → is_complete map.\n   990|        allow_reopen: Whether REOPEN events are permitted.\n   991|\n   992|    Returns:\n   993|        Dict with keys: custody, reconciliation, disposition, manifest,\n   994|        briefing, reviser_projection, gate_projection.\n   995|\n   996|    Raises:\n   997|        SemanticLoopError: If any phase fails validation, before any\n   998|            projection is produced.\n   999|    \"\"\"\n  1000|    if wbc_receipt_chain is None:\n  1001|        wbc_receipt_chain = {}\n  1002|\n  1003|    # Phase 0: Pre-validate occurrences and attempt lifecycle.  Metadata\n  1004|    # fields are optional for imported legacy rows; when present they are\n  1005|    # enforced rather than guessed.\n  1006|    occurrence_ids: set[str] = set()\n  1007|    for occ in occurrences:\n  1008|        if occ.schema_version != SCHEMA_VERSION:\n  1009|            raise SemanticLoopError(\n  1010|                mode=FailureMode.SCHEMA_INCOMPATIBLE,\n  1011|                detail=f\"Occurrence {occ.occurrence_id} uses {occ.schema_version}\",\n  1012|            )\n  1013|        if occ.parse_status == ParseStatus.FAILED.value:\n  1014|            raise SemanticLoopError(\n  1015|                mode=FailureMode.OCCURRENCE_PARSE_FAILED,\n  1016|                detail=f\"Occurrence {occ.occurrence_id} has parse_status=FAILED\",\n  1017|            )\n  1018|        if occ.parse_status == ParseStatus.DROPPED.value:\n  1019|            raise SemanticLoopError(\n  1020|                mode=FailureMode.ATTEMPT_DROPPED,\n  1021|                detail=f\"Occurrence {occ.occurrence_id} was dropped\",\n  1022|            )\n  1023|        if not occ.occurrence_id:\n  1024|            raise SemanticLoopError(\n  1025|                mode=FailureMode.OCCURRENCE_MISSING_ID,\n  1026|                detail=\"Occurrence has empty occurrence_id\",\n  1027|            )\n  1028|        if occ.occurrence_id in occurrence_ids:\n  1029|            raise SemanticLoopError(\n  1030|                mode=FailureMode.OCCURRENCE_DUPLICATE_ID,\n  1031|                detail=f\"Duplicate occurrence_id {occ.occurrence_id}\",\n  1032|            )\n  1033|        occurrence_ids.add(occ.occurrence_id)\n  1034|        if occ.metadata.get(\"start_persisted\") is False:\n  1035|            raise SemanticLoopError(\n  1036|                mode=FailureMode.START_PERSISTENCE_FAILED,\n  1037|                detail=f\"Attempt {occ.attempt_id} lacks durable start evidence\",\n  1038|            )\n  1039|        if occ.metadata.get(\"terminal_persisted\") is False:\n  1040|            raise SemanticLoopError(\n  1041|                mode=FailureMode.TERMINAL_PERSISTENCE_FAILED,\n  1042|                detail=f\"Attempt {occ.attempt_id} lacks durable terminal evidence\",\n  1043|            )\n  1044|        terminal_count = occ.metadata.get(\"terminal_outcome_count\", 1)\n  1045|        if terminal_count != 1:\n  1046|            raise SemanticLoopError(\n  1047|                mode=FailureMode.TERMINAL_OUTCOME_INVALID,\n  1048|                detail=(\n  1049|                    f\"Attempt {occ.attempt_id} has {terminal_count} terminal \"\n  1050|                    \"outcomes; exactly one is required\"\n  1051|                ),\n  1052|            )\n  1053|        if \"owner\" in occ.metadata and not occ.metadata.get(\"owner\"):\n  1054|            raise SemanticLoopError(\n  1055|                mode=FailureMode.OWNERSHIP_MISSING,\n  1056|                detail=f\"Occurrence {occ.occurrence_id} has no owner\",\n  1057|            )\n  1058|        if occ.metadata.get(\"evidence_fresh\") is False:\n  1059|            raise SemanticLoopError(\n  1060|                mode=FailureMode.EVIDENCE_STALE,\n  1061|                detail=f\"Occurrence {occ.occurrence_id} evidence is stale\",\n  1062|            )\n  1063|        if (\n  1064|            occ.metadata.get(\"required_for_briefing\") is True\n  1065|            and occ.evidence_availability == EvidenceAvailability.UNAVAILABLE.value\n  1066|        ):\n  1067|            raise SemanticLoopError(\n  1068|                mode=FailureMode.BRIEFING_INPUT_UNAVAILABLE,\n  1069|                detail=f\"Required briefing input {occ.occurrence_id} is unavailable\",\n  1070|            )\n  1071|        if (\n  1072|            occ.parse_status == ParseStatus.TOMBSTONED.value\n  1073|            and not occ.metadata.get(\"tombstone_reason\")\n  1074|        ):\n  1075|            raise SemanticLoopError(\n  1076|                mode=FailureMode.TOMBSTONE_INVALID,\n  1077|                detail=f\"Tombstone {occ.occurrence_id} lacks tombstone_reason\",\n  1078|            )\n  1079|\n  1080|    valid_authorities=*** for item in Authority}\n  1081|    for event in [*reconciliations, *dispositions]:\n  1082|        if event.schema_version != SCHEMA_VERSION:\n  1083|            raise SemanticLoopError(\n  1084|                mode=FailureMode.SCHEMA_INCOMPATIBLE,\n  1085|                detail=f\"Event uses incompatible schema {event.schema_version}\",\n  1086|            )\n  1087|        if event.authority not in valid_authorities:\n  1088|            raise SemanticLoopError(\n  1089|                mode=FailureMode.OWNERSHIP_MISSING,\n  1090|                detail=\"Semantic event lacks accepted evaluator/curator authority\",\n  1091|            )\n  1092|\n  1093|    # Phase 1: Custody\n  1094|    custody_result = validate_occurrence_custody(occurrences, wbc_receipt_chain)\n  1095|    if not custody_result[\"valid\"]:\n  1096|        raise SemanticLoopError(\n  1097|            mode=custody_result[\"failures\"][0][\"mode\"],\n  1098|            detail=custody_result[\"failures\"][0].get(\"detail\", \"Custody validation failed\"),\n  1099|            failures=custody_result[\"failures\"],\n  1100|        )\n  1101|\n  1102|    # Phase 2: Reconciliation\n  1103|    rec_result = apply_reconciliation_events(occurrences, reconciliations, allow_reopen=allow_reopen)\n  1104|    hard_failures = [\n  1105|        f for f in rec_result[\"failures\"]\n  1106|        if f[\"mode\"] != FailureMode.RECONCILIATION_INFERRED_SAMENESS.value\n  1107|    ]\n  1108|    if hard_failures:\n  1109|        raise SemanticLoopError(\n  1110|            mode=hard_failures[0][\"mode\"],\n  1111|            detail=hard_failures[0].get(\"detail\", \"Reconciliation failed\"),\n  1112|            failures=rec_result[\"failures\"],\n  1113|        )\n  1114|\n  1115|    mapped_counts: dict[str, int] = {}\n  1116|    for mapped_ids in rec_result[\"finding_map\"].values():\n  1117|        for occurrence_id in mapped_ids:\n  1118|            mapped_counts[occurrence_id] = mapped_counts.get(occurrence_id, 0) + 1\n  1119|    parseable_ids = {\n  1120|        occ.occurrence_id\n  1121|        for occ in occurrences\n  1122|        if occ.parse_status in {ParseStatus.SELECTED.value, ParseStatus.COMPLETED.value}\n  1123|    }\n  1124|    unmapped = sorted(parseable_ids - set(mapped_counts))\n  1125|    if unmapped:\n  1126|        raise SemanticLoopError(\n  1127|            mode=FailureMode.OCCURRENCE_UNMAPPED,\n  1128|            detail=f\"Parseable occurrences lack reconciliation: {unmapped}\",\n  1129|        )\n  1130|    multiply_mapped = sorted(\n  1131|        occurrence_id for occurrence_id, count in mapped_counts.items() if count != 1\n  1132|    )\n  1133|    if multiply_mapped:\n  1134|        raise SemanticLoopError(\n  1135|            mode=FailureMode.OCCURRENCE_MULTIPLY_MAPPED,\n  1136|            detail=f\"Occurrences map to multiple semantic findings: {multiply_mapped}\",\n  1137|        )\n  1138|\n  1139|    # Phase 3: Disposition\n  1140|    disp_result = apply_disposition_events(rec_result[\"finding_map\"], dispositions)\n  1141|    if not disp_result[\"accepted\"]:\n  1142|        raise SemanticLoopError(\n  1143|            mode=disp_result[\"failures\"][0][\"mode\"],\n  1144|            detail=disp_result[\"failures\"][0].get(\"detail\", \"Disposition failed\"),\n  1145|            failures=disp_result[\"failures\"],\n  1146|        )\n  1147|    unsupported_closures = [\n  1148|        disp.disposition_id\n  1149|        for disp in dispositions\n  1150|        if (\n  1151|            disp.family == DispositionFamily.RESOLVED.value\n  1152|            and (not disp.evidence_refs or not disp.reason_subcode)\n  1153|        )\n  1154|    ]\n  1155|    if unsupported_closures:\n  1156|        raise SemanticLoopError(\n  1157|            mode=FailureMode.CLOSURE_UNSUPPORTED,\n  1158|            detail=f\"Resolved dispositions lack reason/evidence: {unsupported_closures}\",\n  1159|        )\n  1160|\n  1161|    # Phase 4: Manifest\n  1162|    manifest = construct_manifest(\n  1163|        occurrences, rec_result, disp_result,\n  1164|        domain_completeness=domain_completeness,\n  1165|        prior_manifest=prior_manifest,\n  1166|        expected_prior_revision_hash=expected_prior_revision_hash,\n  1167|    )\n  1168|\n  1169|    # Phase 5: Briefing\n  1170|    briefing = build_briefing(\n  1171|        manifest, disp_result, rec_result[\"finding_map\"],\n  1172|        budget_level=budget_level,\n  1173|        domain_assignments=domain_assignments,\n  1174|    )\n  1175|\n  1176|    # Phase 6: Projections\n  1177|    reviser = project_reviser_input(manifest, briefing, occurrences, disp_result)\n  1178|    gate = project_gate_input(\n  1179|        manifest, briefing, occurrences,\n  1180|        rec_result, disp_result, custody_result,\n  1181|    )\n  1182|\n  1183|    projection_fields = (\n  1184|        \"no_open_blocking_findings\",\n  1185|        \"no_additional_findings\",\n  1186|        \"no_known_findings\",\n  1187|        \"no_adjacent_text_match\",\n  1188|    )\n  1189|    if any(\n  1190|        reviser[field] != gate[field] or reviser[field] != getattr(briefing, field)\n  1191|        for field in projection_fields\n  1192|    ):\n  1193|        raise SemanticLoopError(\n  1194|            mode=FailureMode.REPLAY_PROJECTION_MISMATCH,\n  1195|            detail=\"Reviser, gate, and briefing projections disagree\",\n  1196|        )\n  1197|\n  1198|    return {\n  1199|        \"custody\": custody_result,\n  1200|        \"reconciliation\": rec_result,\n  1201|        \"disposition\": disp_result,\n  1202|        \"manifest\": manifest,\n  1203|        \"briefing\": briefing,\n  1204|        \"reviser_projection\": reviser,\n  1205|        \"gate_projection\": gate,\n  1206|    }\n  1207|", "total_lines": 1206, "file_size": 48088, "truncated": false, "is_binary": false, "is_image": false}
./critique-ledger-m9-planner-prompt.txt:672:{"content": "   400|      \"blocker\": \"PC-SCOPE-BLOCKER-001\",\n   401|      \"detail\": \"Portfolio gate PC scope decision is machine-generated with blocker PC-SCOPE-BLOCKER-001. Human approval is required but not recorded.\",\n   402|      \"source\": \"evidence/pc-scope-decision.json\"\n   403|    },\n   404|    \"run_authority_m1_m3\": {\n   405|      \"status\": \"UNKNOWN\",\n   406|      \"detail\": \"Run Authority M1-M3 completion receipts all have accepted: false.\",\n   407|      \"source\": \"evidence/m6-proof-index.json\"\n   408|    }\n   409|  },\n   410|\n   411|  \"accepted_for_cl2\": {\n   412|    \"value\": false,\n   413|    \"derivation\": \"machine-checkable evidence — derived from live file hashes, gate verdict, review state, and blocker inventory at generation time\",\n   414|    \"checks\": {\n   415|      \"cl1_must_gates_pass\": {\n   416|        \"passed\": true,\n   417|        \"detail\": \"All CL1 must-gates pass: custody, freshness, replay equality, authority, schema, and prerequisite checks are complete and passing in cl1-semantic-loop-gate.json.\"\n   418|      },\n   419|      \"review_status_present\": {\n   420|        \"passed\": false,\n   421|        \"detail\": \"Reviewer sign-off is missing. reviewer_state.reviewed is false in cl1-semantic-loop-gate.json. Reviewer field is empty.\"\n   422|      },\n   423|      \"hashes_fresh\": {\n   424|        \"passed\": true,\n   425|        \"detail\": \"All hashes were recomputed from disk at generation time. No stale hash artifacts detected.\"\n   426|      },\n   427|      \"blocker_bearing_gaps_empty\": {\n   428|        \"passed\": false,\n   429|        \"detail\": \"Blocker-bearing gaps exist: (1) M6 prerequisite verification is INCOHERENT, (2) proof-index validation_passed is false, (3) 4 ownership blockers present, (4) portfolio gate PC-SCOPE-BLOCKER-001 is not approved, (5) reviewer sign-off is pending.\"\n   430|      }\n   431|    },\n   432|    \"blocking_reasons\": [\n   433|      \"review_status_not_present: reviewer_state.reviewed=false, no reviewer assigned\",\n   434|      \"m6_prerequisite_incoherent: M5 final attestation missing 3 bound artifacts\",\n   435|      \"proof_index_failed: validation_passed=false with 2 errors\",\n   436|      \"ownership_blockers: 4 blockers in ownership-decision-record\",\n   437|      \"portfolio_gate_blocked: PC-SCOPE-BLOCKER-001 requires human approval\"\n   438|    ],\n   439|    \"note\": \"accepted_for_cl2 is derived as the logical AND of all four machine-checkable conditions. Since review_status_present and blocker_bearing_gaps_empty both fail, accepted_for_cl2 is false. This value MUST be re-derived (not hard-coded) whenever the handoff is regenerated.\"\n   440|  }\n   441|}\n   442|", "total_lines": 441, "file_size": 21583, "truncated": false, "is_binary": false, "is_image": false}
./critique-ledger-m9-planner-prompt.txt:675:{"content": "     1|\"\"\"Tests for CL1 handoff document (cl1-contract-oracle.json).\n     2|\n     3|Validates accepted_for_cl2 derivation from machine-checkable evidence.\n     4|Negative tests cover: missing, stale, unreviewed, hash-mismatched, future-schema,\n     5|unavailable-evidence-without-reopen, and blocker-bearing inputs.\n     6|\"\"\"\n     7|import json\n     8|import os\n     9|import hashlib\n    10|import tempfile\n    11|import copy\n    12|from pathlib import Path\n    13|\n    14|import pytest\n    15|\n    16|\n    17|# ---------------------------------------------------------------------------\n    18|# Paths\n    19|# ---------------------------------------------------------------------------\n    20|\n    21|REPO_ROOT = Path(__file__).resolve().parent.parent.parent.parent\n    22|HANDOFF_PATH = REPO_ROOT / \"docs\" / \"critique-ledger\" / \"handoffs\" / \"cl1-contract-oracle.json\"\n    23|\n    24|# Files whose hashes are recorded in the handoff and must be recomputable\n    25|HASHED_PATHS = [\n    26|    (\"arnold/critique_ledger/semantic_loop.py\", \"schema_and_version_hashes.semantic_loop.sha256\"),\n    27|    (\"arnold/critique_ledger/schemas.py\", \"schema_and_version_hashes.occurrence_envelope_schema.sha256\"),\n    28|    (\"arnold/critique_ledger/__init__.py\", \"schema_and_version_hashes.module_init.sha256\"),\n    29|    (\"arnold_pipelines/megaplan/workflows/source_to_owner_matrix.json\", \"schema_and_version_hashes.owner_matrix_schema.sha256\"),\n    30|    (\"arnold_pipelines/megaplan/workflows/contract_to_producer_matrix.json\", \"schema_and_version_hashes.producer_matrix_schema.sha256\"),\n    31|    (\"tests/fixtures/critique_ledger/m6-corpus.json\", \"manifest_oracle_gate_hashes.m6_corpus_fixture.sha256\"),\n    32|    (\"docs/critique-ledger/evidence/m6-corpus-manifest.json\", \"manifest_oracle_gate_hashes.m6_corpus_manifest.sha256\"),\n    33|    (\"docs/critique-ledger/evidence/m6-oracle.json\", \"manifest_oracle_gate_hashes.m6_oracle.sha256\"),\n    34|    (\"docs/critique-ledger/evidence/cl1-semantic-loop-gate.json\", \"manifest_oracle_gate_hashes.cl1_semantic_loop_gate.sha256\"),\n    35|    (\"docs/critique-ledger/evidence/retention-class-mapping.json\", \"manifest_oracle_gate_hashes.retention_class_mapping.sha256\"),\n    36|    (\"docs/critique-ledger/evidence/failure-atomicity-table.json\", \"manifest_oracle_gate_hashes.failure_atomicity_table.sha256\"),\n    37|]\n    38|\n    39|\n    40|def _nested_get(d, dotted_path):\n    41|    \"\"\"Get a value from nested dict by dotted path.\"\"\"\n    42|    parts = dotted_path.split(\".\")\n    43|    for part in parts:\n    44|        if isinstance(d, dict):\n    45|            d = d[part]\n    46|        else:\n    47|            raise KeyError(dotted_path)\n    48|    return d\n    49|\n    50|\n    51|def _sha256_file(path):\n    52|    \"\"\"Compute SHA-256 of a file.\"\"\"\n    53|    h = hashlib.sha256()\n    54|    with open(path, \"rb\") as f:\n    55|        for chunk in iter(lambda: f.read(65536), b\"\"):\n    56|            h.update(chunk)\n    57|    return h.hexdigest()\n    58|\n    59|\n    60|def _load_handoff(path=None):\n    61|    \"\"\"Load the handoff JSON.\"\"\"\n    62|    p = path or HANDOFF_PATH\n    63|    with open(p, \"r\") as f:\n    64|        return json.load(f)\n    65|\n    66|\n    67|# ---------------------------------------------------------------------------\n    68|# Positive tests\n    69|# ---------------------------------------------------------------------------\n    70|\n    71|class TestHandoffDocument:\n    72|    \"\"\"Tests that the handoff document exists and is well-formed.\"\"\"\n    73|\n    74|    def test_handoff_exists(self):\n    75|        \"\"\"Handoff file must exist.\"\"\"\n    76|        assert HANDOFF_PATH.exists(), f\"Handoff missing: {HANDOFF_PATH}\"\n    77|\n    78|    def test_handoff_valid_json(self):\n    79|        \"\"\"Handoff must be valid JSON.\"\"\"\n    80|        doc = _load_handoff()\n    81|        assert isinstance(doc, dict)\n    82|\n    83|    def test_handoff_schema_version(self):\n    84|        \"\"\"Handoff must declare cl.handoff.v1 schema.\"\"\"\n    85|        doc = _load_handoff()\n    86|        assert doc[\"schema\"] == \"cl.handoff.v1\"\n    87|\n    88|    def test_handoff_has_required_sections(self):\n    89|        \"\"\"Handoff must have all required top-level sections.\"\"\"\n    90|        doc = _load_handoff()\n    91|        required = [\n    92|            \"schema_and_version_hashes\",\n    93|            \"owner_and_cutover_mappings\",\n    94|            \"wbc_merge_and_parent_references\",\n    95|            \"implementation_revision\",\n    96|            \"m6_source_revision\",\n    97|            \"custody_receipt_versions\",\n    98|            \"manifest_oracle_gate_hashes\",\n    99|            \"retention_and_atomicity_decisions\",\n   100|            \"domain_budgets\",\n   101|            \"authority_decisions\",\n   102|            \"limitations\",\n   103|            \"touchpoints\",\n   104|            \"open_gates\",\n   105|            \"accepted_for_cl2\",\n   106|        ]\n   107|        for section in required:\n   108|            assert section in doc, f\"Missing section: {section}\"\n   109|\n   110|    def test_accepted_for_cl2_is_derived_not_hard_coded(self):\n   111|        \"\"\"accepted_for_cl2.derivation must declare machine-checkable evidence.\"\"\"\n   112|        doc = _load_handoff()\n   113|        a = doc[\"accepted_for_cl2\"]\n   114|        assert \"derivation\" in a\n   115|        assert \"machine-checkable\" in a[\"derivation\"].lower()\n   116|        assert \"hard-coded\" not in a[\"derivation\"].lower()\n   117|\n   118|    def test_accepted_for_cl2_has_checks(self):\n   119|        \"\"\"accepted_for_cl2.checks must enumerate all four gate conditions.\"\"\"\n   120|        doc = _load_handoff()\n   121|", "total_lines": 523, "file_size": 23001, "truncated": true, "hint": "Use offset=121 to continue reading (showing 1-120 of 523 lines)", "is_binary": false, "is_image": false}
./critique-ledger-m9-planner-prompt.txt:704:{"content": "   121|        checks = doc[\"accepted_for_cl2\"][\"checks\"]\n   122|        expected = [\n   123|            \"cl1_must_gates_pass\",\n   124|            \"review_status_present\",\n   125|            \"hashes_fresh\",\n   126|            \"blocker_bearing_gaps_empty\",\n   127|        ]\n   128|        for key in expected:\n   129|            assert key in checks, f\"Missing check: {key}\"\n   130|            assert \"passed\" in checks[key], f\"Check {key} missing 'passed' field\"\n   131|            assert \"detail\" in checks[key], f\"Check {key} missing 'detail' field\"\n   132|\n   133|    def test_accepted_for_cl2_is_boolean(self):\n   134|        \"\"\"accepted_for_cl2.value must be a boolean.\"\"\"\n   135|        doc = _load_handoff()\n   136|        assert isinstance(doc[\"accepted_for_cl2\"][\"value\"], bool)\n   137|\n   138|    def test_accepted_for_cl2_matches_and_of_checks(self):\n   139|        \"\"\"accepted_for_cl2.value must equal the logical AND of all checks.\"\"\"\n   140|        doc = _load_handoff()\n   141|        checks = doc[\"accepted_for_cl2\"][\"checks\"]\n   142|        all_pass = all(c[\"passed\"] for c in checks.values())\n   143|        assert doc[\"accepted_for_cl2\"][\"value\"] == all_pass, (\n   144|            f\"accepted_for_cl2.value={doc['accepted_for_cl2']['value']} but AND of checks={all_pass}\"\n   145|        )\n   146|\n   147|\n   148|class TestHandoffHashesFresh:\n   149|    \"\"\"Tests that all hashes recorded in the handoff match recomputed values.\"\"\"\n   150|\n   151|    def test_all_recorded_hashes_fresh(self):\n   152|        \"\"\"Every recorded file hash must match the recomputed hash from disk.\"\"\"\n   153|        doc = _load_handoff()\n   154|        mismatches = []\n   155|        for rel_path, dotted_key in HASHED_PATHS:\n   156|            abs_path = REPO_ROOT / rel_path\n   157|            if not abs_path.exists():\n   158|                mismatches.append(f\"{rel_path}: file not found\")\n   159|                continue\n   160|            expected = _nested_get(doc, dotted_key)\n   161|            actual = _sha256_file(abs_path)\n   162|            if expected != actual:\n   163|                mismatches.append(f\"{rel_path}: expected={expected[:16]}... actual={actual[:16]}...\")\n   164|        assert not mismatches, f\"Hash mismatches: {mismatches}\"\n   165|\n   166|\n   167|class TestHandoffWBCAncestry:\n   168|    \"\"\"Tests WBC merge/parent references.\"\"\"\n   169|\n   170|    def test_wbc_merge_commit_present(self):\n   171|        \"\"\"WBC merge commit must be 24afce006.\"\"\"\n   172|        doc = _load_handoff()\n   173|        m = doc[\"wbc_merge_and_parent_references\"][\"wbc_merge_commit\"]\n   174|        assert m[\"full\"].startswith(\"24afce006\")\n   175|        assert m[\"short\"] == \"24afce006\"\n   176|\n   177|    def test_both_parents_recorded(self):\n   178|        \"\"\"Both merge parents must be recorded.\"\"\"\n   179|        doc = _load_handoff()\n   180|        parents = doc[\"wbc_merge_and_parent_references\"][\"merge_parents\"]\n   181|        assert len(parents) == 2\n   182|        roles = {p[\"role\"] for p in parents}\n   183|        assert roles == {\"first_parent\", \"second_parent\"}\n   184|\n   185|    def test_ancestry_verified(self):\n   186|        \"\"\"Ancestry must be marked verified.\"\"\"\n   187|        doc = _load_handoff()\n   188|        assert doc[\"wbc_merge_and_parent_references\"][\"ancestry_verified\"] is True\n   189|\n   190|\n   191|class TestHandoffOwnerMappings:\n   192|    \"\"\"Tests owner and cutover mapping correctness.\"\"\"\n   193|\n   194|    def test_four_owner_domains(self):\n   195|        \"\"\"Must have exactly 4 owner domains.\"\"\"\n   196|        doc = _load_handoff()\n   197|        domains = doc[\"owner_and_cutover_mappings\"][\"owner_domains\"]\n   198|        assert len(domains) == 4\n   199|        assert set(domains.keys()) == {\"run_authority\", \"maintenance\", \"wbc\", \"critique_ledger\"}\n   200|\n   201|    def test_critique_ledger_domain_has_one_writer(self):\n   202|        \"\"\"Critique ledger domain must have exactly one writer.\"\"\"\n   203|        doc = _load_handoff()\n   204|        cl = doc[\"owner_and_cutover_mappings\"][\"owner_domains\"][\"critique_ledger\"]\n   205|        assert cl[\"writer_count\"] == 1\n   206|\n   207|    def test_35_boundary_contracts(self):\n   208|        \"\"\"Must record 35 boundary contracts.\"\"\"\n   209|        doc = _load_handoff()\n   210|        bc = doc[\"owner_and_cutover_mappings\"][\"boundary_contracts\"]\n   211|        assert bc[\"count\"] == 35\n   212|\n   213|    def test_3_custody_contracts(self):\n   214|        \"\"\"Must record exactly 3 custody contracts.\"\"\"\n   215|        doc = _load_handoff()\n   216|        cc = doc[\"owner_and_cutover_mappings\"][\"custody_contracts\"]\n   217|        assert cc[\"count\"] == 3\n   218|        assert len(cc[\"contracts\"]) == 3\n   219|\n   220|    def test_reclassified_rows(self):\n   221|        \"\"\"9 rows reclassified as not_emitted_by_contract.\"\"\"\n   222|        doc = _load_handoff()\n   223|        rr = doc[\"owner_and_cutover_mappings\"][\"reclassified_rows\"]\n   224|        assert rr[\"count\"] == 9\n   225|        assert rr[\"new_producer_category\"] == \"not_emitted_by_contract\"\n   226|\n   227|\n   228|class TestHandoffDomainBudgets:\n   229|    \"\"\"Tests domain budget declarations.\"\"\"\n   230|\n   231|    def test_three_budget_levels(self):\n   232|        \"\"\"Must have standard, high, and exhaustive budgets.\"\"\"\n   233|        doc = _load_handoff()\n   234|        budgets = doc[\"domain_budgets\"]\n   235|        assert \"standard\" in budgets\n   236|        assert \"high\" in budgets\n   237|        assert \"exhaustive\" in budgets\n   238|\n   239|    def test_standard_budget_values(self):\n   240|        \"\"\"Standard budget: 2 domains, 10 findings.\"\"\"\n   241|        doc = _load_handoff()\n   242|        s = doc[\"domain_budgets\"][\"standard\"]\n   243|        assert s[\"max_domains\"] == 2\n   244|        assert s[\"max_findings\"] == 10\n   245|\n   246|    def test_high_budget_values(self):\n   247|        \"\"\"High budget: 4 domains, 25 findings.\"\"\"\n   248|        doc = _load_handoff()\n   249|        h = doc[\"domain_budgets\"][\"high\"]\n   250|        assert h[\"max_domains\"] == 4\n   251|        assert h[\"max_findings\"] == 25\n   252|\n   253|    def test_spillover_required(self):\n   254|        \"\"\"Spillover must be declared and silent truncation forbidden.\"\"\"\n   255|        doc = _load_handoff()\n   256|        assert \"silent truncation\" in doc[\"domain_budgets\"][\"spillover\"].lower()\n   257|\n   258|\n   259|class TestHandoffOpenGates:\n   260|    \"\"\"Tests that open gates are documented.\"\"\"\n   261|\n   262|    def test_reviewer_sign_off_pending(self):\n   263|        \"\"\"Reviewer sign-off must be recorded as pending.\"\"\"\n   264|        doc = _load_handoff()\n   265|        gates = doc[\"open_gates\"]\n   266|        assert \"reviewer_sign_off\" in gates\n   267|        assert gates[\"reviewer_sign_off\"][\"reviewed\"] is False\n   268|\n   269|    def test_m6_prerequisite_incoherent(self):\n   270|        \"\"\"M6 prerequisite verification INCOHERENT status recorded.\"\"\"\n   271|        doc = _load_handoff()\n   272|        gates = doc[\"open_gates\"]\n   273|        assert \"m6_prerequisite_verification\" in gates\n   274|        assert gates[\"m6_prerequisite_verification\"][\"status\"] == \"INCOHERENT\"\n   275|\n   276|    def test_proof_index_failed(self):\n   277|        \"\"\"Proof index validation failure recorded.\"\"\"\n   278|        doc = _load_handoff()\n   279|        gates = doc[\"open_gates\"]\n   280|        assert \"proof_index_validation\" in gates\n   281|        assert gates[\"proof_index_validation\"][\"validation_passed\"] is False\n   282|\n   283|\n   284|# ---------------------------------------------------------------------------\n   285|# Negative tests — accepted_for_cl2 derivation\n   286|# ---------------------------------------------------------------------------\n   287|\n   288|class TestAcceptedForCl2Negative:\n   289|    \"\"\"Negative tests proving accepted_for_cl2 is derived, not hard-coded.\"\"\"\n   290|\n   291|    def _make_altered_handoff(self, overrides, base_path=None):\n   292|        \"\"\"Load handoff, apply overrides via dotted path, return altered doc.\"\"\"\n   293|        doc = _load_handoff(base_path)\n   294|        for dotted_path, value in overrides.items():\n   295|            parts = dotted_path.split(\".\")\n   296|            target = doc\n   297|            for part in parts[:-1]:\n   298|                target = target[part]\n   299|            target[parts[-1]] = value\n   300|        return doc\n   301|", "total_lines": 523, "file_size": 23001, "truncated": true, "hint": "Use offset=301 to continue reading (showing 121-300 of 523 lines)", "is_binary": false, "is_image": false}
./critique-ledger-m9-planner-prompt.txt:736:{"content": "     1|\"\"\"Fail-closed custody for critique findings across planning stages.\n     2|\n     3|The model-facing critique schema is not an authority boundary.  This module\n     4|materializes every flagged finding as a stable flag, writes an immutable\n     5|production receipt, joins every receipt to explicit resolution evidence, and\n     6|binds the resulting clearance to the exact finalized task graph.\n     7|\"\"\"\n     8|\n     9|from __future__ import annotations\n    10|\n    11|import hashlib\n    12|import json\n    13|import re\n    14|from pathlib import Path\n    15|from typing import Any, Mapping, Sequence\n    16|\n    17|from arnold_pipelines.megaplan._core import (\n    18|    atomic_write_json,\n    19|    configured_robustness,\n    20|    latest_plan_path,\n    21|    load_flag_registry,\n    22|    now_utc,\n    23|    read_json,\n    24|    sha256_file,\n    25|    workflow_includes_step,\n    26|)\n    27|from arnold_pipelines.megaplan.flags import synthesize_critique_flags\n    28|from arnold_pipelines.megaplan.orchestration.task_feasibility import task_contract_hash\n    29|from arnold_pipelines.megaplan.types import PlanState\n    30|\n    31|\n    32|CUSTODY_SCHEMA_VERSION = \"megaplan-critique-custody-v1\"\n    33|CLEARANCE_SCHEMA_VERSION = \"megaplan-critique-clearance-v1\"\n    34|FINAL_BINDING_SCHEMA_VERSION = \"megaplan-finalize-critique-binding-v1\"\n    35|_ALLOWED_FINDING_KEYS = {\n    36|    \"detail\",\n    37|    \"flagged\",\n    38|    \"category\",\n    39|    \"severity_hint\",\n    40|    \"evidence\",\n    41|    \"finding_id\",\n    42|}\n    43|\n    44|\n    45|class CritiqueCustodyError(ValueError):\n    46|    \"\"\"One or more custody invariants failed.\"\"\"\n    47|\n    48|    def __init__(self, code: str, issues: Sequence[str]) -> None:\n    49|        self.code = code\n    50|        self.issues = tuple(str(issue) for issue in issues)\n    51|        super().__init__(f\"{code}: \" + \"; \".join(self.issues))\n    52|\n    53|\n    54|def _canonical_bytes(value: Any) -> bytes:\n    55|    return json.dumps(\n    56|        value,\n    57|        sort_keys=True,\n    58|        separators=(\",\", \":\"),\n    59|        ensure_ascii=False,\n    60|    ).encode(\"utf-8\")\n    61|\n    62|\n    63|def _digest(value: Any) -> str:\n    64|    return \"sha256:\" + hashlib.sha256(_canonical_bytes(value)).hexdigest()\n    65|\n    66|\n    67|def _stable_finding_id(flag: Mapping[str, Any]) -> str:\n    68|    identity = {\n    69|        \"source_check_id\": flag.get(\"source_check_id\"),\n    70|        \"concern\": str(flag.get(\"concern\") or \"\").strip(),\n    71|        \"category\": flag.get(\"category\"),\n    72|        \"severity_hint\": flag.get(\"severity_hint\"),\n    73|        \"evidence\": str(flag.get(\"evidence\") or \"\").strip(),\n    74|    }\n    75|    return \"CF-\" + hashlib.sha256(_canonical_bytes(identity)).hexdigest()[:20].upper()\n    76|\n    77|\n    78|def canonical_critique_flag_id(flag: Mapping[str, Any]) -> str:\n    79|    \"\"\"Return the reducer-owned identity for a normalized critique finding.\"\"\"\n    80|    return _stable_finding_id(flag)\n    81|\n    82|\n    83|def _normalize_flag_ids(payload: dict[str, Any]) -> None:\n    84|    flags = payload.get(\"flags\")\n    85|    if not isinstance(flags, list):\n    86|        raise CritiqueCustodyError(\"critique_flags_malformed\", [\"flags must be an array\"])\n    87|    seen: dict[str, int] = {}\n    88|    remapped: dict[str, set[str]] = {}\n    89|    issues: list[str] = []\n    90|    for index, raw_flag in enumerate(flags):\n    91|        if not isinstance(raw_flag, dict):\n    92|            issues.append(f\"flags[{index}] is not an object\")\n    93|            continue\n    94|        producer_id = raw_flag.get(\"id\")\n    95|        if not isinstance(producer_id, str):\n    96|            issues.append(f\"flags[{index}].id is not a string\")\n    97|            continue\n    98|        for field in (\"concern\", \"category\", \"severity_hint\", \"evidence\"):\n    99|            value = raw_flag.get(field)\n   100|            if not isinstance(value, str) or not value.strip():\n   101|                issues.append(f\"flags[{index}].{field} must be a non-empty string\")\n   102|        local_id = producer_id.strip()\n   103|        canonical_id = canonical_critique_flag_id(raw_flag)\n   104|        if local_id and local_id != canonical_id and \"producer_flag_id\" not in raw_flag:\n   105|            raw_flag[\"producer_flag_id\"] = local_id\n   106|        raw_flag[\"id\"] = canonical_id\n   107|        remapped.setdefault(producer_id.strip(), set()).add(canonical_id)\n   108|        if canonical_id in seen:\n   109|            issues.append(\n   110|                f\"duplicate canonical flag id {canonical_id!r} at \"\n   111|                f\"flags[{seen[canonical_id]}] and flags[{index}]\"\n   112|            )\n   113|        seen[canonical_id] = index\n   114|    if issues:\n   115|        raise CritiqueCustodyError(\"critique_finding_identity_invalid\", issues)\n   116|    for key in (\"verified_flag_ids\", \"disputed_flag_ids\"):\n   117|        values = payload.get(key)\n   118|        if isinstance(values, list):\n   119|            normalized_values: list[Any] = []\n   120|            for value in values:\n   121|", "total_lines": 810, "file_size": 36112, "truncated": true, "hint": "Use offset=121 to continue reading (showing 1-120 of 810 lines)", "is_binary": false, "is_image": false}
./critique-ledger-m9-planner-prompt.txt:771:{"content": "     1|\"\"\"Durable object reference schema for workflow boundary contracts.\n     2|\n     3|This module freezes a public schema contract under ``arnold.workflow``.\n     4|Every ``DurableRef`` requires retrievable durable object metadata and\n     5|rejects digest-only result preservation and secret payloads.\n     6|\n     7|This is schema-only — no I/O, mutation, or runtime effects.\n     8|\"\"\"\n     9|\n    10|from __future__ import annotations\n    11|\n    12|import re\n    13|from dataclasses import dataclass, field\n    14|from enum import StrEnum\n    15|from types import MappingProxyType\n    16|from typing import Any, Mapping\n    17|\n    18|\n    19|# ── Enums ─────────────────────────────────────────────────────────────────\n    20|\n    21|\n    22|class PrivacyClass(StrEnum):\n    23|    \"\"\"Privacy classification for durable object references.\"\"\"\n    24|\n    25|    PUBLIC = \"public\"\n    26|    INTERNAL = \"internal\"\n    27|    CONFIDENTIAL = \"confidential\"\n    28|    RESTRICTED = \"restricted\"\n    29|\n    30|\n    31|class AvailabilityClass(StrEnum):\n    32|    \"\"\"Availability tier for durable object references.\"\"\"\n    33|\n    34|    IMMEDIATE = \"immediate\"\n    35|    STANDARD = \"standard\"\n    36|    ARCHIVE = \"archive\"\n    37|    COLD = \"cold\"\n    38|\n    39|\n    40|class EncryptionScope(StrEnum):\n    41|    \"\"\"Encryption scope for durable object references.\"\"\"\n    42|\n    43|    NONE = \"none\"\n    44|    TENANT_KEY = \"tenant_key\"\n    45|    WORKFLOW_KEY = \"workflow_key\"\n    46|    FIELD_LEVEL = \"field_level\"\n    47|\n    48|\n    49|class RetentionClass(StrEnum):\n    50|    \"\"\"Retention class for durable object references.\"\"\"\n    51|\n    52|    EPHEMERAL = \"ephemeral\"\n    53|    RUN = \"run\"\n    54|    AUDIT = \"audit\"\n    55|    LEGAL_HOLD = \"legal_hold\"\n    56|\n    57|\n    58|class AccessScope(StrEnum):\n    59|    \"\"\"Access scope for durable object references.\"\"\"\n    60|\n    61|    TENANT = \"tenant\"\n    62|    WORKFLOW = \"workflow\"\n    63|    INVOCATION = \"invocation\"\n    64|    RESTRICTED = \"restricted\"\n    65|\n    66|\n    67|# ── Digest validation ─────────────────────────────────────────────────────\n    68|\n    69|_DIGEST_RE = re.compile(r\"^sha256:[0-9a-f]{64}$\")\n    70|\n    71|# Forbidden secret-like field keys that must never appear in a DurableRef.\n    72|_FORBIDDEN_SECRET_KEYS: frozenset[str] = frozenset(\n    73|    {\n    74|        \"api_key\",\n    75|        \"password\",\n    76|        \"secret\",\n    77|        \"token\",\n    78|        \"private_key\",\n    79|        \"credential\",\n    80|        \"bearer\",\n    81|        \"authorization\",\n    82|    }\n    83|)\n    84|\n    85|\n    86|def _require_digest(value: str) -> str:\n    87|    \"\"\"Validate a canonical digest string.\"\"\"\n    88|    if not isinstance(value, str) or not _DIGEST_RE.fullmatch(value):\n    89|        raise ValueError(\n    90|            f\"digest must be 'sha256:' followed by 64 lowercase hex chars, \"\n    91|            f\"got {value!r}\"\n    92|        )\n    93|    return value\n    94|\n    95|\n    96|def _reject_secret_keys(metadata: Mapping[str, Any]) -> None:\n    97|    \"\"\"Reject any metadata keys that could carry secrets.\"\"\"\n    98|    for key in metadata:\n    99|        lower_key = key.lower()\n   100|        for forbidden in _FORBIDDEN_SECRET_KEYS:\n   101|            if forbidden in lower_key:\n   102|                raise ValueError(\n   103|                    f\"DurableRef metadata key {key!r} matches forbidden \"\n   104|                    f\"secret pattern {forbidden!r}; durable refs must not \"\n   105|                    f\"carry secrets\"\n   106|                )\n   107|\n   108|\n   109|def _freeze_mapping(value: Mapping[str, Any]) -> Mapping[str, Any]:\n   110|    return MappingProxyType(\n   111|        {str(key): _freeze_value(subvalue) for key, subvalue in value.items()}\n   112|    )\n   113|\n   114|\n   115|def _freeze_value(value: Any) -> Any:\n   116|    if isinstance(value, Mapping):\n   117|        return _freeze_mapping(value)\n   118|    if isinstance(value, list):\n   119|        return tuple(_freeze_value(item) for item in value)\n   120|    if isinstance(value, tuple):\n   121|", "total_lines": 379, "file_size": 12797, "truncated": true, "hint": "Use offset=121 to continue reading (showing 1-120 of 379 lines)", "is_binary": false, "is_image": false}

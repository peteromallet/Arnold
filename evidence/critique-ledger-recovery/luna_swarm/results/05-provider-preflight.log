    83	def _resident_health(store: Store, config: ResidentConfig, *, limit: int) -> dict[str, Any]:
    84	    pending_jobs = store.list_scheduled_jobs(status="pending", limit=limit)
    85	    claimed_jobs = store.list_scheduled_jobs(status="claimed", limit=limit)
    86	    recent_runs = store.list_cloud_runs(limit=limit)
    87	    conversations = store.list_resident_conversations(transport="discord", limit=limit)
    88	    stale_control = store.list_stale_control_messages(
    89	        older_than_seconds=int(config.stale_control_claim_timeout_s),
    90	        limit=limit,
    91	    )
    92	    pending_confirmations = StoreBackedConfirmationManager(config, store).pending()
    93	    abandoned_turns = [
    94	        turn
    95	        for turn in store.list_recent_turns(n=limit * 2)
    96	        if turn.status == "abandoned"
    97	    ][:limit]
    98	    return {
    99	        "success": True,
   100	        "step": "resident",
   101	        "action": "health",
   102	        "mode": config.mode,
   103	        "store": type(store).__name__,
   104	        "scheduled_backlog": {
   105	            "pending": len(pending_jobs),
   106	            "claimed": len(claimed_jobs),
   107	            "pending_jobs": [_model(row) for row in pending_jobs],
   108	            "claimed_jobs": [_model(row) for row in claimed_jobs],
   109	        },
   110	        "resident_conversations": [_model(row) for row in conversations],
   111	        "abandoned_turns": [_model(row) for row in abandoned_turns],
   112	        "recent_cloud_runs": [_model(row) for row in recent_runs],
   113	        "pending_cloud_confirmations": [_confirmation_model(row) for row in pending_confirmations[:limit]],
   114	        "stale_control_messages": {
   115	            "count": len(stale_control),
   116	            "messages": [_model(row) for row in stale_control],
   117	        },
   118	    }

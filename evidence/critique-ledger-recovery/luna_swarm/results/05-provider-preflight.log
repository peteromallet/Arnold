   223	class StoreBackedConfirmationManager(ConfirmationManager):
   224	    """Confirmation manager that persists pending requests as scheduled jobs."""
   225	
   226	    def __init__(self, config: ResidentConfig, store: Store) -> None:
   227	        super().__init__(config)
   228	        self.store = store
   229	
   230	    def request_confirmation(
   231	        self,
   232	        *,
   233	        subject: AuthorizationSubject,
   234	        action: ActionKind,
   235	        target_summary: str,
   236	        metadata: JSONDict | None = None,
   237	        now: datetime | None = None,
   238	    ) -> ConfirmationRequest:
   239	        request = super().request_confirmation(
   240	            subject=subject,
   241	            action=action,
   242	            target_summary=target_summary,
   243	            metadata=metadata,
   244	            now=now,
   245	        )
   246	        self.store.create_scheduled_job(
   247	            ScheduledJobInput(
   248	                job_type="confirmation_expiry",
   249	                payload={"confirmation": _confirmation_to_payload(request)},
   250	                scheduled_for=request.expires_at,
   251	                max_attempts=1,
   252	            ),
   253	            idempotency_key=deterministic_idempotency_key("resident-confirmation-request", request.id),
   254	        )
   255	        return request
   256	
   257	    def confirm(
   258	        self,
   259	        *,
   260	        request_id: str,
   261	        subject: AuthorizationSubject,
   262	        phrase: str,
   263	        now: datetime | None = None,
   264	    ) -> ConfirmationDecision:
   265	        self._hydrate_request(request_id)
   266	        decision = super().confirm(request_id=request_id, subject=subject, phrase=phrase, now=now)
   267	        if decision.allowed:
   268	            self._complete_confirmation_job(request_id, "fired")
   269	        elif decision.status == "expired":
   270	            self._complete_confirmation_job(request_id, "cancelled")
   271	        return decision
   272	
   273	    def expire_due(self, *, now: datetime | None = None) -> list[ConfirmationRequest]:
   274	        current = _aware_now(now)
   275	        expired: list[ConfirmationRequest] = []
   276	        for job in self.store.list_scheduled_jobs(job_type="confirmation_expiry", limit=1000):
   277	            if job.status not in {"pending", "claimed"}:
   278	                continue
   279	            request = _confirmation_from_payload(job.payload.get("confirmation"))
   280	            if request is None or request.expires_at > current:
   281	                continue
   282	            expired.append(request)
   283	            self._pending.pop(request.id, None)
   284	            self._complete_confirmation_job(request.id, "cancelled")
   285	        expired.extend(super().expire_due(now=current))
   286	        unique = {request.id: request for request in expired}
   287	        return list(sorted(unique.values(), key=lambda request: (request.expires_at, request.id)))
   288	
   289	    def pending(self) -> tuple[ConfirmationRequest, ...]:
   290	        rows = self.store.list_scheduled_jobs(status="pending", job_type="confirmation_expiry", limit=1000)
   291	        durable = [_confirmation_from_payload(row.payload.get("confirmation")) for row in rows]
   292	        combined = {request.id: request for request in super().pending()}
   293	        combined.update({request.id: request for request in durable if request is not None})
   294	        return tuple(sorted(combined.values(), key=lambda request: (request.expires_at, request.id)))
   295	
   296	    def _hydrate_request(self, request_id: str) -> None:
   297	        if request_id in self._pending:
   298	            return
   299	        for job in self.store.list_scheduled_jobs(job_type="confirmation_expiry", limit=1000):
   300	            if job.status not in {"pending", "claimed"}:

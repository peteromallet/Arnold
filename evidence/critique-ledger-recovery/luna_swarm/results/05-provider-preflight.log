    89	def _secure_dir(path):
    90	    """Set directory to owner-only access (0700). No-op on Windows."""
    91	    try:
    92	        os.chmod(path, 0o700)
    93	    except (OSError, NotImplementedError):
    94	        pass
    95	
    96	
    97	def _secure_file(path):
    98	    """Set file to owner-only read/write (0600). No-op on Windows."""
    99	    try:
   100	        if os.path.exists(str(path)):
   101	            os.chmod(path, 0o600)
   102	    except (OSError, NotImplementedError):
   103	        pass

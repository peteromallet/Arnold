   169	def test_escalation_resolution_free_text_requests_confirmation_without_mutation(tmp_path: Path) -> None:
   170	    repair_data_dir = tmp_path / "repair-data"
   171	    _write_escalation(
   172	        repair_data_dir,
   173	        {
   174	            "session": "demo",
   175	            "event": "opened",
   176	            "escalation_id": "esc-1",
   177	            "target_id": "target-1",
   178	            "current_plan": "plan-1",
   179	            "dm_user_id": "user-1",
   180	            "resume_handler": "cloud_resume",
   181	        },
   182	        {
   183	            "session": "demo",
   184	            "event": "delivered",
   185	            "escalation_id": "esc-1",
   186	            "channel_id": "channel-1",
   187	            "message_ids": ["msg-1"],
   188	            "dm_user_id": "user-1",
   189	        },
   190	    )
   191	    _write_marker(repair_data_dir, "demo", "target-1")
   192	    backend = RecordingCloudBackend()
   193	    outbound = RecordingOutbound()
   194	    runtime = _runtime(tmp_path, repair_data_dir=repair_data_dir, cloud_backend=backend, outbound=outbound)
   195	
   196	    asyncio.run(
   197	        runtime.receive(
   198	            InboundEvent(
   199	                idempotency_key="discord:message:answer-1",
   200	                conversation_key="discord:dm:user-1",
   201	                subject=AuthorizationSubject(user_id="user-1", channel_id="channel-1"),
   202	                content="resume it",
   203	                escalation_id="esc-1",
   204	                resume_handler="cloud_resume",
   205	                raw={"discord_message_id": "answer-1"},
   206	            )
   207	        )
   208	    )
   209	
   210	    assert outbound.sent
   211	    assert outbound.sent[-1].content.startswith("Confirmation required: confirm escalation_resolve ")
   212	    assert backend.calls == []
   213	    assert (repair_data_dir / "demo.needs-human.json").exists()
   214	    assert [record["event"] for record in _read_escalations(repair_data_dir)] == ["opened", "delivered"]

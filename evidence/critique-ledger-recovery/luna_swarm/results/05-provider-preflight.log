   652	def clear_provider_auth(provider_id: Optional[str] = None) -> bool:
   653	    """
   654	    Clear auth state for a provider. Used by `hermes logout`.
   655	    If provider_id is None, clears the active provider.
   656	    Returns True if something was cleared.
   657	    """
   658	    with _auth_store_lock():
   659	        auth_store = _load_auth_store()
   660	        target = provider_id or auth_store.get("active_provider")
   661	        if not target:
   662	            return False
   663	
   664	        providers = auth_store.get("providers", {})
   665	        if target not in providers:
   666	            return False
   667	
   668	        del providers[target]
   669	        if auth_store.get("active_provider") == target:
   670	            auth_store["active_provider"] = None
   671	        _save_auth_store(auth_store)
   672	    return True

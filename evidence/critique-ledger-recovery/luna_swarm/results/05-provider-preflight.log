    61	def authorize_escalation_answer(
    62	    *,
    63	    authorizer: ResidentAuthorizer,
    64	    subject: AuthorizationSubject,
    65	    action: ActionKind,
    66	    escalation_id: str,
    67	    repair_data_dir: str | Path,
    68	    audit_sink: EscalationAuditSink | None = None,
    69	    idempotency_key: str = "",
    70	) -> EscalationAnswerDecision:
    71	    """Authorize an answer before any resident state mutation."""
    72	
    73	    if action not in {"escalation_reply", "escalation_resolve"}:
    74	        raise ValueError(f"unsupported escalation action: {action}")
    75	
    76	    action_decision = authorizer.authorize_action(subject, action)
    77	    if not action_decision.allowed:
    78	        _audit_denial(audit_sink, subject, action, escalation_id, action_decision.reason or "action_denied", idempotency_key)
    79	        return EscalationAnswerDecision(False, action_decision.reason)
    80	
    81	    target = load_escalation_target(repair_data_dir, escalation_id)
    82	    if target is None:
    83	        _audit_denial(audit_sink, subject, action, escalation_id, "escalation_not_found", idempotency_key)
    84	        return EscalationAnswerDecision(False, "escalation_not_found")
    85	    if target.superseded:
    86	        _audit_denial(audit_sink, subject, action, escalation_id, "escalation_superseded", idempotency_key)
    87	        return EscalationAnswerDecision(False, "escalation_superseded", target)
    88	    if target.unavailable or not target.message_ids:
    89	        _audit_denial(audit_sink, subject, action, escalation_id, "escalation_not_delivered", idempotency_key)
    90	        return EscalationAnswerDecision(False, "escalation_not_delivered", target)
    91	    if target.responder_user_id and subject.user_id != target.responder_user_id:
    92	        _audit_denial(audit_sink, subject, action, escalation_id, "responder_user_mismatch", idempotency_key)
    93	        return EscalationAnswerDecision(False, "responder_user_mismatch", target)
    94	    if target.channel_id and subject.channel_id != target.channel_id:
    95	        _audit_denial(audit_sink, subject, action, escalation_id, "responder_channel_mismatch", idempotency_key)
    96	        return EscalationAnswerDecision(False, "responder_channel_mismatch", target)
    97	
    98	    current_target_id = _current_marker_target_id(repair_data_dir, target.session)
    99	    if target.target_id and current_target_id != target.target_id:
   100	        _audit_denial(
   101	            audit_sink,
   102	            subject,
   103	            action,
   104	            escalation_id,
   105	            "stale_target_mismatch",
   106	            idempotency_key,
   107	            {"expected_target_id": target.target_id, "current_target_id": current_target_id},
   108	        )
   109	        return EscalationAnswerDecision(False, "stale_target_mismatch", target)
   110	
   111	    return EscalationAnswerDecision(True, target=target)

   139	class KeyPool:
   140	    """Thread-safe API key pool with LRU acquisition and 429 cooldown.
   141	
   142	    Keys are sourced from environment variables (and ~/.hermes/.env) and,
   143	    optionally, from a JSON file at the path returned by ``keys_path_source``.
   144	
   145	    Governor integration and envelope context wiring are intentionally absent
   146	    from this generic pool.  Add them via subclassing or a wrapper in the
   147	    plugin layer.
   148	    """
   149	
   150	    def __init__(
   151	        self,
   152	        ttl_seconds: float = _RELOAD_TTL_SECONDS,
   153	        keys_path_source: KeyPathSource | None = None,
   154	    ) -> None:
   155	        self._ttl_seconds = ttl_seconds
   156	        self._keys_path_source = keys_path_source
   157	        self._lock = threading.Lock()
   158	        self._next_reload = 0.0
   159	        self._hermes_env: dict[str, str] = {}
   160	        self._entries: dict[str, list[KeyEntry]] = {
   161	            provider: [] for provider in _PROVIDER_KEY_VARS
   162	        }
   163	        self._broker_keys: dict[str, BrokeredKey] = {}
   164	
   165	    def _api_keys_path(self) -> Path | None:
   166	        """Return the JSON keys file path via the injected source, or None."""
   167	        if self._keys_path_source is not None:
   168	            return self._keys_path_source.keys_path()
   169	        return None
   170	
   171	    def _load_hermes_env_unlocked(self) -> dict[str, str]:
   172	        result: dict[str, str] = {}
   173	        env_path = Path.home() / ".hermes" / ".env"
   174	        if env_path.exists():
   175	            for line in env_path.read_text(encoding="utf-8").splitlines():
   176	                line = line.strip()
   177	                if line and not line.startswith("#") and "=" in line:
   178	                    key, value = line.split("=", 1)
   179	                    result[key.strip()] = value.strip().strip("'\"")
   180	        return result
   181	
   182	    def _collect_key_values(self, env_var: str, hermes_env: dict[str, str]) -> list[str]:
   183	        values: list[str] = []
   184	        seen: set[str] = set()
   185	        names = _ENV_ALIASES.get(env_var, (env_var,))
   186	        combined_names = set(hermes_env) | set(os.environ)
   187	        for name in names:
   188	            pattern = re.compile(rf"^{re.escape(name)}(?:_(\d+))?$")
   189	            matches: list[tuple[int, str]] = []
   190	            for candidate in combined_names:
   191	                match = pattern.match(candidate)
   192	                if match:
   193	                    matches.append((int(match.group(1) or "1"), candidate))
   194	            for _, candidate in sorted(matches):
   195	                value = (os.environ.get(candidate) or hermes_env.get(candidate) or "").strip().strip("'\"")
   196	                if value and value not in seen:
   197	                    seen.add(value)
   198	                    values.append(value)
   199	        return values
   200	
   201	    def _load_api_keys_json(self) -> list[str]:
   202	        path = self._api_keys_path()
   203	        if path is None or not path.exists():
   204	            return []
   205	        try:
   206	            payload = json.loads(path.read_text(encoding="utf-8"))
   207	        except (OSError, json.JSONDecodeError):
   208	            return []
   209	        keys: list[str] = []
   210	        if isinstance(payload, list):
   211	            for item in payload:
   212	                if isinstance(item, dict):
   213	                    key = str(item.get("key", "")).strip()
   214	                    if key and key not in keys:
   215	                        keys.append(key)
   216	        return keys
   217	
   218	    def _load_keys_unlocked(self, now: float) -> None:
   219	        if now < self._next_reload:
   220	            return
   221	        hermes_env = self._load_hermes_env_unlocked()
   222	        self._hermes_env = hermes_env
   223	        for provider, env_var in _PROVIDER_KEY_VARS.items():
   224	            keys = self._collect_key_values(env_var, hermes_env)
   225	            if provider == "zhipu":
   226	                for key in self._load_api_keys_json():
   227	                    if key not in keys:
   228	                        keys.append(key)
   229	            existing = {entry.key: entry for entry in self._entries.get(provider, [])}
   230	            self._entries[provider] = [existing.get(key, KeyEntry(key=key)) for key in keys]
   231	        self._next_reload = now + self._ttl_seconds
   232	
   233	    def _provider_base_url_unlocked(self, provider: str) -> str:
   234	        env_var = _PROVIDER_BASE_URL_VARS.get(provider, "")
   235	        env_override = self._get_api_credential_unlocked(env_var) if env_var else ""
   236	        default_url = _DEFAULT_BASE_URLS.get(provider, "")
   237	        if provider == "kimi":
   238	            sample_key = ""
   239	            for entry in self._entries.get(provider, []):
   240	                if entry.key:
   241	                    sample_key = entry.key
   242	                    break
   243	            return resolve_kimi_base_url(sample_key, default_url, env_override)
   244	        return env_override or default_url
   245	
   246	    def _acquire_brokered_key_unlocked(self, provider: str) -> str:
   247	        current = self._broker_keys.get(provider)
   248	        now = int(time.time())
   249	        if current is not None and (current.expires_at is None or current.expires_at > now):
   250	            return current.key
   251	        upstream_base_url = self._provider_base_url_unlocked(provider)
   252	        if not upstream_base_url:
   253	            return ""
   254	        try:
   255	            credential = resolve_brokered_llm_proxy(
   256	                provider,
   257	                upstream_base_url,
   258	                broker_client=BrokerClient.from_environment(),
   259	            )

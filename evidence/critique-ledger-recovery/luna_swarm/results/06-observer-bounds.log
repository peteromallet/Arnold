   225	        opener=fake_urlopen,
   226	    )
   227	
   228	    assert result["ok"] is True
   229	    assert result["channel_id"] == "dm-channel-1"
   230	    assert result["message_ids"] == [f"msg-{idx}" for idx in range(1, len(expected_messages) + 1)]
   231	    assert result["message_count"] == len(expected_messages)
   232	    assert "Authorization" not in result
   233	    assert "headers" not in result
   234	    assert "body" not in result
   235	    assert "token-123" not in json.dumps(result)
   236	    assert "supersecret" not in json.dumps(result)
   237	    assert "bearer-secret-token-value" not in json.dumps(result)

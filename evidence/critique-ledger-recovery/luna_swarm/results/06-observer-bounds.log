  4288	        if not path.exists():
  4289	            continue
  4290	        evidence = {{"status": "present", "path": str(path), **_mtime_payload(path)}}
  4291	        try:
  4292	            report = json.loads(path.read_text())
  4293	        except Exception as exc:
  4294	            return {{}}, {{"status": "invalid", "path": str(path), "error": str(exc)}}
  4295	        evidence["report_timestamp_utc"] = report.get("timestamp_utc") or report.get("generated_at") or ""
  4296	        by_session = {{}}
  4297	        for section in ("issues", "items"):
  4298	            items = report.get(section)
  4299	            if not isinstance(items, list):
  4300	                continue
  4301	            for item in items:
  4302	                if not isinstance(item, dict):
  4303	                    continue
  4304	                session = item.get("session")
  4305	                if not isinstance(session, str) or not session:
  4306	                    continue
  4307	                by_session[session] = {{
  4308	                    "status": "present",
  4309	                    "source": section,
  4310	                    "path": str(path),
  4311	                    "action": item.get("action") or "",
  4312	                    "watchdog_status": item.get("status") or "",
  4313	                    "message": item.get("message") or "",
  4314	                    "remote_spec": item.get("remote_spec") or "",
  4315	                    "workspace": item.get("workspace") or "",
  4316	                    "report_timestamp_utc": evidence["report_timestamp_utc"],
  4317	                }}
  4318	        return by_session, evidence
  4319	    return {{}}, {{"status": "missing", "path": str(paths[0])}}

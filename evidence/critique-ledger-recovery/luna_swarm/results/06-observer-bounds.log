    78	def _compute_liveness_and_reason(events: list[dict], state: dict | None, now_ts: float) -> tuple[str, str]:
    79	    """Best-effort liveness computation matching the introspect semantics."""
    80	    # Phase age / timeout-imminent
    81	    phase_timeout = 3600.0
    82	    phase_age: float | None = None
    83	    if state and isinstance(state, dict):
    84	        active = state.get("active_step")
    85	        if isinstance(active, dict):
    86	            started = active.get("started_at")
    87	            if started:
    88	                started_epoch = _parse_iso(str(started))
    89	                if started_epoch is not None:
    90	                    phase_age = now_ts - started_epoch
    91	        phase_timeout = float(state.get("phase_timeout_seconds") or phase_timeout)
    92	
    93	    if phase_age is not None and phase_age > 0.8 * phase_timeout:
    94	        return "timeout-imminent", f"phase_age {phase_age:.0f}s > 0.8 * timeout {phase_timeout:.0f}s"
    95	
    96	    last_event_age = _compute_last_event_age(events, now_ts)
    97	    has_in_flight = _compute_in_flight_llm(events, state, now_ts)
    98	
    99	    if last_event_age is None:
   100	        if has_in_flight:
   101	            return "progressing", "no events yet but LLM call in flight"
   102	        return "quiet", "no events recorded yet"
   103	
   104	    if last_event_age < 60 or has_in_flight:
   105	        return "progressing", "recent event or LLM call in flight"
   106	    if last_event_age < 300:
   107	        return "quiet", f"last event {last_event_age:.0f}s ago"
   108	    return "stalled", f"last event {last_event_age:.0f}s ago"

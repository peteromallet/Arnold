   137	def _detect_ps_format(ps_lines: Iterable[str]) -> str:
   138	    """Return ``metadata`` if ps output includes ppid/etime/time, else ``legacy``."""
   139	    for line in ps_lines:
   140	        stripped = line.strip().lower()
   141	        if stripped.startswith("pid args"):
   142	            return "legacy"
   143	        if "ppid" in stripped and "etime" in stripped:
   144	            return "metadata"
   145	        parts = stripped.split()
   146	        if len(parts) >= 2:
   147	            try:
   148	                int(parts[0])
   149	            except ValueError:
   150	                continue
   151	            try:
   152	                int(parts[1])
   153	                return "metadata" if len(parts) >= 5 else "legacy"
   154	            except ValueError:
   155	                return "legacy"
   156	    return "metadata"
   157	

  5024	def _run_status_all(spec: CloudSpec, provider, *, args: argparse.Namespace | None = None) -> int:
  5025	    """``cloud status --all`` against the canonical snapshot.
  5026	
  5027	    Inside the trusted container: read the snapshot the watchdog wrote, or
  5028	    rebuild it locally from observation only — never SSH back to our own host.
  5029	    From a laptop: fetch the same snapshot from the box; if the box has not
  5030	    started producing one yet, fall back to the legacy remote listing so the
  5031	    command never hard-fails during the rollout.
  5032	    """
  5033	    compact = bool(getattr(args, "compact", False)) if args is not None else False
  5034	
  5035	    if _in_trusted_container():
  5036	        snapshot, _degraded = status_snapshot.load_cloud_status_snapshot(
  5037	            status_snapshot.DEFAULT_SNAPSHOT_PATH, max_age_s=3600
  5038	        )
  5039	        if snapshot is None:
  5040	            snapshot = status_snapshot.build_cloud_status_snapshot()
  5041	        _emit_cloud_status_human(snapshot, compact=compact)
  5042	        sys.stdout.write(json.dumps(snapshot, indent=2) + "\n")
  5043	        return 0
  5044	
  5045	    # Laptop path: ask the box for the same snapshot its watchdog produced.
  5046	    try:
  5047	        raw = provider.read_remote_file(str(status_snapshot.DEFAULT_SNAPSHOT_PATH))
  5048	        snapshot = json.loads(raw)
  5049	    except (CliError, OSError, ValueError) as exc:
  5050	        sys.stderr.write(
  5051	            f"cloud status: snapshot unavailable on box ({exc.__class__.__name__}); "
  5052	            "falling back to legacy remote listing\n"
  5053	        )
  5054	        return _run_cloud_chains(spec, provider, args=args)
  5055	    if not isinstance(snapshot, dict):
  5056	        sys.stderr.write("cloud status: box snapshot malformed; falling back to legacy remote listing\n")
  5057	        return _run_cloud_chains(spec, provider, args=args)
  5058	    stale_reason = _cloud_status_snapshot_stale_reason(snapshot)
  5059	    if stale_reason:
  5060	        sys.stderr.write(
  5061	            f"cloud status: box snapshot stale ({stale_reason}); "
  5062	            "falling back to legacy remote listing\n"
  5063	        )
  5064	        return _run_cloud_chains(spec, provider, args=args)
  5065	    _emit_cloud_status_human(snapshot, compact=compact)
  5066	    sys.stdout.write(json.dumps(snapshot, indent=2) + "\n")
  5067	    return 0
  5068	

    65	
    66	def format_cloud_status_short(
    67	    snapshot: Mapping[str, Any] | None,
    68	    *,
    69	    max_chars: int = DISCORD_SAFE_LIMIT,
    70	) -> list[str]:
    71	    """Compact Discord reply, chunked to fit the message limit.
    72	
    73	    Returns one or more strings; each fits under ``max_chars``. An absent
    74	    snapshot yields a single explicit degraded-mode message so the resident
    75	    never answers partial plan files as full cloud status.
    76	    """
    77	    if not snapshot or not isinstance(snapshot, Mapping) or not snapshot.get("sessions"):
    78	        reason = "snapshot unavailable"
    79	        if snapshot and isinstance(snapshot, Mapping):
    80	            degraded = snapshot.get("degraded")
    81	            if isinstance(degraded, Mapping) and degraded.get("reasons"):
    82	                reason = "; ".join(degraded["reasons"])
    83	        return [
    84	            f"Cloud status is degraded: {reason}. "
    85	            "Falling back to local plan evidence only — this is NOT the canonical shared-runner view."
    86	        ]
    87	
    88	    header = (
    89	        f"**Cloud status:** {_summary_line(snapshot)}\n"
    90	        f"{_evidence_citation(snapshot)}"
    91	    )
    92	    lines = [header]
    93	    for entry in _ordered_sessions(snapshot):
    94	        status = entry.get("status", "attention")
    95	        emoji = _STATUS_EMOJI.get(status, "❓")
    96	        plan = entry.get("current_plan") or entry.get("session", "?")
    97	        line = f"{emoji} `{entry.get('session', '?')}` — {status}: {plan}"
    98	        if entry.get("operator_next") and status in {"repairing", "blocked", "attention"}:
    99	            line += f" ({entry['operator_next']})"
   100	        lines.append(line)
   101	
   102	    return _chunk_lines(lines, max_chars=max_chars)
   103	
   104	
   105	def format_cloud_status_detailed(snapshot: Mapping[str, Any] | None) -> str:
   106	    """Multi-line CLI / human view of the snapshot."""
   107	    if not snapshot or not isinstance(snapshot, Mapping):
   108	        return "Cloud status snapshot unavailable (degraded)."
   109	    out = [f"Cloud status — {_summary_line(snapshot)}"]
   110	    out.append(_evidence_citation(snapshot))
   111	    degraded = snapshot.get("degraded")
   112	    if isinstance(degraded, Mapping) and degraded.get("reasons"):
   113	        out.append("degraded: " + "; ".join(degraded["reasons"]))
   114	    out.append("")
   115	    for entry in _ordered_sessions(snapshot):
   116	        status = entry.get("status", "attention")
   117	        progress = entry.get("progress")
   118	        progress_str = ""
   119	        if isinstance(progress, Mapping) and progress.get("percent") is not None:
   120	            progress_str = f"  progress={progress.get('percent')}%"
   121	            # In-flight plan stage estimate (completed lifecycle stages / total),
   122	            # or the raw plan state when it is not percentage-able (e.g. blocked).
   123	            plan_percent = progress.get("plan_percent")
   124	            plan_state = progress.get("plan_state")
   125	            if plan_percent is not None:
   126	                progress_str += f"  plan={plan_percent}%"
   127	                if plan_state:
   128	                    progress_str += f" ({plan_state})"
   129	            elif plan_state:
   130	                progress_str += f"  plan={plan_state}"
   131	            # Epic % gained over the last 1h / 5h, from sweep history.
   132	            delta_parts = []
   133	            for window, key in (("1h", "epic_delta_1h"), ("5h", "epic_delta_5h")):
   134	                delta = progress.get(key)
   135	                if isinstance(delta, int):
   136	                    delta_parts.append(f"{delta:+d}%/{window}")
   137	            if delta_parts:
   138	                progress_str += "  (" + ", ".join(delta_parts) + ")"
   139	            # Ladder stages the plan newly reached in the past hour.
   140	            stage_changes = progress.get("stage_changes_1h") or []
   141	            if stage_changes:
   142	                progress_str += "  stages1h:" + "→".join(stage_changes)
   143	        out.append(
   144	            f"[{status}] {entry.get('session', '?')}  "
   145	            f"plan={entry.get('current_plan') or '-'}  "
   146	            f"completed={entry.get('completed_count')}/{entry.get('milestone_count') or '-'}"
   147	            f"{progress_str}"
   148	        )
   149	        if entry.get("latest_activity"):
   150	            out.append(f"      latest_activity: {entry['latest_activity']}")
   151	        if entry.get("operator_next"):
   152	            out.append(f"      operator_next: {entry['operator_next']}")
   153	        evidence = entry.get("evidence") or {}
   154	        if isinstance(evidence, Mapping) and evidence.get("marker"):
   155	            out.append(f"      evidence: {evidence['marker']}")
   156	    return "\n".join(out)
   157	
   158	
   159	def format_attention_only(snapshot: Mapping[str, Any] | None) -> str:
   160	    """Watchdog alert body: only sessions needing human or repair attention.
   161	
   162	    Returns an empty string when nothing needs attention, so callers can skip
   163	    the notification entirely.
   164	    """
   165	    if not snapshot or not isinstance(snapshot, Mapping):
   166	        return ""
   167	    noteworthy = [
   168	        entry
   169	        for entry in (snapshot.get("sessions") or [])
   170	        if isinstance(entry, Mapping) and entry.get("status") in {"blocked", "attention", "repairing"}
   171	    ]
   172	    if not noteworthy:
   173	        return ""
   174	    lines = [f"Cloud status needs attention — {_summary_line(snapshot)}"]
   175	    for entry in sorted(noteworthy, key=lambda e: _STATUS_ORDER.index(e.get("status", "attention")) if e.get("status") in _STATUS_ORDER else len(_STATUS_ORDER)):
   176	        emoji = _STATUS_EMOJI.get(entry.get("status"), "⚠️")
   177	        lines.append(
   178	            f"{emoji} {entry.get('session', '?')}: {entry.get('status')} — "
   179	            f"{entry.get('operator_next', '')}".rstrip()
   180	        )
   181	    return "\n".join(lines)
   182	
   183	
   184	def _chunk_lines(lines: Iterable[str], *, max_chars: int) -> list[str]:
   185	    """Pack lines into the fewest chunks that each fit under ``max_chars``."""
   186	    cap = max(64, int(max_chars))
   187	    chunks: list[str] = []
   188	    current: list[str] = []
   189	    running = 0
   190	    for line in lines:
   191	        cost = len(line) + 1  # +1 for the joining newline
   192	        if cost > cap and not current:
   193	            # A single oversized line becomes its own chunk (truncated hard).
   194	            chunks.append(line[: cap - 1])
   195	            current = []
   196	            running = 0
   197	            continue
   198	        if current and running + cost > cap:
   199	            chunks.append("\n".join(current))
   200	            current = []
   201	            running = 0
   202	        current.append(line)
   203	        running += cost
   204	    if current:
   205	        chunks.append("\n".join(current))
   206	    return chunks or [""]

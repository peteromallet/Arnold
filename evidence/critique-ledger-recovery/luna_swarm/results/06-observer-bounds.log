   114	    if state is None:
   115	        return result
   116	    current_state = state.get("current_state")
   117	    result["current_state"] = current_state
   118	
   119	    if not isinstance(current_state, str):
   120	        return result
   121	
   122	    # Count unresolved flags from gate_signals files.
   123	    flags_count = 0
   124	    try:
   125	        for path_obj in sorted(plan_dir.glob("gate_signals_v*.json"), reverse=True):
   126	            try:
   127	                data = json.loads(path_obj.read_text(encoding="utf-8"))
   128	                flags = data.get("unresolved_flags", [])
   129	                if isinstance(flags, list):
   130	                    flags_count = len(flags)
   131	                break
   132	            except Exception:
   133	                continue
   134	    except Exception:
   135	        pass
   136	
   137	    is_blocked = flags_count > 0 or current_state in {"gated", "clarifying", "blocked"}
   138	    result["is_blocked"] = is_blocked
   139	
   140	    if is_blocked and current_state in {"gated", "clarifying", "blocked"}:
   141	        result["recoverable_via"] = ["resume", "auto"]
   142	    return result
   143	
   144	
   145	def _doctor_findings(plan_dir: Path, state: dict | None) -> tuple[CheckFinding, ...]:
   146	    """Lightweight doctor checks that do not require the megaplan CLI."""
   147	    findings: list[CheckFinding] = []
   148	
   149	    # Stale lock check.
   150	    lock_file = plan_dir / ".plan.lock"
   151	    if lock_file.exists():
   152	        try:
   153	            mtime = lock_file.stat().st_mtime
   154	            age = time.time() - mtime
   155	            if age > 300:
   156	                findings.append(
   157	                    CheckFinding(
   158	                        scope="plan",
   159	                        check="stale_lock",
   160	                        status="fail",
   161	                        message=f"plan lock is {age:.0f}s old",
   162	                    )
   163	                )
   164	        except Exception:
   165	            pass
   166	
   167	    return tuple(findings)
   168	
   169	
   170	def compute_signal_bundle(plan_dir: Path, state: dict | None = None) -> SignalBundle:
   171	    """Build a SignalBundle for a plan directory.
   172	
   173	    Uses direct filesystem reads so it works even when the megaplan CLI is
   174	    broken or shadowed. Degrades gracefully on any error.
   175	    """
   176	    plan_dir = Path(plan_dir)
   177	    if state is None:
   178	        state = _read_json(plan_dir / "state.json")
   179	
   180	    try:
   181	        events = _read_events(plan_dir)
   182	        now_ts = time.time()
   183	        liveness, liveness_reason = _compute_liveness_and_reason(events, state, now_ts)
   184	        last_event_age_seconds = _compute_last_event_age(events, now_ts)
   185	        has_in_flight_llm = _compute_in_flight_llm(events, state, now_ts)
   186	        block_details = _compute_block_details(plan_dir, state)
   187	        doctor_findings = _doctor_findings(plan_dir, state)
   188	
   189	        return SignalBundle(
   190	            liveness=liveness,
   191	            liveness_reason=liveness_reason,
   192	            block_details=block_details,
   193	            doctor_findings=doctor_findings,
   194	            has_in_flight_llm=has_in_flight_llm,
   195	            last_event_age_seconds=last_event_age_seconds,
   196	        )
   197	    except Exception as exc:
   198	        return SignalBundle(
   199	            liveness="unknown",
   200	            liveness_reason="signal computation failed",
   201	            block_details={},
   202	            doctor_findings=(),
   203	            degraded=True,
   204	            failure_reason=str(exc),
   205	        )
   206	
   207	
   208	__all__ = [
   209	    "compute_signal_bundle",
   210	]

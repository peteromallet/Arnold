    24	
    25	
    26	_CATEGORIES: tuple[tuple[str, tuple[str, ...]], ...] = (
    27	    ("megaplan", ("megaplan", "python -m megaplan")),
    28	    ("arnold", ("arnold", "python -m arnold")),
    29	    ("shannon", ("shannon",)),
    30	    ("codex", ("codex",)),
    31	    ("claude", ("claude",)),
    32	)

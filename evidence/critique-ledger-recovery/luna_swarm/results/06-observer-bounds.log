    35	def _parse_ps_time(value: str) -> float | None:
    36	    """Parse ps ``etime``/``time`` ([[dd-]hh:]mm:ss) to seconds."""
    37	    value = value.strip()
    38	    if not value:
    39	        return None
    40	    try:
    41	        if "-" in value:
    42	            days, rest = value.split("-", 1)
    43	            day_seconds = int(days) * 86400
    44	        else:
    45	            day_seconds = 0
    46	            rest = value
    47	        parts = rest.split(":")
    48	        if len(parts) == 3:
    49	            hours, minutes, seconds = parts
    50	            return day_seconds + int(hours) * 3600 + int(minutes) * 60 + int(seconds)
    51	        if len(parts) == 2:
    52	            minutes, seconds = parts
    53	            return day_seconds + int(minutes) * 60 + int(seconds)
    54	        if len(parts) == 1:
    55	            return day_seconds + int(parts[0])
    56	    except Exception:
    57	        pass
    58	    return None
    59	
    60	
    61	def _categorize_cmdline(cmdline: str) -> str | None:
    62	    lowered = cmdline.lower()
    63	    # Split on whitespace, path separators, and dots so dotted module paths
    64	    # like "python -m arnold_pipelines.megaplan" are categorized correctly.
    65	    # Path segments like ".megaplan-worktrees" split into "megaplan-worktrees",
    66	    # which does not exactly match the "megaplan" needle, avoiding false positives.
    67	    tokens = re.split(r"[\s/.]", lowered)
    68	    for category, needles in _CATEGORIES:
    69	        for needle in needles:
    70	            if needle in tokens:
    71	                return category
    72	    return None
    73	
    74	
    75	def _extract_cwd_from_cmdline(cmdline: str) -> str | None:
    76	    """Best-effort cwd extraction from known cmdline patterns."""
    77	    # Claude daemon: --spawned-by {"cwd":"/path",...}
    78	    match = re.search(r'--spawned-by\s+\{[^}]*"cwd"\s*:\s*"([^"]+)"', cmdline)
    79	    if match:
    80	        return match.group(1)
    81	    # tmux new-session -c /path (only when tmux is the executable).
    82	    if cmdline.lstrip().startswith("tmux") or " tmux " in cmdline:
    83	        match = re.search(r'\s-c\s+(\S+)', cmdline)
    84	        if match:
    85	            return match.group(1)
    86	    # Bash wrapper: last `cd '/path' || cd "/path"` in the command.
    87	    matches = re.findall(r"\bcd\s+['\"]([^'\"]+)['\"]", cmdline)
    88	    if matches:
    89	        return matches[-1]
    90	    return None
    91	
    92	
    93	def _get_cwd(pid: int) -> str | None:
    94	    """Return the current working directory of *pid* if available."""
    95	    # Linux procfs shortcut (only when procfs is present).
    96	    proc_cwd = Path(f"/proc/{pid}/cwd")
    97	    if proc_cwd.is_symlink():
    98	        try:
    99	            resolved = proc_cwd.resolve()
   100	            if resolved.is_dir():
   101	                return str(resolved)
   102	        except Exception:
   103	            pass
   104	    # macOS / BSD via lsof.
   105	    try:
   106	        result = subprocess.run(
   107	            ["lsof", "-p", str(pid), "-a", "-d", "cwd", "-Fn"],
   108	            capture_output=True,
   109	            text=True,
   110	            check=False,
   111	            timeout=2,
   112	        )
   113	        for line in result.stdout.splitlines():
   114	            if line.startswith("n"):
   115	                candidate = line[1:]
   116	                if Path(candidate).is_dir():
   117	                    return candidate
   118	    except Exception:
   119	        pass
   120	    return None
   121	
   122	
   123	def _read_ps() -> list[str]:
   124	    try:
   125	        result = subprocess.run(
   126	            ["ps", "-eo", "pid,ppid,etime,time,args"],
   127	            capture_output=True,
   128	            text=True,
   129	            check=True,
   130	            timeout=10,
   131	        )
   132	        return result.stdout.splitlines()
   133	    except Exception:
   134	        return []

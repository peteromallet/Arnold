    67	        author_id = _optional_snowflake(getattr(author, "id", None))
    68	        channel_id = _optional_snowflake(getattr(channel, "id", None))
    69	        thread_id = None
    70	        dm_user_id = None
    71	        parent = getattr(channel, "parent", None)
    72	        if parent is not None and _optional_snowflake(getattr(parent, "id", None)):
    73	            thread_id = channel_id
    74	            channel_id = _optional_snowflake(getattr(parent, "id", None))
    75	        if guild_id is None:
    76	            dm_user_id = author_id
    77	        if not author_id:
    78	            raise ValueError("Discord message author has no stable id")
    79	        if not channel_id:

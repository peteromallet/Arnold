   192	
   193	    class _FakeResponse:
   194	        def __init__(self, payload: dict[str, Any]) -> None:
   195	            self._payload = payload
   196	
   197	        def read(self) -> bytes:
   198	            return json.dumps(self._payload).encode("utf-8")
   199	
   200	        def __enter__(self) -> "_FakeResponse":
   201	            return self
   202	
   203	        def __exit__(self, exc_type, exc, tb) -> None:
   204	            return None
   205	
   206	    def fake_urlopen(req, timeout=10):
   207	        requests.append(
   208	            {
   209	                "url": req.full_url,
   210	                "headers": dict(req.header_items()),

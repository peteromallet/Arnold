   593	    async def _load_live_cloud_chain_context(self) -> dict[str, Any] | None:
   594	        cloud_yaml = self.config.cloud_yaml_path
   595	        if not cloud_yaml:
   596	            return None
   597	        if not cloud_yaml.is_absolute():
   598	            cloud_yaml = Path.cwd() / cloud_yaml
   599	        if not cloud_yaml.exists():
   600	            return {
   601	                "available": False,
   602	                "cloud_yaml": str(self.config.cloud_yaml_path),
   603	                "message": "configured cloud YAML does not exist",
   604	            }
   605	        try:
   606	            result = await self.cloud_backend.run(
   607	                CloudToolRequest(
   608	                    operation="cloud_status_chain",
   609	                    arguments={
   610	                        "project_root": str(Path.cwd()),
   611	                        "cloud_yaml": str(self.config.cloud_yaml_path),
   612	                    },
   613	                )
   614	            )
   615	        except Exception as exc:
   616	            return {
   617	                "available": False,
   618	                "cloud_yaml": str(self.config.cloud_yaml_path),
   619	                "error": f"{exc.__class__.__name__}: {exc}",
   620	            }
   621	        return {
   622	            "available": True,
   623	            "cloud_yaml": str(self.config.cloud_yaml_path),
   624	            "classification": result.classification,
   625	            "summary": result.summary,
   626	            "details": result.details,
   627	        }

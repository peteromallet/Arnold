   359	def test_megaplan_resident_hot_context_builds_fresh_with_markers_without_env(
   360	    tmp_path: Path,
   361	    monkeypatch: pytest.MonkeyPatch,
   362	) -> None:
   363	    """P0: marker-dir presence (not the trust env var) triggers a fresh build, so
   364	    a resident that lost MEGAPLAN_TRUSTED_CONTAINER on a manual restart still
   365	    serves live per-turn data. Without the env var it must NOT clobber the shared
   366	    cache."""
   367	    import json
   368	    from arnold_pipelines.megaplan.cloud import status_snapshot
   369	
   370	    marker_dir = tmp_path / "cloud-sessions"
   371	    marker_dir.mkdir()
   372	    ws = tmp_path / "live"
   373	    ws.mkdir()
   374	    (marker_dir / "live.json").write_text(
   375	        json.dumps(
   376	            {
   377	                "session": "live",
   378	                "workspace": str(ws),
   379	                "remote_spec": "/spec/live",
   380	                "started_at": "2026-07-04T20:00:00Z",
   381	                "run_kind": "chain",
   382	            }
   383	        ),
   384	        encoding="utf-8",
   385	    )
   386	    monkeypatch.delenv("MEGAPLAN_TRUSTED_CONTAINER", raising=False)
   387	    monkeypatch.setattr(status_snapshot, "DEFAULT_MARKER_DIR", marker_dir)
   388	    monkeypatch.setattr(status_snapshot, "DEFAULT_WATCHDOG_REPORT", tmp_path / "absent-report.json")
   389	    on_disk = tmp_path / "cloud-status.json"
   390	
   391	    profile = MegaplanResidentProfile(
   392	        store=FileStore(tmp_path / "store"),
   393	        config=ResidentConfig(status_snapshot_path=on_disk),
   394	        cloud_backend=FakeCloudBackend(),
   395	    )
   396	    monkeypatch.chdir(tmp_path)
   397	
   398	    context = asyncio.run(profile.load_hot_context("c"))
   399	
   400	    snap = context["cloud_status_snapshot"]
   401	    assert snap is not None
   402	    assert context["cloud_status_degraded"] is None
   403	    # Fresh build reflects the live marker even without the trust env var...
   404	    assert any(s["session"] == "live" for s in snap["sessions"])
   405	    # ...visibility reports the actual trust/marker state.
   406	    assert context["resident_runtime"]["has_local_markers"] is True
   407	    assert context["resident_runtime"]["trusted_container"] is False
   408	    # Without the trust env var, the shared cache must NOT be written.
   409	    assert not on_disk.exists()
   410	
   411	
   412	def test_megaplan_resident_hot_context_sanitizes_stale_snapshot(
   413	    tmp_path: Path,
   414	    monkeypatch: pytest.MonkeyPatch,
   415	) -> None:
   416	    """P1: a present-but-stale cache snapshot is sanitized — sessions/summary
   417	    stripped and a stale_banner attached — so the resident cannot cite frozen
   418	    numbers as authoritative, and plan_activity_summary marks it degraded."""
   419	    import json
   420	    from datetime import datetime, timedelta, timezone
   421	    from arnold_pipelines.megaplan.cloud import status_snapshot
   422	
   423	    project = tmp_path / "project"
   424	    project.mkdir()
   425	    old = (datetime.now(timezone.utc) - timedelta(hours=3)).isoformat().replace("+00:00", "Z")
   426	    snapshot_path = tmp_path / "cloud-status.json"
   427	    snapshot_path.write_text(
   428	        json.dumps(
   429	            {
   430	                "generated_at": old,
   431	                "source": "cloud-local-observer",
   432	                "summary": {"running": 1, "blocked": 0, "repairing": 0, "complete": 0, "attention": 0},
   433	                "sessions": [{"session": "frozen", "status": "running", "current_plan": "m1"}],
   434	                "degraded": None,
   435	            }
   436	        ),
   437	        encoding="utf-8",
   438	    )
   439	    # No marker dir on a laptop/CLI host -> cache-read path is taken.
   440	    monkeypatch.setattr(status_snapshot, "DEFAULT_MARKER_DIR", tmp_path / "no-cloud-sessions")
   441	
   442	    profile = MegaplanResidentProfile(
   443	        store=FileStore(tmp_path / "store"),
   444	        config=ResidentConfig(status_snapshot_path=snapshot_path),
   445	        cloud_backend=FakeCloudBackend(),
   446	    )
   447	    monkeypatch.chdir(project)
   448	
   449	    context = asyncio.run(profile.load_hot_context("c"))
   450	
   451	    snap = context["cloud_status_snapshot"]
   452	    assert snap is not None
   453	    assert snap["sessions"] == []                # stale numbers withheld
   454	    assert snap["summary"]["running"] == 0
   455	    assert snap["stale_banner"]
   456	    assert "WATCHDOG STALE" in snap["stale_banner"]
   457	    assert context["cloud_status_degraded"] is not None
   458	    assert context["plan_activity_summary"]["degraded"] is True


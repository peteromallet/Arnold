    33	
    34	    @property
    35	    def conversation_key(self) -> str:
    36	        if self.dm_user_id:
    37	            return f"discord:dm:{self.dm_user_id}"
    38	        thread_part = f":thread:{self.thread_id}" if self.thread_id else ""
    39	        return f"discord:guild:{self.guild_id}:channel:{self.channel_id}{thread_part}"
    40	
    41	    @classmethod
    42	    def from_conversation_key(cls, conversation_key: str) -> "DiscordDeliveryTarget":
    43	        parts = [part for part in conversation_key.split(":") if part]
    44	        if parts[:2] == ["discord", "dm"] and len(parts) == 3:
    45	            return cls(guild_id=None, channel_id=parts[2], dm_user_id=parts[2])
    46	        if parts[:2] == ["discord", "guild"] and len(parts) >= 5 and parts[3] == "channel":
    47	            thread_id = parts[6] if len(parts) >= 7 and parts[5] == "thread" else None
    48	            return cls(guild_id=parts[2], channel_id=parts[4], thread_id=thread_id)
    49	        raise ValueError(f"Unsupported Discord conversation key: {conversation_key}")

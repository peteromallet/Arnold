   629	    def _load_cloud_status_snapshot(self) -> tuple[dict[str, Any] | None, str | None]:
   630	        """Load the canonical cloud status snapshot for broad-status answers.
   631	
   632	        Returns ``(snapshot, degraded_reason)``. ``degraded_reason`` is ``None``
   633	        when the snapshot is present and fresh; otherwise it explains why the
   634	        resident must fall back to local plan evidence (clearly labeled as
   635	        degraded, not canonical). Never raises — a missing/unreadable snapshot
   636	        is the degraded-mode signal, not an error.
   637	
   638	        Inside the trusted container the snapshot is built fresh from local
   639	        observation on every call, so hot context always reflects the current
   640	        running/stuck/done set (the on-disk file the watchdog writes hourly can
   641	        lag a newly-started session by up to a tick). Elsewhere the on-disk file
   642	        is read with a freshness window.
   643	        """
   644	        # P0: build fresh whenever the canonical marker dir is present — the real
   645	        # "I'm on the box" signal — NOT gated on MEGAPLAN_TRUSTED_CONTAINER. A
   646	        # resident that lost the env var on a manual restart still serves live
   647	        # per-turn data instead of a stale cache. The env var now only gates the
   648	        # best-effort shared-file write (so an arbitrary on-box process doesn't
   649	        # clobber the watchdog's cache).
   650	        if status_snapshot.has_local_markers():
   651	            try:
   652	                snapshot = status_snapshot.build_cloud_status_snapshot()
   653	            except Exception as exc:  # pragma: no cover - defensive guard
   654	                return None, f"snapshot build failed: {exc.__class__.__name__}: {exc}"
   655	            if status_snapshot.is_trusted_container():
   656	                # Best-effort refresh of the shared on-disk file so CLI/laptop
   657	                # and later reads see the current view too. The watchdog still
   658	                # owns the hourly cadence; this just keeps the file fresh between
   659	                # sweeps while the resident is active. A write failure never
   660	                # degrades the answer.
   661	                try:
   662	                    status_snapshot.write_cloud_status_snapshot(
   663	                        snapshot, path=self.config.status_snapshot_path
   664	                    )
   665	                except Exception:  # pragma: no cover - best effort
   666	                    pass
   667	            return snapshot, None
   668	        path = self.config.status_snapshot_path
   669	        try:
   670	            snapshot, degraded_reason = status_snapshot.load_cloud_status_snapshot(
   671	                path, max_age_s=_SNAPSHOT_MAX_AGE_S
   672	            )
   673	        except Exception as exc:  # pragma: no cover - defensive guard for callers
   674	            return None, f"snapshot load failed at {path}: {exc.__class__.__name__}"
   675	        if snapshot is None:
   676	            return None, degraded_reason
   677	        # P1: never serve stale numbers as authoritative. When the cached file is
   678	        # present but stale, strip sessions/summary (so the resident cannot cite
   679	        # frozen progress as if live), keep generated_at for honesty, and attach
   680	        # a verbatim stale_banner the prompt must lead with.
   681	        if degraded_reason:
   682	            return _sanitize_stale_snapshot(snapshot, degraded_reason), degraded_reason
   683	        return snapshot, None

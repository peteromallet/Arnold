   208	def _resolve_escalation_id_from_message_id(message_id: str | None) -> str | None:
   209	    if not message_id:
   210	        return None
   211	    ledger_path = _escalations_ledger_path()
   212	    if ledger_path is None or not ledger_path.exists():
   213	        return None
   214	    try:
   215	        for raw_line in ledger_path.read_text(encoding="utf-8").splitlines():
   216	            line = raw_line.strip()
   217	            if not line:
   218	                continue
   219	            record = json.loads(line)
   220	            if not isinstance(record, dict):
   221	                continue
   222	            if str(record.get("event") or "") != "delivered":
   223	                continue
   224	            message_ids = record.get("message_ids")
   225	            if not isinstance(message_ids, list):
   226	                continue
   227	            if message_id not in {str(item) for item in message_ids if str(item).strip()}:
   228	                continue
   229	            escalation_id = str(record.get("escalation_id") or "").strip()
   230	            if escalation_id:
   231	                return escalation_id
   232	    except Exception:
   233	        LOGGER.exception("Failed to resolve escalation id from Discord message reference")
   234	    return None
   235	
   236	
   237	def _escalations_ledger_path() -> Path | None:
   238	    for key in ("MEGAPLAN_RESIDENT_REPAIR_DATA_DIR", "CLOUD_WATCHDOG_REPAIR_DATA_DIR"):
   239	        value = os.environ.get(key, "").strip()
   240	        if value:
   241	            return Path(value) / "escalations" / "escalations.jsonl"
   242	    return None

  5014	def _emit_cloud_status_human(snapshot: dict[str, Any] | None, *, compact: bool) -> None:
  5015	    text = (
  5016	        status_format.format_cloud_status_short(snapshot, max_chars=10**9)[0]
  5017	        if compact
  5018	        else status_format.format_cloud_status_detailed(snapshot)
  5019	    )
  5020	    if text:
  5021	        sys.stderr.write(text + "\n")

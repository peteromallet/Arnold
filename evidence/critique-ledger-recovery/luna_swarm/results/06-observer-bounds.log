   293	def plan_activity_summary(snapshot: Mapping[str, Any] | None) -> dict[str, Any]:
   294	    """Derive the resident ``plan_activity_summary`` from a snapshot.
   295	
   296	    Returns three buckets — ``active_working`` (running),
   297	    ``should_be_working_but_needs_attention`` (repairing + attention + blocked
   298	    that should be running), and ``recently_completed`` — plus a ``degraded``
   299	    flag when no snapshot was supplied. This is the shape the resident hot
   300	    context injects; it is derived from the canonical snapshot first.
   301	    """
   302	    if not snapshot or not isinstance(snapshot, Mapping):
   303	        return {
   304	            "degraded": True,
   305	            "reason": "no cloud status snapshot available",
   306	            "active_working": [],
   307	            "should_be_working_but_needs_attention": [],
   308	            "recently_completed": [],
   309	        }
   310	    # A sanitized stale snapshot (P1) carries a stale_banner and intentionally
   311	    # empty buckets; surface it as degraded with the banner so consumers never
   312	    # read "0 running" off a frozen view as "nothing is running".
   313	    if snapshot.get("stale_banner"):
   314	        return {
   315	            "degraded": True,
   316	            "reason": snapshot.get("stale_reason") or "snapshot stale",
   317	            "stale_banner": snapshot.get("stale_banner"),
   318	            "active_working": [],
   319	            "should_be_working_but_needs_attention": [],
   320	            "recently_completed": [],
   321	        }
   322	    sessions = snapshot.get("sessions") or []
   323	    active: list[dict[str, Any]] = []
   324	    needs_attention: list[dict[str, Any]] = []
   325	    completed: list[dict[str, Any]] = []
   326	    for entry in sessions:
   327	        if not isinstance(entry, Mapping):
   328	            continue
   329	        compact = {
   330	            "session": entry.get("session"),
   331	            "status": entry.get("status"),
   332	            "current_plan": entry.get("current_plan"),
   333	            "operator_next": entry.get("operator_next"),
   334	            "latest_activity": entry.get("latest_activity"),
   335	            "progress": entry.get("progress"),
   336	        }
   337	        status = entry.get("status")
   338	        if status == "running":
   339	            active.append(compact)
   340	        elif status == "complete":
   341	            completed.append(compact)
   342	        elif status in {"repairing", "attention", "blocked"}:
   343	            needs_attention.append(compact)
   344	    return {
   345	        "degraded": False,
   346	        "active_working": active,
   347	        "should_be_working_but_needs_attention": needs_attention,
   348	        "recently_completed": completed,
   349	    }

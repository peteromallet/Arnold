 16377	def test_scan_once_writes_heartbeat_and_early_snapshot_before_heavy_work() -> None:
 16378	    """P2: scan_once touches the heartbeat and writes a best-effort snapshot
 16379	    BEFORE repair_trigger_scan / git sync / pip refresh, so a hang later in the
 16380	    sweep leaves the cache ~one sweep stale instead of frozen."""
 16381	    text = _wrapper("arnold-watchdog")
 16382	    body = text[text.index("scan_once() {"):]
 16383	    i_scan = body.index('log "scan start')
 16384	    i_hb = body.index("write_watchdog_heartbeat", i_scan)
 16385	    i_early = body.index('write_status_snapshot "" "" "" notrack', i_hb)
 16386	    i_repair = body.index("repair_trigger_scan", i_early)
 16387	    assert i_scan < i_hb < i_early < i_repair

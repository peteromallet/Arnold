   155	def split_discord_message(content: str) -> list[str]:
   156	    """Split outbound Discord text into messages below Discord's hard limit."""
   157	
   158	    text = str(content or "")
   159	    if len(text) <= DISCORD_MESSAGE_LIMIT:
   160	        return [text]
   161	    chunks: list[str] = []
   162	    remaining = text
   163	    while remaining:
   164	        chunk, remaining = _split_once(remaining, DISCORD_SAFE_MESSAGE_LIMIT)
   165	        chunks.append(chunk)
   166	    return chunks
   167	
   168	
   169	def _split_once(text: str, limit: int) -> tuple[str, str]:
   170	    if len(text) <= limit:
   171	        return text, ""
   172	    split_at = max(
   173	        text.rfind("\n\n", 0, limit + 1),
   174	        text.rfind("\n", 0, limit + 1),
   175	        text.rfind(" ", 0, limit + 1),
   176	    )
   177	    if split_at <= 0:
   178	        split_at = limit
   179	    chunk = text[:split_at].rstrip()
   180	    rest = text[split_at:].lstrip()
   181	    if not chunk:
   182	        chunk = text[:limit]
   183	        rest = text[limit:]
   184	    return chunk, rest
   185	

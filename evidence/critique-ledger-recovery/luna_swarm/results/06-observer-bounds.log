  5005	def _in_trusted_container() -> bool:
  5006	    """True when this process is the cloud worker itself (no SSH needed).
  5007	
  5008	    Delegates to :func:`status_snapshot.is_trusted_container` so the CLI and the
  5009	    resident share one definition of "we are the box."

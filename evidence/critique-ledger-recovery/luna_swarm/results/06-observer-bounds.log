   259	def load_cloud_status_snapshot(
   260	    path: Path | str = DEFAULT_SNAPSHOT_PATH,
   261	    *,
   262	    max_age_s: float | None = None,
   263	    now: datetime | None = None,
   264	) -> tuple[dict[str, Any] | None, str | None]:
   265	    """Read a snapshot from disk, returning ``(snapshot, degraded_reason)``.
   266	
   267	    Returns ``(None, reason)`` when the file is missing, unreadable, or — when
   268	    ``max_age_s`` is given — older than the freshness window. This is the single
   269	    entry point consumers use to decide snapshot-first vs. degraded fallback.
   270	    """
   271	    path = Path(path)
   272	    if not path.exists():
   273	        return None, f"snapshot missing at {path}"
   274	    try:
   275	        raw = path.read_text(encoding="utf-8")
   276	        snapshot = json.loads(raw)
   277	    except (OSError, json.JSONDecodeError) as exc:
   278	        return None, f"snapshot unreadable at {path}: {exc.__class__.__name__}"
   279	    if not isinstance(snapshot, dict):
   280	        return None, f"snapshot at {path} is not a JSON object"
   281	
   282	    if max_age_s is not None:
   283	        now = now or _utcnow()
   284	        generated_at = _parse_iso(snapshot.get("generated_at"))
   285	        if generated_at is None:
   286	            return snapshot, "snapshot has no generated_at timestamp"
   287	        age = (now - generated_at).total_seconds()
   288	        if age > max_age_s:
   289	            return snapshot, f"snapshot stale ({int(age)}s old, limit {int(max_age_s)}s)"
   290	    return snapshot, None

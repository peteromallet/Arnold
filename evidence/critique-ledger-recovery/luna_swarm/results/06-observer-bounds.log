    45	def test_status_all_in_container_builds_locally_without_ssh(
    46	    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture
    47	) -> None:
    48	    marker_dir = tmp_path / "cloud-sessions"
    49	    marker_dir.mkdir()
    50	    ws = tmp_path / "demo"
    51	    ws.mkdir()
    52	    (marker_dir / "demo.json").write_text(
    53	        json.dumps(
    54	            {
    55	                "session": "demo",
    56	                "workspace": str(ws),
    57	                "remote_spec": "/spec/demo",
    58	                "started_at": "2026-07-04T20:00:00Z",
    59	                "run_kind": "chain",
    60	            }
    61	        ),
    62	        encoding="utf-8",
    63	    )
    64	    (marker_dir / "demo.chain-health.progress.json").write_text(
    65	        json.dumps(
    66	            {
    67	                "chain_complete": False,
    68	                "completed_count": 1,
    69	                "milestone_count": 4,
    70	                "current_plan_name": "m1",
    71	                "last_state": "executed",
    72	                # Recent relative to the build's real ``now`` so the session
    73	                # classifies as running rather than stale attention.
    74	                "updated_at": (datetime.now(timezone.utc) - timedelta(seconds=30))
    75	                .isoformat()
    76	                .replace("+00:00", "Z"),
    77	            }
    78	        ),
    79	        encoding="utf-8",
    80	    )
    81	
    82	    monkeypatch.setenv("MEGAPLAN_TRUSTED_CONTAINER", "1")
    83	    monkeypatch.setattr(status_snapshot, "DEFAULT_MARKER_DIR", marker_dir)
    84	    monkeypatch.setattr(
    85	        status_snapshot, "DEFAULT_SNAPSHOT_PATH", tmp_path / "absent-cloud-status.json"
    86	    )
    87	    provider = _RecordingProvider()
    88	
    89	    rc = cli_module._run_status_all(spec=None, provider=provider, args=_args())
    90	
    91	    assert rc == 0
    92	    # The whole point: no SSH read or exec from inside the container.
    93	    assert provider.read_remote_file_calls == []
    94	    assert provider.ssh_exec_calls == []
    95	    out = capsys.readouterr().out
    96	    payload = json.loads(out)
    97	    assert payload["source"] == "cloud-local-observer"
    98	    assert payload["summary"]["running"] == 1
    99	    sessions = {s["session"]: s for s in payload["sessions"]}
   100	    assert sessions["demo"]["status"] == "running"

   791	def test_write_load_roundtrip_and_freshness(tmp_path, fx):
   792	    fx.add_session("a"); fx.add_chain_health("a")
   793	    snap = fx.build(watchdog_report_path=fx.root / "absent.json")
   794	    target = tmp_path / "status" / "cloud-status.json"
   795	    previous = tmp_path / "status" / "cloud-status.previous.json"
   796	
   797	    written = ss.write_cloud_status_snapshot(snap, path=target, previous_path=previous)
   798	    assert written == target
   799	
   800	    loaded, reason = ss.load_cloud_status_snapshot(target, max_age_s=60, now=NOW)
   801	    assert reason is None
   802	    assert loaded["summary"] == snap["summary"]
   803	
   804	    # Second write rotates the prior snapshot into previous_path.
   805	    snap2 = dict(snap)
   806	    snap2 = json.loads(json.dumps(snap))
   807	    snap2["generated_at"] = (NOW + timedelta(seconds=1)).isoformat().replace("+00:00", "Z")
   808	    ss.write_cloud_status_snapshot(snap2, path=target, previous_path=previous)
   809	    assert previous.exists()
   810	    rotated, _ = ss.load_cloud_status_snapshot(previous)
   811	    assert rotated["summary"] == snap["summary"]
   812	
   813	    stale, reason = ss.load_cloud_status_snapshot(target, max_age_s=60, now=NOW + timedelta(hours=2))
   814	    assert stale is not None
   815	    assert reason is not None
   816	    assert "stale" in reason

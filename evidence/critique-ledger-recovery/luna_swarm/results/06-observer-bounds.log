  1087	def _load_watchdog_report(
  1088	    primary: Path, fallback: Path
  1089	) -> tuple[dict[str, Any] | None, dict[str, dict[str, Any]], list[str]]:
  1090	    path = primary if primary.exists() else (fallback if fallback.exists() else None)
  1091	    if path is None:
  1092	        return None, {}, [f"watchdog report missing (looked for {primary}, {fallback})"]
  1093	    try:
  1094	        report = json.loads(path.read_text(encoding="utf-8"))
  1095	    except (OSError, json.JSONDecodeError) as exc:
  1096	        return None, {}, [f"watchdog report unreadable at {path}: {exc.__class__.__name__}"]
  1097	    if not isinstance(report, dict):
  1098	        return None, {}, [f"watchdog report at {path} is not a JSON object"]
  1099	    by_session: dict[str, dict[str, Any]] = {}
  1100	    for section in ("items", "issues"):
  1101	        items = report.get(section)
  1102	        if not isinstance(items, list):
  1103	            continue
  1104	        for item in items:
  1105	            if not isinstance(item, dict):
  1106	                continue
  1107	            name = item.get("session")
  1108	            if isinstance(name, str) and name:
  1109	                # Keep the most informative item per session.
  1110	                existing = by_session.get(name)
  1111	                if existing is None or _item_signal_rank(item) > _item_signal_rank(existing):
  1112	                    by_session[name] = item
  1113	    return report, by_session, []

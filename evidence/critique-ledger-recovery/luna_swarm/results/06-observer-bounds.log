  4282	def _load_watchdog_sessions():
  4283	    paths = [
  4284	        pathlib.Path("/workspace/watchdog-report.json"),
  4285	        pathlib.Path("/workspace/.megaplan/watchdog-report.json"),
  4286	    ]

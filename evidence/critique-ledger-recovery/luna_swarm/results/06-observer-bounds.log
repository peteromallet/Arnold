  1062	def _canonical_spec_missing(workspace: Path, remote_spec: str) -> bool:
  1063	    """True when a chain marker points at a spec that should exist locally.
  1064	
  1065	    Many tests and some legacy markers carry placeholder specs outside the
  1066	    workspace. Those are not enough to invalidate a session. A spec inside the
  1067	    session workspace is canonical durable input, though; if that file is gone,
  1068	    old chain-health and needs-human sidecars are stale evidence and must not
  1069	    keep the session classified as a live blocker.
  1070	    """
  1071	    if not remote_spec:
  1072	        return False
  1073	    try:
  1074	        spec_path = Path(remote_spec)
  1075	        workspace_resolved = workspace.resolve()
  1076	        spec_resolved = spec_path.resolve(strict=False)
  1077	    except (OSError, RuntimeError, ValueError):
  1078	        return False
  1079	    if spec_resolved != workspace_resolved and workspace_resolved not in spec_resolved.parents:
  1080	        return False
  1081	    return not spec_path.exists()

  1122	        "reaped",
  1123	        "sync_dirty",
  1124	        "sync_failed",
  1125	        "alive",
  1126	        "skipped",
  1127	        "synced",
  1128	        "complete",
  1129	        "completed",
  1130	    ]
  1131	    try:
  1132	        return len(order) - order.index(status)
  1133	    except ValueError:

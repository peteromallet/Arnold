     1	"""Shared formatters for the canonical cloud status snapshot.
     2	
     3	One formatter set, consumed by every status surface so they can never disagree:
     4	
     5	- :func:`format_cloud_status_short` — compact Discord reply (chunked to fit the
     6	  2000-character message limit).
     7	- :func:`format_cloud_status_detailed` — multi-line CLI / human view.
     8	- :func:`format_attention_only` — watchdog alert body for sessions needing eyes.
     9	
    10	All three take the snapshot dict produced by
    11	:mod:`arnold_pipelines.megaplan.cloud.status_snapshot` and render plain text.
    12	They never read files or SSH; they only format what the snapshot already holds,
    13	so a snapshot is genuinely the single source of truth.
    14	"""
    15	
    16	from __future__ import annotations
    17	
    18	from typing import Any, Iterable, Mapping
    19	
    20	# Discord's hard per-message ceiling. Stay under it with headroom for code fences.
    21	DISCORD_MESSAGE_LIMIT = 2000
    22	DISCORD_SAFE_LIMIT = 1900
    23	
    24	_STATUS_EMOJI = {
    25	    "running": "🟢",
    26	    "repairing": "🛠️",
    27	    "blocked": "🚫",
    28	    "complete": "✅",
    29	    "attention": "⚠️",
    30	}
    31	
    32	_STATUS_ORDER = ("running", "repairing", "blocked", "attention", "complete")
    33	
    34	
    35	def _summary_line(snapshot: Mapping[str, Any]) -> str:
    36	    summary = snapshot.get("summary") or {}
    37	    parts = [
    38	        f"{summary.get('running', 0)} running",
    39	        f"{summary.get('repairing', 0)} repairing",
    40	        f"{summary.get('blocked', 0)} blocked",
    41	        f"{summary.get('attention', 0)} attention",
    42	        f"{summary.get('complete', 0)} complete",
    43	    ]
    44	    return ", ".join(parts)
    45	
    46	
    47	def _evidence_citation(snapshot: Mapping[str, Any]) -> str:
    48	    generated = snapshot.get("generated_at") or snapshot.get("watchdog_generated_at") or "?"
    49	    source = snapshot.get("source", "?")
    50	    return f"source: {source} · generated: {generated}"
    51	
    52	
    53	def _ordered_sessions(snapshot: Mapping[str, Any]) -> list[Mapping[str, Any]]:
    54	    sessions = [s for s in (snapshot.get("sessions") or []) if isinstance(s, Mapping)]
    55	
    56	    def rank(entry: Mapping[str, Any]) -> tuple[int, str]:
    57	        status = entry.get("status", "")
    58	        try:
    59	            return (_STATUS_ORDER.index(status), entry.get("session", ""))
    60	        except ValueError:
    61	            return (len(_STATUS_ORDER), entry.get("session", ""))
    62	
    63	    return sorted(sessions, key=rank)

   131	    async def send(self, message: OutboundMessage) -> None:
   132	        if self.client is None:
   133	            raise RuntimeError("Discord client is not bound")
   134	        target = DiscordDeliveryTarget.from_conversation_key(message.conversation_key)
   135	        channel = await self._resolve_channel(target)

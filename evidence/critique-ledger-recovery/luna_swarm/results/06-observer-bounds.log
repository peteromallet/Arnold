   308	def test_megaplan_resident_hot_context_builds_fresh_snapshot_in_trusted_container(
   309	    tmp_path: Path,
   310	    monkeypatch: pytest.MonkeyPatch,
   311	) -> None:
   312	    """In-container, the resident builds a fresh local snapshot each turn instead
   313	    of reading the (stale, hourly) on-disk file, so newly-started sessions appear
   314	    immediately and the on-disk file is refreshed."""
   315	    import json
   316	    from arnold_pipelines.megaplan.cloud import status_snapshot
   317	
   318	    marker_dir = tmp_path / "cloud-sessions"
   319	    marker_dir.mkdir()
   320	    ws = tmp_path / "live"
   321	    ws.mkdir()
   322	    (marker_dir / "live.json").write_text(
   323	        json.dumps(
   324	            {
   325	                "session": "live",
   326	                "workspace": str(ws),
   327	                "remote_spec": "/spec/live",
   328	                "started_at": "2026-07-04T20:00:00Z",
   329	                "run_kind": "chain",
   330	            }
   331	        ),
   332	        encoding="utf-8",
   333	    )
   334	    monkeypatch.setenv("MEGAPLAN_TRUSTED_CONTAINER", "1")
   335	    monkeypatch.setattr(status_snapshot, "DEFAULT_MARKER_DIR", marker_dir)
   336	    monkeypatch.setattr(status_snapshot, "DEFAULT_WATCHDOG_REPORT", tmp_path / "absent-report.json")
   337	    on_disk = tmp_path / "cloud-status.json"
   338	
   339	    profile = MegaplanResidentProfile(
   340	        store=FileStore(tmp_path / "store"),
   341	        # Points at a nonexistent file; in-container it must be ignored in favor of a fresh build.
   342	        config=ResidentConfig(status_snapshot_path=on_disk),
   343	        cloud_backend=FakeCloudBackend(),
   344	    )
   345	    monkeypatch.chdir(tmp_path)
   346	
   347	    context = asyncio.run(profile.load_hot_context("c"))
   348	
   349	    snap = context["cloud_status_snapshot"]
   350	    assert snap is not None
   351	    assert context["cloud_status_degraded"] is None
   352	    assert any(s["session"] == "live" for s in snap["sessions"])
   353	    # The fresh build also refreshed the on-disk file for CLI/laptop consumers.
   354	    assert on_disk.exists()
   355	    written = json.loads(on_disk.read_text(encoding="utf-8"))
   356	    assert any(s["session"] == "live" for s in written["sessions"])

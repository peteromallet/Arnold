  5080	def _run_cloud_chains(spec: CloudSpec, provider, *, args: argparse.Namespace | None = None) -> int:
  5081	    del spec
  5082	    result = provider.ssh_exec(_cloud_chains_command())
  5083	    if result.returncode != 0:
  5084	        _relay_output(result, secret_names=[], env=os.environ)
  5085	        raise CliError("provider_failed", "unable to list remote cloud chain sessions")
  5086	    try:
  5087	        payload = json.loads((result.stdout or "").strip().splitlines()[-1])
  5088	    except (IndexError, json.JSONDecodeError) as exc:
  5089	        raise CliError("provider_failed", f"cloud chains did not return JSON: {exc}") from exc
  5090	    since = _parse_cloud_status_since(getattr(args, "since", None) if args is not None else None)

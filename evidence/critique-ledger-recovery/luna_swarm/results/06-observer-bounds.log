   583	def _plan_stage_percent(plan_state: str) -> int | None:
   584	    """Estimate a coarse "% through the in-flight plan" from its lifecycle state.
   585	
   586	    A plan advances through a fixed ladder of stages (``PLAN_PROGRESSION_RUNGS``);
   587	    its recorded ``current_state`` (exposed via chain-health ``last_state``) tells
   588	    us how many it has completed. We map that to completed-stages / total-stages.
   589	    ``initialized`` is 0%; an off-ladder state (blocked / failed / awaiting_* /
   590	    tiebreaker_*) is not percentage-able, so we return ``None`` and let the caller
   591	    surface the raw state label instead. This is a deliberately coarse stage
   592	    estimate, not exact sub-plan progress — stages are treated as equal-weight.
   593	    """
   594	    if not plan_state:
   595	        return None
   596	    if plan_state == STATE_INITIALIZED:
   597	        return 0
   598	    try:
   599	        index = PLAN_PROGRESSION_RUNGS.index(plan_state)
   600	    except ValueError:
   601	        return None
   602	    return round((index + 1) / len(PLAN_PROGRESSION_RUNGS) * 100)

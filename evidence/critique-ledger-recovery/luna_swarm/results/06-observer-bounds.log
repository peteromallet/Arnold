   450	    def _reschedule_cloud_check(self, job: ScheduledJob, run: CloudRun) -> None:
   451	        pending = self.store.list_scheduled_jobs(
   452	            conversation_id=job.conversation_id,
   453	            cloud_run_id=run.id,
   454	            status="pending",
   455	            job_type="cloud_check",
   456	            limit=1,
   457	        )
   458	        if pending:
   459	            return
   460	        interval = int(job.payload.get("check_interval_s") or self.reschedule_interval_s or self.config.scheduler_poll_interval_s)
   461	        self.store.create_scheduled_job(
   462	            ScheduledJobInput(
   463	                job_type="cloud_check",
   464	                conversation_id=job.conversation_id,
   465	                cloud_run_id=run.id,
   466	                epic_id=run.epic_id or job.epic_id,
   467	                payload=dict(job.payload),
   468	                scheduled_for=utc_now() + timedelta(seconds=max(1, interval)),
   469	                max_attempts=job.max_attempts,
   470	            ),
   471	            idempotency_key=deterministic_idempotency_key(
   472	                "resident-cloud-check-reschedule",
   473	                run.id,
   474	                job.attempt_count,
   475	                run.last_checked_at.isoformat() if run.last_checked_at else "",
   476	            ),
   477	        )

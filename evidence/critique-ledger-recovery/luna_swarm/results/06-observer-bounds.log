    11	def test_status_command_accepts_project_dir_and_plan(
    12	    capsys,
    13	    tmp_path: Path,
    14	) -> None:
    15	    root = tmp_path / "root"
    16	    root.mkdir()
    17	    project_dir = tmp_path / "project"
    18	    project_dir.mkdir()
    19	
    20	    base = cli.build_parser().parse_args(["init"])
    21	    args = argparse.Namespace(**vars(base))
    22	    args.project_dir = str(project_dir)
    23	    args.idea = "fixture plan"
    24	    args.name = "fixture-plan"
    25	    args.robustness = "standard"
    26	
    27	    response = handle_init(root, args)
    28	    plan_name = response["plan"]
    29	
    30	    rc = cli.main(["status", "--project-dir", str(root), "--plan", plan_name])
    31	
    32	    payload = json.loads(capsys.readouterr().out)
    33	    assert rc == 0
    34	    assert payload["success"] is True
    35	    assert payload["plan"] == plan_name
    36	    assert payload["state"] == "initialized"

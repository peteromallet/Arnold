 16417	def test_write_watchdog_heartbeat_writes_freshness_probe(tmp_path: Path) -> None:
 16418	    """P2: write_watchdog_heartbeat drops an ISO-8601 UTC probe in STATUS_DIR."""
 16419	    status_dir = tmp_path / "status"
 16420	    program = (
 16421	        "#!/usr/bin/env bash\nset -u\n"
 16422	        + _extract_wrapper_function("write_watchdog_heartbeat")
 16423	        + f'\nSTATUS_DIR="{status_dir}"\n'

   581	        chain_states = [_summarize_chain_state(path) for path in chain_paths]
   582	        return {
   583	            "searched_roots": [str(root) for root in roots],
   584	            "epic_chains": epic_states,
   585	            "chains": chain_states,
   586	            "active_chains": [
   587	                row
   588	                for row in chain_states

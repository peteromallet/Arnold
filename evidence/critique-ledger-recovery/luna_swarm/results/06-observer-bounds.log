  5070	def _cloud_status_snapshot_stale_reason(snapshot: Mapping[str, Any]) -> str | None:
  5071	    generated = status_snapshot._parse_iso(snapshot.get("generated_at"))
  5072	    if generated is None:
  5073	        return "missing generated_at"
  5074	    age = (datetime.now(timezone.utc) - generated).total_seconds()
  5075	    if age > CLOUD_STATUS_CLI_MAX_AGE_S:
  5076	        return f"{int(age)}s old, limit {CLOUD_STATUS_CLI_MAX_AGE_S}s"
  5077	    return None

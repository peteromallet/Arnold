    21	class _RecordingProvider:
    22	    """Records every SSH-touching call so tests can assert none happened."""
    23	
    24	    def __init__(self, *, remote_snapshot: dict | None = None, fail_read: bool = False) -> None:
    25	        self._remote_snapshot = remote_snapshot
    26	        self._fail_read = fail_read
    27	        self.read_remote_file_calls: list[str] = []
    28	        self.ssh_exec_calls: list[str] = []
    29	
    30	    def read_remote_file(self, path: str) -> str:
    31	        self.read_remote_file_calls.append(path)
    32	        if self._fail_read:
    33	            raise OSError("boom")
    34	        return json.dumps(self._remote_snapshot or {})
    35	
    36	    def ssh_exec(self, command: str):
    37	        self.ssh_exec_calls.append(command)
    38	        raise AssertionError("ssh_exec should not be called in the snapshot path")
    39	

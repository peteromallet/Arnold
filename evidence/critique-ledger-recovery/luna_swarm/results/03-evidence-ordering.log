)

_VALID_EXIT_KINDS: frozenset[str] = frozenset(e.value for e in ExitKind)


def _optional_int(value: Any) -> int:
    if value is None:
        return 0
    try:
        return int(value)
    except (TypeError, ValueError):
        return 0


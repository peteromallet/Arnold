  2535	def _tmux_chain_launch_command(
  2536	    workspace: str,
  2537	    remote_spec_path: str,
  2538	    *,
  2539	    one_shot: bool = False,
  2540	    no_git_refresh: bool = False,
  2541	    force_clean_editable_install: bool = False,
  2542	    session_name: str | None = None,
  2543	    spec: CloudSpec | None = None,
  2544	    log_relative: str = _CHAIN_LOG_RELATIVE,
  2545	    marker_path: str | None = None,
  2546	    identity_digest: str | None = None,
  2547	    marker_payload: dict[str, Any] | None = None,

   172	        ):
   173	            raise CliError(
   174	                "invalid_spec",
   175	                f"epics[{index}].observe_spec must be a non-empty string",
   176	            )
   177	        unknown = sorted(
   178	            set(raw) - {"id", "spec", "observe_spec", "handoff_from_previous"}
   179	        )
   180	        if unknown:

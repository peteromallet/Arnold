    72	@dataclass(frozen=True)
    73	class EpicFailurePolicy:
    74	    abort: str = "stop_epic_chain"
    75	
    76	    @classmethod
    77	    def from_yaml(cls, value: Any, section: str) -> "EpicFailurePolicy":
    78	        if value is None:
    79	            return cls()
    80	        if isinstance(value, str):
    81	            if value not in VALID_EPIC_FAILURE_ACTIONS:
    82	                raise CliError(
    83	                    "invalid_spec",
    84	                    f"{section} must be one of {VALID_EPIC_FAILURE_ACTIONS}; got {value!r}",
    85	                )
    86	            return cls(abort=value)
    87	        if not isinstance(value, dict):
    88	            raise CliError(
    89	                "invalid_spec",
    90	                f"`{section}` must be a string or a mapping with `abort`",
    91	            )
    92	        abort = value.get("abort", "stop_epic_chain")
    93	        if abort not in VALID_EPIC_FAILURE_ACTIONS:
    94	            raise CliError(
    95	                "invalid_spec",
    96	                f"{section}.abort must be one of {VALID_EPIC_FAILURE_ACTIONS}; got {abort!r}",
    97	            )
    98	        unknown = sorted(set(value) - {"abort"})
    99	        if unknown:
   100	            raise CliError(
   101	                "invalid_spec",
   102	                f"`{section}` only supports `abort`; unknown key `{unknown[0]}`",
   103	            )
   104	        return cls(abort=abort)

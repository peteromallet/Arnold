    10	from pathlib import Path
    11	from typing import Literal, Protocol
    12	
    13	from arnold_pipelines.megaplan.cloud.cli import build_cloud_parser, run_cloud_cli
    14	
    15	CloudClassification = Literal["running", "blocked", "failed", "gate-needed", "completed", "unknown"]
    16	CloudOperation = Literal[
    17	    "cloud_status",
    18	    "cloud_status_chain",
    19	    "cloud_start_chain",
    20	    "cloud_bootstrap",
    21	    "cloud_resume",
    22	    "cloud_logs",
    23	]
    24	
    25	
    26	@dataclass(frozen=True)
    27	class CloudToolRequest:
    28	    operation: CloudOperation
    29	    target_id: str | None = None
    30	    arguments: dict[str, str] = field(default_factory=dict)
    31	    confirmed: bool = False
    32	
    33	
    34	@dataclass(frozen=True)
    35	class CloudToolResult:
    36	    classification: CloudClassification
    37	    summary: str
    38	    details: dict[str, object] = field(default_factory=dict)
    39	
    40	
    41	class CloudToolBackend(Protocol):
    42	    async def run(self, request: CloudToolRequest) -> CloudToolResult:
    43	        """Execute one constrained cloud operation."""
    44	
    45	
    46	class CloudCliBackend:
    47	    """Default resident backend that dispatches through existing cloud CLI code."""
    48	
    49	    async def run(self, request: CloudToolRequest) -> CloudToolResult:
    50	        argv = _argv_for_request(request)
    51	        root = Path(request.arguments.get("project_root") or ".").expanduser().resolve()
    52	        parser = argparse.ArgumentParser()
    53	        build_cloud_parser(parser.add_subparsers(dest="command", required=True))
    54	        args = parser.parse_args(["cloud", *argv])
    55	        stdout = StringIO()
    56	        stderr = StringIO()
    57	        with contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr):
    58	            code = run_cloud_cli(root, args)
    59	        output = stdout.getvalue().strip()
    60	        error_output = stderr.getvalue().strip()
    61	        payload = _json_payload(output)
    62	        classification = classify_cloud_payload(payload or {"returncode": code, "stderr": error_output})
    63	        ok = code == 0
    64	        summary = _summary_for_payload(request.operation, classification, payload, ok=ok)
    65	        return CloudToolResult(
    66	            classification=classification if ok else "failed",
    67	            summary=summary,
    68	            details={
    69	                "returncode": code,
    70	                "stdout": output,
    71	                "stderr": error_output,
    72	                "payload": payload,
    73	                "argv": argv,
    74	            },
    75	        )
    76	
    77	
    78	def classify_cloud_payload(payload: object) -> CloudClassification:
    79	    """Classify status/chain payloads without depending on provider-specific text."""
    80	    flat = " ".join(str(value).lower() for value in _walk_values(payload))
    81	    if not flat.strip():
    82	        return "unknown"
    83	    if any(token in flat for token in ("gate-needed", "gate_needed", "gate pending", "gate_pending", "state_gated")):
    84	        return "gate-needed"
    85	    if any(token in flat for token in ("failed", "failure", "error", "state_failed", "traceback")):
    86	        return "failed"
    87	    if any(token in flat for token in ("blocked", "execution_blocked", "state_blocked")):
    88	        return "blocked"
    89	    if any(token in flat for token in ("completed", "complete", "done", "success", "state_done", "plan_done")):
    90	        return "completed"
    91	    if any(token in flat for token in ("running", "starting", "queued", "in_progress", "state_executing", "state_planning")):
    92	        return "running"
    93	    if isinstance(payload, dict) and payload.get("next_step"):
    94	        return "running"
    95	    return "unknown"
    96	
    97	
    98	def progress_kind_for_classification(classification: CloudClassification) -> str:
    99	    if classification == "completed":
   100	        return "plan_done"
   101	    if classification == "failed":
   102	        return "plan_failed"
   103	    if classification == "gate-needed":
   104	        return "gate_pending"
   105	    if classification == "blocked":
   106	        return "execution_blocked"
   107	    if classification == "running":
   108	        return "phase_start"
   109	    return "phase_end"
   110	
   111	
   112	def cloud_run_status_for_classification(classification: CloudClassification) -> str:
   113	    """Map resident cloud classifications onto CloudRun.status values."""
   114	    if classification == "completed":
   115	        return "completed"
   116	    if classification == "failed":
   117	        return "failed"
   118	    if classification == "blocked":
   119	        return "blocked"
   120	    if classification == "gate-needed":
   121	        return "gate-needed"
   122	    if classification == "running":
   123	        return "running"
   124	    return "unknown"
   125	
   126	
   127	def _argv_for_request(request: CloudToolRequest) -> list[str]:
   128	    args = request.arguments
   129	    cloud_yaml = args.get("cloud_yaml")
   130	    argv: list[str] = []
   131	    if request.operation == "cloud_status":
   132	        argv = ["status"]
   133	        if plan := args.get("plan"):
   134	            argv.extend(["--plan", plan])
   135	    elif request.operation == "cloud_status_chain":
   136	        argv = ["status", "--chain"]
   137	        if remote_spec := args.get("remote_spec"):
   138	            argv.extend(["--remote-spec", remote_spec])
   139	    elif request.operation == "cloud_start_chain":
   140	        spec = args.get("spec")
   141	        if not spec:
   142	            raise ValueError("cloud_start_chain requires spec")
   143	        argv = ["chain", spec]
   144	        if idea_dir := args.get("idea_dir"):
   145	            argv.extend(["--idea-dir", idea_dir])
   146	        _append_repo_args(argv, args)
   147	    elif request.operation == "cloud_bootstrap":
   148	        idea_file = args.get("idea_file")
   149	        if not idea_file:
   150	            raise ValueError("cloud_bootstrap requires idea_file")
   151	        argv = ["bootstrap", idea_file]
   152	        if plan_name := args.get("plan_name"):
   153	            argv.extend(["--plan-name", plan_name])
   154	        if robustness := args.get("robustness"):
   155	            argv.extend(["--robustness", robustness])
   156	        _append_repo_args(argv, args)
   157	    elif request.operation == "cloud_resume":
   158	        argv = ["resume"]
   159	        if plan := args.get("plan"):
   160	            argv.extend(["--plan", plan])
   161	    elif request.operation == "cloud_logs":
   162	        argv = ["logs"]
   163	        if args.get("no_follow") == "true":
   164	            argv.append("--no-follow")
   165	    else:
   166	        raise ValueError(f"unsupported cloud operation: {request.operation}")
   167	    if cloud_yaml:
   168	        argv.extend(["--cloud-yaml", cloud_yaml])
   169	    return argv
   170	
   171	
   172	def _append_repo_args(argv: list[str], args: dict[str, str]) -> None:
   173	    if repo_url := args.get("repo_url"):
   174	        argv.extend(["--repo-url", repo_url])
   175	    if repo_branch := args.get("repo_branch"):
   176	        argv.extend(["--repo-branch", repo_branch])
   177	    if repo_workspace := args.get("repo_workspace"):
   178	        argv.extend(["--repo-workspace", repo_workspace])
   179	
   180	
   181	def _summary_for_payload(
   182	    operation: CloudOperation,
   183	    classification: CloudClassification,
   184	    payload: object,
   185	    *,
   186	    ok: bool,
   187	) -> str:
   188	    if not ok:
   189	        return f"{operation} failed"
   190	    if isinstance(payload, dict):
   191	        next_step = payload.get("next_step")
   192	        if isinstance(next_step, str) and next_step:
   193	            return f"{operation}: next step {next_step}"
   194	        summary = payload.get("summary")
   195	        if isinstance(summary, dict):
   196	            current = summary.get("current")
   197	            if current:
   198	                return f"{operation}: {current}"
   199	    return f"{operation}: {classification}"
   200	
   201	
   202	def _json_payload(text: str) -> object | None:
   203	    if not text:
   204	        return None
   205	    try:
   206	        return json.loads(text)
   207	    except json.JSONDecodeError:
   208	        return None
   209	
   210	
   211	def _walk_values(value: object) -> list[object]:
   212	    if isinstance(value, dict):
   213	        values: list[object] = []
   214	        for key, item in value.items():
   215	            values.append(key)
   216	            values.extend(_walk_values(item))
   217	        return values
   218	    if isinstance(value, list):
   219	        values = []
   220	        for item in value:
   221	            values.extend(_walk_values(item))
   222	        return values
   223	    return [value]


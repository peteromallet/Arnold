   111	
   112	    @classmethod
   113	    def from_dict(cls, raw: dict[str, Any], index: int) -> "HandoffArtifactSpec":
   114	        if not isinstance(raw, dict):
   115	            raise CliError("invalid_spec", f"artifacts[{index}] must be a mapping")
   116	        path = raw.get("path")

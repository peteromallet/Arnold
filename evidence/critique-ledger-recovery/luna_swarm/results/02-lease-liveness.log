  2508	def _refresh_then_chain_start_command(
  2509	    remote_spec_path: str,
  2510	    *,
  2511	    spec: CloudSpec | None = None,
  2512	    project_dir: str | None = None,
  2513	    one_shot: bool = False,
  2514	    no_git_refresh: bool = False,
  2515	    force_clean_editable_install: bool = False,
  2516	    log_relative: str = _CHAIN_LOG_RELATIVE,
  2517	) -> str:
  2518	    runtime_src_path = (
  2519	        str(PurePosixPath(project_dir) / ".megaplan" / "runtime" / "editable-engine")
  2520	        if project_dir
  2521	        else None
  2522	    )
  2523	    refresh = _megaplan_refresh_command(
  2524	        spec,
  2525	        force_clean_editable_install=force_clean_editable_install,
  2526	        runtime_src_path=runtime_src_path,
  2527	    )
  2528	    engine_dir = spec.megaplan.src_path if spec is not None else "/workspace/arnold"
  2529	    return (
  2530	        f"{{ {refresh}; }} >> {shlex.quote(log_relative)} 2>&1 && "
  2531	        f"{_chain_start_command(remote_spec_path, project_dir=project_dir, engine_dir=engine_dir, one_shot=one_shot, no_git_refresh=no_git_refresh, log_relative=log_relative)}"
  2532	    )

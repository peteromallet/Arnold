   743	def _pid_is_live(pid: int) -> bool:
   744	    """True if ``pid`` names a live process this user can signal.
   745	
   746	    ``os.kill(pid, 0)`` raises ``ProcessLookupError`` for a dead pid and
   747	    ``PermissionError`` for a live pid owned by another user (still live). pid
   748	    <= 0 targets a process group / every process and must never be treated as a
   749	    specific live holder.
   750	    """
   751	    if pid <= 0:
   752	        return False
   753	    try:
   754	        os.kill(pid, 0)
   755	    except ProcessLookupError:
   756	        return False
   757	    except PermissionError:
   758	        return True
   759	    except OSError:
   760	        return False
   761	    return True

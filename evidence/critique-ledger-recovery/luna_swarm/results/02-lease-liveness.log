   218	            remaining = deadline - time.monotonic()
   219	            if remaining <= 0:
   220	                break
   221	            try:
   222	                proc.wait(timeout=min(0.1, remaining))
   223	                _reap_descendants(descendants, tag)
   224	                return
   225	            except subprocess.TimeoutExpired:
   226	                pass
   227	            except (ProcessLookupError, OSError):
   228	                _reap_descendants(descendants, tag)
   229	                return
   230	    else:

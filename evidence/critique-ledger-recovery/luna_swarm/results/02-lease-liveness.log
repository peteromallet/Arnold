  2581	        " && "
  2582	        f"if tmux has-session -t {shlex.quote(name)} 2>/dev/null; then "
  2583	        f"if [ -f {shlex.quote(marker)} ] && grep -F {shlex.quote(digest)} {shlex.quote(marker)} >/dev/null 2>&1; then "
  2584	        f"echo {shlex.quote(f'{name} session already running for this chain')}; "
  2585	        "else "
  2586	        f"echo {shlex.quote(f'ERROR: {name} session already running for a different chain; refusing to disturb it')}; "
  2587	        "exit 17; "
  2588	        "fi; "
  2589	        "else "
  2590	        f"{_write_session_marker_command(marker, marker_payload)}; "

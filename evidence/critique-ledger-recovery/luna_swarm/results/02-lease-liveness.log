   321	def load_epic_chain_spec(spec_path: Path) -> EpicChainSpec:
   322	    if not spec_path.exists():
   323	        raise CliError("invalid_spec", f"spec file not found: {spec_path}")
   324	    try:
   325	        raw = yaml.safe_load(spec_path.read_text(encoding="utf-8"))
   326	    except yaml.YAMLError as exc:
   327	        raise CliError("invalid_spec", f"YAML parse error: {exc}") from exc
   328	    return EpicChainSpec.from_dict(raw or {})
   329	
   330	
   331	def load_epic_chain_state(spec_path: Path) -> EpicChainState:
   332	    state_path = _state_path_for(spec_path)
   333	    if not state_path.exists():
   334	        return EpicChainState()
   335	    try:
   336	        raw = json.loads(state_path.read_text(encoding="utf-8"))
   337	    except json.JSONDecodeError as exc:
   338	        raise CliError("invalid_chain_state", f"epic-chain state is invalid JSON: {exc}") from exc
   339	    if not isinstance(raw, dict):
   340	        raise CliError("invalid_chain_state", "epic-chain state must be an object")
   341	    return EpicChainState.from_dict(raw)
   342	
   343	
   344	def save_epic_chain_state(spec_path: Path, state: EpicChainState) -> None:
   345	    state_path = _state_path_for(spec_path)
   346	    state_path.parent.mkdir(parents=True, exist_ok=True)
   347	    atomic_write_json(state_path, state.to_dict())
   348	
   349	
   350	def _resolve_child_spec_path(spec_path: Path, child_spec: str) -> Path:
   351	    candidate = Path(child_spec).expanduser()
   352	    if candidate.is_absolute():
   353	        return candidate.resolve()
   354	    return (spec_path.parent / candidate).resolve()
   355	
   356	
   357	def _find_project_root_from_spec_path(spec_path: Path) -> Path | None:
   358	    resolved = spec_path.resolve()
   359	    for parent in resolved.parents:
   360	        if parent.name == ".megaplan":
   361	            return parent.parent
   362	    return None
   363	
   364	
   365	def _child_project_root(observed_spec_path: Path, chain_state: ChainState) -> Path | None:
   366	    execution_environment = chain_state.metadata.get("execution_environment")
   367	    if isinstance(execution_environment, dict):
   368	        project_root = execution_environment.get("project_root")
   369	        if isinstance(project_root, str) and project_root:
   370	            return Path(project_root).expanduser().resolve()
   371	    return _find_project_root_from_spec_path(observed_spec_path)

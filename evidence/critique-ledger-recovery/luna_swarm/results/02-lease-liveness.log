   394	    if not isinstance(raw, dict):
   395	        return {"status": "unavailable", "reason": "invalid plan state", "plan": plan_name}
   396	    status = raw.get("current_state")
   397	    if not isinstance(status, str) or not status:
   398	        status = "unknown"
   399	    return {"status": status, "plan": plan_name, "plan_dir": str(state_path.parent)}

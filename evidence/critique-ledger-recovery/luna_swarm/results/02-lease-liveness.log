  4504	        "status": "present",
  4505	        "path": str(path),
  4506	        "merge_policy": merge_policy,
  4507	        "driver_auto_approve": driver_auto_approve,
  4508	        "human_gated": merge_policy != "auto" or driver_auto_approve is False,
  4509	    }}

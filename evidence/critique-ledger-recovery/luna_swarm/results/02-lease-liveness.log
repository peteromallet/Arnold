   200	    base_branch: str = "main"
   201	    on_failure_policy: EpicFailurePolicy = field(default_factory=EpicFailurePolicy)
   202	
   203	    @classmethod
   204	    def from_dict(cls, raw: dict[str, Any]) -> "EpicChainSpec":
   205	        if not isinstance(raw, dict):
   206	            raise CliError("invalid_spec", "epic-chain spec must be a YAML mapping")
   207	        allowed_keys = {"anchors", "base_branch", "epics", "on_failure"}
   208	        unknown = sorted(set(raw) - allowed_keys)
   209	        if unknown:
   210	            raise CliError("invalid_spec", f"Unknown epic-chain spec key `{unknown[0]}`")
   211	        base_branch = raw.get("base_branch", "main")
   212	        if not isinstance(base_branch, str) or not base_branch.strip():
   213	            raise CliError("invalid_spec", "`base_branch` must be a non-empty string")
   214	        anchors = AnchorSpec.from_yaml(raw.get("anchors"), "anchors")
   215	        epics_raw = raw.get("epics") or []
   216	        if not isinstance(epics_raw, list):
   217	            raise CliError("invalid_spec", "`epics` must be a list")
   218	        epics = [EpicSpec.from_dict(raw_epic, idx) for idx, raw_epic in enumerate(epics_raw)]
   219	        if not epics:
   220	            raise CliError("invalid_spec", "`epics` must declare at least one child epic")
   221	        seen_ids: set[str] = set()
   222	        for epic in epics:
   223	            if epic.id in seen_ids:
   224	                raise CliError("invalid_spec", f"duplicate epic id {epic.id!r}")
   225	            seen_ids.add(epic.id)
   226	        return cls(
   227	            epics=epics,

   138	        raise ValueError(
   139	            "spawn() does not permit shell=True — pass an explicit argv list "
   140	            "to prevent shell injection."
   141	        )
   142	    kw.setdefault("start_new_session", True)
   143	    _strip_setsid_collision(kw)
   144	    return subprocess.Popen(*args, **kw)

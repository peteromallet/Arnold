  2400	def _plan_auto_command(
  2401	    plan_name: str,
  2402	    *,
  2403	    workspace: str,
  2404	    engine_dir: str | None = None,
  2405	    log_relative: str,
  2406	) -> str:
  2407	    log_target = shlex.quote(str(PurePosixPath(workspace) / log_relative))
  2408	    prefix = (
  2409	        f"if [ -f {shlex.quote(_CLOUD_HOT_ENV_PATH)} ]; then "
  2410	        f"set -a; . {shlex.quote(_CLOUD_HOT_ENV_PATH)}; set +a; fi; "
  2411	    )
  2412	    if engine_dir:
  2413	        engine_path = shlex.quote(engine_dir)
  2414	        prefix += f"cd {shlex.quote(workspace)} && PYTHONSAFEPATH=1 PYTHONPATH={engine_path}:${{PYTHONPATH:-}} "
  2415	        command = (
  2416	            f"python3 -P -m arnold_pipelines.megaplan auto "
  2417	            f"--plan {shlex.quote(plan_name)} --project-dir {shlex.quote(workspace)}"
  2418	        )
  2419	    else:
  2420	        command = (
  2421	            f"cd {shlex.quote(workspace)} && "
  2422	            f"arnold auto --plan {shlex.quote(plan_name)} --project-dir {shlex.quote(workspace)}"
  2423	        )
  2424	    return f"{prefix}MEGAPLAN_TRUSTED_CONTAINER=1 {command} >> {log_target} 2>&1"

   309	def _state_path_for(spec_path: Path) -> Path:
   310	    spec_resolved = spec_path.resolve()
   311	    digest = hashlib.sha1(str(spec_resolved).encode("utf-8")).hexdigest()[:12]
   312	    return (
   313	        spec_resolved.parent
   314	        / ".megaplan"
   315	        / "plans"
   316	        / ".epic_chains"
   317	        / f"{spec_resolved.stem}-{digest}.json"
   318	    )

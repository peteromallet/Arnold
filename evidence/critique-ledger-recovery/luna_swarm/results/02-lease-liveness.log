  1722	        "branch": branch,
  1723	        "remote": remote,
  1724	        "launch_head": launch_head,
  1725	        "launch_branch": launch_branch,
  1726	        "editable_head_before": before,
  1727	        "editable_head": after,
  1728	        "merge_commit_created": merged,

  4491	        return {{"status": "invalid", "path": str(path), "error": str(exc)}}
  4492	    merge_policy = "auto"
  4493	    match = re.search(r"(?m)^merge_policy:\\s*([^\\s#]+)", text)
  4494	    if match:
  4495	        merge_policy = match.group(1).strip().strip("'\\\"")
  4496	    driver_auto_approve = True
  4497	    driver_match = re.search(r"(?ms)^driver:\\s*\\n(?P<body>(?:[ \\t]+[^\\n]*\\n?)*)", text)

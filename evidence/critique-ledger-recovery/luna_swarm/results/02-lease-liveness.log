    54	def _descendant_pids(root_pid: int) -> list[int]:
    55	    """Return the transitive closure of *root_pid*'s descendant PIDs.
    56	
    57	    Parent links survive children starting their own sessions, so this catches
    58	    descendants that a direct process-group signal cannot reach.
    59	    """
    60	    descendants: list[int] = []
    61	    seen: set[int] = {root_pid}
    62	    frontier = [root_pid]
    63	    while frontier:
    64	        next_frontier: list[int] = []
    65	        for parent in frontier:
    66	            try:
    67	                result = subprocess.run(
    68	                    ["pgrep", "-P", str(parent)],
    69	                    check=False,
    70	                    capture_output=True,
    71	                    text=True,
    72	                )

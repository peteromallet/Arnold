  2427	def _megaplan_refresh_command(
  2428	    spec: CloudSpec | None = None,
  2429	    *,
  2430	    force_clean_editable_install: bool = False,
  2431	    runtime_src_path: str | None = None,
  2432	) -> str:
  2433	    src = spec.megaplan.src_path if spec is not None else "/workspace/arnold"
  2434	    repo = (spec.megaplan.repo or "") if spec is not None else ""
  2435	    ref = _EDITABLE_INSTALL_BRANCH
  2436	    lines = [
  2437	        "set -e",
  2438	        "echo \"[megaplan-refresh] $(date -Iseconds) starting\"",
  2439	        f"SRC={shlex.quote(src)}",
  2440	        f"REPO={shlex.quote(repo)}",
  2441	        f"REF={shlex.quote(ref)}",
  2442	        f"RUNTIME_SRC={shlex.quote(runtime_src_path or '')}",
  2443	        'if [ -n "$REPO" ] && [ ! -d "$SRC/.git" ]; then',
  2444	        '  mkdir -p "$(dirname "$SRC")"',
  2445	        '  CLONE_URL="$REPO"',
  2446	        '  if [ -n "${GITHUB_TOKEN:-}" ]; then',
  2447	        '    case "$CLONE_URL" in',
  2448	        '      https://github.com/*) CLONE_URL="https://x-access-token:${GITHUB_TOKEN}@github.com/${CLONE_URL#https://github.com/}" ;;',
  2449	        "    esac",
  2450	        "  fi",
  2451	        '  git clone --branch "$REF" "$CLONE_URL" "$SRC"',
  2452	        "fi",
  2453	        'if [ -d "$SRC/.git" ]; then',
  2454	        '  git -C "$SRC" fetch origin "$REF"',
  2455	        '  BRANCH="$(git -C "$SRC" branch --show-current)"',
  2456	        '  if [ "$BRANCH" != "$REF" ]; then git -C "$SRC" checkout "$REF"; fi',
  2457	        *(
  2458	            [
  2459	                '  echo "[megaplan-refresh] force-clean enabled: resetting and cleaning $SRC"',
  2460	                '  git -C "$SRC" reset --hard "origin/$REF"',
  2461	                '  git -C "$SRC" clean -fd',
  2462	            ]
  2463	            if force_clean_editable_install
  2464	            else []
  2465	        ),
  2466	        '  if [ -n "$(git -C "$SRC" status --porcelain --untracked-files=no)" ]; then',
  2467	        '    if [ -n "$RUNTIME_SRC" ]; then',
  2468	        '      echo "[megaplan-refresh] source checkout dirty; using clean runtime mirror at $RUNTIME_SRC"',
  2469	        '      rm -rf "$RUNTIME_SRC"',
  2470	        '      mkdir -p "$(dirname "$RUNTIME_SRC")"',
  2471	        '      git clone --shared --no-checkout "$SRC" "$RUNTIME_SRC"',
  2472	        '      git -C "$RUNTIME_SRC" fetch origin "$REF"',
  2473	        '      git -C "$RUNTIME_SRC" checkout --detach "origin/$REF"',
  2474	        '      export MEGAPLAN_RUNTIME_SRC="$RUNTIME_SRC"',
  2475	        "    else",
  2476	        '      echo "[megaplan-refresh] refusing editable install refresh: tracked changes in source checkout at $SRC"',
  2477	        "      exit 19",
  2478	        "    fi",
  2479	        "  else",
  2480	        '    if ! git -C "$SRC" merge-base --is-ancestor HEAD "origin/$REF"; then',
  2481	        '      echo "[megaplan-refresh] source checkout has local commits not contained in origin/$REF; attempting push"',
  2482	        '      git -C "$SRC" log --oneline --max-count=5 "origin/$REF..HEAD" || true',
  2483	        '      if git -C "$SRC" push origin "$REF"; then',
  2484	        '        git -C "$SRC" fetch origin "$REF"',
  2485	        '      else',
  2486	        '        echo "[megaplan-refresh] refusing editable install refresh: $SRC has unpushed local commits not contained in origin/$REF"',
  2487	        "        exit 20",
  2488	        "      fi",
  2489	        "    fi",
  2490	        '    git -C "$SRC" pull --ff-only origin "$REF"',
  2491	        '    export MEGAPLAN_RUNTIME_SRC="$SRC"',
  2492	        "  fi",
  2493	        '  if ! git -C "$MEGAPLAN_RUNTIME_SRC" merge-base --is-ancestor HEAD "origin/$REF"; then',
  2494	        '    echo "[megaplan-refresh] refusing editable install refresh: $MEGAPLAN_RUNTIME_SRC has local commits not contained in origin/$REF"',
  2495	        '    git -C "$MEGAPLAN_RUNTIME_SRC" log --oneline --max-count=5 "origin/$REF..HEAD" || true',
  2496	        "    exit 20",
  2497	        "  fi",
  2498	        '  pip install -e "$MEGAPLAN_RUNTIME_SRC"',
  2499	        "else",
  2500	        '  echo "[megaplan-refresh] source clone missing at $SRC; skipping editable install"',
  2501	        "fi",
  2502	        'echo "[megaplan-refresh] done"',
  2503	        "true",
  2504	    ]
  2505	    return "\n".join(lines)

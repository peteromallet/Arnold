    78	                try:
    79	                    child = int(line)
    80	                except ValueError:
    81	                    continue
    82	                if child in seen:
    83	                    continue
    84	                seen.add(child)
    85	                descendants.append(child)
    86	                next_frontier.append(child)
    87	        frontier = next_frontier
    88	    return descendants

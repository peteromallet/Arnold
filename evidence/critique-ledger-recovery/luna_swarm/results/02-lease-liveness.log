   130	def spawn(*args: Any, **kw: Any) -> subprocess.Popen:
   131	    """Spawn a subprocess with safe isolation defaults.
   132	
   133	    Raises ValueError for shell=True — callers must pass explicit argv lists.
   134	    Defaults start_new_session=True so the child is its own session/pgroup
   135	    leader and kill_group() can reap the whole tree safely.
   136	    """

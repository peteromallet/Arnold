     1	#!/usr/bin/env bash
     2	# Ensure the Discord resident tmux session is alive in the cloud container.
     3	# Mirrors ensure-megaplan-watchdog: idempotent, host-side, fired by a 5-min
     4	# systemd timer. This is the "never dark" guarantee — the resident self-heals
     5	# within ~5 min of any disruption (container restart/crash/OOM/image swap),
     6	# independent of whether the entrypoint happened to start it.
     7	set -u
     8	
     9	CONTAINER="${MEGAPLAN_CLOUD_CONTAINER:-megaplan-cloud-agent}"
    10	LOG="${MEGAPLAN_RESIDENT_ENSURE_LOG:-/var/log/megaplan-resident-ensure.log}"
    11	SESSION=megaplan-resident-discord
    12	
    13	now() { date -u +"%Y-%m-%dT%H:%M:%SZ"; }
    14	log() { printf "[%s] %s\n" "$(now)" "$*" >> "$LOG"; }
    15	
    16	resident_healthy() {
    17	  docker exec "$CONTAINER" bash -lc '
    18	    set -euo pipefail
    19	    tmux has-session -t megaplan-resident-discord
    20	    pane_pid="$(tmux list-panes -t megaplan-resident-discord -F "#{pane_pid}" | head -1)"
    21	    tr "\0" "\n" < "/proc/$pane_pid/cmdline" | grep -Fx -- "--store-root" >/dev/null
    22	    set -a
    23	    . /workspace/.secrets/megaplan-resident-discord.env
    24	    [[ ! -f /workspace/.cloud-hot-env ]] || . /workspace/.cloud-hot-env
    25	    set +a
    26	    runtime_src="${MEGAPLAN_RUNTIME_SRC:-/workspace/arnold}"
    27	    store_root="${MEGAPLAN_RESIDENT_STORE_ROOT:-/workspace/arnold/.megaplan/resident}"
    28	    PYTHONSAFEPATH=1 PYTHONPATH="$runtime_src:${PYTHONPATH:-}" \
    29	      python -P -m arnold_pipelines.megaplan resident health \
    30	        --mode "${MEGAPLAN_RESIDENT_MODE:-production}" \
    31	        --store-root "$store_root" >/dev/null
    32	  ' >/dev/null 2>&1
    33	}
    34	
    35	if ! docker inspect "$CONTAINER" >/dev/null 2>&1; then
    36	  log "container_missing container=$CONTAINER"
    37	  exit 1
    38	fi
    39	
    40	running="$(docker inspect -f "{{.State.Running}}" "$CONTAINER" 2>/dev/null || echo false)"
    41	if [[ "$running" != "true" ]]; then
    42	  # Don't fight a stopped/restarting container — the watchdog-ensure service
    43	  # owns starting it. Retry next tick.
    44	  log "container_not_running container=$CONTAINER"
    45	  exit 0
    46	fi
    47	
    48	if resident_healthy; then
    49	  log "resident_alive container=$CONTAINER"
    50	  exit 0
    51	fi
    52	
    53	if docker exec "$CONTAINER" bash -lc "tmux has-session -t $SESSION" >/dev/null 2>&1; then
    54	  log "resident_unhealthy restarting container=$CONTAINER"
    55	  docker exec "$CONTAINER" tmux kill-session -t "$SESSION" >/dev/null 2>&1 || true
    56	else
    57	  log "resident_missing starting container=$CONTAINER"
    58	fi
    59	# Canonical resident launch (mirrors entrypoint.sh.tmpl). The heredoc is quoted
    60	# ('EOS') so \$ and \${...} stay literal until the resident's bash -lc expands
    61	# them AFTER sourcing the env — exactly like the entrypoint's invocation.
    62	if docker exec -i "$CONTAINER" bash >>"$LOG" 2>&1 <<'EOS'; then
    63	  set -u
    64	  if [ ! -f /workspace/.secrets/megaplan-resident-discord.env ]; then
    65	    echo "resident_env_missing"
    66	    exit 0
    67	  fi
    68	  if tmux has-session -t megaplan-resident-discord 2>/dev/null; then
    69	    echo "resident_already_up"
    70	    exit 0
    71	  fi
    72	  tmux new-session -d -s megaplan-resident-discord -c /workspace/arnold "bash -lc 'set -a; . /workspace/.secrets/megaplan-resident-discord.env; [[ ! -f /workspace/.cloud-hot-env ]] || . /workspace/.cloud-hot-env; set +a; runtime_src=\${MEGAPLAN_RUNTIME_SRC:-/workspace/arnold}; store_root=\${MEGAPLAN_RESIDENT_STORE_ROOT:-/workspace/arnold/.megaplan/resident}; export PYTHONPATH=\$runtime_src:\${PYTHONPATH:-}; echo [resident-start] \$(date -Iseconds) provider=\${MEGAPLAN_RESIDENT_MODEL_PROVIDER} model=\${MEGAPLAN_RESIDENT_MODEL} store_root=\$store_root >> /workspace/megaplan-resident-discord.log; exec python -P -m arnold_pipelines.megaplan resident discord --mode \${MEGAPLAN_RESIDENT_MODE:-production} --store-root \"\$store_root\" >> /workspace/megaplan-resident-discord.log 2>&1'"
    73	  echo "resident_started"
    74	EOS
    75	  sleep 5
    76	  if resident_healthy; then
    77	    log "resident_restarted container=$CONTAINER"
    78	    exit 0
    79	  fi
    80	fi
    81	
    82	log "resident_restart_failed_not_alive container=$CONTAINER"
    83	exit 1


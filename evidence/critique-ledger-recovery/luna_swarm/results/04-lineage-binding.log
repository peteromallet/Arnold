    44	
    45	def _tail(text: str, *, max_lines: int = 20) -> str:
    46	    lines = text.splitlines()
    47	    if len(lines) <= max_lines:
    48	        return text.strip()
    49	    return "\n".join(lines[-max_lines:]).strip()
    50	
    51	
    52	def _redacted_tail(text: str) -> str:
    53	    return redact_text(_tail(text or ""))
    54	
    55	
    56	def _command_text(command: list[str]) -> str:
    57	    return " ".join(shlex.quote(part) for part in command)
    58	
    59	
    60	def capture_runtime_identity(
    61	    source_root: Path | str,
    62	    *,
    63	    python_executable: str | None = None,
    64	    runner: Runner = subprocess.run,
    65	) -> dict[str, Any]:
    66	    root = Path(source_root).expanduser().resolve()
    67	    python_bin = python_executable or sys.executable
    68	
    69	    git_head_proc = _run(["git", "rev-parse", "HEAD"], cwd=root, runner=runner)
    70	    git_branch_proc = _run(["git", "branch", "--show-current"], cwd=root, runner=runner)
    71	    probe_proc = _run([python_bin, "-c", _IDENTITY_PROBE], cwd=root, runner=runner)
    72	
    73	    package_identity: dict[str, Any] = {}
    74	    if probe_proc.returncode == 0:
    75	        try:
    76	            import json
    77	
    78	            loaded = json.loads(probe_proc.stdout or "{}")
    79	        except Exception:
    80	            loaded = {}
    81	        if isinstance(loaded, dict):
    82	            package_identity = loaded
    83	
    84	    return {
    85	        "source_root": str(root),
    86	        "python_executable": package_identity.get("python_executable") or python_bin,
    87	        "git_head": (git_head_proc.stdout or "").strip() or None,
    88	        "git_branch": (git_branch_proc.stdout or "").strip() or None,
    89	        "package_file": package_identity.get("package_file"),
    90	        "package_root": package_identity.get("package_root"),
    91	    }
    92	
    93	
    94	def apply_install_sync(
    95	    *,
    96	    source_root: Path | str,
    97	    incident_id: str,
    98	    session_id: str | None = None,
    99	    problem_id: str | None = None,
   100	    root: Path | str | None = None,
   101	    python_executable: str | None = None,
   102	    runner: Runner = subprocess.run,
   103	) -> dict[str, Any]:
   104	    source = Path(source_root).expanduser().resolve()
   105	    python_bin = python_executable or sys.executable
   106	    command = [python_bin, "-m", "pip", "install", "-e", str(source)]
   107	    before_identity = capture_runtime_identity(
   108	        source,
   109	        python_executable=python_bin,
   110	        runner=runner,
   111	    )
   112	    install_proc = _run(command, cwd=source, runner=runner)
   113	    after_identity = capture_runtime_identity(
   114	        source,
   115	        python_executable=python_bin,
   116	        runner=runner,
   117	    )
   118	
   119	    command_text = _command_text(command)
   120	    verification = {
   121	        "kind": "install_sync_verification",
   122	        "expected_git_head": before_identity.get("git_head"),
   123	        "observed_git_head": after_identity.get("git_head"),
   124	        "runtime_changed": before_identity != after_identity,
   125	        "returncode": install_proc.returncode,
   126	        "success": install_proc.returncode == 0,
   127	    }
   128	    evidence = [
   129	        {
   130	            "kind": "runtime_identity",
   131	            "before": before_identity,
   132	            "after": after_identity,
   133	            "command": command_text,
   134	            "returncode": install_proc.returncode,
   135	        },
   136	        {
   137	            "kind": "command_result",
   138	            "command": command_text,
   139	            "returncode": install_proc.returncode,
   140	            "stdout_tail": _redacted_tail(install_proc.stdout or ""),
   141	            "stderr_tail": _redacted_tail(install_proc.stderr or ""),
   142	        },
   143	        verification,
   144	    ]
   145	    summary = (
   146	        f"Editable install synced with {command_text}"
   147	        if install_proc.returncode == 0
   148	        else f"Editable install sync failed with {command_text}"
   149	    )
   150	    if install_proc.returncode == 0:
   151	        event = append_install_sync_applied(
   152	            incident_id=incident_id,
   153	            summary=summary,
   154	            evidence=evidence,
   155	            session_id=session_id,
   156	            problem_id=problem_id,
   157	            root=root or source,
   158	        )
   159	        status = "applied"
   160	    else:
   161	        event = append_install_sync_failed(
   162	            incident_id=incident_id,
   163	            summary=summary,
   164	            evidence=evidence,
   165	            session_id=session_id,
   166	            problem_id=problem_id,
   167	            root=root or source,
   168	        )
   169	        status = "failed"
   170	
   171	    return {
   172	        "status": status,
   173	        "command": command,
   174	        "command_text": command_text,
   175	        "returncode": install_proc.returncode,
   176	        "before_identity": before_identity,
   177	        "after_identity": after_identity,
   178	        "stdout_tail": evidence[1]["stdout_tail"],
   179	        "stderr_tail": evidence[1]["stderr_tail"],
   180	        "verification": verification,
   181	        "event": event,
   182	    }
   183	
   184	
   185	__all__ = [
   186	    "apply_install_sync",
   187	    "capture_runtime_identity",
   188	]


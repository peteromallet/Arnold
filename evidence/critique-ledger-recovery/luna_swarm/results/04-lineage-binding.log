   250	def _probe_write_allowed(root: Path) -> bool:
   251	    probe = root / ".megaplan-engine-isolation-target-probe"
   252	    try:
   253	        probe.write_text("probe\n", encoding="utf-8")
   254	        probe.unlink(missing_ok=True)
   255	        return True
   256	    except OSError:
   257	        return False
   258	
   259	
   260	def _probe_write_denied(root: Path) -> tuple[bool, bool]:
   261	    probe = root / ".megaplan-engine-isolation-engine-probe"
   262	    try:
   263	        probe.write_text("probe\n", encoding="utf-8")
   264	    except OSError:
   265	        if _same_user_chmod_can_make_writable(root, probe):
   266	            return False, True
   267	        return True, False
   268	    try:
   269	        probe.unlink(missing_ok=True)
   270	    except OSError:
   271	        pass
   272	    return False, False
   273	
   274	
   275	def _same_user_chmod_can_make_writable(root: Path, probe: Path) -> bool:
   276	    try:
   277	        original_mode = root.stat().st_mode
   278	    except OSError:
   279	        return False
   280	    try:
   281	        root.chmod(original_mode | 0o200)
   282	    except OSError:
   283	        return False
   284	    try:
   285	        probe.write_text("probe\n", encoding="utf-8")
   286	    except OSError:
   287	        return False
   288	    finally:
   289	        try:
   290	            probe.unlink(missing_ok=True)
   291	        except OSError:
   292	            pass
   293	        try:
   294	            root.chmod(original_mode)
   295	        except OSError:
   296	            pass
   297	    return True

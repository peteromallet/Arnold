   127	def _auto_command(spec: CloudSpec) -> str:
   128	    assert spec.auto is not None
   129	    plan_dir = f"{spec.repo.workspace}/.megaplan/plans/{spec.auto.plan_name}"
   130	    script = f"""
   131	set -euo pipefail
   132	PLAN_DIR={shlex.quote(plan_dir)}
   133	if [[ ! -d "$PLAN_DIR" ]]; then
   134	  IDEA="$(cat "$IDEA_FILE")"
   135	  arnold init --project-dir {shlex.quote(spec.repo.workspace)} --name {shlex.quote(spec.auto.plan_name)} --auto-approve --robustness {shlex.quote(spec.auto.robustness)} "$IDEA"
   136	fi
   137	exec arnold-supervise {shlex.quote(f"auto-{spec.auto.plan_name}")} arnold auto --plan {shlex.quote(spec.auto.plan_name)}
   138	"""
   139	    return _quoted(script)

   164	def _agent_routing_block(spec: CloudSpec) -> str:
   165	    default_agent = spec.agents.get("default")
   166	    selected_vendor = (
   167	        default_agent
   168	        if default_agent in {"claude", "codex"}
   169	        else effective_premium_vendor()
   170	    )
   171	    routing = {
   172	        step: spec.agents.get(step, default_agent or fallback)
   173	        for step, fallback in DEFAULT_AGENT_ROUTING.items()
   174	    }
   175	    return "\n".join(
   176	        "arnold config set agents."
   177	        f"{step} "
   178	        f"{format_agent_spec(resolve_premium_placeholder_spec(agent, selected_vendor)) if is_premium_placeholder_spec(agent) else agent} "
   179	        ">/dev/null 2>&1 || true"
   180	        for step, agent in routing.items()
   181	    )

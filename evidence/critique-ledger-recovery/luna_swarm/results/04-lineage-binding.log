   202	mkdir -p "$CLAUDE_CREDS_DIR"
   203	chmod 700 "$CLAUDE_CREDS_DIR"
   204	
   205	if [[ -n "${CLAUDE_CODE_REFRESH_TOKEN:-}" ]]; then
   206	  # Seed the on-volume refresh token from the env on first boot (or if missing).
   207	  if [[ ! -s "$CLAUDE_CREDS_DIR/refresh_token" ]]; then
   208	    printf '%s' "$CLAUDE_CODE_REFRESH_TOKEN" > "$CLAUDE_CREDS_DIR/refresh_token"

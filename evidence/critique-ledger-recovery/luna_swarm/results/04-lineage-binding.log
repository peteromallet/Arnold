    30	def _run(
    31	    command: list[str],
    32	    *,
    33	    cwd: Path,
    34	    runner: Runner,
    35	) -> subprocess.CompletedProcess[str]:
    36	    return runner(
    37	        command,
    38	        cwd=str(cwd),
    39	        capture_output=True,
    40	        text=True,
    41	        check=False,
    42	    )

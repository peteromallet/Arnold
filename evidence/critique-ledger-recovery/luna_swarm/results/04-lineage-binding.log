    70	        and pytest.approx(a.cost) == b.cost
    71	        and set(a.lineage) == set(b.lineage)
    72	        and a.deadline == b.deadline
    73	        and a.cancellation == b.cancellation
    74	        and a.retry_budget == b.retry_budget

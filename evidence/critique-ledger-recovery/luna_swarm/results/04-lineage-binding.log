   151	def _runner_block(spec: CloudSpec) -> str:
   152	    values = {"WORKSPACE_PATH": shlex.quote(spec.repo.workspace)}
   153	    if spec.mode == "auto":
   154	        return _AUTO_RUNNER.safe_substitute(
   155	            values | {"AUTO_COMMAND": _auto_command(spec)}
   156	        )
   157	    if spec.mode == "chain":
   158	        return _CHAIN_RUNNER.safe_substitute(
   159	            values | {"CHAIN_COMMAND": _chain_command(spec)}
   160	        )
   161	    return _IDLE_RUNNER.safe_substitute(values)

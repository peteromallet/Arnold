   177	def cli_run(args: argparse.Namespace) -> int:
   178	    """Dispatch ``megaplan run`` — list / describe / execute by name.
   179	
   180	    Thin wrapper around the registry: every action resolves the
   181	    pipeline through :class:`megaplan.registry.PipelineRegistry`
   182	    with no YAML dispatch branch.
   183	    """
   184	
   185	    from arnold_pipelines.megaplan.registry import (
   186	        describe_pipeline,
   187	        pipeline_metadata,
   188	        registered_pipelines,
   189	    )
   190	
   191	    if args.list_pipelines:
   192	        names = list(registered_pipelines())
   193	        if not names:
   194	            print("(no pipelines registered)")
   195	            return 0
   196	        print("Pipelines:")
   197	        for name in names:
   198	            desc = describe_pipeline(name)
   199	            if not desc:
   200	                meta = pipeline_metadata(name)
   201	                desc = str(meta.get("description", "") or "")
   202	            print(f"  {name:24s} {desc}")
   203	        return 0
   204	
   205	    if not args.pipeline_name:
   206	        print(
   207	            "usage: megaplan run <pipeline-name> [--inputs k=v,...] "
   208	            "[--plan-dir PATH]\n"
   209	            "       megaplan run --list",
   210	            file=sys.stderr,
   211	        )
   212	        return 2
   213	
   214	    if args.describe:
   215	        return _describe_pipeline(args.pipeline_name)
   216	
   217	    reg_names = set(registered_pipelines())
   218	    if args.pipeline_name not in reg_names:
   219	        print(
   220	            f"Error: Unknown pipeline {args.pipeline_name!r}. "
   221	            f"Available: {', '.join(sorted(reg_names)) if reg_names else '(none)'}",
   222	            file=sys.stderr,
   223	        )
   224	        return 2
   225	
   226	    return _run_pipeline(args)

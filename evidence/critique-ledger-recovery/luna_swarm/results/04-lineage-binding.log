   304	        "CODEX_EMAIL": "codex-agent@example.com",
   305	        "MEGAPLAN_REF": spec.megaplan.ref,
   306	        "MEGAPLAN_REPO": spec.megaplan.repo or "",
   307	        "MEGAPLAN_INSTALL_SPEC_OVERRIDE": spec.megaplan.install_spec or "",
   308	        "CODEX_AUTH_METHOD": spec.megaplan.codex_auth,
   309	        "CODEX_AUTH_CONFIG_BLOCK": _codex_auth_config_block(spec),
   310	        "ROBUSTNESS": spec.auto.robustness if spec.auto is not None else "standard",
   311	        "MODE": spec.mode,
   312	        "IDEA_FILE": spec.auto.idea_file if spec.auto is not None else "/workspace/idea.txt",
   313	        "CHAIN_SPEC": spec.chain.spec if spec.chain is not None else "/workspace/chain.yaml",
   314	        "AUTO_PLAN_NAME": spec.auto.plan_name if spec.auto is not None else "idle-plan",
   315	        "AGENT_ROUTING_BLOCK": _agent_routing_block(spec),
   316	        "CLAUDE_AUTH_BLOCK": _claude_auth_block(),
   317	        "ENSURE_REPO_BLOCK": render_ensure_repos_block(spec),
   318	        "RUNNER_LAUNCH_BLOCK": _runner_block(spec),
   319	    }
   320	    rendered = _entrypoint_template().safe_substitute(values)
   321	    missing = [name for name in PLACEHOLDERS if f"${{{name}}}" in rendered]
   322	    if missing:
   323	        raise RuntimeError(f"Unreplaced entrypoint placeholders: {', '.join(missing)}")
   324	    return rendered

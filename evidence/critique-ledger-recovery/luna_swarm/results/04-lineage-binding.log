   327	def _toolchain_block(toolchains: list[ToolchainSpec] | None) -> str:
   328	    if not toolchains:
   329	        return ""
   330	    blocks: list[str] = []
   331	    for toolchain in toolchains:
   332	        if toolchain.install in _TOOLCHAIN_RECIPES:
   333	            blocks.append(_TOOLCHAIN_RECIPES[toolchain.install])
   334	            continue
   335	        blocks.append(f"# Toolchain: {toolchain.name}\n{toolchain.install}")
   336	    return "\n\n".join(blocks)

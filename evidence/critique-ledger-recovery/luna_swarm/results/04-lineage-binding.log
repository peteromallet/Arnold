   115	def render_ensure_repos_block(spec: CloudSpec) -> str:
   116	    """Clone primary + every extra repo if missing, in declared order.
   117	
   118	    Each repo lives at its own absolute workspace path so a multi-repo or
   119	    multi-tenant volume can hold them as siblings on independent branches.

  2355	    one_shot: bool = False,
  2356	    no_git_refresh: bool = False,
  2357	    log_relative: str = _CHAIN_LOG_RELATIVE,
  2358	) -> str:
  2359	    """Construct the ``python -m arnold_pipelines.megaplan chain start`` command with canonical quoting.
  2360	
  2361	    Both ``_run_chain_wrapper`` and ``cloud_supervise_tick`` use this helper
  2362	    so the session name, log path, trusted env var, and shell quoting stay
  2363	    consistent across all entry points.
  2364	    """
  2365	    flags = f"--spec {shlex.quote(remote_spec_path)}"
  2366	    if project_dir:
  2367	        flags += f" --project-dir {shlex.quote(project_dir)}"
  2368	    if one_shot:
  2369	        flags += " --one"
  2370	    if no_git_refresh:
  2371	        flags += " --no-git-refresh"
  2372	    log_target = (
  2373	        shlex.quote(str(PurePosixPath(project_dir) / log_relative))
  2374	        if project_dir
  2375	        else shlex.quote(log_relative)
  2376	    )
  2377	    prefix = (
  2378	        f"if [ -f {shlex.quote(_CLOUD_HOT_ENV_PATH)} ]; then "
  2379	        f"set -a; . {shlex.quote(_CLOUD_HOT_ENV_PATH)}; set +a; fi; "
  2380	    )
  2381	    if engine_dir:
  2382	        cwd = shlex.quote(project_dir or engine_dir)
  2383	        engine_path = shlex.quote(engine_dir)
  2384	        prefix += (
  2385	            'ENGINE_DIR="${MEGAPLAN_RUNTIME_SRC:-}"; '
  2386	            f'if [ -z "$ENGINE_DIR" ]; then ENGINE_DIR={engine_path}; fi; '
  2387	            f'cd {cwd} && PYTHONSAFEPATH=1 PYTHONPATH="$ENGINE_DIR:${{PYTHONPATH:-}}" '
  2388	        )
  2389	    return (
  2390	        f"{prefix}MEGAPLAN_TRUSTED_CONTAINER=1 python -P -m arnold_pipelines.megaplan chain start {flags} "
  2391	        f">> {log_target} 2>&1"
  2392	    )

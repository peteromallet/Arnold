   184	def _claude_auth_block() -> str:
   185	    # Three auth modes, in priority order:
   186	    #
   187	    # 1. CLAUDE_CODE_REFRESH_TOKEN (preferred — uses Max/Pro subscription, fully
   188	    #    programmatic): install a `claude` shim at /usr/local/bin/claude that
   189	    #    refreshes the OAuth access token on every invocation, exports it as
   190	    #    ANTHROPIC_API_KEY, then exec's the real binary. The refresh token
   191	    #    rotates per use and is persisted to the volume.
   192	    #
   193	    # 2. ANTHROPIC_API_KEY (legacy / metered API): claude --bare reads it
   194	    #    directly; nothing to install. claude setup-token is NOT attempted
   195	    #    because it requires interactive browser OAuth.
   196	    #
   197	    # 3. Neither: claude will fail at first call. Warn loudly.
   198	    #
   199	    # See megaplan-cloud skill for full design rationale.
   200	    return r"""# ── Claude auth: refresh-token shim takes precedence ─────────────────
   201	CLAUDE_CREDS_DIR=/workspace/.claude-creds
   202	mkdir -p "$CLAUDE_CREDS_DIR"
   203	chmod 700 "$CLAUDE_CREDS_DIR"
   204	
   205	if [[ -n "${CLAUDE_CODE_REFRESH_TOKEN:-}" ]]; then
   206	  # Seed the on-volume refresh token from the env on first boot (or if missing).
   207	  if [[ ! -s "$CLAUDE_CREDS_DIR/refresh_token" ]]; then
   208	    printf '%s' "$CLAUDE_CODE_REFRESH_TOKEN" > "$CLAUDE_CREDS_DIR/refresh_token"
   209	    chmod 600 "$CLAUDE_CREDS_DIR/refresh_token"
   210	  fi
   211	
   212	  REAL_CLAUDE=$(command -v claude || true)
   213	  if [[ -z "$REAL_CLAUDE" ]]; then
   214	    echo "WARN: claude binary not on PATH; skipping refresh-token shim install"
   215	  else
   216	    # Move the real binary aside so we can shadow it (idempotent across reboots).
   217	    if [[ ! -x /usr/local/bin/claude.real ]]; then
   218	      cp "$REAL_CLAUDE" /usr/local/bin/claude.real
   219	      chmod +x /usr/local/bin/claude.real
   220	    fi
   221	
   222	    # Refresh helper (usable standalone, and as `apiKeyHelper` via --settings).
   223	    cat > /usr/local/bin/claude-key-helper <<'HELPER_EOF'
   224	#!/usr/bin/env bash
   225	# Refresh the Claude Code OAuth access token if missing/expiring, then print it
   226	# to stdout. Refresh token rotates per use and is persisted to the volume.
   227	set -euo pipefail
   228	DIR=/workspace/.claude-creds
   229	mkdir -p "$DIR"
   230	NOW=$(date +%s)
   231	EXP=$(cat "$DIR/expires_at" 2>/dev/null || echo 0)
   232	if [[ ! -s "$DIR/access_token" ]] || [[ "$NOW" -ge $((EXP - 300)) ]]; then
   233	  RT=$(cat "$DIR/refresh_token" 2>/dev/null || true)
   234	  if [[ -z "$RT" ]]; then
   235	    echo "claude-key-helper: no refresh token at $DIR/refresh_token" >&2
   236	    exit 1
   237	  fi
   238	  CID=${CLAUDE_CODE_OAUTH_CLIENT_ID:-9d1c250a-e61b-44d9-88ed-5944d1962f5e}
   239	  URL=${CLAUDE_CODE_OAUTH_TOKEN_URL:-https://api.anthropic.com/v1/oauth/token}
   240	  RESP=$(curl -sS --max-time 15 -X POST "$URL" \
   241	    -H "Content-Type: application/json" \
   242	    -d "{\"grant_type\":\"refresh_token\",\"refresh_token\":\"$RT\",\"client_id\":\"$CID\"}")
   243	  AT=$(echo "$RESP" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("access_token",""))' 2>/dev/null)
   244	  EXPIRES_IN=$(echo "$RESP" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("expires_in",0))' 2>/dev/null)
   245	  NEW_RT=$(echo "$RESP" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("refresh_token",""))' 2>/dev/null)
   246	  if [[ -z "$AT" ]]; then
   247	    echo "claude-key-helper: refresh failed: $RESP" >&2
   248	    exit 1
   249	  fi
   250	  printf '%s' "$AT" > "$DIR/access_token"
   251	  echo $((NOW + EXPIRES_IN)) > "$DIR/expires_at"
   252	  [[ -n "$NEW_RT" ]] && printf '%s' "$NEW_RT" > "$DIR/refresh_token"
   253	  chmod 600 "$DIR/access_token" "$DIR/refresh_token" "$DIR/expires_at"
   254	fi
   255	cat "$DIR/access_token"
   256	HELPER_EOF
   257	    chmod +x /usr/local/bin/claude-key-helper
   258	
   259	    # Claude shim: refresh on entry, export, exec real binary.
   260	    cat > /usr/local/bin/claude <<'SHIM_EOF'
   261	#!/usr/bin/env bash
   262	AT=$(/usr/local/bin/claude-key-helper) || {
   263	  echo "claude shim: refresh failed; falling back to ANTHROPIC_API_KEY (may be expired)" >&2
   264	  exec /usr/local/bin/claude.real "$@"
   265	}
   266	export ANTHROPIC_API_KEY="$AT"
   267	exec /usr/local/bin/claude.real "$@"
   268	SHIM_EOF
   269	    chmod +x /usr/local/bin/claude
   270	
   271	    # Prime the cache so the first phase call doesn't pay refresh latency.
   272	    if /usr/local/bin/claude-key-helper >/dev/null 2>&1; then
   273	      echo "Claude auth: refresh-token shim active (cached access token ready)"
   274	    else
   275	      echo "WARN: claude shim installed but priming refresh FAILED — see /var/log/entrypoint.log"
   276	    fi
   277	  fi
   278	elif [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
   279	  echo "Claude auth: using ANTHROPIC_API_KEY (legacy / metered). For Max-sub usage, set CLAUDE_CODE_REFRESH_TOKEN."
   280	else
   281	  echo "WARN: no Claude auth configured (set CLAUDE_CODE_REFRESH_TOKEN or ANTHROPIC_API_KEY). Claude phases will fail."
   282	fi
   283	# ─────────────────────────────────────────────────────────────────────"""
   284	

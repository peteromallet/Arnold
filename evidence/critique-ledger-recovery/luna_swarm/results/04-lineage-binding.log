    16	Runner = Callable[..., subprocess.CompletedProcess[str]]
    17	
    18	_IDENTITY_PROBE = (
    19	    "import json, pathlib, sys; "
    20	    "import arnold_pipelines; "
    21	    "package_file = pathlib.Path(arnold_pipelines.__file__).resolve(); "
    22	    "print(json.dumps({"
    23	    "'python_executable': sys.executable, "
    24	    "'package_file': str(package_file), "
    25	    "'package_root': str(package_file.parent.parent)"
    26	    "}, sort_keys=True))"
    27	)

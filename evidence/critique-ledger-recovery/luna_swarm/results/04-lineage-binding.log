    84	# Megaplan install: always re-pull on boot so entrypoint restarts pick up the
    85	# requested ref without rebuilding the base image. The refresh helper is also
    86	# invoked by `arnold cloud chain` before each run.
    87	#
    88	# MEGAPLAN_INSTALL_SPEC – runtime pip install override, verbatim. Git specs get
    89	#   @MEGAPLAN_REF appended.
    90	# MEGAPLAN_INSTALL_SPEC_OVERRIDE – rendered cloud.yaml megaplan.install_spec.
    91	# MEGAPLAN_REPO – rendered cloud.yaml megaplan.repo source URL.
    92	# MEGAPLAN_REF – git ref (branch/tag/commit) used for git installs.
    93	MEGAPLAN_REF="$${MEGAPLAN_REF:-${MEGAPLAN_REF}}"
    94	MEGAPLAN_REPO="$${MEGAPLAN_REPO:-${MEGAPLAN_REPO}}"
    95	MEGAPLAN_INSTALL_SPEC_OVERRIDE="$${MEGAPLAN_INSTALL_SPEC_OVERRIDE:-${MEGAPLAN_INSTALL_SPEC_OVERRIDE}}"
    96	
    97	mp_pip_retry() {
    98	  # Retry a pip install up to 3x with backoff. A transient network/git blip must
    99	  # not crash-loop the whole container on boot; only a persistently-failing
   100	  # install (3 consecutive failures) propagates failure so the box still
   101	  # surfaces a real break instead of silently running stale code.
   102	  local label="$$1"; shift
   103	  local attempt
   104	  for attempt in 1 2 3; do
   105	    echo "[install $$attempt/3] $$label"
   106	    if pip install --upgrade --force-reinstall --no-cache-dir "$$@" 2>&1 | tail -3; then
   107	      return 0
   108	    fi
   109	    if [[ $$attempt -lt 3 ]]; then
   110	      echo "[install $$attempt/3] $$label failed; retrying in $$((attempt*10))s..."
   111	      sleep "$$((attempt*10))"
   112	    fi
   113	  done
   114	  echo "[install] FAILED after 3 attempts: $$label"
   115	  return 1
   116	}

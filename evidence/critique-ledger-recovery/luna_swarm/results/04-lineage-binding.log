    97	def render_ensure_repo_command(repo: RepoSpec) -> str:
    98	    """Render the fixed clone-if-missing command used by cloud entrypoints."""
    99	    workspace = PurePosixPath(repo.workspace)
   100	    parent = str(workspace.parent)
   101	    git_dir = str(workspace / ".git")
   102	    return " && ".join(
   103	        [
   104	            f"mkdir -p {shlex.quote(parent)}",
   105	            (
   106	                f"if [ ! -d {shlex.quote(git_dir)} ]; then "
   107	                f"git clone --branch {shlex.quote(repo.branch)} "
   108	                f"{shlex.quote(repo.url)} {shlex.quote(repo.workspace)}; "
   109	                "else true; fi"
   110	            ),
   111	        ]
   112	    )
   113	
   114	
   115	def render_ensure_repos_block(spec: CloudSpec) -> str:
   116	    """Clone primary + every extra repo if missing, in declared order.
   117	
   118	    Each repo lives at its own absolute workspace path so a multi-repo or
   119	    multi-tenant volume can hold them as siblings on independent branches.
   120	    """
   121	    blocks = [render_ensure_repo_command(spec.repo)]
   122	    for extra in spec.extra_repos:
   123	        blocks.append(render_ensure_repo_command(extra))
   124	    return "\n".join(blocks)

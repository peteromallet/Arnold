   167	
   168	echo "Runner mode: $$MODE"
   169	
   170	# Record the boot-time chain runner so the resident watchdog can supervise it.
   171	# `cloud chain` launches create their own per-session markers; `mode: chain`
   172	# starts the runner through the generic `agent` tmux session, so it needs this
   173	# marker to be discoverable by the hourly scan.
   174	if [[ "$$MODE" == "chain" && -n "$$CHAIN_SPEC" ]]; then
   175	  mkdir -p /workspace/.megaplan/cloud-sessions
   176	  python3 - <<PY
   177	import json
   178	import pathlib
   179	
   180	path = pathlib.Path("/workspace/.megaplan/cloud-sessions/agent.json")
   181	path.write_text(json.dumps({
   182	    "session": "agent",
   183	    "workspace": "$$WORKSPACE_PATH",
   184	    "remote_spec": "$$CHAIN_SPEC",
   185	    "source": "entrypoint-mode-chain",
   186	}, sort_keys=True) + "\n", encoding="utf-8")
   187	PY
   188	fi
   189	
   190	# Launch heartbeat in its own tmux session.
   191	if ! tmux has-session -t heartbeat 2>/dev/null; then
   192	  tmux new-session -d -s heartbeat -c /workspace "bash -lc '/usr/local/bin/arnold-heartbeat'"
   193	  echo "heartbeat watchdog running in tmux session 'heartbeat'"
   194	fi
   195	
   196	# Launch cloud chain watchdog in its own tmux session. It scans cloud-session
   197	# markers hourly and wakes stopped chain runners without disturbing live ones.
   198	if ! tmux has-session -t watchdog 2>/dev/null; then
   199	  tmux new-session -d -s watchdog -c /workspace "bash -lc '/usr/local/bin/arnold-watchdog'"
   200	  echo "cloud watchdog running in tmux session 'watchdog'"
   201	fi
   202	
   203	# Launch the interactive Discord resident when its shared secret env exists.
   204	# Watchdog escalation DMs and resident replies both read the same token/user
   205	# file, but only this resident session listens for inbound Discord messages.
   206	if [[ -f /workspace/.secrets/megaplan-resident-discord.env ]]; then
   207	  if ! tmux has-session -t megaplan-resident-discord 2>/dev/null; then
   208	    tmux new-session -d -s megaplan-resident-discord -c /workspace/arnold \
   209	      "bash -lc 'set -a; . /workspace/.secrets/megaplan-resident-discord.env; [[ ! -f /workspace/.cloud-hot-env ]] || . /workspace/.cloud-hot-env; set +a; runtime_src=\${MEGAPLAN_RUNTIME_SRC:-/workspace/arnold}; store_root=\${MEGAPLAN_RESIDENT_STORE_ROOT:-/workspace/arnold/.megaplan/resident}; export PYTHONPATH=\$runtime_src:\${PYTHONPATH:-}; echo [resident-start] \$(date -Iseconds) provider=\$MEGAPLAN_RESIDENT_MODEL_PROVIDER model=\$MEGAPLAN_RESIDENT_MODEL trusted=\${MEGAPLAN_TRUSTED_CONTAINER:-0} markers=\$([ -d /workspace/.megaplan/cloud-sessions ] && echo yes || echo no) store_root=\$store_root >> /workspace/megaplan-resident-discord.log; exec python -P -m arnold_pipelines.megaplan resident discord --mode \${MEGAPLAN_RESIDENT_MODE:-production} --store-root \"\$store_root\" >> /workspace/megaplan-resident-discord.log 2>&1'"
   210	    echo "Discord resident running in tmux session 'megaplan-resident-discord'"
   211	  fi
   212	else
   213	  echo "Discord resident not started; /workspace/.secrets/megaplan-resident-discord.env is missing"
   214	fi
   215	
   216	# Tiny health server so the process supervisor keeps the container alive
   217	python3 /usr/local/bin/healthserver.py &
   218	HEALTH_PID=$$!
   219	echo "healthserver.py running as pid $$HEALTH_PID"
   220	
   221	# Ensure tmux session 'agent' exists. The renderer injects the mode-specific
   222	# launch block here so auto/chain can warn-and-drop-to-idle on missing inputs.
   223	if ! tmux has-session -t agent 2>/dev/null; then
   224	${RUNNER_LAUNCH_BLOCK}
   225	fi
   226	echo "tmux 'agent' session ready"
   227	
   228	echo "=== entrypoint idle ==="
   229	wait "$$HEALTH_PID"


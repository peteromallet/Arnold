   257	class _LaunchEpicProvider:
   258	    def __init__(self) -> None:
   259	        self.uploads: list[tuple[Path, str]] = []
   260	        self.remote_files: set[str] = set()
   261	        self.markers: dict[str, dict] = {}
   262	
   263	    def upload_file(self, src: Path, dest: str) -> None:
   264	        self.uploads.append((src, dest))
   265	        self.remote_files.add(dest)
   266	
   267	    def ssh_exec(self, command: str) -> subprocess.CompletedProcess[str]:
   268	        if "MEGAPLAN_RESET" in command:
   269	            return subprocess.CompletedProcess([], 0, "", "")
   270	        if "MEGAPLAN_WATCHDOG_TRACKING" in command:
   271	            marker = re.search(r"marker_path = pathlib\.Path\('([^']+)'\)", command).group(1)
   272	            workspace = re.search(r"workspace = pathlib\.Path\('([^']+)'\)", command).group(1)
   273	            remote_spec = re.search(r"remote_spec = pathlib\.Path\('([^']+)'\)", command).group(1)
   274	            payload = self.markers.get(marker, {})
   275	            errors = []
   276	            if not payload:
   277	                errors.append("marker missing")
   278	            if remote_spec not in self.remote_files:
   279	                errors.append("remote_spec missing")
   280	            if payload.get("workspace") != workspace:
   281	                errors.append("workspace mismatch")
   282	            if payload.get("remote_spec") != remote_spec:
   283	                errors.append("remote_spec mismatch")
   284	            result = {
   285	                "tracked": not errors,
   286	                "errors": errors,
   287	                "marker_path": marker,
   288	                "workspace": workspace,
   289	                "remote_spec": remote_spec,
   290	                "session": payload.get("session"),
   291	            }
   292	            return subprocess.CompletedProcess([], 0 if result["tracked"] else 1, json.dumps(result) + "\n", "")
   293	        if "MEGAPLAN_VERIFY" in command:
   294	            result = {
   295	                "session_alive": True,
   296	                "advanced_past_init": True,
   297	                "chain_log": "/workspace/log",
   298	                "state_present": True,
   299	                "plan_dirs": ["m1"],
   300	            }
   301	            return subprocess.CompletedProcess([], 0, json.dumps(result) + "\n", "")
   302	        if "tmux new-session" in command or "session already running for this chain" in command:
   303	            marker_match = re.search(r"printf %s ('(?:[^']|'\"'\"')*') > ([^;]+);", command)
   304	            assert marker_match, command
   305	            marker_payload = json.loads(shlex_split_one(marker_match.group(1)))
   306	            marker_path = shlex_split_one(marker_match.group(2))
   307	            self.markers[marker_path] = marker_payload
   308	            return subprocess.CompletedProcess([], 0, "started session\n", "")
   309	        return subprocess.CompletedProcess([], 0, "", "")
   310	
   311	
   312	def shlex_split_one(value: str) -> str:
   313	    import shlex
   314	
   315	    parsed = shlex.split(value)
   316	    assert len(parsed) == 1
   317	    return parsed[0]

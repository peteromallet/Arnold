   122	      echo "Installing/upgrading arnold from explicit git spec at ref $$MEGAPLAN_REF"
   123	      mp_pip_retry "explicit git spec @ $$MEGAPLAN_REF" "$$explicit_spec@$$MEGAPLAN_REF"

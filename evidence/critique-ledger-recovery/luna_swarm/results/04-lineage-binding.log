    77	@dataclass(frozen=True)
    78	class RunEnvelope:
    79	    """Frozen cross-cutting metadata attached to every StepContext/StepResult.
    80	
    81	    Fields
    82	    ------
    83	    taint : str
    84	        Propagation marker (e.g. ``"clean"`` or ``"tainted"``).
    85	    cost : float
    86	        Accumulated cost in USD so far.
    87	    lineage : tuple[str, ...]
    88	        Ordered step IDs that produced this envelope.
    89	    deadline : float | None
    90	        POSIX timestamp after which execution should abort, or ``None``.
    91	    cancellation : bool
    92	        ``True`` when a cancellation signal has been received.
    93	    retry_budget : int
    94	        Remaining retry attempts.
    95	    error_class : str | None
    96	        Symbolic error class if an error has been recorded.
    97	    lease_id : str | None
    98	        Identifier of the capacity lease this envelope represents, if any.
    99	        Two non-None unequal lease_ids cannot join — joining raises
   100	        :class:`LeaseIdConflict`.
   101	    fencing_token : int | None
   102	        Monotonic fencing token for stale-lease detection.  Join takes the max
   103	        (treating ``None`` as ``-1`` so any concrete token dominates).
   104	    capacity_grant : int
   105	        Capacity-grant amount in abstract units.  Join sums across distinct
   106	        grants, but suppresses duplicate concrete ``(lease_id, fencing_token)``
   107	        grant identities by keeping the larger grant.
   108	    """
   109	
   110	    taint: str = "clean"
   111	    cost: float = 0.0
   112	    lineage: tuple[str, ...] = ()
   113	    deadline: float | None = None
   114	    cancellation: bool = False
   115	    retry_budget: int = 3
   116	    error_class: str | None = None
   117	    lease_id: str | None = None
   118	    fencing_token: int | None = None
   119	    capacity_grant: int = 0
   120	
   121	    # ------------------------------------------------------------------
   122	    # Semilattice join
   123	    # ------------------------------------------------------------------
   124	
   125	    def join(self, other: "RunEnvelope") -> "RunEnvelope":
   126	        """Return the least-upper-bound of ``self`` and ``other``.
   127	
   128	        Commutative, associative, and idempotent:
   129	
   130	        * ``taint`` — ``"tainted"`` dominates ``"clean"`` (any non-clean value
   131	          dominates a clean one; between two non-clean values the first is kept).
   132	        * ``cost`` — summed.
   133	        * ``lineage`` — concatenation (self first, deduplicating exact-prefix repeats).
   134	        * ``deadline`` — minimum non-None value (tightest deadline).
   135	        * ``cancellation`` — boolean OR.
   136	        * ``retry_budget`` — minimum (most constrained).
   137	        * ``error_class`` — first non-None wins; if both non-None and equal keeps it,
   138	          otherwise ``"multiple"`` signals conflict.
   139	
   140	        Note: ``cost`` is summed rather than max'd so the envelope tracks total
   141	        spend across a fan-out reduction.  Commutativity holds because addition
   142	        is commutative; the test suite verifies this directly.
   143	        """
   144	        if self == other:
   145	            return self
   146	
   147	        # taint: "tainted" dominates
   148	        if self.taint == "clean":
   149	            taint = other.taint
   150	        elif other.taint == "clean":
   151	            taint = self.taint
   152	        else:
   153	            taint = self.taint  # both non-clean: keep self (deterministic)
   154	
   155	        cost = self.cost + other.cost
   156	
   157	        # lineage: concatenate, avoid pure duplication when joining with EMPTY
   158	        combined = self.lineage + tuple(x for x in other.lineage if x not in self.lineage)
   159	
   160	        # deadline: tightest non-None
   161	        if self.deadline is None:
   162	            deadline = other.deadline
   163	        elif other.deadline is None:
   164	            deadline = self.deadline
   165	        else:
   166	            deadline = min(self.deadline, other.deadline)
   167	
   168	        cancellation = self.cancellation or other.cancellation
   169	
   170	        retry_budget = min(self.retry_budget, other.retry_budget)
   171	
   172	        if self.error_class is None:
   173	            error_class = other.error_class
   174	        elif other.error_class is None:
   175	            error_class = self.error_class
   176	        elif self.error_class == other.error_class:
   177	            error_class = self.error_class
   178	        else:
   179	            error_class = "multiple"
   180	
   181	        # lease_id: equal or one-side None merges; unequal non-None conflicts.
   182	        if self.lease_id is None:
   183	            lease_id = other.lease_id
   184	        elif other.lease_id is None:
   185	            lease_id = self.lease_id
   186	        elif self.lease_id == other.lease_id:
   187	            lease_id = self.lease_id
   188	        else:
   189	            raise LeaseIdConflict(
   190	                f"Cannot join envelopes with unequal lease_ids: "
   191	                f"{self.lease_id!r} vs {other.lease_id!r}"
   192	            )
   193	
   194	        # fencing_token: max, treating None as -1.
   195	        a = -1 if self.fencing_token is None else self.fencing_token
   196	        b = -1 if other.fencing_token is None else other.fencing_token
   197	        merged_ft = max(a, b)
   198	        fencing_token = None if merged_ft == -1 else merged_ft
   199	
   200	        # capacity_grant: additive except duplicate concrete grant identity.
   201	        if (
   202	            lease_id is not None
   203	            and self.lease_id == other.lease_id == lease_id
   204	            and self.fencing_token is not None
   205	            and self.fencing_token == other.fencing_token
   206	        ):
   207	            capacity_grant = max(self.capacity_grant, other.capacity_grant)
   208	        else:
   209	            capacity_grant = self.capacity_grant + other.capacity_grant

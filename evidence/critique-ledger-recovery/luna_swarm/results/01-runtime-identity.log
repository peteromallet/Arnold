    30	def _workflow_parser() -> argparse.ArgumentParser:
    31	    # workflow.main builds the parser internally; exercise it by parsing --help.
    32	    import io
    33	
    34	    buf = io.StringIO()
    35	    try:
    36	        workflow_main(["--help"], out=buf)
    37	    except SystemExit:
    38	        pass
    39	    # We cannot easily get the parser object back, so build a lightweight mirror
    40	    # by importing the module and calling its internal helper indirectly.
    41	    import arnold.cli.workflow as workflow_mod
    42	
    43	    return workflow_mod.main.__code__  # type: ignore[attr-defined]
    44	
    45	
    46	def test_workflow_subcommand_surface() -> None:
    47	    """Snapshot of workflow subcommands exposed by arnold.cli.workflow."""
    48	
    49	    import arnold.cli.workflow as workflow_mod
    50	
    51	    # Build the parser by calling main with a --help trap.
    52	    parser = None
    53	    original_parse_args = argparse.ArgumentParser.parse_args
    54	
    55	    def capture_parser(self, args=None, namespace=None):
    56	        nonlocal parser
    57	        parser = self
    58	        raise SystemExit
    59	
    60	    argparse.ArgumentParser.parse_args = capture_parser  # type: ignore[method-assign]
    61	    try:
    62	        try:
    63	            workflow_mod.main(["--help"])
    64	        except SystemExit:
    65	            pass
    66	    finally:
    67	        argparse.ArgumentParser.parse_args = original_parse_args
    68	
    69	    assert parser is not None
    70	    subparsers_action = next(
    71	        action for action in parser._actions if isinstance(action, argparse._SubParsersAction)
    72	    )
    73	    assert sorted(subparsers_action.choices) == EXPECTED_WORKFLOW_SUBCOMMANDS

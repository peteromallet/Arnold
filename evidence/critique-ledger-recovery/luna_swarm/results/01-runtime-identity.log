  1341	def _remote_megaplan_import_check_command() -> str:
  1342	    script = """
  1343	import importlib.util, json
  1344	
  1345	def present(name):
  1346	    try:
  1347	        return importlib.util.find_spec(name) is not None
  1348	    except Exception as exc:
  1349	        return {"error": str(exc)}
  1350	
  1351	checks = {
  1352	    "arnold_pipelines.megaplan": present("arnold_pipelines.megaplan"),
  1353	    "arnold_pipelines.megaplan.cli": present("arnold_pipelines.megaplan.cli"),
  1354	    "arnold.pipelines.megaplan": present("arnold.pipelines.megaplan"),
  1355	}
  1356	errors = []
  1357	if checks["arnold_pipelines.megaplan"] is not True:
  1358	    errors.append("missing modern arnold_pipelines.megaplan import")
  1359	if checks["arnold_pipelines.megaplan.cli"] is not True:
  1360	    errors.append("missing modern arnold_pipelines.megaplan.cli import")
  1361	print(json.dumps({"checks": checks, "errors": errors}, sort_keys=True))
  1362	raise SystemExit(1 if errors else 0)
  1363	"""
  1364	    return f"python3 - <<'MEGAPLAN_IMPORT_CHECK'\n{script.strip()}\nMEGAPLAN_IMPORT_CHECK"

    76	def test_top_level_dispatch_routes_workflow_without_importing_legacy_modules() -> None:
    77	    """arnold workflow ... must not trigger an import of legacy Megaplan CLI modules."""
    78	
    79	    before = set(sys.modules.keys())
    80	    rc = cli_package.main(["workflow", "check", "--module", "tests.fixtures.workflow.demo_pipeline:build_pipeline"])
    81	    imported = set(sys.modules.keys()) - before
    82	
    83	    forbidden = {
    84	        name
    85	        for name in imported
    86	        if name == "arnold_pipelines.megaplan.cli.arnold"
    87	        or name.startswith("arnold_pipelines.megaplan.cli")
    88	    }
    89	    assert rc == 0
    90	    assert not forbidden, f"workflow dispatch imported legacy modules: {forbidden}"

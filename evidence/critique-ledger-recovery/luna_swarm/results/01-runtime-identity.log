  1236	def _remote_chain_workspace_path(local_path: Path, *, local_root: Path, target_workspace: str) -> str:
  1237	    path = local_path.expanduser().resolve()
  1238	    root = local_root.expanduser().resolve()
  1239	    relative: PurePosixPath | None = None
  1240	    try:
  1241	        relative = PurePosixPath(path.relative_to(root))
  1242	    except ValueError:
  1243	        relative = None
  1244	    # local_root isn't always the spec's repo root (it can be a cloud cache dir
  1245	    # or a project dir that doesn't contain the spec). Fall back to the spec's
  1246	    # OWN git repo root so the spec lands at its repo-relative path on the box —
  1247	    # this keeps the chain spec, its north_star anchor, and idea files at the
  1248	    # same relative paths, so chain.yaml-dir-relative anchor resolution works
  1249	    # identically locally and remotely. Bare path.name is the last resort.
  1250	    if relative is None:
  1251	        git_root = _git_repo_root(path)
  1252	        if git_root is not None:
  1253	            try:
  1254	                relative = PurePosixPath(path.relative_to(git_root))
  1255	            except ValueError:
  1256	                relative = None
  1257	    if relative is None:
  1258	        return str(PurePosixPath(target_workspace) / path.name)
  1259	    return str(PurePosixPath(target_workspace).joinpath(*relative.parts))

  1059	def _local_idea_source_candidates(*, root: Path, idea_dir: Path, workspace: str, remote_path: str) -> list[Path]:
  1060	    relative_remote = _relative_remote_path(workspace=workspace, remote_path=remote_path)
  1061	    candidates: list[Path] = []
  1062	    _append_unique_path(candidates, idea_dir / relative_remote)
  1063	    _append_unique_path(candidates, root / relative_remote)
  1064	
  1065	    try:
  1066	        idea_dir_tail = idea_dir.relative_to(root)
  1067	    except ValueError:
  1068	        idea_dir_tail = None
  1069	    if idea_dir_tail is not None:
  1070	        try:
  1071	            deduped_tail = relative_remote.relative_to(idea_dir_tail)
  1072	        except ValueError:
  1073	            deduped_tail = None
  1074	        if deduped_tail is not None:
  1075	            _append_unique_path(candidates, idea_dir / deduped_tail)
  1076	
  1077	    remote = PurePosixPath(remote_path)
  1078	    if remote.is_absolute() and not str(remote).startswith(f"{PurePosixPath(workspace)}/"):
  1079	        _append_unique_path(candidates, idea_dir / remote.name)
  1080	    return candidates

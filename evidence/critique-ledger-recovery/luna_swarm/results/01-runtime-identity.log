--- test_phase_command_shim ---
     1	"""Tests for the _phase_command substrate shim (M3 Step 12).
     2	
     3	The shim adds a *substrate* kwarg to ``auto._phase_command`` so callers
     4	in the unified-dispatch path can explicitly declare their execution model.
     5	The parameter is forward-looking: both ``"subprocess_isolated"`` and
     6	``"in_process"`` currently return identical CLI args (the legacy contract).
     7	"""
     8	
     9	from __future__ import annotations
    10	
    11	import inspect
    12	
    13	import pytest
    14	
    15	from arnold_pipelines.megaplan.auto import _phase_command
    16	from arnold_pipelines.megaplan.cloud.cli import cloud_substrate
    17	
    18	
    19	# ---------------------------------------------------------------------------
    20	# Backward-compatible signature
    21	# ---------------------------------------------------------------------------
    22	
    23	def test_phase_command_accepts_no_substrate_kwarg() -> None:
    24	    """Calling without *substrate* uses the default and returns correct args."""
    25	    result = _phase_command("review")
    26	    assert result == ["review"]
    27	
    28	
    29	def test_phase_command_default_is_subprocess_isolated() -> None:
    30	    """The default substrate value is ``"subprocess_isolated"``."""
    31	    sig = inspect.signature(_phase_command)
    32	    assert sig.parameters["substrate"].default == "subprocess_isolated"
    33	
    34	
    35	def test_phase_command_substrate_annotation_is_string() -> None:
    36	    """The *substrate* parameter is annotated (string under PEP 563)."""
    37	    sig = inspect.signature(_phase_command)
    38	    param = sig.parameters["substrate"]
    39	    assert param.annotation is not inspect.Parameter.empty
    40	
    41	
    42	# ---------------------------------------------------------------------------
    43	# Both substrates return identical args (shim contract)
    44	# ---------------------------------------------------------------------------
    45	
    46	@pytest.mark.parametrize("next_step,expected", [
    47	    ("review", ["review"]),
    48	    ("step", ["step"]),
    49	    ("plan", ["plan"]),
    50	    ("execute", ["execute", "--confirm-destructive", "--user-approved", "--retry-blocked-tasks"]),
    51	    ("feedback", ["feedback", "workflow"]),
    52	    ("override add-note", ["override", "add-note"]),
    53	    ("override force-proceed", ["override", "force-proceed"]),
    54	    ("override abort", ["override", "abort"]),
    55	])
    56	def test_both_substrates_return_same_args(next_step: str, expected: list[str]) -> None:
    57	    """``subprocess_isolated`` and ``in_process`` produce identical CLI args."""
    58	    assert _phase_command(next_step, substrate="subprocess_isolated") == expected
    59	    assert _phase_command(next_step, substrate="in_process") == expected
    60	
    61	
    62	def test_default_matches_explicit_subprocess_isolated() -> None:
    63	    """Default (no substrate) == explicit ``subprocess_isolated``."""
    64	    for step in ("review", "execute", "feedback", "override add-note"):
    65	        assert _phase_command(step) == _phase_command(step, substrate="subprocess_isolated")
    66	
    67	
    68	# ---------------------------------------------------------------------------
    69	# cloud_substrate constant
    70	# ---------------------------------------------------------------------------
    71	
    72	def test_cloud_substrate_exists() -> None:
    73	    """``cloud_substrate`` is importable from ``megaplan.cloud.cli``."""
    74	    assert cloud_substrate == "subprocess_isolated"
    75	
    76	
    77	def test_cloud_substrate_is_string() -> None:
    78	    """``cloud_substrate`` is a plain string literal."""
    79	    assert isinstance(cloud_substrate, str)
    80	
    81	
    82	# ---------------------------------------------------------------------------
    83	# In-process shim does not break any caller
    84	# ---------------------------------------------------------------------------
    85	
    86	def test_in_process_substrate_does_not_alter_execute_flags() -> None:
    87	    """Execute under ``in_process`` still returns the auto-mode flags."""
    88	    result = _phase_command("execute", substrate="in_process")
    89	    assert "--confirm-destructive" in result
    90	    assert "--user-approved" in result
    91	    assert "--retry-blocked-tasks" in result
    92	
    93	
    94	def test_in_process_substrate_does_not_alter_feedback() -> None:
    95	    """Feedback under ``in_process`` still returns the workflow operation."""
    96	    assert _phase_command("feedback", substrate="in_process") == ["feedback", "workflow"]

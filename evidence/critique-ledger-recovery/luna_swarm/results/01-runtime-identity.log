  1083	def _resolve_local_idea_source(*, root: Path, idea_dir: Path, workspace: str, remote_path: str) -> tuple[Path | None, list[Path]]:
  1084	    candidates = _local_idea_source_candidates(root=root, idea_dir=idea_dir, workspace=workspace, remote_path=remote_path)
  1085	    for candidate in candidates:
  1086	        if candidate.exists():
  1087	            return candidate, candidates

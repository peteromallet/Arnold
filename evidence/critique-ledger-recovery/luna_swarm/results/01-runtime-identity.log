  1320	def _remote_dependency_check_command(commands: list[str]) -> str:
  1321	    quoted_commands = " ".join(shlex.quote(command) for command in commands)
  1322	    return (
  1323	        "missing=''; "
  1324	        f"for cmd in {quoted_commands}; do "
  1325	        'if ! command -v "$cmd" >/dev/null 2>&1; then missing="$missing $cmd"; fi; '
  1326	        "done; "
  1327	        'printf "%s\\n" "$missing"'
  1328	    )

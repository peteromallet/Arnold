  1367	def _run_remote_megaplan_import_check(provider) -> dict[str, Any]:
  1368	    result = provider.ssh_exec(_remote_megaplan_import_check_command())
  1369	    raw = (result.stdout or "").strip().splitlines()
  1370	    try:
  1371	        payload = json.loads(raw[-1] if raw else "{}")
  1372	    except json.JSONDecodeError as exc:
  1373	        payload = {
  1374	            "checks": {},
  1375	            "errors": [f"import check output was not JSON: {exc}"],
  1376	            "raw": result.stdout,
  1377	        }
  1378	    if result.returncode != 0:
  1379	        payload.setdefault("errors", [])
  1380	        if result.stderr:
  1381	            payload["errors"].append(result.stderr.strip())
  1382	    payload["status"] = "ok" if not payload.get("errors") else "failed"
  1383	    return payload

--- arnold cli package ---
     1	"""Arnold CLI dispatch layer.
     2	
     3	Routes:
     4	* ``arnold workflow ...`` directly to ``arnold.cli.workflow``.
     5	* ``arnold status/trace/inspect/override`` to ``arnold.cli.operators``.
     6	* ``arnold approve/deny/cancel/resume`` to ``arnold.cli.execution``.
     7	
     8	Legacy Megaplan subcommands are removed in M6; the only supported top-level
     9	verbs are the workflow runtime and the operator projection commands.
    10	"""
    11	
    12	from __future__ import annotations
    13	
    14	import sys
    15	from typing import Sequence
    16	
    17	
    18	# Commands that are implemented directly against the workflow/execution runtime.
    19	_WORKFLOW_COMMAND = "workflow"
    20	_OPERATOR_COMMANDS = frozenset({"status", "trace", "inspect", "override"})
    21	_EXECUTION_COMMANDS = frozenset({"approve", "deny", "cancel", "resume"})
    22	
    23	
    24	def cli_entry() -> None:
    25	    """Console-script entry point registered in pyproject.toml."""
    26	    sys.exit(main())
    27	
    28	
    29	def main(argv: Sequence[str] | None = None) -> int:
    30	    """Dispatch to the workflow CLI or operator commands."""
    31	    args = list(sys.argv[1:] if argv is None else argv)
    32	    if not args:
    33	        _print_usage()
    34	        return 2
    35	    if args[0] in {"-h", "--help"}:
    36	        _print_usage()
    37	        return 0
    38	
    39	    command = args[0]
    40	    rest = args[1:]
    41	
    42	    if command == _WORKFLOW_COMMAND:
    43	        from arnold.cli.workflow import main as _workflow_main
    44	
    45	        return _workflow_main(rest)
    46	
    47	    if command in _OPERATOR_COMMANDS:
    48	        from arnold.cli.operators import main as _operators_main
    49	
    50	        return _operators_main([command, *rest])
    51	
    52	    if command in _EXECUTION_COMMANDS:
    53	        from arnold.cli.execution import main as _execution_main
    54	
    55	        return _execution_main([command, *rest], prog="arnold")
    56	
    57	    print(f"arnold: unknown command {command!r}", file=sys.stderr)
    58	    _print_usage(file=sys.stderr)
    59	    return 2
    60	
    61	
    62	def _print_usage(*, file=None) -> None:  # type: ignore[no-untyped-def]
    63	    target = file or sys.stdout
    64	    print(
    65	        "usage: arnold workflow {check,manifest,dot,dry-run,run,resume,describe} | "
    66	        "arnold {status,trace,inspect,override,approve,deny,cancel,resume}",
    67	        file=target,
    68	    )
    69	
    70	
    71	__all__ = ["cli_entry", "main"]

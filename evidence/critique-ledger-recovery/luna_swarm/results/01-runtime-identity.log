   806	def _call_cloud_step_quietly(func, *call_args) -> tuple[int, str, str]:
   807	    stdout = io.StringIO()
   808	    stderr = io.StringIO()
   809	    try:
   810	        with contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr):
   811	            rc = int(func(*call_args) or 0)
   812	    except CliError:
   813	        captured_out = stdout.getvalue()
   814	        captured_err = stderr.getvalue()
   815	        if captured_out:
   816	            sys.stdout.write(captured_out)
   817	        if captured_err:
   818	            sys.stderr.write(captured_err)
   819	        raise
   820	    return rc, stdout.getvalue(), stderr.getvalue()

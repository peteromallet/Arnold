  1396	            warnings.append(
  1397	                "resolved chain routing includes Claude/Shannon phases. "
  1398	                "Codex-only cloud workers should use profile all-codex or explicit codex phase_model pins; "
  1399	                "mixed profiles need Claude CLI/auth and ANTHROPIC_API_KEY available on the worker."
  1400	            )
  1401	    if required_agents == {"codex"}:

     5	[project]
     6	name = "arnold"
     7	version = "0.23.0"
     8	description = "Arnold — AI agent harness for coordinating Claude and GPT to make and execute extremely robust plans, with Megaplan as the flagship planning pipeline plugin"
     9	requires-python = ">=3.11"
    10	license = { text = "OSNL-0.2" }
    11	authors = [
    12	    { name = "Peter O'Malley" },
    13	]
    14	keywords = ["ai", "planning", "orchestration", "claude", "codex", "arnold", "megaplan"]
    15	classifiers = [
    16	    "Development Status :: 3 - Alpha",
    17	    "Environment :: Console",
    18	    "Intended Audience :: Developers",
    19	    "Topic :: Software Development :: Quality Assurance",
    20	    "Topic :: Scientific/Engineering :: Artificial Intelligence",
    21	]
    22	dependencies = [
    23	    "pyyaml>=6.0",
    24	    "pydantic>=2.0",
    25	    "python-ulid>=3.0",
    26	    "psutil>=5.9",
    27	    # --- Hermes/agent backend (core) ---------------------------------------
    28	    # The hermes/agent runtime backs prep research, critique, fanout, and the
    29	    # agentic phases. It is NOT optional: the canonical prep models route to
    30	    # `hermes:deepseek:...` for every run, so a chain that does prep WILL import
    31	    # this backend. Historically these lived in the `[agent]` optional extra
    32	    # plus a `[tool.uv] default-extras = ["agent"]` hint, but some uv versions
    33	    # silently ignore `default-extras`, producing a fresh install that imports
    34	    # fine until prep iteration N fails with a confusing `agent_deps_missing`.
    35	    # Moving them into core makes `pip install -e .` / `uv pip install -e .`
    36	    # ALWAYS ship a working backend. (The `[agent]` extra below is kept as a
    37	    # back-compat alias for callers that still reference it.)
    38	    "openai",
    39	    "anthropic>=0.39.0",
    40	    "python-dotenv",
    41	    "fire",
    42	    "httpx",
    43	    "rich",
    44	    "requests",
    45	    "prompt_toolkit",
    46	    "firecrawl-py",
    47	    "fal-client",
    48	    "edge-tts",
    49	    "faster-whisper>=1.0.0",
    50	    "PyJWT[crypto]",
    51	    "discord.py>=2.6,<3",
    52	]
    53	
    54	[project.scripts]
    55	arnold = "arnold.cli:main"
    56	agentbox = "agentbox.cli:main"
    57	
    58	[project.optional-dependencies]
    59	db = [
    60	    "psycopg[binary]>=3.1",
    61	]
    62	# Back-compat alias: the agent backend's packages are now core dependencies
    63	# (see [project].dependencies). This extra is retained so existing install
    64	# commands / docs that say `pip install '.[agent]'` keep working as a no-op.
    65	agent = []
    66	
    67	[tool.uv]
    68	# The hermes/agent backend's packages are now core [project].dependencies, so a
    69	# plain `uv pip install -e .` / `uv sync` always ships a working backend. We no
    70	# longer rely on `default-extras` (some uv versions silently ignore it, which is
    71	# what produced the confusing mid-prep `agent_deps_missing` failures).
    72	
    73	[tool.hatch.build]

     1	"""Tests for SshProvider.deploy() persistent mounts."""
     2	
     3	from __future__ import annotations
     4	
     5	import shlex
     6	from pathlib import Path
     7	from unittest.mock import MagicMock, patch
     8	
     9	from arnold_pipelines.megaplan.cloud.spec import (
    10	    CloudSpec,
    11	    RepoSpec,
    12	    CodexSpec,
    13	    MegaplanSpec,
    14	    ResourcesSpec,
    15	    SshSpec,
    16	)
    17	
    18	
    19	def _minimal_cloud_spec(**ssh_overrides) -> CloudSpec:
    20	    """Build a minimal valid CloudSpec with provider=ssh."""
    21	    ssh = SshSpec(
    22	        host="testhost",
    23	        **ssh_overrides,
    24	    )
    25	    return CloudSpec(
    26	        provider="ssh",
    27	        repo=RepoSpec(url="https://github.com/example/app.git"),
    28	        agents={"default": "codex"},
    29	        codex=CodexSpec(),
    30	        mode="idle",
    31	        megaplan=MegaplanSpec(),
    32	        resources=ResourcesSpec(),
    33	        secrets=[],
    34	        ssh=ssh,
    35	    )
    36	
    37	
    38	class TestSshDeployPersistentMounts:
    39	    """SshProvider.deploy() must create remote dirs and run Docker with
    40	    persistent workspace + cache mounts, without requiring real SSH/Docker."""
    41	
    42	    def _build_deploy_command(self, spec: CloudSpec) -> str:
    43	        """Reconstruct the exact deploy remote command that SshProvider would
    44	        send, by calling _remote_run with a mock that captures the command."""
    45	        from arnold_pipelines.megaplan.cloud.providers.ssh import SshProvider
    46	
    47	        captured_commands: list[str] = []
    48	
    49	        class CaptureSshProvider(SshProvider):
    50	            def _remote_run(self, command, *, capture_output=True, input=None):
    51	                captured_commands.append(command)
    52	                # Return a mock completed process
    53	                from subprocess import CompletedProcess
    54	                return CompletedProcess(args=[], returncode=0, stdout="", stderr="")
    55	
    56	            def _run(self, argv, *, capture_output=True, input=None):
    57	                # For the docker rm/run calls
    58	                captured_commands.append(" ".join(argv))
    59	                from subprocess import CompletedProcess
    60	                return CompletedProcess(args=[], returncode=0, stdout="", stderr="")
    61	
    62	            def _sync_deploy_dir(self, deploy_dir):
    63	                pass  # skip for this test
    64	
    65	        provider = CaptureSshProvider(spec)
    66	        provider.deploy(Path("/tmp/fake"), secrets={"OPENAI_API_KEY": "sk-test"})
    67	        # Return the concatenated commands for assertion
    68	        return "\n".join(captured_commands)
    69	
    70	    def test_deploy_creates_workspace_and_cache_dirs(self) -> None:
    71	        """deploy() must mkdir -p the workspace_dir and cache subdirs."""
    72	        spec = _minimal_cloud_spec()
    73	        commands = self._build_deploy_command(spec)
    74	
    75	        # Should create workspace_dir
    76	        assert shlex.quote(spec.ssh.workspace_dir) in commands
    77	        # Should create cache_dir/pip

  1585	def _sync_launch_head_to_editable_install_branch(
  1586	    root: Path,
  1587	    *,
  1588	    branch: str = "editible-install",
  1589	    remote: str = "origin",
  1590	    ignore_dirty_paths: list[Path] | None = None,
  1591	) -> dict[str, Any]:
  1592	    """Publish the local launch HEAD to the cloud editable-install branch.
  1593	
  1594	    The cloud worker refreshes `/workspace/arnold` from `editible-install`.
  1595	    Before launching any new cloud chain, publish the code currently being used
  1596	    to launch the run into that branch as well. If the editable branch has
  1597	    unique commits that are not already contained by the launch HEAD, refuse to
  1598	    sync so the divergent code can be reconciled deliberately first.
  1599	    """
  1600	    root = root.expanduser().resolve()
  1601	    inside = _git_run(root, ["rev-parse", "--is-inside-work-tree"])
  1602	    if inside.stdout.strip() != "true":
  1603	        raise CliError(
  1604	            "editable_install_sync_failed",
  1605	            f"cloud chain must be launched from a git worktree to sync {branch}",
  1606	        )
  1607	    ignored = {
  1608	        relative
  1609	        for path in (ignore_dirty_paths or [])
  1610	        if (relative := _git_relative_path(root, path)) is not None
  1611	    }
  1612	    dirty_lines = [
  1613	        line
  1614	        for line in _git_run(root, ["status", "--porcelain", "--untracked-files=all"]).stdout.splitlines()
  1615	        if _porcelain_path(line) not in ignored
  1616	    ]
  1617	    if dirty_lines:
  1618	        raise CliError(
  1619	            "editable_install_sync_dirty",

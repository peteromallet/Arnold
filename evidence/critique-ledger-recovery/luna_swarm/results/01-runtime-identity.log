  1042	def _relative_remote_path(*, workspace: str, remote_path: str) -> Path:
  1043	    remote = PurePosixPath(remote_path)
  1044	    workspace_path = PurePosixPath(workspace)
  1045	    if remote == workspace_path:
  1046	        return Path()
  1047	    elif str(remote).startswith(f"{workspace_path}/"):
  1048	        return Path(*remote.relative_to(workspace_path).parts)
  1049	    elif remote.is_absolute():
  1050	        return Path(*remote.parts[1:])
  1051	    return Path(*remote.parts)

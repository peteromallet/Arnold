  1262	def _normalized_chain_upload_spec(
  1263	    local_spec_path: Path,
  1264	    *,
  1265	    base_branch: str,
  1266	    source_workspace: str | None = None,
  1267	    target_workspace: str | None = None,
  1268	    driver_overrides: dict[str, Any] | None = None,
  1269	    phase_model_by_label: dict[str, list[str]] | None = None,
  1270	) -> Path:
  1271	    raw = _read_chain_yaml(local_spec_path)
  1272	    workspace_changed = (
  1273	        bool(source_workspace)
  1274	        and bool(target_workspace)
  1275	        and source_workspace != target_workspace
  1276	    )
  1277	    if (
  1278	        "base_branch" in raw
  1279	        and not workspace_changed
  1280	        and not driver_overrides
  1281	        and not phase_model_by_label
  1282	    ):
  1283	        return local_spec_path
  1284	    normalized = dict(raw)
  1285	    if "base_branch" not in normalized:
  1286	        normalized["base_branch"] = base_branch
  1287	    if driver_overrides:
  1288	        driver = normalized.get("driver")
  1289	        driver_mapping = dict(driver) if isinstance(driver, dict) else {}
  1290	        driver_mapping.update(driver_overrides)
  1291	        normalized["driver"] = driver_mapping
  1292	    if (workspace_changed or phase_model_by_label) and isinstance(normalized.get("milestones"), list):
  1293	        rewritten: list[Any] = []
  1294	        for item in normalized["milestones"]:
  1295	            if isinstance(item, dict):
  1296	                copied = dict(item)
  1297	                if workspace_changed and isinstance(copied.get("idea"), str):
  1298	                    copied["idea"] = _rewrite_remote_workspace_path(
  1299	                        copied["idea"],
  1300	                        source_workspace=source_workspace or "",
  1301	                        target_workspace=target_workspace or "",
  1302	                    )
  1303	                if phase_model_by_label and isinstance(copied.get("label"), str):
  1304	                    phase_models = phase_model_by_label.get(copied["label"])
  1305	                    if phase_models:
  1306	                        copied["phase_model"] = list(phase_models)
  1307	                rewritten.append(copied)
  1308	            else:
  1309	                rewritten.append(item)
  1310	        normalized["milestones"] = rewritten
  1311	    with NamedTemporaryFile("w", suffix=".yaml", encoding="utf-8", delete=False) as handle:
  1312	        yaml.safe_dump(normalized, handle, sort_keys=False)
  1313	        return Path(handle.name)

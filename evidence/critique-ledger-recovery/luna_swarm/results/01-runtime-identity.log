  1520	def _resolve_resume_workspace(root: Path, args: argparse.Namespace, spec: CloudSpec, provider) -> str:
  1521	    """Resolve the workspace for ``cloud resume``.
  1522	
  1523	    Chain launches can derive a per-chain workspace even when cloud.yaml keeps
  1524	    the default ``repo.workspace``. Prefer the local last-chain marker, then
  1525	    remote chain session markers, and fall back to the static spec workspace.
  1526	    """
  1527	    plan = getattr(args, "plan", None)
  1528	    marker = _load_marker(root, args)
  1529	    if marker:
  1530	        workspace = _workspace_from_chain_marker(spec, marker, provider, plan=plan)
  1531	        if workspace:
  1532	            return workspace
  1533	
  1534	    if plan:
  1535	        for session in _remote_chain_sessions(provider):
  1536	            workspace = _workspace_from_chain_marker(spec, session, provider, plan=plan)
  1537	            if workspace:
  1538	                return workspace
  1539	
  1540	    return spec.repo.workspace

   823	def _json_from_captured_stdout(text: str) -> dict[str, Any] | None:
   824	    decoder = json.JSONDecoder()
   825	    idx = 0
   826	    last: dict[str, Any] | None = None
   827	    while idx < len(text):
   828	        while idx < len(text) and text[idx].isspace():
   829	            idx += 1
   830	        if idx >= len(text):
   831	            break
   832	        try:
   833	            value, end = decoder.raw_decode(text, idx)
   834	        except json.JSONDecodeError:
   835	            break
   836	        if isinstance(value, dict):
   837	            last = value
   838	        idx = end
   839	    return last

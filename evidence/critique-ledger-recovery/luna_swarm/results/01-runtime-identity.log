  1406	def _phase_model_by_label_from_preflight(preflight_summary: Mapping[str, Any]) -> dict[str, list[str]]:
  1407	    """Return phase pins that must be materialized in the uploaded chain spec.
  1408	
  1409	    Cloud chain launch may resolve routing from cloud-only defaults such as
  1410	    ``agents.default``. The remote ``chain start`` process only sees the
  1411	    uploaded chain YAML, so the resolved routing must be materialized into that
  1412	    temporary upload spec or init can fall back to a different local default.
  1413	
  1414	    Do not materialize resolved profile routes for profiled milestones. Profiles
  1415	    can carry ``tier_models.execute``/``tier_models.critique`` tables; flattening
  1416	    their resolved phase map into ``phase_model`` erases adaptive per-batch
  1417	    routing and pins execute to one model.
  1418	    """
  1419	    phase_model_by_label: dict[str, list[str]] = {}
  1420	    for milestone in preflight_summary.get("milestones", []):
  1421	        if not isinstance(milestone, Mapping):
  1422	            continue
  1423	        label = milestone.get("label")
  1424	        profile = milestone.get("profile")
  1425	        explicit = milestone.get("explicit_phase_model")
  1426	        resolved_phase_chains = milestone.get("resolved_phase_chains")
  1427	        if isinstance(profile, str) and profile:
  1428	            if (
  1429	                isinstance(label, str)
  1430	                and isinstance(explicit, list)
  1431	                and all(isinstance(item, str) for item in explicit)
  1432	                and explicit
  1433	            ):
  1434	                phase_model_by_label[label] = list(explicit)
  1435	            continue
  1436	        resolved = milestone.get("resolved_phase_map")
  1437	        if not isinstance(label, str):
  1438	            continue
  1439	        phase_models: list[str] = []
  1440	        explicit_steps: set[str] = set()
  1441	        if isinstance(explicit, list) and all(isinstance(item, str) for item in explicit):
  1442	            for entry in explicit:
  1443	                if "=" not in entry:
  1444	                    continue
  1445	                phase, _chain = decode_phase_model_value(entry)
  1446	                explicit_steps.add(phase)
  1447	                phase_models.append(entry)
  1448	        if isinstance(resolved_phase_chains, Mapping):
  1449	            for phase, specs in resolved_phase_chains.items():
  1450	                if not isinstance(phase, str) or phase in explicit_steps:
  1451	                    continue
  1452	                if not isinstance(specs, list) or not all(isinstance(item, str) for item in specs) or not specs:
  1453	                    continue
  1454	                phase_models.append(encode_phase_model_value(phase, specs))
  1455	        elif isinstance(resolved, Mapping):
  1456	            for phase, spec in resolved.items():
  1457	                if isinstance(phase, str) and isinstance(spec, str) and phase and spec and phase not in explicit_steps:
  1458	                    phase_models.append(f"{phase}={spec}")
  1459	        if phase_models:
  1460	            phase_model_by_label[label] = phase_models
  1461	    return phase_model_by_label

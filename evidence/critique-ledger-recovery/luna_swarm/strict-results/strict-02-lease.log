maybe_reexec_updated_watchdog() {
  local wrapper_path wrapper_mtime
  local source_wrapper source_mtime
  local reexec_path reexec_reason

  wrapper_path="$SELF_PATH"
  wrapper_mtime="$(stat -c %Y "$wrapper_path" 2>/dev/null || stat -f %m "$wrapper_path" 2>/dev/null || echo 0)"
  [[ "$wrapper_mtime" =~ ^[0-9]+$ ]] || wrapper_mtime=0

  source_wrapper="$SRC_DIR/arnold_pipelines/megaplan/cloud/wrappers/$(basename "$SELF_PATH")"
  source_mtime=0
  if [[ -f "$source_wrapper" ]]; then
    source_mtime="$(stat -c %Y "$source_wrapper" 2>/dev/null || stat -f %m "$source_wrapper" 2>/dev/null || echo 0)"
    [[ "$source_mtime" =~ ^[0-9]+$ ]] || source_mtime=0
  fi

  reexec_path=""
  reexec_reason=""
  if (( source_mtime > WATCHDOG_STARTED_AT && source_mtime >= wrapper_mtime )); then
    reexec_path="$source_wrapper"
    reexec_reason="editable source wrapper"
  elif (( wrapper_mtime > WATCHDOG_STARTED_AT )); then
    reexec_path="$wrapper_path"
    reexec_reason="current script"
  fi

  if [[ -n "$reexec_path" ]]; then
    log "watchdog wrapper updated on disk; re-execing $reexec_reason"
    exec bash "$reexec_path" "${WATCHDOG_ARGS[@]}"
  fi
}

json_field() {
  local marker="$1"
  local field="$2"
  python3 - "$marker" "$field" <<'PY'
import json
import sys

path, field = sys.argv[1], sys.argv[2]
try:
    payload = json.load(open(path, encoding="utf-8"))
except Exception:
    sys.exit(1)
value = payload.get(field)
if not isinstance(value, str) or not value:
    sys.exit(1)
print(value)
PY
}

safe_name() {
  printf '%s' "$1" | tr -c 'A-Za-z0-9_.-' '-'
}

repair_pidfile_path() {
  printf '%s/%s.repair-loop.pid' "$MARKER_DIR" "$(safe_name "$1")"
}

repair_loop_pid_matches_session() {
  local pid="$1"
  local session="${2:-}"
  local repair_basename="${PRIMARY_REPAIR_BASENAME:-arnold-repair-loop}"
  python3 - "$pid" "$session" "$repair_basename" <<'PY'
import os
import pathlib
import shlex
import subprocess
import sys

pid_text, session, repair_basename = sys.argv[1:]
try:
    pid = int(pid_text)
except (TypeError, ValueError):
    raise SystemExit(1)
if pid <= 0:
    raise SystemExit(1)

def parse_args() -> list[str]:
    cmdline_path = pathlib.Path(f"/proc/{pid}/cmdline")
    if cmdline_path.exists():
        raw = cmdline_path.read_bytes()
        return [part.decode("utf-8", "replace") for part in raw.split(b"\0") if part]
    proc = subprocess.run(
        ["ps", "-ww", "-o", "args=", "-p", str(pid)],
        check=False,
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        return []
    text = proc.stdout.strip()
    if not text:
        return []
    try:
        return shlex.split(text)
    except ValueError:
        return text.split()

args = parse_args()
if not args:
    raise SystemExit(1)

def match_at(idx: int) -> bool:
    if idx >= len(args):
        return False
    base = os.path.basename(args[idx])
    if base not in {"arnold-repair-loop", repair_basename}:
        return False
    if not session:
        return True
    return idx + 1 < len(args) and args[idx + 1] == session

for idx in range(len(args)):
    if match_at(idx):
        raise SystemExit(0)
    base = os.path.basename(args[idx])
    if base in {"bash", "sh"} and match_at(idx + 1):
        raise SystemExit(0)

raise SystemExit(1)
PY
}



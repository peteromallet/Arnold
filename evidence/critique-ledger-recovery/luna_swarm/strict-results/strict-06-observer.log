1557:write_status_snapshot() {
1558:  # Produce the canonical cloud-status.json. Built from local observation only
1559:  # (marker dir + the report emit_report wrote). The 4th arg ("track" default vs
1560:  # "notrack") decides whether a failure counts toward escalation — the early
1561:  # best-effort write at sweep start uses "notrack" so only authoritative
1562:  # end-of-sweep write failures escalate. Never let a snapshot failure break the
1563:  # watchdog sweep — count/log and move on.
1564:  local marker_dir="${1:-$MARKER_DIR}"
1565:  local report_path="${2:-$REPORT_PATH}"
1566:  local status_dir="${3:-$STATUS_DIR}"
1567:  local track="${4:-track}"
1568:  if PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$marker_dir" "$report_path" "$status_dir" <<'PY' 2>>"${LOG:-/dev/null}"; then
1569:import sys
1570:from pathlib import Path
1571:
1572:from arnold_pipelines.megaplan.cloud import status_snapshot
1573:
1574:marker_dir, report_path, status_dir = (Path(p) for p in sys.argv[1:4])
1575:status_snapshot.build_and_write_snapshot(
1576:    marker_dir=marker_dir,
1577:    watchdog_report_path=report_path,
1578:    path=status_dir / "cloud-status.json",
1579:    previous_path=status_dir / "cloud-status.previous.json",
1580:)
1581:PY
1582:    [[ "$track" != "notrack" ]] && record_snapshot_write_outcome "$status_dir" ok
1583:  else
1584:    if [[ "$track" != "notrack" ]]; then
1585:      local _failures
1586:      _failures="$(record_snapshot_write_outcome "$status_dir" fail)"
1587:      log "status snapshot write failed (${_failures:-?} consecutive; threshold ${SNAPSHOT_FAILURE_THRESHOLD:-3})"
1588:    else
1589:      log "status snapshot early write failed (best-effort; not counted)"
1590:    fi
1591:  fi
1592:}

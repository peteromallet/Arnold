) -> subprocess.CompletedProcess[str]:
    program = _extract_repair_program(
        "write_needs_human_marker",
        "PYTHONPATH=\"$ARNOLD_SRC:${PYTHONPATH:-}\" python3 - \"$DATA_FILE\" \"$NEEDS_HUMAN_FILE\" \"$discord_status\" <<'PY'",

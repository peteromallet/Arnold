1519:record_snapshot_write_outcome() {
1520:  # Track consecutive snapshot-write failures (watchdog-snapshot-staleness-fix.md
1521:  # P2): "ok" resets the counter and clears the error sidecar; "fail" bumps it,
1522:  # and once it reaches SNAPSHOT_FAILURE_THRESHOLD drops a visible
1523:  # cloud-status.write-error.json so consumers know the cache is frozen. Prints
1524:  # the failure count on "fail" (for logging); prints nothing on "ok".
1525:  local status_dir="${1:-$STATUS_DIR}"
1526:  local outcome="${2:-ok}"
1527:  local threshold="${SNAPSHOT_FAILURE_THRESHOLD:-3}"
1528:  python3 - "$status_dir" "$outcome" "$threshold" <<'PY' 2>/dev/null || true
1529:import datetime, json, pathlib, sys
1530:status_dir, outcome, threshold = sys.argv[1], sys.argv[2], int(sys.argv[3] or 3)
1531:base = pathlib.Path(status_dir)
1532:counter_path = base / "snapshot-failures.json"
1533:err_path = base / "cloud-status.write-error.json"
1534:now = datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z")
1535:if outcome == "ok":
1536:    for p in (counter_path, err_path):
1537:        try:
1538:            p.unlink()
1539:        except FileNotFoundError:
1540:            pass
1541:    sys.exit(0)
1542:try:
1543:    failures = json.loads(counter_path.read_text()).get("failures", 0) + 1 if counter_path.exists() else 1
1544:except Exception:
1545:    failures = 1
1546:counter_path.write_text(json.dumps({"failures": failures, "last_at": now}) + "\n")
1547:if failures >= threshold:
1548:    err_path.write_text(json.dumps({
1549:        "error": "cloud-status snapshot write has failed %d consecutive sweeps; cache may be frozen" % failures,
1550:        "failures": failures,
1551:        "at": now,
1552:    }) + "\n")
1553:print(failures)
1554:PY
1555:}

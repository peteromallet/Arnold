1505:write_watchdog_heartbeat() {
1506:  # Touch a freshness probe at sweep START so the resident can detect a stalled
1507:  # watchdog even when a later step (repair_trigger_scan / git sync / pip refresh)
1508:  # hangs before the snapshot write completes (watchdog-snapshot-staleness-fix.md
1509:  # P2). Best-effort; never fails a sweep.
1510:  local status_dir="${1:-$STATUS_DIR}"
1511:  mkdir -p "$status_dir" 2>/dev/null || true
1512:  python3 - "$status_dir" <<'PY' 2>/dev/null || date -u +"%Y-%m-%dT%H:%M:%SZ" > "$status_dir/watchdog.heartbeat" 2>/dev/null || true
1513:import datetime, pathlib, sys
1514:p = pathlib.Path(sys.argv[1]) / "watchdog.heartbeat"
1515:p.write_text(datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z") + "\n")
1516:PY
1517:}
